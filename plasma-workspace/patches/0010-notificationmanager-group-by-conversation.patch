+#include <QAbstractItemModelTester>
+#include <QSignalSpy>
+#include <QSortFilterProxyModel>
+#include <QStandardItemModel>
+#include <QTest>
+
+#include <algorithm>
+#include <memory>
+
+#include "notificationgroupingproxymodel_p.h"
+#include "notifications.h"
+
+using namespace NotificationManager;
+
+class GroupingProxyModelTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void init();
+    void groupsByApplication();
+    void groupsByConversation();
+    void conversationOverridesSummary();
+    void hiddenContentGroupsByApplication();
+    void switchesMode();
+    void regroupsChangedNotification();
+    void keepsJobsTogether();
+    void removesNotifications();
+    void followsSourceLayoutChange();
+
+private:
+    void add(const QString &app, const QString &summary, const QString &conversation = QString());
+    QList<int> groupSizes() const;
+
+    QStandardItemModel m_source;
+    std::unique_ptr<NotificationGroupingProxyModel> m_proxy;
+    std::unique_ptr<QAbstractItemModelTester> m_tester;
+};
+
+void GroupingProxyModelTest::init()
+{
+    m_tester.reset();
+    m_source.clear();
+    m_proxy = std::make_unique<NotificationGroupingProxyModel>();
+    m_proxy->setSourceModel(&m_source);
+    // checks the signals of the model, e.g. no row changes within a reset
+    m_tester = std::make_unique<QAbstractItemModelTester>(m_proxy.get(), QAbstractItemModelTester::FailureReportingMode::QtTest);
+}
+
+void GroupingProxyModelTest::add(const QString &app, const QString &summary, const QString &conversation)
+{
+    auto *item = new QStandardItem;
+    item->setData(app, Notifications::ApplicationNameRole);
+    item->setData(QString(QStringLiteral("org.example.") + app), Notifications::DesktopEntryRole);
+    item->setData(summary, Notifications::SummaryRole);
+    item->setData(conversation, Notifications::ConversationRole);
+    m_source.appendRow(item);
+}
+
+// sizes of the top level rows, 1 for a single notification
+QList<int> GroupingProxyModelTest::groupSizes() const
+{
+    QList<int> sizes;
+    for (int i = 0; i < m_proxy->rowCount(); ++i) {
+        sizes.append(std::max(1, m_proxy->rowCount(m_proxy->index(i, 0))));
+    }
+    std::sort(sizes.begin(), sizes.end());
+    return sizes;
+}
+
+void GroupingProxyModelTest::groupsByApplication()
+{
+    add(QStringLiteral("chat"), QStringLiteral("Max"));
+    add(QStringLiteral("chat"), QStringLiteral("Erika"));
+    add(QStringLiteral("mail"), QStringLiteral("Max"));
+
+    QCOMPARE(groupSizes(), (QList<int>{1, 2}));
+}
+
+void GroupingProxyModelTest::groupsByConversation()
+{
+    m_proxy->setGroupConversations(true);
+
+    add(QStringLiteral("chat"), QStringLiteral("Max"));
+    add(QStringLiteral("chat"), QStringLiteral("Erika"));
+    add(QStringLiteral("chat"), QStringLiteral("Max"));
+    add(QStringLiteral("mail"), QStringLiteral("Max"));
+    add(QStringLiteral("chat"), QStringLiteral("Max"));
+
+    QCOMPARE(groupSizes(), (QList<int>{1, 1, 3}));
+
+    const QModelIndex group = m_proxy->index(0, 0);
+    QVERIFY(group.data(Notifications::IsGroupRole).toBool());
+    QCOMPARE(group.data(Notifications::GroupChildrenCountRole).toInt(), 3);
+    QCOMPARE(m_proxy->index(0, 0, group).data(Notifications::SummaryRole).toString(), QStringLiteral("Max"));
+}
+
+void GroupingProxyModelTest::conversationOverridesSummary()
+{
+    m_proxy->setGroupConversations(true);
+
+    add(QStringLiteral("chat"), QStringLiteral("Max in Family"), QStringLiteral("family"));
+    add(QStringLiteral("chat"), QStringLiteral("Erika in Family"), QStringLiteral("family"));
+    add(QStringLiteral("chat"), QStringLiteral("family"));
+
+    QCOMPARE(groupSizes(), (QList<int>{1, 2}));
+}
+
+void GroupingProxyModelTest::hiddenContentGroupsByApplication()
+{
+    m_proxy->setGroupConversations(true);
+
+    // the visibility proxy empties summary and conversation when only the application may be shown
+    add(QStringLiteral("chat"), QString());
+    add(QStringLiteral("chat"), QString());
+    add(QStringLiteral("chat"), QStringLiteral("Max"));
+
+    QCOMPARE(groupSizes(), (QList<int>{1, 2}));
+}
+
+void GroupingProxyModelTest::switchesMode()
+{
+    add(QStringLiteral("chat"), QStringLiteral("Max"));
+    add(QStringLiteral("chat"), QStringLiteral("Erika"));
+    QCOMPARE(groupSizes(), (QList<int>{2}));
+
+    QSignalSpy resetSpy(m_proxy.get(), &QAbstractItemModel::modelReset);
+    m_proxy->setGroupConversations(true);
+    QCOMPARE(resetSpy.count(), 1);
+    QCOMPARE(groupSizes(), (QList<int>{1, 1}));
+
+    m_proxy->setGroupConversations(false);
+    QCOMPARE(groupSizes(), (QList<int>{2}));
+}
+
+void GroupingProxyModelTest::regroupsChangedNotification()
+{
+    m_proxy->setGroupConversations(true);
+
+    add(QStringLiteral("chat"), QStringLiteral("Max"));
+    add(QStringLiteral("chat"), QStringLiteral("Max"));
+    add(QStringLiteral("chat"), QStringLiteral("Erika"));
+    QCOMPARE(groupSizes(), (QList<int>{1, 2}));
+
+    // a notification replaced with another summary moves to the group of that summary
+    m_source.item(1)->setData(QStringLiteral("Erika"), Notifications::SummaryRole);
+    QCOMPARE(groupSizes(), (QList<int>{1, 2}));
+    for (int i = 0; i < m_proxy->rowCount(); ++i) {
+        const QModelIndex idx = m_proxy->index(i, 0);
+        if (m_proxy->rowCount(idx) == 2) {
+            QCOMPARE(m_proxy->index(0, 0, idx).data(Notifications::SummaryRole).toString(), QStringLiteral("Erika"));
+            QCOMPARE(m_proxy->index(1, 0, idx).data(Notifications::SummaryRole).toString(), QStringLiteral("Erika"));
+        } else {
+            QCOMPARE(idx.data(Notifications::SummaryRole).toString(), QStringLiteral("Max"));
+        }
+    }
+
+    // a change that keeps the grouping does not reset the model
+    QSignalSpy resetSpy(m_proxy.get(), &QAbstractItemModel::modelReset);
+    m_source.item(0)->setData(QStringLiteral("body"), Notifications::BodyRole);
+    QCOMPARE(resetSpy.count(), 0);
+}
+
+void GroupingProxyModelTest::keepsJobsTogether()
+{
+    m_proxy->setGroupConversations(true);
+
+    add(QStringLiteral("files"), QStringLiteral("Copying"));
+    add(QStringLiteral("files"), QStringLiteral("Moving"));
+    add(QStringLiteral("files"), QStringLiteral("Done"));
+    m_source.item(0)->setData(Notifications::JobType, Notifications::TypeRole);
+    m_source.item(1)->setData(Notifications::JobType, Notifications::TypeRole);
+    QCOMPARE(groupSizes(), (QList<int>{1, 2}));
+
+    // a running job changes its summary without leaving its group
+    QSignalSpy resetSpy(m_proxy.get(), &QAbstractItemModel::modelReset);
+    m_source.item(0)->setData(QStringLiteral("Copied"), Notifications::SummaryRole);
+    QCOMPARE(resetSpy.count(), 0);
+    QCOMPARE(groupSizes(), (QList<int>{1, 2}));
+}
+
+void GroupingProxyModelTest::removesNotifications()
+{
+    m_proxy->setGroupConversations(true);
+
+    add(QStringLiteral("chat"), QStringLiteral("Max"));
+    add(QStringLiteral("chat"), QStringLiteral("Erika"));
+    add(QStringLiteral("chat"), QStringLiteral("Max"));
+    add(QStringLiteral("chat"), QStringLiteral("Erika"));
+    add(QStringLiteral("chat"), QStringLiteral("Max"));
+    QCOMPARE(groupSizes(), (QList<int>{2, 3}));
+
+    m_source.removeRow(0); // Max: 3 -> 2
+    QCOMPARE(groupSizes(), (QList<int>{2, 2}));
+    m_source.removeRow(0); // Erika: 2 -> 1, the group dissolves
+    QCOMPARE(groupSizes(), (QList<int>{1, 2}));
+    m_source.removeRows(0, 2);
+    QCOMPARE(groupSizes(), (QList<int>{1}));
+}
+
+class LayoutChangingModel : public QSortFilterProxyModel
+{
+public:
+    bool hideMax = false;
+
+    void hide()
+    {
+        hideMax = true;
+        // like a proxy that invalidates: the rows change within a layout change
+        invalidate();
+    }
+
+protected:
+    bool filterAcceptsRow(int sourceRow, const QModelIndex &sourceParent) const override
+    {
+        return !hideMax || sourceModel()->index(sourceRow, 0, sourceParent).data(Notifications::SummaryRole).toString() != QLatin1String("Max");
+    }
+};
+
+void GroupingProxyModelTest::followsSourceLayoutChange()
+{
+    LayoutChangingModel filter;
+    filter.setSourceModel(&m_source);
+    m_proxy->setGroupConversations(true);
+    m_proxy->setSourceModel(&filter);
+
+    add(QStringLiteral("chat"), QStringLiteral("Max"));
+    add(QStringLiteral("chat"), QStringLiteral("Max"));
+    add(QStringLiteral("chat"), QStringLiteral("Erika"));
+    QCOMPARE(groupSizes(), (QList<int>{1, 2}));
+
+    filter.hide();
+    QCOMPARE(groupSizes(), (QList<int>{1}));
+    QCOMPARE(m_proxy->index(0, 0).data(Notifications::SummaryRole).toString(), QStringLiteral("Erika"));
+
+    m_proxy->setSourceModel(nullptr);
+}
+
+QTEST_GUILESS_MAIN(GroupingProxyModelTest)
+
