+bool NotificationGroupingProxyModel::groupsMatch(const QModelIndex &a, const QModelIndex &b) const
+{
+    if (!appsMatch(a, b)) {
+        return false;
+    }
+
+    if (!m_groupConversations) {
+        return true;
+    }
+
+    // The conversation the application names, otherwise the summary (e.g. the sender of a message).
+    // Both are empty when only the application may be shown, the notifications then group by application.
+    const auto conversationKey = [](const QModelIndex &idx) -> QString {
+        // the summary of a job changes while it runs, the jobs of an application stay together
+        if (idx.data(Notifications::TypeRole).toInt() == Notifications::JobType) {
+            return QStringLiteral("j:");
+        }
+        const QString conversation = idx.data(Notifications::ConversationRole).toString();
+        if (!conversation.isEmpty()) {
+            return QStringLiteral("c:") + conversation;
+        }
+        return QStringLiteral("s:") + idx.data(Notifications::SummaryRole).toString();
+    };
+
+    return conversationKey(a) == conversationKey(b);
+}
+
+bool NotificationGroupingProxyModel::groupConversations() const
+{
+    return m_groupConversations;
+}
+
+void NotificationGroupingProxyModel::setGroupConversations(bool groupConversations)
+{
+    if (m_groupConversations == groupConversations) {
+        return;
+    }
+
+    m_groupConversations = groupConversations;
+
+    if (sourceModel()) {
+        regroup();
+    }
+}
+
+void NotificationGroupingProxyModel::regroup()
+{
+    beginResetModel();
+    rebuildMap();
+    endResetModel();
+}
+
+bool NotificationGroupingProxyModel::isGroupedCorrectly(int sourceRow) const
+{
+    const QModelIndex sourceIndex = sourceModel()->index(sourceRow, 0);
+
+    for (int i = 0; i < rowMap.count(); ++i) {
+        const QList<int> *sourceRows = rowMap.at(i);
+        if (sourceRows->contains(sourceRow)) {
+            if (sourceRows->count() > 1) {
+                // still belongs to the other members of its group
+                const int other = sourceRows->constFirst() != sourceRow ? sourceRows->constFirst() : sourceRows->at(1);
+                return groupsMatch(sourceIndex, sourceModel()->index(other, 0));
+            }
+            continue;
+        }
+
+        // a single notification that now belongs to another group
+        if (groupsMatch(sourceIndex, sourceModel()->index(sourceRows->constFirst(), 0))) {
+            return false;
+        }
+    }
+
+    return true;
+}
