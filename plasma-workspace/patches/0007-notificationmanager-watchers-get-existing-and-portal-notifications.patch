+void Server::notifyWatchers(const QVariantList &notifyArguments, const QString &service)
+{
+    const QStringList services = service.isEmpty() ? d->m_notificationWatchers->watchedServices() : QStringList{service};
+    for (const QString &watcher : services) {
+        QDBusMessage msg = QDBusMessage::createMethodCall(watcher,
+                                                          QStringLiteral("/NotificationWatcher"),
+                                                          QStringLiteral("org.kde.NotificationWatcher"),
+                                                          QStringLiteral("Notify"));
+        msg.setArguments(notifyArguments);
+        QDBusConnection::sessionBus().call(msg, QDBus::NoBlock);
+    }
+}
+
+void Server::closeOnWatchers(uint id)
+{
+    for (const QString &watcher : d->m_notificationWatchers->watchedServices()) {
+        QDBusMessage msg = QDBusMessage::createMethodCall(watcher,
+                                                          QStringLiteral("/NotificationWatcher"),
+                                                          QStringLiteral("org.kde.NotificationWatcher"),
+                                                          QStringLiteral("CloseNotification"));
+        msg.setArguments({id});
+        QDBusConnection::sessionBus().call(msg, QDBus::NoBlock);
+    }
+}
+
 void Server::closeNotification(uint notificationId, CloseReason reason)
 {
     d->m_notificationServices.remove(notificationId);
