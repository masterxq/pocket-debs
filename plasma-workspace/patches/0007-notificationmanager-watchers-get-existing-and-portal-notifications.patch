From: pocket-debs <masterxq@users.noreply.github.com>
Date: Sat, 28 Nov 2026 12:23:05 +0100
Subject: [PATCH] notificationmanager: watchers get the existing and the portal notifications
Description:
 A notification watcher (the lock screen) only saw notifications that
 arrived after it registered, without the desktop entry the server
 resolved itself, and never notifications of the portal.
 .
 The server keeps the watcher arguments with each notification and sends
 the notifications of the model to a watcher when it registers. Portal
 notifications go to the watchers as well (added, replaced, removed);
 actions a watcher invokes on them go to the portal.
Author: masterxq <masterxq@users.noreply.github.com>
Forwarded: no
License: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL (as the patched files)
Last-Update: 2026-11-28
---
diff --git a/libnotificationmanager/notificationsmodel.cpp b/libnotificationmanager/notificationsmodel.cpp
index 21a1fceff4..1cc1fe803a 100644
--- a/libnotificationmanager/notificationsmodel.cpp
+++ b/libnotificationmanager/notificationsmodel.cpp
@@ -35,6 +35,17 @@ NotificationsModel::NotificationsModel()
     connect(&Server::self(), &Server::notificationRemoved, this, [this](uint removedId, Server::CloseReason reason) {
         onNotificationRemoved(removedId, reason);
     });
+    connect(&Server::self(), &Server::watcherRegistered, this, [this](const QString &service) {
+        // A watcher (the lock screen) gets the notifications that are already there
+        const auto notificationList = notifications();
+        for (const Notification &notification : notificationList) {
+            QVariantList arguments = notification.d->watcherArguments;
+            if (arguments.size() > 2) {
+                arguments[2] = 0u; // replaces_id
+                Server::self().notifyWatchers(arguments, service);
+            }
+        }
+    });
     connect(&Server::self(), &Server::serviceOwnershipLost, this, [this] {
         // Expire all notifications as we're defunct now
         const auto notificationList = notifications();
diff --git a/libnotificationmanager/portalnotificationsmodel.cpp b/libnotificationmanager/portalnotificationsmodel.cpp
index b0f0154a14..89201b219c 100644
--- a/libnotificationmanager/portalnotificationsmodel.cpp
+++ b/libnotificationmanager/portalnotificationsmodel.cpp
@@ -31,16 +31,92 @@ PortalNotificationsModel::PortalNotificationsModel()
 {
     connect(&Portal::self(), &Portal::notificationAdded, this, [this](const Notification &notification) {
         onNotificationAdded(notification);
+        Server::self().notifyWatchers(watcherArguments(notification, 0));
     });
     connect(&Portal::self(), &Portal::notificationReplaced, this, [this](uint replacedId, const Notification &notification) {
         onNotificationReplaced(replacedId, notification);
+        Server::self().notifyWatchers(watcherArguments(notification, replacedId));
     });
     connect(&Portal::self(), &Portal::notificationRemoved, this, [this](uint removedId) {
         onNotificationRemoved(removedId, Server::CloseReason::Revoked);
+        Server::self().closeOnWatchers(removedId);
+    });
+    // Watchers (the lock screen) show portal notifications as well
+    connect(&Server::self(), &Server::watcherRegistered, this, [this](const QString &service) {
+        const auto notificationList = notifications();
+        for (const Notification &notification : notificationList) {
+            Server::self().notifyWatchers(watcherArguments(notification, 0), service);
+        }
+    });
+    connect(&Server::self(), &Server::watcherInvokedAction, this, [this](uint id, const QString &actionName) {
+        if (rowOfNotification(id) < 0) {
+            return;
+        }
+        if (actionName == QLatin1String("default")) {
+            invokeDefaultAction(id, Notifications::None);
+        } else {
+            invokeAction(id, actionName, Notifications::None);
+        }
     });
     Portal::self().init();
 }
 
+QVariantList PortalNotificationsModel::watcherArguments(const Notification &notification, uint replacesId)
+{
+    QStringList actions;
+    if (notification.hasDefaultAction()) {
+        actions << QStringLiteral("default") << notification.defaultActionLabel();
+    }
+    const QStringList actionNames = notification.actionNames();
+    const QStringList actionLabels = notification.actionLabels();
+    for (int i = 0; i < actionNames.size() && i < actionLabels.size(); ++i) {
+        actions << actionNames.at(i) << actionLabels.at(i);
+    }
+
+    QVariantMap hints;
+    hints.insert(QStringLiteral("desktop-entry"), notification.desktopEntry());
+    if (!notification.category().isEmpty()) {
+        hints.insert(QStringLiteral("category"), notification.category());
+    }
+    switch (notification.urgency()) {
+    case Notifications::LowUrgency:
+        hints.insert(QStringLiteral("urgency"), 0);
+        break;
+    case Notifications::NormalUrgency:
+        hints.insert(QStringLiteral("urgency"), 1);
+        break;
+    case Notifications::CriticalUrgency:
+        hints.insert(QStringLiteral("urgency"), 2);
+        break;
+    }
+    switch (notification.lockScreenVisibility()) {
+    case Notifications::VisibilityFull:
+        break;
+    case Notifications::VisibilitySender:
+        hints.insert(QStringLiteral("x-kde-lock-screen-visibility"), QStringLiteral("sender"));
+        break;
+    case Notifications::VisibilityApplication:
+        hints.insert(QStringLiteral("x-kde-lock-screen-visibility"), QStringLiteral("application"));
+        break;
+    case Notifications::VisibilityHidden:
+        hints.insert(QStringLiteral("x-kde-lock-screen-visibility"), QStringLiteral("hidden"));
+        break;
+    }
+    if (!notification.icon().isEmpty()) {
+        hints.insert(QStringLiteral("image-path"), notification.icon());
+    }
+
+    return {notification.id(),
+            notification.applicationName(),
+            replacesId,
+            notification.applicationIconName(),
+            notification.summary(),
+            notification.rawBody(),
+            actions,
+            hints,
+            notification.timeout()};
+}
+
 void PortalNotificationsModel::expire(uint notificationId)
 {
     if (rowOfNotification(notificationId) > -1) {
