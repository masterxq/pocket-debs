+    }
+}
+
+bool NotificationVisibilityProxyModel::isMessageCategory(const QString &category)
+{
+    // freedesktop categories im, im.received, email.arrived, portal call.incoming, ...
+    for (const auto &prefix : {u"im"_s, u"email"_s, u"call"_s}) {
+        if (category == prefix || category.startsWith(prefix + u'.')) {
+            return true;
+        }
+    }
+    return category == "x-kde.incoming-call"_L1;
+}
+
+Notifications::Visibility NotificationVisibilityProxyModel::visibilityOf(const QModelIndex &sourceIdx) const
+{
+    if (sourceIdx.data(Notifications::TypeRole).toInt() != Notifications::NotificationType) {
+        return Notifications::VisibilityFull;
+    }
+
+    int visibility = m_visibility;
+    if (m_lockScreen) {
+        visibility = std::max(visibility, sourceIdx.data(Notifications::LockScreenVisibilityRole).toInt());
+
+        const QString desktopEntry = sourceIdx.data(Notifications::DesktopEntryRole).toString();
+        if (!desktopEntry.isEmpty()) {
+            visibility = std::max(visibility, m_applications.value(desktopEntry, int(Notifications::VisibilityFull)).toInt());
+        }
+        const QString notifyRcName = sourceIdx.data(Notifications::NotifyRcNameRole).toString();
+        if (!notifyRcName.isEmpty()) {
+            visibility = std::max(visibility, m_services.value(notifyRcName, int(Notifications::VisibilityFull)).toInt());
+        }
+    }
+
+    // Only messages have a sender in their summary
+    if (visibility == Notifications::VisibilitySender && sourceIdx.data(Notifications::PublicSummaryRole).toString().isEmpty()
+        && !isMessageCategory(sourceIdx.data(Notifications::CategoryRole).toString())) {
+        visibility = Notifications::VisibilityApplication;
+    }
+
+    return static_cast<Notifications::Visibility>(std::clamp(visibility, int(Notifications::VisibilityFull), int(Notifications::VisibilityHidden)));
+}
+
+bool NotificationVisibilityProxyModel::filterAcceptsRow(int source_row, const QModelIndex &source_parent) const
+{
+    return visibilityOf(sourceModel()->index(source_row, 0, source_parent)) != Notifications::VisibilityHidden;
+}
+
+QVariant NotificationVisibilityProxyModel::data(const QModelIndex &index, int role) const
+{
+    const QModelIndex sourceIdx = mapToSource(index);
+    const Notifications::Visibility visibility = visibilityOf(sourceIdx);
+
+    if (role == Notifications::VisibilityRole) {
+        return visibility;
+    }
+    if (visibility == Notifications::VisibilityFull) {
+        return sourceIdx.data(role);
+    }
+
+    const bool sender = visibility == Notifications::VisibilitySender;
+    switch (role) {
+    case Notifications::SummaryRole: {
+        if (!sender) {
+            return QString();
+        }
+        const QString publicSummary = sourceIdx.data(Notifications::PublicSummaryRole).toString();
+        return publicSummary.isEmpty() ? sourceIdx.data(role) : publicSummary;
+    }
+    case Notifications::ImageRole:
+    case Notifications::IconNameRole:
+        // the image of a message shows the sender (avatar), others show content
+        if (sender && isMessageCategory(sourceIdx.data(Notifications::CategoryRole).toString())) {
+            return sourceIdx.data(role);
+        }
+        return role == Notifications::ImageRole ? QVariant() : QVariant(QString());
+    case Notifications::OriginNameRole:
+        return sender ? sourceIdx.data(role) : QVariant(QString());
+    case Notifications::BodyRole:
+    case Notifications::DefaultActionLabelRole:
+    case Notifications::ReplyActionLabelRole:
+    case Notifications::ReplyPlaceholderTextRole:
+    case Notifications::ReplySubmitButtonTextRole:
+    case Notifications::ReplySubmitButtonIconNameRole:
+        return QString();
+    case Notifications::ActionNamesRole:
+    case Notifications::ActionLabelsRole:
+        return QStringList();
+    case Notifications::HasReplyActionRole:
+        return false;
+    case Notifications::UrlsRole:
+        return QVariant::fromValue(QList<QUrl>());
+    case Notifications::HintsRole:
+        return QVariantMap();
+    }
+
+    return sourceIdx.data(role);
+}
