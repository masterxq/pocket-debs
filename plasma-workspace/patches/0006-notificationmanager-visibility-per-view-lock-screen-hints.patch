+
+namespace NotificationManager
+{
+/**
+ * Applies the visibility of a view (popups, history, lock screen): leaves
+ * out hidden notifications and empties the roles with content of the others.
+ */
+class NotificationVisibilityProxyModel : public QSortFilterProxyModel
+{
+    Q_OBJECT
+
+public:
+    explicit NotificationVisibilityProxyModel(QObject *parent = nullptr);
+    ~NotificationVisibilityProxyModel() override;
+
+    Notifications::Visibility visibility() const;
+    void setVisibility(Notifications::Visibility visibility);
+
+    bool lockScreen() const;
+    void setLockScreen(bool lockScreen);
+
+    QVariantMap applications() const;
+    void setApplications(const QVariantMap &visibilities);
+
+    QVariantMap services() const;
+    void setServices(const QVariantMap &visibilities);
+
+    QVariant data(const QModelIndex &index, int role) const override;
+
+    static bool isMessageCategory(const QString &category);
+
+Q_SIGNALS:
+    void visibilityChanged();
+    void lockScreenChanged();
+    void applicationsChanged();
+    void servicesChanged();
+
+protected:
+    bool filterAcceptsRow(int source_row, const QModelIndex &source_parent) const override;
+
+private:
+    Notifications::Visibility visibilityOf(const QModelIndex &sourceIdx) const;
+
+    Notifications::Visibility m_visibility = Notifications::VisibilityFull;
+    bool m_lockScreen = false;
+    QVariantMap m_applications;
+    QVariantMap m_services;
+};
+
+} // namespace NotificationManager
