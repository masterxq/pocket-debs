+Notifications::Visibility NotificationVisibilityProxyModel::visibility() const
+{
+    return m_visibility;
+}
+
+void NotificationVisibilityProxyModel::setVisibility(Notifications::Visibility visibility)
+{
+    if (m_visibility != visibility) {
+        m_visibility = visibility;
+        invalidate();
+        Q_EMIT visibilityChanged();
+    }
+}
