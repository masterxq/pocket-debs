@@ -437,6 +437,19 @@ void Notification::Private::processFdoHints(const QVariantMap &hints)
 
     category = hints.value(QStringLiteral("category")).toString();
 
+    // Visibility on the lock screen, an unknown value hides the notification there
+    const QString lockScreenVisibilityHint = hints.value(QStringLiteral("x-kde-lock-screen-visibility")).toString();
+    if (lockScreenVisibilityHint == "full"_L1) {
+        lockScreenVisibility = Notifications::VisibilityFull;
+    } else if (lockScreenVisibilityHint == "sender"_L1) {
+        lockScreenVisibility = Notifications::VisibilitySender;
+    } else if (lockScreenVisibilityHint == "application"_L1) {
+        lockScreenVisibility = Notifications::VisibilityApplication;
+    } else if (!lockScreenVisibilityHint.isEmpty()) {
+        lockScreenVisibility = Notifications::VisibilityHidden;
+    }
+    publicSummary = hints.value(QStringLiteral("x-kde-public-summary")).toString();
+
     // Underscored hints was in use in version 1.1 of the spec but has been
     // replaced by dashed hints in version 1.2. We need to support it for
     // users of the 1.2 version of the spec.
@@ -491,10 +504,20 @@ void Notification::Private::processPortalProperties(const QVariantMap &props)
         // TODO add high urgency
     } else if (priority == "normal"_L1 || priority == "high"_L1) {
         setUrgency(Notifications::NormalUrgency);
-    } else if (priority == "high"_L1) {
+    } else if (priority == "urgent"_L1) {
         setUrgency(Notifications::CriticalUrgency);
     }
 
+    category = props.value(u"category"_s).toString();
+
+    QStringList displayHints = props.value(u"display-hint"_s).toStringList();
+    displayHints += props.value(u"display-hints"_s).toStringList();
+    if (displayHints.contains(u"hide-on-lock-screen"_s)) {
+        lockScreenVisibility = Notifications::VisibilityHidden;
+    } else if (displayHints.contains(u"hide-content-on-lock-screen"_s)) {
+        lockScreenVisibility = Notifications::VisibilityApplication;
+    }
