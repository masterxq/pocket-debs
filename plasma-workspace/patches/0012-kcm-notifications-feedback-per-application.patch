From: pocket-debs <masterxq@users.noreply.github.com>
Date: Sat, 28 Nov 2026 13:03:44 +0100
Subject: [PATCH] kcms/notifications: feedback per application
Description:
 A setting per application for the feedback of new notifications, with
 German translation. Changing the lock screen visibility or the feedback
 of an application marks the module as changed, so it can be applied.
 .
 The lists of the privacy section were empty: the model of their entries
 had become part of the expression of notificationsAvailable.
 They showed no value either: the binding of the current index was
 evaluated before the entries were there and depends on their count now.
Author: masterxq <masterxq@users.noreply.github.com>
Forwarded: no
License: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL (as the patched files)
Last-Update: 2026-11-28
---
diff --git a/kcms/notifications/kcm.cpp b/kcms/notifications/kcm.cpp
index 41c63aee90..7ffa3b9aa3 100644
--- a/kcms/notifications/kcm.cpp
+++ b/kcms/notifications/kcm.cpp
@@ -271,6 +271,8 @@ void KCMNotifications::createConnections(NotificationManager::BehaviorSettings *
     connect(settings, &NotificationManager::BehaviorSettings::ShowPopupsInDndModeChanged, this, &KCMNotifications::settingsChanged);
     connect(settings, &NotificationManager::BehaviorSettings::ShowInHistoryChanged, this, &KCMNotifications::settingsChanged);
     connect(settings, &NotificationManager::BehaviorSettings::ShowBadgesChanged, this, &KCMNotifications::settingsChanged);
+    connect(settings, &NotificationManager::BehaviorSettings::LockScreenVisibilityChanged, this, &KCMNotifications::settingsChanged);
+    connect(settings, &NotificationManager::BehaviorSettings::FeedbackChanged, this, &KCMNotifications::settingsChanged);
 
     connect(settings, &NotificationManager::BehaviorSettings::ShowPopupsChanged, this, [this, index] {
         updateModelIsDefaultStatus(index);
@@ -284,6 +286,12 @@ void KCMNotifications::createConnections(NotificationManager::BehaviorSettings *
     connect(settings, &NotificationManager::BehaviorSettings::ShowBadgesChanged, this, [this, index] {
         updateModelIsDefaultStatus(index);
     });
+    connect(settings, &NotificationManager::BehaviorSettings::LockScreenVisibilityChanged, this, [this, index] {
+        updateModelIsDefaultStatus(index);
+    });
+    connect(settings, &NotificationManager::BehaviorSettings::FeedbackChanged, this, [this, index] {
+        updateModelIsDefaultStatus(index);
+    });
 }
 
 QUrl KCMNotifications::soundsLocation()
diff --git a/kcms/notifications/ui/ApplicationConfiguration.qml b/kcms/notifications/ui/ApplicationConfiguration.qml
index 440e40dacf..54d64b6402 100644
--- a/kcms/notifications/ui/ApplicationConfiguration.qml
+++ b/kcms/notifications/ui/ApplicationConfiguration.qml
@@ -149,6 +149,26 @@ ColumnLayout {
                         }
                     }
 
+                    QQC2.ComboBox {
+                        Kirigami.FormData.label: i18nc("@label:listbox", "New notifications:")
+                        textRole: "text"
+                        valueRole: "value"
+                        // values of NotificationManager.Settings.Feedback
+                        model: [
+                            { value: 1, text: i18nc("@item:inlistbox feedback of new notifications", "Sound, vibration and light") },
+                            { value: 2, text: i18nc("@item:inlistbox feedback of new notifications", "Vibration and light") },
+                            { value: 3, text: i18nc("@item:inlistbox feedback of new notifications", "Only light (muted)") },
+                            { value: 4, text: i18nc("@item:inlistbox feedback of new notifications", "None") },
+                        ]
+                        currentIndex: !!behaviorSettings ? indexOfValue(behaviorSettings.feedback) : 0
+                        onActivated: behaviorSettings.feedback = currentValue
+
+                        KCM.SettingStateBinding {
+                            configObject: behaviorSettings
+                            settingName: "Feedback"
+                        }
+                    }
+
                     QQC2.CheckBox {
                         text: i18n("Show in history")
                         checked: !!behaviorSettings && behaviorSettings.showInHistory
diff --git a/kcms/notifications/ui/main.qml b/kcms/notifications/ui/main.qml
index 72de099311..8d0da22aef 100644
--- a/kcms/notifications/ui/main.qml
+++ b/kcms/notifications/ui/main.qml
@@ -26,6 +26,7 @@ KCM.SimpleKCM {
     readonly property NotificationManager.ServerInfo currentOwnerInfo: NotificationManager.Server.currentOwner
 
     readonly property bool notificationsAvailable: currentOwnerInfo.status === NotificationManager.ServerInfo.Running
+        && currentOwnerInfo.vendor === ourServerVendor && currentOwnerInfo.name === ourServerName
 
     // values of NotificationManager.Notifications.Visibility
     readonly property var visibilityModel: [
@@ -34,7 +35,6 @@ KCM.SimpleKCM {
         { value: 3, text: i18nc("@item:inlistbox what notifications show", "Only the application") },
         { value: 4, text: i18nc("@item:inlistbox what notifications show", "Nothing") },
     ]
-        && currentOwnerInfo.vendor === ourServerVendor && currentOwnerInfo.name === ourServerName
 
     function openSourcesSettings(args) {
         // TODO would be nice to re-use the current SourcesPage instead of pushing a new one that lost all state
@@ -234,7 +234,8 @@ KCM.SimpleKCM {
             textRole: "text"
             valueRole: "value"
             model: root.visibilityModel
-            currentIndex: indexOfValue(kcm.notificationSettings.lockScreenVisibility)
+            // depends on count: the model is not there yet when the binding is first evaluated
+            currentIndex: count > 0 ? indexOfValue(kcm.notificationSettings.lockScreenVisibility) : -1
             onActivated: kcm.notificationSettings.lockScreenVisibility = currentValue
 
             KCM.SettingStateBinding {
@@ -249,7 +250,8 @@ KCM.SimpleKCM {
             textRole: "text"
             valueRole: "value"
             model: root.visibilityModel
-            currentIndex: indexOfValue(kcm.notificationSettings.popupVisibility)
+            // depends on count: the model is not there yet when the binding is first evaluated
+            currentIndex: count > 0 ? indexOfValue(kcm.notificationSettings.popupVisibility) : -1
             onActivated: kcm.notificationSettings.popupVisibility = currentValue
 
             KCM.SettingStateBinding {
@@ -264,7 +266,8 @@ KCM.SimpleKCM {
             textRole: "text"
             valueRole: "value"
             model: root.visibilityModel
-            currentIndex: indexOfValue(kcm.notificationSettings.historyVisibility)
+            // depends on count: the model is not there yet when the binding is first evaluated
+            currentIndex: count > 0 ? indexOfValue(kcm.notificationSettings.historyVisibility) : -1
             onActivated: kcm.notificationSettings.historyVisibility = currentValue
 
             KCM.SettingStateBinding {
