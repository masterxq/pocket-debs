+
+#include "kwin_export.h"
+
+#include <QObject>
+
+#include <memory>
+
+struct wl_resource;
+
+namespace KWin
+{
+
+class Display;
+class BackNavigationV1Interface;
+class BackNavigationV1InterfacePrivate;
+class BackNavigationManagerV1InterfacePrivate;
+class BackNavigationShellV1InterfacePrivate;
+class XdgToplevelInterface;
+
+/**
+ * The BackNavigationManagerV1Interface implements the kde_back_navigation_manager_v1 global,
+ * through which clients report whether back has an effect in a toplevel.
+ */
+class KWIN_EXPORT BackNavigationManagerV1Interface : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit BackNavigationManagerV1Interface(Display *display, QObject *parent = nullptr);
+    ~BackNavigationManagerV1Interface() override;
+
+    /**
+     * Returns the back navigation object of @p toplevel, or @c null if it has none.
+     */
+    BackNavigationV1Interface *backNavigationForToplevel(XdgToplevelInterface *toplevel) const;
+
+Q_SIGNALS:
+    void backNavigationCreated(BackNavigationV1Interface *backNavigation);
+
+private:
+    std::unique_ptr<BackNavigationManagerV1InterfacePrivate> d;
+};
+
+/**
+ * The BackNavigationV1Interface represents a kde_back_navigation_v1 object, the back navigation
+ * state of one xdg_toplevel.
+ *
+ * The object is destroyed together with its resource. When that happens while the state is
+ * available, availableChanged() is emitted with @c false first.
+ */
+class KWIN_EXPORT BackNavigationV1Interface : public QObject
+{
+    Q_OBJECT
+
+public:
+    ~BackNavigationV1Interface() override;
+
+    /**
+     * Returns the toplevel, or @c null if it has been destroyed. Without a toplevel the object
+     * is inert.
+     */
+    XdgToplevelInterface *toplevel() const;
+
+    /**
+     * Whether back currently has an effect in the toplevel.
+     */
+    bool isAvailable() const;
+
+    /**
+     * Sends the back event to the client. Does nothing if the state is not available.
+     */
+    void sendBack();
+
+Q_SIGNALS:
+    void availableChanged(bool available);
+
+private:
+    BackNavigationV1Interface(wl_resource *resource, XdgToplevelInterface *toplevel);
+    friend class BackNavigationManagerV1InterfacePrivate;
+    std::unique_ptr<BackNavigationV1InterfacePrivate> d;
+};
+
+/**
+ * The BackNavigationShellV1Interface implements the kde_back_navigation_shell_v1 global. It gives
+ * clients that hold an org_kde_plasma_window access to the back navigation state of that window
+ * (PlasmaWindowInterface::isBackAvailable()) and forwards their back requests
+ * (PlasmaWindowInterface::backRequested()).
+ */
+class KWIN_EXPORT BackNavigationShellV1Interface : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit BackNavigationShellV1Interface(Display *display, QObject *parent = nullptr);
+    ~BackNavigationShellV1Interface() override;
+
+private:
+    std::unique_ptr<BackNavigationShellV1InterfacePrivate> d;
+};
+
+}
