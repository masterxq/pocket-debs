+void XdgToplevelWindow::installBackNavigationV1(BackNavigationV1Interface *backNavigation)
+{
+    if (m_backNavigation == backNavigation) {
+        return;
+    }
+    m_backNavigation = backNavigation;
+
+    // Destroying the object emits availableChanged(false) first if it was available.
+    connect(backNavigation, &BackNavigationV1Interface::availableChanged, this, &Window::backAvailableChanged);
+    if (backNavigation->isAvailable()) {
+        Q_EMIT backAvailableChanged(true);
+    }
+}
+
+bool XdgToplevelWindow::isBackAvailable() const
+{
+    return m_backNavigation && m_backNavigation->isAvailable();
+}
+
+void XdgToplevelWindow::requestBack()
+{
+    if (!m_backNavigation || isDeleted()) {
+        return;
+    }
+    // Back is user input to the window: not while a modal dialog blocks the window or while
+    // the session is locked (unless the window is shown above the lock screen).
+    if (findModal()) {
+        return;
+    }
+    if (waylandServer()->isScreenLocked() && !isLockScreenOverlay()) {
+        return;
+    }
+    m_backNavigation->sendBack();
+}
