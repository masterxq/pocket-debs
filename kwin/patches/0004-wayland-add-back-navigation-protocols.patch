diff --git a/src/wayland/backnavigation_v1.cpp b/src/wayland/backnavigation_v1.cpp
new file mode 100644
index 0000000..30d1ec9
--- /dev/null
+++ b/src/wayland/backnavigation_v1.cpp
@@ -0,0 +1,278 @@
+/*
+    SPDX-FileCopyrightText: 2026 masterxq
+
+    SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+*/
+
+#include "backnavigation_v1.h"
+
+#include "display.h"
+#include "plasmawindowmanagement.h"
+#include "xdgshell.h"
+
+#include "qwayland-server-kde-back-navigation-shell-v1.h"
+#include "qwayland-server-kde-back-navigation-v1.h"
+
+#include <QHash>
+#include <QPointer>
+
+namespace KWin
+{
+
+static constexpr int s_managerVersion = 1;
+static constexpr int s_shellVersion = 1;
+
+class BackNavigationManagerV1InterfacePrivate : public QtWaylandServer::kde_back_navigation_manager_v1
+{
+public:
+    BackNavigationManagerV1InterfacePrivate(Display *display, BackNavigationManagerV1Interface *q);
+
+    BackNavigationManagerV1Interface *const q;
+    QHash<XdgToplevelInterface *, BackNavigationV1Interface *> objects;
+
+protected:
+    void kde_back_navigation_manager_v1_destroy(Resource *resource) override;
+    void kde_back_navigation_manager_v1_get_back_navigation(Resource *resource, uint32_t id, wl_resource *toplevel) override;
+};
+
+class BackNavigationV1InterfacePrivate : public QtWaylandServer::kde_back_navigation_v1
+{
+public:
+    BackNavigationV1InterfacePrivate(wl_resource *resource, BackNavigationV1Interface *q);
+
+    void setAvailable(bool set);
+
+    BackNavigationV1Interface *const q;
+    QPointer<XdgToplevelInterface> toplevel;
+    bool available = false;
+
+protected:
+    void kde_back_navigation_v1_destroy(Resource *resource) override;
+    void kde_back_navigation_v1_destroy_resource(Resource *resource) override;
+    void kde_back_navigation_v1_set_state(Resource *resource, uint32_t state) override;
+};
+
+BackNavigationManagerV1InterfacePrivate::BackNavigationManagerV1InterfacePrivate(Display *display, BackNavigationManagerV1Interface *q)
+    : QtWaylandServer::kde_back_navigation_manager_v1(*display, s_managerVersion)
+    , q(q)
+{
+}
+
+void BackNavigationManagerV1InterfacePrivate::kde_back_navigation_manager_v1_destroy(Resource *resource)
+{
+    wl_resource_destroy(resource->handle);
+}
+
+void BackNavigationManagerV1InterfacePrivate::kde_back_navigation_manager_v1_get_back_navigation(Resource *resource, uint32_t id, wl_resource *toplevelResource)
+{
+    XdgToplevelInterface *toplevel = XdgToplevelInterface::get(toplevelResource);
+    if (!toplevel) {
+        wl_resource_post_error(resource->handle, WL_DISPLAY_ERROR_INVALID_OBJECT, "invalid xdg_toplevel");
+        return;
+    }
+    if (objects.contains(toplevel)) {
+        wl_resource_post_error(resource->handle, error_already_constructed, "the xdg_toplevel already has a kde_back_navigation_v1");
+        return;
+    }
+
+    wl_resource *objectResource = wl_resource_create(resource->client(), &kde_back_navigation_v1_interface, resource->version(), id);
+    if (!objectResource) {
+        wl_resource_post_no_memory(resource->handle);
+        return;
+    }
+
+    auto object = new BackNavigationV1Interface(objectResource, toplevel);
+    objects.insert(toplevel, object);
+
+    // The entry goes away with whichever of the two is destroyed first; a toplevel at the same
+    // address can then get a new object.
+    auto remove = [this, toplevel, object]() {
+        objects.removeIf([toplevel, object](const std::pair<XdgToplevelInterface *, BackNavigationV1Interface *> &entry) {
+            return entry.first == toplevel && entry.second == object;
+        });
+    };
+    QObject::connect(object, &QObject::destroyed, q, remove);
+    QObject::connect(toplevel, &QObject::destroyed, q, remove);
+    QObject::connect(toplevel, &QObject::destroyed, object, [object]() {
+        object->d->setAvailable(false);
+    });
+
+    Q_EMIT q->backNavigationCreated(object);
+}
+
+BackNavigationManagerV1Interface::BackNavigationManagerV1Interface(Display *display, QObject *parent)
+    : QObject(parent)
+    , d(std::make_unique<BackNavigationManagerV1InterfacePrivate>(display, this))
+{
+}
+
+BackNavigationManagerV1Interface::~BackNavigationManagerV1Interface() = default;
+
+BackNavigationV1Interface *BackNavigationManagerV1Interface::backNavigationForToplevel(XdgToplevelInterface *toplevel) const
+{
+    return d->objects.value(toplevel);
+}
+
+BackNavigationV1InterfacePrivate::BackNavigationV1InterfacePrivate(wl_resource *resource, BackNavigationV1Interface *q)
+    : QtWaylandServer::kde_back_navigation_v1(resource)
+    , q(q)
+{
+}
+
+void BackNavigationV1InterfacePrivate::setAvailable(bool set)
+{
+    if (available == set) {
+        return;
+    }
+    available = set;
+    Q_EMIT q->availableChanged(available);
+}
+
+void BackNavigationV1InterfacePrivate::kde_back_navigation_v1_destroy(Resource *resource)
+{
+    wl_resource_destroy(resource->handle);
+}
+
+void BackNavigationV1InterfacePrivate::kde_back_navigation_v1_destroy_resource(Resource *resource)
+{
+    setAvailable(false);
+    delete q;
+}
+
+void BackNavigationV1InterfacePrivate::kde_back_navigation_v1_set_state(Resource *resource, uint32_t state)
+{
+    if (state != state_unavailable && state != state_available) {
+        wl_resource_post_error(resource->handle, error_invalid_state, "invalid back navigation state %u", state);
+        return;
+    }
+    if (!toplevel) {
+        return;
+    }
+    setAvailable(state == state_available);
+}
+
+BackNavigationV1Interface::BackNavigationV1Interface(wl_resource *resource, XdgToplevelInterface *toplevel)
+    : d(std::make_unique<BackNavigationV1InterfacePrivate>(resource, this))
+{
+    d->toplevel = toplevel;
+}
+
+BackNavigationV1Interface::~BackNavigationV1Interface() = default;
+
+XdgToplevelInterface *BackNavigationV1Interface::toplevel() const
+{
+    return d->toplevel;
+}
+
+bool BackNavigationV1Interface::isAvailable() const
+{
+    return d->available;
+}
+
+void BackNavigationV1Interface::sendBack()
+{
+    if (!d->toplevel || !d->available) {
+        return;
+    }
+    d->send_back();
+}
+
+class BackNavigationWindowV1 : public QtWaylandServer::kde_back_navigation_window_v1
+{
+public:
+    BackNavigationWindowV1(wl_resource *resource, PlasmaWindowInterface *window);
+    ~BackNavigationWindowV1() override;
+
+    QPointer<PlasmaWindowInterface> window;
+    QMetaObject::Connection availableConnection;
+
+protected:
+    void kde_back_navigation_window_v1_destroy(Resource *resource) override;
+    void kde_back_navigation_window_v1_destroy_resource(Resource *resource) override;
+    void kde_back_navigation_window_v1_back(Resource *resource) override;
+};
+
+class BackNavigationShellV1InterfacePrivate : public QtWaylandServer::kde_back_navigation_shell_v1
+{
+public:
+    BackNavigationShellV1InterfacePrivate(Display *display);
+
+protected:
+    void kde_back_navigation_shell_v1_destroy(Resource *resource) override;
+    void kde_back_navigation_shell_v1_get_window(Resource *resource, uint32_t id, wl_resource *window) override;
+};
+
+static uint32_t windowState(PlasmaWindowInterface *window)
+{
+    return window->isBackAvailable() ? QtWaylandServer::kde_back_navigation_window_v1::state_available
+                                     : QtWaylandServer::kde_back_navigation_window_v1::state_unavailable;
+}
+
+BackNavigationWindowV1::BackNavigationWindowV1(wl_resource *resource, PlasmaWindowInterface *window)
+    : QtWaylandServer::kde_back_navigation_window_v1(resource)
+    , window(window)
+{
+    if (!window) {
+        return;
+    }
+    // The connection ends when the window is destroyed; the object is inert from then on.
+    availableConnection = QObject::connect(window, &PlasmaWindowInterface::backAvailableChanged, window, [this]() {
+        send_state(windowState(this->window));
+    });
+    send_state(windowState(window));
+}
+
+BackNavigationWindowV1::~BackNavigationWindowV1()
+{
+    QObject::disconnect(availableConnection);
+}
+
+void BackNavigationWindowV1::kde_back_navigation_window_v1_destroy(Resource *resource)
+{
+    wl_resource_destroy(resource->handle);
+}
+
+void BackNavigationWindowV1::kde_back_navigation_window_v1_destroy_resource(Resource *resource)
+{
+    delete this;
+}
+
+void BackNavigationWindowV1::kde_back_navigation_window_v1_back(Resource *resource)
+{
+    if (window) {
+        window->requestBack();
+    }
+}
+
+BackNavigationShellV1InterfacePrivate::BackNavigationShellV1InterfacePrivate(Display *display)
+    : QtWaylandServer::kde_back_navigation_shell_v1(*display, s_shellVersion)
+{
+}
+
+void BackNavigationShellV1InterfacePrivate::kde_back_navigation_shell_v1_destroy(Resource *resource)
+{
+    wl_resource_destroy(resource->handle);
+}
+
+void BackNavigationShellV1InterfacePrivate::kde_back_navigation_shell_v1_get_window(Resource *resource, uint32_t id, wl_resource *windowResource)
+{
+    wl_resource *objectResource = wl_resource_create(resource->client(), &kde_back_navigation_window_v1_interface, resource->version(), id);
+    if (!objectResource) {
+        wl_resource_post_no_memory(resource->handle);
+        return;
+    }
+    // An org_kde_plasma_window whose window is already gone yields an inert object.
+    new BackNavigationWindowV1(objectResource, PlasmaWindowInterface::get(windowResource));
+}
+
+BackNavigationShellV1Interface::BackNavigationShellV1Interface(Display *display, QObject *parent)
+    : QObject(parent)
+    , d(std::make_unique<BackNavigationShellV1InterfacePrivate>(display))
+{
+}
+
+BackNavigationShellV1Interface::~BackNavigationShellV1Interface() = default;
+
+}
+
+#include "moc_backnavigation_v1.cpp"
