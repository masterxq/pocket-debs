+++ b/src/wayland/plasmawindowmanagement.cpp
@@ -105,6 +105,7 @@ public:
     QString uuid;
     QString m_resourceName;
     Rect clientGeometry;
+    bool backAvailable = false;
 
 protected:
     Resource *org_kde_plasma_window_allocate() override;
@@ -805,6 +806,38 @@ PlasmaWindowInterface::PlasmaWindowInterface(PlasmaWindowManagementInterface *wm
 
 PlasmaWindowInterface::~PlasmaWindowInterface() = default;
 
+PlasmaWindowInterface *PlasmaWindowInterface::get(wl_resource *resource)
+{
+    auto windowResource = QtWaylandServer::org_kde_plasma_window::Resource::fromResource(resource);
+    if (!windowResource) {
+        return nullptr;
+    }
+    auto window = static_cast<PlasmaWindowInterfacePrivate *>(windowResource->object());
+    if (!window || window->unmapped) {
+        return nullptr;
+    }
+    return window->q;
+}
+
+void PlasmaWindowInterface::setBackAvailable(bool set)
+{
+    if (d->backAvailable == set) {
+        return;
+    }
+    d->backAvailable = set;
+    Q_EMIT backAvailableChanged(set);
+}
+
+bool PlasmaWindowInterface::isBackAvailable() const
+{
+    return d->backAvailable;
+}
+
+void PlasmaWindowInterface::requestBack()
+{
+    Q_EMIT backRequested();
+}
+
 void PlasmaWindowInterface::setAppId(const QString &appId)
 {
     d->setAppId(appId);
