 }
 
+void InputMethodTest::testPanelRequestsFromUnfocusedClient()
+{
+    // This test verifies that only the client with text input focus can show or hide the input panel.
+    touchNow();
+    QVERIFY(!kwinApp()->inputMethod()->isActive());
+
+    std::unique_ptr<KWayland::Client::Surface> surface(Test::createSurface());
+    std::unique_ptr<Test::XdgToplevel> shellSurface(Test::createXdgToplevelSurface(surface.get()));
+    Window *window = Test::renderAndWaitForShown(surface.get(), QSize(1280, 1024), Qt::red);
+    QVERIFY(window);
+    QVERIFY(window->isActive());
+
+    std::unique_ptr<KWayland::Client::TextInput> textInput(Test::waylandTextInputManager()->createTextInput(Test::waylandSeat()));
+    QSignalSpy panelChangedSpy(kwinApp()->inputMethod(), &InputMethod::panelChanged);
+    textInput->enable(surface.get());
+    QVERIFY(panelChangedSpy.wait());
+    QVERIFY(kwinApp()->inputMethod()->isActive());
+    QVERIFY(!kwinApp()->inputMethod()->isVisible());
+
+    // A second client without focus asks to show the panel.
+    std::unique_ptr<Test::Connection> other = Test::Connection::setup(Test::AdditionalWaylandInterface::Seat | Test::AdditionalWaylandInterface::TextInputManagerV2);
+    QVERIFY(other);
+    std::unique_ptr<KWayland::Client::TextInput> otherTextInput(other->textInputManager->createTextInput(other->seat));
+    QVERIFY(otherTextInput);
+    QSignalSpy showSpy(waylandServer()->seat()->textInputV2(), &TextInputV2Interface::requestShowInputPanel);
+    QSignalSpy hideSpy(waylandServer()->seat()->textInputV2(), &TextInputV2Interface::requestHideInputPanel);
+    otherTextInput->showInputPanel();
+    QVERIFY(other->sync());
+    QCOMPARE(showSpy.count(), 0);
+    QVERIFY(!kwinApp()->inputMethod()->isVisible());
+
+    // The focused client can show it.
+    textInput->showInputPanel();
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(showSpy.count(), 1);
+    QTRY_VERIFY(kwinApp()->inputMethod()->isVisible());
+
+    // The other client cannot hide it.
+    otherTextInput->hideInputPanel();
+    QVERIFY(other->sync());
+    QCOMPARE(hideSpy.count(), 0);
+    QVERIFY(kwinApp()->inputMethod()->isVisible());
+
+    otherTextInput.reset();
+    other.reset();
+    shellSurface.reset();
+    QVERIFY(Test::waitForWindowClosed(window));
+}
+
 void InputMethodTest::testModifierForwarding()
 {
     QVERIFY(Test::waitForWaylandKeyboard());
diff --git a/src/wayland/textinput_v2.cpp b/src/wayland/textinput_v2.cpp
index e413955..61c610f 100644
--- a/src/wayland/textinput_v2.cpp
+++ b/src/wayland/textinput_v2.cpp
@@ -367,6 +367,9 @@ void TextInputV2InterfacePrivate::zwp_text_input_v2_update_state(Resource *resou
 
 void TextInputV2InterfacePrivate::zwp_text_input_v2_hide_input_panel(Resource *resource)
 {
+    if (!hasTextInputFocus(resource)) {
+        return;
+    }
     Q_EMIT q->requestHideInputPanel();
 }
 
@@ -411,9 +414,19 @@ void TextInputV2InterfacePrivate::zwp_text_input_v2_set_preferred_language(Resou
 
 void TextInputV2InterfacePrivate::zwp_text_input_v2_show_input_panel(Resource *resource)
 {
+    if (!hasTextInputFocus(resource)) {
+        return;
+    }
     Q_EMIT q->requestShowInputPanel();
 }
 
+bool TextInputV2InterfacePrivate::hasTextInputFocus(Resource *resource) const
+{
+    // The input panel serves the surface with text input focus. Requests of other clients
+    // would show or hide it over a window that did not ask for it.
+    return focusedSurface && focusedSurface->client()->client() == resource->client();
+}
+
 QList<TextInputV2InterfacePrivate::Resource *> TextInputV2InterfacePrivate::textInputsForClient(ClientConnection *client) const
 {
     return resourceMap().values(client->client());
