+#include "kwin_wayland_test.h"
+
+#include "wayland_server.h"
+#include "window.h"
+#include "workspace.h"
+
+#include <KWayland/Client/plasmawindowmanagement.h>
+#include <KWayland/Client/surface.h>
+
+namespace KWin
+{
+
+using BackState = Test::BackNavigationWindowV1::state;
+
+class BackNavigationTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void initTestCase();
+    void init();
+    void cleanup();
+
+    void testNoBackNavigation();
+    void testState();
+    void testBack();
+    void testBackWhenUnavailable();
+    void testDestroy();
+    void testRemap();
+    void testToplevelDestroyedFirst();
+    void testDialogHasOwnState();
+    void testModalBlocksBack();
+    void testLockScreenBlocksBack();
+
+private:
+    KWayland::Client::PlasmaWindow *waitForPlasmaWindow(Window *window);
+};
+
+void BackNavigationTest::initTestCase()
+{
+    qRegisterMetaType<KWin::Window *>();
+    QVERIFY(waylandServer()->init(qAppName()));
+    kwinApp()->start();
+    Test::setOutputConfig({
+        Rect(0, 0, 1280, 1024),
+    });
+}
+
+void BackNavigationTest::init()
+{
+    QVERIFY(Test::setupWaylandConnection(Test::AdditionalWaylandInterface::WindowManagement
+                                         | Test::AdditionalWaylandInterface::BackNavigationV1
+                                         | Test::AdditionalWaylandInterface::XdgDialogV1));
+}
+
+void BackNavigationTest::cleanup()
+{
+    Test::destroyWaylandConnection();
+}
+
+KWayland::Client::PlasmaWindow *BackNavigationTest::waitForPlasmaWindow(Window *window)
+{
+    const QByteArray uuid = window->internalId().toByteArray();
+    auto find = [&uuid]() -> KWayland::Client::PlasmaWindow * {
+        const auto windows = Test::waylandWindowManagement()->windows();
+        for (auto *plasmaWindow : windows) {
+            if (plasmaWindow->uuid() == uuid) {
+                return plasmaWindow;
+            }
+        }
+        return nullptr;
+    };
+    if (auto plasmaWindow = find()) {
+        return plasmaWindow;
+    }
+    QSignalSpy windowCreatedSpy(Test::waylandWindowManagement(), &KWayland::Client::PlasmaWindowManagement::windowCreated);
+    while (windowCreatedSpy.wait()) {
+        if (auto plasmaWindow = find()) {
+            return plasmaWindow;
+        }
+    }
+    return nullptr;
+}
+
+void BackNavigationTest::testNoBackNavigation()
+{
+    // A window of a client that does not use kde_back_navigation_v1 reports back as unavailable,
+    // and a back request from the shell has no effect.
+    auto surface = Test::createSurface();
+    auto toplevel = Test::createXdgToplevelSurface(surface.get());
+    Window *window = Test::renderAndWaitForShown(surface.get(), QSize(100, 50), Qt::blue);
+    QVERIFY(window);
+    QVERIFY(!window->isBackAvailable());
+
+    auto plasmaWindow = waitForPlasmaWindow(window);
+    QVERIFY(plasmaWindow);
+    auto shellWindow = Test::createBackNavigationWindowV1(plasmaWindow);
+    QSignalSpy stateSpy(shellWindow.get(), &Test::BackNavigationWindowV1::stateReceived);
+    QVERIFY(stateSpy.wait());
+    QCOMPARE(stateSpy.count(), 1);
+    QCOMPARE(stateSpy.last().at(0).value<uint32_t>(), BackState::state_unavailable);
+
+    shellWindow->back();
+    QVERIFY(Test::waylandSync());
+    QVERIFY(!window->isBackAvailable());
+}
+
+void BackNavigationTest::testState()
+{
+    auto surface = Test::createSurface();
+    auto toplevel = Test::createXdgToplevelSurface(surface.get());
+    auto backNavigation = Test::createBackNavigationV1(toplevel.get());
+    QVERIFY(backNavigation);
+    Window *window = Test::renderAndWaitForShown(surface.get(), QSize(100, 50), Qt::blue);
+    QVERIFY(window);
+    QVERIFY(!window->isBackAvailable());
+
+    auto plasmaWindow = waitForPlasmaWindow(window);
+    QVERIFY(plasmaWindow);
+    auto shellWindow = Test::createBackNavigationWindowV1(plasmaWindow);
+    QSignalSpy stateSpy(shellWindow.get(), &Test::BackNavigationWindowV1::stateReceived);
+    QVERIFY(stateSpy.wait());
+    QCOMPARE(stateSpy.last().at(0).value<uint32_t>(), BackState::state_unavailable);
+
+    QSignalSpy availableChangedSpy(window, &Window::backAvailableChanged);
+    backNavigation->set_state(Test::BackNavigationV1::state_available);
+    QVERIFY(availableChangedSpy.wait());
+    QVERIFY(window->isBackAvailable());
+    QVERIFY(stateSpy.wait());
+    QCOMPARE(stateSpy.count(), 2);
+    QCOMPARE(stateSpy.last().at(0).value<uint32_t>(), BackState::state_available);
+
+    // Setting the same state again changes nothing.
+    backNavigation->set_state(Test::BackNavigationV1::state_available);
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(availableChangedSpy.count(), 1);
+
+    backNavigation->set_state(Test::BackNavigationV1::state_unavailable);
+    QVERIFY(availableChangedSpy.wait());
+    QVERIFY(!window->isBackAvailable());
+    QVERIFY(stateSpy.wait());
+    QCOMPARE(stateSpy.count(), 3);
+    QCOMPARE(stateSpy.last().at(0).value<uint32_t>(), BackState::state_unavailable);
+
+    // A second shell object for the same window starts with the current state.
+    backNavigation->set_state(Test::BackNavigationV1::state_available);
+    QVERIFY(availableChangedSpy.wait());
+    auto secondShellWindow = Test::createBackNavigationWindowV1(plasmaWindow);
+    QSignalSpy secondStateSpy(secondShellWindow.get(), &Test::BackNavigationWindowV1::stateReceived);
+    QVERIFY(secondStateSpy.wait());
+    QCOMPARE(secondStateSpy.count(), 1);
+    QCOMPARE(secondStateSpy.last().at(0).value<uint32_t>(), BackState::state_available);
+}
+
+void BackNavigationTest::testBack()
+{
+    auto surface = Test::createSurface();
+    auto toplevel = Test::createXdgToplevelSurface(surface.get());
+    auto backNavigation = Test::createBackNavigationV1(toplevel.get());
+    Window *window = Test::renderAndWaitForShown(surface.get(), QSize(100, 50), Qt::blue);
+    QVERIFY(window);
+
+    QSignalSpy availableChangedSpy(window, &Window::backAvailableChanged);
+    backNavigation->set_state(Test::BackNavigationV1::state_available);
+    QVERIFY(availableChangedSpy.wait());
+
+    auto shellWindow = Test::createBackNavigationWindowV1(waitForPlasmaWindow(window));
+    QSignalSpy backSpy(backNavigation.get(), &Test::BackNavigationV1::back);
+    shellWindow->back();
+    QVERIFY(backSpy.wait());
+    QCOMPARE(backSpy.count(), 1);
+
+    // Each request is one event.
+    shellWindow->back();
+    shellWindow->back();
+    QVERIFY(backSpy.wait());
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(backSpy.count(), 3);
+}
+
+void BackNavigationTest::testBackWhenUnavailable()
+{
+    // The compositor checks the state when it processes the request of the shell.
+    auto surface = Test::createSurface();
+    auto toplevel = Test::createXdgToplevelSurface(surface.get());
+    auto backNavigation = Test::createBackNavigationV1(toplevel.get());
+    Window *window = Test::renderAndWaitForShown(surface.get(), QSize(100, 50), Qt::blue);
+    QVERIFY(window);
+
+    QSignalSpy availableChangedSpy(window, &Window::backAvailableChanged);
+    backNavigation->set_state(Test::BackNavigationV1::state_available);
+    QVERIFY(availableChangedSpy.wait());
+
+    auto shellWindow = Test::createBackNavigationWindowV1(waitForPlasmaWindow(window));
+    QSignalSpy backSpy(backNavigation.get(), &Test::BackNavigationV1::back);
+
+    backNavigation->set_state(Test::BackNavigationV1::state_unavailable);
+    QVERIFY(availableChangedSpy.wait());
+    shellWindow->back();
+    QVERIFY(Test::waylandSync());
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(backSpy.count(), 0);
+
+    // Also a request on the server side is dropped.
+    window->requestBack();
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(backSpy.count(), 0);
+}
+
+void BackNavigationTest::testDestroy()
+{
+    // Destroying the back navigation object makes back unavailable.
+    auto surface = Test::createSurface();
+    auto toplevel = Test::createXdgToplevelSurface(surface.get());
+    auto backNavigation = Test::createBackNavigationV1(toplevel.get());
+    Window *window = Test::renderAndWaitForShown(surface.get(), QSize(100, 50), Qt::blue);
+    QVERIFY(window);
+
+    QSignalSpy availableChangedSpy(window, &Window::backAvailableChanged);
+    backNavigation->set_state(Test::BackNavigationV1::state_available);
+    QVERIFY(availableChangedSpy.wait());
+
+    auto shellWindow = Test::createBackNavigationWindowV1(waitForPlasmaWindow(window));
+    QSignalSpy stateSpy(shellWindow.get(), &Test::BackNavigationWindowV1::stateReceived);
+    QVERIFY(stateSpy.wait());
+    QCOMPARE(stateSpy.last().at(0).value<uint32_t>(), BackState::state_available);
+
+    backNavigation.reset();
+    QVERIFY(availableChangedSpy.wait());
+    QVERIFY(!window->isBackAvailable());
+    QVERIFY(stateSpy.wait());
+    QCOMPARE(stateSpy.last().at(0).value<uint32_t>(), BackState::state_unavailable);
+
+    // A new object can be created for the same toplevel.
+    backNavigation = Test::createBackNavigationV1(toplevel.get());
+    backNavigation->set_state(Test::BackNavigationV1::state_available);
+    QVERIFY(availableChangedSpy.wait());
+    QVERIFY(window->isBackAvailable());
+}
+
+void BackNavigationTest::testRemap()
+{
+    // The state belongs to the xdg_toplevel and survives an unmap and remap of the surface.
+    auto surface = Test::createSurface();
+    auto toplevel = Test::createXdgToplevelSurface(surface.get(), Test::CreationSetup::CreateOnly);
+    auto backNavigation = Test::createBackNavigationV1(toplevel.get());
+    backNavigation->set_state(Test::BackNavigationV1::state_available);
+
+    QSignalSpy configureRequestedSpy(toplevel->xdgSurface(), &Test::XdgSurface::configureRequested);
+    surface->commit(KWayland::Client::Surface::CommitFlag::None);
+    QVERIFY(configureRequestedSpy.wait());
+    toplevel->xdgSurface()->ack_configure(configureRequestedSpy.last().at(0).value<quint32>());
+    Window *window = Test::renderAndWaitForShown(surface.get(), QSize(100, 50), Qt::blue);
+    QVERIFY(window);
+    QVERIFY(window->isBackAvailable());
+
+    surface->attachBuffer(KWayland::Client::Buffer::Ptr());
+    surface->commit(KWayland::Client::Surface::CommitFlag::None);
+    QVERIFY(Test::waitForWindowClosed(window));
+
+    surface->commit(KWayland::Client::Surface::CommitFlag::None);
+    QVERIFY(configureRequestedSpy.wait());
+    toplevel->xdgSurface()->ack_configure(configureRequestedSpy.last().at(0).value<quint32>());
+    window = Test::renderAndWaitForShown(surface.get(), QSize(100, 50), Qt::blue);
+    QVERIFY(window);
+    QVERIFY(window->isBackAvailable());
+
+    auto shellWindow = Test::createBackNavigationWindowV1(waitForPlasmaWindow(window));
+    QSignalSpy stateSpy(shellWindow.get(), &Test::BackNavigationWindowV1::stateReceived);
+    QVERIFY(stateSpy.wait());
+    QCOMPARE(stateSpy.last().at(0).value<uint32_t>(), BackState::state_available);
+
+    QSignalSpy backSpy(backNavigation.get(), &Test::BackNavigationV1::back);
+    shellWindow->back();
+    QVERIFY(backSpy.wait());
+}
+
+void BackNavigationTest::testToplevelDestroyedFirst()
+{
+    // After the xdg_toplevel is gone the object is inert; using it must not crash the compositor.
+    auto surface = Test::createSurface();
+    auto toplevel = Test::createXdgToplevelSurface(surface.get());
+    auto backNavigation = Test::createBackNavigationV1(toplevel.get());
+    Window *window = Test::renderAndWaitForShown(surface.get(), QSize(100, 50), Qt::blue);
+    QVERIFY(window);
+
+    auto shellWindow = Test::createBackNavigationWindowV1(waitForPlasmaWindow(window));
+    QSignalSpy stateSpy(shellWindow.get(), &Test::BackNavigationWindowV1::stateReceived);
+    QVERIFY(stateSpy.wait());
+
+    toplevel.reset();
+    QVERIFY(Test::waitForWindowClosed(window));
+
+    backNavigation->set_state(Test::BackNavigationV1::state_available);
+    shellWindow->back();
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(stateSpy.count(), 1);
+
+    backNavigation.reset();
+    shellWindow.reset();
+    QVERIFY(Test::waylandSync());
+}
+
+void BackNavigationTest::testDialogHasOwnState()
+{
+    // A transient toplevel has its own state; back is never forwarded between parent and child.
+    auto parentSurface = Test::createSurface();
+    auto parentToplevel = Test::createXdgToplevelSurface(parentSurface.get());
+    auto parentBack = Test::createBackNavigationV1(parentToplevel.get());
+    Window *parentWindow = Test::renderAndWaitForShown(parentSurface.get(), QSize(200, 200), Qt::cyan);
+    QVERIFY(parentWindow);
+    QSignalSpy parentAvailableSpy(parentWindow, &Window::backAvailableChanged);
+    parentBack->set_state(Test::BackNavigationV1::state_available);
+    QVERIFY(parentAvailableSpy.wait());
+
+    auto childSurface = Test::createSurface();
+    auto childToplevel = Test::createXdgToplevelSurface(childSurface.get(), [&parentToplevel](Test::XdgToplevel *toplevel) {
+        toplevel->set_parent(parentToplevel->object());
+    });
+    Window *childWindow = Test::renderAndWaitForShown(childSurface.get(), QSize(100, 100), Qt::yellow);
+    QVERIFY(childWindow);
+    QCOMPARE(childWindow->transientFor(), parentWindow);
+    QVERIFY(!childWindow->isBackAvailable());
+
+    QSignalSpy parentBackSpy(parentBack.get(), &Test::BackNavigationV1::back);
+    auto childShellWindow = Test::createBackNavigationWindowV1(waitForPlasmaWindow(childWindow));
+    QSignalSpy childStateSpy(childShellWindow.get(), &Test::BackNavigationWindowV1::stateReceived);
+    QVERIFY(childStateSpy.wait());
+    QCOMPARE(childStateSpy.last().at(0).value<uint32_t>(), BackState::state_unavailable);
+    childShellWindow->back();
+    QVERIFY(Test::waylandSync());
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(parentBackSpy.count(), 0);
+
+    auto childBack = Test::createBackNavigationV1(childToplevel.get());
+    QSignalSpy childBackSpy(childBack.get(), &Test::BackNavigationV1::back);
+    childBack->set_state(Test::BackNavigationV1::state_available);
+    QVERIFY(childStateSpy.wait());
+    QCOMPARE(childStateSpy.last().at(0).value<uint32_t>(), BackState::state_available);
+    childShellWindow->back();
+    QVERIFY(childBackSpy.wait());
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(parentBackSpy.count(), 0);
+}
+
+void BackNavigationTest::testModalBlocksBack()
+{
+    // A window blocked by a modal dialog receives no back event.
+    auto parentSurface = Test::createSurface();
+    auto parentToplevel = Test::createXdgToplevelSurface(parentSurface.get());
+    auto parentBack = Test::createBackNavigationV1(parentToplevel.get());
+    Window *parentWindow = Test::renderAndWaitForShown(parentSurface.get(), QSize(200, 200), Qt::cyan);
+    QVERIFY(parentWindow);
+    QSignalSpy parentAvailableSpy(parentWindow, &Window::backAvailableChanged);
+    parentBack->set_state(Test::BackNavigationV1::state_available);
+    QVERIFY(parentAvailableSpy.wait());
+    auto parentShellWindow = Test::createBackNavigationWindowV1(waitForPlasmaWindow(parentWindow));
+    QSignalSpy parentBackSpy(parentBack.get(), &Test::BackNavigationV1::back);
+
+    auto childSurface = Test::createSurface();
+    auto childToplevel = Test::createXdgToplevelSurface(childSurface.get(), [&parentToplevel](Test::XdgToplevel *toplevel) {
+        toplevel->set_parent(parentToplevel->object());
+    });
+    Window *childWindow = Test::renderAndWaitForShown(childSurface.get(), QSize(100, 100), Qt::yellow);
+    QVERIFY(childWindow);
+    auto dialog = Test::createXdgDialogV1(childToplevel.get());
+    QSignalSpy modalChangedSpy(childWindow, &Window::modalChanged);
+    dialog->set_modal();
+    QVERIFY(modalChangedSpy.wait());
+    QVERIFY(childWindow->isModal());
+
+    parentShellWindow->back();
+    QVERIFY(Test::waylandSync());
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(parentBackSpy.count(), 0);
+
+    dialog->unset_modal();
+    QVERIFY(modalChangedSpy.wait());
+    parentShellWindow->back();
+    QVERIFY(parentBackSpy.wait());
+}
+
+void BackNavigationTest::testLockScreenBlocksBack()
+{
+#if KWIN_BUILD_SCREENLOCKER
+    auto surface = Test::createSurface();
+    auto toplevel = Test::createXdgToplevelSurface(surface.get());
+    auto backNavigation = Test::createBackNavigationV1(toplevel.get());
+    Window *window = Test::renderAndWaitForShown(surface.get(), QSize(100, 50), Qt::blue);
+    QVERIFY(window);
+    QSignalSpy availableChangedSpy(window, &Window::backAvailableChanged);
+    backNavigation->set_state(Test::BackNavigationV1::state_available);
+    QVERIFY(availableChangedSpy.wait());
+    auto shellWindow = Test::createBackNavigationWindowV1(waitForPlasmaWindow(window));
+    QSignalSpy backSpy(backNavigation.get(), &Test::BackNavigationV1::back);
+
+    QVERIFY(Test::lockScreen());
+    shellWindow->back();
+    QVERIFY(Test::waylandSync());
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(backSpy.count(), 0);
+
+    QVERIFY(Test::unlockScreen());
+    shellWindow->back();
+    QVERIFY(backSpy.wait());
+#endif
+}
+
+}
+
+WAYLANDTEST_MAIN(KWin::BackNavigationTest)
