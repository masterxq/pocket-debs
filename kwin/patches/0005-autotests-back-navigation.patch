+std::unique_ptr<BackNavigationWindowV1> createBackNavigationWindowV1(KWayland::Client::PlasmaWindow *window)
+{
+    BackNavigationShellV1 *shell = s_waylandConnection->backNavigationShell.get();
+    if (!shell) {
+        qWarning() << "Could not create a kde_back_navigation_window_v1 because kde_back_navigation_shell_v1 global is not bound";
+        return nullptr;
+    }
+    return std::make_unique<BackNavigationWindowV1>(shell->get_window(*window));
+}
