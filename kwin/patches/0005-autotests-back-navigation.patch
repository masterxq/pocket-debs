+std::unique_ptr<BackNavigationV1> createBackNavigationV1(XdgToplevel *toplevel)
+{
+    BackNavigationManagerV1 *manager = s_waylandConnection->backNavigationManager.get();
+    if (!manager) {
+        qWarning() << "Could not create a kde_back_navigation_v1 because kde_back_navigation_manager_v1 global is not bound";
+        return nullptr;
+    }
+    return std::make_unique<BackNavigationV1>(manager->get_back_navigation(toplevel->object()));
+}
