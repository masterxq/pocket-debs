From: masterxq <masterxq@users.noreply.github.com>
Date: Sat, 28 Nov 2026 10:00:00 +0100
Subject: [PATCH] lockscreen: fingerprint icon shows whether a finger unlocks, reason in the keypad
Description:
 The lock screen showed the hints and errors of the fingerprint
 authenticator as text above the fingerprint icon. The hint of
 pam_fprintd names the enrolled finger ("Place your right index
 finger ..."), which is wrong with several enrolled fingers and tells
 others which finger to use. The icon itself disappeared whenever the
 authenticator was not running, so a device with a reader could not
 tell "not now" from "no reader".
 .
 A device preset can now say whether the device has a fingerprint
 reader ([Lockscreen] fingerprintReader, applied by envmanager like the
 panel settings; new preset for motorola,lisbon). With a reader the
 lock screen always shows the fingerprint icon:
 - no text above it;
 - struck through while a finger does not unlock: the fingerprint
   authenticator ran and stopped without unlocking (reported itself
   unavailable or failed); it is plain again when it runs again;
 - the icon shakes on a rejected finger (vibration as before);
 - it stays in place when the keypad opens, above the scrim and below
   the keypad;
 - the keypad shows why a finger does not unlock: the last message of
   the fingerprint authenticator if it stopped within a second after
   it (PAM stacks can give the reason as their last message, e.g. a PIN
   is needed first after a restart).
 Without a reader the lock screen shows no fingerprint icon. Without
 the setting the icon shows while the authenticator waits for a finger,
 as before, but without the text.
Author: masterxq
Forwarded: no
License: GPL-2.0-or-later (as the patched files)
Last-Update: 2026-11-28
---
diff --git a/components/shellsettingsplugin/mobileshellsettings.cpp b/components/shellsettingsplugin/mobileshellsettings.cpp
index 88beb01e4..c5bbd13bb 100644
--- a/components/shellsettingsplugin/mobileshellsettings.cpp
+++ b/components/shellsettingsplugin/mobileshellsettings.cpp
@@ -49,6 +49,7 @@ MobileShellSettings::MobileShellSettings(QObject *parent)
         if (group.name() == LOCKSCREEN_CONFIG_GROUP) {
             Q_EMIT lockscreenLeftButtonActionChanged();
             Q_EMIT lockscreenRightButtonActionChanged();
+            Q_EMIT fingerprintReaderChanged();
         }
         if (group.name() == QUICKSETTINGS_CONFIG_GROUP) {
             Q_EMIT quickSettingsColumnsChanged();
@@ -325,3 +326,12 @@ void MobileShellSettings::setLockscreenRightButtonAction(const LockscreenButtonA
     group.writeEntry("lockscreenRightButtonAction", (int)action, KConfigGroup::Notify);
     m_config->sync();
 }
+
+MobileShellSettings::FingerprintReader MobileShellSettings::fingerprintReader() const
+{
+    auto group = KConfigGroup{m_config, LOCKSCREEN_CONFIG_GROUP};
+    if (!group.hasKey("fingerprintReader")) {
+        return FingerprintReaderUnknown;
+    }
+    return group.readEntry("fingerprintReader", false) ? FingerprintReaderPresent : FingerprintReaderAbsent;
+}
diff --git a/components/shellsettingsplugin/mobileshellsettings.h b/components/shellsettingsplugin/mobileshellsettings.h
index 64be056bb..adb33d603 100644
--- a/components/shellsettingsplugin/mobileshellsettings.h
+++ b/components/shellsettingsplugin/mobileshellsettings.h
@@ -59,6 +59,9 @@ class MobileShellSettings : public QObject
     Q_PROPERTY(LockscreenButtonAction lockscreenLeftButtonAction READ lockscreenLeftButtonAction WRITE setLockscreenLeftButtonAction NOTIFY lockscreenLeftButtonActionChanged)
     Q_PROPERTY(LockscreenButtonAction lockscreenRightButtonAction READ lockscreenRightButtonAction WRITE setLockscreenRightButtonAction NOTIFY lockscreenRightButtonActionChanged)
 
+    // lockscreen fingerprint indicator, set by the device preset
+    Q_PROPERTY(FingerprintReader fingerprintReader READ fingerprintReader NOTIFY fingerprintReaderChanged)
+
 public:
     MobileShellSettings(QObject *parent = nullptr);
 
@@ -76,6 +79,13 @@ public:
     };
     Q_ENUM(LockscreenButtonAction)
 
+    enum FingerprintReader {
+        FingerprintReaderUnknown, // not configured: the fingerprint icon shows while the screen locker waits for a finger
+        FingerprintReaderPresent, // the icon always shows, struck through while a finger does not unlock
+        FingerprintReaderAbsent // no fingerprint icon
+    };
+    Q_ENUM(FingerprintReader)
+
     /**
      * Get whether shell vibrations are enabled.
      */
@@ -293,6 +303,12 @@ public:
      */
     void setLockscreenRightButtonAction(LockscreenButtonAction action);
 
+    /**
+     * Whether the device has a fingerprint reader (key fingerprintReader in the group Lockscreen, true or false),
+     * set by the device preset (devices/spec.conf); unknown if the key is not set.
+     */
+    FingerprintReader fingerprintReader() const;
+
 Q_SIGNALS:
     void vibrationsEnabledChanged();
     void vibrationDurationChanged();
@@ -313,6 +329,7 @@ Q_SIGNALS:
     void allowLogoutChanged();
     void lockscreenLeftButtonActionChanged();
     void lockscreenRightButtonActionChanged();
+    void fingerprintReaderChanged();
 
 private:
     void updateNavigationBarsInPlasma();
