diff --git a/devices/spec.conf b/devices/spec.conf
index 585f41ba9..5e98daa7f 100644
--- a/devices/spec.conf
+++ b/devices/spec.conf
@@ -5,6 +5,13 @@
 # The name of the device.
 name=My Phone
 
+# Lock screen
+[Lockscreen]
+# Whether the device has a fingerprint reader (true, false). With true the lock screen always shows the fingerprint
+# icon, struck through while a finger does not unlock, and the reason in the keypad; with false it shows no fingerprint
+# icon. If not set, the icon shows while the screen locker waits for a finger.
+fingerprintReader=
+
 # Dimensions for a panel (fallback for any of the options below)
 [Panels]
 statusBarHeight=
diff --git a/envmanager/devicepresets.cpp b/envmanager/devicepresets.cpp
index ea29a96ef..030f3fc24 100644
--- a/envmanager/devicepresets.cpp
+++ b/envmanager/devicepresets.cpp
