diff --git a/shell/contents/lockscreen/BottomIconIndicator.qml b/shell/contents/lockscreen/BottomIconIndicator.qml
index 78e6c78a2..b93942925 100644
--- a/shell/contents/lockscreen/BottomIconIndicator.qml
+++ b/shell/contents/lockscreen/BottomIconIndicator.qml
@@ -14,7 +14,7 @@ Loader {
     property var lockScreenState
 
     sourceComponent: {
-        if (lockScreenState.isFingerprintSupported) {
+        if (lockScreenState.fingerprintIndicatorShown) {
             return fingerprintIcon;
         } else {
             return scrollUpIcon;
@@ -36,16 +36,62 @@ Loader {
     Component {
         id: fingerprintIcon
 
-        Kirigami.Icon {
-            source: 'fingerprint-symbolic'
+        // struck through while a finger does not unlock; shakes when a finger was not recognized
+        Item {
             implicitWidth: Kirigami.Units.iconSizes.medium
             implicitHeight: Kirigami.Units.iconSizes.medium
 
             Kirigami.Theme.colorSet: Kirigami.Theme.Complementary
+            Kirigami.Theme.inherit: false
+
+            transform: Translate {
+                id: shakeOffset
+            }
+
+            Kirigami.Icon {
+                anchors.fill: parent
+                source: 'fingerprint-symbolic'
+            }
+
+            // the stroke over a darker band, which sets it off from the lines of the icon below
+            Rectangle {
+                visible: root.lockScreenState.fingerprintIndicatorStruck
+                anchors.centerIn: parent
+                width: strike.width + height - strike.height
+                height: strike.height * 3
+                radius: height / 2
+                rotation: -45
+                antialiasing: true
+                color: Qt.rgba(0, 0, 0, 0.5)
+            }
+
+            Rectangle {
+                id: strike
+                visible: root.lockScreenState.fingerprintIndicatorStruck
+                anchors.centerIn: parent
+                width: Math.round(parent.width * 1.3)
+                height: Math.max(2, Math.round(parent.width / 12))
+                radius: height / 2
+                rotation: -45
+                antialiasing: true
+                color: Kirigami.Theme.textColor
+            }
+
+            SequentialAnimation {
+                id: shakeAnimation
+                readonly property real distance: Kirigami.Units.smallSpacing * 2
+                NumberAnimation { target: shakeOffset; property: "x"; to: -shakeAnimation.distance; duration: 50 }
+                NumberAnimation { target: shakeOffset; property: "x"; to: shakeAnimation.distance; duration: 100 }
+                NumberAnimation { target: shakeOffset; property: "x"; to: -shakeAnimation.distance / 2; duration: 80 }
+                NumberAnimation { target: shakeOffset; property: "x"; to: 0; duration: 50 }
+            }
 
-            anchors.horizontalCenter: parent.horizontalCenter
-            anchors.bottom: parent.bottom
-            anchors.bottomMargin: Kirigami.Units.gridUnit * 2 + flickable.position * 0.5
+            Connections {
+                target: root.lockScreenState
+                function onFingerprintFailed() {
+                    shakeAnimation.restart();
+                }
+            }
         }
     }
 }
