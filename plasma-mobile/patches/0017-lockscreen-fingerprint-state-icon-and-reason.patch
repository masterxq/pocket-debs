         // pin display and bar
         PasswordBar {
             id: passwordBar
diff --git a/shell/contents/lockscreen/LockScreen.qml b/shell/contents/lockscreen/LockScreen.qml
index 493c382cd..4dfaaf64c 100644
--- a/shell/contents/lockscreen/LockScreen.qml
+++ b/shell/contents/lockscreen/LockScreen.qml
@@ -161,43 +161,16 @@ Item {
                 }
             }
 
-            // hint or error of the fingerprint reader, above the indicator icon
-            PC3.Label {
-                id: fingerprintMessage
-                visible: text !== ""
-                text: root.lockScreenState.fingerprintMessage
-                opacity: Math.max(0, 1 - flickable.openFactor * 2)
-                color: "white"
-                horizontalAlignment: Text.AlignHCenter
-                wrapMode: Text.WordWrap
-                width: Math.min(parent.width - Kirigami.Units.gridUnit * 2, Kirigami.Units.gridUnit * 20)
-
-                anchors.bottom: scrollUpIconLoader.top
-                anchors.bottomMargin: Kirigami.Units.largeSpacing
-                anchors.horizontalCenter: parent.horizontalCenter
-            }
-
             Connections {
                 target: root.lockScreenState
                 function onFingerprintFailed() {
                     // a rejected finger is felt also while the display is off
-                    if (ShellSettings.Settings.vibrationsEnabled) {
+                    if (ShellSettings.Settings.vibrationsEnabled && root.lockScreenState.fingerprintIndicatorShown) {
                         HapticsPlugin.VibrationManager.vibrate(ShellSettings.Settings.vibrationDuration * 4);
                     }
                 }
             }
 
-            // scroll up icon
-            BottomIconIndicator {
-                id: scrollUpIconLoader
-                lockScreenState: root.lockScreenState
-                opacity: Math.max(0, 1 - flickable.openFactor * 2)
-
-                anchors.bottom: parent.bottom
-                anchors.bottomMargin: Kirigami.Units.gridUnit + flickable.position * 0.1
-                anchors.horizontalCenter: parent.horizontalCenter
-            }
-
             Rectangle {
                 id: keypadScrim
                 anchors.fill: parent
@@ -206,6 +179,19 @@ Item {
                 color: Qt.rgba(0, 0, 0, 0.5)
             }
 
+            // scroll up icon, or the fingerprint icon: that one stays in place over the scrim when the keypad opens
+            BottomIconIndicator {
+                id: scrollUpIconLoader
+                lockScreenState: root.lockScreenState
+                opacity: root.lockScreenState.fingerprintIndicatorShown ? 1 : Math.max(0, 1 - flickable.openFactor * 2)
+
+                anchors.bottom: parent.bottom
+                anchors.bottomMargin: root.lockScreenState.fingerprintIndicatorShown
+                    ? Kirigami.Units.gridUnit * 3
+                    : Kirigami.Units.gridUnit + flickable.position * 0.1
+                anchors.horizontalCenter: parent.horizontalCenter
+            }
+
             MouseArea {
                 // Disable "double tap to lock" to avoid accidental locking
                 // when the keypad is open, and the user is typing their password.
diff --git a/shell/contents/lockscreen/LockScreenState.qml b/shell/contents/lockscreen/LockScreenState.qml
index 3de474e4d..88d6f945a 100644
--- a/shell/contents/lockscreen/LockScreenState.qml
+++ b/shell/contents/lockscreen/LockScreenState.qml
@@ -5,6 +5,7 @@ import QtQml
 import QtQuick
 
 import org.kde.kscreenlocker 1.0 as ScreenLocker
+import org.kde.plasma.private.mobileshell.shellsettingsplugin as ShellSettings
 
 QtObject {
     id: root
@@ -36,13 +37,46 @@ QtObject {
     // whether the device can log in with fingerprint
     readonly property bool isFingerprintSupported: authenticator.authenticatorTypes & ScreenLocker.Authenticator.Fingerprint
 
-    // last hint of the fingerprint authenticator (e.g. where to place the finger, or why only the PIN works now)
-    property string fingerprintInfo: ""
+    // whether the device preset says that the device has a fingerprint reader
+    readonly property bool hasFingerprintReader: ShellSettings.Settings.fingerprintReader === ShellSettings.Settings.FingerprintReaderPresent
+
+    // whether the fingerprint icon shows: always on a device with a reader, never on a device without one, and
+    // without that configuration while the fingerprint authenticator waits for a finger
+    readonly property bool fingerprintIndicatorShown: {
+        switch (ShellSettings.Settings.fingerprintReader) {
+        case ShellSettings.Settings.FingerprintReaderPresent:
+            return true;
+        case ShellSettings.Settings.FingerprintReaderAbsent:
+            return false;
+        default:
+            return isFingerprintSupported;
+        }
+    }
+
+    // the fingerprint authenticator ran and stopped without unlocking (it reported itself unavailable or failed):
+    // a finger does not unlock until it runs again
+    property bool fingerprintStopped: false
 
-    // last error of the fingerprint authenticator (e.g. finger not recognized), shown for a few seconds
-    property string fingerprintError: ""
+    // why a finger does not unlock: the last message of the fingerprint authenticator if it stopped right after it
+    property string fingerprintStopReason: ""
 
-    readonly property string fingerprintMessage: fingerprintError !== "" ? fingerprintError : fingerprintInfo
+    readonly property bool fingerprintIndicatorStruck: hasFingerprintReader && fingerprintStopped
+    readonly property string fingerprintReason: fingerprintIndicatorStruck ? fingerprintStopReason : ""
+
+    // last message of the fingerprint authenticator and when it came (ms since the epoch)
+    property string lastFingerprintMessage: ""
+    property double lastFingerprintMessageTime: 0
+
+    onIsFingerprintSupportedChanged: {
+        if (isFingerprintSupported) {
+            fingerprintStopped = false;
+            fingerprintStopReason = "";
+        } else if (!canBeUnlocked) {
+            fingerprintStopped = true;
+            // a message that came long before (e.g. where to place the finger) is not the reason
+            fingerprintStopReason = Date.now() - lastFingerprintMessageTime < 1000 ? lastFingerprintMessage : "";
+        }
+    }
 
     // whether we are in keyboard mode (hiding the numpad)
     property bool isKeyboardMode: false
@@ -147,24 +181,20 @@ QtObject {
         }
     }
 
-    property var fingerprintErrorTimer: Timer {
-        interval: 3000
-        onTriggered: root.fingerprintError = ""
-    }
-
     property var connections: Connections {
         target: authenticator
 
         function onNoninteractiveInfo(what: int, authenticator: var): void {
             if (what & ScreenLocker.Authenticator.Fingerprint) {
-                root.fingerprintInfo = authenticator.infoMessage;
+                root.lastFingerprintMessage = authenticator.infoMessage;
+                root.lastFingerprintMessageTime = Date.now();
             }
         }
 
         function onNoninteractiveError(what: int, authenticator: var): void {
             if (what & ScreenLocker.Authenticator.Fingerprint) {
-                root.fingerprintError = authenticator.errorMessage;
-                root.fingerprintErrorTimer.restart();
+                root.lastFingerprintMessage = authenticator.errorMessage;
+                root.lastFingerprintMessageTime = Date.now();
                 root.fingerprintFailed();
             }
         }
