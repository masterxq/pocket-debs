diff --git a/components/hapticsplugin/feedbackevents.cpp b/components/hapticsplugin/feedbackevents.cpp
new file mode 100644
index 000000000..02310f63d
--- /dev/null
+++ b/components/hapticsplugin/feedbackevents.cpp
@@ -0,0 +1,130 @@
+// SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "feedbackevents.h"
+
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusPendingCallWatcher>
+#include <QDBusPendingReply>
+#include <QDBusServiceWatcher>
+#include <QPointer>
+
+using namespace Qt::StringLiterals;
+
+static const QString s_service = u"org.sigxcpu.Feedback"_s;
+static const QString s_path = u"/org/sigxcpu/Feedback"_s;
+static const QString s_interface = u"org.sigxcpu.Feedback"_s;
+
+FeedbackEvents::FeedbackEvents(QObject *parent)
+    : QObject{parent}
+    , m_watcher{new QDBusServiceWatcher(s_service, QDBusConnection::sessionBus(), QDBusServiceWatcher::WatchForRegistration, this)}
+{
+    connect(m_watcher, &QDBusServiceWatcher::serviceRegistered, this, &FeedbackEvents::onDaemonRestarted);
+    QDBusConnection::sessionBus().connect(s_service, s_path, s_interface, u"FeedbackEnded"_s, this, SLOT(onFeedbackEnded(uint, uint)));
+}
+
+void FeedbackEvents::trigger(const QString &key, const QString &appId, const QString &event, const QVariantMap &hints, int timeout)
+{
+    end(key);
+
+    Event e;
+    e.appId = appId;
+    e.event = event;
+    e.hints = hints;
+    e.timeout = timeout;
+    e.serial = ++m_serial;
+    m_events.insert(key, e);
+    send(key);
+}
+
+void FeedbackEvents::send(const QString &key)
+{
+    const Event &e = m_events.value(key);
+    const quint64 serial = e.serial;
+
+    QDBusMessage msg = QDBusMessage::createMethodCall(s_service, s_path, s_interface, u"TriggerFeedback"_s);
+    msg << e.appId << e.event << e.hints << e.timeout;
+
+    auto watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(msg), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this, key, serial](QDBusPendingCallWatcher *watcher) {
+        watcher->deleteLater();
+        const QDBusPendingReply<uint> reply = *watcher;
+        if (reply.isError()) {
+            if (m_events.value(key).serial == serial) {
+                m_events.remove(key);
+            }
+            return;
+        }
+        auto it = m_events.find(key);
+        if (it == m_events.end() || it->serial != serial) {
+            // ended or replaced while the call was pending
+            endId(reply.value());
+            return;
+        }
+        it->id = reply.value();
+    });
+}
+
+void FeedbackEvents::end(const QString &key)
+{
+    const auto it = m_events.constFind(key);
+    if (it == m_events.constEnd()) {
+        return;
+    }
+    const uint id = it->id;
+    m_events.erase(it);
+    if (id) {
+        endId(id);
+    }
+}
+
+bool FeedbackEvents::isActive(const QString &key) const
+{
+    return m_events.contains(key);
+}
+
+void FeedbackEvents::endId(uint id)
+{
+    QDBusMessage msg = QDBusMessage::createMethodCall(s_service, s_path, s_interface, u"EndFeedback"_s);
+    msg << id;
+    QDBusConnection::sessionBus().asyncCall(msg);
+}
+
+void FeedbackEvents::onFeedbackEnded(uint id, uint reason)
+{
+    Q_UNUSED(reason)
+    for (auto it = m_events.begin(); it != m_events.end(); ++it) {
+        if (it->id == id) {
+            m_events.erase(it);
+            return;
+        }
+    }
+}
+
+void FeedbackEvents::onDaemonRestarted()
+{
+    // The events of the previous daemon are gone; endless ones come back
+    const QStringList keys = m_events.keys();
+    for (const QString &key : keys) {
+        Event &e = m_events[key];
+        if (e.timeout != 0) {
+            m_events.remove(key);
+            continue;
+        }
+        e.id = 0;
+        e.serial = ++m_serial;
+        send(key);
+    }
+}
+
+void FeedbackEvents::wakeScreen()
+{
+    QDBusMessage msg = QDBusMessage::createMethodCall(u"org.kde.Solid.PowerManagement"_s,
+                                                      u"/org/kde/Solid/PowerManagement"_s,
+                                                      u"org.kde.Solid.PowerManagement"_s,
+                                                      u"wakeup"_s);
+    QDBusConnection::sessionBus().asyncCall(msg);
+}
+
+#include "moc_feedbackevents.cpp"
diff --git a/components/hapticsplugin/feedbackevents.h b/components/hapticsplugin/feedbackevents.h
new file mode 100644
index 000000000..64bd9734a
--- /dev/null
+++ b/components/hapticsplugin/feedbackevents.h
@@ -0,0 +1,64 @@
+// SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <QHash>
+#include <QObject>
+#include <QVariantMap>
+#include <qqmlregistration.h>
+
+class QDBusServiceWatcher;
+
+/**
+ * Events for the feedback daemon (feedbackd, org.sigxcpu.Feedback).
+ *
+ * Each event is triggered under a key chosen by the caller. Triggering a
+ * key again ends the previous event of that key, end() ends it. Events
+ * without a timeout (0) are triggered again when the daemon restarts.
+ * Without the daemon nothing happens.
+ */
+class FeedbackEvents : public QObject
+{
+    Q_OBJECT
+    QML_ELEMENT
+    QML_SINGLETON
+
+public:
+    explicit FeedbackEvents(QObject *parent = nullptr);
+
+    /**
+     * Trigger @p event (event naming spec of feedbackd) for @p appId.
+     * @p hints are passed on (e.g. profile, important, sound-file).
+     * @p timeout in seconds, 0 runs until end(), -1 runs every feedback once.
+     */
+    Q_INVOKABLE void trigger(const QString &key, const QString &appId, const QString &event, const QVariantMap &hints, int timeout);
+    Q_INVOKABLE void end(const QString &key);
+    Q_INVOKABLE bool isActive(const QString &key) const;
+
+    /**
+     * Turn the display on as for user activity (PowerDevil wakeup).
+     */
+    Q_INVOKABLE void wakeScreen();
+
+private Q_SLOTS:
+    void onFeedbackEnded(uint id, uint reason);
+
+private:
+    struct Event {
+        QString appId;
+        QString event;
+        QVariantMap hints;
+        int timeout = -1;
+        quint64 serial = 0;
+        uint id = 0; // 0 while the reply of the daemon is pending
+    };
+
+    void send(const QString &key);
+    void endId(uint id);
+    void onDaemonRestarted();
+
+    QHash<QString, Event> m_events;
+    quint64 m_serial = 0;
+    QDBusServiceWatcher *m_watcher = nullptr;
+};
