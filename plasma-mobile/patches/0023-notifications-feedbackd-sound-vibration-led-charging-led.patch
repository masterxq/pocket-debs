diff --git a/components/mobileshell/qml/popups/notifications/NotificationFeedback.qml b/components/mobileshell/qml/popups/notifications/NotificationFeedback.qml
new file mode 100644
index 000000000..d15d0f013
--- /dev/null
+++ b/components/mobileshell/qml/popups/notifications/NotificationFeedback.qml
@@ -0,0 +1,201 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+import QtQuick
+
+import org.kde.notificationmanager as NotificationManager
+import org.kde.plasma.private.mobileshell as MobileShell
+import org.kde.plasma.private.mobileshell.state as MobileShellState
+import org.kde.plasma.private.mobileshell.shellsettingsplugin as ShellSettings
+import org.kde.plasma.private.mobileshell.hapticsplugin as HapticsPlugin
+import org.kde.plasma.private.mobileshell.dpmsplugin as DPMS
+
+/**
+ * Sound, vibration and LED for notifications through feedbackd, and the
+ * charging indicator on the LED. The event depends on the category and
+ * the urgency of a notification; feedbackd decides by the priorities of
+ * its theme which event a device shows when several compete.
+ *
+ * - Applications using KNotification play their own sounds, so their
+ *   events get no sound from feedbackd.
+ * - Do not disturb: only alarms keep their feedback, everything else
+ *   (incoming calls too) only lights the LED.
+ * - A notification that arrives while the phone is locked or the
+ *   display is off starts the reminder on the LED until it is seen:
+ *   unlock, display on without a lock, or the action drawer opens.
+ */
+Item {
+    id: root
+
+    required property bool inhibited
+    required property QtObject notificationSettings
+
+    readonly property string shellId: "org.kde.plasmashell"
+
+    readonly property bool locked: MobileShellState.LockscreenDBusClient.lockscreenActive
+    readonly property bool drawerOpen: MobileShellState.ShellDBusClient.isActionDrawerOpen
+    property bool screenOn: true
+    readonly property bool seen: drawerOpen || (!locked && screenOn)
+
+    // ids of the notifications the reminder on the LED stands for
+    property var unseen: []
+    property bool ready: false
+
+    readonly property bool charging: MobileShell.BatteryInfo.charging
+
+    onChargingChanged: updateCharging()
+    onSeenChanged: {
+        if (seen) {
+            clearUnseen();
+        }
+    }
+
+    Component.onCompleted: {
+        updateCharging();
+        // notifications that are there already got their feedback before
+        Qt.callLater(() => { root.ready = true; });
+    }
+
+    function updateCharging() {
+        if (charging) {
+            if (!HapticsPlugin.FeedbackEvents.isActive("charging")) {
+                HapticsPlugin.FeedbackEvents.trigger("charging", shellId, "battery-charging", {}, 0);
+            }
+        } else {
+            HapticsPlugin.FeedbackEvents.end("charging");
+        }
+    }
+
+    function clearUnseen() {
+        unseen = [];
+        HapticsPlugin.FeedbackEvents.end("unseen");
+    }
+
+    function listed(applications, services, desktopEntry, notifyRcName) {
+        return (desktopEntry !== "" && applications.includes(desktopEntry))
+            || (notifyRcName !== "" && services.includes(notifyRcName));
+    }
+
+    // Event for the category of a notification (event naming spec of feedbackd)
+    function eventFor(category) {
+        if (category === "call.incoming" || category === "x-kde.incoming-call") {
+            return { kind: "call", event: "phone-incoming-call", missed: "" };
+        }
+        if (category === "alarm.ringing") {
+            return { kind: "alarm", event: "alarm-clock-elapsed", missed: "" };
+        }
+        if (category.startsWith("cellbroadcast.")) {
+            return { kind: "alert", event: "message-new-cellbroadcast", missed: "notification-missed-generic" };
+        }
+        if (category === "call.unanswered") {
+            return { kind: "", event: "notification-new-generic", missed: "phone-missed-call" };
+        }
+        if (category === "im" || category.startsWith("im.")) {
+            return { kind: "", event: "message-new-instant", missed: "message-missed-instant" };
+        }
+        if (category === "email" || category.startsWith("email.")) {
+            return { kind: "", event: "message-new-email", missed: "message-missed-email" };
+        }
+        return { kind: "", event: "notification-new-generic", missed: "notification-missed-generic" };
+    }
+
+    function added(idx) {
+        const N = NotificationManager.Notifications;
+        if (notifications.data(idx, N.TypeRole) !== N.NotificationType) {
+            return;
+        }
+        const urgency = notifications.data(idx, N.UrgencyRole);
+        if (urgency === N.LowUrgency || notifications.data(idx, N.UserActionFeedbackRole)) {
+            return;
+        }
+
+        const desktopEntry = notifications.data(idx, N.DesktopEntryRole) || "";
+        const notifyRcName = notifications.data(idx, N.NotifyRcNameRole) || "";
+        const s = notificationSettings;
+        // shown neither as popup nor in the drawer
+        if (listed(s.popupBlacklistedApplications, s.popupBlacklistedServices, desktopEntry, notifyRcName)
+            && listed(s.historyBlacklistedApplications, s.historyBlacklistedServices, desktopEntry, notifyRcName)) {
+            return;
+        }
+
+        const id = notifications.data(idx, N.IdRole);
+        const category = notifications.data(idx, N.CategoryRole) || "";
+        const notificationHints = notifications.data(idx, N.HintsRole) || {};
+        const appId = desktopEntry || notifyRcName || notifications.data(idx, N.ApplicationNameRole) || shellId;
+        const f = eventFor(category);
+
+        const exempt = f.kind === "alarm"
+            || listed(s.doNotDisturbPopupWhitelistedApplications, s.doNotDisturbPopupWhitelistedServices, desktopEntry, notifyRcName);
+        const quiet = inhibited && !exempt;
+
+        const hints = {};
+        if (quiet) {
+            hints.profile = "silent";
+        } else if (notificationHints["suppress-sound"] === true || ("x-kde-appname" in notificationHints)) {
+            // the application plays its sound itself
+            hints.profile = "quiet";
+        } else if (notificationHints["sound-file"]) {
+            hints["sound-file"] = notificationHints["sound-file"];
+        }
+        if (f.kind !== "" || urgency === N.CriticalUrgency) {
+            hints.important = true;
+        }
+
+        // calls and alarms last as long as their notification
+        const endless = f.kind === "call" || f.kind === "alarm";
+        HapticsPlugin.FeedbackEvents.trigger("n" + id, appId, f.event, hints, endless ? 0 : -1);
+
+        if (f.missed !== "" && !seen && !notifications.data(idx, N.TransientRole)) {
+            unseen = unseen.concat([id]);
+            HapticsPlugin.FeedbackEvents.trigger("unseen", shellId, f.missed, {}, 0);
+        }
+
+        if (!quiet && !screenOn && f.kind !== "call" && ShellSettings.Settings.wakeScreenOnNotification) {
+            HapticsPlugin.FeedbackEvents.wakeScreen();
+        }
+    }
+
+    function removed(id) {
+        HapticsPlugin.FeedbackEvents.end("n" + id);
+        if (unseen.includes(id)) {
+            unseen = unseen.filter(other => other !== id);
+            if (unseen.length === 0) {
+                HapticsPlugin.FeedbackEvents.end("unseen");
+            }
+        }
+    }
+
+    DPMS.DPMSUtil {
+        onDpmsTurnedOn: root.screenOn = true
+        onDpmsTurnedOff: root.screenOn = false
+    }
+
+    NotificationManager.Notifications {
+        id: notifications
+
+        showExpired: true
+        showDismissed: true
+        showJobs: false
+        groupMode: NotificationManager.Notifications.GroupDisabled
+        urgencies: NotificationManager.Notifications.LowUrgency
+                   | NotificationManager.Notifications.NormalUrgency
+                   | NotificationManager.Notifications.CriticalUrgency
+
+        onRowsInserted: (parent, first, last) => {
+            if (!root.ready) {
+                return;
+            }
+            for (let row = first; row <= last; ++row) {
+                root.added(notifications.index(row, 0));
+            }
+        }
+        onRowsAboutToBeRemoved: (parent, first, last) => {
+            for (let row = first; row <= last; ++row) {
+                root.removed(notifications.data(notifications.index(row, 0), NotificationManager.Notifications.IdRole));
+            }
+        }
+    }
+}
