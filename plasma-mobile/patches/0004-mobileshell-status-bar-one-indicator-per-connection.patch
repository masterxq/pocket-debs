+// SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+pragma Singleton
+
+import QtQuick
+
+import org.kde.kirigami as Kirigami
+import org.kde.plasma.private.mobileshell as MobileShell
+import org.kde.plasma.private.mobileshell.dpmsplugin as DPMS
+
+/**
+ * Opacity of the status bar indicators of connections that are being activated.
+ *
+ * All of them pulse in the same phase over 2.4 s: 1 s fade in, 0.2 s visible, 1 s fade out, 0.2 s invisible, with
+ * sine easing. The opacity changes in steps (stepsPerSecond during the fades, none during the holds), so the status
+ * bar is redrawn a few times per second instead of at the frame rate. The pulse runs only while an indicator pulses
+ * and a screen is on. With animations disabled the indicators are shown half transparent instead.
+ */
+QtObject {
+    id: root
+
+    // opacity steps per second during the fades
+    readonly property int stepsPerSecond: 8
+
+    readonly property bool animated: Kirigami.Units.longDuration > 0
+    readonly property real opacity: animated ? _value : 0.5
+    readonly property bool pulsing: animated && _needed && _screenOn
+
+    property real _value: 0
+    property double _start: 0
+
+    readonly property bool _needed: MobileShell.SignalStrengthInfo.mobileDataActivating || MobileShell.NetworkInfo.wifiActivating
+
+    // names of the screens that DPMS turned off
+    property var _screensOff: []
+    readonly property bool _screenOn: _screensOff.length < Qt.application.screens.length
+
+    property DPMS.DPMSUtil _dpms: DPMS.DPMSUtil {
+        onDpmsTurnedOff: (screen) => {
+            if (screen && !root._screensOff.includes(screen.name)) {
+                root._screensOff = root._screensOff.concat([screen.name]);
+            }
+        }
+        onDpmsTurnedOn: (screen) => {
+            if (screen) {
+                root._screensOff = root._screensOff.filter(name => name !== screen.name);
+            }
+        }
+    }
+
+    property Timer _timer: Timer {
+        repeat: false
+        onTriggered: root._step()
+    }
+
+    // sine ease in and out, t from 0 to 1
+    function _ease(t) {
+        return (1 - Math.cos(Math.PI * t)) / 2;
+    }
+
+    // sets the opacity for the current time and schedules the next step: the next fade step, or the end of a hold
+    function _step() {
+        const phase = (Date.now() - _start) % 2400;
+        const stepInterval = Math.round(1000 / stepsPerSecond);
+        let next;
+        if (phase < 1000) {
+            _value = _ease(phase / 1000);
+            next = Math.min(stepInterval, 1000 - phase);
+        } else if (phase < 1200) {
+            _value = 1;
+            next = 1200 - phase;
+        } else if (phase < 2200) {
+            _value = 1 - _ease((phase - 1200) / 1000);
+            next = Math.min(stepInterval, 2200 - phase);
+        } else {
+            _value = 0;
+            next = 2400 - phase;
+        }
+        _timer.interval = Math.max(1, next);
+        _timer.restart();
+    }
+
+    onPulsingChanged: {
+        if (pulsing) {
+            _start = Date.now();
+            _step();
+        } else {
+            _timer.stop();
+        }
+    }
+    Component.onCompleted: {
+        if (pulsing) {
+            _start = Date.now();
+            _step();
+        }
+    }
+}
