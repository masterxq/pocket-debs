+import QtQuick
+
+import org.kde.kirigami as Kirigami
+
+/**
+ * Red cross of a status bar indicator whose connection failed.
+ */
+Item {
+    id: root
+
+    readonly property real lineWidth: Math.max(1.5, Math.min(width, height) * 0.18)
+
+    Repeater {
+        model: [45, -45]
+
+        delegate: Rectangle {
+            required property int modelData
+
+            anchors.centerIn: parent
+            width: Math.min(root.width, root.height) * 1.25
+            height: root.lineWidth
+            radius: height / 2
+            rotation: modelData
+            antialiasing: true
+            color: Kirigami.Theme.negativeTextColor
+        }
+    }
+}
