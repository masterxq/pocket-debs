+// SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import QtQuick
+
+import org.kde.kirigami as Kirigami
+
+/**
+ * A glyph in the 22 × 22 grid of the Breeze status icons, drawn with strokes of one grid unit like the network type
+ * letters of the network-mobile icons: "e" (the letter E), "dots" (three dots on the base line) or "cross", in the
+ * 5 × 5 box whose top left corner is (boxX, boxY). The item covers the painted area of the icon.
+ */
+Item {
+    id: root
+
+    property string glyph
+    property real boxX: 3
+    property real boxY: 3
+    property color color: Kirigami.Theme.textColor
+
+    readonly property real unit: Math.min(width, height) / 22
+
+    component Stroke: Rectangle {
+        property real gridX
+        property real gridY
+        property real gridWidth: 1
+        property real gridHeight: 1
+
+        x: (root.boxX + gridX) * root.unit
+        y: (root.boxY + gridY) * root.unit
+        width: gridWidth * root.unit
+        height: gridHeight * root.unit
+        color: root.color
+        antialiasing: true
+    }
+
+    Stroke { visible: root.glyph === "e"; gridX: 0; gridY: 0; gridHeight: 5 }
+    Stroke { visible: root.glyph === "e"; gridX: 0; gridY: 0; gridWidth: 4 }
+    Stroke { visible: root.glyph === "e"; gridX: 0; gridY: 2; gridWidth: 3 }
+    Stroke { visible: root.glyph === "e"; gridX: 0; gridY: 4; gridWidth: 4 }
+
+    Stroke { visible: root.glyph === "dots"; gridX: 0; gridY: 4 }
+    Stroke { visible: root.glyph === "dots"; gridX: 2; gridY: 4 }
+    Stroke { visible: root.glyph === "dots"; gridX: 4; gridY: 4 }
+
+    Repeater {
+        model: root.glyph === "cross" ? [45, -45] : []
+
+        delegate: Stroke {
+            required property int modelData
+
+            gridX: 2.5 - gridWidth / 2
+            gridY: 2
+            gridWidth: 6
+            rotation: modelData
+        }
+    }
+}
