@@ -0,0 +1,44 @@
+// SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import QtQuick
+
+import org.kde.kirigami as Kirigami
+import org.kde.plasma.networkmanagement as PlasmaNM
+import org.kde.plasma.private.mobileshell as MobileShell
+
+/**
+ * Wi-Fi client connection: the signal strength while connected, pulsing while it is activated (in the negative
+ * color after a minute), a red cross when an activation failed. Hidden while Wi-Fi is off or not connecting.
+ */
+Item {
+    id: root
+
+    readonly property var wirelessStatus: MobileShell.NetworkInfo.wirelessStatus
+    readonly property bool activating: wirelessStatus.wifiState === PlasmaNM.WirelessStatus.WifiActivating
+    readonly property bool failed: wirelessStatus.wifiState === PlasmaNM.WirelessStatus.WifiFailed
+
+    visible: wirelessStatus.wifiState !== PlasmaNM.WirelessStatus.WifiDisconnected
+
+    function strengthIcon(strength) {
+        if (strength <= 0) {
+            return "network-wireless-0";
+        }
+        return "network-wireless-" + Math.min(100, (Math.floor(strength / 20) + 1) * 20);
+    }
+
+    Kirigami.Icon {
+        anchors.fill: parent
+        source: root.failed ? "network-wireless-0" : root.strengthIcon(root.wirelessStatus.wifiSignalStrength)
+        color: root.activating && MobileShell.NetworkInfo.wifiActivatingLong ? Kirigami.Theme.negativeTextColor : "transparent"
+        opacity: root.activating ? MobileShell.IndicatorPulse.opacity : 1
+    }
+
+    FailureMark {
+        anchors.right: parent.right
+        anchors.bottom: parent.bottom
+        width: Math.round(parent.width * 0.45)
+        height: width
+        visible: root.failed
+    }
+}
