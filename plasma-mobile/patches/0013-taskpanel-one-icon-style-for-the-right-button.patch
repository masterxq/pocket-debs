diff --git a/containments/taskpanel/qml/NavigationPanelComponent.qml b/containments/taskpanel/qml/NavigationPanelComponent.qml
index a044cb64a..2985f3a2a 100644
--- a/containments/taskpanel/qml/NavigationPanelComponent.qml
+++ b/containments/taskpanel/qml/NavigationPanelComponent.qml
@@ -101,9 +101,12 @@ MobileShell.NavigationPanel {
         readonly property bool showBack: !Keyboards.KWinVirtualKeyboard.visible && WindowPlugin.WindowUtil.activeWindowCanGoBack
 
         enabled: Keyboards.KWinVirtualKeyboard.visible || showBack || WindowPlugin.WindowUtil.hasCloseableActiveWindow
-        iconSource: Keyboards.KWinVirtualKeyboard.visible ? "go-down-symbolic" : (showBack ? "go-previous-symbolic" : "mobile-close-app")
-        // mobile-close-app (from plasma-frameworks) seems to have fewer margins than icons from breeze-icons
-        shrinkSize: (Keyboards.KWinVirtualKeyboard.visible || showBack) ? 0 : 4
+        // hide keyboard, back and close share one style: 12px grid, open strokes, stroke width 1.4 (slightly heavier than
