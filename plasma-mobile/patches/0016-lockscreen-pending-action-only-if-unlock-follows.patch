index cbe4228a1..937d92c0c 100644
--- a/components/mobileshell/qml/actiondrawer/ActionDrawer.qml
+++ b/components/mobileshell/qml/actiondrawer/ActionDrawer.qml
@@ -134,6 +134,13 @@ Item {
      */
     signal runPendingNotificationAction()
 
+    /**
+     * Drops the held notification action that was pending for authentication.
+     *
+     * Should be called by users if the authentication requested with permissionsRequested() was abandoned.
+     */
+    signal cancelPendingNotificationAction()
+
     property real oldOffset
     onOffsetChanged: {
         if (offset < 0) {
diff --git a/components/mobileshell/qml/actiondrawer/private/NotificationDrawer.qml b/components/mobileshell/qml/actiondrawer/private/NotificationDrawer.qml
index a14c5cebc..974ef5380 100644
--- a/components/mobileshell/qml/actiondrawer/private/NotificationDrawer.qml
+++ b/components/mobileshell/qml/actiondrawer/private/NotificationDrawer.qml
@@ -68,6 +68,10 @@ Item {
             function onRunPendingNotificationAction() {
                 notificationWidget.runPendingAction();
             }
+
+            function onCancelPendingNotificationAction() {
+                notificationWidget.cancelPendingAction();
+            }
         }
 
         // the first swipe when at the top of the notification list is handled using a MouseArea, not the flickable
diff --git a/components/mobileshell/qml/widgets/notifications/NotificationsWidget.qml b/components/mobileshell/qml/widgets/notifications/NotificationsWidget.qml
index 6caa9e4ce..114236261 100644
--- a/components/mobileshell/qml/widgets/notifications/NotificationsWidget.qml
+++ b/components/mobileshell/qml/widgets/notifications/NotificationsWidget.qml
@@ -122,6 +122,13 @@ Item {
         }
     }
 
+    /**
+     * Drop the pending action, the authentication requested with unlockRequested() was abandoned.
+     */
+    function cancelPendingAction() {
+        list.pendingNotificationWithAction = null;
+    }
+
     /**
      * Clears the history of the notification model.
      */
