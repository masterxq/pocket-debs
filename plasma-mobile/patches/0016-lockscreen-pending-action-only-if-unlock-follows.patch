index 8884666f3..eb0017273 100644
--- a/components/mobileshellstate/shelldbusclient.cpp
+++ b/components/mobileshellstate/shelldbusclient.cpp
@@ -51,6 +51,7 @@ void ShellDBusClient::connectSignals()
     connect(m_interface, &OrgKdePlasmashellInterface::resetHomeScreenPositionRequested, this, &ShellDBusClient::resetHomeScreenPositionRequested);
     connect(m_interface, &OrgKdePlasmashellInterface::showVolumeOSDRequested, this, &ShellDBusClient::showVolumeOSDRequested);
     connect(m_interface, &OrgKdePlasmashellInterface::openLockScreenKeypadRequested, this, &ShellDBusClient::openLockScreenKeypadRequested);
+    connect(m_interface, &OrgKdePlasmashellInterface::lockScreenUnlockCancelled, this, &ShellDBusClient::lockScreenUnlockCancelled);
 
     // Initial state fetch
     updatePanelState();
@@ -162,6 +163,11 @@ void ShellDBusClient::openLockScreenKeypad()
     m_interface->openLockScreenKeypad();
 }
 
+void ShellDBusClient::cancelLockScreenUnlock()
+{
+    m_interface->cancelLockScreenUnlock();
+}
+
 void ShellDBusClient::updatePanelState()
 {
     auto reply = m_interface->panelState();
diff --git a/components/mobileshellstate/shelldbusclient.h b/components/mobileshellstate/shelldbusclient.h
