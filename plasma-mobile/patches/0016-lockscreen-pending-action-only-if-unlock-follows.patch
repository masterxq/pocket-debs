-                Qt.quit();
+                root.finishUnlock();
             }
         }
 
diff --git a/shell/contents/lockscreen/NotificationsComponent.qml b/shell/contents/lockscreen/NotificationsComponent.qml
index 151884e59..5ae6898a6 100644
--- a/shell/contents/lockscreen/NotificationsComponent.qml
+++ b/shell/contents/lockscreen/NotificationsComponent.qml
@@ -40,19 +40,24 @@ Loader {
         onTriggered: root.active = true
     }
 
+    // A tapped action runs only if the unlock directly follows it: a wrong PIN keeps it while the keypad stays
+    // open, leaving the keypad (or the display turning off) drops it.
     Connections {
         target: lockScreenState
 
         function onUnlockSucceeded() {
             // run pending action if successfully unlocked
-            if (notificationsList.requestNotificationAction) {
+            if (notificationsList && notificationsList.requestNotificationAction) {
                 notificationsList.runPendingAction();
                 notificationsList.requestNotificationAction = false;
             }
         }
 
-        function onUnlockFailed() {
-            notificationsList.requestNotificationAction = false;
+        function onUnlockCancelled() {
+            if (notificationsList) {
+                notificationsList.cancelPendingAction();
+                notificationsList.requestNotificationAction = false;
+            }
         }
     }
 
