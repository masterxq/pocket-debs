+                lockScreenState.unlockCancelled();
             }
         }
     }
@@ -123,7 +133,7 @@ Item {
             // Unlock lockscreen if it's already unlocked and keypad is opened
             onOpened: {
                 if (root.lockScreenState.canBeUnlocked) {
-                    Qt.quit();
+                    root.lockScreenState.finishUnlock();
                 }
             }
 
@@ -132,7 +142,7 @@ Item {
