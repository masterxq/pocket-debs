 }
+
+void ShellDBusObject::cancelLockScreenUnlock()
+{
+    Q_EMIT lockScreenUnlockCancelled();
+}
diff --git a/components/mobileshellstate/shelldbusobject.h b/components/mobileshellstate/shelldbusobject.h
index b39f1cbf8..1543e78bc 100644
--- a/components/mobileshellstate/shelldbusobject.h
+++ b/components/mobileshellstate/shelldbusobject.h
@@ -39,6 +39,7 @@ Q_SIGNALS:
     Q_SCRIPTABLE void resetHomeScreenPositionRequested();
     Q_SCRIPTABLE void showVolumeOSDRequested();
     Q_SCRIPTABLE void openLockScreenKeypadRequested();
+    Q_SCRIPTABLE void lockScreenUnlockCancelled();
 
