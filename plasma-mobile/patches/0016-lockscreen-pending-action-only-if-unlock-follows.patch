@@ -54,6 +54,9 @@ QtObject {
     signal reset()
     signal unlockSucceeded()
     signal unlockFailed()
+
+    // the user left the keypad without unlocking (keypad closed, display turned off)
+    signal unlockCancelled()
     signal fingerprintFailed()
 
     Component.onCompleted: {
@@ -111,6 +114,12 @@ QtObject {
         root.reset();
     }
 
+    // Called once the lockscreen may go away: unlocked by authentication, or no authentication needed
+    function finishUnlock(): void {
+        root.unlockSucceeded();
+        Qt.quit();
+    }
+
     function resetPinLabel(): void {
         pinLabel = enterPinLabel;
     }
@@ -166,8 +175,7 @@ QtObject {
             if (authenticator.hadPrompt) {
                 console.log('login succeeded');
                 root.waitingForAuth = false;
