@@ -0,0 +1,121 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<protocol name="kde_back_navigation_shell_v1">
+  <copyright>
+    Copyright © 2026 masterxq
+
+    Permission is hereby granted, free of charge, to any person obtaining a
+    copy of this software and associated documentation files (the "Software"),
+    to deal in the Software without restriction, including without limitation
+    the rights to use, copy, modify, merge, publish, distribute, sublicense,
+    and/or sell copies of the Software, and to permit persons to whom the
+    Software is furnished to do so, subject to the following conditions:
+
+    The above copyright notice and this permission notice (including the next
+    paragraph) shall be included in all copies or substantial portions of the
+    Software.
+
+    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+    THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+    DEALINGS IN THE SOFTWARE.
+  </copyright>
+
+  <description summary="back navigation for the windows of a Plasma shell">
+    This protocol gives a shell that manages windows through
+    org_kde_plasma_window_management access to the back navigation state of
+    those windows and lets it trigger back in them. The state and the meaning
+    of back are defined by the kde_back_navigation_v1 protocol, through which
+    applications take part.
+
+    A shell would typically offer a back control for the active window while
+    its state is available, and its usual controls (for example closing the
+    window) otherwise.
+
+    Access to a window requires its org_kde_plasma_window object, so only
+    clients that the compositor allows to manage windows can use this
+    protocol.
+
+    Warning! The protocol described in this file is currently in the testing
+    phase. Backward compatible changes may be added together with the
+    corresponding interface version bump. Backward incompatible changes can
+    only be done by creating a new major version of the extension.
+  </description>
+
+  <interface name="kde_back_navigation_shell_v1" version="1">
+    <description summary="access back navigation of plasma windows">
+      A global that creates kde_back_navigation_window_v1 objects for
+      org_kde_plasma_window objects.
+    </description>
+
+    <request name="destroy" type="destructor">
+      <description summary="destroy the global">
+        Destroy the object. Objects created through it are not affected.
+      </description>
+    </request>
+
+    <request name="get_window">
+      <description summary="get the back navigation of a window">
+        Create a kde_back_navigation_window_v1 object for the window that the
+        given org_kde_plasma_window represents. Several objects may be created
+        for the same window; each one reports the state and can trigger back.
+      </description>
+      <arg name="id" type="new_id" interface="kde_back_navigation_window_v1"/>
+      <arg name="window" type="object" interface="org_kde_plasma_window"/>
+    </request>
+  </interface>
+
+  <interface name="kde_back_navigation_window_v1" version="1">
+    <description summary="back navigation of one window">
+      The back navigation state of one window and the request to go back in
+      it.
+
+      When the window is unmapped (org_kde_plasma_window.unmapped) or its
+      org_kde_plasma_window was already unmapped when this object was created,
+      the object becomes inert: no further events are sent, also not the
+      initial state event, and back has no effect. The client should destroy
+      it.
+    </description>
+
+    <enum name="state">
+      <entry name="unavailable" value="0"
+        summary="back has no effect in the window"/>
+      <entry name="available" value="1"
+        summary="back goes back one step in the window"/>
+    </enum>
+
+    <request name="destroy" type="destructor">
+      <description summary="destroy the object">
+        Destroy the object.
+      </description>
+    </request>
+
+    <event name="state">
+      <description summary="back navigation state of the window">
+        The current back navigation state of the window as the application
+        set it with kde_back_navigation_v1.set_state. Windows of applications
+        that do not use kde_back_navigation_v1, and windows that are not
+        xdg_toplevels, are always unavailable.
+
+        Sent once right after the object is created, then whenever the state
+        changes.
+      </description>
+      <arg name="state" type="uint" enum="state"/>
+    </event>
+
+    <request name="back">
+      <description summary="go back in the window">
+        Ask the compositor to send kde_back_navigation_v1.back to the window.
+        Use this only in response to a user action.
+
+        The compositor sends the event only if the state of the window is
+        available when it processes this request and the window can receive
+        user input (see kde_back_navigation_v1.back); otherwise the request
+        has no effect. No answer is sent; a change of the state is reported
+        through the state event.
+      </description>
+    </request>
+  </interface>
+</protocol>
