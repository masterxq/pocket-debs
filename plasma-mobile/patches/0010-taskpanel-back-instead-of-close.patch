index 0000000..9cd97c6
--- /dev/null
+++ b/components/windowplugin/backnavigation.h
@@ -0,0 +1,58 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 masterxq
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#pragma once
+
+#include <QObject>
+#include <QWaylandClientExtensionTemplate>
+
+#include <memory>
+
+#include "qwayland-kde-back-navigation-shell-v1.h"
+
+struct org_kde_plasma_window;
+
+/**
+ * Back navigation state of one window (kde_back_navigation_window_v1).
+ */
+class BackNavigationWindow : public QObject, public QtWayland::kde_back_navigation_window_v1
+{
+    Q_OBJECT
+
+public:
+    explicit BackNavigationWindow(struct ::kde_back_navigation_window_v1 *object);
+    ~BackNavigationWindow() override;
+
+    /**
+     * Whether back currently has an effect in the window.
+     */
+    bool isAvailable() const;
+
+Q_SIGNALS:
+    void availableChanged();
+
+protected:
+    void kde_back_navigation_window_v1_state(uint32_t state) override;
+
+private:
+    bool m_available = false;
+};
+
+/**
+ * The kde_back_navigation_shell_v1 global.
+ */
+class BackNavigationShell : public QWaylandClientExtensionTemplate<BackNavigationShell>, public QtWayland::kde_back_navigation_shell_v1
+{
+public:
+    BackNavigationShell();
+    ~BackNavigationShell() override;
+
+    /**
+     * Returns the back navigation of @p window, or @c null if the compositor does not offer
+     * kde_back_navigation_shell_v1.
+     */
+    std::unique_ptr<BackNavigationWindow> windowBackNavigation(struct ::org_kde_plasma_window *window);
+};
