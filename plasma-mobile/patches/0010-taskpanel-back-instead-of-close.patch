new file mode 100644
index 0000000..9570fef
--- /dev/null
+++ b/components/windowplugin/backnavigation.cpp
@@ -0,0 +1,57 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 masterxq
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "backnavigation.h"
+
+BackNavigationWindow::BackNavigationWindow(struct ::kde_back_navigation_window_v1 *object)
+    : QtWayland::kde_back_navigation_window_v1(object)
+{
+}
+
+BackNavigationWindow::~BackNavigationWindow()
+{
+    if (isInitialized()) {
+        destroy();
+    }
+}
+
+bool BackNavigationWindow::isAvailable() const
+{
+    return m_available;
+}
+
+void BackNavigationWindow::kde_back_navigation_window_v1_state(uint32_t state)
+{
+    const bool available = state == state_available;
+    if (m_available == available) {
+        return;
+    }
+    m_available = available;
+    Q_EMIT availableChanged();
+}
+
+BackNavigationShell::BackNavigationShell()
+    : QWaylandClientExtensionTemplate<BackNavigationShell>(1)
+{
+    initialize();
+}
+
+BackNavigationShell::~BackNavigationShell()
+{
+    if (isActive()) {
+        destroy();
+    }
+}
+
+std::unique_ptr<BackNavigationWindow> BackNavigationShell::windowBackNavigation(struct ::org_kde_plasma_window *window)
+{
+    if (!isActive() || !window) {
+        return nullptr;
+    }
+    return std::make_unique<BackNavigationWindow>(get_window(window));
+}
+
+#include "moc_backnavigation.cpp"
