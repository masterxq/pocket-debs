         connect(m_windowManagement, &PlasmaWindowManagement::showingDesktopChanged, this, &WindowUtil::updateShowingDesktop);
         connect(m_windowManagement, &PlasmaWindowManagement::activeWindowChanged, m_activeWindowTimer, qOverload<>(&QTimer::start));
@@ -139,6 +147,7 @@ void WindowUtil::updateActiveWindow()
     }
 
     Q_EMIT hasCloseableActiveWindowChanged();
+    Q_EMIT activeWindowCanGoBackChanged();
 }
 
 bool WindowUtil::hasCloseableActiveWindow() const
@@ -165,6 +174,70 @@ void WindowUtil::closeActiveWindow()
     }
 }
 
+bool WindowUtil::activeWindowCanGoBack() const
+{
+    if (!m_activeWindow) {
+        return false;
+    }
+    const auto it = m_backNavigation.find(m_activeWindow.data());
+    return it != m_backNavigation.end() && it->second->isAvailable();
+}
+
+void WindowUtil::goBackInActiveWindow()
+{
+    if (!m_activeWindow) {
+        return;
+    }
+    // Sent to the window the state was shown for; the compositor checks the state again.
+    const auto it = m_backNavigation.find(m_activeWindow.data());
+    if (it != m_backNavigation.end() && it->second->isAvailable()) {
+        it->second->back();
+    }
+}
+
+void WindowUtil::trackBackNavigation(KWayland::Client::PlasmaWindow *window)
+{
+    if (!window || m_backNavigation.contains(window)) {
+        return;
+    }
+    auto backNavigation = m_backNavigationShell->windowBackNavigation(*window);
+    if (!backNavigation) {
+        return;
+    }
+    connect(backNavigation.get(), &BackNavigationWindow::availableChanged, this, [this, window]() {
+        if (window == m_activeWindow) {
+            Q_EMIT activeWindowCanGoBackChanged();
+        }
+    });
+    connect(window, &KWayland::Client::PlasmaWindow::unmapped, backNavigation.get(), [this, window]() {
+        untrackBackNavigation(window);
+    });
+    connect(window, &QObject::destroyed, backNavigation.get(), [this, window]() {
+        untrackBackNavigation(window);
+    });
+    m_backNavigation.emplace(window, std::move(backNavigation));
+}
+
+void WindowUtil::untrackBackNavigation(KWayland::Client::PlasmaWindow *window)
+{
+    // Deleting the object also ends the connections it is the context of.
+    if (m_backNavigation.erase(window) && window == m_activeWindow) {
+        Q_EMIT activeWindowCanGoBackChanged();
+    }
+}
+
+void WindowUtil::resetBackNavigation()
+{
+    m_backNavigation.clear();
+    if (m_windowManagement && m_backNavigationShell->isActive()) {
+        const auto windows = m_windowManagement->windows();
+        for (auto *window : windows) {
+            trackBackNavigation(window);
+        }
+    }
+    Q_EMIT activeWindowCanGoBackChanged();
+}
+
 void WindowUtil::requestShowingDesktop(bool showingDesktop)
 {
     if (!m_windowManagement) {
@@ -244,6 +317,7 @@ void WindowUtil::forgetActiveWindow()
