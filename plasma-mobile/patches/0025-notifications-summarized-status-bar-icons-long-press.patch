diff --git a/components/mobileshell/qml/popups/notifications/NotificationPopupProvider.qml b/components/mobileshell/qml/popups/notifications/NotificationPopupProvider.qml
index 78f49fd06..50d15cb42 100644
--- a/components/mobileshell/qml/popups/notifications/NotificationPopupProvider.qml
+++ b/components/mobileshell/qml/popups/notifications/NotificationPopupProvider.qml
@@ -29,6 +29,20 @@ QtObject {
     }
 
     property QtObject popupNotificationsModel: NotificationManager.Notifications {
+        id: popupModel
+
+        // Of the notifications of a conversation only the newest pops up, the others are in the drawer
+        onRowsInserted: (parent, first, last) => {
+            const N = NotificationManager.Notifications;
+            for (let row = first; row <= last; ++row) {
+                const idx = popupModel.index(row, 0);
+                if (popupModel.data(idx, N.TypeRole) === N.NotificationType) {
+                    notificationProvider.newPopups.push(popupModel.data(idx, N.IdRole));
+                }
+            }
+            Qt.callLater(notificationProvider.replaceOlderPopups);
+        }
+
         showExpired: false
         showDismissed: false
         blacklistedDesktopEntries: notificationSettings.popupBlacklistedApplications
@@ -68,6 +82,75 @@ QtObject {
         }
     }
 
+    // ids of new popups whose older popups of the same conversation are still to be replaced
+    property var newPopups: []
+
+    // The application and conversation of a popup, as grouped in the drawer: the conversation the application
+    // names or the summary; both are empty if the popup only shows the application.
+    function conversationKey(idx) {
+        const N = NotificationManager.Notifications;
+        const model = popupNotificationsModel;
+        const conversation = model.data(idx, N.ConversationRole) || "";
+        return [model.data(idx, N.ApplicationNameRole) || "",
+                model.data(idx, N.DesktopEntryRole) || "",
+                model.data(idx, N.OriginNameRole) || "",
+                conversation !== "" ? "c:" + conversation : "s:" + (model.data(idx, N.SummaryRole) || "")].join("\n");
+    }
+
+    function replaceOlderPopups() {
+        const N = NotificationManager.Notifications;
+        const model = popupNotificationsModel;
+        const ids = newPopups;
+        newPopups = [];
+
+        const rowOf = id => {
+            for (let row = 0; row < model.count; ++row) {
+                if (model.data(model.index(row, 0), N.IdRole) === id) {
+                    return row;
+                }
+            }
+            return -1;
+        };
+
+        for (const id of ids) {
+            const newRow = rowOf(id);
+            if (newRow < 0) {
+                continue;
+            }
+            const newIdx = model.index(newRow, 0);
+            if (model.data(newIdx, N.UrgencyRole) === N.CriticalUrgency) {
+                continue;
+            }
+            const key = conversationKey(newIdx);
+            const created = model.data(newIdx, N.CreatedRole);
+
+            const older = [];
+            for (let row = 0; row < model.count; ++row) {
+                const idx = model.index(row, 0);
+                const otherId = model.data(idx, N.IdRole);
+                if (otherId !== id && model.data(idx, N.TypeRole) === N.NotificationType
+                    && model.data(idx, N.UrgencyRole) !== N.CriticalUrgency
+                    && model.data(idx, N.CreatedRole) <= created && conversationKey(idx) === key) {
+                    older.push(otherId);
+                }
+            }
+
+            for (const otherId of older) {
+                const row = rowOf(otherId);
+                if (row < 0) {
+                    continue;
+                }
+                const idx = model.index(row, 0);
+                if (model.data(idx, N.ResidentRole)) {
+                    // like a resident popup that timed out: it stays a notification
+                    model.setData(idx, true, N.ExpiredRole);
+                } else {
+                    model.expire(idx);
+                }
+            }
+        }
+    }
+
     // TODO use pulseaudio-qt for this once it becomes a framework
     property QtObject __pulseAudio: Loader {
         source: "PulseAudio.qml"
