diff --git a/components/mobileshell/qml/statusbar/indicators/NotificationIndicator.qml b/components/mobileshell/qml/statusbar/indicators/NotificationIndicator.qml
new file mode 100644
index 000000000..550520a5c
--- /dev/null
+++ b/components/mobileshell/qml/statusbar/indicators/NotificationIndicator.qml
@@ -0,0 +1,120 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+import QtQuick
+import QtQuick.Layouts
+
+import org.kde.kirigami as Kirigami
+import org.kde.plasma.components 3.0 as PlasmaComponents
+import org.kde.notificationmanager as NotificationManager
+import org.kde.plasma.private.mobileshell.shellsettingsplugin as ShellSettings
+import org.kde.plasma.private.mobileshell.state as MobileShellState
+
+/**
+ * The icons of the applications with notifications in the drawer, newest first.
+ *
+ * While locked only the applications whose notifications the lock screen shows.
+ * At most ShellSettings.Settings.statusBarNotificationIcons icons; with more
+ * applications one icon less and an ellipsis. Applications with badges turned
+ * off in the notification settings are left out.
+ */
+RowLayout {
+    id: root
+
+    property real iconSize: Kirigami.Units.iconSizes.small
+    property real textPixelSize: 11
+
+    readonly property int maximum: ShellSettings.Settings.statusBarNotificationIcons
+    readonly property bool locked: MobileShellState.LockscreenDBusClient.lockscreenActive
+
+    // {key, icon} of each application, newest notification first
+    property var applications: []
+    readonly property bool overflowing: applications.length > maximum
+
+    // whether there is an icon to show (visible also depends on the parent)
+    readonly property bool shown: maximum > 0 && applications.length > 0
+
+    spacing: Math.round(Kirigami.Units.smallSpacing / 2)
+    visible: shown
+
+    function update() {
+        const N = NotificationManager.Notifications;
+        const hiddenApplications = settings.badgeBlacklistedApplications;
+        const hiddenServices = settings.badgeBlacklistedServices;
+        const seen = new Set();
+        const list = [];
+        for (let row = 0; row < notifications.count; ++row) {
+            const idx = notifications.index(row, 0);
+            const desktopEntry = notifications.data(idx, N.DesktopEntryRole) || "";
+            const notifyRcName = notifications.data(idx, N.NotifyRcNameRole) || "";
+            if ((desktopEntry !== "" && hiddenApplications.includes(desktopEntry))
+                || (notifyRcName !== "" && hiddenServices.includes(notifyRcName))) {
+                continue;
+            }
+            const key = desktopEntry || notifyRcName || notifications.data(idx, N.ApplicationNameRole) || "";
+            if (seen.has(key)) {
+                continue;
+            }
+            seen.add(key);
+            list.push({ key: key, icon: notifications.data(idx, N.ApplicationIconNameRole) || "preferences-desktop-notification-bell" });
+        }
+        applications = list;
+    }
+
+    NotificationManager.Settings {
+        id: settings
+        onSettingsChanged: Qt.callLater(root.update)
+    }
+
+    // the notifications that stay in the drawer until they are dismissed or closed by their application
+    NotificationManager.Notifications {
+        id: notifications
+
+        showExpired: true
+        showDismissed: true
+        showJobs: false
+        groupMode: NotificationManager.Notifications.GroupDisabled
+        sortMode: NotificationManager.Notifications.SortByDate
+        sortOrder: Qt.DescendingOrder
+        blacklistedDesktopEntries: settings.historyBlacklistedApplications
+        blacklistedNotifyRcNames: settings.historyBlacklistedServices
+        urgencies: NotificationManager.Notifications.CriticalUrgency
+                   | NotificationManager.Notifications.NormalUrgency
+                   | (settings.lowPriorityHistory ? NotificationManager.Notifications.LowUrgency : 0)
+
+        // over the lock screen the icons show what the lock screen shows
+        lockScreen: root.locked
+        visibility: root.locked ? settings.lockScreenVisibility : settings.historyVisibility
+        lockScreenVisibilityApplications: settings.lockScreenVisibilityApplications
+        lockScreenVisibilityServices: settings.lockScreenVisibilityServices
+
+        onCountChanged: Qt.callLater(root.update)
+        onDataChanged: Qt.callLater(root.update)
+        onLayoutChanged: Qt.callLater(root.update)
+        onModelReset: Qt.callLater(root.update)
+    }
+
+    Repeater {
+        model: root.overflowing ? Math.max(root.maximum - 1, 0) : root.applications.length
+
+        delegate: Kirigami.Icon {
+            required property int index
+
+            Layout.preferredWidth: root.iconSize
+            Layout.preferredHeight: root.iconSize
+            Layout.alignment: Qt.AlignVCenter
+            source: root.applications[index] ? root.applications[index].icon : ""
+        }
+    }
+
+    PlasmaComponents.Label {
+        Layout.alignment: Qt.AlignVCenter
+        visible: root.overflowing
+        text: "…"
+        font.pixelSize: root.textPixelSize
+        color: Kirigami.Theme.textColor
+    }
+}
