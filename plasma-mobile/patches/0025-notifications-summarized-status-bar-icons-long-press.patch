diff --git a/components/mobileshell/qml/widgets/notifications/NotificationOptions.qml b/components/mobileshell/qml/widgets/notifications/NotificationOptions.qml
new file mode 100644
index 000000000..e8b42c805
--- /dev/null
+++ b/components/mobileshell/qml/widgets/notifications/NotificationOptions.qml
@@ -0,0 +1,130 @@
+/*
+ * SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+import QtQuick
+import QtQuick.Layouts
+
+import org.kde.kirigami as Kirigami
+import org.kde.plasma.components 3.0 as PlasmaComponents
+import org.kde.notificationmanager as NotificationManager
+
+/**
+ * The settings of the application of a notification, shown in its card on a long press:
+ * mute it, hide it on the lock screen, open its notification settings.
+ *
+ * The settings belong to the service (notifyrc name) of applications using KNotification,
+ * otherwise to the application (desktop entry), like in the notification settings.
+ */
+ColumnLayout {
+    id: root
+
+    required property string applicationName
+    required property string desktopEntry
+    required property string notifyRcName
+
+    /**
+     * Whether the notification settings can be opened from here.
+     */
+    property bool settingsAvailable: true
+
+    signal closeRequested()
+    signal settingsRequested()
+
+    readonly property bool service: notifyRcName !== ""
+    readonly property string configName: service ? notifyRcName : desktopEntry
+
+    readonly property int feedback: {
+        settings.feedbackApplications;
+        settings.feedbackServices;
+        return service ? settings.serviceFeedback(configName) : settings.applicationFeedback(configName);
+    }
+    readonly property int lockScreenVisibility: {
+        settings.lockScreenVisibilityApplications;
+        settings.lockScreenVisibilityServices;
+        return service ? settings.serviceLockScreenVisibility(configName) : settings.applicationLockScreenVisibility(configName);
+    }
+
+    readonly property bool muted: feedback >= NotificationManager.Settings.FeedbackSilent
+    readonly property bool hiddenOnLockScreen: lockScreenVisibility >= NotificationManager.Notifications.VisibilityHidden
+
+    spacing: 0
+
+    NotificationManager.Settings {
+        id: settings
+    }
+
+    function setFeedback(value) {
+        if (service) {
+            settings.setServiceFeedback(configName, value);
+        } else {
+            settings.setApplicationFeedback(configName, value);
+        }
+        settings.save();
+    }
+
+    function setLockScreenVisibility(value) {
+        if (service) {
+            settings.setServiceLockScreenVisibility(configName, value);
+        } else {
+            settings.setApplicationLockScreenVisibility(configName, value);
+        }
+        settings.save();
+    }
+
+    RowLayout {
+        Layout.fillWidth: true
+        Layout.bottomMargin: Kirigami.Units.smallSpacing
+
+        PlasmaComponents.Label {
+            Layout.fillWidth: true
+            textFormat: Text.PlainText
+            elide: Text.ElideRight
+            font.weight: Font.DemiBold
+            text: i18nd("plasma_org.kde.plasma.private.mobileshell", "Notifications of %1", root.applicationName)
+        }
+
+        PlasmaComponents.ToolButton {
+            icon.name: "window-close-symbolic"
+            display: PlasmaComponents.AbstractButton.IconOnly
+            text: i18nd("plasma_org.kde.plasma.private.mobileshell", "Close")
+            onClicked: root.closeRequested()
+        }
+    }
+
+    PlasmaComponents.ToolButton {
+        Layout.fillWidth: true
+        icon.name: root.muted ? "audio-volume-high-symbolic" : "audio-volume-muted-symbolic"
+        text: root.muted ? i18nd("plasma_org.kde.plasma.private.mobileshell", "Sound and vibration on")
+                         : i18nd("plasma_org.kde.plasma.private.mobileshell", "Mute")
+        onClicked: {
+            root.setFeedback(root.muted ? NotificationManager.Settings.FeedbackFull : NotificationManager.Settings.FeedbackSilent);
+            root.closeRequested();
+        }
+    }
+
+    PlasmaComponents.ToolButton {
+        Layout.fillWidth: true
+        icon.name: root.hiddenOnLockScreen ? "view-visible-symbolic" : "view-hidden-symbolic"
+        text: root.hiddenOnLockScreen ? i18nd("plasma_org.kde.plasma.private.mobileshell", "Show on the lock screen")
+                                      : i18nd("plasma_org.kde.plasma.private.mobileshell", "Not on the lock screen")
+        onClicked: {
+            root.setLockScreenVisibility(root.hiddenOnLockScreen ? NotificationManager.Notifications.VisibilityFull
+                                                                 : NotificationManager.Notifications.VisibilityHidden);
+            root.closeRequested();
+        }
+    }
+
+    PlasmaComponents.ToolButton {
+        Layout.fillWidth: true
+        visible: root.settingsAvailable
+        icon.name: "configure-symbolic"
+        text: i18nd("plasma_org.kde.plasma.private.mobileshell", "Settings")
+        onClicked: {
+            root.settingsRequested();
+            root.closeRequested();
+        }
+    }
+}
