From: pocket-debs <masterxq@users.noreply.github.com>
Date: Tue, 25 Nov 2026 12:00:00 +0100
Subject: [PATCH] mobileshell: several modems: signal of every SIM, mobile data on the chosen modem
Description:
 With several modems (one per SIM on dual SIM phones) the shell showed the
 signal of the first modem only and the mobile data quick setting and the
 cellular page of the initial setup always worked on the first modem.
 .
 The status bar shows the signal of every SIM, each with the icon of the
 SIM (from the shared SIM icons of plasma-nm's cellular library), in the
 order of the SIM slots; with one modem it is unchanged. The mobile data
 quick setting and the initial setup follow the modem chosen for mobile
 data (CellularModemList.dataModem) and name its SIM. While modems go away
 and come back (a modem object restarted by ModemManager) the quick setting
 shows "Not Available" instead of failing on a missing modem.
 .
 Needs the cellular library of plasma-nm with CellularModemList.dataModem,
 CellularModem.sim/simSlot and CellularSim.name/icon.
Forwarded: no
License: GPL-2.0-or-later, LGPL-2.0-or-later (as the patched files)
Last-Update: 2026-11-25
---
--- a/components/mobileshell/qml/dataproviders/SignalStrengthInfo.qml
+++ b/components/mobileshell/qml/dataproviders/SignalStrengthInfo.qml
@@ -14,13 +14,30 @@ import org.kde.plasma.networkmanagement.cellular as Cellular
 QtObject {
     property Cellular.CellularModemList _modemList: Cellular.CellularModemList {}
 
-    readonly property string icon: "network-mobile-" + Math.floor((_modemList.primaryModem ? _modemList.primaryModem.signalStrength : 0) / 20) * 20
+    function _strengthIcon(modem) {
+        return "network-mobile-" + Math.floor((modem ? modem.signalStrength : 0) / 20) * 20;
+    }
 
-    readonly property string label: {
-        if (!_modemList.primaryModem) return "";
-        if (_modemList.primaryModem.simLocked) return i18n("SIM Locked");
-        return _modemList.primaryModem.operatorName;
+    function _label(modem) {
+        if (!modem) return "";
+        if (modem.simLocked) return i18n("SIM Locked");
+        return modem.operatorName;
     }
 
+    // the modem used for mobile data
+    readonly property string icon: _strengthIcon(_modemList.dataModem)
+    readonly property string label: _modemList.modems.length > 1 ? modems.map(modem => modem.label).filter(text => text !== "").join(" · ") : _label(_modemList.dataModem)
+
+    // every modem with a SIM, in the order of the SIM slots
+    readonly property var modems: _modemList.modems
+        .filter(modem => modem.sim !== null)
+        .sort((a, b) => a.simSlot - b.simSlot)
+        .map(modem => ({
+            "icon": _strengthIcon(modem),
+            "label": _label(modem),
+            "simIcon": modem.sim.icon,
+            "simName": modem.sim.name
+        }))
+
     readonly property bool showIndicator: _modemList.modemAvailable
 }
--- a/components/mobileshell/qml/statusbar/StatusBar.qml
+++ b/components/mobileshell/qml/statusbar/StatusBar.qml
@@ -132,7 +132,7 @@ Item {
                         visible: root.showTime
                         internetIndicator: internetIndicatorItem
                         implicitHeight: mainRow.rowHeight
-                        Layout.preferredWidth: height
+                        Layout.preferredWidth: implicitWidth
                     }
                     MobileShell.BluetoothIndicator {
                         implicitHeight: mainRow.rowHeight
--- a/components/mobileshell/qml/statusbar/indicators/SignalStrengthIndicator.qml
+++ b/components/mobileshell/qml/statusbar/indicators/SignalStrengthIndicator.qml
@@ -14,40 +14,75 @@ import org.kde.kirigami as Kirigami
 import org.kde.plasma.private.mobileshell as MobileShell
 
 Item {
+    id: root
+
     property InternetIndicator internetIndicator
 
     // check if the internet indicator icon is a mobile data related one
     readonly property bool isInternetIndicatorMobileData: internetIndicator && internetIndicator.icon && internetIndicator.icon.startsWith('network-mobile-')
 
+    // with several SIMs, the signal of each SIM is shown with the icon of the SIM
+    readonly property bool severalSims: MobileShell.SignalStrengthInfo.modems.length > 1
+
     property bool showLabel: true
     property real textPixelSize: Kirigami.Units.gridUnit * 0.6
 
-    width: strengthIcon.width + label.width
-    Layout.minimumWidth: strengthIcon.width + label.width
+    implicitWidth: row.width
+    width: row.width
+    Layout.minimumWidth: row.width
 
-    Kirigami.Icon {
-        id: strengthIcon
+    Row {
+        id: row
         anchors.left: parent.left
-        anchors.verticalCenter: parent.verticalCenter
-        width: height
-        height: parent.height
+        anchors.top: parent.top
+        anchors.bottom: parent.bottom
+        spacing: Kirigami.Units.smallSpacing
 
-        source: MobileShell.SignalStrengthInfo.icon
+        Kirigami.Icon {
+            id: strengthIcon
+            width: visible ? height : 0
+            height: row.height
 
-        // don't show mobile indicator icon if the networkmanager one is already showing
-        visible: (!isInternetIndicatorMobileData || wirelessStatus.hotspotSSID.length !== 0) && MobileShell.SignalStrengthInfo.showIndicator
-    }
+            source: MobileShell.SignalStrengthInfo.icon
+
+            // don't show mobile indicator icon if the networkmanager one is already showing
+            visible: !root.severalSims && (!isInternetIndicatorMobileData || wirelessStatus.hotspotSSID.length !== 0) && MobileShell.SignalStrengthInfo.showIndicator
+        }
+
+        Repeater {
+            model: root.severalSims ? MobileShell.SignalStrengthInfo.modems : []
+
+            delegate: Row {
+                required property var modelData
+
+                height: row.height
+                spacing: 0
+
+                Kirigami.Icon {
+                    anchors.verticalCenter: parent.verticalCenter
+                    width: Math.round(row.height * 0.6)
+                    height: width
+                    source: modelData.simIcon
+                    visible: modelData.simIcon !== ""
+                }
+
+                Kirigami.Icon {
+                    width: height
+                    height: row.height
+                    source: modelData.icon
+                }
+            }
+        }
+
+        PlasmaComponents.Label {
+            id: label
+            visible: showLabel
+            width: visible ? implicitWidth : 0
+            anchors.verticalCenter: parent.verticalCenter
 
-    PlasmaComponents.Label {
-        id: label
-        visible: showLabel
-        width: visible ? implicitWidth : 0
-        anchors.leftMargin: Kirigami.Units.smallSpacing
-        anchors.left: strengthIcon.right
-        anchors.verticalCenter: parent.verticalCenter
-
-        text: MobileShell.SignalStrengthInfo.label
-        color: Kirigami.Theme.textColor
-        font.pixelSize: textPixelSize
+            text: MobileShell.SignalStrengthInfo.label
+            color: Kirigami.Theme.textColor
+            font.pixelSize: textPixelSize
+        }
     }
 }
--- a/initialstart/modules/cellular/package/contents/ui/main.qml
+++ b/initialstart/modules/cellular/package/contents/ui/main.qml
@@ -21,7 +21,7 @@ InitialStartModule {
             id: modemList
         }
 
