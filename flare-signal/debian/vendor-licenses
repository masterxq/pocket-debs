#!/bin/sh
# Lists the crates under the vendor directory given as $1 with version and license expression (field "license" of
# Cargo.toml), followed by the license, copyright and notice files they ship. Identical texts are printed once.
set -eu
v=${1:?vendor directory}
t=$(mktemp -d)
trap 'rm -rf "$t"' EXIT

feld() {   # feld <Cargo.toml> <key>: value of <key> in the [package] table
	awk -v k="$2" '
		/^\[/ { p = ($0 == "[package]"); next }
		p && $1 == k && $2 == "=" { sub(/^[^=]*= *"/, ""); sub(/"[[:space:]]*$/, ""); print; exit }' "$1"
}

echo "Rust crates of the source (vendor/), from which the program is built, with their licenses and license texts."
echo
n=0
for c in "$v"/*/; do
	c=${c%/}
	[ -f "$c/Cargo.toml" ] || continue
	l=$(feld "$c/Cargo.toml" license)
	[ -n "$l" ] || l="see $(feld "$c/Cargo.toml" license-file)"
	texte=
	# also below the crate root: C libraries bundled in -sys crates carry their own license files
	for f in $(find "$c" -type f \( -iname 'LICEN[CS]E*' -o -iname 'COPYING*' -o -iname 'COPYRIGHT*' \
			-o -iname 'NOTICE*' -o -iname 'UNLICENSE*' \) ! -path '*/test*' ! -path '*/assets/*' | LC_ALL=C sort); do
		h=$(sha256sum < "$f" | cut -c1-16)
		if [ ! -f "$t/$h" ]; then
			n=$((n + 1))
			printf '%s %s\n' "$n" "${f#"$v"/}" > "$t/$h"
			cp "$f" "$t/$h.text"
			echo "$h" >> "$t/order"
		fi
		texte="$texte $(cut -d' ' -f1 "$t/$h")"
	done
	printf '%s %s: %s%s\n' "$(feld "$c/Cargo.toml" name)" "$(feld "$c/Cargo.toml" version)" "$l" \
		"${texte:+ (texts:$texte)}"
done
[ -f "$t/order" ] || exit 0
while read -r h; do
	printf '\n==== text %s, from %s ====\n\n' "$(cut -d' ' -f1 "$t/$h")" "$(cut -d' ' -f2 "$t/$h")"
	cat "$t/$h.text"
done < "$t/order"
