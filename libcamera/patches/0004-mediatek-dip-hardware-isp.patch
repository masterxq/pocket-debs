 	/**
 	 * \brief Sums of colour channels of all the sampled pixels
 	 */
 	RGB<uint64_t> sum_;
+	/**
+	 * \brief Number of zones of the zone grid in each direction
+	 */
+	static constexpr unsigned int kZones = 15;
+	/**
+	 * \brief Sums of the colour channels (8-bit scale, as sum_) of the
+	 *        sampled pixels in each zone of a kZones x kZones grid over the
+	 *        statistics window, row by row from the top left
+	 */
+	std::array<RGB<uint64_t>, kZones * kZones> zoneSum;
+	/**
+	 * \brief Number of sampled pixels (2x2 blocks) in each zone
+	 */
+	std::array<uint32_t, kZones * kZones> zoneCount;
 	/**
 	 * \brief Number of bins in the yHistogram
 	 */
@@ -43,6 +70,54 @@ struct SwIspStats {
 	 * \brief A histogram of luminance values of all the sampled pixels
 	 */
 	Histogram yHistogram;
+	/**
+	 * \brief Largest number of cells of the focus grid in each direction
+	 */
+	static constexpr unsigned int kAfGridMaxWidth = 160;
+	static constexpr unsigned int kAfGridMaxHeight = 120;
+	/**
+	 * \brief Number of columns and rows of the focus grid, 0 when the
+	 *        input format provides no focus statistics
+	 */
+	unsigned int afGridWidth;
+	unsigned int afGridHeight;
+	/**
+	 * \brief True if the focus grid was gathered for this frame (it is
+	 *        gathered on request only, see SwStatsCpu::setInterval())
+	 */
+	bool afGridValid;
+	/**
+	 * \brief Number of the last frame whose statistics were skipped on
+	 *        purpose (a longer interval, see SwStatsCpu::setInterval())
+	 */
+	uint32_t skippedFrame;
+	/**
+	 * \brief Number of the frame the focus grid belongs to
+	 *
+	 * The focus grid may be gathered on frames without the other
+	 * statistics (see SwStatsCpu::setInterval()); it is then valid for
+	 * afGridFrame while \a valid and \a frame still describe the last frame
+	 * with full statistics.
+	 */
+	uint32_t afGridFrame;
+	/**
+	 * \brief Edge length of a focus grid cell in pixels
+	 */
+	unsigned int afCellSize;
+	/**
+	 * \brief Number of green samples summed up in each focus grid cell
+	 */
+	unsigned int afCellSamples;
+	/**
