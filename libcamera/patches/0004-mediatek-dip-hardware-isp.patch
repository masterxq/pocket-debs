+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * MediaTek packed raw: packing, statistics and CPU debayering
+ *
+ * A synthetic 10-bit Bayer frame is stored once in MediaTek packing and once
+ * in CSI-2 packing. Statistics and CPU debayering must give identical results
+ * for both.
+ */
+
+#include <iostream>
+#include <memory>
+#include <stdint.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <vector>
+
+#include <libcamera/base/memfd.h>
+
+#include <libcamera/camera_manager.h>
+#include <libcamera/formats.h>
+#include <libcamera/framebuffer.h>
+#include <libcamera/stream.h>
+
+#include "libcamera/internal/mapped_framebuffer.h"
+#include "libcamera/internal/software_isp/mtisp.h"
+#include "libcamera/internal/software_isp/swstats_cpu.h"
+
+#include "debayer_cpu.h"
+
+#include "test.h"
+
+using namespace libcamera;
+
+namespace {
+
+constexpr unsigned int kWidth = 64;
+constexpr unsigned int kHeight = 16;
+constexpr unsigned int kStride = kWidth * 5 / 4;
+
+uint16_t pixel(unsigned int x, unsigned int y)
+{
+	/* Different values per Bayer position, all 10 bits used */
+	return (x * 37 + y * 101 + (x & 1) * 300 + (y & 1) * 150) & 0x3ff;
+}
+
+std::unique_ptr<FrameBuffer> makeBuffer(size_t size)
+{
+	UniqueFD fd = MemFd::create("mtisp-test", size);
+	if (!fd.isValid())
+		return nullptr;
+
+	FrameBuffer::Plane plane;
+	plane.fd = SharedFD(std::move(fd));
+	plane.offset = 0;
+	plane.length = size;
+	return std::make_unique<FrameBuffer>(std::vector<FrameBuffer::Plane>{ plane });
+}
+
+void fill(FrameBuffer *buffer, bool mtisp)
+{
+	MappedFrameBuffer map(buffer, MappedFrameBuffer::MapFlag::Write);
+	uint8_t *data = map.planes()[0].data();
+
+	for (unsigned int y = 0; y < kHeight; y++) {
+		for (unsigned int x = 0; x < kWidth; x += 4) {
+			uint16_t px[4] = { pixel(x, y), pixel(x + 1, y),
+					   pixel(x + 2, y), pixel(x + 3, y) };
+			uint8_t *dst = data + y * kStride + x * 5 / 4;
+
+			if (mtisp) {
+				mtisp::packGroup(px, dst);
+			} else {
+				dst[0] = px[0] >> 2;
+				dst[1] = px[1] >> 2;
+				dst[2] = px[2] >> 2;
+				dst[3] = px[3] >> 2;
+				dst[4] = (px[0] & 3) | ((px[1] & 3) << 2) |
+					 ((px[2] & 3) << 4) | ((px[3] & 3) << 6);
+			}
+		}
+	}
+}
+
+} /* namespace */
+
+class MtispRawTest : public Test
+{
+protected:
+	int init() override
+	{
+		cm_ = std::make_unique<CameraManager>();
+		return TestPass;
+	}
+
+	int testPacking()
+	{
+		for (unsigned int v = 0; v < 1024; v += 7) {
+			uint16_t px[4] = { static_cast<uint16_t>(v), static_cast<uint16_t>(1023 - v),
+					   static_cast<uint16_t>((v * 3) & 0x3ff),
+					   static_cast<uint16_t>((v * 5) & 0x3ff) };
+			uint8_t packed[5], csi2[5];
+			uint16_t back[4];
+
+			mtisp::packGroup(px, packed);
+			mtisp::unpackGroup(packed, back);
+			if (memcmp(px, back, sizeof(px))) {
+				std::cerr << "MTISP pack/unpack mismatch at " << v << std::endl;
+				return TestFail;
+			}
+
+			/* LSB first: the first byte holds the low bits of pixel 0 */
+			if (packed[0] != (px[0] & 0xff) || (packed[1] & 3) != (px[0] >> 8)) {
+				std::cerr << "MTISP bit order wrong" << std::endl;
+				return TestFail;
+			}
+
+			mtisp::repackToCsi2(csi2, packed, 5);
+			for (unsigned int i = 0; i < 4; i++) {
+				uint16_t p = (csi2[i] << 2) | ((csi2[4] >> (2 * i)) & 3);
+				if (p != px[i]) {
+					std::cerr << "CSI-2 repack mismatch" << std::endl;
+					return TestFail;
+				}
+			}
+		}
+
+		return TestPass;
+	}
+
+	int testStats(FrameBuffer *mtispBuf, FrameBuffer *csi2Buf)
+	{
+		SwStatsCpu mtispStats(*cm_);
+		SwStatsCpu csi2Stats(*cm_);
+
+		StreamConfiguration cfg;
+		cfg.size = Size(kWidth, kHeight);
+		cfg.stride = kStride;
+
+		cfg.pixelFormat = formats::SBGGR10_MTISP;
+		if (mtispStats.configure(cfg)) {
+			std::cerr << "MTISP statistics not supported" << std::endl;
+			return TestFail;
+		}
+		cfg.pixelFormat = formats::SBGGR10_CSI2P;
+		if (csi2Stats.configure(cfg))
+			return TestFail;
+
+		mtispStats.setWindow(Rectangle(0, 0, kWidth, kHeight));
+		csi2Stats.setWindow(Rectangle(0, 0, kWidth, kHeight));
+
+		MappedFrameBuffer mtispMap(mtispBuf, MappedFrameBuffer::MapFlag::Read);
+		MappedFrameBuffer csi2Map(csi2Buf, MappedFrameBuffer::MapFlag::Read);
+		mtispStats.processFrame(0, 0, mtispMap);
+		csi2Stats.processFrame(0, 0, csi2Map);
+
+		/*
+		 * The CSI-2 statistics use the 8 most significant bits, the
+		 * MediaTek ones all 10 bits scaled to 8: the sums agree within
+		 * the rounding of the two dropped bits.
+		 */
+		const SwIspStats *a = static_cast<const SwIspStats *>(
+			mmap(nullptr, sizeof(SwIspStats), PROT_READ, MAP_SHARED,
+			     mtispStats.getStatsFD().get(), 0));
+		const SwIspStats *b = static_cast<const SwIspStats *>(
+			mmap(nullptr, sizeof(SwIspStats), PROT_READ, MAP_SHARED,
+			     csi2Stats.getStatsFD().get(), 0));
+		if (a == MAP_FAILED || b == MAP_FAILED)
+			return TestFail;
+
+		int ret = TestPass;
+		unsigned int samples = 0;
+		for (unsigned int i = 0; i < SwIspStats::kYHistogramSize; i++)
+			samples += b->yHistogram[i];
+
+		for (unsigned int c = 0; c < 3; c++) {
+			int64_t diff = static_cast<int64_t>(a->sum_[c]) - static_cast<int64_t>(b->sum_[c]);
+			if (!a->valid || !b->valid || b->sum_[c] == 0 ||
+			    diff < 0 || diff > static_cast<int64_t>(samples)) {
+				std::cerr << "Statistics differ in channel " << c << ": "
+					  << a->sum_[c] << " vs " << b->sum_[c] << std::endl;
+				ret = TestFail;
+			}
+		}
+
+		munmap(const_cast<SwIspStats *>(a), sizeof(SwIspStats));
+		munmap(const_cast<SwIspStats *>(b), sizeof(SwIspStats));
+		return ret;
+	}
+
+	int debayer(PixelFormat inputFormat, FrameBuffer *input, std::vector<uint8_t> &result)
+	{
+		DebayerCpu cpu(std::make_unique<SwStatsCpu>(*cm_), *cm_);
+
+		StreamConfiguration inCfg;
+		inCfg.pixelFormat = inputFormat;
+		inCfg.size = Size(kWidth, kHeight);
+		inCfg.stride = kStride;
+
+		SizeRange sizes = cpu.sizes(inputFormat, inCfg.size);
+		StreamConfiguration outCfg;
+		outCfg.pixelFormat = formats::XRGB8888;
+		outCfg.size = sizes.max;
+		std::tie(outCfg.stride, outCfg.frameSize) =
+			cpu.strideAndFrameSize(outCfg.pixelFormat, outCfg.size);
+
+		if (cpu.configure(inCfg, { outCfg }, false)) {
+			std::cerr << "CPU debayer does not take " << inputFormat << std::endl;
+			return TestFail;
+		}
+
+		std::unique_ptr<FrameBuffer> output = makeBuffer(outCfg.frameSize);
+		if (!output)
+			return TestFail;
+
+		cpu.start();
+		DebayerParams params;
+		cpu.process(0, input, output.get(), params);
+		cpu.stop();
+
+		MappedFrameBuffer map(output.get(), MappedFrameBuffer::MapFlag::Read);
+		result.assign(map.planes()[0].begin(), map.planes()[0].end());
+		return TestPass;
+	}
+
+	int run() override
+	{
+		if (testPacking())
+			return TestFail;
+
+
+		std::unique_ptr<FrameBuffer> mtispBuf = makeBuffer(kStride * kHeight);
+		std::unique_ptr<FrameBuffer> csi2Buf = makeBuffer(kStride * kHeight);
+		if (!mtispBuf || !csi2Buf)
+			return TestFail;
+
+		fill(mtispBuf.get(), true);
+		fill(csi2Buf.get(), false);
+
+		if (testStats(mtispBuf.get(), csi2Buf.get()))
+			return TestFail;
+
+		std::vector<uint8_t> fromMtisp, fromCsi2;
+		if (debayer(formats::SBGGR10_MTISP, mtispBuf.get(), fromMtisp) ||
+		    debayer(formats::SBGGR10_CSI2P, csi2Buf.get(), fromCsi2))
+			return TestFail;
+
+		if (fromMtisp.empty() || fromMtisp != fromCsi2) {
+			std::cerr << "CPU debayer output differs between packings" << std::endl;
+			return TestFail;
+		}
+
+		return TestPass;
+	}
+
+	void cleanup() override
+	{
+		cm_.reset();
+	}
+
+private:
+	std::unique_ptr<CameraManager> cm_;
+};
+
+TEST_REGISTER(MtispRawTest)
