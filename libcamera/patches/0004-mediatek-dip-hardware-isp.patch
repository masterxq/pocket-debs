+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detect focus search
+ */
+
+#pragma once
+
+#include <stdint.h>
+#include <vector>
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+/*
+ * Sharpness measure of a focus grid: mean squared difference between
+ * horizontally and vertically neighbouring cells, divided by the squared mean
+ * cell level after black level subtraction, so that it does not depend on
+ * exposure and gain. The region is the central fraction of the grid in each
+ * direction. Returns a negative value when the region is too small or too
+ * dark to measure.
+ */
+struct AfMeasurement {
+	double sharpness;
+	double level;	/* mean green level per sample, black level removed */
+};
+
+AfMeasurement afMeasure(const uint32_t *grid, unsigned int width,
+			unsigned int height, unsigned int cellSamples,
+			double blackLevel, double fraction);
+
+/*
+ * Two strategies, both ending with a move to the peak interpolated from the
+ * best sample and its neighbours in position (parabola through the
+ * logarithms, i.e. a Gaussian fit) and one check measurement there:
+ * - climb (default): measure at the current position, probe one step to
+ *   either side, then climb in the better direction until the sharpness
+ *   drops below peakDrop of the best value. A flat start (no side clearly
+ *   better or worse) falls back to the full scan.
+ * - full scan: coarse steps over the whole range from its lower end, with
+ *   an early end two samples past a clear peak.
+ */
+class AfSearch
+{
+public:
+	struct Config {
+		int32_t min;
+		int32_t max;
+		int32_t step;
+		/* End the scan after two samples below this fraction of the best. */
+		double peakDrop;
+		/* Fail when the best sample is not this much above the worst. */
+		double minContrast;
+		/* Climb from this position instead of scanning the whole range */
+		bool climb = false;
+		int32_t start = 0;
+	};
+
+	enum class Result {
+		Move,
+		Done,
+		Failed,
+	};
+
+	void start(const Config &config);
+	Result update(double sharpness);
+
+	/* The position to measure next (Move) or the result (Done) */
+	int32_t target() const { return target_; }
+	/* Sharpness at the result, valid after Done */
+	double peak() const { return peak_; }
+
+private:
+	struct Sample {
+		int32_t position;
+		double sharpness;
+	};
+
+	enum class Phase {
+		Probe,
+		Climb,
+		Coarse,
+		Check,
+	};
+
+	bool scanEnded() const;
+	Result finishScan(bool knownPeak = false);
+	Result startFullScan();
+	Result moveTo(int32_t position);
+
+	Config config_;
+	Phase phase_;
+	std::vector<Sample> samples_;
+	unsigned int best_;
+	int32_t target_;
+	double peak_;
+	int dir_ = 1;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
