+/**
+ * \brief Read the DIP settings from the IPA tuning file
+ * \param[in] file Path of the tuning file
+ *
+ * The optional top level section "mtk-dip" of the soft IPA tuning file may
+ * hold:
+ *
+ * - toneCurve: a flat list of points x0, y0, x1, y1, ... (linear input after
+ *   the colour matrix to output before YUV, both 0.0 to 1.0, x rising). The
+ *   curve replaces the power law of the gamma, see mtk_dip_params.h. Without
+ *   it, or if it is invalid, the DIP keeps the gamma of the soft IPA.
+ * - shadowLift: raise the shadows in front of the tone curve, a gain of
+ *   1 + shadowLift at black falling off towards white (0.0 to 16.0, default
+ *   0.0, see mtkdip::shadowLift()).
+ * - lensShading: lens shading correction, sent to the DIP only with
+ *   "enable: true" (drivers without support reject the block). "strength"
+ *   (0.0 to 2.0, default 1.0) scales the correction, the lists "r", "gr",
+ *   "gb" and "b" hold 17 x 17 gains each (red, green in the red rows, green
+ *   in the blue rows, blue), row by row from the top left, at the corners of
+ *   the 16 x 16 block grid over the whole raw input frame that the UAPI
+ *   header defines (struct mtk_dip_params_lsc). The driver interpolates
+ *   between the corners.
+ * - quality: image quality blocks (edge enhancement, noise reduction in two
+ *   stages, demosaicing) per sensitivity, see mtkdip::QualityTable. Without it the
+ *   blocks are sent disabled once at the start of a stream (driver
+ *   defaults), as the driver keeps them from earlier streams.
+ *
+ * The IPA ignores the section.
+ */
+void DebayerMtkDip::loadTuning(const std::string &file)
+{
+	encoder_.setToneCurve(std::nullopt);
+	encoder_.setShadowLift(0.0f);
+	encoder_.setLensShading(std::nullopt);
+	encoder_.setQuality(std::nullopt);
+
+	if (file.empty())
+		return;
+
+	File f(file);
+	if (!f.open(File::OpenModeFlag::ReadOnly))
+		return;
+
+	std::unique_ptr<ValueNode> data = YamlParser::parse(f);
+	if (!data || !data->contains("mtk-dip")) {
+		LOG(Debayer, Info)
+			<< "No mtk-dip section in " << file << ", DIP tone curve from the IPA gamma";
+		return;
+	}
+
+	const ValueNode &section = (*data)["mtk-dip"];
+
+	const ValueNode &points = section["toneCurve"];
+	if (points) {
+		std::optional<std::vector<float>> xy = floatList(points);
+		std::optional<mtkdip::ToneCurve> curve;
+		if (xy)
+			curve = mtkdip::ToneCurve::fromPoints(*xy);
+		if (curve) {
+			LOG(Debayer, Info)
+				<< "DIP tone curve from " << file << ": " << curve->size() << " points";
+			encoder_.setToneCurve(std::move(curve));
+		} else {
+			LOG(Debayer, Error)
+				<< "Invalid mtk-dip toneCurve in " << file
+				<< ", using the gamma of the IPA";
+		}
+	}
+
+	if (section.contains("shadowLift")) {
+		std::optional<float> lift = section["shadowLift"].get<float>();
+		if (lift && *lift >= 0.0f && *lift <= 16.0f) {
+			encoder_.setShadowLift(*lift);
+			LOG(Debayer, Info) << "DIP shadow lift " << *lift;
+		} else {
+			LOG(Debayer, Error) << "Invalid mtk-dip shadowLift in " << file;
+		}
+	}
+
+	if (section.contains("quality")) {
+		std::optional<mtkdip::QualityTable> quality =
+			mtkdip::QualityTable::fromTuning(section["quality"]);
+		if (quality) {
+			LOG(Debayer, Info)
+				<< "DIP quality blocks from " << file << ": " << quality->size()
+				<< " points, ISO = " << quality->isoPerGain() << " x gain"
+				<< (quality->usesNbc2() ? ", with NBC2" : "");
+			encoder_.setQuality(std::move(quality));
+		} else {
+			LOG(Debayer, Error)
+				<< "Invalid mtk-dip quality in " << file << ", quality blocks not sent";
+		}
+	}
+
+	const ValueNode &lsc = section["lensShading"];
+	if (lsc && lsc["enable"].get<bool>(false)) {
+		static constexpr const char *names[] = { "r", "gr", "gb", "b" };
+		std::array<std::vector<float>, 4> grids;
+		bool valid = true;
+
+		for (unsigned int c = 0; c < 4; c++) {
+			std::optional<std::vector<float>> grid = floatList(lsc[names[c]]);
+			if (!grid) {
+				valid = false;
+				break;
+			}
+			grids[c] = std::move(*grid);
+		}
+
+		std::optional<mtkdip::LensShading> gains;
+		if (valid)
+			gains = mtkdip::LensShading::fromGrids(grids, lsc["strength"].get<float>(1.0f));
+		if (gains) {
+			LOG(Debayer, Info)
+				<< "DIP lens shading from " << file << ", strength "
+				<< lsc["strength"].get<float>(1.0f);
+			encoder_.setLensShading(std::move(gains));
+		} else {
+			LOG(Debayer, Error)
+				<< "Invalid mtk-dip lensShading in " << file
+				<< ", no lens shading correction";
+		}
+	}
+}
+
+int DebayerMtkDip::probe()
+{
+	rawEntity_ = media_->getEntityByName(kRawEntity);
+	paramsEntity_ = media_->getEntityByName(kParamsEntity);
+	mainEntity_ = media_->getEntityByName(kMainEntity);
+	if (!rawEntity_ || !paramsEntity_ || !mainEntity_) {
+		LOG(Debayer, Error) << "DIP video entities missing";
+		return -ENODEV;
+	}
+
+	probeRaw_ = std::make_unique<V4L2VideoDevice>(rawEntity_);
+	probeParams_ = std::make_unique<V4L2VideoDevice>(paramsEntity_);
+	probeMain_ = std::make_unique<V4L2VideoDevice>(mainEntity_);
+
+	if (probeRaw_->open() || probeParams_->open() || probeMain_->open())
+		return -ENODEV;
+
+	if (!probeRaw_->caps().isVideoOutput() || !probeMain_->caps().isVideoCapture() ||
+	    !probeParams_->caps().isMetaOutput()) {
+		LOG(Debayer, Error) << "Unexpected DIP video node capabilities";
+		return -ENODEV;
+	}
+
+	for (const auto &[fourcc, sizes] : probeRaw_->formats())
+		rawFormats_.insert(fourcc);
+
+	return 0;
+}
+
+/*
+ * The DIP takes 8-bit Bayer as the capture device writes it today, and the
+ * MediaTek packed 10-bit Bayer formats, as far as its raw node lists them.
+ * Everything else goes to the CPU route.
+ */
+bool DebayerMtkDip::isDipInput(const PixelFormat &format) const
+{
+	BayerFormat bayer = BayerFormat::fromPixelFormat(format);
+	if (!bayer.isValid() || !isStandardBayerOrder(bayer.order))
+		return false;
+
+	const bool raw8 = bayer.bitDepth == 8 && bayer.packing == BayerFormat::Packing::None;
+	const bool mtisp10 = bayer.bitDepth == 10 && bayer.packing == BayerFormat::Packing::MTISP;
+	if (!raw8 && !mtisp10)
+		return false;
+
+	return rawFormats_.count(bayer.toV4L2PixelFormat());
+}
+
+Size DebayerMtkDip::patternSize(PixelFormat inputFormat)
+{
+	if (isDipInput(inputFormat)) {
+		/* 4 pixels per 5 byte group in the packed format */
+		if (BayerFormat::fromPixelFormat(inputFormat).bitDepth == 10)
+			return { 4, 2 };
+		return { 2, 2 };
+	}
+
+	return cpu_->patternSize(inputFormat);
+}
+
+/**
+ * \brief Prefer 10-bit input on the DIP
+ * \param[in] inputFormat The input format
+ *
+ * Of the formats the DIP reads, the MediaTek packed 10-bit Bayer keeps more
+ * of the shadows than 8 bits. LIBCAMERA_MTK_DIP_RAW8=1 reverses the order,
+ * to use 8-bit input where the capture device offers both.
+ *
+ * \return 2 for the preferred DIP input, 1 for the other DIP input, 0 for
+ * formats the DIP does not read
+ */
+unsigned int DebayerMtkDip::inputPreference(const PixelFormat &inputFormat)
+{
+	if (!isDipInput(inputFormat))
+		return 0;
+
+	const char *env = utils::secure_getenv("LIBCAMERA_MTK_DIP_RAW8");
+	const bool raw8First = env && std::string(env) == "1";
+	const bool raw8 = BayerFormat::fromPixelFormat(inputFormat).bitDepth == 8;
+
+	return raw8 == raw8First ? 2 : 1;
+}
+
+std::vector<PixelFormat> DebayerMtkDip::formats(PixelFormat inputFormat)
+{
+	if (isDipInput(inputFormat))
+		return { formats::NV12 };
+
+	return cpu_->formats(inputFormat);
+}
+
+SizeRange DebayerMtkDip::sizes(PixelFormat inputFormat, const Size &inputSize)
+{
+	if (!isDipInput(inputFormat))
+		return cpu_->sizes(inputFormat, inputSize);
+
+	/* Crop only: the output is at most as large as the input */
+	Size min = kMinOutputSize;
+	unsigned int hStep = kOutputHStep;
+	unsigned int vStep = kOutputVStep;
+
+	V4L2VideoDevice::Formats mainFormats = probeMain_->formats();
+	auto it = mainFormats.find(V4L2PixelFormat(V4L2_PIX_FMT_NV12));
+	if (it != mainFormats.end() && !it->second.empty()) {
+		const SizeRange &range = it->second.front();
+		min = range.min;
+		hStep = std::max(range.hStep, 2u);
+		vStep = std::max(range.vStep, 2u);
+	}
+
+	Size max{ inputSize.width / hStep * hStep, inputSize.height / vStep * vStep };
+	if (max.width < min.width || max.height < min.height) {
+		LOG(Debayer, Warning) << "Input size too small for the DIP: " << inputSize;
+		return {};
+	}
+
+	if (fullField_)
+		return SizeRange(max);
+
+	return SizeRange(min, max, hStep, vStep);
+}
+
+std::tuple<unsigned int, unsigned int>
+DebayerMtkDip::strideAndFrameSize(const PixelFormat &outputFormat, const Size &size)
+{
+	if (outputFormat != formats::NV12)
+		return cpu_->strideAndFrameSize(outputFormat, size);
+
+	V4L2DeviceFormat format;
+	format.fourcc = V4L2PixelFormat(V4L2_PIX_FMT_NV12);
+	format.size = size;
+	if (probeMain_->tryFormat(&format) || format.size != size) {
+		LOG(Debayer, Debug) << "DIP rejects NV12 output " << size;
+		return std::make_tuple(0, 0);
+	}
+
+	return std::make_tuple(format.planes[0].bpl, format.planes[0].size);
+}
+
+uint32_t DebayerMtkDip::preferredInputStride(const PixelFormat &inputFormat, const Size &size)
+{
+	if (!isDipInput(inputFormat))
+		return cpu_->preferredInputStride(inputFormat, size);
+
+	/* Ask the DIP for the line length it reads */
+	V4L2DeviceFormat format;
+	format.fourcc = BayerFormat::fromPixelFormat(inputFormat).toV4L2PixelFormat();
+	format.size = size;
+	if (probeRaw_->tryFormat(&format))
+		return 0;
+
+	return format.planes[0].bpl;
+}
+
+int DebayerMtkDip::configure(const StreamConfiguration &inputCfg,
+			     const std::vector<std::reference_wrapper<const StreamConfiguration>> &outputCfgs,
+			     bool ccmEnabled)
+{
+	if (outputCfgs.size() != 1) {
+		LOG(Debayer, Error)
+			<< "Unsupported number of output streams: " << outputCfgs.size();
+		return -EINVAL;
+	}
+
+	const StreamConfiguration &outputCfg = outputCfgs[0];
+
+	useDip_ = isDipInput(inputCfg.pixelFormat) && outputCfg.pixelFormat == formats::NV12;
+	if (!useDip_) {
+		LOG(Debayer, Info)
+			<< "DIP not used for " << inputCfg.pixelFormat << " to "
+			<< outputCfg.pixelFormat << ", debayering on the CPU";
+		int ret = cpu_->configure(inputCfg, outputCfgs, ccmEnabled);
+		outputConfig_ = cpu_->outputConfig_;
+		inputConfig_ = cpu_->inputConfig_;
+		return ret;
+	}
+
+	BayerFormat bayer = BayerFormat::fromPixelFormat(inputCfg.pixelFormat);
+	bayerOrder_ = bayer.order;
+
+	/* Raw input, line length as written by the capture device */
+	V4L2DeviceFormat rawFormat;
+	rawFormat.fourcc = bayer.toV4L2PixelFormat();
+	rawFormat.size = inputCfg.size;
+	rawFormat.planesCount = 1;
+	rawFormat.planes[0].bpl = inputCfg.stride;
+	int ret = probeRaw_->setFormat(&rawFormat);
+	if (ret)
+		return ret;
+
+	if (rawFormat.fourcc != bayer.toV4L2PixelFormat() || rawFormat.size != inputCfg.size ||
+	    rawFormat.planes[0].bpl != inputCfg.stride) {
+		LOG(Debayer, Error)
+			<< "DIP input " << rawFormat << " does not match the capture format "
+			<< inputCfg.size << "-" << inputCfg.pixelFormat
+			<< " stride " << inputCfg.stride;
+		return -EINVAL;
+	}
+
+	/*
+	 * Centred crop with the output size. Even coordinates keep the Bayer
+	 * phase, a multiple of 4 pixels horizontally also starts on a 5 byte
+	 * group of the packed format.
+	 */
+	crop_.width = outputCfg.size.width;
+	crop_.height = outputCfg.size.height;
+	crop_.x = ((inputCfg.size.width - crop_.width) / 2) & ~3;
+	crop_.y = ((inputCfg.size.height - crop_.height) / 2) & ~1;
+
+	Rectangle crop = crop_;
+	ret = probeRaw_->setSelection(V4L2_SEL_TGT_CROP, &crop);
+	if (ret)
+		return ret;
+
+	if (crop.size() != crop_.size() || (crop.x & 1) || (crop.y & 1)) {
+		LOG(Debayer, Error)
+			<< "DIP crop " << crop << " differs from " << crop_;
+		return -EINVAL;
+	}
+	crop_ = crop;
+
+	/* NV12 output */
+	V4L2DeviceFormat mainFormat;
+	mainFormat.fourcc = V4L2PixelFormat(V4L2_PIX_FMT_NV12);
+	mainFormat.size = outputCfg.size;
+	ret = probeMain_->setFormat(&mainFormat);
+	if (ret)
+		return ret;
+
+	if (mainFormat.fourcc != V4L2PixelFormat(V4L2_PIX_FMT_NV12) ||
+	    mainFormat.size != outputCfg.size || mainFormat.planesCount != 1 ||
+	    mainFormat.planes[0].bpl != outputCfg.stride) {
+		LOG(Debayer, Error)
+			<< "DIP output " << mainFormat << " does not match "
+			<< outputCfg.toString() << " stride " << outputCfg.stride;
+		return -EINVAL;
+	}
+
+	/*
+	 * Parameters: the buffer size is the driver's (it grows with new block
+	 * types), the encoder fills what fits
+	 */
+	V4L2DeviceFormat paramsFormat;
+	ret = probeParams_->getFormat(&paramsFormat);
+	if (ret)
+		return ret;
+	paramsFormat.fourcc = V4L2PixelFormat(V4L2_META_FMT_MTK_DIP_PARAMS);
+	paramsFormat.planesCount = 1;
+	ret = probeParams_->setFormat(&paramsFormat);
+	if (ret)
+		return ret;
+
+	if (paramsFormat.fourcc != V4L2PixelFormat(V4L2_META_FMT_MTK_DIP_PARAMS)) {
+		LOG(Debayer, Error) << "DIP params format " << paramsFormat << " not supported";
+		return -EINVAL;
+	}
+	LOG(Debayer, Debug) << "DIP params buffer " << paramsFormat.planes[0].size << " bytes";
+
+	/* Statistics on the raw buffer, over the area that is shown */
+	ret = stats_->configure(inputCfg);
+	if (ret)
+		return ret;
+	stats_->setWindow(crop_);
+
+	inputConfig_.patternSize = patternSize(inputCfg.pixelFormat);
+	inputConfig_.bpp = bayer.bitDepth;
+	inputConfig_.stride = inputCfg.stride;
+	outputConfig_.bpp = 12;
+	outputConfig_.stride = mainFormat.planes[0].bpl;
+	outputConfig_.frameSize = mainFormat.planes[0].size;
+	inputPixelFormat_ = inputCfg.pixelFormat;
+	outputPixelFormat_ = outputCfg.pixelFormat;
+	outputSize_ = outputCfg.size;
+	swapRedBlueGains_ = false;
+
+	encoder_.reset();
+
+	LOG(Debayer, Info)
+		<< "DIP: " << inputCfg.size << "-" << inputCfg.pixelFormat
+		<< " stride " << inputCfg.stride << ", crop " << crop_
+		<< " -> " << outputCfg.size << "-NV12 stride " << outputConfig_.stride;
+
+	return 0;
+}
+
+int DebayerMtkDip::exportOutputBuffers(unsigned int count,
+				       std::vector<std::unique_ptr<FrameBuffer>> *buffers)
+{
+	if (!useDip_)
+		return -ENOTSUP;
+
+	/* Contiguous buffers from the DIP, exported as DMABUF */
+	return probeMain_->exportBuffers(count, buffers);
+}
+
+int DebayerMtkDip::setupLinks()
+{
+	/*
+	 * The params link must be enabled for the params buffers to be used,
+	 * the optional outputs stay off as this backend does not queue
+	 * buffers on them.
+	 */
+	auto setLinks = [&](const char *name, bool enable) -> int {
+		const MediaEntity *entity = media_->getEntityByName(name);
+		if (!entity)
+			return 0;
+
+		for (const MediaPad *pad : entity->pads()) {
+			for (MediaLink *link : pad->links()) {
+				if (link->flags() & MEDIA_LNK_FL_IMMUTABLE)
+					continue;
+				if (!!(link->flags() & MEDIA_LNK_FL_ENABLED) == enable)
+					continue;
+
+				int ret = link->setEnabled(enable);
+				if (ret)
+					return ret;
+			}
+		}
+
+		return 0;
+	};
+
+	int ret = setLinks(kRawEntity, true);
+	if (!ret)
+		ret = setLinks(kMainEntity, true);
+	if (!ret)
+		ret = setLinks(kParamsEntity, true);
+	if (!ret)
+		ret = setLinks(kScaledEntity, false);
+	if (!ret)
+		ret = setLinks(kStatsEntity, false);
+
+	return ret;
+}
+
+int DebayerMtkDip::start()
+{
+	if (!useDip_)
+		return cpu_->start();
+
+	if (!media_->acquire())
+		return -EBUSY;
+
+	if (!media_->lock()) {
+		LOG(Debayer, Error) << "The DIP is in use by another process";
+		media_->release();
+		return -EBUSY;
+	}
+
+	int ret = setupLinks();
+	if (ret)
+		goto error;
+
+	/* Devices for streaming, owned by the ISP worker thread */
+	raw_ = std::make_unique<V4L2VideoDevice>(rawEntity_);
+	params_ = std::make_unique<V4L2VideoDevice>(paramsEntity_);
+	main_ = std::make_unique<V4L2VideoDevice>(mainEntity_);
+
+	ret = raw_->open();
+	if (!ret)
+		ret = params_->open();
+	if (!ret)
+		ret = main_->open();
+	if (ret)
+		goto error;
+
+	ret = raw_->importBuffers(kImportSlots);
+	if (ret < 0)
+		goto error;
+	ret = main_->importBuffers(kImportSlots);
+	if (ret < 0)
+		goto error;
+	ret = params_->allocateBuffers(kParamsBufferCount, &paramsBuffers_);
+	if (ret < 0)
+		goto error;
+
+	paramsMaps_.clear();
+	paramsMaps_.reserve(paramsBuffers_.size());
+	freeParams_.clear();
+	for (unsigned int i = 0; i < paramsBuffers_.size(); i++) {
+		paramsMaps_.emplace_back(paramsBuffers_[i].get(), MappedFrameBuffer::MapFlag::Write);
+		if (!paramsMaps_.back().isValid()) {
+			LOG(Debayer, Error) << "Failed to map DIP params buffer " << i;
+			ret = -ENOMEM;
+			goto error;
+		}
+		paramsBuffers_[i]->setCookie(i);
+		freeParams_.push_back(i);
+	}
+
+	raw_->bufferReady.connect(this, &DebayerMtkDip::rawBufferReady);
+	main_->bufferReady.connect(this, &DebayerMtkDip::mainBufferReady);
+	params_->bufferReady.connect(this, &DebayerMtkDip::paramsBufferReady);
+	main_->dequeueTimeout.connect(this, &DebayerMtkDip::dequeueTimeout);
+	main_->setDequeueTimeout(1000ms);
+
+	ret = params_->streamOn();
+	if (!ret)
+		ret = main_->streamOn();
+	if (!ret)
+		ret = raw_->streamOn();
+	if (ret)
+		goto error;
+
+	streaming_ = true;
+	errors_ = 0;
+	encoder_.reset();
+	return 0;
+
+error:
+	LOG(Debayer, Error) << "Failed to start the DIP: " << strerror(-ret);
+	streaming_ = true;
+	stop();
+	return ret;
+}
+
+void DebayerMtkDip::stop()
+{
+	if (!useDip_) {
+		cpu_->stop();
+		return;
+	}
+
+	if (!streaming_)
+		return;
+
+	/*
+	 * Buffers still queued come back as cancelled and are ignored here:
+	 * the software ISP returns all buffers of unfinished jobs itself.
+	 */
+	streaming_ = false;
+	if (raw_)
+		raw_->streamOff();
+	if (main_)
+		main_->streamOff();
+	if (params_)
+		params_->streamOff();
+	jobs_.clear();
+
+	paramsMaps_.clear();
+	freeParams_.clear();
+	if (params_)
+		params_->releaseBuffers();
+	paramsBuffers_.clear();
+	if (raw_)
+		raw_->releaseBuffers();
+	if (main_)
+		main_->releaseBuffers();
+
+	raw_.reset();
+	params_.reset();
+	main_.reset();
+	rawMaps_.clear();
+
+	media_->unlock();
+	media_->release();
+
+	if (errors_)
+		LOG(Debayer, Warning) << errors_ << " DIP jobs failed";
+}
+
+int DebayerMtkDip::queueJob(Job &job, const DebayerParams &params)
+{
+	/*
+	 * The raw buffer goes first: it is the only buffer that comes from
+	 * another device and that the DIP may refuse (not contiguous, above
+	 * 4 GiB). If it is refused nothing else has been queued, and the
+	 * queues stay matched.
+	 */
+	int ret = raw_->queueBuffer(job.input);
+	if (ret)
+		return ret;
+	job.rawQueued = true;
+
+	queueParams(params);
+
+	ret = main_->queueBuffer(job.output);
+	if (ret)
+		return ret;
+	job.mainQueued = true;
+
+	return 0;
+}
+
+/*
+ * The params node never holds up a job: without a params buffer the DIP keeps
+ * the values of the previous job. A buffer is only queued when a block
+ * changed; if none is free the change goes with a later job.
+ */
+void DebayerMtkDip::queueParams(const DebayerParams &params)
+{
+	if (freeParams_.empty()) {
+		LOG(Debayer, Debug) << "No free DIP params buffer, parameters follow later";
+		return;
+	}
+
+	unsigned int index = freeParams_.front();
+	FrameBuffer *paramsBuffer = paramsBuffers_[index].get();
+
+	/*
+	 * A driver refuses the whole buffer for one bad block. Each step below
+	 * leaves something out and encodes the buffer again, so that the other
+	 * blocks get through:
+	 * - a driver without the second noise reduction stage (older than the
+	 *   block type) refuses its disabled block after a start, and the
+	 *   block itself;
+	 * - the quality blocks come from the tuning unchecked against the
+	 *   field ranges;
+	 * - a driver without any of the optional block types refuses all
+	 *   disabled blocks after a start.
+	 */
+	for (unsigned int attempt = 0; attempt < 6; attempt++) {
+		size_t size = encoder_.encode(params, bayerOrder_, paramsMaps_[index].planes()[0]);
+		if (!size)
+			return;
+
+		paramsBuffer->_d()->metadata().planes()[0].bytesused = size;
+		if (!params_->queueBuffer(paramsBuffer)) {
+			freeParams_.pop_front();
+			encoder_.commit();
+			return;
+		}
+
+		if (encoder_.dropStartDisables(MTK_DIP_PARAMS_BLOCK_NBC2)) {
+			LOG(Debayer, Warning)
+				<< "DIP refused the disabled second noise reduction stage "
+				<< "(driver without it), sent without";
+		} else if (encoder_.usesNbc2()) {
+			LOG(Debayer, Warning)
+				<< "DIP refused the params buffer, second noise reduction stage switched off";
+			encoder_.dropNbc2();
+		} else if (encoder_.hasQuality()) {
+			LOG(Debayer, Error)
+				<< "DIP refused the params buffer, quality blocks switched off";
+			encoder_.setQuality(std::nullopt);
+		} else if (encoder_.dropStartDisables()) {
+			LOG(Debayer, Warning)
+				<< "DIP refused the disabled optional blocks "
+				<< "(driver without them), sent without";
+		} else {
+			break;
+		}
+	}
+
+	LOG(Debayer, Warning) << "Failed to queue DIP params buffer";
+}
+
+void DebayerMtkDip::process(uint32_t frame, FrameBuffer *input, FrameBuffer *output,
+			    const DebayerParams &params)
+{
+	if (!useDip_) {
+		cpu_->process(frame, input, output, params);
+		return;
+	}
+
+	jobs_.push_back({});
+	Job &job = jobs_.back();
+	job.frame = frame;
+	job.input = input;
+	job.output = output;
+	/* The DIP overwrites the metadata of the raw buffer when it returns it */
+	job.inputMetadata = input->metadata();
+
+	int ret = streaming_ ? queueJob(job, params) : -ENODEV;
+	if (ret) {
+		LOG(Debayer, Error) << "Failed to queue DIP job for frame " << frame
+				    << ": " << strerror(-ret);
+		job.failed = true;
+		/* Some buffers are in the DIP, the others not: match the queues again */
+		if (job.rawQueued)
+			restartStreaming();
+	}
+
+	/*
+	 * CPU statistics on the raw buffer while the DIP job runs: interval
+	 * and sampling from the IPA, sparse by default. The raw buffers stay
+	 * mapped while streaming (the same few buffers come back), so a
+	 * frame with statistics costs no mmap/munmap.
+	 */
+	stats_->setSampling(params.statsLinePairStep ? params.statsLinePairStep : kStatsLinePairStep,
+			    params.statsBlockStep ? params.statsBlockStep : kStatsBlockStep);
+	stats_->setInterval(params.statsInterval, params.afStatsInterval, params.afEveryFrame);
+	stats_->setAfRegion(params.afRegionMode, params.afRegion);
+	if (!stats_->wantsFrame(frame) && !params.afEveryFrame) {
+		stats_->finishFrame(frame, 0);
+	} else {
+		std::unique_ptr<MappedFrameBuffer> &in = rawMaps_[input];
+		if (!in)
+			in = std::make_unique<MappedFrameBuffer>(input, MappedFrameBuffer::MapFlag::Read);
+
+		if (in->isValid()) {
+			DmaSyncer syncer(input->planes()[0].fd, DmaSyncer::SyncType::Read);
+			stats_->processFrame(frame, 0, *in);
+		} else {
+			LOG(Debayer, Error) << "mmap-ing raw buffer failed";
+			rawMaps_.erase(input);
+			stats_->finishFrame(frame, 0);
+		}
+	}
+
+	completeJobs();
+}
+
+void DebayerMtkDip::rawBufferReady(FrameBuffer *buffer)
+{
+	if (!streaming_)
+		return;
+
+	for (Job &job : jobs_) {
+		if (job.input == buffer && job.rawQueued && !job.rawDone) {
+			job.rawDone = true;
+			if (buffer->metadata().status != FrameMetadata::FrameSuccess)
+				job.error = true;
+			if (!restarting_)
+				completeJobs();
+			return;
+		}
+	}
+
+	LOG(Debayer, Error) << "Unexpected raw buffer from the DIP";
+}
+
+void DebayerMtkDip::mainBufferReady(FrameBuffer *buffer)
+{
+	if (!streaming_)
+		return;
+
+	for (Job &job : jobs_) {
+		if (job.output == buffer && job.mainQueued && !job.mainDone) {
+			job.mainDone = true;
+			if (buffer->metadata().status != FrameMetadata::FrameSuccess)
+				job.error = true;
+			if (!restarting_)
+				completeJobs();
+			return;
+		}
+	}
+
+	LOG(Debayer, Error) << "Unexpected output buffer from the DIP";
+}
+
+void DebayerMtkDip::paramsBufferReady(FrameBuffer *buffer)
+{
+	if (!streaming_)
+		return;
+
+	freeParams_.push_back(buffer->cookie());
+}
+
+void DebayerMtkDip::dequeueTimeout()
+{
+	LOG(Debayer, Warning) << "DIP job takes longer than 1 s, "
+			      << jobs_.size() << " jobs pending";
+}
+
+/*
+ * Stream off and on again after a job was queued only partly, so that the
+ * buffers of the three queues are matched again. Every job in the DIP fails.
+ */
+void DebayerMtkDip::restartStreaming()
+{
+	LOG(Debayer, Warning) << "Restarting the DIP queues";
+
+	for (Job &job : jobs_)
+		job.failed = true;
+
+	/*
+	 * Returned buffers are marked done by the handlers. The jobs complete
+	 * afterwards, from process(), after the statistics of the current
+	 * frame.
+	 */
+	restarting_ = true;
+	raw_->streamOff();
+	main_->streamOff();
+	params_->streamOff();
+	restarting_ = false;
+
+	freeParams_.clear();
+	for (unsigned int i = 0; i < paramsBuffers_.size(); i++)
+		freeParams_.push_back(i);
+
+	encoder_.reset();
+
+	if (params_->streamOn() || main_->streamOn() || raw_->streamOn()) {
+		LOG(Debayer, Error) << "DIP does not stream again";
+		streaming_ = false;
+	}
+}
+
+/* Return the buffers of finished jobs, in the order they were queued */
+void DebayerMtkDip::completeJobs()
+{
+	while (!jobs_.empty()) {
+		Job &job = jobs_.front();
+
+		if ((job.rawQueued && !job.rawDone) || (job.mainQueued && !job.mainDone))
+			return;
+
+		/* Undo the changes the DIP made to the raw buffer metadata */
+		job.input->_d()->metadata() = job.inputMetadata;
+
+		FrameMetadata &metadata = job.output->_d()->metadata();
+		metadata.sequence = job.inputMetadata.sequence;
+		metadata.timestamp = job.inputMetadata.timestamp;
+
+		const bool ok = !job.failed && !job.error;
+		metadata.status = ok ? job.inputMetadata.status
+				     : FrameMetadata::FrameError;
+		if (!ok) {
+			errors_++;
+			for (FrameMetadata::Plane &plane : metadata.planes())
+				plane.bytesused = 0;
+		}
+
+		FrameBuffer *input = job.input;
+		FrameBuffer *output = job.output;
+		jobs_.pop_front();
+
+		outputBufferReady.emit(output);
+		inputBufferReady.emit(input);
+	}
+}
+
+} /* namespace libcamera */
