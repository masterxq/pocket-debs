+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Debayering on the MediaTek MT6785 ISP pass 2 (DIP)
+ */
+
+#include "debayer_mtk_dip.h"
+
+#include <algorithm>
+#include <chrono>
+#include <fstream>
+#include <string.h>
+#include <string>
+#include <unistd.h>
+
+#include <linux/media.h>
+
+#include <linux/media/mediatek/mtk-dip-mt6785.h>
+#include <linux/videodev2.h>
+
+#include <libcamera/base/file.h>
+#include <libcamera/base/log.h>
+#include <libcamera/base/utils.h>
+
+#include <libcamera/formats.h>
+#include <libcamera/stream.h>
+
+#include "libcamera/internal/camera_manager.h"
+#include "libcamera/internal/dma_buf_allocator.h"
+#include "libcamera/internal/framebuffer.h"
+#include "libcamera/internal/global_configuration.h"
+#include "libcamera/internal/media_device.h"
+#include "libcamera/internal/v4l2_videodevice.h"
+#include "libcamera/internal/yaml_parser.h"
+
+/**
+ * \file debayer_mtk_dip.h
+ * \brief Debayer backend of the software ISP running on the MediaTek DIP
+ */
+
+namespace libcamera {
+
+using namespace std::literals::chrono_literals;
+
+/**
+ * \class DebayerMtkDip
+ * \brief Debayer backend for the MediaTek MT6785 ISP pass 2 (DIP)
+ *
+ * The DIP is a memory to memory processor with the video nodes mtk-dip-raw
+ * (raw Bayer in), mtk-dip-params (parameters in) and mtk-dip-main (NV12 out).
+ * This backend lets it replace the CPU or GPU debayering inside the software
+ * ISP, so that the CPU statistics, the soft IPA and the sensor controls stay
+ * as they are:
+ *
+ * - The raw buffer of the capture device is queued to mtk-dip-raw by DMABUF,
+ *   without a copy. The DIP needs physically contiguous buffers below 4 GiB,
+ *   the capture buffers of the simple pipeline are allocated by the capture
+ *   driver and qualify when it allocates from CMA with a 32-bit DMA mask.
+ * - The CPU statistics read the same raw buffer while the DIP job runs. The
+ *   input buffer is returned once both are done.
+ * - The output buffers are allocated by mtk-dip-main and exported, the
+ *   application gets NV12 frames.
+ * - DebayerParams are translated into DIP parameter blocks (see
+ *   mtk_dip_params.h). A params buffer is only queued when a block changed,
+ *   the DIP keeps the previous values for jobs without one.
+ *
+ * 8-bit Bayer and MediaTek packed 10-bit Bayer with NV12 output go to the
+ * DIP. Other input formats are handled by an embedded DebayerCpu.
+ *
+ * Version 1 of the DIP crops but does not scale: the output size is a centred
+ * crop of the input.
+ */
+
+namespace {
+
+/* Video entities of the DIP media device */
+constexpr const char *kRawEntity = "mtk-dip-raw";
+constexpr const char *kParamsEntity = "mtk-dip-params";
+constexpr const char *kMainEntity = "mtk-dip-main";
+constexpr const char *kScaledEntity = "mtk-dip-scaled";
+constexpr const char *kStatsEntity = "mtk-dip-stats";
+
+/* Output limits of the DIP (UAPI header) when the driver does not enumerate frame sizes */
+constexpr Size kMinOutputSize{ 128, 64 };
+constexpr unsigned int kOutputHStep = 2;
+constexpr unsigned int kOutputVStep = 2;
+
+/*
+ * Device node of an entity from its device number, as the sysfs device
+ * enumerator does it. MediaDevice::populate() fills in the numbers only.
+ */
+std::string lookupDeviceNode(unsigned int major, unsigned int minor)
+{
+	std::ifstream uevent("/sys/dev/char/" + std::to_string(major) + ":" +
+			     std::to_string(minor) + "/uevent");
+	std::string line;
+
+	while (uevent >> line) {
+		if (line.find("DEVNAME=") == 0)
+			return "/dev/" + line.substr(strlen("DEVNAME="));
+	}
+
+	return {};
+}
+
+int setDeviceNodes(MediaDevice *media)
+{
+	for (MediaEntity *entity : media->entities()) {
+		if (entity->deviceMajor() == 0 && entity->deviceMinor() == 0)
+			continue;
+
+		std::string node = lookupDeviceNode(entity->deviceMajor(),
+						    entity->deviceMinor());
+		/* A video node without a path makes probe() fail later */
+		if (node.empty() || entity->setDeviceNode(node)) {
+			LOG(Debayer, Warning)
+				<< "No device node for " << entity->name();
+			continue;
+		}
+
+		LOG(Debayer, Debug) << entity->name() << ": " << node;
+	}
+
+	return 0;
+}
+
+} /* namespace */
+
+DebayerMtkDip::DebayerMtkDip(const CameraManager &cm, std::unique_ptr<MediaDevice> media)
+	: Debayer(cm), media_(std::move(media))
+{
+	/*
+	 * software_isp.dip_full_field: offer only the full sensor mode sizes,
+	 * no crops. Without a scaler every smaller output is a centred crop
+	 * with a smaller field of view; applications that pick the largest
+	 * size up to some limit then fall back to a full field mode.
+	 */
+	const GlobalConfiguration &configuration = cm._d()->configuration();
+	fullField_ = configuration.option<bool>({ "software_isp", "dip_full_field" }).value_or(false);
+	if (fullField_)
+		LOG(Debayer, Info) << "DIP outputs only the full sensor mode sizes";
+}
+
+void DebayerMtkDip::init(std::unique_ptr<SwStatsCpu> stats, const CameraManager &cm)
+{
+	stats_ = stats.get();
+	cpu_ = std::make_unique<DebayerCpu>(std::move(stats), cm);
+
+	/* The CPU route emits in the ISP worker thread, forward directly */
+	cpu_->inputBufferReady.connect(this, [this](FrameBuffer *buffer) {
+		inputBufferReady.emit(buffer);
+	});
+	cpu_->outputBufferReady.connect(this, [this](FrameBuffer *buffer) {
+		outputBufferReady.emit(buffer);
+	});
+}
+
+DebayerMtkDip::~DebayerMtkDip()
+{
+	if (streaming_)
+		stop();
+}
+
+/**
+ * \brief Find the DIP and create the backend
+ * \param[in,out] stats The statistics object, moved into the backend only on
+ * success
+ * \param[in] cm The camera manager
+ * \return The backend, or nullptr if no usable DIP was found
+ */
+std::unique_ptr<DebayerMtkDip>
+DebayerMtkDip::create(std::unique_ptr<SwStatsCpu> &stats, const CameraManager &cm)
+{
+	for (unsigned int i = 0; i < 64; i++) {
+		std::string node = "/dev/media" + std::to_string(i);
+		if (access(node.c_str(), F_OK))
+			continue;
+
+		auto media = std::make_unique<MediaDevice>(node);
+		if (media->populate() < 0)
+			continue;
+
+		if (!media->getEntityByName(kRawEntity) ||
+		    !media->getEntityByName(kMainEntity))
+			continue;
+
+		/* Both device sets (probe and streaming) open the entity nodes */
+		if (setDeviceNodes(media.get()))
+			return nullptr;
+
+		std::unique_ptr<DebayerMtkDip> dip(new DebayerMtkDip(cm, std::move(media)));
+		if (dip->probe()) {
+			/* The statistics object stays with the caller for the fallback */
+			LOG(Debayer, Warning) << "MediaTek DIP on " << node << " not usable";
+			return nullptr;
+		}
+
+		dip->init(std::move(stats), cm);
+		LOG(Debayer, Info) << "Using the MediaTek DIP on " << node;
+		return dip;
+	}
+
+	LOG(Debayer, Warning) << "No MediaTek DIP found";
+	return nullptr;
+}
+
+namespace {
+
+std::optional<std::vector<float>> floatList(const ValueNode &node)
+{
+	if (!node.isList())
+		return std::nullopt;
+
+	std::vector<float> values;
+	for (const ValueNode &p : node.asList()) {
+		std::optional<float> v = p.get<float>();
+		if (!v)
+			return std::nullopt;
+		values.push_back(*v);
+	}
+
+	return values;
+}
