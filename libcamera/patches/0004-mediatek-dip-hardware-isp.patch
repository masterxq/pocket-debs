@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Debayering on the MediaTek MT6785 ISP pass 2 (DIP)
+ */
+
+#pragma once
+
+#include <deque>
+#include <map>
+#include <memory>
+#include <set>
+#include <stdint.h>
+#include <string>
+#include <vector>
+
+#include <libcamera/base/object.h>
+
+#include <libcamera/framebuffer.h>
+#include <libcamera/geometry.h>
+
+#include "libcamera/internal/bayer_format.h"
+#include "libcamera/internal/mapped_framebuffer.h"
+#include "libcamera/internal/software_isp/mtk_dip_params.h"
+#include "libcamera/internal/software_isp/swstats_cpu.h"
+#include "libcamera/internal/v4l2_pixelformat.h"
+
+#include "debayer.h"
+#include "debayer_cpu.h"
+
+namespace libcamera {
+
+class MediaDevice;
+class MediaEntity;
+class V4L2VideoDevice;
+
+class DebayerMtkDip : public Debayer
+{
+public:
+	static std::unique_ptr<DebayerMtkDip>
+	create(std::unique_ptr<SwStatsCpu> &stats, const CameraManager &cm);
+
+	~DebayerMtkDip();
+
+	int configure(const StreamConfiguration &inputCfg,
+		      const std::vector<std::reference_wrapper<const StreamConfiguration>> &outputCfgs,
+		      bool ccmEnabled) override;
+
+	std::vector<PixelFormat> formats(PixelFormat inputFormat) override;
+	std::tuple<unsigned int, unsigned int>
+	strideAndFrameSize(const PixelFormat &outputFormat, const Size &size) override;
+	uint32_t preferredInputStride(const PixelFormat &inputFormat, const Size &size) override;
+	SizeRange sizes(PixelFormat inputFormat, const Size &inputSize) override;
+
+	int exportOutputBuffers(unsigned int count,
+				std::vector<std::unique_ptr<FrameBuffer>> *buffers) override;
+
+	void process(uint32_t frame, FrameBuffer *input, FrameBuffer *output,
+		     const DebayerParams &params) override;
+	int start() override;
+	void stop() override;
+
+	const SharedFD &getStatsFD() override { return stats_->getStatsFD(); }
+
+	void loadTuning(const std::string &file) override;
+	unsigned int inputPreference(const PixelFormat &inputFormat) override;
+
+private:
+	struct Job {
+		uint32_t frame;
+		FrameBuffer *input;
+		FrameBuffer *output;
+		FrameMetadata inputMetadata;
+		bool failed = false;
+		bool rawQueued = false;
+		bool mainQueued = false;
+		bool rawDone = false;
+		bool mainDone = false;
+		bool error = false;
+	};
+
+	DebayerMtkDip(const CameraManager &cm, std::unique_ptr<MediaDevice> media);
+	void init(std::unique_ptr<SwStatsCpu> stats, const CameraManager &cm);
+
+	Size patternSize(PixelFormat inputFormat) override;
+
+	int probe();
+	bool isDipInput(const PixelFormat &format) const;
+	int setupLinks();
+	int queueJob(Job &job, const DebayerParams &params);
+	void queueParams(const DebayerParams &params);
+	void rawBufferReady(FrameBuffer *buffer);
+	void mainBufferReady(FrameBuffer *buffer);
+	void paramsBufferReady(FrameBuffer *buffer);
+	void dequeueTimeout();
+	void completeJobs();
+	void restartStreaming();
+
+	static constexpr unsigned int kParamsBufferCount = 8;
+	static constexpr unsigned int kImportSlots = 16;
+
+	/* Route for formats the DIP does not take, owns the statistics */
+	std::unique_ptr<DebayerCpu> cpu_;
+	SwStatsCpu *stats_ = nullptr;
+
+	std::unique_ptr<MediaDevice> media_;
+	const MediaEntity *rawEntity_ = nullptr;
+	const MediaEntity *paramsEntity_ = nullptr;
+	const MediaEntity *mainEntity_ = nullptr;
+
+	/* Opened in the creating thread: queries, formats, buffer export */
+	std::unique_ptr<V4L2VideoDevice> probeRaw_;
+	std::unique_ptr<V4L2VideoDevice> probeParams_;
+	std::unique_ptr<V4L2VideoDevice> probeMain_;
+	std::set<V4L2PixelFormat> rawFormats_;
+
+	/* Opened in the ISP worker thread between start() and stop() */
+	std::unique_ptr<V4L2VideoDevice> raw_;
+	std::unique_ptr<V4L2VideoDevice> params_;
+	std::unique_ptr<V4L2VideoDevice> main_;
+	std::vector<std::unique_ptr<FrameBuffer>> paramsBuffers_;
+	std::vector<MappedFrameBuffer> paramsMaps_;
+
+	/* Raw buffers mapped for the statistics, kept while streaming */
+	std::map<const FrameBuffer *, std::unique_ptr<MappedFrameBuffer>> rawMaps_;
+
+	/*
+	 * Statistics sampling in DIP mode without tuning: the DIP does the
+	 * image, the CPU only reads what exposure and white balance need,
+	 * one line pair out of 8 (the focus grid keeps its own sampling)
+	 */
+	static constexpr unsigned int kStatsLinePairStep = 8;
+	static constexpr unsigned int kStatsBlockStep = 1;
+	std::deque<unsigned int> freeParams_;
+
+	bool useDip_ = false;
+	/* Only the full input size as output (software_isp.dip_full_field) */
+	bool fullField_ = false;
+	bool streaming_ = false;
+	bool restarting_ = false;
+	BayerFormat::Order bayerOrder_ = BayerFormat::BGGR;
+	Rectangle crop_;
+	mtkdip::ParamsEncoder encoder_;
+	std::deque<Job> jobs_;
+	unsigned int errors_ = 0;
+};
+
+} /* namespace libcamera */
