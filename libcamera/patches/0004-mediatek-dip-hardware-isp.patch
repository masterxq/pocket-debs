diff --git a/include/libcamera/internal/software_isp/mtisp.h b/include/libcamera/internal/software_isp/mtisp.h
new file mode 100644
index 0000000..9e50160
--- /dev/null
+++ b/include/libcamera/internal/software_isp/mtisp.h
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * MediaTek ISP packed raw helpers
+ *
+ * The MediaTek ISP packing (V4L2_PIX_FMT_MTISP_S*10) stores 10 bits per pixel
+ * as one little endian bit stream per line, least significant bit first: four
+ * pixels take five bytes. The CSI-2 packing stores the same four pixels as
+ * their eight most significant bits in four bytes, followed by one byte with
+ * the four pairs of least significant bits.
+ */
+
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+namespace libcamera {
+
+namespace mtisp {
+
+/* Unpack the four 10-bit pixels of one five byte group */
+static inline void unpackGroup(const uint8_t *src, uint16_t px[4])
+{
+	const uint64_t v = static_cast<uint64_t>(src[0]) |
+			   (static_cast<uint64_t>(src[1]) << 8) |
+			   (static_cast<uint64_t>(src[2]) << 16) |
+			   (static_cast<uint64_t>(src[3]) << 24) |
+			   (static_cast<uint64_t>(src[4]) << 32);
+
+	px[0] = v & 0x3ff;
+	px[1] = (v >> 10) & 0x3ff;
+	px[2] = (v >> 20) & 0x3ff;
+	px[3] = (v >> 30) & 0x3ff;
+}
+
+/* Pack four 10-bit pixels into one five byte group */
+static inline void packGroup(const uint16_t px[4], uint8_t *dst)
+{
+	const uint64_t v = static_cast<uint64_t>(px[0] & 0x3ff) |
+			   (static_cast<uint64_t>(px[1] & 0x3ff) << 10) |
+			   (static_cast<uint64_t>(px[2] & 0x3ff) << 20) |
+			   (static_cast<uint64_t>(px[3] & 0x3ff) << 30);
+
+	for (unsigned int i = 0; i < 5; i++)
+		dst[i] = (v >> (8 * i)) & 0xff;
+}
+
+/*
+ * Repack \a length bytes (a multiple of 5) of a MediaTek packed line into the
+ * CSI-2 packed layout, so that the CSI-2 debayer and statistics functions can
+ * process it.
+ */
+static inline void repackToCsi2(uint8_t *dst, const uint8_t *src, size_t length)
+{
+	for (size_t i = 0; i + 5 <= length; i += 5) {
+		uint16_t px[4];
+
+		unpackGroup(src + i, px);
+		dst[i + 0] = px[0] >> 2;
+		dst[i + 1] = px[1] >> 2;
+		dst[i + 2] = px[2] >> 2;
+		dst[i + 3] = px[3] >> 2;
+		dst[i + 4] = (px[0] & 3) | ((px[1] & 3) << 2) |
+			     ((px[2] & 3) << 4) | ((px[3] & 3) << 6);
+	}
+}
+
+} /* namespace mtisp */
+
+} /* namespace libcamera */
diff --git a/include/libcamera/internal/software_isp/mtk_dip_params.h b/include/libcamera/internal/software_isp/mtk_dip_params.h
new file mode 100644
index 0000000..9534f7a
--- /dev/null
+++ b/include/libcamera/internal/software_isp/mtk_dip_params.h
@@ -0,0 +1,192 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Translation of the software ISP parameters into MT6785 DIP parameter blocks
+ */
+
+#pragma once
+
+#include <array>
+#include <optional>
+#include <utility>
+#include <vector>
+#include <stddef.h>
+#include <stdint.h>
+
+#include <linux/media/mediatek/mtk-dip-mt6785.h>
+
+#include <libcamera/base/span.h>
+
+#include "libcamera/internal/bayer_format.h"
+#include "libcamera/internal/software_isp/debayer_params.h"
+
+namespace libcamera {
+
+class ValueNode;
+
+namespace mtkdip {
+
+/*
+ * Input positions of the gamma curve points of the DIP: segments of points
+ * with a fixed step, in units of 1/kGammaInputScale of full scale, as defined
+ * by the UAPI header. This is the only place that knows the layout.
+ */
+struct GammaSegment {
+	unsigned int points;
+	unsigned int step;
+};
+
+static constexpr unsigned int kGammaInputScale = MTK_DIP_GAMMA_INPUT_SCALE;
+static constexpr std::array<GammaSegment, 3> kGammaSegments = { {
+	{ MTK_DIP_GAMMA_SEG0, MTK_DIP_GAMMA_STEP0 },
+	{ MTK_DIP_GAMMA_SEG1, MTK_DIP_GAMMA_STEP1 },
+	{ MTK_DIP_GAMMA_SEG2, MTK_DIP_GAMMA_STEP2 },
+} };
+static constexpr unsigned int kGammaPoints =
+	kGammaSegments[0].points + kGammaSegments[1].points + kGammaSegments[2].points;
+
+unsigned int gammaInputPosition(unsigned int index);
+
+uint16_t toUnsignedQ4_12(float value);
+int16_t toSignedQ4_12(float value);
+uint16_t toBlackLevel(float level);
+
+/* Largest gain of the BLC and WB blocks (Q4.12 below 16.0) */
+static constexpr float kMaxBlcGain = 0xffff / 4096.0f;
+
+float commonGain(const DebayerParams &params);
+
+/*
+ * Gamma of the soft IPA default (Adjust, kDefaultGamma): with a tuned tone
+ * curve, DebayerParams::gamma acts relative to it.
+ */
+static constexpr float kReferenceGamma = 2.2f;
+
+class ToneCurve
+{
+public:
+	static std::optional<ToneCurve> fromPoints(Span<const float> xy);
+
+	float operator()(float x) const;
+	std::size_t size() const { return points_.size(); }
+
+private:
+	ToneCurve() = default;
+
+	std::vector<std::pair<float, float>> points_;
+};
+
+float shadowLift(float value, float lift);
+
+float toneCurve(float value, float gamma, float contrastExp,
+		const ToneCurve *curve = nullptr, float lift = 0.0f);
+
+/*
+ * Lens shading gains at the corners of the block grid over the raw input
+ * frame (positions as in the UAPI header), per colour channel: red, green in
+ * the red rows, green in the blue rows, blue.
+ */
+struct LensShading {
+	enum Channel {
+		R = 0,
+		Gr = 1,
+		Gb = 2,
+		B = 3,
+	};
+
+	static constexpr unsigned int kGridPoints = MTK_DIP_LSC_POINTS;
+	static constexpr unsigned int kPoints = kGridPoints * kGridPoints;
+
+	/* Gains row by row from the top left, the strength already applied */
+	std::array<std::array<float, kPoints>, 4> gain;
+
+	static std::optional<LensShading> fromGrids(const std::array<std::vector<float>, 4> &grids,
+						    float strength);
+};
+
+/*
+ * Image quality blocks (edge enhancement, noise reduction in two stages,
+ * demosaicing) for a sensitivity, as given by the tuning file. A missing
+ * module is sent as disabled at that sensitivity.
+ */
+struct QualityPoint {
+	double iso = 0.0;
+	std::optional<struct mtk_dip_params_ee> ee;
+	std::optional<struct mtk_dip_params_ycnr> ycnr;
+	std::optional<struct mtk_dip_params_demosaic> demosaic;
+	std::optional<struct mtk_dip_params_nbc2> nbc2;
+};
+
+class QualityTable
+{
+public:
+	static std::optional<QualityTable> fromTuning(const ValueNode &node);
+
+	const QualityPoint &select(float totalGain);
+	std::size_t size() const { return points_.size(); }
+	double isoPerGain() const { return isoPerGain_; }
+
+	bool usesEe() const { return usesEe_; }
+	bool usesYcnr() const { return usesYcnr_; }
+	bool usesDemosaic() const { return usesDemosaic_; }
+	bool usesNbc2() const { return usesNbc2_; }
+	void dropNbc2();
+
+private:
+	QualityTable() = default;
+
+	std::vector<QualityPoint> points_;
+	double isoPerGain_ = 100.0;
+	double hysteresis_ = 0.25;
+	std::optional<unsigned int> current_;
+	bool usesEe_ = false;
+	bool usesYcnr_ = false;
+	bool usesDemosaic_ = false;
+	bool usesNbc2_ = false;
+};
+
+class ParamsEncoder
+{
+public:
+	void reset();
+	size_t encode(const DebayerParams &params, BayerFormat::Order order,
+		      Span<uint8_t> buffer);
+	void commit();
+
+	void setToneCurve(std::optional<ToneCurve> curve);
+	void setShadowLift(float lift);
+	void setLensShading(std::optional<LensShading> lsc);
+	void setQuality(std::optional<QualityTable> quality);
+	bool hasQuality() const { return quality_.has_value(); }
+	bool usesNbc2() const { return quality_ && quality_->usesNbc2(); }
+	void dropNbc2();
+	bool dropStartDisables(unsigned int minType = 0);
+
+private:
+	/* The colour module needs the MDP path of the hardware: not sent */
+	static constexpr unsigned int kBlockTypes = MTK_DIP_PARAMS_BLOCK_NBC2 + 1;
+
+	/*
+	 * Blocks the DIP has received, those of the last encode(), and which
+	 * of them that buffer carries (all that changed, as far as they fit)
+	 */
+	std::array<std::vector<uint8_t>, kBlockTypes> sent_;
+	std::array<std::vector<uint8_t>, kBlockTypes> pending_;
+	std::array<bool, kBlockTypes> included_{};
+
+	/*
+	 * Optional blocks whose state in the DIP is unknown (after reset(),
+	 * the driver keeps them across streams): sent disabled when the
+	 * tuning does not configure them
+	 */
+	std::array<bool, kBlockTypes> unknown_{};
+
+	/* Tuning, kept across reset() */
+	std::optional<ToneCurve> toneCurve_;
+	float shadowLift_ = 0.0f;
+	std::optional<LensShading> lensShading_;
+	std::optional<QualityTable> quality_;
+};
+
+} /* namespace mtkdip */
+
+} /* namespace libcamera */
