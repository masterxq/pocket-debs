 struct SwIspStats {
+	/**
+	 * \brief Statistics are gathered on every kFramesPerStats-th frame,
+	 *        the frames whose number is a multiple of it
+	 */
+	static constexpr uint32_t kFramesPerStats = 4;
 	/**
