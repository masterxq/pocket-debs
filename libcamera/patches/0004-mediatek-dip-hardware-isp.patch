+	struct v4l2_isp_params_block_header header;
+	__u16 contrast;
+	__u16 brightness;
+	__u16 saturation;
+	__u8 luma_slope[MTK_DIP_COLOR_LUMA_POINTS];
+	__u8 hue_offset[MTK_DIP_COLOR_HUE_SECTORS];
+	__u8 sat_gain[MTK_DIP_COLOR_SAT_SEGMENTS][MTK_DIP_COLOR_HUE_SECTORS];
+	__u8 sat_point[MTK_DIP_COLOR_SAT_POINTS][MTK_DIP_COLOR_HUE_SECTORS];
+	__u8 sat_gain_luma[MTK_DIP_COLOR_LUMA_LEVELS][MTK_DIP_COLOR_HUE_SECTORS];
+	__u8 luma_sat_param[MTK_DIP_COLOR_LUMA_SAT_PARAMS];
+	__u8 reserved[6];
