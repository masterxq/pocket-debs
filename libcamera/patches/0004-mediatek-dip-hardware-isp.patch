+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * MediaTek DIP debayer backend: behaviour without a DIP
+ */
+
+#include <iostream>
+#include <memory>
+
+#include <libcamera/camera_manager.h>
+
+#include "libcamera/internal/software_isp/swstats_cpu.h"
+
+#include "debayer_mtk_dip.h"
+
+#include "test.h"
+
+using namespace libcamera;
+
+class MtkDipFallbackTest : public Test
+{
+protected:
+	int run() override
+	{
+		CameraManager cm;
+
+		/*
+		 * Without a DIP the backend is not created and the statistics
+		 * object stays with the caller for the CPU fallback.
+		 */
+		std::unique_ptr<SwStatsCpu> stats = std::make_unique<SwStatsCpu>(cm);
+		std::unique_ptr<DebayerMtkDip> dip = DebayerMtkDip::create(stats, cm);
+		if (dip) {
+			std::cout << "MediaTek DIP present, fallback not tested" << std::endl;
+			return TestSkip;
+		}
+
+		if (!stats) {
+			std::cerr << "Statistics object lost without a DIP" << std::endl;
+			return TestFail;
+		}
+
+		return TestPass;
+	}
+};
+
+TEST_REGISTER(MtkDipFallbackTest)
