+/**
+ * struct mtk_dip_params_color - colour module, on the YUV data
+ * @header: block header, type MTK_DIP_PARAMS_BLOCK_COLOR
+ * @contrast: contrast, 128 = unchanged, 0 to 1023
+ * @brightness: brightness offset, 1024 = unchanged, 0 to 2047
+ * @saturation: global saturation gain, 128 = 1.0, 0 to 1023
+ * @luma_slope: slope of the luma curve per sixteenth of the luma range, 128 =
+ *	1.0, 0 to 255
+ * @hue_offset: hue offset per hue sector, 128 = none, 0 to 255
+ * @sat_gain: saturation gain per segment of the saturation curve and hue
+ *	sector, 128 = 1.0, 0 to 255
+ * @sat_point: saturation at the ends of the first two segments per hue sector,
+ *	0 to 255
+ * @sat_gain_luma: saturation gain at the luma levels 0, 64, 128, 192, 255 per
+ *	hue sector, 128 = 1.0, 0 to 255
