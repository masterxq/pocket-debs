From: pocket-debs
Date: Thu, 19 Nov 2026 12:00:00 +0100
Subject: [PATCH] ipa: simple: agc: Tunable step size and frame length extension
Description:
 The proportional exposure control of the simple IPA moves by at most 6% per
 statistics frame (every fourth frame) at its built-in gain of 0.04, so a dark
 start takes several seconds to reach the right exposure. The exposure is
 also capped by the default frame length of the sensor mode, which leaves
 indoor scenes dark once the analogue gain is at its maximum.
 .
 Make the proportional gain, the largest step and the smallest gain step
 tunable, and let the AGC raise VBLANK up to a tuned factor of the default
 exposure limit once the gain reached a tuned value. Without the new tuning
 keys the behaviour is unchanged.
 .
 The simple pipeline handler gets VBLANK into the delayed controls (priority
 write), sets a new VBLANK before the exposure when it applies controls
 directly (no frame start events), and resets VBLANK to its default at
 configure time so that an earlier session does not leave a longer frame
 length behind.
Forwarded: no
License: LGPL-2.1-or-later (as the patched files)
Last-Update: 2026-11-19
---
diff --git a/src/ipa/simple/algorithms/agc.cpp b/src/ipa/simple/algorithms/agc.cpp
index a13a755..50ead42 100644
--- a/src/ipa/simple/algorithms/agc.cpp
+++ b/src/ipa/simple/algorithms/agc.cpp
@@ -9,8 +9,11 @@
 
 #include <algorithm>
 #include <cmath>
+#include <errno.h>
 #include <stdint.h>
 
+#include <linux/v4l2-controls.h>
+
 #include <libcamera/base/log.h>
 
 #include "control_ids.h"
@@ -62,11 +65,88 @@ static constexpr float kExpProportionalGain = 0.04;
 static constexpr float kExpMaxStep = 0.15;
 
 Agc::Agc()
+	: proportionalGain_(kExpProportionalGain), maxStep_(kExpMaxStep),
+	  maxExposureFactor_(1.0)
+{
+}
+
+/**
+ * \brief Read the optional tuning parameters
+ *
+ * - proportionalGain, maxStep: the proportional gain and the largest relative
+ *   step per statistics frame (defaults kExpProportionalGain, kExpMaxStep)
+ * - minGainStep: smallest gain step, relative to the minimum gain (default
+ *   one hundredth of the gain range)
+ * - maxExposureFactor: how far the exposure may grow beyond the limit of the
+ *   default frame length by raising VBLANK (default 1.0, no extension)
+ * - extensionGain: gain, relative to the minimum gain, from which on the frame
+ *   length is extended (default the maximum gain)
+ */
+int Agc::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
 {
+	proportionalGain_ = tuningData["proportionalGain"].get<float>(kExpProportionalGain);
+	maxStep_ = tuningData["maxStep"].get<float>(kExpMaxStep);
+	minGainStep_ = tuningData["minGainStep"].get<double>();
+	maxExposureFactor_ = tuningData["maxExposureFactor"].get<double>(1.0);
+	extensionGain_ = tuningData["extensionGain"].get<double>();
+
+	if (proportionalGain_ <= 0.0f || maxStep_ <= 0.0f || maxStep_ >= 1.0f ||
+	    maxExposureFactor_ < 1.0 ||
+	    (minGainStep_ && *minGainStep_ <= 0.0) ||
+	    (extensionGain_ && *extensionGain_ < 1.0)) {
+		LOG(IPASoftExposure, Error) << "Invalid Agc tuning parameters";
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+int Agc::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+	auto &agc = context.configuration.agc;
+
+	if (minGainStep_)
+		agc.againMinStep = *minGainStep_ * agc.againMin;
+
+	agc.exposureMaxExtended = agc.exposureMax;
+	agc.extensionGain = agc.againMax;
+	agc.vblankEnabled = false;
+	agc.vblankDefault = 0;
+
+	const auto it = configInfo.sensorControls.find(V4L2_CID_VBLANK);
+	if (maxExposureFactor_ > 1.0 && it != configInfo.sensorControls.end()) {
+		const int32_t vblankDef = it->second.def().get<int32_t>();
+		const int32_t vblankMax = it->second.max().get<int32_t>();
+		/* One line of headroom for VBLANK steps of two lines. */
+		const int64_t limit = static_cast<int64_t>(agc.exposureMax) +
+				      vblankMax - vblankDef - 1;
+		const int64_t wanted = agc.exposureMax * maxExposureFactor_;
+
+		agc.exposureMaxExtended = std::min(wanted, limit);
+		if (agc.exposureMaxExtended > agc.exposureMax) {
+			agc.vblankEnabled = true;
+			agc.vblankDefault = vblankDef;
+			if (extensionGain_)
+				agc.extensionGain = std::clamp(*extensionGain_ * agc.againMin,
+							       agc.againMin, agc.againMax);
+		} else {
+			agc.exposureMaxExtended = agc.exposureMax;
+		}
+	}
+
+	LOG(IPASoftExposure, Info)
+		<< "Agc: step " << proportionalGain_ << "/" << maxStep_
+		<< ", min gain step " << agc.againMinStep
+		<< ", exposure up to " << agc.exposureMaxExtended
+		<< " (" << agc.exposureMax << " at the default frame length)"
+		<< ", extension from gain " << agc.extensionGain;
+
+	return 0;
 }
 
 void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext, double exposureMSV)
 {
+	const auto &agc = context.configuration.agc;
 	int32_t &exposure = frameContext.sensor.exposure;
 	double &again = frameContext.sensor.gain;
 
@@ -80,40 +160,59 @@ void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext, dou
 	 * determines the direction: positive error means too dark (increase),
 	 * negative means too bright (decrease).
 	 */
-	float step = std::clamp(static_cast<float>(error) * kExpProportionalGain,
-				-kExpMaxStep, kExpMaxStep);
+	float step = std::clamp(static_cast<float>(error) * proportionalGain_,
+				-maxStep_, maxStep_);
 	float factor = 1.0f + step;
 
+	auto exposureUp = [&](int32_t limit) {
+		int32_t next = static_cast<int32_t>(exposure * factor);
+		exposure = std::min(std::max(next, exposure + 1), limit);
+	};
+	auto exposureDown = [&](int32_t limit) {
+		int32_t next = static_cast<int32_t>(exposure * factor);
+		exposure = std::max(std::min(next, exposure - 1), limit);
+	};
+	auto gainUp = [&](double limit) {
+		double next = again * factor;
+		if (next - again < agc.againMinStep)
+			next = again + agc.againMinStep;
+		again = std::min(next, limit);
+	};
+	auto gainDown = [&](double limit) {
+		double next = again * factor;
+		if (again - next < agc.againMinStep)
+			next = again - agc.againMinStep;
+		again = std::max(next, limit);
+	};
+
+	/*
+	 * Order when too dark: exposure up to the limit of the default frame
+	 * length, gain up to extensionGain, exposure up to the extended frame
+	 * length, gain up to the maximum. Too bright: the reverse. Without a
+	 * frame length extension this is exposure first, then gain.
+	 */
 	if (factor > 1.0f) {
-		/* Scene too dark: increase exposure first, then gain. */
-		if (exposure < context.configuration.agc.exposureMax) {
-			int32_t next = static_cast<int32_t>(exposure * factor);
-			exposure = std::max(next, exposure + 1);
-		} else {
-			double next = again * factor;
-			if (next - again < context.configuration.agc.againMinStep)
-				again += context.configuration.agc.againMinStep;
-			else
-				again = next;
-		}
+		if (exposure < agc.exposureMax)
+			exposureUp(agc.exposureMax);
+		else if (again < agc.extensionGain)
+			gainUp(agc.extensionGain);
+		else if (exposure < agc.exposureMaxExtended)
+			exposureUp(agc.exposureMaxExtended);
+		else
+			gainUp(agc.againMax);
 	} else {
-		/* Scene too bright: decrease gain first, then exposure. */
-		if (again > context.configuration.agc.again10) {
-			double next = again * factor;
-			if (again - next < context.configuration.agc.againMinStep)
-				again -= context.configuration.agc.againMinStep;
-			else
-				again = next;
-		} else {
-			int32_t next = static_cast<int32_t>(exposure * factor);
-			exposure = std::min(next, exposure - 1);
-		}
+		if (exposure > agc.exposureMax && again > agc.extensionGain)
+			gainDown(agc.extensionGain);
+		else if (exposure > agc.exposureMax)
+			exposureDown(agc.exposureMax);
+		else if (again > agc.again10)
+			gainDown(agc.againMin);
+		else
+			exposureDown(agc.exposureMin);
 	}
 
-	exposure = std::clamp(exposure, context.configuration.agc.exposureMin,
-			      context.configuration.agc.exposureMax);
-	again = std::clamp(again, context.configuration.agc.againMin,
-			   context.configuration.agc.againMax);
+	exposure = std::clamp(exposure, agc.exposureMin, agc.exposureMaxExtended);
+	again = std::clamp(again, agc.againMin, agc.againMax);
 
 	context.activeState.agc.exposure = exposure;
 	context.activeState.agc.again = again;
diff --git a/src/ipa/simple/algorithms/agc.h b/src/ipa/simple/algorithms/agc.h
index 112d9f5..82a3360 100644
--- a/src/ipa/simple/algorithms/agc.h
+++ b/src/ipa/simple/algorithms/agc.h
@@ -7,6 +7,8 @@
 
 #pragma once
 
+#include <optional>
+
 #include "algorithm.h"
 
 namespace libcamera {
@@ -19,6 +21,8 @@ public:
 	Agc();
 	~Agc() = default;
 
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
 	void process(IPAContext &context, const uint32_t frame,
 		     IPAFrameContext &frameContext,
 		     const SwIspStats *stats,
@@ -26,6 +30,12 @@ public:
 
 private:
 	void updateExposure(IPAContext &context, IPAFrameContext &frameContext, double exposureMSV);
+
+	float proportionalGain_;
+	float maxStep_;
+	std::optional<double> minGainStep_;
+	double maxExposureFactor_;
+	std::optional<double> extensionGain_;
 };
 
 } /* namespace ipa::soft::algorithms */
diff --git a/src/ipa/simple/ipa_context.h b/src/ipa/simple/ipa_context.h
index 8ccfacb..115a64e 100644
--- a/src/ipa/simple/ipa_context.h
+++ b/src/ipa/simple/ipa_context.h
@@ -29,6 +29,17 @@ struct IPASessionConfiguration {
 		int32_t exposureMin, exposureMax;
 		double againMin, againMax, again10, againMinStep;
 		utils::Duration lineDuration;
+		/*
+		 * Frame length extension: exposureMax is the limit at the
+		 * default frame length, exposureMaxExtended the limit with
+		 * VBLANK raised up to the tuned factor (equal to exposureMax
+		 * without extension). The frame length is only extended once
+		 * the gain reached extensionGain.
+		 */
+		int32_t exposureMaxExtended;
+		double extensionGain;
+		bool vblankEnabled;
+		int32_t vblankDefault;
 	} agc;
 	struct {
 		std::optional<uint8_t> level;
diff --git a/src/ipa/simple/soft_simple.cpp b/src/ipa/simple/soft_simple.cpp
index 629e1a3..f219d25 100644
--- a/src/ipa/simple/soft_simple.cpp
+++ b/src/ipa/simple/soft_simple.cpp
@@ -325,6 +325,14 @@ void IPASoftSimple::processStats(const uint32_t frame,
 	ctrls.set(V4L2_CID_ANALOGUE_GAIN,
 		  static_cast<int32_t>(camHelper_ ? camHelper_->gainCode(againNew) : againNew));
 
+	const auto &agc = context_.configuration.agc;
+	if (agc.vblankEnabled) {
+		/* Raise the frame length with the exposure, one line headroom. */
+		int32_t extra = frameContext.sensor.exposure - agc.exposureMax;
+		ctrls.set(V4L2_CID_VBLANK,
+			  agc.vblankDefault + (extra > 0 ? extra + 1 : 0));
+	}
+
 	setSensorControls.emit(ctrls);
 }
 
diff --git a/src/libcamera/pipeline/simple/simple.cpp b/src/libcamera/pipeline/simple/simple.cpp
index e26f438..a01faed 100644
--- a/src/libcamera/pipeline/simple/simple.cpp
+++ b/src/libcamera/pipeline/simple/simple.cpp
@@ -22,6 +22,7 @@
 #include <vector>
 
 #include <linux/media-bus-format.h>
+#include <linux/v4l2-controls.h>
 
 #include <libcamera/base/log.h>
 
@@ -570,6 +571,9 @@ SimpleCameraData::SimpleCameraData(SimplePipelineHandler *pipe,
 		{ V4L2_CID_ANALOGUE_GAIN, { delays.gainDelay, false } },
 		{ V4L2_CID_EXPOSURE, { delays.exposureDelay, false } },
 	};
+	/* The IPA may raise the frame length for longer exposures. */
+	if (sensor_->controls().count(V4L2_CID_VBLANK))
+		params[V4L2_CID_VBLANK] = { delays.vblankDelay, true };
 	delayedCtrls_ = std::make_unique<DelayedControls>(sensor_->device(), params);
 
 	LOG(SimplePipeline, Debug)
@@ -1054,6 +1058,17 @@ void SimpleCameraData::setSensorControls(const ControlList &sensorControls)
 	 */
 	if (!frameStartEmitter_) {
 		ControlList ctrls(sensorControls);
+
+		/*
+		 * Set a new frame length on its own first, the exposure limit
+		 * of the sensor follows it.
+		 */
+		if (ctrls.contains(V4L2_CID_VBLANK)) {
+			ControlList vblank(sensor_->controls());
+			vblank.set(V4L2_CID_VBLANK, ctrls.get(V4L2_CID_VBLANK));
+			sensor_->setControls(&vblank);
+		}
+
 		sensor_->setControls(&ctrls);
 	}
 }
@@ -1603,6 +1618,21 @@ int SimplePipelineHandler::configure(Camera *camera, CameraConfiguration *c)
 	if (data->converter_) {
 		return data->converter_->configure(inputCfg, outputCfgs);
 	} else {
+		/*
+		 * Start from the default frame length of the mode, the IPA may
+		 * have extended it in an earlier session.
+		 */
+		const ControlInfoMap &sensorCtrls = data->sensor_->controls();
+		const auto vblank = sensorCtrls.find(V4L2_CID_VBLANK);
+		if (vblank != sensorCtrls.end()) {
+			ControlList ctrls(sensorCtrls);
+			ctrls.set(V4L2_CID_VBLANK, vblank->second.def());
+			ret = data->sensor_->setControls(&ctrls);
+			if (ret)
+				return ret;
+			data->sensor_->device()->updateControlInfo();
+		}
+
 		ipa::soft::IPAConfigInfo configInfo;
 		configInfo.sensorControls = data->sensor_->controls();
 		return data->swIsp_->configure(inputCfg, outputCfgs, configInfo);
