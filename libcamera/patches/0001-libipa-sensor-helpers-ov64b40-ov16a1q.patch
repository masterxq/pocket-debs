From: pocket-debs
Date: Sun, 22 Nov 2026 12:00:00 +0100
Subject: [PATCH] ipa: libipa: camera_sensor_helper: Add OV64B40, OV16A1Q and S5K5E9
Description:
 Add camera sensor helpers and static sensor properties for the OmniVision
 OV64B40 (64 MP quad Bayer, rear camera of the Motorola Moto G60s), the
 OV16A1Q (16 MP, front camera of the same phone) and the S5K5E9 (5 MP, macro
 camera of the same phone).
 .
 The OmniVision sensors take a linear analogue gain code with 0x100 = 1x up
 to 0xf80 (15.5x), as programmed by the vendor kernel drivers; the S5K5E9 a
 linear code with 0x20 = 1x up to 0x200 (16x). The black level of 16 at
 8 bits (4096 at 16 bits) was measured on the device for all three sensors.
 The sensor delays (two frames for all three) follow
 the group hold the kernel drivers use for exposure, gain and frame length
 updates while streaming.
Forwarded: no
License: LGPL-2.1-or-later (as the patched files)
Last-Update: 2026-11-22
---
diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
index 9457d62..9fde81b 100644
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -791,6 +791,19 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("ov64a40", CameraSensorHelperOv64a40)
 
+class CameraSensorHelperOv64b40 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperOv64b40()
+	{
+		/* 16 at 8 bits, measured on a covered sensor. */
+		blackLevel_ = 4096;
+		/* 0x100 is 1x, up to 0xf80 (15.5x). */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 256 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("ov64b40", CameraSensorHelperOv64b40)
+
 class CameraSensorHelperOv8858 : public CameraSensorHelper
 {
 public:
@@ -827,6 +840,32 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("ov13858", CameraSensorHelperOv13858)
 
+class CameraSensorHelperOv16a1q : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperOv16a1q()
+	{
+		/* 16 at 8 bits, measured on a covered sensor. */
+		blackLevel_ = 4096;
+		/* 0x100 is 1x, up to 0xf80 (15.5x). */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 256 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("ov16a1q", CameraSensorHelperOv16a1q)
+
+class CameraSensorHelperS5k5e9 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperS5k5e9()
+	{
+		/* 16 at 8 bits, measured on a dark frame. */
+		blackLevel_ = 4096;
+		/* 0x20 is 1x, up to 0x200 (16x). */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 32 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5k5e9", CameraSensorHelperS5k5e9)
+
 class CameraSensorHelperVd55g1 : public CameraSensorHelper
 {
 public:
