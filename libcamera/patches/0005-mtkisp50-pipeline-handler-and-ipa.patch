+	struct v4l2_isp_params_block_header header;
+	__u32 con;
+	__u32 ll_con[MTK_MFB_LL_CON_EXTRA_WORDS];
+	__u32 edge;
+} __attribute__((aligned(8)));
+
+#endif /* _UAPI_MTK_MFB_MT6785_H */
