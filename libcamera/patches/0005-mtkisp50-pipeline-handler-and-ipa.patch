diff --git a/src/ipa/mtkisp50/algorithms/adjust.cpp b/src/ipa/mtkisp50/algorithms/adjust.cpp
new file mode 100644
index 0000000..c33ffef
--- /dev/null
+++ b/src/ipa/mtkisp50/algorithms/adjust.cpp
@@ -0,0 +1,295 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2024, Ideas On Board
+ * Copyright (C) 2024-2026, Red Hat Inc.
+ *
+ * Common image adjustments
+ */
+
+#include "adjust.h"
+
+#include <algorithm>
+#include <cmath>
+#include <string>
+#include <utility>
+
+#include <libcamera/base/log.h>
+#include <libcamera/base/utils.h>
+
+#include <libcamera/control_ids.h>
+
+#include "libcamera/internal/matrix.h"
+
+namespace libcamera {
+
+namespace ipa::mtkisp50::algorithms {
+
+constexpr float kDefaultContrast = 1.0f;
+constexpr float kDefaultSaturation = 1.0f;
+
+LOG_DEFINE_CATEGORY(IPAMtkIsp50Adjust)
+
+/**
+ * \class Adjust
+ *
+ * Tuning parameters (all optional):
+ * - saturation: default of the Saturation control (used while the application
+ *   sets none), a curve over the colour temperature of Awb and optionally the
+ *   light value of the scene. Keys: "ct", rising colour temperatures in
+ *   Kelvin; "values", the saturation at these temperatures (0.0 to 2.0, 1.0 =
+ *   unchanged), one list, or one list per entry of "lv", rising light values.
+ *   Between the temperatures the value is interpolated linearly in mired,
+ *   between the light values linearly, and held beyond the ends. The light
+ *   value of a frame is estimated from its exposure, assuming the AGC exposes
+ *   it to its target and ISO 100 at a gain of 1.0:
+ *   lv = log2(fNumber^2 / exposure time) - log2(gain) + lvOffset, with
+ *   "fNumber" (default 2.0) and "lvOffset" (default 0.0). Needs Ccm, the
+ *   saturation is applied to the colour matrix.
+ */
+
+int Adjust::init(IPAContext &context, const ValueNode &tuningData)
+{
+	context.ctrlMap[&controls::Gamma] =
+		ControlInfo(0.1f, 10.0f, kDefaultGamma);
+	context.ctrlMap[&controls::Contrast] =
+		ControlInfo(0.0f, 2.0f, kDefaultContrast);
+	if (context.ccmEnabled)
+		context.ctrlMap[&controls::Saturation] =
+			ControlInfo(0.0f, 2.0f, kDefaultSaturation);
+
+	if (tuningData.contains("saturation")) {
+		if (!context.ccmEnabled) {
+			LOG(IPAMtkIsp50Adjust, Warning)
+				<< "Saturation curve without Ccm, ignored";
+		} else if (parseSaturationCurve(tuningData["saturation"])) {
+			return -EINVAL;
+		}
+	}
+
+	return 0;
+}
+
+int Adjust::parseSaturationCurve(const ValueNode &node)
+{
+	SaturationCurve curve;
+	curve.fNumber = node["fNumber"].get<double>(2.0);
+	curve.lvOffset = node["lvOffset"].get<double>(0.0);
+
+	auto list = [](const ValueNode &n) -> std::optional<std::vector<double>> {
+		if (!n.isList())
+			return std::nullopt;
+		std::vector<double> out;
+		for (const ValueNode &v : n.asList()) {
+			std::optional<double> d = v.get<double>();
+			if (!d)
+				return std::nullopt;
+			out.push_back(*d);
+		}
+		return out;
+	};
+	auto rising = [](const std::vector<double> &v) {
+		for (unsigned int i = 1; i < v.size(); i++) {
+			if (!(v[i] > v[i - 1]))
+				return false;
+		}
+		return !v.empty();
+	};
+
+	std::optional<std::vector<double>> ct = list(node["ct"]);
+	if (!ct || !rising(*ct) || !((*ct)[0] > 0.0) || !(curve.fNumber > 0.0)) {
+		LOG(IPAMtkIsp50Adjust, Error) << "saturation: ct missing, not rising or fNumber invalid";
+		return -EINVAL;
+	}
+	curve.ct = *ct;
+
+	const ValueNode &values = node["values"];
+	if (node.contains("lv")) {
+		std::optional<std::vector<double>> lv = list(node["lv"]);
+		if (!lv || !rising(*lv) || !values.isList()) {
+			LOG(IPAMtkIsp50Adjust, Error) << "saturation: lv not rising or values not a list";
+			return -EINVAL;
+		}
+		curve.lv = *lv;
+		for (const ValueNode &row : values.asList()) {
+			std::optional<std::vector<double>> r = list(row);
+			if (!r) {
+				LOG(IPAMtkIsp50Adjust, Error) << "saturation: values not a list per lv";
+				return -EINVAL;
+			}
+			curve.values.push_back(*r);
+		}
+	} else {
+		std::optional<std::vector<double>> r = list(values);
+		if (r)
+			curve.values.push_back(*r);
+	}
+
+	if (curve.values.size() != std::max<std::size_t>(curve.lv.size(), 1)) {
+		LOG(IPAMtkIsp50Adjust, Error) << "saturation: one list of values per lv expected";
+		return -EINVAL;
+	}
+	for (const std::vector<double> &row : curve.values) {
+		if (row.size() != curve.ct.size() ||
+		    std::any_of(row.begin(), row.end(), [](double v) { return !(v >= 0.0 && v <= 2.0); })) {
+			LOG(IPAMtkIsp50Adjust, Error)
+				<< "saturation: one value from 0.0 to 2.0 per ct expected";
+			return -EINVAL;
+		}
+	}
+
+	LOG(IPAMtkIsp50Adjust, Info)
+		<< "Saturation curve over " << curve.ct.size() << " colour temperatures"
+		<< (curve.lv.empty() ? "" : " and " + std::to_string(curve.lv.size()) + " light values");
+	saturationCurve_ = std::move(curve);
+	return 0;
+}
+
+/*
+ * Default saturation of the tuning for the current scene, std::nullopt
+ * without a curve or before Awb has a colour temperature
+ */
+std::optional<float> Adjust::curveSaturation(const IPAContext &context) const
+{
+	if (!saturationCurve_ || !context.activeState.awb.temperatureK)
+		return std::nullopt;
+
+	const SaturationCurve &c = *saturationCurve_;
+
+	/* Position between two points: index of the lower one and weight of the upper */
+	auto locate = [](const std::vector<double> &x, double v) {
+		if (x.size() == 1 || v <= x.front())
+			return std::pair<unsigned int, double>(0, 0.0);
+		if (v >= x.back())
+			return std::pair<unsigned int, double>(x.size() - 2, 1.0);
+		unsigned int i = 0;
+		while (v > x[i + 1])
+			i++;
+		return std::pair<unsigned int, double>(i, (v - x[i]) / (x[i + 1] - x[i]));
+	};
+
+	/* Linear in mired: mired falls with the temperature, use -mired */
+	std::vector<double> negMired;
+	for (double ct : c.ct)
+		negMired.push_back(-1e6 / ct);
+	const auto [ci, cw] = locate(negMired, -1e6 / context.activeState.awb.temperatureK);
+	auto rowValue = [&](const std::vector<double> &row) {
+		return row.size() == 1 ? row[0] : row[ci] + cw * (row[ci + 1] - row[ci]);
+	};
+
+	if (c.lv.empty())
+		return static_cast<float>(rowValue(c.values[0]));
+
+	/* Light value from the exposure; the first row before the AGC runs */
+	const auto &agc = context.activeState.agc;
+	const utils::Duration exposureTime = context.configuration.agc.lineDuration * agc.exposure;
+	const double t = exposureTime.get<std::ratio<1>>();
+	const double gain = agc.again * agc.digitalGain;
+	if (!agc.valid || !(t > 0.0) || !(gain > 0.0))
+		return static_cast<float>(rowValue(c.values[0]));
+
+	const double lv = std::log2(c.fNumber * c.fNumber / t) - std::log2(gain) + c.lvOffset;
+	const auto [li, lw] = locate(c.lv, lv);
+	const double lo = rowValue(c.values[li]);
+	const double hi = c.values.size() > 1 ? rowValue(c.values[li + 1]) : lo;
+	return static_cast<float>(lo + lw * (hi - lo));
+}
+
+int Adjust::configure(IPAContext &context,
+		      [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	context.activeState.knobs.gamma = kDefaultGamma;
+	context.activeState.knobs.contrast = std::optional<float>();
+	context.activeState.knobs.saturation = std::optional<float>();
+
+	return 0;
+}
+
+void Adjust::queueRequest(typename Module::Context &context,
+			  [[maybe_unused]] const uint32_t frame,
+			  [[maybe_unused]] typename Module::FrameContext &frameContext,
+			  const ControlList &controls)
+{
+	const auto &gamma = controls.get(controls::Gamma);
+	if (gamma.has_value()) {
+		context.activeState.knobs.gamma = gamma.value();
+		LOG(IPAMtkIsp50Adjust, Debug) << "Setting gamma to " << gamma.value();
+	}
+
+	const auto &contrast = controls.get(controls::Contrast);
+	if (contrast.has_value()) {
+		context.activeState.knobs.contrast = contrast;
+		LOG(IPAMtkIsp50Adjust, Debug) << "Setting contrast to " << contrast.value();
+	}
+
+	const auto &saturation = controls.get(controls::Saturation);
+	if (saturation.has_value()) {
+		context.activeState.knobs.saturation = saturation;
+		LOG(IPAMtkIsp50Adjust, Debug) << "Setting saturation to " << saturation.value();
+	}
+}
+
+void Adjust::applySaturation(Matrix<float, 3, 3> &matrix, float saturation)
+{
+	/* https://en.wikipedia.org/wiki/YCbCr#ITU-R_BT.601_conversion */
+	const Matrix<float, 3, 3> rgb2ycbcr{
+		{ 0.256788235294, 0.504129411765, 0.0979058823529,
+		  -0.148223529412, -0.290992156863, 0.439215686275,
+		  0.439215686275, -0.367788235294, -0.0714274509804 }
+	};
+	const Matrix<float, 3, 3> ycbcr2rgb{
+		{ 1.16438356164, 0, 1.59602678571,
+		  1.16438356164, -0.391762290094, -0.812967647235,
+		  1.16438356164, 2.01723214285, 0 }
+	};
+	const Matrix<float, 3, 3> saturationMatrix{
+		{ 1, 0, 0,
+		  0, saturation, 0,
+		  0, 0, saturation }
+	};
+	matrix =
+		ycbcr2rgb * saturationMatrix * rgb2ycbcr * matrix;
+}
+
+void Adjust::prepare(IPAContext &context,
+		     [[maybe_unused]] const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     DipFrameParams *params)
+{
+	frameContext.gamma = context.activeState.knobs.gamma;
+	frameContext.contrast = context.activeState.knobs.contrast;
+
+	/* The Saturation control, else the default of the tuning */
+	std::optional<float> saturation = context.activeState.knobs.saturation;
+	if (!saturation)
+		saturation = curveSaturation(context);
+	if (context.ccmEnabled && saturation) {
+		applySaturation(context.activeState.combinedMatrix, saturation.value());
+		frameContext.saturation = saturation;
+	}
+
+	params->gamma = 1.0 / context.activeState.knobs.gamma;
+	const float contrast = context.activeState.knobs.contrast.value_or(kDefaultContrast);
+	params->contrastExp = tan(std::clamp(contrast * M_PI_4, 0.0, M_PI_2 - 0.00001));
+}
+
+void Adjust::process([[maybe_unused]] IPAContext &context,
+		     [[maybe_unused]] const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     [[maybe_unused]] const Statistics *stats,
+		     ControlList &metadata)
+{
+	const auto &gamma = frameContext.gamma;
+	metadata.set(controls::Gamma, gamma);
+
+	const auto &contrast = frameContext.contrast;
+	metadata.set(controls::Contrast, contrast.value_or(kDefaultContrast));
+
+	const auto &saturation = frameContext.saturation;
+	metadata.set(controls::Saturation, saturation.value_or(kDefaultSaturation));
+}
+
+REGISTER_IPA_ALGORITHM(Adjust, "Adjust")
+
+} /* namespace ipa::mtkisp50::algorithms */
+
+} /* namespace libcamera */
