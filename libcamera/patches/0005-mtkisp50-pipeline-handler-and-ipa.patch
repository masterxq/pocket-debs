+
+	int compare(const SwIspStats &a, const ipa::mtkisp50::Statistics &b, uint32_t frame)
+	{
+		std::ostringstream err;
+
+		if (a.valid != b.valid)
+			err << "valid " << a.valid << "/" << b.valid;
+
+		if (a.valid && b.valid) {
+			if (a.frame != b.frame || !(a.sum_ == b.sum_))
+				err << " sums " << a.sum_ << "/" << b.sum_;
+			for (unsigned int j = 0; j < SwIspStats::kZones * SwIspStats::kZones; j++) {
+				if (!(a.zoneSum[j] == b.zoneSum[j]) || a.zoneCount[j] != b.zoneCount[j]) {
+					err << " zone " << j << " " << a.zoneSum[j] << "/" << b.zoneSum[j]
+					    << " count " << a.zoneCount[j] << "/" << b.zoneCount[j];
+					break;
+				}
+			}
+			for (unsigned int j = 0; j < SwIspStats::kYHistogramSize; j++) {
+				if (a.yHistogram[j] != b.yHistogram[j]) {
+					err << " histogram bin " << j;
+					break;
+				}
+			}
+		}
+
+		if (a.afGridValid != b.afGridValid)
+			err << " afGridValid " << a.afGridValid << "/" << b.afGridValid;
+
+		if (a.afGridValid && b.afGridValid) {
+			if (a.afGridWidth != b.afGridWidth || a.afGridHeight != b.afGridHeight ||
+			    a.afCellSize != b.afCellSize || a.afCellSamples != b.afCellSamples)
+				err << " grid geometry";
+			for (unsigned int j = 0; j < a.afGridWidth * a.afGridHeight; j++) {
+				if (a.afGrid[j] != b.afGrid[j]) {
+					err << " grid cell " << j;
+					break;
+				}
+			}
+		}
+
+		if (err.str().empty())
+			return TestPass;
+
+		std::cerr << "frame " << frame << ":" << err.str() << std::endl;
+		return TestFail;
+	}
+
+	int runSequence(const std::vector<Frame *> &frames, const Rectangle &window,
+			unsigned int count, unsigned int &compared)
+	{
+		StreamConfiguration cfg;
+		cfg.pixelFormat = formats::SBGGR10_MTISP;
+		cfg.size = frames[0]->size;
+		cfg.stride = frames[0]->stride;
+
+		SwStatsCpu oldStats(*cm_);
+		RawStatsCpu newStats;
+		if (oldStats.configure(cfg) || newStats.configure(cfg)) {
+			std::cerr << "configure failed" << std::endl;
+			return TestFail;
+		}
+		oldStats.setWindow(window);
+		newStats.setWindow(window);
+
+		const SwIspStats *shared = static_cast<const SwIspStats *>(
+			mmap(nullptr, sizeof(SwIspStats), PROT_READ, MAP_SHARED,
+			     oldStats.getStatsFD().get(), 0));
+		if (shared == MAP_FAILED)
+			return TestFail;
+
+		auto out = std::make_unique<mtkisp50::StatsBuffer>();
+		auto view = std::make_unique<ipa::mtkisp50::Statistics>();
+		auto oldView = std::make_unique<OldView>();
+		*view = {};
+
+		/* Settings as the IPA changes them: settled, focus search, regions */
+		const std::vector<Settings> schedule = {
+			{ 4, 1, false, 8, 0, { 0, 0, 16384, 16384 } },
+			{ 4, 0, false, 8, 0, {} },
+			{ 8, 2, false, 8, 0, { 0, 0, 16384, 16384 } },
+			{ 4, 1, true, 8, 1, { 30000, 20000, 9000, 9000 } },
+			{ 16, 0, false, 2, 0, {} },
+			{ 4, 1, true, 2, 1, { 2000, 50000, 12000, 8000 } },
+		};
+
+		int ret = TestPass;
+		for (unsigned int frame = 0; frame < count; frame++) {
+			const Settings &s = schedule[(frame / 5) % schedule.size()];
+			FrameBuffer *raw = frames[frame % frames.size()]->buffer.get();
+			MappedFrameBuffer map(raw, MappedFrameBuffer::MapFlag::Read);
+
+			oldStats.setSampling(s.linePairStep, 1);
+			oldStats.setInterval(s.interval, s.afInterval, s.afEveryFrame);
+			oldStats.setAfRegion(s.afRegionMode, s.afRegion);
+			newStats.setSampling(s.linePairStep, 1);
+			newStats.setInterval(s.interval, s.afInterval, s.afEveryFrame);
+			newStats.setAfRegion(s.afRegionMode, s.afRegion);
+
+			/* As the DIP backend of the software ISP called it */
+			if (!oldStats.wantsFrame(frame) && !s.afEveryFrame)
+				oldStats.finishFrame(frame, 0);
+			else
+				oldStats.processFrame(frame, 0, map);
+
+			if (!newStats.wantsFrame(frame) && !s.afEveryFrame)
+				newStats.finishFrame(frame, out.get());
+			else
+				newStats.processFrame(frame, map, out.get());
+
+			oldView->update(shared, frame);
+			if (!view->parse(*out, frame)) {
+				std::cerr << "frame " << frame << ": buffer not parsed" << std::endl;
+				ret = TestFail;
+				break;
+			}
+
+			if (compare(oldView->copy, *view, frame) != TestPass) {
+				ret = TestFail;
+				break;
+			}
+			compared++;
+		}
+
+		munmap(const_cast<SwIspStats *>(shared), sizeof(SwIspStats));
+		return ret;
+	}
+
+	int run() override
+	{
+		unsigned int compared = 0;
+
+		std::vector<Frame> synthetic;
+		for (unsigned int i = 0; i < 3; i++)
+			synthetic.push_back(syntheticFrame(Size(1152, 864), i));
+
+		std::vector<Frame *> frames;
+		for (Frame &f : synthetic)
+			frames.push_back(&f);
+
+		if (runSequence(frames, Rectangle(0, 0, 1152, 864), 60, compared) != TestPass)
+			return TestFail;
+		/* Window of a centred crop, as with a smaller output */
+		if (runSequence(frames, Rectangle(64, 52, 1024, 768), 60, compared) != TestPass)
+			return TestFail;
+
+		const char *env = std::getenv("MTKISP50_RAW");
+		if (env) {
+			std::vector<Frame> real;
+			std::istringstream list(env);
+			std::string spec;
+			while (std::getline(list, spec, ',')) {
+				real.push_back(fileFrame(spec));
+				if (!real.back().buffer) {
+					std::cerr << "cannot read " << spec << std::endl;
+					return TestFail;
+				}
+			}
+
+			std::vector<Frame *> realFrames;
+			for (Frame &f : real)
+				realFrames.push_back(&f);
+
+			const Size &size = real[0].size;
+			if (runSequence(realFrames, Rectangle(size), 60, compared) != TestPass)
+				return TestFail;
+
+			Rectangle crop(((size.width - size.width / 2) / 2) & ~3,
+				       ((size.height - size.height / 2) / 2) & ~1,
+				       size.width / 2, size.height / 2);
+			if (runSequence(realFrames, crop, 60, compared) != TestPass)
+				return TestFail;
+		}
+
+		std::cout << compared << " frames equal" << std::endl;
+		return TestPass;
+	}
+
+private:
+	std::unique_ptr<CameraManager> cm_;
+};
+
+TEST_REGISTER(MtkIsp50RawStatsTest)
