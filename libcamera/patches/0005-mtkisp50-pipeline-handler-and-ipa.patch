+/* Maximum number of frame contexts to be held */
+static constexpr uint32_t kMaxFrameContexts = 16;
+
+class IPAMtkIsp50 : public IPAMtkIsp50Interface, public Module
+{
+public:
+	IPAMtkIsp50()
+		: context_(kMaxFrameContexts)
+	{
+	}
+
+	int init(const IPASettings &settings,
+		 const IPACameraSensorInfo &sensorInfo,
+		 const ControlInfoMap &sensorControls,
+		 const ControlInfoMap &lensControls,
+		 ControlInfoMap *ipaControls) override;
+	int configure(const IPAConfigInfo &configInfo, ControlInfoMap *ipaControls) override;
+	void start(const ControlList &controls, StartResult *result) override;
+	void stop() override;
+
+	void mapBuffers(const std::vector<IPABuffer> &buffers) override;
+	void unmapBuffers(const std::vector<unsigned int> &ids) override;
+
+	void queueRequest(const uint32_t frame, const ControlList &controls) override;
+	void computeParams(const uint32_t frame, const uint32_t paramsBufferId,
+			   const UseCase jobUse) override;
+	void processStats(const uint32_t frame, const uint32_t statsBufferId,
+			  const ControlList &sensorControls) override;
+
+	void blendParams(const uint32_t frame, std::vector<uint8_t> *params) override;
+	void seriesCaptured() override;
+	void seriesEnd() override;
+	void seriesParams(const uint32_t baseParamsBufferId, const uint32_t blendParamsBufferId,
+			  uint32_t *baseBytesused, uint32_t *blendBytesused) override;
+
+protected:
+	std::string logPrefix() const override;
+
+private:
+	void resetParams();
+	void saveState();
+	void restoreState();
+	uint32_t encodeInto(uint32_t paramsBufferId);
+
+	/*
+	 * Multi-frame series: from the still image that starts it until
+	 * seriesEnd(). The frames of the series are processed with the
+	 * parameters of its first frame; while it is captured (until
+	 * seriesCaptured()) the sensor keeps the exposure and gain of that
+	 * frame and the lens does not move.
+	 */
+	struct Series {
+		bool active = false;
+		bool capturing = false;
+		double iso = 0.0;
+		DipFrameParams params;
+		int32_t exposure = 0;
+		double again = 0.0;
+	} series_;
+	bool multiFrame_ = false;
+
+	/* Parameters of the frames, kept from frame to frame as before */
+	DipFrameParams params_;
+	ParamsEncoder encoder_;
+	BayerFormat::Order bayerOrder_ = BayerFormat::BGGR;
+
+	Statistics stats_;
+
+	std::map<unsigned int, MappedFrameBuffer> buffers_;
+
+	/*
+	 * Statistics interval once exposure, white balance and focus have
+	 * settled, from the tuning file
+	 */
+	unsigned int statsIntervalSettled_ = Statistics::kFramesPerStats;
+	unsigned int statsLinePairStep_ = 0;
+	unsigned int statsBlockStep_ = 0;
+	unsigned int settledCount_ = 0;
+	RGB<float> lastGains_ = RGB<float>({ 0.0, 0.0, 0.0 });
+
+	/*
+	 * State carried over a new configuration of the same camera (mode
+	 * change), so that the first frames start close to where the
+	 * previous stream ended
+	 */
+	struct CarriedState {
+		bool valid = false;
+		utils::Duration exposureTime;
+		double again;
+		double digitalGain;
+		RGB<float> awbGains;
+		unsigned int temperatureK;
+		bool lensValid;
+	} carried_;
+	bool startControls_ = false;
+	bool configured_ = false;
+
+	std::unique_ptr<CameraSensorHelper> camHelper_;
+	ControlInfoMap sensorInfoMap_;
+
+	/* Local parameter storage */
+	struct IPAContext context_;
+};
+
+int IPAMtkIsp50::init(const IPASettings &settings,
+		      const IPACameraSensorInfo &sensorInfo,
+		      const ControlInfoMap &sensorControls,
+		      const ControlInfoMap &lensControls,
+		      ControlInfoMap *ipaControls)
+{
+	camHelper_ = CameraSensorHelperFactoryBase::create(settings.sensorModel);
+	if (!camHelper_) {
+		LOG(IPAMtkIsp50, Warning)
+			<< "Failed to create camera sensor helper for "
+			<< settings.sensorModel;
+	}
+
+	context_.sensorInfo = sensorInfo;
+	context_.lensControls = lensControls;
+
+	/* Load the tuning data file */
+	File file(settings.configurationFile);
+	if (!file.open(File::OpenModeFlag::ReadOnly)) {
+		int ret = file.error();
+		LOG(IPAMtkIsp50, Error)
+			<< "Failed to open configuration file "
+			<< settings.configurationFile << ": " << strerror(-ret);
+		return ret;
+	}
+
+	std::unique_ptr<ValueNode> data = YamlParser::parse(file);
+	if (!data)
+		return -EINVAL;
+
+	unsigned int version = (*data)["version"].get<uint32_t>(0);
+	LOG(IPAMtkIsp50, Debug) << "Tuning file version " << version;
+
+	if (!data->contains("algorithms")) {
+		LOG(IPAMtkIsp50, Error) << "Tuning file doesn't contain algorithms";
+		return -EINVAL;
+	}
+
+	/*
+	 * The calibration of the single camera module over the reference
+	 * values; values of it the algorithms refuse leave the tuning alone.
+	 */
+	const UnitTuning unit = UnitTuning::apply(*data, UnitTuning::file(settings.sensorModel));
+
+	int ret = createAlgorithms(context_, (*data)["algorithms"]);
+	if (ret && unit.status == UnitTuning::Status::Applied) {
+		LOG(IPAMtkIsp50, Warning)
+			<< "Algorithms refuse the unit calibration, tuning alone";
+		file.seek(0);
+		data = YamlParser::parse(file);
+		if (!data)
+			return -EINVAL;
+		ret = createAlgorithms(context_, (*data)["algorithms"]);
+	}
+	if (ret)
+		return ret;
+
+	/*
+	 * Sampling of the statistics: every intervalSettled frames once
+	 * exposure, white balance and focus are steady, else every
+	 * kFramesPerStats frames; line pair and block steps (0: pipeline
+	 * default).
+	 */
+	const ValueNode &statistics = (*data)["statistics"];
+	statsIntervalSettled_ = std::clamp(statistics["intervalSettled"].get<unsigned int>(Statistics::kFramesPerStats),
+					   Statistics::kFramesPerStats, 64u);
+	statsIntervalSettled_ -= statsIntervalSettled_ % Statistics::kFramesPerStats;
+	statsLinePairStep_ = std::min(statistics["linePairStep"].get<unsigned int>(0), 64u);
+	statsBlockStep_ = std::min(statistics["blockStep"].get<unsigned int>(0), 64u);
+	if (statistics)
+		LOG(IPAMtkIsp50, Info)
+			<< "Statistics every " << statsIntervalSettled_ << " frames when settled, steps "
+			<< statsLinePairStep_ << "/" << statsBlockStep_ << " (0: pipeline default)";
+
+	/* DIP tuning collected by the ToneCurve, Lsc and Quality algorithms */
+	encoder_.setToneCurve(context_.dip.toneCurve);
+	encoder_.setShadowLift(context_.dip.shadowLift);
+	encoder_.setLensShading(context_.dip.lensShading);
+	encoder_.setQuality(context_.dip.quality);
+
+	resetParams();
+
+	/*
+	 * Ranges of the manual exposure controls for the sensor mode of the
+	 * moment, before the first configuration; configure() updates them.
+	 */
+	const auto expIt = sensorControls.find(V4L2_CID_EXPOSURE);
+	const auto gainIt = sensorControls.find(V4L2_CID_ANALOGUE_GAIN);
+	if (sensorInfo.pixelRate && expIt != sensorControls.end() && gainIt != sensorControls.end() &&
+	    context_.ctrlMap.count(&controls::ExposureTime)) {
+		const utils::Duration line = sensorInfo.minLineLength * 1.0s / sensorInfo.pixelRate;
+		const int32_t minUs = static_cast<int32_t>(
+			utils::Duration(line * std::max(expIt->second.min().get<int32_t>(), 1)).get<std::micro>());
+		const int32_t maxUs = static_cast<int32_t>(
+			utils::Duration(line * expIt->second.max().get<int32_t>()).get<std::micro>());
+		context_.ctrlMap[&controls::ExposureTime] =
+			ControlInfo(minUs, maxUs, std::clamp(10000, minUs, maxUs));
+		if (camHelper_)
+			context_.ctrlMap[&controls::AnalogueGain] =
+				ControlInfo(static_cast<float>(camHelper_->gain(gainIt->second.min().get<int32_t>())),
+					    static_cast<float>(camHelper_->gain(gainIt->second.max().get<int32_t>())),
+					    1.0f);
+	}
+
+	ControlInfoMap::Map ctrlMap = context_.ctrlMap;
+	*ipaControls = ControlInfoMap(std::move(ctrlMap), controls::controls);
+
+	/*
+	 * Check if the sensor driver supports the controls required by the
+	 * IPA. Don't save the min and max control values yet, as e.g. the
+	 * limits for V4L2_CID_EXPOSURE depend on the configured sensor mode.
+	 */
+	if (sensorControls.find(V4L2_CID_EXPOSURE) == sensorControls.end()) {
+		LOG(IPAMtkIsp50, Error) << "Don't have exposure control";
+		return -EINVAL;
+	}
+
+	if (sensorControls.find(V4L2_CID_ANALOGUE_GAIN) == sensorControls.end()) {
+		LOG(IPAMtkIsp50, Error) << "Don't have gain control";
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+/* Initial parameters, as the software ISP set them up */
+void IPAMtkIsp50::resetParams()
+{
+	params_ = {};
+	params_.blackLevel = { { 0.0, 0.0, 0.0 } };
+	params_.gamma = 1.0 / algorithms::kDefaultGamma;
+	params_.contrastExp = 1.0;
+	params_.gains = { { 1.0, 1.0, 1.0 } };
+}
+
+void IPAMtkIsp50::saveState()
+{
+	const IPAActiveState &state = context_.activeState;
+
+	carried_.valid = state.agc.valid;
+	if (!carried_.valid)
+		return;
+
+	carried_.exposureTime = context_.configuration.agc.lineDuration * state.agc.exposure;
+	carried_.again = state.agc.again;
+	carried_.digitalGain = state.agc.digitalGain;
+	carried_.awbGains = state.awb.gains;
+	carried_.temperatureK = state.awb.temperatureK;
+	carried_.lensValid = !context_.lensControls.empty();
+}
+
+/*
+ * After a new configuration of the same camera: start from the exposure,
+ * white balance and lens position the previous stream ended with. The
+ * exposure keeps its time over a change of the line duration.
+ */
+void IPAMtkIsp50::restoreState()
+{
+	startControls_ = false;
+	if (!carried_.valid)
+		return;
+
+	IPAActiveState &state = context_.activeState;
+	const auto &agc = context_.configuration.agc;
+
+	int32_t exposure = agc.lineDuration > 0s
+				   ? static_cast<int32_t>(std::lround(carried_.exposureTime / agc.lineDuration))
+				   : state.agc.exposure;
+	/*
+	 * Up to the longest exposure of the regulation in this mode (frame
+	 * length extension and frame durations of the application); the rest
+	 * goes over to the gain.
+	 */
+	const int32_t limit = std::max(state.agc.exposureLimit, agc.exposureMin);
+	double again = carried_.again;
+	if (exposure > limit) {
+		again *= static_cast<double>(exposure) / limit;
+		exposure = limit;
+	}
+	state.agc.exposure = std::max(exposure, agc.exposureMin);
+	state.agc.again = std::clamp(again, agc.againMin, agc.againMax);
+	state.agc.digitalGain = carried_.digitalGain;
+	state.agc.valid = true;
+	state.awb.gains = carried_.awbGains;
+	state.awb.temperatureK = carried_.temperatureK;
+	/* The Af algorithm keeps the lens position itself */
+
+	startControls_ = true;
+
+	LOG(IPAMtkIsp50, Debug)
+		<< "Carried over: exposure " << state.agc.exposure << " lines, gain "
+		<< state.agc.again << ", gains " << state.awb.gains;
+}
+
+int IPAMtkIsp50::configure(const IPAConfigInfo &configInfo, ControlInfoMap *ipaControls)
+{
+	sensorInfoMap_ = configInfo.sensorControls;
+	context_.sensorInfo = configInfo.sensorInfo;
+
+	const ControlInfo &exposureInfo = sensorInfoMap_.find(V4L2_CID_EXPOSURE)->second;
+	const ControlInfo &gainInfo = sensorInfoMap_.find(V4L2_CID_ANALOGUE_GAIN)->second;
+
+	/* The state of the previous configuration goes over a mode change */
+	if (configured_)
+		saveState();
+	configured_ = true;
+
+	/* Clear the IPA context before the streaming session. */
+	context_.configuration = {};
+	context_.activeState = {};
+	context_.frameContexts.clear();
+
+	context_.configuration.rawSize = configInfo.rawSize;
+	context_.configuration.statsWindow = configInfo.ispCrop;
+	context_.configuration.agc.lineDuration =
+		context_.sensorInfo.minLineLength * 1.0s / context_.sensorInfo.pixelRate;
+	context_.configuration.agc.exposureMin = exposureInfo.min().get<int32_t>();
+	context_.configuration.agc.exposureMax = exposureInfo.max().get<int32_t>();
+	if (!context_.configuration.agc.exposureMin) {
+		LOG(IPAMtkIsp50, Warning) << "Minimum exposure is zero, that can't be linear";
+		context_.configuration.agc.exposureMin = 1;
+	}
+
+	int32_t againMin = gainInfo.min().get<int32_t>();
+	int32_t againMax = gainInfo.max().get<int32_t>();
+	int32_t againDef = gainInfo.def().get<int32_t>();
+
+	if (camHelper_) {
+		context_.configuration.agc.againMin = camHelper_->gain(againMin);
+		context_.configuration.agc.againMax = camHelper_->gain(againMax);
+		context_.configuration.agc.again10 = std::max(context_.configuration.agc.againMin, 1.0);
+		context_.configuration.agc.againMinStep =
+			(context_.configuration.agc.againMax -
+			 context_.configuration.agc.againMin) /
+			100.0;
+		if (camHelper_->blackLevel().has_value()) {
+			/*
+			 * The black level from camHelper_ is a 16 bit value,
+			 * the algorithms use 8 bit values.
+			 */
+			context_.configuration.black.level =
+				camHelper_->blackLevel().value() / 256;
+		}
+	} else {
+		context_.configuration.agc.againMax = againMax;
+		context_.configuration.agc.again10 = againDef;
+		context_.configuration.agc.againMin = againMin;
+		context_.configuration.agc.againMinStep = 1.0;
+	}
+
+	for (const auto &algo : algorithms()) {
+		int ret = algo->configure(context_, configInfo);
+		if (ret)
+			return ret;
+	}
+
+	restoreState();
+
+	bayerOrder_ = static_cast<BayerFormat::Order>(configInfo.bayerOrder);
+	multiFrame_ = configInfo.multiFrame && context_.dip.multiFrame && context_.dip.quality;
+	series_ = {};
+
+	/* All blocks again with the first parameters of the stream */
+	encoder_.setTemporalNr(driverHasTemporalNr(configInfo.paramsBufferSize));
+	encoder_.reset();
+
+	ControlInfoMap::Map ctrlMap = context_.ctrlMap;
+	*ipaControls = ControlInfoMap(std::move(ctrlMap), controls::controls);
+
+	LOG(IPAMtkIsp50, Info)
+		<< "Exposure " << context_.configuration.agc.exposureMin << "-"
+		<< context_.configuration.agc.exposureMax
+		<< ", gain " << context_.configuration.agc.againMin << "-"
+		<< context_.configuration.agc.againMax
+		<< " (" << context_.configuration.agc.againMinStep << ")"
+		<< ", use case " << static_cast<int>(configInfo.useCase);
+
+	return 0;
+}
+
+void IPAMtkIsp50::start(const ControlList &controls, StartResult *result)
+{
+	/*
+	 * The controls of the start act as those of a first request (frame
+	 * durations, modes); they stay for the following frames.
+	 */
+	if (!controls.empty()) {
+		IPAFrameContext startContext{};
+		for (const auto &algo : algorithms())
+			algo->queueRequest(context_, 0, startContext, controls);
+	}
+
+	settledCount_ = 0;
+	lastGains_ = RGB<float>({ 0.0, 0.0, 0.0 });
+	encoder_.reset();
+	resetParams();
+
+	result->ret = 0;
+	result->sensorControls = ControlList(sensorInfoMap_);
+	result->lensControls = ControlList(context_.lensControls);
+
+	if (!startControls_)
+		return;
+
+	const IPAActiveState &state = context_.activeState;
+	result->sensorControls.set(V4L2_CID_EXPOSURE, state.agc.exposure);
+	const auto &agc = context_.configuration.agc;
+	if (agc.vblankEnabled)
+		result->sensorControls.set(V4L2_CID_VBLANK,
+					   agc.frame.vblankFor(state.agc.exposure,
+							       state.agc.minFrameLines));
+	result->sensorControls.set(V4L2_CID_ANALOGUE_GAIN,
+				   static_cast<int32_t>(camHelper_ ? camHelper_->gainCode(state.agc.again)
+								   : state.agc.again));
+	if (carried_.lensValid && state.af.lensPosition)
+		result->lensControls.set(V4L2_CID_FOCUS_ABSOLUTE, state.af.lensPosition);
+}
+
+void IPAMtkIsp50::stop()
+{
+	context_.frameContexts.clear();
+	series_ = {};
+}
+
+void IPAMtkIsp50::mapBuffers(const std::vector<IPABuffer> &buffers)
+{
+	for (const IPABuffer &buffer : buffers) {
+		const FrameBuffer fb(buffer.planes);
+		buffers_.emplace(buffer.id,
+				 MappedFrameBuffer(&fb, MappedFrameBuffer::MapFlag::ReadWrite));
+	}
+}
+
+void IPAMtkIsp50::unmapBuffers(const std::vector<unsigned int> &ids)
+{
+	for (unsigned int id : ids)
+		buffers_.erase(id);
+}
+
+void IPAMtkIsp50::queueRequest(const uint32_t frame, const ControlList &controls)
+{
+	IPAFrameContext &frameContext = context_.frameContexts.alloc(frame);
+
+	for (const auto &algo : algorithms())
+		algo->queueRequest(context_, frame, frameContext, controls);
+}
+
+void IPAMtkIsp50::computeParams(const uint32_t frame, const uint32_t paramsBufferId,
+				const UseCase jobUse)
+{
+	context_.activeState.combinedMatrix = Matrix<float, 3, 3>::identity();
+
+	IPAFrameContext &frameContext = context_.frameContexts.get(frame);
+
+	const bool seriesJob = jobUse == UseCase::StillSeries || jobUse == UseCase::SeriesFrame;
+	/* Frames of a series are still image frames for the algorithms */
+
+	/* Without the Af algorithm (or with it idle) no focus grid, no PD */
+	params_.afStatsInterval = 0;
+	params_.pd = false;
+	params_.statsInterval = settledCount_ >= 2 ? statsIntervalSettled_
+						    : Statistics::kFramesPerStats;
+	params_.statsLinePairStep = statsLinePairStep_;
+	params_.statsBlockStep = statsBlockStep_;
+	params_.useCase = static_cast<uint8_t>(seriesJob ? UseCase::Still : jobUse);
+	params_.mix.reset();
+	params_.mixOff = false;
+	for (const auto &algo : algorithms())
+		algo->prepare(context_, frame, frameContext, &params_);
+	params_.combinedMatrix = context_.activeState.combinedMatrix;
+
+	/*
+	 * A still image that may start a series: the frames from the tuning
+	 * for its sensitivity. The series is processed with the parameters
+	 * of this frame and the set of the raw frames of a series.
+	 */
+	uint32_t seriesFrames = 0;
+	if (jobUse == UseCase::StillSeries && multiFrame_ && frameContext.multiFrame &&
+	    !series_.active) {
+		const double iso = context_.dip.quality->isoPerGain() *
+				   std::max(params_.totalGain, 1e-3f);
+		seriesFrames = context_.dip.multiFrame->frames(iso);
+		if (seriesFrames >= 2) {
+			series_.active = true;
+			series_.capturing = true;
+			series_.iso = iso;
+			series_.params = params_;
+			series_.params.useCase = QualityTable::MultiFrameInput;
+			series_.params.nr3d.reset();
+			series_.exposure = context_.activeState.agc.exposure;
+			series_.again = context_.activeState.agc.again;
+			LOG(IPAMtkIsp50, Info)
+				<< "Frame " << frame << ": series of " << seriesFrames
+				<< " frames at ISO " << static_cast<int>(iso);
+		} else {
+			seriesFrames = 0;
+		}
+	}
+
+	if (series_.active && (seriesFrames || jobUse == UseCase::SeriesFrame)) {
+		/* Same processing for every frame of the series */
+		const DipFrameParams keep = params_;
+		params_ = series_.params;
+		params_.statsInterval = keep.statsInterval;
+		params_.statsLinePairStep = keep.statsLinePairStep;
+		params_.statsBlockStep = keep.statsBlockStep;
+		params_.afStatsInterval = keep.afStatsInterval;
+		params_.afEveryFrame = keep.afEveryFrame;
+		params_.afRegionMode = keep.afRegionMode;
+		params_.afRegion = keep.afRegion;
+		params_.pd = keep.pd;
+		params_.pdRegion = keep.pdRegion;
+		params_.pdGridWidth = keep.pdGridWidth;
+		params_.pdGridHeight = keep.pdGridHeight;
+		params_.pdMaxShift = keep.pdMaxShift;
+		params_.pdBlackLevel = keep.pdBlackLevel;
+	}
+
+	const uint32_t bytesused = encodeInto(paramsBufferId);
+
+	StatsConfig config;
+	config.interval = params_.statsInterval;
+	config.linePairStep = params_.statsLinePairStep;
+	config.blockStep = params_.statsBlockStep;
+	config.afInterval = params_.afStatsInterval;
+	config.afEveryFrame = params_.afEveryFrame;
+	config.afRegionMode = params_.afRegionMode;
+	config.afRegion.assign(params_.afRegion.begin(), params_.afRegion.end());
+	config.pd = params_.pd;
+	config.pdRegion.assign(params_.pdRegion.begin(), params_.pdRegion.end());
+	config.pdGridWidth = params_.pdGridWidth;
+	config.pdGridHeight = params_.pdGridHeight;
+	config.pdMaxShift = params_.pdMaxShift;
+	config.pdBlackLevel = params_.pdBlackLevel;
+
+	paramsComputed.emit(frame, bytesused, config, seriesFrames);
+}
+
+/* Encode params_ into a params buffer, the bytes used (0: nothing to queue) */
+uint32_t IPAMtkIsp50::encodeInto(uint32_t paramsBufferId)
+{
+	auto it = buffers_.find(paramsBufferId);
+	if (it == buffers_.end()) {
+		LOG(IPAMtkIsp50, Error) << "Unknown parameters buffer " << paramsBufferId;
+		return 0;
+	}
+
+	const uint32_t bytesused = encoder_.encode(params_, bayerOrder_, it->second.planes()[0]);
+	if (bytesused)
+		encoder_.commit();
+
+	return bytesused;
+}
+
+/**
+ * \brief Parameters of the multi-frame blending block for the series
+ * \param[in] frame The frame of the still image of the series
+ * \param[out] params A params buffer of the block (struct
+ * v4l2_isp_params_buffer with the blend block), empty without a series
+ */
+void IPAMtkIsp50::blendParams([[maybe_unused]] const uint32_t frame, std::vector<uint8_t> *params)
+{
+	params->clear();
+	if (!series_.active)
+		return;
+
+	const auto &words = context_.dip.multiFrame->blend(series_.iso);
+
+	struct mtk_mfb_params_blend blend = {};
+	blend.header.type = MTK_MFB_PARAMS_BLOCK_BLEND;
+	blend.header.size = sizeof(blend);
+	blend.ll_con1 = words[0];
+	blend.ll_con2 = words[1];
+	for (unsigned int i = 0; i < MTK_MFB_MBD_CON_WORDS; i++)
+		blend.mbd_con[i] = words[2 + i];
+
+	struct v4l2_isp_params_buffer head = {};
+	head.version = MTK_MFB_PARAMS_VERSION_V1;
+	head.data_size = sizeof(blend);
+
+	static_assert(sizeof(head) + sizeof(blend) <= MTK_MFB_PARAMS_MAX_SIZE);
+	params->resize(sizeof(head) + sizeof(blend));
+	memcpy(params->data(), &head, sizeof(head));
+	memcpy(params->data() + sizeof(head), &blend, sizeof(blend));
+}
+
+/**
+ * \brief The raw frames of the series are captured
+ *
+ * Exposure, white balance and focus follow the scene again.
+ */
+void IPAMtkIsp50::seriesCaptured()
+{
+	series_.capturing = false;
+}
+
+/**
+ * \brief Parameters of the two ISP jobs of a series
+ * \param[in] baseParamsBufferId Buffer for the noise reduction of the base frame
+ * \param[in] blendParamsBufferId Buffer for the blend job
+ * \param[out] baseBytesused Bytes used in the first buffer
+ * \param[out] blendBytesused Bytes used in the second buffer
+ *
+ * The jobs follow each other in the ISP, after all jobs whose parameters were
+ * computed before (the handler holds new frames back until then): both go
+ * through the encoder like the parameters of any other job. seriesEnd()
+ * follows.
+ */
+void IPAMtkIsp50::seriesParams(const uint32_t baseParamsBufferId,
+			       const uint32_t blendParamsBufferId,
+			       uint32_t *baseBytesused, uint32_t *blendBytesused)
+{
+	*baseBytesused = 0;
+	*blendBytesused = 0;
+	if (!series_.active)
+		return;
+
+	const DipFrameParams keep = params_;
+
+	/* Noise reduction of the base frame: the set of a single frame, no blend */
+	params_ = series_.params;
+	params_.useCase = QualityTable::MultiFrameBase;
+	params_.mixOff = true;
+	*baseBytesused = encodeInto(baseParamsBufferId);
+
+	/* The blend with the base frame over the weight map */
+	params_.useCase = QualityTable::MultiFrameOutput;
+	params_.mixOff = false;
+	params_.mix = context_.dip.multiFrame->mix(series_.iso);
+	*blendBytesused = encodeInto(blendParamsBufferId);
+
+	params_ = keep;
+	params_.mix.reset();
+	params_.mixOff = false;
+}
+
+/**
+ * \brief The series ended, with or without its ISP jobs
+ *
+ * Exposure, white balance and focus are free again, the next still image may
+ * start a series.
+ */
+void IPAMtkIsp50::seriesEnd()
+{
+	series_ = {};
+}
+
+void IPAMtkIsp50::processStats(const uint32_t frame, const uint32_t statsBufferId,
+			       const ControlList &sensorControls)
+{
+	IPAFrameContext &frameContext = context_.frameContexts.get(frame);
+
+	/*
+	 * Software ISP stats are valid only for some frames: the values of
+	 * the sensor controls of this frame are in sensorControls.
+	 */
+	const ControlValue &exposure = sensorControls.get(V4L2_CID_EXPOSURE);
+	const ControlValue &gain = sensorControls.get(V4L2_CID_ANALOGUE_GAIN);
+	if (exposure.type() == ControlTypeInteger32 && gain.type() == ControlTypeInteger32) {
+		frameContext.sensor.exposure = exposure.get<int32_t>();
+		int32_t again = gain.get<int32_t>();
+		frameContext.sensor.gain = camHelper_ ? camHelper_->gain(again) : again;
+	} else {
+		LOG(IPAMtkIsp50, Error)
+			<< "Frame " << frame << ": sensor controls missing or of the wrong type"
+			<< " (exposure type " << static_cast<int>(exposure.type())
+			<< ", gain type " << static_cast<int>(gain.type()) << "), keeping the last values";
+		frameContext.sensor.exposure = context_.activeState.agc.exposure;
+		frameContext.sensor.gain = context_.activeState.agc.again;
+	}
+
+	auto it = buffers_.find(statsBufferId);
+	if (it != buffers_.end() &&
+	    it->second.planes()[0].size() >= sizeof(libcamera::mtkisp50::StatsBuffer)) {
+		const auto *buffer = reinterpret_cast<const libcamera::mtkisp50::StatsBuffer *>(
+			it->second.planes()[0].data());
+		stats_.parse(*buffer, frame);
+	} else {
+		LOG(IPAMtkIsp50, Error) << "Unknown statistics buffer " << statsBufferId;
+		stats_.valid = false;
+		stats_.afGridValid = false;
+	}
+
+	ControlList metadata(controls::controls);
+	for (const auto &algo : algorithms())
+		algo->process(context_, frame, frameContext, &stats_, metadata);
+	metadataReady.emit(frame, metadata);
+
+	/*
+	 * Settled when exposure, white balance (gains within 2 %) and focus
+	 * are steady: then statistics on a longer interval.
+	 */
+	if (stats_.valid) {
+		const auto &agc = context_.activeState.agc;
+		const RGB<float> &gains = context_.activeState.awb.gains;
+		bool awbSteady = true;
+		for (unsigned int c = 0; c < 3; c++) {
+			if (!(lastGains_[c] > 0.0f) ||
+			    std::abs(gains[c] / lastGains_[c] - 1.0f) > 0.02f)
+				awbSteady = false;
+		}
+		lastGains_ = gains;
+
+		const bool settled = agc.valid && !agc.converging && awbSteady &&
+				     !context_.activeState.af.busy;
+		settledCount_ = settled ? settledCount_ + 1 : 0;
+	}
+
+	/* Sanity check */
+	if (!sensorControls.contains(V4L2_CID_EXPOSURE) ||
+	    !sensorControls.contains(V4L2_CID_ANALOGUE_GAIN)) {
+		LOG(IPAMtkIsp50, Error) << "Control(s) missing";
+		return;
+	}
+
+	ControlList ctrls(sensorInfoMap_);
+
+	/* The series keeps the exposure of its first frame, the lens stays */
+	if (series_.capturing) {
+		frameContext.sensor.exposure = series_.exposure;
+		frameContext.sensor.gain = series_.again;
+	}
+
+	auto &againNew = frameContext.sensor.gain;
+	ctrls.set(V4L2_CID_EXPOSURE, frameContext.sensor.exposure);
+	ctrls.set(V4L2_CID_ANALOGUE_GAIN,
+		  static_cast<int32_t>(camHelper_ ? camHelper_->gainCode(againNew) : againNew));
+
+	const auto &agc = context_.configuration.agc;
+	if (agc.vblankEnabled)
+		/* Raise the frame length with the exposure */
+		ctrls.set(V4L2_CID_VBLANK,
+			  agc.frame.vblankFor(frameContext.sensor.exposure,
+					      context_.activeState.agc.minFrameLines));
+
+	ControlList lensCtrls(context_.lensControls);
+	if (context_.activeState.af.update && !series_.capturing) {
+		lensCtrls.set(V4L2_CID_FOCUS_ABSOLUTE,
+			      context_.activeState.af.lensPosition);
+		context_.activeState.af.update = false;
+	}
+
+	setSensorControls.emit(frame, ctrls, lensCtrls);
+}
+
+std::string IPAMtkIsp50::logPrefix() const
+{
+	return "IPAMtkIsp50";
+}
+
+} /* namespace ipa::mtkisp50 */
+
+/*
+ * External IPA module interface
+ */
+extern "C" {
+const struct IPAModuleInfo ipaModuleInfo = {
+	IPA_MODULE_API_VERSION,
+	0,
+	"mtkisp50",
+	"mtkisp50",
+};
+
+IPAInterface *ipaCreate()
+{
+	return new ipa::mtkisp50::IPAMtkIsp50();
+}
+
+} /* extern "C" */
+
+} /* namespace libcamera */
diff --git a/src/ipa/mtkisp50/statistics.cpp b/src/ipa/mtkisp50/statistics.cpp
new file mode 100644
index 0000000..8010472
--- /dev/null
+++ b/src/ipa/mtkisp50/statistics.cpp
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Statistics of a frame as the mtkisp50 algorithms see them
+ */
+
+#include "statistics.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPAMtkIsp50Stats)
+
+namespace ipa::mtkisp50 {
+
+using libcamera::mtkisp50::StatsBuffer;
+
+namespace {
+
+/* Sum of a cell back from its mean and count, before the 8 bit shift */
+uint64_t cellSum(const libcamera::mtkisp50::StatsCell &cell, unsigned int c)
+{
+	return static_cast<uint64_t>(std::llround(cell.mean[c] * cell.count));
+}
+
+} /* namespace */
+
+bool Statistics::parse(const StatsBuffer &buffer, uint32_t frameId)
+{
+	valid = false;
+	afGridValid = false;
+	pdValid = false;
+
+	if (buffer.version != StatsBuffer::kVersion || buffer.frame != frameId) {
+		LOG(IPAMtkIsp50Stats, Warning)
+			<< "Statistics buffer of frame " << buffer.frame
+			<< " (version " << buffer.version << ") for frame " << frame;
+		return false;
+	}
+
+	const bool cells = buffer.valid & libcamera::mtkisp50::StatsValidCells;
+	const bool af = buffer.valid & libcamera::mtkisp50::StatsValidAf;
+
+	if (buffer.skipped)
+		skippedFrame = frameId;
+
+	if (cells) {
+		if (buffer.gridWidth != kZones || buffer.gridHeight != kZones ||
+		    buffer.bitDepth < 8) {
+			LOG(IPAMtkIsp50Stats, Error)
+				<< "Unsupported statistics grid " << buffer.gridWidth
+				<< "x" << buffer.gridHeight << " at " << buffer.bitDepth << " bits";
+			return false;
+		}
+
+		const unsigned int shift = buffer.bitDepth - 8;
+		RGB<uint64_t> total({ 0, 0, 0 });
+
+		for (unsigned int j = 0; j < kZones * kZones; j++) {
+			const auto &cell = buffer.cells[j];
+			RGB<uint64_t> sum({ cellSum(cell, 0), cellSum(cell, 1), cellSum(cell, 2) });
+
+			total += sum;
+			zoneSum[j] = RGB<uint64_t>({ sum.r() >> shift, sum.g() >> shift,
+						     sum.b() >> shift });
+			zoneCount[j] = cell.count;
+		}
+
+		sum_ = RGB<uint64_t>({ total.r() >> shift, total.g() >> shift,
+				       total.b() >> shift });
+
+		yHistogram.fill(0);
+		for (unsigned int i = 0; i < std::min<unsigned int>(buffer.histogramCount,
+								    StatsBuffer::kMaxHistograms); i++) {
+			const auto &hist = buffer.histograms[i];
+			if (hist.type != libcamera::mtkisp50::StatsHistogramLumaBt601 ||
+			    hist.bins != kYHistogramSize)
+				continue;
+			std::copy_n(hist.data, kYHistogramSize, yHistogram.begin());
+			break;
+		}
+
+		frame = frameId;
+		valid = true;
+	}
+
+	/*
+	 * The grid goes with the frames with statistics, gathered or not, and
+	 * with the frames that gathered it alone.
+	 */
+	if ((cells || af) && buffer.afWidth && buffer.afHeight) {
+		const unsigned int count = std::min<unsigned int>(buffer.afWidth * buffer.afHeight,
+								  afGrid.size());
+
+		afGridWidth = buffer.afWidth;
+		afGridHeight = buffer.afHeight;
+		afCellSize = buffer.afBlockSize;
+		afCellSamples = buffer.afBlockSamples;
+		for (unsigned int j = 0; j < count; j++)
+			afGrid[j] = buffer.af[j].level;
+		afGridFrame = frameId;
+		afGridValid = af && buffer.afMeasure == libcamera::mtkisp50::StatsAfLevelSum;
+	}
+
+	/* Phase detection: belongs to this frame only */
+	if ((buffer.valid & libcamera::mtkisp50::StatsValidPd) && buffer.pdGridWidth &&
+	    buffer.pdGridHeight &&
+	    buffer.pdGridWidth * buffer.pdGridHeight <= StatsBuffer::kMaxPdWindows) {
+		auto view = [](const libcamera::mtkisp50::StatsPdWindow &w) {
+			PdWindow v;
+			v.rect = Rectangle(w.x, w.y, w.width, w.height);
+			v.shift = w.shift;
+			v.confidence = w.confidence;
+			v.contrast = w.contrast;
+			v.saturation = w.saturation;
+			v.level = w.level;
+			return v;
+		};
+
+		pdGridWidth = buffer.pdGridWidth;
+		pdGridHeight = buffer.pdGridHeight;
+		for (unsigned int j = 0; j < pdGridWidth * pdGridHeight; j++)
+			pdWindows[j] = view(buffer.pd[j]);
+		pdRegion = view(buffer.pdRegion);
+		pdValid = true;
+	}
+
+	return true;
+}
+
+} /* namespace ipa::mtkisp50 */
+
+} /* namespace libcamera */
diff --git a/src/ipa/mtkisp50/statistics.h b/src/ipa/mtkisp50/statistics.h
new file mode 100644
index 0000000..1597590
--- /dev/null
+++ b/src/ipa/mtkisp50/statistics.h
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Statistics of a frame as the mtkisp50 algorithms see them
+ *
+ * The algorithms read this view only; parse() fills it from a statistics
+ * buffer (mtkisp50/stats.h) of any source. The fields keep the meaning of the
+ * CPU statistics the algorithms were tuned with: sums of the samples on an
+ * 8 bit scale over a 15x15 zone grid, a 64 bin luma histogram and a focus grid
+ * of green sums.
+ */
+
+#pragma once
+
+#include <array>
+#include <stdint.h>
+
+#include <libcamera/geometry.h>
+
+#include "libcamera/internal/mtkisp50/stats.h"
+#include "libcamera/internal/vector.h"
+
+namespace libcamera {
+
+namespace ipa::mtkisp50 {
+
+struct Statistics {
+	/* Statistics need a frame number that is a multiple of this */
+	static constexpr uint32_t kFramesPerStats = 4;
+
+	/* Statistics of this frame are valid */
+	bool valid;
+	/* Frame the statistics belong to */
+	uint32_t frame;
+	/* Sums of the colour channels of all sampled pixels, 8 bit scale */
+	RGB<uint64_t> sum_;
+
+	static constexpr unsigned int kZones = 15;
+	/* Sums and number of samples per zone, rows from the top */
+	std::array<RGB<uint64_t>, kZones * kZones> zoneSum;
+	std::array<uint32_t, kZones * kZones> zoneCount;
+
+	static constexpr unsigned int kYHistogramSize = 64;
+	using Histogram = std::array<uint32_t, kYHistogramSize>;
+	Histogram yHistogram;
+
+	/* Focus grid: green sums of square cells (8 bit scale) */
+	static constexpr unsigned int kAfGridMaxWidth = libcamera::mtkisp50::StatsBuffer::kMaxAfWidth;
+	static constexpr unsigned int kAfGridMaxHeight = 120;
+	unsigned int afGridWidth;
+	unsigned int afGridHeight;
+	bool afGridValid;
+	/* Frame without statistics on purpose (longer interval) */
+	uint32_t skippedFrame;
+	uint32_t afGridFrame;
+	unsigned int afCellSize;
+	unsigned int afCellSamples;
+	std::array<uint32_t, kAfGridMaxWidth * kAfGridMaxHeight> afGrid;
+
+	/*
+	 * Phase detection of this frame (pdValid): a grid of windows, rows
+	 * from the top, and all windows together. Shift in pixels of the
+	 * sensor output frame, confidence 0..100.
+	 */
+	struct PdWindow {
+		Rectangle rect;
+		double shift;
+		double confidence;
+		double contrast;
+		double saturation;
+		double level;
+	};
+	static constexpr unsigned int kPdMaxWindows = libcamera::mtkisp50::StatsBuffer::kMaxPdWindows;
+	bool pdValid = false;
+	unsigned int pdGridWidth = 0;
+	unsigned int pdGridHeight = 0;
+	std::array<PdWindow, kPdMaxWindows> pdWindows;
+	PdWindow pdRegion;
+
+	/*
+	 * Update the view with the buffer of a frame. Like the statistics of
+	 * the software ISP, fields of a part that is not valid for the frame
+	 * keep the values of the last frame that had it; valid and
+	 * afGridValid tell what belongs to this frame. Returns false if the
+	 * buffer is not usable (wrong version or frame).
+	 */
+	bool parse(const libcamera::mtkisp50::StatsBuffer &buffer, uint32_t frameId);
+};
+
+} /* namespace ipa::mtkisp50 */
+
+} /* namespace libcamera */
diff --git a/src/ipa/mtkisp50/temporal_nr.cpp b/src/ipa/mtkisp50/temporal_nr.cpp
new file mode 100644
index 0000000..85f05f6
--- /dev/null
+++ b/src/ipa/mtkisp50/temporal_nr.cpp
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * When the temporal noise reduction has to start a new reference
+ */
+
+#include "temporal_nr.h"
+
+#include <algorithm>
+#include <cmath>
+#include <stdlib.h>
+
+namespace libcamera {
+
+namespace ipa::mtkisp50 {
+
+/**
+ * \class TemporalNrRestart
+ * \brief Decide per job whether the temporal noise reduction starts anew
+ */
+
+/**
+ * \brief Forget the last state, for a new stream
+ *
+ * The first job of a stream has no reference in the driver, it needs no flag.
+ */
+void TemporalNrRestart::reset()
+{
+	last_.reset();
+	remaining_ = 0;
+}
+
+/**
+ * \brief Start a new reference with the next jobs
+ */
+void TemporalNrRestart::trigger()
+{
+	remaining_ = std::max(limits_.frames, 1u);
+}
+
+bool TemporalNrRestart::jumped(const State &state) const
+{
+	if (!last_)
+		return false;
+
+	if (state.exposure > 0.0 && last_->exposure > 0.0 &&
+	    std::abs(std::log2(state.exposure / last_->exposure)) > limits_.exposureStops)
+		return true;
+
+	for (unsigned int c = 0; c < 3; c++) {
+		const float a = last_->gains[c];
+		const float b = state.gains[c];
+		if (a > 0.0f && b > 0.0f && std::abs(b / a - 1.0f) > limits_.colourGain)
+			return true;
+	}
+
+	if (state.lensPosition && last_->lensPosition &&
+	    std::abs(*state.lensPosition - *last_->lensPosition) >= limits_.lensSteps)
+		return true;
+
+	return false;
+}
+
+/**
+ * \brief Take the state of the next job
+ * \param[in] state Exposure, colour gains and lens position for the job
+ *
+ * A change beyond the limits against the job before restarts this job and
+ * the following ones up to Limits::frames in all, a further change within
+ * them extends the run.
+ *
+ * \return True if the job starts a new reference
+ */
+bool TemporalNrRestart::update(const State &state)
+{
+	if (jumped(state))
+		trigger();
+	last_ = state;
+
+	if (!remaining_)
+		return false;
+
+	remaining_--;
+	return true;
+}
+
+} /* namespace ipa::mtkisp50 */
+
+} /* namespace libcamera */
diff --git a/src/ipa/mtkisp50/temporal_nr.h b/src/ipa/mtkisp50/temporal_nr.h
new file mode 100644
index 0000000..b7d7880
--- /dev/null
+++ b/src/ipa/mtkisp50/temporal_nr.h
@@ -0,0 +1,69 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * When the temporal noise reduction has to start a new reference
+ */
+
+#pragma once
+
+#include <array>
+#include <optional>
+#include <stdint.h>
+
+namespace libcamera {
+
+namespace ipa::mtkisp50 {
+
+/*
+ * The temporal noise reduction blends each frame with the output of the job
+ * before. After a jump of the exposure or of the white balance, and while the
+ * lens moves, the old image would linger in the new one: such jobs start a new
+ * reference. The state of a job is the one the IPA has set when it computes
+ * its parameters; the sensor takes a new exposure a few frames later, so a
+ * change restarts the following jobs for a number of frames.
+ */
+class TemporalNrRestart
+{
+public:
+	struct Limits {
+		/* Change of exposure time times gain, in stops */
+		double exposureStops = 0.5;
+		/* Relative change of a colour gain */
+		double colourGain = 0.1;
+		/* Movement of the lens, in steps of the focus control */
+		int32_t lensSteps = 1;
+		/* Jobs that start a new reference after a change */
+		unsigned int frames = 3;
+	};
+
+	struct State {
+		/* Exposure time times analogue and digital gain */
+		double exposure = 0.0;
+		/* Colour gains red, green, blue */
+		std::array<float, 3> gains = { 1.0f, 1.0f, 1.0f };
+		/* Lens position, std::nullopt without a lens */
+		std::optional<int32_t> lensPosition;
+	};
+
+	void setLimits(const Limits &limits) { limits_ = limits; }
+	const Limits &limits() const { return limits_; }
+
+	/* A new stream: the driver starts a new reference itself */
+	void reset();
+
+	/* Restart a new reference with the next jobs (scene cut) */
+	void trigger();
+
+	/* The state of the next job; true if the job starts a new reference */
+	bool update(const State &state);
+
+private:
+	bool jumped(const State &state) const;
+
+	Limits limits_;
+	std::optional<State> last_;
+	unsigned int remaining_ = 0;
+};
+
+} /* namespace ipa::mtkisp50 */
+
+} /* namespace libcamera */
diff --git a/src/ipa/mtkisp50/unit_tuning.cpp b/src/ipa/mtkisp50/unit_tuning.cpp
new file mode 100644
index 0000000..2ecd683
--- /dev/null
+++ b/src/ipa/mtkisp50/unit_tuning.cpp
@@ -0,0 +1,226 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Calibration of the single camera module over the tuning
+ */
+
+#include "unit_tuning.h"
+
+#include <errno.h>
+#include <memory>
+#include <string.h>
+#include <sys/stat.h>
+
+#include <libcamera/base/file.h>
+#include <libcamera/base/log.h>
+#include <libcamera/base/utils.h>
+
+#include "libcamera/internal/yaml_parser.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPAMtkIsp50Unit)
+
+namespace ipa::mtkisp50 {
+
+namespace {
+
+/* The only version of the file so far */
+constexpr uint32_t kUnitVersion = 1;
+
+std::unique_ptr<ValueNode> copyNode(const ValueNode &node)
+{
+	auto copy = std::make_unique<ValueNode>();
+
+	if (node.isValue()) {
+		copy->set(node.get<std::string>(""));
+	} else if (node.isList()) {
+		for (const ValueNode &child : node.asList())
+			copy->add(copyNode(child));
+	} else if (node.isDictionary()) {
+		for (const auto &[key, child] : node.asDict())
+			copy->add(key, copyNode(child));
+	}
+
+	return copy;
+}
+
+/* The algorithms of the file, or nullptr when the file is not valid */
+const ValueNode *unitAlgorithms(const ValueNode &unit, std::string *error)
+{
+	if (!unit.isDictionary()) {
+		*error = "not a dictionary";
+		return nullptr;
+	}
+
+	std::optional<uint32_t> version = unit["version"].get<uint32_t>();
+	if (!version) {
+		*error = "no version";
+		return nullptr;
+	}
+	if (*version != kUnitVersion) {
+		*error = "unknown version " + unit["version"].get<std::string>("");
+		return nullptr;
+	}
+
+	const ValueNode &algorithms = unit["algorithms"];
+	if (!algorithms.isList()) {
+		*error = "no list of algorithms";
+		return nullptr;
+	}
+
+	for (const ValueNode &algo : algorithms.asList()) {
+		if (!algo.isDictionary() || algo.size() != 1) {
+			*error = "an algorithm entry is not a single dictionary key";
+			return nullptr;
+		}
+
+		const auto &[name, params] = *algo.asDict().begin();
+		if (!params.isDictionary()) {
+			*error = "the parameters of " + name + " are not a dictionary";
+			return nullptr;
+		}
+	}
+
+	return &algorithms;
+}
+
+/*
+ * The parameters of an algorithm with the keys of the file in place of its
+ * own, in the order of the tuning, keys only the file has at the end
+ */
+std::unique_ptr<ValueNode> mergeParams(const ValueNode &params, const ValueNode &unit)
+{
+	auto merged = std::make_unique<ValueNode>();
+
+	for (const auto &[key, value] : params.asDict())
+		merged->add(key, copyNode(unit.contains(key) ? unit[key] : value));
+
+	for (const auto &[key, value] : unit.asDict()) {
+		if (!params.contains(key))
+			merged->add(key, copyNode(value));
+	}
+
+	return merged;
+}
+
+} /* namespace */
+
+/**
+ * \brief The path of the file of the camera module with sensor \a sensorModel
+ *
+ * The file is <sensor>-unit.yaml in the directory of the IPA below the state
+ * directory of libcamera (var/lib/libcamera/ipa/mtkisp50), or in the directory
+ * named by the environment variable LIBCAMERA_MTKISP50_UNIT_DIR.
+ */
+std::string UnitTuning::file(const std::string &sensorModel)
+{
+	std::string dir = IPA_STATE_DIR "/mtkisp50";
+
+	const char *env = utils::secure_getenv("LIBCAMERA_MTKISP50_UNIT_DIR");
+	if (env && *env != '\0')
+		dir = env;
+
+	return dir + "/" + sensorModel + "-unit.yaml";
+}
+
+/**
+ * \brief Lay the file at \a path over the algorithms of \a tuning
+ *
+ * A missing file leaves the tuning as it is, as does a file that is not
+ * valid as a whole (syntax, version, structure); the camera works with the
+ * tuning alone then. An algorithm the tuning does not have is left out with a
+ * warning, the others are applied.
+ */
+UnitTuning UnitTuning::apply(ValueNode &tuning, const std::string &path)
+{
+	UnitTuning result;
+
+	struct stat st;
+	if (stat(path.c_str(), &st) && errno == ENOENT) {
+		LOG(IPAMtkIsp50Unit, Info) << "No unit calibration " << path;
+		return result;
+	}
+
+	result.status = Status::Invalid;
+
+	File file(path);
+	if (!file.open(File::OpenModeFlag::ReadOnly)) {
+		LOG(IPAMtkIsp50Unit, Warning)
+			<< "Unit calibration " << path << " not readable: "
+			<< strerror(-file.error()) << ", tuning alone";
+		return result;
+	}
+
+	std::unique_ptr<ValueNode> unit = YamlParser::parse(file);
+	if (!unit) {
+		LOG(IPAMtkIsp50Unit, Warning)
+			<< "Unit calibration " << path << " not valid YAML, tuning alone";
+		return result;
+	}
+
+	std::string error;
+	const ValueNode *unitAlgos = unitAlgorithms(*unit, &error);
+	ValueNode *algorithms = tuning.at("algorithms");
+	if (!unitAlgos || !algorithms || !algorithms->isList()) {
+		LOG(IPAMtkIsp50Unit, Warning)
+			<< "Unit calibration " << path << " not used: "
+			<< (unitAlgos ? "tuning without a list of algorithms" : error)
+			<< ", tuning alone";
+		return result;
+	}
+
+	result.status = Status::Applied;
+
+	std::string applied;
+	for (const ValueNode &unitAlgo : unitAlgos->asList()) {
+		const auto &[name, unitParams] = *unitAlgo.asDict().begin();
+		bool found = false;
+
+		for (std::size_t i = 0; i < algorithms->size(); i++) {
+			ValueNode *entry = algorithms->at(i);
+			if (!entry->isDictionary() || !entry->contains(name))
+				continue;
+
+			const ValueNode &params = (*entry)[name];
+			if (!params.isDictionary() && !params.isEmpty() &&
+			    !(params.isValue() && params.get<std::string>("").empty())) {
+				LOG(IPAMtkIsp50Unit, Warning)
+					<< "Parameters of " << name
+					<< " in the tuning are not a dictionary, unit calibration left out";
+				found = true;
+				continue;
+			}
+
+			std::unique_ptr<ValueNode> merged = mergeParams(params, unitParams);
+			const std::string key{ name };
+			entry->erase(key);
+			entry->add(key, std::move(merged));
+			found = true;
+		}
+
+		if (!found) {
+			LOG(IPAMtkIsp50Unit, Warning)
+				<< "Unit calibration " << path << ": algorithm " << name
+				<< " not in the tuning, left out";
+			result.unknown.push_back(name);
+			continue;
+		}
+
+		std::string keys;
+		for (const auto &[key, value] : unitParams.asDict()) {
+			result.keys.push_back(name + "." + key);
+			keys += (keys.empty() ? "" : ", ") + key;
+		}
+		applied += (applied.empty() ? "" : ", ") + name + " (" + keys + ")";
+	}
+
+	LOG(IPAMtkIsp50Unit, Info)
+		<< "Unit calibration " << path << ": "
+		<< (applied.empty() ? "nothing applied" : applied);
+
+	return result;
+}
+
+} /* namespace ipa::mtkisp50 */
+
+} /* namespace libcamera */
