+
+/*
+ * Follow the links from the sensor to the capture video node. Entities with
+ * the routing API (seninf) are crossed through their active route from the
+ * sink pad, others through their only source pad.
+ */
+int MtkIsp50CameraData::init(MediaEntity *sensorEntity)
+{
+	sensor_ = CameraSensorFactoryBase::create(sensorEntity);
+	if (!sensor_)
+		return -ENODEV;
+
+	const MediaPad *source = nullptr;
+	for (const MediaPad *pad : sensorEntity->pads()) {
+		if (pad->flags() & MEDIA_PAD_FL_SOURCE) {
+			source = pad;
+			break;
+		}
+	}
+
+	while (source) {
+		const MediaLink *link = nullptr;
+		for (const MediaLink *l : source->links()) {
+			if (l->flags() & MEDIA_LNK_FL_ENABLED) {
+				link = l;
+				break;
+			}
+		}
+		if (!link) {
+			LOG(MtkIsp50, Error)
+				<< "No enabled link from " << source->entity()->name()
+				<< ":" << source->index();
+			return -ENODEV;
+		}
+
+		MediaEntity *entity = link->sink()->entity();
+		const MediaPad *sink = link->sink();
+
+		if (entity->function() == MEDIA_ENT_F_IO_V4L) {
+			video_ = std::make_unique<V4L2VideoDevice>(entity);
+			int ret = video_->open();
+			if (ret)
+				return ret;
+			break;
+		}
+
+		auto subdev = std::make_unique<V4L2Subdevice>(entity);
+		int ret = subdev->open();
+		if (ret)
+			return ret;
+
+		/*
+		 * The route of the image (stream 0) from the sink pad, if the
+		 * subdevice has routing
+		 */
+		const MediaPad *next = nullptr;
+		V4L2Subdevice::Routing routing = {};
+		if (!subdev->getRouting(&routing, V4L2Subdevice::ActiveFormat)) {
+			for (const V4L2Subdevice::Route &route : routing) {
+				if (route.sink.pad == sink->index() && route.sink.stream == 0 &&
+				    (route.flags & V4L2_SUBDEV_ROUTE_FL_ACTIVE)) {
+					next = entity->getPadByIndex(route.source.pad);
+					break;
+				}
+			}
+			if (next && pd_.router < 0) {
+				pd_.router = entities_.size();
+				pd_.sinkPad = sink->index();
+			}
+		}
+
+		if (!next) {
+			std::vector<const MediaPad *> sources;
+			for (const MediaPad *pad : entity->pads()) {
+				if ((pad->flags() & MEDIA_PAD_FL_SOURCE) && !pad->links().empty())
+					sources.push_back(pad);
+			}
+			if (sources.size() != 1) {
+				LOG(MtkIsp50, Error)
+					<< "No route through " << entity->name()
+					<< " from pad " << sink->index();
+				return -ENODEV;
+			}
+			next = sources[0];
+		}
+
+		entities_.push_back({ entity, sink, next, std::move(subdev) });
+		source = next;
+	}
+
+	if (!video_) {
+		LOG(MtkIsp50, Error) << "No capture device for " << sensor_->id();
+		return -ENODEV;
+	}
+
+	properties_ = sensor_->properties();
+
+	/* A sensor that sends PD frames: its capture chain, if there is one */
+	if (MtkIsp50PdLayout::known(sensor_->model()) && pd_.router >= 0 && findPdChain())
+		LOG(MtkIsp50, Info) << "No capture device for the PD frames of " << sensor_->id();
+
+	const CameraSensorProperties::SensorDelays &delays = sensor_->sensorDelays();
+	std::unordered_map<uint32_t, DelayedControls::ControlParams> params = {
+		{ V4L2_CID_ANALOGUE_GAIN, { delays.gainDelay, false } },
+		{ V4L2_CID_EXPOSURE, { delays.exposureDelay, false } },
+	};
+	/* The IPA may raise the frame length for longer exposures. */
+	if (sensor_->controls().count(V4L2_CID_VBLANK))
+		params[V4L2_CID_VBLANK] = { delays.vblankDelay, true };
+	delayedCtrls_ = std::make_unique<DelayedControls>(sensor_->device(), params);
+
+	return 0;
+}
+
+/*
+ * The capture chain of the PD frames: from a source pad of the router that no
+ * image of a sensor uses (its route, if any, comes from a sink pad without a
+ * sensor), along the enabled links to a capture device that takes the PD
+ * frame format. The lowest such pad wins.
+ */
+int MtkIsp50CameraData::findPdChain()
+{
+	const Entity &router = entities_[pd_.router];
+
+	V4L2Subdevice::Routing routing;
+	if (router.subdev->getRouting(&routing, V4L2Subdevice::ActiveFormat))
+		return -ENODEV;
+
+	auto hasSensor = [&](unsigned int pad) {
+		const MediaPad *p = router.entity->getPadByIndex(pad);
+		if (!p)
+			return false;
+		for (const MediaLink *link : p->links()) {
+			if (link->source()->entity()->function() == MEDIA_ENT_F_CAM_SENSOR)
+				return true;
+		}
+		return false;
+	};
+
+	for (const MediaPad *pad : router.entity->pads()) {
+		if (!(pad->flags() & MEDIA_PAD_FL_SOURCE) || pad == router.source)
+			continue;
+
+		bool used = false;
+		for (const V4L2Subdevice::Route &route : routing) {
+			if (route.source.pad == pad->index() &&
+			    (route.flags & V4L2_SUBDEV_ROUTE_FL_ACTIVE) &&
+			    hasSensor(route.sink.pad) && route.sink.pad != pd_.sinkPad)
+				used = true;
+		}
+		if (used)
+			continue;
+
+		/* Follow the enabled links to a capture device */
+		std::vector<Entity> chain;
+		std::unique_ptr<V4L2VideoDevice> video;
+		const MediaPad *source = pad;
+		while (source && !video) {
+			const MediaLink *link = nullptr;
+			for (const MediaLink *l : source->links()) {
+				if (l->flags() & MEDIA_LNK_FL_ENABLED) {
+					link = l;
+					break;
+				}
+			}
+			if (!link)
+				break;
+
+			MediaEntity *entity = link->sink()->entity();
+			if (entity->function() == MEDIA_ENT_F_IO_V4L) {
+				video = std::make_unique<V4L2VideoDevice>(entity);
+				if (video->open())
+					video.reset();
+				break;
+			}
+
+			std::vector<const MediaPad *> sources;
+			for (const MediaPad *p : entity->pads()) {
+				if ((p->flags() & MEDIA_PAD_FL_SOURCE) && !p->links().empty())
+					sources.push_back(p);
+			}
+			if (sources.size() != 1)
+				break;
+
+			auto subdev = std::make_unique<V4L2Subdevice>(entity);
+			if (subdev->open())
+				break;
+			chain.push_back({ entity, link->sink(), sources[0], std::move(subdev) });
+			source = sources[0];
+		}
+
+		if (!video)
+			continue;
+
+		const auto formats = video->formats();
+		if (formats.find(kPdPixelFormat) == formats.end())
+			continue;
+
+		pd_.sourcePad = pad->index();
+		pd_.entities = std::move(chain);
+		pd_.video = std::move(video);
+
+		LOG(MtkIsp50, Debug)
+			<< "PD frames of " << sensor_->id() << " through "
+			<< router.entity->name() << " pad " << pd_.sourcePad
+			<< " to " << pd_.video->deviceNode();
+		return 0;
+	}
+
+	return -ENODEV;
+}
+
+/* The routing has the PD route of the configured layout */
+bool MtkIsp50CameraData::pdRouted(const V4L2Subdevice::Routing &routing) const
+{
+	for (const V4L2Subdevice::Route &route : routing) {
+		if (route.sink.pad == pd_.sinkPad && route.sink.stream != 0 &&
+		    route.source.pad == pd_.sourcePad &&
+		    (route.flags & V4L2_SUBDEV_ROUTE_FL_ACTIVE))
+			return true;
+	}
+	return false;
+}
+
+/*
+ * Route the PD stream of @layout to the PD capture chain, or (layout nullptr)
+ * take the PD route away again. A new routing resets the formats of the
+ * router: call before the formats are set.
+ */
+int MtkIsp50CameraData::setPdRouting(const MtkIsp50PdLayout *layout)
+{
+	if (!hasPdChain())
+		return layout ? -ENODEV : 0;
+
+	V4L2Subdevice *router = entities_[pd_.router].subdev.get();
+	V4L2Subdevice::Routing routing;
+	int ret = router->getRouting(&routing, V4L2Subdevice::ActiveFormat);
+	if (ret)
+		return ret;
+
+	const bool routed = pdRouted(routing);
+
+	if (!layout) {
+		if (!routed)
+			return 0;
+
+		V4L2Subdevice::Routing plain;
+		if (pd_.savedRouting && !pdRouted(*pd_.savedRouting)) {
+			plain = *pd_.savedRouting;
+		} else {
+			for (const V4L2Subdevice::Route &route : routing) {
+				if (!(route.sink.pad == pd_.sinkPad && route.sink.stream != 0))
+					plain.push_back(route);
+			}
+		}
+
+		ret = router->setRouting(&plain, V4L2Subdevice::ActiveFormat);
+		if (ret)
+			LOG(MtkIsp50, Error) << "Failed to remove the PD route: " << strerror(-ret);
+		return ret;
+	}
+
+	if (routed)
+		return 0;
+
+	if (!pd_.savedRouting)
+		pd_.savedRouting = routing;
+
+	V4L2Subdevice::Routing withPd;
+	for (const V4L2Subdevice::Route &route : routing) {
+		if (route.source.pad != pd_.sourcePad)
+			withPd.push_back(route);
+	}
+	withPd.emplace_back(V4L2Subdevice::Stream{ pd_.sinkPad, layout->stream },
+			    V4L2Subdevice::Stream{ pd_.sourcePad, 0 },
+			    V4L2_SUBDEV_ROUTE_FL_ACTIVE);
+
+	ret = router->setRouting(&withPd, V4L2Subdevice::ActiveFormat);
+	if (ret) {
+		LOG(MtkIsp50, Info)
+			<< "No PD route on " << entities_[pd_.router].entity->name()
+			<< ": " << strerror(-ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+/* Formats of the PD route and of the PD capture chain */
+int MtkIsp50CameraData::setPdFormats()
+{
+	const MtkIsp50PdLayout *layout = pd_.layout;
+	V4L2Subdevice *router = entities_[pd_.router].subdev.get();
+
+	V4L2SubdeviceFormat format;
+	format.code = layout->mbusCode;
+	format.size = layout->size;
+
+	int ret = router->setFormat(V4L2Subdevice::Stream{ pd_.sinkPad, layout->stream }, &format);
+	if (ret)
+		return ret;
+	ret = router->setFormat(V4L2Subdevice::Stream{ pd_.sourcePad, 0 }, &format);
+	if (ret)
+		return ret;
+
+	for (Entity &e : pd_.entities) {
+		ret = e.subdev->setFormat(e.sink->index(), &format);
+		if (ret)
+			return ret;
+
+		V4L2SubdeviceFormat sourceFormat = format;
+		ret = e.subdev->getFormat(e.source->index(), &sourceFormat);
+		if (ret)
+			return ret;
+		if (sourceFormat.code != format.code || sourceFormat.size != format.size) {
+			ret = e.subdev->setFormat(e.source->index(), &format);
+			if (ret)
+				return ret;
+		}
+	}
+
+	if (format.code != layout->mbusCode || format.size != layout->size) {
+		LOG(MtkIsp50, Error) << "PD format " << format << " instead of " << layout->size;
+		return -EINVAL;
+	}
+
+	V4L2DeviceFormat video;
+	video.fourcc = kPdPixelFormat;
+	video.size = layout->size;
+	ret = pd_.video->setFormat(&video);
+	if (ret)
+		return ret;
+	if (video.fourcc != kPdPixelFormat || video.size != layout->size) {
+		LOG(MtkIsp50, Error) << "PD capture format " << video;
+		return -EINVAL;
+	}
+	pd_.format = video;
+
+	return 0;
+}
+
+/* The routing as it was before the first change */
+void MtkIsp50CameraData::restoreRouting()
+{
+	if (!pd_.savedRouting || pd_.router < 0)
+		return;
+
+	V4L2Subdevice::Routing routing = *pd_.savedRouting;
+	int ret = entities_[pd_.router].subdev->setRouting(&routing, V4L2Subdevice::ActiveFormat);
+	if (ret)
+		LOG(MtkIsp50, Warning) << "Failed to restore the routing: " << strerror(-ret);
+	pd_.savedRouting.reset();
+	pd_.layout = nullptr;
+}
+
+int MtkIsp50CameraData::loadIPA()
+{
+	ipa_ = pipe()->createIPA<ipa::mtkisp50::IPAProxyMtkIsp50>(0, 0);
+	if (!ipa_)
+		return -ENOENT;
+
+	ipa_->setSensorControls.connect(this, &MtkIsp50CameraData::setSensorControls);
+	ipa_->paramsComputed.connect(this, &MtkIsp50CameraData::paramsComputed);
+	ipa_->metadataReady.connect(this, &MtkIsp50CameraData::metadataReady);
+
+	std::string tuningFile =
+		ipa_->configurationFile(sensor_->model() + ".yaml", "uncalibrated.yaml");
+
+	IPACameraSensorInfo sensorInfo{};
+	int ret = sensor_->sensorInfo(&sensorInfo);
+	if (ret) {
+		LOG(MtkIsp50, Error) << "Camera sensor information not available";
+		return ret;
+	}
+
+	ControlInfoMap lensControls;
+	if (sensor_->focusLens())
+		lensControls = sensor_->focusLens()->controls();
+
+	ret = ipa_->init({ tuningFile, sensor_->model() }, sensorInfo,
+			 sensor_->controls(), lensControls, &ipaControls_);
+	if (ret) {
+		LOG(MtkIsp50, Error) << "IPA initialisation failed with " << tuningFile;
+		return ret;
+	}
+
+	LOG(MtkIsp50, Info) << "Tuning of " << sensor_->id() << ": " << tuningFile;
+
+	return 0;
+}
+
+void MtkIsp50CameraData::setSensorControls([[maybe_unused]] uint32_t frame,
+					   const ControlList &sensorControls,
+					   const ControlList &lensControls)
+{
+	delayedCtrls_->push(sensorControls);
+
+	/*
+	 * Without a frame start event of the capture device the controls are
+	 * applied right away, as the simple pipeline handler does. A new frame
+	 * length goes first, the exposure limit of the sensor follows it.
+	 */
+	ControlList ctrls(sensorControls);
+	if (ctrls.contains(V4L2_CID_VBLANK)) {
+		ControlList vblank(sensor_->controls());
+		vblank.set(V4L2_CID_VBLANK, ctrls.get(V4L2_CID_VBLANK));
+		sensor_->setControls(&vblank);
+	}
+	sensor_->setControls(&ctrls);
+
+	CameraLens *lens = sensor_->focusLens();
+	if (lens && lensControls.contains(V4L2_CID_FOCUS_ABSOLUTE)) {
+		const ControlValue &position = lensControls.get(V4L2_CID_FOCUS_ABSOLUTE);
+		lens->setFocusPosition(position.get<int32_t>());
+	}
+}
+
+void MtkIsp50CameraData::paramsComputed(uint32_t frame, uint32_t bytesused,
+					const ipa::mtkisp50::StatsConfig &config,
+					uint32_t seriesFrames)
+{
+	if (paramsPending_)
+		paramsPending_--;
+
+	MtkIsp50Frames::Info *info = frames_.find(frame);
+	if (!info)
+		return;
+
+	PipelineHandlerMtkIsp50 *pipe = this->pipe();
+
+	/* The still image starts a multi-frame series */
+	if (seriesFrames)
+		pipe->startSeries(this, info, seriesFrames);
+
+	/* The raw buffer stays until the statistics are done */
+	statsDone_[frame] = false;
+
+	frames_.submitIspJob(info, bytesused);
+	pipe->runIspJobs(this);
+	pipe->trySeriesIsp(this);
+
+	if (!pd_.streaming) {
+		pipe->dispatchStats(this, info, config, nullptr);
+		return;
+	}
+
+	/*
+	 * The statistics of a frame with its PD frame: earlier frames still
+	 * waiting go without theirs, this one waits for its PD frame if it may
+	 * still come.
+	 */
+	pipe->dispatchPdWaiting(this, true);
+
+	std::vector<FrameBuffer *> release;
+	FrameBuffer *pd = pd_.matcher.take(info->rawTimestamp, &release);
+	pipe->queuePdBuffers(this, release);
+
+	if (!pd && pd_.matcher.mayCome(info->rawTimestamp)) {
+		pd_.waiting.emplace_back(frame, config);
+		return;
+	}
+
+	pipe->dispatchStats(this, info, config, pd);
+}
+
+void MtkIsp50CameraData::metadataReady(uint32_t frame, const ControlList &metadata)
+{
+	MtkIsp50Frames::Info *info = frames_.find(frame);
+	if (!info)
+		return;
+
+	if (info->request)
+		info->request->_d()->metadata().merge(metadata);
+	info->metadataDone = true;
+
+	pipe()->tryComplete(this, info);
+}
+
+/* -----------------------------------------------------------------------------
+ * Camera configuration
+ */
+
+CameraConfiguration::Status MtkIsp50CameraConfiguration::validate()
+{
+	Status status = Valid;
+
+	if (config_.empty())
+		return Invalid;
+
+	status = validateColorSpaces(ColorSpaceFlag::StreamsShareColorSpace);
+
+	CameraSensor *sensor = data_->sensor_.get();
+	PipelineHandlerMtkIsp50 *pipe = data_->pipe();
+
+	/* 10 bit (or else 8 bit) Bayer codes of the sensor */
+	std::vector<unsigned int> mbusCodes;
+	for (unsigned int code : sensor->mbusCodes()) {
+		BayerFormat bayer = BayerFormat::fromMbusCode(code);
+		if (bayer.isValid() && (bayer.bitDepth == 10 || bayer.bitDepth == 8))
+			mbusCodes.push_back(code);
+	}
+	std::stable_sort(mbusCodes.begin(), mbusCodes.end(), [](unsigned int a, unsigned int b) {
+		return BayerFormat::fromMbusCode(a).bitDepth > BayerFormat::fromMbusCode(b).bitDepth;
+	});
+	if (mbusCodes.empty() || data_->modes_.empty())
+		return Invalid;
+
+	/* Streams to the outputs, sensor mode and processed area */
+	MtkIsp50StreamPlan plan(data_->modes_, data_->ispAvailable_, pipe->dip_.hasScaled());
+	const Status planned = plan.plan(config_);
+	if (planned == Invalid)
+		return Invalid;
+	if (planned == Adjusted)
+		status = Adjusted;
+
+	sensorFormat = sensor->getFormat(mbusCodes, plan.mode);
+	if (sensorFormat.size != plan.mode) {
+		LOG(MtkIsp50, Error)
+			<< "Sensor mode " << sensorFormat.size << " instead of " << plan.mode;
+		return Invalid;
+	}
+
+	BayerFormat bayer = BayerFormat::fromMbusCode(sensorFormat.code);
+	if (bayer.bitDepth == 10)
+		bayer.packing = BayerFormat::Packing::MTISP;
+
+	V4L2DeviceFormat rawFormat;
+	rawFormat.fourcc = PipelineHandlerMtkIsp50::rawPixelFormat(bayer);
+	rawFormat.size = sensorFormat.size;
+	int ret = data_->video_->tryFormat(&rawFormat);
+	if (ret)
+		return Invalid;
+
+	if (plan.raw >= 0) {
+		StreamConfiguration *rawCfg = &config_[plan.raw];
+		const PixelFormat format = PipelineHandlerMtkIsp50::rawFormatOf(bayer);
+		if (rawCfg->pixelFormat != format || rawCfg->size != sensorFormat.size) {
+			rawCfg->pixelFormat = format;
+			rawCfg->size = sensorFormat.size;
+			status = Adjusted;
+		}
+
+		rawCfg->stride = rawFormat.planes[0].bpl;
+		rawCfg->frameSize = rawFormat.planes[0].size;
+		if (rawCfg->colorSpace != ColorSpace::Raw) {
+			rawCfg->colorSpace = ColorSpace::Raw;
+			status = Adjusted;
+		}
+		if (!rawCfg->bufferCount)
+			rawCfg->bufferCount = kRawBufferCount;
+		rawCfg->setStream(const_cast<Stream *>(&data_->rawStream_));
+	}
+
+	crop = plan.crop;
+
+	if (plan.main >= 0) {
+		StreamConfiguration *outCfg = &config_[plan.main];
+
+		V4L2DeviceFormat format;
+		format.fourcc = V4L2PixelFormat(V4L2_PIX_FMT_NV12);
+		format.size = outCfg->size;
+		ret = pipe->dip_.main_->tryFormat(&format);
+		if (ret)
+			return Invalid;
+
+		if (format.size != outCfg->size) {
+			/* A size the planning does not know as impossible */
+			outCfg->size = format.size;
+			crop = Rectangle(static_cast<int>(((sensorFormat.size.width - format.size.width) / 2) & ~3u),
+					 static_cast<int>(((sensorFormat.size.height - format.size.height) / 2) & ~1u),
+					 format.size);
+			status = Adjusted;
+		}
+
+		outCfg->stride = format.planes[0].bpl;
+		outCfg->frameSize = format.planes[0].size;
+		if (!outCfg->bufferCount)
+			outCfg->bufferCount = plan.scaled >= 0 && outCfg->frameSize > kLargeOutputFrame
+						      ? kLargeOutputBufferCount
+						      : kOutputBufferCount;
+		outCfg->setStream(const_cast<Stream *>(&data_->outputStream_));
+	}
+
+	if (plan.scaled >= 0) {
+		StreamConfiguration *scaledCfg = &config_[plan.scaled];
+
+		Size size = MtkIsp50StreamPlan::fitScaled(crop.size(), scaledCfg->size);
+		unsigned int stride = utils::alignUp(size.width * 2, 16);
+
+		/*
+		 * The driver rounds the width down to one its tile computation
+		 * serves for the processed area of the raw node. While no
+		 * camera of the handler streams, the area is set for the check
+		 * (configure() sets it again); a busy node keeps the size.
+		 */
+		if (!pipe->streaming()) {
+			V4L2DeviceFormat ispRaw = rawFormat;
+			Rectangle area = crop;
+			V4L2DeviceFormat format;
+			format.fourcc = V4L2PixelFormat(V4L2_PIX_FMT_YUYV);
+			format.size = size;
+
+			if (!pipe->dip_.raw_->setFormat(&ispRaw) &&
+			    !pipe->dip_.raw_->setSelection(V4L2_SEL_TGT_CROP, &area) &&
+			    area == crop && !pipe->dip_.scaled_->tryFormat(&format)) {
+				size = format.size;
+				stride = format.planes[0].bpl;
+			}
+		}
+
+		if (size != scaledCfg->size) {
+			scaledCfg->size = size;
+			status = Adjusted;
+		}
+
+		scaledCfg->stride = stride;
+		scaledCfg->frameSize = stride * size.height;
+		if (!scaledCfg->bufferCount)
+			scaledCfg->bufferCount = kOutputBufferCount;
+		scaledCfg->setStream(const_cast<Stream *>(&data_->scaledStream_));
+	}
+
+	/* BT.601 full range on both processed outputs */
+	for (int index : { plan.main, plan.scaled }) {
+		if (index < 0)
+			continue;
+
+		StreamConfiguration &cfg = config_[index];
+		if (cfg.colorSpace != ColorSpace::Sycc) {
+			cfg.colorSpace = ColorSpace::Sycc;
+			status = Adjusted;
+		}
+	}
+
+	return status;
+}
+
+/* -----------------------------------------------------------------------------
+ * Pipeline handler
+ */
+
+PipelineHandlerMtkIsp50::PipelineHandlerMtkIsp50(CameraManager *manager)
+	: PipelineHandler(manager, kMaxQueuedRequests)
+{
+}
+
+PipelineHandlerMtkIsp50::~PipelineHandlerMtkIsp50()
+{
+	/* The thread of the worker ends first, then the worker goes */
+	if (statsThread_.isRunning()) {
+		statsThread_.exit();
+		statsThread_.wait();
+	}
+	if (seriesThread_.isRunning()) {
+		seriesThread_.exit();
+		seriesThread_.wait();
+	}
+
+	statsWorker_.reset();
+	seriesWorker_.reset();
+}
+
+V4L2PixelFormat PipelineHandlerMtkIsp50::rawPixelFormat(const BayerFormat &bayer)
+{
+	return bayer.toV4L2PixelFormat();
+}
+
+PixelFormat PipelineHandlerMtkIsp50::rawFormatOf(const BayerFormat &bayer)
+{
+	return bayer.toPixelFormat();
+}
+
+std::unique_ptr<CameraConfiguration>
+PipelineHandlerMtkIsp50::generateConfiguration(Camera *camera, Span<const StreamRole> roles)
+{
+	MtkIsp50CameraData *data = cameraData(camera);
+	auto config = std::make_unique<MtkIsp50CameraConfiguration>(data);
+	CameraSensor *sensor = data->sensor_.get();
+
+	if (roles.empty())
+		return config;
+
+	const std::vector<Size> &modes = data->modes_;
+	if (modes.empty())
+		return nullptr;
+
+	Size viewfinder = modes.back();
+	for (const Size &size : modes) {
+		if (size.width >= kViewfinderMinSize.width &&
+		    size.height >= kViewfinderMinSize.height) {
+			viewfinder = size;
+			break;
+		}
+	}
+
+	const bool scaledAvailable = data->ispAvailable_ && dip_.hasScaled();
+	const unsigned int maxProcessed = !data->ispAvailable_ ? 0 : scaledAvailable ? 2 : 1;
+
+	unsigned int processed = 0;
+	bool haveRaw = false;
+	bool haveStill = false;
+	bool haveVideo = false;
+	data->videoRoles_ = false;
+	for (const StreamRole role : roles) {
+		const bool raw = role == StreamRole::Raw || !data->ispAvailable_;
+		if (raw) {
+			if (haveRaw) {
+				LOG(MtkIsp50, Error) << "Only one raw stream is supported";
+				return nullptr;
+			}
+			haveRaw = true;
+			continue;
+		}
+
+		if (++processed > maxProcessed) {
+			LOG(MtkIsp50, Error)
+				<< "At most " << maxProcessed << " processed streams are supported";
+			return nullptr;
+		}
+		haveStill |= role == StreamRole::StillCapture;
+		haveVideo |= role == StreamRole::VideoRecording;
+		data->videoRoles_ = haveVideo;
+	}
+
+	/*
+	 * Defaults. One processed stream: still and viewfinder on the main
+	 * output (a crop of the sensor mode as before), video on the scaled
+	 * output (16:9 of the whole width of the larger mode). Two: the still
+	 * or the video on the main output, the other one scaled from the same
+	 * area.
+	 */
+	const Size halfLargest(modes.back().width / 2, modes.back().height / 2);
+	const Size scaledMax = MtkIsp50StreamPlan::fitScaled(modes.back(), {});
+
+	for (const StreamRole role : roles) {
+		const bool raw = role == StreamRole::Raw || !data->ispAvailable_;
+		std::map<PixelFormat, std::vector<SizeRange>> formats;
+		StreamConfiguration cfg;
+
+		if (raw) {
+			BayerFormat bayer;
+			for (unsigned int code : sensor->mbusCodes()) {
+				bayer = BayerFormat::fromMbusCode(code);
+				if (bayer.isValid() && (bayer.bitDepth == 10 || bayer.bitDepth == 8))
+					break;
+			}
+			if (bayer.bitDepth == 10)
+				bayer.packing = BayerFormat::Packing::MTISP;
+
+			std::vector<SizeRange> sizes;
+			for (const Size &size : modes)
+				sizes.emplace_back(size);
+			formats[rawFormatOf(bayer)] = sizes;
+
+			cfg = StreamConfiguration(StreamFormats(formats));
+			cfg.pixelFormat = rawFormatOf(bayer);
+			cfg.size = role == StreamRole::Raw || role == StreamRole::StillCapture
+					   ? modes.back() : viewfinder;
+			/* Two processed streams of the large mode leave less memory */
+			cfg.bufferCount = processed == 2 ? kLargeOutputBufferCount : kRawBufferCount;
+			config->addConfiguration(cfg);
+			continue;
+		}
+
+		formats[formats::NV12] = { SizeRange(MtkIsp50StreamPlan::kIspMinSize, modes.back()) };
+		if (scaledAvailable)
+			formats[formats::YUYV] = { SizeRange(MtkIsp50StreamPlan::kScaledMinSize,
+							     scaledMax) };
+		cfg = StreamConfiguration(StreamFormats(formats));
+		cfg.pixelFormat = formats::NV12;
+		cfg.bufferCount = kOutputBufferCount;
+
+		switch (role) {
+		case StreamRole::StillCapture:
+			cfg.size = modes.back();
+			if (processed == 2)
+				cfg.bufferCount = kLargeOutputBufferCount;
+			break;
+
+		case StreamRole::VideoRecording:
+			cfg.size = kVideoSize;
+			if (scaledAvailable && processed == 1)
+				cfg.pixelFormat = formats::YUYV;
+			break;
+
+		default:
+			if (haveStill && processed == 2) {
+				/* Half of the still, the largest scaled size */
+				cfg.pixelFormat = formats::YUYV;
+				cfg.size = viewfinder;
+				cfg.size.boundTo(halfLargest);
+			} else if (haveVideo && processed == 2) {
+				cfg.pixelFormat = formats::YUYV;
+				cfg.size = Size(kVideoSize.width / 2, kVideoSize.height / 2);
+			} else {
+				cfg.size = viewfinder;
+			}
+			break;
+		}
+
+		config->addConfiguration(cfg);
+	}
+
+	config->validate();
+
+	return config;
+}
+
+int PipelineHandlerMtkIsp50::configure(Camera *camera, CameraConfiguration *c)
+{
+	MtkIsp50CameraConfiguration *config =
+		static_cast<MtkIsp50CameraConfiguration *>(c);
+	MtkIsp50CameraData *data = cameraData(camera);
+
+	/*
+	 * The sensor mode with PD frames gets the PD route, the others not
+	 * (the route of a stream the sensor does not send fails the start).
+	 * A new routing resets the formats of the router: first the routing.
+	 */
+	const MtkIsp50PdLayout *pdLayout = data->hasPdChain()
+		? MtkIsp50PdLayout::find(data->sensor_->model(), config->sensorFormat.size)
+		: nullptr;
+	int ret = data->setPdRouting(pdLayout);
+	if (ret && pdLayout) {
+		pdLayout = nullptr;
+		ret = data->setPdRouting(nullptr);
+	}
+	if (ret)
+		return ret;
+
+	V4L2SubdeviceFormat format = config->sensorFormat;
+	ret = data->sensor_->setFormat(&format);
+	if (ret)
+		return ret;
+	data->sensorFormat_ = format;
+
+	/* Propagate the format along the subdevices */
+	auto propagate = [&]() {
+		V4L2SubdeviceFormat f = data->sensorFormat_;
+		for (MtkIsp50CameraData::Entity &e : data->entities_) {
+			int r = e.subdev->setFormat(e.sink->index(), &f);
+			if (r)
+				return r;
+
+			V4L2SubdeviceFormat sourceFormat = f;
+			r = e.subdev->getFormat(e.source->index(), &sourceFormat);
+			if (r)
+				return r;
+
+			if (sourceFormat.code != f.code || sourceFormat.size != f.size) {
+				r = e.subdev->setFormat(e.source->index(), &f);
+				if (r)
+					return r;
+			}
+
+			LOG(MtkIsp50, Debug)
+				<< e.entity->name() << ": " << f;
+		}
+		return 0;
+	};
+
+	ret = propagate();
+	if (ret)
+		return ret;
+
+	/* The PD stream; without it the route goes again */
+	data->pd_.layout = pdLayout;
+	if (pdLayout) {
+		ret = data->setPdFormats();
+		if (ret) {
+			LOG(MtkIsp50, Warning)
+				<< "No PD frames, formats not taken: " << strerror(-ret);
+			data->pd_.layout = nullptr;
+			ret = data->setPdRouting(nullptr);
+			if (!ret)
+				ret = propagate();
+			if (ret)
+				return ret;
+		}
+	}
+
+	BayerFormat bayer = BayerFormat::fromMbusCode(data->sensorFormat_.code);
+	if (bayer.bitDepth == 10)
+		bayer.packing = BayerFormat::Packing::MTISP;
+	data->rawBayer_ = bayer;
+
+	V4L2DeviceFormat rawFormat;
+	rawFormat.fourcc = rawPixelFormat(bayer);
+	rawFormat.size = data->sensorFormat_.size;
+	ret = data->video_->setFormat(&rawFormat);
+	if (ret)
+		return ret;
+
+	if (rawFormat.fourcc != rawPixelFormat(bayer) ||
+	    rawFormat.size != data->sensorFormat_.size) {
+		LOG(MtkIsp50, Error)
+			<< "Capture format " << rawFormat << " instead of "
+			<< data->sensorFormat_.size << "-" << rawPixelFormat(bayer);
+		return -EINVAL;
+	}
+	data->rawFormat_ = rawFormat;
+
+	data->outputs_ = 0;
+	data->rawActive_ = false;
+	StreamConfiguration *outCfg = nullptr;
+	StreamConfiguration *scaledCfg = nullptr;
+	for (StreamConfiguration &cfg : *config) {
+		if (cfg.stream() == &data->outputStream_) {
+			outCfg = &cfg;
+			data->outputs_ |= MtkIsp50OutputMain;
+		} else if (cfg.stream() == &data->scaledStream_) {
+			scaledCfg = &cfg;
+			data->outputs_ |= MtkIsp50OutputScaled;
+		} else if (cfg.stream() == &data->rawStream_) {
+			data->rawActive_ = true;
+		}
+	}
+
+	StreamConfiguration rawConfig;
+	rawConfig.pixelFormat = rawFormatOf(bayer);
+	rawConfig.size = rawFormat.size;
+	rawConfig.stride = rawFormat.planes[0].bpl;
+
+	/* Statistics over the processed area, or the whole frame */
+	data->crop_ = Rectangle(rawFormat.size);
+	/* Size of the parameter buffers of the driver, 0 without the ISP */
+	uint32_t paramsSize = 0;
+
+	if (data->ispActive()) {
+		/* Raw input of the DIP, line length as written by the CAMSV */
+		V4L2DeviceFormat ispRaw = rawFormat;
+		ret = dip_.raw_->setFormat(&ispRaw);
+		if (ret)
+			return ret;
+
+		if (ispRaw.fourcc != rawFormat.fourcc || ispRaw.size != rawFormat.size ||
+		    ispRaw.planes[0].bpl != rawFormat.planes[0].bpl) {
+			LOG(MtkIsp50, Error)
+				<< "ISP input " << ispRaw << " does not match the capture format "
+				<< rawFormat;
+			return -EINVAL;
+		}
+
+		/* The processed area chosen in validate() */
+		const Rectangle &crop = config->crop;
+
+		Rectangle applied = crop;
+		ret = dip_.raw_->setSelection(V4L2_SEL_TGT_CROP, &applied);
+		if (ret)
+			return ret;
+
+		if (applied.size() != crop.size() || (applied.x & 1) || (applied.y & 1)) {
+			LOG(MtkIsp50, Error) << "ISP crop " << applied << " instead of " << crop;
+			return -EINVAL;
+		}
+		data->crop_ = applied;
+
+		if (outCfg) {
+			V4L2DeviceFormat main;
+			main.fourcc = V4L2PixelFormat(V4L2_PIX_FMT_NV12);
+			main.size = outCfg->size;
+			ret = dip_.main_->setFormat(&main);
+			if (ret)
+				return ret;
+
+			if (main.size != outCfg->size || main.size != applied.size() ||
+			    main.planes[0].bpl != outCfg->stride) {
+				LOG(MtkIsp50, Error)
+					<< "ISP output " << main << " does not match "
+					<< outCfg->toString() << " stride " << outCfg->stride;
+				return -EINVAL;
+			}
+		}
+
+		if (scaledCfg) {
+			V4L2DeviceFormat scaled;
+			scaled.fourcc = V4L2PixelFormat(V4L2_PIX_FMT_YUYV);
+			scaled.size = scaledCfg->size;
+			scaled.planes[0].bpl = scaledCfg->stride;
+			scaled.planesCount = 1;
+			ret = dip_.scaled_->setFormat(&scaled);
+			if (ret)
+				return ret;
+
+			if (scaled.size != scaledCfg->size ||
+			    scaled.planes[0].bpl != scaledCfg->stride) {
+				LOG(MtkIsp50, Error)
+					<< "ISP scaled output " << scaled << " does not match "
+					<< scaledCfg->toString() << " stride " << scaledCfg->stride;
+				return -EINVAL;
+			}
+		}
+
+		V4L2DeviceFormat params;
+		ret = dip_.params_->getFormat(&params);
+		if (ret)
+			return ret;
+		params.fourcc = V4L2PixelFormat(V4L2_META_FMT_MTK_DIP_PARAMS);
+		params.planesCount = 1;
+		ret = dip_.params_->setFormat(&params);
+		if (ret)
+			return ret;
+		paramsSize = params.planes[0].size;
+	}
+
+	ret = statsWorker_->invokeMethod(&MtkIsp50StatsWorker::configure,
+					 ConnectionTypeBlocking, rawConfig, data->crop_);
+	if (ret) {
+		LOG(MtkIsp50, Error) << "Statistics not possible on " << rawConfig.pixelFormat;
+		return ret;
+	}
+	statsWorker_->invokeMethod(&MtkIsp50StatsWorker::configurePd, ConnectionTypeBlocking,
+				   data->pd_.layout,
+				   data->pd_.layout ? data->pd_.format.planes[0].bpl : 0u);
+
+	/*
+	 * The processed area in active pixel array coordinates, through the
+	 * analogue crop and the binning of the sensor mode; the largest one is
+	 * the analogue crop.
+	 */
+	IPACameraSensorInfo sensorInfo{};
+	ret = data->sensor_->sensorInfo(&sensorInfo);
+	if (ret)
+		return ret;
+
+	const Rectangle &analog = sensorInfo.analogCrop;
+	const Size &out = sensorInfo.outputSize;
+	if (!out.isNull()) {
+		data->scalerCrop_ = Rectangle(
+			analog.x + static_cast<int>(static_cast<int64_t>(data->crop_.x) * analog.width / out.width),
+			analog.y + static_cast<int>(static_cast<int64_t>(data->crop_.y) * analog.height / out.height),
+			static_cast<unsigned int>(static_cast<uint64_t>(data->crop_.width) * analog.width / out.width),
+			static_cast<unsigned int>(static_cast<uint64_t>(data->crop_.height) * analog.height / out.height));
+	}
+	data->properties_.set(properties::ScalerCropMaximum, analog);
+
+	if (!data->ipa_)
+		return 0;
+
+	ipa::mtkisp50::IPAConfigInfo ipaConfig{};
+	ipaConfig.sensorInfo = sensorInfo;
+
+	ipaConfig.sensorControls = data->sensor_->controls();
+	if (data->sensor_->focusLens())
+		ipaConfig.lensControls = data->sensor_->focusLens()->controls();
+	ipaConfig.rawSize = rawFormat.size;
+	ipaConfig.ispCrop = data->crop_;
+	ipaConfig.bayerOrder = bayer.order;
+	ipaConfig.bitDepth = bayer.bitDepth;
+	ipaConfig.useCase = data->videoRoles_ ? ipa::mtkisp50::UseCase::Video
+					      : ipa::mtkisp50::UseCase::Preview;
+	if (outCfg && outCfg->size == data->sensor_->resolution())
+		ipaConfig.useCase = ipa::mtkisp50::UseCase::Still;
+	data->useCase_ = ipaConfig.useCase;
+
+	LOG(MtkIsp50, Debug)
+		<< "Sensor " << data->sensorFormat_ << ", processed area " << data->crop_
+		<< (outCfg ? ", main " + outCfg->toString() : "")
+		<< (scaledCfg ? ", scaled " + scaledCfg->toString() : "");
+	ipaConfig.paramsBufferSize = paramsSize;
+	/*
+	 * With the temporal noise reduction the driver keeps each buffer of
+	 * the main output until the next job: a stream of main buffers needs
+	 * one more than the application holds. Jobs of still images run
+	 * without the module. In a session with still images the preview jobs
+	 * have no main buffer and the driver needs two frames of the whole
+	 * processed area of its own; next to the buffers of the still images
+	 * they do not fit into the camera memory region, so such sessions run
+	 * without the module.
+	 */
+	ipaConfig.temporalNr = ipaConfig.useCase != ipa::mtkisp50::UseCase::Still &&
+			       (!outCfg || outCfg->bufferCount >= kTemporalNrMainBuffers);
+	ipaConfig.statsSource = static_cast<uint32_t>(mtkisp50::StatsSource::Cpu);
+	ipaConfig.pdAvailable = data->pd_.layout != nullptr;
+
+	/*
+	 * Multi-frame still images: a still image of the whole sensor mode,
+	 * the blend inputs of the DIP and the MFB
+	 */
+	data->series_.enabled = ipaConfig.useCase == ipa::mtkisp50::UseCase::Still &&
+				dip_.hasBlend() && seriesWorker_ && outCfg &&
+				outCfg->pixelFormat == formats::NV12 &&
+				!data->rawActive_;
+	ipaConfig.multiFrame = data->series_.enabled;
+
+	ret = data->ipa_->configure(ipaConfig, &data->ipaControls_);
+	if (ret) {
+		LOG(MtkIsp50, Error) << "IPA configuration failed";
+		return ret;
+	}
+
+	data->controlInfo_ = data->ipaControls_;
+
+	return 0;
+}
+
+int PipelineHandlerMtkIsp50::exportFrameBuffers(Camera *camera, Stream *stream,
+						std::vector<std::unique_ptr<FrameBuffer>> *buffers)
+{
+	MtkIsp50CameraData *data = cameraData(camera);
+	unsigned int count = stream->configuration().bufferCount;
+
+	if (stream == &data->outputStream_)
+		return dip_.main_->exportBuffers(count, buffers);
+	if (stream == &data->scaledStream_ && dip_.scaled_)
+		return dip_.scaled_->exportBuffers(count, buffers);
+	if (stream == &data->rawStream_)
+		return data->video_->exportBuffers(count, buffers);
+
+	return -EINVAL;
+}
+
+int PipelineHandlerMtkIsp50::allocateBuffers(Camera *camera)
+{
+	MtkIsp50CameraData *data = cameraData(camera);
+	int ret;
+
+	/*
+	 * The camera memory region holds all raw and output buffers and a
+	 * spare raw frame of the capture device, without which the capture
+	 * device keeps the last queued buffer until the next one comes. Large
+	 * raw frames next to a large main output get a smaller internal pool,
+	 * and a raw stream brings its own buffers: requests wait for a pool
+	 * buffer if needed.
+	 */
+	const bool largeMain = (data->outputs_ & MtkIsp50OutputMain) &&
+			       data->outputStream_.configuration().frameSize > kLargeOutputFrame;
+	unsigned int pool = kRawBufferCount;
+	if (data->rawActive_)
+		pool = 2;
+	else if (data->rawFormat_.planes[0].size > kLargeRawFrame && largeMain)
+		pool = 3;
+
+	unsigned int rawSlots = pool;
+	if (data->rawActive_)
+		rawSlots += data->rawStream_.configuration().bufferCount;
+
+	/* Internal raw pool, imported by the capture device and the ISP */
+	ret = data->video_->exportBuffers(pool, &data->rawBuffers_);
+	if (ret < 0)
+		return ret;
+	ret = data->video_->importBuffers(rawSlots);
+	if (ret < 0)
+		return ret;
+	data->rawSlots_ = rawSlots;
+	for (std::unique_ptr<FrameBuffer> &buffer : data->rawBuffers_)
+		data->availableRawBuffers_.push(buffer.get());
+
+	if (data->ispActive()) {
+		ret = dip_.raw_->importBuffers(rawSlots);
+		if (ret < 0)
+			return ret;
+		if (data->outputs_ & MtkIsp50OutputMain) {
+			/* The images of multi-frame series go through the main output too */
+			const unsigned int series = data->series_.enabled ? kSeriesMaxFrames : 0;
+			ret = dip_.main_->importBuffers(data->outputStream_.configuration().bufferCount +
+							series);
+			if (ret < 0)
+				return ret;
+		}
+		if (data->outputs_ & MtkIsp50OutputScaled) {
+			ret = dip_.scaled_->importBuffers(data->scaledStream_.configuration().bufferCount);
+			if (ret < 0)
+				return ret;
+		}
+		const unsigned int series = data->series_.enabled ? kSeriesParamsBuffers : 0;
+		ret = dip_.params_->allocateBuffers(kParamsBufferCount + series, &data->paramsBuffers_);
+		if (ret < 0)
+			return ret;
+		if (static_cast<unsigned int>(ret) < kParamsBufferCount + series)
+			data->series_.enabled = false;
+	} else {
+		/* Raw only: parameter buffers without the ISP, never queued */
+		for (unsigned int i = 0; i < kParamsBufferCount; i++) {
+			UniqueFD fd = MemFd::create("mtkisp50-params", MTK_DIP_PARAMS_MAX_SIZE);
+			if (!fd.isValid())
+				return -ENOMEM;
+			FrameBuffer::Plane plane;
+			plane.fd = SharedFD(std::move(fd));
+			plane.offset = 0;
+			plane.length = MTK_DIP_PARAMS_MAX_SIZE;
+			data->paramsBuffers_.push_back(std::make_unique<FrameBuffer>(
+				std::vector<FrameBuffer::Plane>{ plane }));
+		}
+	}
+
+	for (unsigned int i = 0; i < kStatsBufferCount; i++) {
+		const size_t size = sizeof(mtkisp50::StatsBuffer);
+		UniqueFD fd = MemFd::create("mtkisp50-stats", size);
+		if (!fd.isValid())
+			return -ENOMEM;
+
+		FrameBuffer::Plane plane;
+		plane.fd = SharedFD(std::move(fd));
+		plane.offset = 0;
+		plane.length = size;
+		data->statsBuffers_.push_back(std::make_unique<FrameBuffer>(
+			std::vector<FrameBuffer::Plane>{ plane }));
+	}
+
+	unsigned int id = kParamsCookie;
+	for (std::unique_ptr<FrameBuffer> &buffer : data->paramsBuffers_) {
+		buffer->setCookie(id++);
+		data->ipaBuffers_.emplace_back(buffer->cookie(),
+					       std::vector<FrameBuffer::Plane>(buffer->planes().begin(),
+									       buffer->planes().end()));
+	}
+
+	id = kStatsCookie;
+	for (std::unique_ptr<FrameBuffer> &buffer : data->statsBuffers_) {
+		buffer->setCookie(id++);
+		data->ipaBuffers_.emplace_back(buffer->cookie(),
+					       std::vector<FrameBuffer::Plane>(buffer->planes().begin(),
+									       buffer->planes().end()));
+
+		void *mem = mmap(nullptr, sizeof(mtkisp50::StatsBuffer), PROT_READ | PROT_WRITE,
+				 MAP_SHARED, buffer->planes()[0].fd.get(), 0);
+		if (mem == MAP_FAILED)
+			return -errno;
+		auto *stats = static_cast<mtkisp50::StatsBuffer *>(mem);
+		stats->version = 0;
+		data->statsMaps_[buffer.get()] = stats;
+	}
+
+	if (data->ipa_)
+		data->ipa_->mapBuffers(data->ipaBuffers_);
+
+	/* The last params buffers are those of the ISP jobs of a series */
+	data->series_.paramsBuffers.clear();
+	if (data->series_.enabled) {
+		for (unsigned int i = 0; i < kSeriesParamsBuffers; i++)
+			data->series_.paramsBuffers.push_back(
+				data->paramsBuffers_[kParamsBufferCount + i].get());
+	}
+	data->frames_.init(data->paramsBuffers_, data->statsBuffers_,
+			   data->series_.paramsBuffers.size());
+
+	/* PD frames: without their buffers the image goes on alone */
+	data->pd_.active = false;
+	if (data->pd_.layout) {
+		ret = data->pd_.video->allocateBuffers(kPdBufferCount, &data->pd_.buffers);
+		if (ret < 0) {
+			LOG(MtkIsp50, Warning)
+				<< "No PD frames, no buffers: " << strerror(-ret);
+			data->pd_.buffers.clear();
+		} else {
+			data->pd_.active = true;
+		}
+	}
+
+	return 0;
+}
+
+void PipelineHandlerMtkIsp50::freeBuffers(Camera *camera)
+{
+	MtkIsp50CameraData *data = cameraData(camera);
+
+	data->frames_.clear();
+	data->statsDone_.clear();
+
+	if (data->ipa_ && !data->ipaBuffers_.empty()) {
+		std::vector<unsigned int> ids;
+		for (const IPABuffer &buffer : data->ipaBuffers_)
+			ids.push_back(buffer.id);
+		data->ipa_->unmapBuffers(ids);
+	}
+	data->ipaBuffers_.clear();
+
+	for (auto &[buffer, stats] : data->statsMaps_)
+		munmap(stats, sizeof(mtkisp50::StatsBuffer));
+	data->statsMaps_.clear();
+	data->statsBuffers_.clear();
+
+	if (data->ispActive()) {
+		dip_.params_->releaseBuffers();
+		if (data->outputs_ & MtkIsp50OutputMain)
+			dip_.main_->releaseBuffers();
+		if (data->outputs_ & MtkIsp50OutputScaled)
+			dip_.scaled_->releaseBuffers();
+		dip_.raw_->releaseBuffers();
+		if (dip_.hasBlend()) {
+			dip_.base_->releaseBuffers();
+			dip_.weight_->releaseBuffers();
+		}
+	}
+	data->series_.paramsBuffers.clear();
+	data->paramsBuffers_.clear();
+
+	data->availableRawBuffers_ = {};
+	data->video_->releaseBuffers();
+	data->rawBuffers_.clear();
+
+	if (data->pd_.active) {
+		data->pd_.video->releaseBuffers();
+		data->pd_.buffers.clear();
+		data->pd_.active = false;
+	}
+}
+
+int PipelineHandlerMtkIsp50::start(Camera *camera, const ControlList *controls)
+{
+	MtkIsp50CameraData *data = cameraData(camera);
+	std::optional<int32_t> startLens;
+	int ret;
+
+	ret = allocateBuffers(camera);
+	if (ret < 0) {
+		LOG(MtkIsp50, Error) << "Failed to allocate buffers: " << strerror(-ret);
+		freeBuffers(camera);
+		return ret;
+	}
+
+	/* Without the images of a series the still images are single frames */
+	data->nextFrame_ = 0;
+	data->paramsPending_ = 0;
+	if (data->series_.enabled) {
+		ret = allocateSeries(data);
+		if (ret) {
+			LOG(MtkIsp50, Warning)
+				<< "No multi-frame still images: " << strerror(-ret);
+			freeSeries(data);
+		}
+	}
+
+	if (data->ipa_) {
+		ipa::mtkisp50::StartResult result;
+		data->ipa_->start(controls ? *controls : ControlList{ controls::controls }, &result);
+		ret = result.ret;
+		ControlList &sensorControls = result.sensorControls;
+		ControlList &lensControls = result.lensControls;
+		if (ret) {
+			LOG(MtkIsp50, Error) << "Failed to start the IPA";
+			freeBuffers(camera);
+			return ret;
+		}
+
+		/*
+		 * Values carried over from the previous configuration; a new
+		 * frame length first, the exposure limit follows it.
+		 */
+		if (sensorControls.contains(V4L2_CID_VBLANK)) {
+			ControlList vblank(data->sensor_->controls());
+			vblank.set(V4L2_CID_VBLANK, sensorControls.get(V4L2_CID_VBLANK));
+			data->sensor_->setControls(&vblank);
+		}
+		if (!sensorControls.empty())
+			data->sensor_->setControls(&sensorControls);
+
+		CameraLens *lens = data->sensor_->focusLens();
+		if (lens && lensControls.contains(V4L2_CID_FOCUS_ABSOLUTE)) {
+			startLens = lensControls.get(V4L2_CID_FOCUS_ABSOLUTE).get<int32_t>();
+			lens->setFocusPosition(*startLens);
+		}
+	}
+
+	data->delayedCtrls_->reset();
+
+	activeData_ = data;
+
+	if (data->ispActive()) {
+		ret = dip_.start(data->outputs_);
+		if (ret) {
+			LOG(MtkIsp50, Error) << "Failed to start the ISP: " << strerror(-ret);
+			goto error;
+		}
+		data->frames_.startIsp(data->outputs_);
+	}
+
+	ret = data->video_->streamOn();
+	if (ret) {
+		LOG(MtkIsp50, Error) << "Failed to start the capture: " << strerror(-ret);
+		goto error;
+	}
+
+	/* The PD frames join the running sensor; the image goes on without */
+	if (data->pd_.active) {
+		data->pd_.matcher.reset();
+		data->pd_.matcher.setTolerance(kPdTolerance);
+		data->pd_.waiting.clear();
+		data->pd_.frames = data->pd_.paired = data->pd_.unpaired = 0;
+
+		int r = 0;
+		for (std::unique_ptr<FrameBuffer> &buffer : data->pd_.buffers) {
+			r = data->pd_.video->queueBuffer(buffer.get());
+			if (r)
+				break;
+		}
+		if (!r)
+			r = data->pd_.video->streamOn();
+		if (r)
+			LOG(MtkIsp50, Warning) << "No PD frames, start failed: " << strerror(-r);
+		data->pd_.streaming = !r;
+	}
+
+	/*
+	 * The capture side may move the lens when the stream starts (seninf
+	 * has a default position for it): the kept position goes again.
+	 */
+	if (startLens)
+		data->sensor_->focusLens()->setFocusPosition(*startLens);
+
+	return 0;
+
+error:
+	dip_.stop();
+	if (data->ipa_)
+		data->ipa_->stop();
+	activeData_ = nullptr;
+	freeBuffers(camera);
+	return ret;
+}
+
+void PipelineHandlerMtkIsp50::stopDevice(Camera *camera)
+{
+	MtkIsp50CameraData *data = cameraData(camera);
+
+	/* Returned buffers come back cancelled and complete their requests */
+	data->stopping_ = true;
+	data->frames_.holdIsp(true);
+	if (data->pd_.streaming) {
+		data->pd_.video->streamOff();
+		data->pd_.streaming = false;
+		data->pd_.waiting.clear();
+		data->pd_.matcher.reset();
+		LOG(MtkIsp50, Debug)
+			<< "PD frames: " << data->pd_.paired << " of " << data->pd_.frames
+			<< " statistics with their PD frame";
+	}
+	data->video_->streamOff();
+	if (data->ispActive())
+		dip_.stop();
+	stopSeries(data);
+
+	/* Wait for the statistics still running */
+	statsWorker_->invokeMethod(&MtkIsp50StatsWorker::clear, ConnectionTypeBlocking);
+	Thread::current()->dispatchMessages(Message::Type::InvokeMessage, this);
+
+	if (data->ipa_)
+		data->ipa_->stop();
+
+	/* Requests that did not complete yet, and those still waiting */
+	while (!data->pendingRequests_.empty()) {
+		cancelRequest(data->pendingRequests_.front());
+		data->pendingRequests_.pop();
+	}
+
+	while (MtkIsp50Frames::Info *info = data->frames_.first()) {
+		Request *request = info->request;
+
+		/* A frame of a series of the handler */
+		if (!request) {
+			data->frames_.remove(info);
+			continue;
+		}
+
+		/* The buffer of a still image waiting for its series */
+		if (info->outputBuffer && (!info->outputDone || info->held)) {
+			info->outputBuffer->_d()->cancel();
+			completeBuffer(request, info->outputBuffer);
+		}
+
+		if (info->scaledBuffer && !info->scaledDone) {
+			info->scaledBuffer->_d()->cancel();
+			completeBuffer(request, info->scaledBuffer);
+		}
+
+		if (info->rawBuffer && info->rawFromRequest) {
+			info->rawBuffer->_d()->cancel();
+			completeBuffer(request, info->rawBuffer);
+		}
+
+		data->frames_.remove(info);
+		completeRequest(request);
+	}
+
+	activeData_ = nullptr;
+	freeBuffers(camera);
+	freeSeries(data);
+	data->stopping_ = false;
+}
+
+int PipelineHandlerMtkIsp50::queueRequestDevice(Camera *camera, Request *request)
+{
+	MtkIsp50CameraData *data = cameraData(camera);
+
+	data->pendingRequests_.push(request);
+	queuePendingRequests(data);
+
+	return 0;
+}
+
+/*
+ * Queue the waiting requests to the capture device, as long as there are raw
+ * buffers: a request of the raw stream brings its own, the others take one of
+ * the internal pool and wait while it is empty.
+ */
+void PipelineHandlerMtkIsp50::queuePendingRequests(MtkIsp50CameraData *data)
+{
+	/* The frames of a series that is captured go first */
+	while (!data->stopping_ && queueSeriesFrame(data))
+		;
+	if (data->series_.state == MtkIsp50CameraData::Series::State::Capture &&
+	    data->series_.queued + 1 < data->series_.wanted)
+		return;
+
+	while (!data->stopping_ && !data->pendingRequests_.empty()) {
+		Request *request = data->pendingRequests_.front();
+
+		FrameBuffer *output = data->outputs_ & MtkIsp50OutputMain
+					      ? request->findBuffer(&data->outputStream_) : nullptr;
+		FrameBuffer *scaled = data->outputs_ & MtkIsp50OutputScaled
+					      ? request->findBuffer(&data->scaledStream_) : nullptr;
+		FrameBuffer *raw = data->rawActive_ ? request->findBuffer(&data->rawStream_) : nullptr;
+		const bool rawFromRequest = raw != nullptr;
+
+		if (!raw) {
+			if (data->availableRawBuffers_.empty())
+				return;
+			raw = data->availableRawBuffers_.front();
+		}
+
+		const unsigned int id = data->nextFrame_;
+		MtkIsp50Frames::Info *info =
+			data->frames_.create(id, request, raw, rawFromRequest, output, scaled);
+		if (!info)
+			return;
+
+		data->nextFrame_++;
+		data->pendingRequests_.pop();
+		if (!rawFromRequest)
+			data->availableRawBuffers_.pop();
+
+		if (data->ipa_)
+			data->ipa_->queueRequest(id, request->controls());
+
+		int ret = data->video_->queueBuffer(raw);
+		if (ret) {
+			LOG(MtkIsp50, Error) << "Failed to queue the raw buffer: " << strerror(-ret);
+			if (!rawFromRequest)
+				data->availableRawBuffers_.push(raw);
+			data->frames_.remove(info);
+			cancelRequest(request);
+		}
+	}
+}
+
+void PipelineHandlerMtkIsp50::recycleRaw(MtkIsp50CameraData *data, MtkIsp50Frames::Info *info)
+{
+	auto it = data->statsDone_.find(info->id);
+	const bool stats = it == data->statsDone_.end() || it->second;
+
+	if (!info->rawDone || !stats || !info->rawBuffer)
+		return;
+
+	FrameBuffer *raw = info->rawBuffer;
+	info->rawBuffer = nullptr;
+
+	if (info->rawFromRequest) {
+		completeBuffer(info->request, raw);
+	} else {
+		data->availableRawBuffers_.push(raw);
+		queuePendingRequests(data);
+	}
+}
+
+void PipelineHandlerMtkIsp50::tryComplete(MtkIsp50CameraData *data, MtkIsp50Frames::Info *info)
+{
+	recycleRaw(data, info);
+
+	/* The raw buffer must be back (statistics done) */
+	if (info->rawBuffer)
+		return;
+
+	Request *request = info->request;
+	const unsigned int id = info->id;
+	if (!data->frames_.tryComplete(info))
+		return;
+
+	data->statsDone_.erase(id);
+	if (request)
+		completeRequest(request);
+}
+
+/*
+ * A raw frame from the capture device: the IPA computes the parameters of the
+ * frame, the ISP job and the statistics follow in paramsComputed(). A frame
+ * that failed in capture gets no job and no statistics, its request completes.
+ */
+void PipelineHandlerMtkIsp50::rawBufferReady(FrameBuffer *buffer)
+{
+	MtkIsp50CameraData *data = activeData_;
+	if (!data)
+		return;
+
+	MtkIsp50Frames::Info *info = data->frames_.findCapture(buffer);
+	if (!info)
+		return;
+
+	Request *request = info->request;
+	info->captured = true;
+	info->rawSequence = buffer->metadata().sequence;
+	info->rawTimestamp = buffer->metadata().timestamp;
+
+	if (buffer->metadata().status != FrameMetadata::FrameSuccess) {
+		info->error = true;
+		info->rawDone = true;
+		info->paramsDone = true;
+		info->metadataDone = true;
+		if (!request) {
+			/* A frame of a series: it falls out */
+			info->outputDone = true;
+			seriesFrameBack(data, info, false);
+			tryComplete(data, info);
+			return;
+		}
+		if (info->outputBuffer && !info->outputDone) {
+			info->outputBuffer->_d()->cancel();
+			completeBuffer(request, info->outputBuffer);
+			info->outputDone = true;
+		}
+		if (info->scaledBuffer && !info->scaledDone) {
+			info->scaledBuffer->_d()->cancel();
+			completeBuffer(request, info->scaledBuffer);
+			info->scaledDone = true;
+		}
+		tryComplete(data, info);
+		return;
+	}
+
+	if (request) {
+		request->_d()->metadata().set(controls::SensorTimestamp,
+					      buffer->metadata().timestamp);
+		if (!data->scalerCrop_.isNull())
+			request->_d()->metadata().set(controls::ScalerCrop, data->scalerCrop_);
+	}
+
+	if (!data->ipa_) {
+		/* Raw only camera without IPA: nothing more to do */
+		info->rawDone = true;
+		info->paramsDone = true;
+		info->metadataDone = true;
+		tryComplete(data, info);
+		return;
+	}
+
+	/* While the series is blended and its ISP jobs wait or run, new frames wait */
+	const auto state = data->series_.state;
+	if (state == MtkIsp50CameraData::Series::State::IspWait ||
+	    state == MtkIsp50CameraData::Series::State::Blend ||
+	    state == MtkIsp50CameraData::Series::State::Isp) {
+		data->series_.deferred.push_back(info->id);
+		return;
+	}
+
+	computeParams(data, info);
+}
+
+/*
+ * A job with the still image of a session with still images, the others with
+ * the preview (or video) tuning; the still image may start a multi-frame
+ * series, the frames of the handler belong to one
+ */
+void PipelineHandlerMtkIsp50::computeParams(MtkIsp50CameraData *data, MtkIsp50Frames::Info *info)
+{
+	using ipa::mtkisp50::UseCase;
+
+	UseCase jobUse = data->useCase_;
+	if (!info->request)
+		jobUse = UseCase::SeriesFrame;
+	else if (jobUse == UseCase::Still && !info->outputBuffer)
+		jobUse = UseCase::Preview;
+	else if (jobUse == UseCase::Still && !data->series_.images.empty() &&
+		 data->series_.state == MtkIsp50CameraData::Series::State::Idle)
+		jobUse = UseCase::StillSeries;
+
+	data->paramsPending_++;
+	data->ipa_->computeParams(info->id, info->paramsBuffer->cookie(), jobUse);
+}
+
+void PipelineHandlerMtkIsp50::ispRawBufferReady(FrameBuffer *buffer)
+{
+	MtkIsp50CameraData *data = activeData_;
+	if (!data)
+		return;
+
+	if (data->series_.state == MtkIsp50CameraData::Series::State::Isp) {
+		seriesIspBufferBack(buffer);
+		return;
+	}
+
+	MtkIsp50Frames::Info *info = data->frames_.findIspRaw(buffer);
+	if (!info)
+		return;
+
+	info->rawDone = true;
+	ispJobBack(data, info);
+	tryComplete(data, info);
+}
+
+void PipelineHandlerMtkIsp50::ispOutputBufferReady(FrameBuffer *buffer)
+{
+	MtkIsp50CameraData *data = activeData_;
+	if (!data)
+		return;
+
+	if (data->series_.state == MtkIsp50CameraData::Series::State::Isp) {
+		seriesIspBufferBack(buffer);
+		return;
+	}
+
+	MtkIsp50Frames::Info *info = data->frames_.findOutput(buffer);
+	if (!info)
+		return;
+
+	/* An image of a series: it stays with the handler */
+	if (info->series) {
+		info->outputDone = true;
+		ispJobBack(data, info);
+		seriesFrameBack(data, info,
+				buffer->metadata().status == FrameMetadata::FrameSuccess);
+		tryComplete(data, info);
+		return;
+	}
+
+	if (buffer->metadata().status != FrameMetadata::FrameSuccess)
+		info->error = true;
+
+	info->outputDone = true;
+	completeBuffer(info->request, buffer);
+	ispJobBack(data, info);
+	tryComplete(data, info);
+}
+
+void PipelineHandlerMtkIsp50::ispScaledBufferReady(FrameBuffer *buffer)
+{
+	MtkIsp50CameraData *data = activeData_;
+	if (!data)
+		return;
+
+	MtkIsp50Frames::Info *info = data->frames_.findScaled(buffer);
+	if (!info)
+		return;
+
+	if (buffer->metadata().status != FrameMetadata::FrameSuccess)
+		info->error = true;
+
+	info->scaledDone = true;
+	completeBuffer(info->request, buffer);
+	ispJobBack(data, info);
+	tryComplete(data, info);
+}
+
+void PipelineHandlerMtkIsp50::ispParamsBufferReady(FrameBuffer *buffer)
+{
+	MtkIsp50CameraData *data = activeData_;
+	if (!data)
+		return;
+
+	if (data->series_.state == MtkIsp50CameraData::Series::State::Isp) {
+		seriesIspBufferBack(buffer);
+		return;
+	}
+
+	MtkIsp50Frames::Info *info = data->frames_.findParams(buffer);
+	if (!info)
+		return;
+
+	info->paramsDone = true;
+	tryComplete(data, info);
+}
+
+/* The statistics of the raw frame, also while the ISP works on it */
+void PipelineHandlerMtkIsp50::dispatchStats(MtkIsp50CameraData *data, MtkIsp50Frames::Info *info,
+					    const ipa::mtkisp50::StatsConfig &config, FrameBuffer *pd)
+{
+	if (data->pd_.streaming && config.pd) {
+		data->pd_.frames++;
+		if (pd)
+			data->pd_.paired++;
+		else
+			data->pd_.unpaired++;
+	}
+
+	info->pdBuffer = pd;
+	statsWorker_->invokeMethod(&MtkIsp50StatsWorker::process, ConnectionTypeQueued,
+				   info->id, info->rawBuffer, data->statsMaps_[info->statsBuffer],
+				   config, true, pd);
+}
+
+/*
+ * Frames waiting for their PD frame: those whose PD frame came, or cannot
+ * come any more, go on; with @all every one goes, with or without.
+ */
+void PipelineHandlerMtkIsp50::dispatchPdWaiting(MtkIsp50CameraData *data, bool all)
+{
+	auto &waiting = data->pd_.waiting;
+
+	while (!waiting.empty()) {
+		auto &[id, config] = waiting.front();
+		MtkIsp50Frames::Info *info = data->frames_.find(id);
+		if (!info) {
+			waiting.pop_front();
+			continue;
+		}
+
+		std::vector<FrameBuffer *> release;
+		FrameBuffer *pd = data->pd_.matcher.take(info->rawTimestamp, &release);
+		queuePdBuffers(data, release);
+
+		if (!pd && !all && data->pd_.matcher.mayCome(info->rawTimestamp))
+			break;
+
+		dispatchStats(data, info, config, pd);
+		waiting.pop_front();
+	}
+}
+
+void PipelineHandlerMtkIsp50::queuePdBuffers(MtkIsp50CameraData *data,
+					     const std::vector<FrameBuffer *> &buffers)
+{
+	for (FrameBuffer *buffer : buffers) {
+		if (!data->pd_.streaming || data->stopping_)
+			continue;
+		int ret = data->pd_.video->queueBuffer(buffer);
+		if (ret)
+			LOG(MtkIsp50, Error) << "Failed to queue a PD buffer: " << strerror(-ret);
+	}
+}
+
+/* A PD frame: it waits for the raw frame of the same sensor frame */
+void PipelineHandlerMtkIsp50::pdBufferReady(FrameBuffer *buffer)
+{
+	MtkIsp50CameraData *data = activeData_;
+	if (!data || !data->pd_.streaming || data->stopping_)
+		return;
+
+	const FrameMetadata &metadata = buffer->metadata();
+	if (metadata.status != FrameMetadata::FrameSuccess) {
+		queuePdBuffers(data, { buffer });
+		return;
+	}
+
+	std::vector<FrameBuffer *> release;
+	data->pd_.matcher.push({ buffer, metadata.timestamp, metadata.sequence }, &release);
+	queuePdBuffers(data, release);
+
+	dispatchPdWaiting(data, false);
+}
+
+void PipelineHandlerMtkIsp50::statsDone(uint32_t frame)
+{
+	MtkIsp50CameraData *data = activeData_;
+	if (!data)
+		return;
+
+	MtkIsp50Frames::Info *info = data->frames_.find(frame);
+	if (!info)
+		return;
+
+	data->statsDone_[frame] = true;
+	recycleRaw(data, info);
+
+	/* The PD frame is read: back to the capture device */
+	if (info->pdBuffer) {
+		queuePdBuffers(data, { info->pdBuffer });
+		info->pdBuffer = nullptr;
+	}
+
+	data->ipa_->processStats(frame, info->statsBuffer->cookie(),
+				 data->delayedCtrls_->get(frame));
+
+	tryComplete(data, info);
+}
+
+/*
+ * Queue the ISP jobs that may go. A job that fails gives back the outputs
+ * not queued; a raw buffer alone in the ISP would meet the outputs of the
+ * next job, so the ISP restarts and returns the buffers queued.
+ */
+void PipelineHandlerMtkIsp50::runIspJobs(MtkIsp50CameraData *data)
+{
+	if (data->ispRunning_)
+		return;
+	data->ispRunning_ = true;
+
+	MtkIsp50Frames::Info *failed = nullptr;
+	int ret;
+	while ((ret = data->frames_.runIspJobs(dip_, &failed))) {
+		Request *request = failed->request;
+
+		LOG(MtkIsp50, Error)
+			<< "Failed to queue the ISP job of frame " << failed->id << ": "
+			<< strerror(-ret);
+
+		if (failed->outputBuffer && !failed->outputQueued) {
+			if (failed->series) {
+				seriesFrameBack(data, failed, false);
+			} else {
+				failed->outputBuffer->_d()->cancel();
+				completeBuffer(request, failed->outputBuffer);
+			}
+		}
+		if (failed->scaledBuffer && !failed->scaledQueued) {
+			failed->scaledBuffer->_d()->cancel();
+			completeBuffer(request, failed->scaledBuffer);
+		}
+
+		if (failed->ispQueued)
+			restartIsp(data);
+
+		tryComplete(data, failed);
+	}
+
+	data->ispRunning_ = false;
+}
+
+/* The buffers of an ISP job are back: the next jobs may go */
+void PipelineHandlerMtkIsp50::ispJobBack(MtkIsp50CameraData *data, MtkIsp50Frames::Info *info)
+{
+	if (data->frames_.ispJobBack(info)) {
+		runIspJobs(data);
+		trySeriesIsp(data);
+	}
+}
+
+/*
+ * Stop and start the ISP queues: the buffers in them come back cancelled.
+ * Used when a job could only be queued in part.
+ */
+void PipelineHandlerMtkIsp50::restartIsp([[maybe_unused]] MtkIsp50CameraData *data)
+{
+	const unsigned int outputs = dip_.streaming_;
+
+	data->frames_.holdIsp(true);
+	dip_.stop();
+	int ret = dip_.start(outputs);
+	data->frames_.holdIsp(false);
+	if (ret)
+		LOG(MtkIsp50, Error) << "Failed to restart the ISP: " << strerror(-ret);
+
+	/* The driver keeps the parameters of the ISP, nothing to send again */
+}
+
+/* -----------------------------------------------------------------------------
+ * Multi-frame still images
+ *
+ * A still image whose sensitivity calls for a series (the IPA decides when it
+ * computes the parameters of its frame) is the first frame of the series; the
+ * handler captures the other frames on its own (frames without request, before
+ * further requests) with the parameters of the first one. The ISP writes the
+ * first frame into the buffer of the still image and the others into images of
+ * the series. Then the ISP finishes its jobs and stops; the worker aligns and
+ * blends the frames in the MFB (the DIP and the MFB share a memory port whose
+ * use the drivers do not serialise yet, they do not run at the same time).
+ * Then two ISP jobs with the NV12 input: the noise reduction of the base frame
+ * and the blend of the result with it over the weight map into the buffer of
+ * the still image. Frames that come meanwhile wait with their parameters, so
+ * that the jobs reach the ISP in the order the IPA computed their parameters.
+ */
+
+namespace {
+
+void setPayload(FrameBuffer *buffer)
+{
+	FrameMetadata &metadata = buffer->_d()->metadata();
+	for (unsigned int i = 0; i < buffer->planes().size(); i++)
+		metadata.planes()[i].bytesused = buffer->planes()[i].length;
+}
+
+double msBetween(std::chrono::steady_clock::time_point a, std::chrono::steady_clock::time_point b)
+{
+	return std::chrono::duration<double, std::milli>(b - a).count();
+}
+
+} /* namespace */
+
+int PipelineHandlerMtkIsp50::allocateSeries(MtkIsp50CameraData *data)
+{
+	auto &s = data->series_;
+	const StreamConfiguration &cfg = data->outputStream_.configuration();
+
+	std::vector<SharedFD> images, maps;
+	int ret = seriesWorker_->invokeMethod(&MtkIsp50SeriesWorker::configure,
+					      ConnectionTypeBlocking, cfg.size.width,
+					      cfg.size.height, cfg.stride, kSeriesMaxFrames,
+					      kSeriesMinImages, &images, &maps);
+	if (ret)
+		return ret;
+
+	const size_t ySize = static_cast<size_t>(cfg.stride) * cfg.size.height;
+	s.imageSize = ySize * 3 / 2;
+
+	std::vector<MtkIsp50SeriesImage> list;
+	for (const SharedFD &fd : images) {
+		std::vector<FrameBuffer::Plane> planes(2);
+		planes[0].fd = fd;
+		planes[0].offset = 0;
+		planes[0].length = ySize;
+		planes[1].fd = fd;
+		planes[1].offset = ySize;
+		planes[1].length = ySize / 2;
+		s.images.push_back(std::make_unique<FrameBuffer>(planes));
+		list.push_back({ fd, s.imageSize });
+	}
+
+	for (const SharedFD &fd : maps) {
+		std::vector<FrameBuffer::Plane> planes(1);
+		planes[0].fd = fd;
+		planes[0].offset = 0;
+		planes[0].length = ySize;
+		s.maps.push_back(std::make_unique<FrameBuffer>(planes));
+	}
+
+	seriesWorker_->invokeMethod(&MtkIsp50SeriesWorker::setImages, ConnectionTypeBlocking, list);
+
+	LOG(MtkIsp50, Info)
+		<< "Multi-frame still images: " << s.images.size() << " frames at most, "
+		<< (s.images.size() * s.imageSize + s.maps.size() * ySize) / (1 << 20)
+		<< " MiB";
+
+	return 0;
+}
+
+void PipelineHandlerMtkIsp50::freeSeries(MtkIsp50CameraData *data)
+{
+	auto &s = data->series_;
+
+	s.timeout.stop();
+	if (seriesWorker_)
+		seriesWorker_->invokeMethod(&MtkIsp50SeriesWorker::release, ConnectionTypeBlocking);
+
+	s.images.clear();
+	s.maps.clear();
+	s.state = MtkIsp50CameraData::Series::State::Idle;
+	s.request = nullptr;
+	s.appBuffer = nullptr;
+	s.deferred.clear();
+	s.frames.clear();
+}
+
+/* Queue a frame of the handler for the series being captured */
+bool PipelineHandlerMtkIsp50::queueSeriesFrame(MtkIsp50CameraData *data)
+{
+	auto &s = data->series_;
+
+	if (s.state != MtkIsp50CameraData::Series::State::Capture ||
+	    s.queued + 1 >= s.wanted || data->availableRawBuffers_.empty())
+		return false;
+
+	FrameBuffer *raw = data->availableRawBuffers_.front();
+	const unsigned int id = data->nextFrame_;
+	MtkIsp50Frames::Info *info =
+		data->frames_.create(id, nullptr, raw, false, s.images[s.queued].get());
+	if (!info)
+		return false;
+
+	data->nextFrame_++;
+	data->availableRawBuffers_.pop();
+	info->series = true;
+	s.queued++;
+
+	data->ipa_->queueRequest(id, ControlList{ controls::controls });
+
+	int ret = data->video_->queueBuffer(raw);
+	if (ret) {
+		LOG(MtkIsp50, Error) << "Failed to queue a frame of the series: " << strerror(-ret);
+		data->availableRawBuffers_.push(raw);
+		data->frames_.remove(info);
+		s.wanted--;
+		s.queued--;
+		return false;
+	}
+
+	return true;
+}
+
+void PipelineHandlerMtkIsp50::startSeries(MtkIsp50CameraData *data, MtkIsp50Frames::Info *info,
+					  unsigned int frames)
+{
+	auto &s = data->series_;
+
+	if (s.state != MtkIsp50CameraData::Series::State::Idle || s.images.empty() ||
+	    !info->request || !info->outputBuffer) {
+		LOG(MtkIsp50, Error) << "Frame " << info->id << ": no series possible";
+		data->ipa_->seriesEnd();
+		return;
+	}
+
+	s.state = MtkIsp50CameraData::Series::State::Capture;
+	s.still = info->id;
+	s.request = info->request;
+	s.appBuffer = info->outputBuffer;
+	s.wanted = std::min<unsigned int>(frames, s.images.size());
+	s.queued = 0;
+	s.finished = 0;
+	s.frames.clear();
+	s.deferred.clear();
+	s.result = {};
+	s.ispStep = 0;
+	s.ispPending = 0;
+	s.ispError = false;
+	s.fallback = false;
+	s.tStart = std::chrono::steady_clock::now();
+	s.timeout.start(kSeriesCaptureTimeout);
+
+	info->series = true;
+	info->held = true;
+
+	queuePendingRequests(data);
+}
+
+/*
+ * A frame of the series is back from the ISP (or fell out, @ok false); with
+ * @info nullptr only check whether the capture is complete
+ */
+void PipelineHandlerMtkIsp50::seriesFrameBack(MtkIsp50CameraData *data,
+					      MtkIsp50Frames::Info *info, bool ok)
+{
+	auto &s = data->series_;
+	if (s.state != MtkIsp50CameraData::Series::State::Capture)
+		return;
+
+	if (info) {
+		s.finished++;
+		if (ok) {
+			if (info->request) {
+				s.frames.push_back(s.appImage());
+			} else {
+				for (unsigned int i = 0; i < s.images.size(); i++) {
+					if (s.images[i].get() == info->outputBuffer)
+						s.frames.push_back(i);
+				}
+			}
+		} else {
+			LOG(MtkIsp50, Warning) << "Frame " << info->id << " of the series failed";
+		}
+	}
+
+	if (s.finished < s.wanted)
+		return;
+
+	s.timeout.stop();
+	s.tCaptured = std::chrono::steady_clock::now();
+	data->ipa_->seriesCaptured();
+
+	/*
+	 * The blending block and the DIP do not run at the same time (they
+	 * share a memory port, the drivers do not serialise its use yet): the
+	 * DIP finishes its jobs and waits for the blends and its two jobs of
+	 * the series
+	 */
+	s.fallback = s.frames.size() < 2;
+	s.state = MtkIsp50CameraData::Series::State::IspWait;
+	trySeriesIsp(data);
+}
+
+/* Align and blend the series in the worker */
+void PipelineHandlerMtkIsp50::startBlend(MtkIsp50CameraData *data)
+{
+	auto &s = data->series_;
+
+	/* The buffer of the still image is the last image of the worker */
+	std::vector<MtkIsp50SeriesImage> list;
+	for (const auto &image : s.images)
+		list.push_back({ image->planes()[0].fd, s.imageSize });
+	list.push_back({ s.appBuffer->planes()[0].fd, s.imageSize });
+
+	MtkIsp50SeriesJob job;
+	job.frames = s.frames;
+	job.appImage = s.appImage();
+	job.warpImage = s.warpImage();
+	for (unsigned int i = 0; i < s.warpImage(); i++) {
+		if (std::find(s.frames.begin(), s.frames.end(), i) == s.frames.end())
+			job.free.push_back(i);
+	}
+	data->ipa_->blendParams(s.still, &job.blendParams);
+
+	s.state = MtkIsp50CameraData::Series::State::Blend;
+	seriesWorker_->invokeMethod(&MtkIsp50SeriesWorker::setImages, ConnectionTypeQueued, list);
+	seriesWorker_->invokeMethod(&MtkIsp50SeriesWorker::process, ConnectionTypeQueued, job);
+}
+
+/*
+ * The series takes too long to capture: on with the frames back so far. The
+ * frames still on their way fall out: those in the ISP finish before the
+ * blends, the others wait as any new frame until the series is done.
+ */
+void PipelineHandlerMtkIsp50::seriesCaptureTimeout()
+{
+	MtkIsp50CameraData *data = activeData_;
+	if (!data || data->series_.state != MtkIsp50CameraData::Series::State::Capture)
+		return;
+
+	auto &s = data->series_;
+	LOG(MtkIsp50, Warning)
+		<< "Series capture timed out, " << s.finished << " of " << s.wanted << " frames back";
+	s.wanted = s.finished;
+	seriesFrameBack(data, nullptr, false);
+}
+
+void PipelineHandlerMtkIsp50::seriesBlended(const MtkIsp50SeriesResult &result)
+{
+	MtkIsp50CameraData *data = activeData_;
+	if (!data || data->stopping_ ||
+	    data->series_.state != MtkIsp50CameraData::Series::State::Blend)
+		return;
+
+	auto &s = data->series_;
+	s.result = result;
+	s.tBlended = std::chrono::steady_clock::now();
+	if (result.status || !result.blends || result.blended < 0 || result.map < 0) {
+		LOG(MtkIsp50, Warning)
+			<< "Series not blended (" << strerror(-result.status)
+			<< "), single frame";
+		s.fallback = true;
+	}
+
+	startSeriesIsp(data);
+}
+
+/*
+ * Once the ISP is idle and no parameters are being computed: hold the ISP,
+ * blend the series, then its two ISP jobs
+ */
+void PipelineHandlerMtkIsp50::trySeriesIsp(MtkIsp50CameraData *data)
+{
+	auto &s = data->series_;
+
+	if (s.state != MtkIsp50CameraData::Series::State::IspWait || data->stopping_ ||
+	    data->paramsPending_ || data->frames_.ispWaiting() || data->frames_.ispBusy())
+		return;
+
+	data->frames_.holdIsp(true);
+	s.tDrained = std::chrono::steady_clock::now();
+
+	if (!s.fallback) {
+		startBlend(data);
+		return;
+	}
+
+	s.tBlended = s.tDrained;
+	startSeriesIsp(data);
+}
+
+/*
+ * The ISP jobs of the series: switch the ISP to the NV12 input, the noise
+ * reduction of the base frame, the blend
+ */
+void PipelineHandlerMtkIsp50::startSeriesIsp(MtkIsp50CameraData *data)
+{
+	auto &s = data->series_;
+
+	s.state = MtkIsp50CameraData::Series::State::Isp;
+	s.tIsp = std::chrono::steady_clock::now();
+
+	/* The base frame: from the worker, for a fallback the first good frame */
+	if (s.result.base < 0)
+		s.result.base = s.frames.empty() ? -1 : static_cast<int>(s.frames.front());
+	if (s.result.base < 0) {
+		finishSeries(data, false);
+		return;
+	}
+
+	/* Parameters of both jobs, in the order of the encoder of the IPA */
+	data->ipa_->seriesParams(s.paramsBuffers[0]->cookie(), s.paramsBuffers[1]->cookie(),
+				 &s.paramsBytes[0], &s.paramsBytes[1]);
+
+	dip_.stop();
+	dip_.raw_->releaseBuffers();
+
+	const StreamConfiguration &cfg = data->outputStream_.configuration();
+	V4L2DeviceFormat format;
+	format.fourcc = V4L2PixelFormat(V4L2_PIX_FMT_NV12);
+	format.size = cfg.size;
+	format.planesCount = 1;
+	format.planes[0].bpl = cfg.stride;
+	int ret = dip_.raw_->setFormat(&format);
+	if (!ret && (format.size != cfg.size || format.planes[0].bpl != cfg.stride))
+		ret = -EINVAL;
+	if (!ret)
+		ret = dip_.raw_->importBuffers(4);
+	if (ret >= 0)
+		ret = dip_.base_->importBuffers(2);
+	if (ret >= 0)
+		ret = dip_.weight_->importBuffers(2);
+	if (ret >= 0)
+		ret = dip_.startBlend();
+	if (ret < 0) {
+		LOG(MtkIsp50, Error) << "ISP not ready for the NV12 jobs: " << strerror(-ret);
+		finishSeries(data, false);
+		return;
+	}
+
+	s.ispStep = 0;
+	ret = queueSeriesJob(data);
+	if (ret) {
+		LOG(MtkIsp50, Error) << "Failed to queue the series job: " << strerror(-ret);
+		finishSeries(data, false);
+	}
+}
+
+int PipelineHandlerMtkIsp50::queueSeriesJob(MtkIsp50CameraData *data)
+{
+	auto &s = data->series_;
+	auto image = [&](int index) {
+		return static_cast<unsigned int>(index) == s.appImage() ? s.appBuffer
+									: s.images[index].get();
+	};
+
+	FrameBuffer *in, *base, *weight, *out;
+	if (s.ispStep == 0) {
+		/* Noise reduction of the base frame, blend off */
+		in = image(s.result.base);
+		base = in;
+		weight = s.maps[0].get();
+		out = s.fallback && in != s.appBuffer ? s.appBuffer
+						      : s.images[s.warpImage()].get();
+	} else {
+		/* Blend of the series with the base frame */
+		in = image(s.result.blended);
+		base = s.images[s.warpImage()].get();
+		weight = s.maps[s.result.map].get();
+		out = s.appBuffer;
+	}
+
+	setPayload(in);
+	setPayload(base);
+	setPayload(weight);
+
+	s.ispError = false;
+	s.ispPending = 0;
+	FrameBuffer *params = s.paramsBuffers[s.ispStep];
+	const uint32_t bytes = s.paramsBytes[s.ispStep];
+	int ret = 0;
+	if (bytes) {
+		ret = dip_.queueParams(params, bytes);
+		if (!ret)
+			s.ispPending++;
+	}
+	if (!ret) {
+		ret = dip_.main_->queueBuffer(out);
+		if (!ret)
+			s.ispPending++;
+	}
+	if (!ret) {
+		ret = dip_.base_->queueBuffer(base);
+		if (!ret)
+			s.ispPending++;
+	}
+	if (!ret) {
+		ret = dip_.weight_->queueBuffer(weight);
+		if (!ret)
+			s.ispPending++;
+	}
+	if (!ret) {
+		ret = dip_.raw_->queueBuffer(in);
+		if (!ret)
+			s.ispPending++;
+	}
+
+	return ret;
+}
+
+/* A buffer of an ISP job of the series is back */
+void PipelineHandlerMtkIsp50::seriesIspBufferBack(FrameBuffer *buffer)
+{
+	MtkIsp50CameraData *data = activeData_;
+	if (!data || data->stopping_ ||
+	    data->series_.state != MtkIsp50CameraData::Series::State::Isp)
+		return;
+
+	auto &s = data->series_;
+	if (buffer->metadata().status != FrameMetadata::FrameSuccess)
+		s.ispError = true;
+	if (s.ispPending && --s.ispPending)
+		return;
+
+	if (s.ispError) {
+		LOG(MtkIsp50, Error) << "ISP job " << s.ispStep << " of the series failed";
+		finishSeries(data, false);
+		return;
+	}
+
+	if (s.ispStep == 0 && !s.fallback) {
+		s.ispStep = 1;
+		int ret = queueSeriesJob(data);
+		if (ret) {
+			LOG(MtkIsp50, Error) << "Failed to queue the blend job: " << strerror(-ret);
+			finishSeries(data, false);
+		}
+		return;
+	}
+
+	/* Fallback with the base frame in the buffer of the still image: copy */
+	if (s.fallback && static_cast<unsigned int>(s.result.base) == s.appImage()) {
+		MappedFrameBuffer from(s.images[s.warpImage()].get(), MappedFrameBuffer::MapFlag::Read);
+		MappedFrameBuffer to(s.appBuffer, MappedFrameBuffer::MapFlag::Write);
+		if (from.isValid() && to.isValid()) {
+			DmaSyncer syncFrom(s.images[s.warpImage()]->planes()[0].fd,
+					   DmaSyncer::SyncType::Read);
+			DmaSyncer syncTo(s.appBuffer->planes()[0].fd, DmaSyncer::SyncType::Write);
+			for (unsigned int i = 0; i < from.planes().size(); i++)
+				memcpy(to.planes()[i].data(), from.planes()[i].data(),
+				       std::min(from.planes()[i].size(), to.planes()[i].size()));
+		} else {
+			s.ispError = true;
+		}
+	}
+
+	finishSeries(data, !s.ispError);
+}
+
+/* Back to the raw input: the ISP as before the series */
+int PipelineHandlerMtkIsp50::rawIspInput(MtkIsp50CameraData *data)
+{
+	dip_.raw_->releaseBuffers();
+	dip_.base_->releaseBuffers();
+	dip_.weight_->releaseBuffers();
+
+	V4L2DeviceFormat raw = data->rawFormat_;
+	int ret = dip_.raw_->setFormat(&raw);
+	Rectangle crop = data->crop_;
+	if (!ret)
+		ret = dip_.raw_->setSelection(V4L2_SEL_TGT_CROP, &crop);
+
+	return ret;
+}
+
+int PipelineHandlerMtkIsp50::restoreIsp(MtkIsp50CameraData *data)
+{
+	dip_.stop();
+
+	int ret = rawIspInput(data);
+	if (!ret)
+		ret = dip_.raw_->importBuffers(data->rawSlots_);
+
+	unsigned int outputs = data->frames_.ispOutputs();
+	if (outputs == ~0u)
+		outputs = data->outputs_;
+	if (ret >= 0)
+		ret = dip_.start(outputs);
+	data->frames_.resumeIsp(outputs);
+
+	if (ret < 0)
+		LOG(MtkIsp50, Error) << "Failed to restore the ISP: " << strerror(-ret);
+
+	return ret < 0 ? ret : 0;
+}
+
+/*
+ * The camera stops during a series: the worker lets go of the buffers before
+ * their requests complete, the ISP gets its raw input back for the next start
+ */
+void PipelineHandlerMtkIsp50::stopSeries(MtkIsp50CameraData *data)
+{
+	using State = MtkIsp50CameraData::Series::State;
+	auto &s = data->series_;
+	if (s.state == State::Idle)
+		return;
+
+	static const char *const names[] = { "idle", "capture", "blend", "ISP wait", "ISP" };
+	LOG(MtkIsp50, Info)
+		<< "Series of frame " << s.still << " stopped ("
+		<< names[static_cast<unsigned int>(s.state)] << ")";
+
+	s.timeout.stop();
+	if (s.state == State::Blend && seriesWorker_) {
+		seriesWorker_->abort();
+		seriesWorker_->invokeMethod(&MtkIsp50SeriesWorker::sync, ConnectionTypeBlocking);
+	}
+
+	if (s.state == State::Isp) {
+		int ret = rawIspInput(data);
+		if (ret)
+			LOG(MtkIsp50, Error) << "Failed to restore the ISP input: " << strerror(-ret);
+	}
+
+	s.state = State::Idle;
+}
+
+void PipelineHandlerMtkIsp50::finishSeries(MtkIsp50CameraData *data, bool ok)
+{
+	auto &s = data->series_;
+	const auto now = std::chrono::steady_clock::now();
+
+	if (s.state == MtkIsp50CameraData::Series::State::Isp)
+		restoreIsp(data);
+	else
+		data->frames_.holdIsp(false);
+
+	/* The IPA forgets the series also when its ISP jobs did not come */
+	data->ipa_->seriesEnd();
+
+	LOG(MtkIsp50, Info)
+		<< "Series of frame " << s.still << ": " << s.frames.size() << " of " << s.wanted
+		<< " frames, " << s.result.blends << " blends" << (s.fallback ? " (single frame)" : "")
+		<< (ok ? "" : ", failed") << "; capture "
+		<< msBetween(s.tStart, s.tCaptured) << " ms, estimate " << s.result.tEstimate
+		<< " ms (reduce " << s.result.tReduce << " ms, match " << s.result.tMatch
+		<< " ms, fit " << s.result.tFit << " ms), warp " << s.result.tWarp << " ms, blend " << s.result.tBlend
+		<< " ms, worker " << s.result.tTotal << " ms, wait for the ISP "
+		<< msBetween(s.tCaptured, s.tDrained) << " ms, ISP jobs " << msBetween(s.tIsp, now)
+		<< " ms, total " << msBetween(s.tStart, now) << " ms";
+
+	Request *request = s.request;
+	FrameBuffer *app = s.appBuffer;
+	s.state = MtkIsp50CameraData::Series::State::Idle;
+	s.request = nullptr;
+	s.appBuffer = nullptr;
+
+	if (request && app) {
+		if (!ok)
+			app->_d()->cancel();
+		completeBuffer(request, app);
+	}
+
+	MtkIsp50Frames::Info *still = data->frames_.find(s.still);
+	if (still) {
+		still->held = false;
+		tryComplete(data, still);
+	}
+
+	/* The frames that waited */
+	std::deque<unsigned int> deferred = std::move(s.deferred);
+	s.deferred.clear();
+	for (unsigned int id : deferred) {
+		MtkIsp50Frames::Info *info = data->frames_.find(id);
+		if (info)
+			computeParams(data, info);
+	}
+
+	runIspJobs(data);
+	queuePendingRequests(data);
+}
+
+/* The routing of other users does not have the PD route */
+void PipelineHandlerMtkIsp50::releaseDevice(Camera *camera)
+{
+	cameraData(camera)->restoreRouting();
+}
+
+bool PipelineHandlerMtkIsp50::acquireDevice([[maybe_unused]] Camera *camera)
+{
+	/* One DIP: one camera at a time */
+	if (useCount() > 0) {
+		LOG(MtkIsp50, Error) << "Another camera of the ISP is in use";
+		return false;
+	}
+
+	return true;
+}
+
+/*
+ * The handler takes over the devices of the simple pipeline handler with the
+ * DIP backend of the software ISP. Until it replaces that one, it only
+ * matches when it is asked for: listed in pipelines_match_list, or enabled
+ * with pipelines.mtkisp50.enabled in the configuration file.
+ */
+bool PipelineHandlerMtkIsp50::enabled() const
+{
+	const GlobalConfiguration &configuration = cameraManager()->_d()->configuration();
+
+	const auto list = configuration.listOption({ "pipelines_match_list" });
+	if (list && std::find(list->begin(), list->end(), "mtkisp50") != list->end())
+		return true;
+
+	return configuration.option<bool>({ "pipelines", "mtkisp50", "enabled" }).value_or(false);
+}
+
+int PipelineHandlerMtkIsp50::createCamera(MediaEntity *sensor)
+{
+	std::unique_ptr<MtkIsp50CameraData> data = std::make_unique<MtkIsp50CameraData>(this);
+
+	int ret = data->init(sensor);
+	if (ret) {
+		LOG(MtkIsp50, Warning)
+			<< "No camera for " << sensor->name() << ": " << strerror(-ret);
+		return ret;
+	}
+
+	/*
+	 * The DIP takes Bayer orders and bit depths of its raw formats only;
+	 * other sensors give their raw frames.
+	 */
+	BayerFormat bayer;
+	for (unsigned int code : data->sensor_->mbusCodes()) {
+		bayer = BayerFormat::fromMbusCode(code);
+		if (bayer.isValid() && (bayer.bitDepth == 10 || bayer.bitDepth == 8))
+			break;
+		bayer = {};
+	}
+	if (bayer.bitDepth == 10)
+		bayer.packing = BayerFormat::Packing::MTISP;
+
+	const bool ispFormat = bayer.isValid() && dip_.supports(rawPixelFormat(bayer));
+	if (ispFormat) {
+		ret = data->loadIPA();
+		if (ret) {
+			LOG(MtkIsp50, Warning)
+				<< "No IPA for " << data->sensor_->id() << ", raw frames only";
+			data->ipa_.reset();
+		}
+	} else {
+		LOG(MtkIsp50, Info)
+			<< "The ISP does not take the frames of " << data->sensor_->id()
+			<< ", raw frames only";
+	}
+	data->ispAvailable_ = ispFormat && data->ipa_;
+
+	/* Sensor modes in rising size */
+	for (unsigned int code : data->sensor_->mbusCodes()) {
+		for (const Size &size : data->sensor_->sizes(code))
+			data->modes_.push_back(size);
+	}
+	std::sort(data->modes_.begin(), data->modes_.end());
+	data->modes_.erase(std::unique(data->modes_.begin(), data->modes_.end()),
+			   data->modes_.end());
+
+	if (data->ipa_)
+		data->controlInfo_ = data->ipaControls_;
+
+	/* Largest crop: the analogue crop of the current sensor mode */
+	IPACameraSensorInfo sensorInfo{};
+	if (!data->sensor_->sensorInfo(&sensorInfo))
+		data->properties_.set(properties::ScalerCropMaximum, sensorInfo.analogCrop);
+
+	data->video_->bufferReady.connect(this, &PipelineHandlerMtkIsp50::rawBufferReady);
+	data->series_.timeout.timeout.connect(this, &PipelineHandlerMtkIsp50::seriesCaptureTimeout);
+	if (data->pd_.video)
+		data->pd_.video->bufferReady.connect(this, &PipelineHandlerMtkIsp50::pdBufferReady);
+
+	std::set<Stream *> streams = { &data->outputStream_, &data->scaledStream_,
+				       &data->rawStream_ };
+	const std::string &id = data->sensor_->id();
+	std::shared_ptr<Camera> camera =
+		Camera::create(std::move(data), id, streams);
+	registerCamera(std::move(camera));
+
+	return 0;
+}
+
+bool PipelineHandlerMtkIsp50::match(DeviceEnumerator *enumerator)
+{
+	if (!enabled())
+		return false;
+
+	DeviceMatch camsysDm("mtk-seninf");
+	camsysDm.add(std::regex("[0-9a-f]+\\.seninf"));
+
+	DeviceMatch dipDm("mtk-dip");
+	dipDm.add("mtk-dip-raw");
+	dipDm.add("mtk-dip-params");
+	dipDm.add("mtk-dip-main");
+
+	camsys_ = acquireMediaDevice(enumerator, camsysDm);
+	if (!camsys_)
+		return false;
+
+	if (camsys_->model() != "mtk-camsys-mt6785") {
+		LOG(MtkIsp50, Debug) << "Unsupported camera subsystem " << camsys_->model();
+		return false;
+	}
+
+	dipMedia_ = acquireMediaDevice(enumerator, dipDm);
+	if (!dipMedia_) {
+		LOG(MtkIsp50, Info) << "No DIP, the camera subsystem is left to other handlers";
+		return false;
+	}
+
+	int ret = dip_.init(dipMedia_.get());
+	if (ret) {
+		LOG(MtkIsp50, Error) << "Failed to open the DIP: " << strerror(-ret);
+		return false;
+	}
+
+	dip_.raw_->bufferReady.connect(this, &PipelineHandlerMtkIsp50::ispRawBufferReady);
+	dip_.main_->bufferReady.connect(this, &PipelineHandlerMtkIsp50::ispOutputBufferReady);
+	if (dip_.scaled_)
+		dip_.scaled_->bufferReady.connect(this, &PipelineHandlerMtkIsp50::ispScaledBufferReady);
+	dip_.params_->bufferReady.connect(this, &PipelineHandlerMtkIsp50::ispParamsBufferReady);
+
+	/* The multi-frame blending block, optional */
+	DeviceMatch mfbDm("mtk-mfb");
+	mfbDm.add("mtk-mfb-base");
+	mfbDm.add("mtk-mfb-out");
+	mfbMedia_ = acquireMediaDevice(enumerator, mfbDm);
+	if (mfbMedia_ && dip_.hasBlend()) {
+		auto worker = std::make_unique<MtkIsp50SeriesWorker>();
+		ret = worker->open(MtkIsp50Mfb::nodesOf(mfbMedia_.get()));
+		if (ret) {
+			LOG(MtkIsp50, Warning)
+				<< "Multi-frame blending block not usable: " << strerror(-ret);
+		} else {
+			seriesWorker_ = std::move(worker);
+			seriesWorker_->moveToThread(&seriesThread_);
+			seriesWorker_->done.connect(this, &PipelineHandlerMtkIsp50::seriesBlended);
+			seriesThread_.start();
+		}
+	}
+	if (dip_.hasBlend()) {
+		dip_.base_->bufferReady.connect(this, &PipelineHandlerMtkIsp50::seriesIspBufferBack);
+		dip_.weight_->bufferReady.connect(this, &PipelineHandlerMtkIsp50::seriesIspBufferBack);
+	}
+
+	statsWorker_ = std::make_unique<MtkIsp50StatsWorker>();
+	statsWorker_->moveToThread(&statsThread_);
+	statsWorker_->done.connect(this, &PipelineHandlerMtkIsp50::statsDone);
+	statsThread_.start();
+
+	unsigned int cameras = 0;
+	for (MediaEntity *entity : camsys_->entities()) {
+		if (entity->function() != MEDIA_ENT_F_CAM_SENSOR)
+			continue;
+
+		if (!createCamera(entity))
+			cameras++;
+	}
+
+	return cameras > 0;
+}
+
+REGISTER_PIPELINE_HANDLER(PipelineHandlerMtkIsp50, "mtkisp50")
+
+} /* namespace libcamera */
