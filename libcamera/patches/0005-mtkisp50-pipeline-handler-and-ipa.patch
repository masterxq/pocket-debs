+
+/**
+ * \class QualityTable
+ * \brief Image quality blocks of the DIP per sensitivity, from the tuning file
+ *
+ * The section "quality" of "mtk-dip" holds "points", a list of sensitivities
+ * ("iso") with the blocks "ee", "ycnr", "demosaic" and "nbc2", each a
+ * dictionary with the fields of struct mtk_dip_params_ee, _ycnr, _demosaic and
+ * _nbc2 (names as in the UAPI header, arrays as lists). The sensitivity of a frame is "isoPerGain"
+ * (default 100) times its analogue and digital gain. The point nearest to it
+ * on a logarithmic scale is used; a new point is only taken when it is nearer
+ * by more than "hysteresis" stops (default 0.25), so that the blocks do not
+ * flip at the middle between two points. The blocks are not interpolated
+ * between points: they contain switches, selections and curve points with
+ * their slopes, for which a mean is no valid setting.
+ *
+ * Optional sections "video", "still", "multiFrameInput", "multiFrameBase" and
+ * "multiFrameOutput" hold points of their own (key "points") for the jobs of
+ * video streams, of still images and of the three steps of a multi-frame
+ * still image (see QualityTable::Set); jobs without such a set take
+ * "points". A module used in any set is sent for every job;
+ * a point without it disables it.
+ */
+
+/**
+ * \brief Read the quality table from the "quality" section
+ * \param[in] node The section
+ * \return The table, or std::nullopt if it is invalid
+ */
+std::optional<QualityTable> QualityTable::fromTuning(const ValueNode &node)
+{
+	QualityTable table;
+
+	table.isoPerGain_ = node["isoPerGain"].get<double>(100.0);
+	table.hysteresis_ = node["hysteresis"].get<double>(0.25);
+	if (!(table.isoPerGain_ > 0.0) || !(table.hysteresis_ >= 0.0 && table.hysteresis_ <= 2.0)) {
+		LOG(IPAMtkIsp50Dip, Error) << "mtk-dip quality: invalid isoPerGain or hysteresis";
+		return std::nullopt;
+	}
+
+	if (!parsePoints(node["points"], table.sets_[0], table))
+		return std::nullopt;
+
+	/* Optional sets of video, still image and multi-frame jobs */
+	static constexpr const char *names[] = { nullptr, "video", "still", "multiFrameInput",
+						 "multiFrameBase", "multiFrameOutput" };
+	static_assert(std::size(names) == kSets);
+	for (unsigned int set = 1; set < kSets; set++) {
+		if (!node.contains(names[set]))
+			continue;
+		if (!parsePoints(node[names[set]]["points"], table.sets_[set], table))
+			return std::nullopt;
+	}
+
+	return table;
+}
+
+bool QualityTable::parsePoints(const ValueNode &points, std::vector<QualityPoint> &out,
+			       QualityTable &table)
+{
+	if (!points.isList() || points.asList().begin() == points.asList().end()) {
+		LOG(IPAMtkIsp50Dip, Error) << "mtk-dip quality: no points";
+		return false;
+	}
+
+	for (const ValueNode &p : points.asList()) {
+		QualityPoint point;
+		point.iso = p["iso"].get<double>(0.0);
+		if (!(point.iso > 0.0) || (!out.empty() && !(point.iso > out.back().iso))) {
+			LOG(IPAMtkIsp50Dip, Error) << "mtk-dip quality: iso missing or not rising";
+			return false;
+		}
+
+		if (p.contains("ee")) {
+			point.ee = parseBlock<struct mtk_dip_params_ee>(p["ee"], MTK_DIP_PARAMS_BLOCK_EE,
+									  kEeFields, "ee");
+			if (!point.ee)
+				return false;
+			table.usesEe_ = true;
+		}
+		if (p.contains("ycnr")) {
+			point.ycnr = parseBlock<struct mtk_dip_params_ycnr>(p["ycnr"], MTK_DIP_PARAMS_BLOCK_YCNR,
+									      kYcnrFields, "ycnr");
+			if (!point.ycnr)
+				return false;
+			table.usesYcnr_ = true;
+		}
+		if (p.contains("demosaic")) {
+			point.demosaic = parseBlock<struct mtk_dip_params_demosaic>(
+				p["demosaic"], MTK_DIP_PARAMS_BLOCK_DEMOSAIC, kDemosaicFields, "demosaic");
+			if (!point.demosaic)
+				return false;
+			table.usesDemosaic_ = true;
+		}
+		if (p.contains("nbc2")) {
+			point.nbc2 = parseBlock<struct mtk_dip_params_nbc2>(p["nbc2"], MTK_DIP_PARAMS_BLOCK_NBC2,
+									      kNbc2Fields, "nbc2");
+			if (!point.nbc2)
+				return false;
+			table.usesNbc2_ = true;
+		}
+
+		out.push_back(std::move(point));
+	}
+
+	return true;
+}
+
+/**
+ * \brief Select the point for a frame
+ * \param[in] totalGain Analogue times digital gain of the frame
+ * \param[in] set The set of the job (QualityTable::Set), the preview set if
+ * the tuning has no such set
+ * \return The point to use
+ */
+const QualityPoint &QualityTable::select(float totalGain, unsigned int set)
+{
+	if (!hasSet(set))
+		set = 0;
+
+	const std::vector<QualityPoint> &points = sets_[set];
+	std::optional<unsigned int> &current = current_[set];
+	const double iso = isoPerGain_ * std::max(totalGain, 1e-3f);
+	auto distance = [&](unsigned int i) {
+		return std::abs(std::log2(iso / points[i].iso));
+	};
+
+	unsigned int best = 0;
+	for (unsigned int i = 1; i < points.size(); i++) {
+		if (distance(i) < distance(best))
+			best = i;
+	}
+
+	if (!current || (best != *current && distance(*current) - distance(best) > hysteresis_))
+		current = best;
+
+	return points[*current];
+}
+
+/**
+ * \brief Stop using the second noise reduction stage (a driver without it)
+ */
+void QualityTable::dropNbc2()
+{
+	for (auto &points : sets_)
+		for (QualityPoint &point : points)
+			point.nbc2.reset();
+	usesNbc2_ = false;
+}
+
+/**
+ * \class MultiFrameTable
+ * \brief Multi-frame still images per sensitivity, from the tuning file
+ *
+ * The section "MultiFrame" holds "minIso" (no series below it), "frames", a
+ * list of [iso, count] pairs with rising iso (count frames from that
+ * sensitivity on, the first count also below its iso), "blend" with
+ * "points", each an "iso" and "words", the 13 tuning words of the
+ * multi-frame blending block (struct mtk_mfb_params_blend: ll_con1, ll_con2,
+ * mbd_con[11]), and "mix" with "points", each an "iso" and the fields of
+ * struct mtk_dip_params_mix. Blend and mix take the point nearest on a
+ * logarithmic scale.
+ */
+
+namespace {
+
+template<typename T>
+std::optional<std::vector<T>> listOf(const ValueNode &node)
+{
+	if (!node.isList())
+		return std::nullopt;
+
+	std::vector<T> values;
+	for (const ValueNode &v : node.asList()) {
+		std::optional<T> x = v.get<T>();
+		if (!x)
+			return std::nullopt;
+		values.push_back(*x);
+	}
+
+	return values;
+}
+
+template<typename T>
+bool nearestFirst(const std::vector<std::pair<double, T>> &points, double iso, std::size_t *index)
+{
+	if (points.empty())
+		return false;
+
+	std::size_t best = 0;
+	for (std::size_t i = 1; i < points.size(); i++) {
+		if (std::abs(std::log2(iso / points[i].first)) <
+		    std::abs(std::log2(iso / points[best].first)))
+			best = i;
+	}
+	*index = best;
+	return true;
+}
+
+} /* namespace */
+
+std::optional<MultiFrameTable> MultiFrameTable::fromTuning(const ValueNode &node)
+{
+	MultiFrameTable table;
+
+	table.minIso_ = node["minIso"].get<double>(0.0);
+	if (!(table.minIso_ > 0.0)) {
+		LOG(IPAMtkIsp50Dip, Error) << "MultiFrame: minIso missing";
+		return std::nullopt;
+	}
+
+	const ValueNode &frames = node["frames"];
+	if (!frames.isList()) {
+		LOG(IPAMtkIsp50Dip, Error) << "MultiFrame: frames missing";
+		return std::nullopt;
+	}
+	for (const ValueNode &f : frames.asList()) {
+		std::optional<std::vector<double>> v = listOf<double>(f);
+		if (!v || v->size() != 2 || !((*v)[0] > 0.0) || (*v)[1] < 2.0 || (*v)[1] > 16.0 ||
+		    (!table.frames_.empty() && !((*v)[0] > table.frames_.back().first))) {
+			LOG(IPAMtkIsp50Dip, Error) << "MultiFrame: invalid frames entry";
+			return std::nullopt;
+		}
+		table.frames_.emplace_back((*v)[0], static_cast<unsigned int>((*v)[1]));
+	}
+	if (table.frames_.empty()) {
+		LOG(IPAMtkIsp50Dip, Error) << "MultiFrame: no frames entry";
+		return std::nullopt;
+	}
+
+	for (const ValueNode &p : node["blend"]["points"].asList()) {
+		const double iso = p["iso"].get<double>(0.0);
+		std::optional<std::vector<uint32_t>> words = listOf<uint32_t>(p["words"]);
+		if (!(iso > 0.0) || !words || words->size() != kBlendWords) {
+			LOG(IPAMtkIsp50Dip, Error) << "MultiFrame: invalid blend point";
+			return std::nullopt;
+		}
+		std::array<uint32_t, kBlendWords> w;
+		std::copy(words->begin(), words->end(), w.begin());
+		table.blend_.emplace_back(iso, w);
+	}
+
+	static constexpr std::pair<const char *, std::size_t> kMixFields[] = {
+		{ "luma_enable", offsetof(struct mtk_dip_params_mix, luma_enable) },
+		{ "chroma_enable", offsetof(struct mtk_dip_params_mix, chroma_enable) },
+		{ "weight_to_base", offsetof(struct mtk_dip_params_mix, weight_to_base) },
+		{ "luma_pass_base", offsetof(struct mtk_dip_params_mix, luma_pass_base) },
+		{ "chroma_pass_base", offsetof(struct mtk_dip_params_mix, chroma_pass_base) },
+		{ "weight_min", offsetof(struct mtk_dip_params_mix, weight_min) },
+		{ "weight_max", offsetof(struct mtk_dip_params_mix, weight_max) },
+		{ "slope", offsetof(struct mtk_dip_params_mix, slope) },
+		{ "map_start", offsetof(struct mtk_dip_params_mix, map_start) },
+		{ "map_end", offsetof(struct mtk_dip_params_mix, map_end) },
+	};
+	for (const ValueNode &p : node["mix"]["points"].asList()) {
+		const double iso = p["iso"].get<double>(0.0);
+		struct mtk_dip_params_mix mix = {};
+		mix.header.type = MTK_DIP_PARAMS_BLOCK_MIX;
+		mix.header.size = sizeof(mix);
+		bool valid = iso > 0.0;
+		for (const auto &[name, offset] : kMixFields) {
+			std::optional<uint32_t> v = p[name].get<uint32_t>();
+			if (!v || *v > 255) {
+				valid = false;
+				break;
+			}
+			reinterpret_cast<uint8_t *>(&mix)[offset] = static_cast<uint8_t>(*v);
+		}
+		if (!valid || mix.weight_min > mix.weight_max || mix.luma_enable != mix.chroma_enable) {
+			LOG(IPAMtkIsp50Dip, Error) << "MultiFrame: invalid mix point";
+			return std::nullopt;
+		}
+		table.mix_.emplace_back(iso, mix);
+	}
+
+	if (table.blend_.empty() || table.mix_.empty()) {
+		LOG(IPAMtkIsp50Dip, Error) << "MultiFrame: blend or mix points missing";
+		return std::nullopt;
+	}
+
+	return table;
+}
+
+/**
+ * \brief Frames of a series at a sensitivity
+ * \param[in] iso The sensitivity of the still image
+ * \return The number of frames, 0 below minIso (a single frame)
+ */
+unsigned int MultiFrameTable::frames(double iso) const
+{
+	if (iso < minIso_)
+		return 0;
+
+	unsigned int count = frames_.front().second;
+	for (const auto &[from, n] : frames_) {
+		if (iso >= from)
+			count = n;
+	}
+
+	return count;
+}
+
+const std::array<uint32_t, MultiFrameTable::kBlendWords> &MultiFrameTable::blend(double iso) const
+{
+	std::size_t i = 0;
+	nearestFirst(blend_, iso, &i);
+	return blend_[i].second;
+}
+
+struct mtk_dip_params_mix MultiFrameTable::mix(double iso) const
+{
+	std::size_t i = 0;
+	nearestFirst(mix_, iso, &i);
+	return mix_[i].second;
+}
+
+/**
+ * \class TemporalNrTable
+ * \brief Settings of the temporal noise reduction per sensitivity
+ */
+
+/**
+ * \brief Read the points of the temporal noise reduction
+ * \param[in] points A list of dictionaries with "iso" (rising) and the fields
+ * of struct mtk_dip_params_nr3d (names as in the UAPI header, arrays as
+ * lists) except flags, motion_x and motion_y
+ * \return The table, or std::nullopt if it is invalid
+ */
+std::optional<TemporalNrTable> TemporalNrTable::fromTuning(const ValueNode &points)
+{
+	if (!points.isList() || points.asList().begin() == points.asList().end()) {
+		LOG(IPAMtkIsp50Dip, Error) << "mtk-dip temporal noise reduction: no points";
+		return std::nullopt;
+	}
+
+	TemporalNrTable table;
+	for (const ValueNode &p : points.asList()) {
+		const double iso = p["iso"].get<double>(0.0);
+		if (!(iso > 0.0) || (!table.points_.empty() && !(iso > table.points_.back().first))) {
+			LOG(IPAMtkIsp50Dip, Error)
+				<< "mtk-dip temporal noise reduction: iso missing or not rising";
+			return std::nullopt;
+		}
+
+		std::optional<struct mtk_dip_params_nr3d> block =
+			parseBlock<struct mtk_dip_params_nr3d>(p, MTK_DIP_PARAMS_BLOCK_NR3D,
+								kNr3dFields, "nr3d");
+		if (!block)
+			return std::nullopt;
+		if (!block->luma_enable && !block->chroma_enable) {
+			LOG(IPAMtkIsp50Dip, Error)
+				<< "mtk-dip temporal noise reduction: neither luma nor chroma enabled";
+			return std::nullopt;
+		}
+
+		table.points_.emplace_back(iso, *block);
+	}
+
+	return table;
+}
+
+/**
+ * \brief The block for a sensitivity
+ * \param[in] iso The sensitivity of the frame
+ * \return The block, enabled, without flags and with no global motion
+ */
+struct mtk_dip_params_nr3d TemporalNrTable::at(double iso) const
+{
+	if (points_.size() == 1 || !(iso > points_.front().first))
+		return points_.front().second;
+	if (iso >= points_.back().first)
+		return points_.back().second;
+
+	std::size_t i = 1;
+	while (points_[i].first < iso)
+		i++;
+
+	const auto &[isoLow, low] = points_[i - 1];
+	const auto &[isoHigh, high] = points_[i];
+	const double t = (iso - isoLow) / (isoHigh - isoLow);
+
+	struct mtk_dip_params_nr3d block = low;
+	const auto *a = reinterpret_cast<const uint8_t *>(&low);
+	const auto *b = reinterpret_cast<const uint8_t *>(&high);
+	auto *out = reinterpret_cast<uint8_t *>(&block);
+
+	for (const QualityField &f : kNr3dFields) {
+		if (std::find(std::begin(kNr3dStepped), std::end(kNr3dStepped), f.offset) !=
+		    std::end(kNr3dStepped))
+			continue;
+
+		/* All interpolated fields are bytes */
+		for (std::size_t k = 0; k < f.count; k++) {
+			const std::size_t o = f.offset + k;
+			out[o] = static_cast<uint8_t>(std::lround(a[o] + (b[o] - a[o]) * t));
+		}
+	}
+
+	return block;
+}
+
+/**
+ * \class ParamsEncoder
+ * \brief Serialise DipFrameParams into a DIP parameter buffer
+ *
+ * The DIP keeps the values of the previous job for every block a params
+ * buffer omits, and runs jobs without a params buffer with the previous
+ * values. The encoder therefore writes only the blocks that differ from what
+ * the DIP has received. encode() fills a buffer, commit() records that the
+ * buffer was queued.
+ */
+
+/**
+ * \brief Forget the blocks sent so far, the next buffer carries all blocks
+ *
+ * The DIP keeps the blocks of the last job across jobs and across
+ * VIDIOC_STREAMOFF, also from another process. The optional blocks (lens
+ * shading and the image quality blocks) that the tuning does not configure
+ * are therefore sent disabled once with the next buffer, so that a stream
+ * does not inherit them from a previous one.
+ */
+void ParamsEncoder::reset()
+{
+	for (auto &block : sent_)
+		block.clear();
+
+	unknown_.fill(false);
+	for (unsigned int type : { MTK_DIP_PARAMS_BLOCK_LSC, MTK_DIP_PARAMS_BLOCK_EE,
+				   MTK_DIP_PARAMS_BLOCK_YCNR, MTK_DIP_PARAMS_BLOCK_DEMOSAIC,
+				   MTK_DIP_PARAMS_BLOCK_NBC2 })
+		unknown_[type] = true;
+	unknown_[MTK_DIP_PARAMS_BLOCK_NR3D] = temporalNr_;
+}
+
+/**
+ * \brief Tell whether the driver knows the temporal noise reduction block
+ * \param[in] supported True if it does
+ *
+ * Without it the block is never sent, also not disabled, and the jobs run
+ * without the module whatever DipFrameParams::nr3d holds. Call reset() after.
+ */
+void ParamsEncoder::setTemporalNr(bool supported)
+{
+	temporalNr_ = supported;
+	if (!supported) {
+		sent_[MTK_DIP_PARAMS_BLOCK_NR3D].clear();
+		pending_[MTK_DIP_PARAMS_BLOCK_NR3D].clear();
+		unknown_[MTK_DIP_PARAMS_BLOCK_NR3D] = false;
+	}
+}
+
+/**
+ * \brief Stop sending the disabled blocks of reset()
+ * \param[in] minType Only for block types from this one on (the newer ones)
+ *
+ * For a driver that refuses the buffer because it does not know an optional
+ * block type: such a driver has no state of that block to reset.
+ *
+ * \return True if the pending buffer carried such blocks, false otherwise
+ */
+bool ParamsEncoder::dropStartDisables(unsigned int minType)
+{
+	bool dropped = false;
+
+	for (unsigned int type = minType; type < kBlockTypes; type++) {
+		if (unknown_[type] && sent_[type].empty() && included_[type] &&
+		    pending_[type] == disabledBlock(type))
+			dropped = true;
+		unknown_[type] = false;
+	}
+
+	return dropped;
+}
+
+namespace {
+
+template<typename T>
+std::vector<uint8_t> blockBytes(const T &block)
+{
+	const uint8_t *p = reinterpret_cast<const uint8_t *>(&block);
+	return std::vector<uint8_t>(p, p + sizeof(block));
+}
+
+} /* namespace */
+
+/**
+ * \brief Serialise the changed blocks into a buffer
+ * \param[in] params The parameters
+ * \param[in] order Bayer order of the raw format set on the DIP input
+ * \param[out] buffer The params buffer (mapped)
+ * \return The number of bytes used, or 0 if no block changed (nothing to
+ * queue) or none fits into the buffer
+ *
+ * Changed blocks that do not fit into the buffer are left for the next one;
+ * commit() records only the blocks the buffer carries.
+ */
+size_t ParamsEncoder::encode(const DipFrameParams &params, BayerFormat::Order order,
+			     Span<uint8_t> buffer)
+{
+	const auto channels = bayerChannels(order);
+
+	const float common = commonGain(params);
+
+	struct mtk_dip_params_blc blc = {};
+	fillHeader(&blc, MTK_DIP_PARAMS_BLOCK_BLC);
+	for (unsigned int i = 0; i < MTK_DIP_BAYER_CHANNELS; i++) {
+		const float level = std::clamp(params.blackLevel[channels[i]], 0.0f, 0.99f);
+		blc.level[i] = toBlackLevel(level);
+		/*
+		 * Stretch the range above the black level back to full scale,
+		 * with the part of the colour gains common to all channels
+		 */
+		blc.gain[i] = toUnsignedQ4_12(common / (1.0f - level));
+	}
+
+	struct mtk_dip_params_wb wb = {};
+	fillHeader(&wb, MTK_DIP_PARAMS_BLOCK_WB);
+	for (unsigned int i = 0; i < MTK_DIP_BAYER_CHANNELS; i++)
+		wb.gain[i] = toUnsignedQ4_12(params.gains[channels[i]] / common);
+
+	struct mtk_dip_params_ccm ccm = {};
+	fillHeader(&ccm, MTK_DIP_PARAMS_BLOCK_CCM);
+	for (unsigned int row = 0; row < 3; row++)
+		for (unsigned int col = 0; col < 3; col++)
+			ccm.coeff[row][col] = toSignedQ4_12(params.combinedMatrix[row][col]);
+
+	struct mtk_dip_params_gamma gamma = {};
+	fillHeader(&gamma, MTK_DIP_PARAMS_BLOCK_GAMMA);
+	static_assert(kGammaPoints == MTK_DIP_GAMMA_POINTS);
+	for (unsigned int i = 0; i < kGammaPoints; i++) {
+		const float x = static_cast<float>(gammaInputPosition(i)) / kGammaInputScale;
+		const float y = toneCurve(x, params.gamma, params.contrastExp,
+					  toneCurve_ ? &*toneCurve_ : nullptr, shadowLift_);
+		const uint16_t out = static_cast<uint16_t>(
+			std::clamp(std::lround(y * 1023.0f), 0L, 1023L));
+
+		for (unsigned int c = 0; c < 3; c++)
+			gamma.lut[c][i] = out;
+	}
+
+	/*
+	 * An optional block the tuning does not configure: disabled once if
+	 * it was sent before or its state in the DIP is unknown (reset()),
+	 * otherwise left out, as drivers without the block reject its type
+	 */
+	auto neutral = [this](unsigned int type) {
+		pending_[type] = sent_[type].empty() && !unknown_[type]
+					 ? std::vector<uint8_t>{}
+					 : disabledBlock(type);
+	};
+
+	pending_[MTK_DIP_PARAMS_BLOCK_BLC] = blockBytes(blc);
+	pending_[MTK_DIP_PARAMS_BLOCK_WB] = blockBytes(wb);
+	pending_[MTK_DIP_PARAMS_BLOCK_CCM] = blockBytes(ccm);
+	pending_[MTK_DIP_PARAMS_BLOCK_GAMMA] = blockBytes(gamma);
+
+	/*
+	 * The lens shading block is only sent when the tuning enables it:
+	 * drivers without support reject it. Disabling it again later, or
+	 * the first buffer after reset() without it, sends a disabling header.
+	 */
+	if (lensShading_) {
+		struct mtk_dip_params_lsc lsc = {};
+		fillHeader(&lsc, MTK_DIP_PARAMS_BLOCK_LSC);
+		const auto lscPos = lscChannels(order);
+		for (unsigned int i = 0; i < MTK_DIP_BAYER_CHANNELS; i++)
+			for (unsigned int y = 0; y < LensShading::kGridPoints; y++)
+				for (unsigned int x = 0; x < LensShading::kGridPoints; x++)
+					lsc.gain[i][y][x] = toUnsignedQ4_12(
+						lensShading_->gain[lscPos[i]][y * LensShading::kGridPoints + x]);
+		pending_[MTK_DIP_PARAMS_BLOCK_LSC] = blockBytes(lsc);
+	} else {
+		neutral(MTK_DIP_PARAMS_BLOCK_LSC);
+	}
+
+	/*
+	 * Image quality blocks of the point selected for the gain of the frame.
+	 * Like all blocks they are only sent when they differ from what the DIP
+	 * has, i.e. when the point changes and after reset().
+	 */
+	if (quality_) {
+		const QualityPoint &point = quality_->select(params.totalGain, params.useCase);
+
+		if (quality_->usesEe())
+			pending_[MTK_DIP_PARAMS_BLOCK_EE] = qualityBytes(point.ee, MTK_DIP_PARAMS_BLOCK_EE);
+		else
+			neutral(MTK_DIP_PARAMS_BLOCK_EE);
+		if (quality_->usesYcnr())
+			pending_[MTK_DIP_PARAMS_BLOCK_YCNR] =
+				qualityBytes(point.ycnr, MTK_DIP_PARAMS_BLOCK_YCNR);
+		else
+			neutral(MTK_DIP_PARAMS_BLOCK_YCNR);
+		if (quality_->usesDemosaic())
+			pending_[MTK_DIP_PARAMS_BLOCK_DEMOSAIC] =
+				qualityBytes(point.demosaic, MTK_DIP_PARAMS_BLOCK_DEMOSAIC);
+		else
+			neutral(MTK_DIP_PARAMS_BLOCK_DEMOSAIC);
+		if (quality_->usesNbc2())
+			pending_[MTK_DIP_PARAMS_BLOCK_NBC2] =
+				qualityBytes(point.nbc2, MTK_DIP_PARAMS_BLOCK_NBC2);
+		else
+			neutral(MTK_DIP_PARAMS_BLOCK_NBC2);
+	} else {
+		/* Quality switched off: back to the driver defaults once */
+		for (unsigned int type : { MTK_DIP_PARAMS_BLOCK_EE, MTK_DIP_PARAMS_BLOCK_YCNR,
+					   MTK_DIP_PARAMS_BLOCK_DEMOSAIC, MTK_DIP_PARAMS_BLOCK_NBC2 })
+			neutral(type);
+	}
+
+	/*
+	 * Temporal noise reduction: the block of the frame, or the module off
+	 * once (a still image, no tuning). A block with a flag acts on its job
+	 * only: it goes into the buffer also when the same block went before.
+	 */
+	bool forceNr3d = false;
+	if (temporalNr_ && params.nr3d) {
+		pending_[MTK_DIP_PARAMS_BLOCK_NR3D] = blockBytes(*params.nr3d);
+		forceNr3d = params.nr3d->flags != 0;
+	} else if (temporalNr_) {
+		neutral(MTK_DIP_PARAMS_BLOCK_NR3D);
+	} else {
+		pending_[MTK_DIP_PARAMS_BLOCK_NR3D].clear();
+	}
+
+	/*
+	 * Blend: only the jobs of a multi-frame still image set it; the
+	 * others leave the block as the DIP has it (they ignore it)
+	 */
+	if (params.mix)
+		pending_[MTK_DIP_PARAMS_BLOCK_MIX] = blockBytes(*params.mix);
+	else if (params.mixOff)
+		pending_[MTK_DIP_PARAMS_BLOCK_MIX] = disabledBlock(MTK_DIP_PARAMS_BLOCK_MIX);
+	else
+		pending_[MTK_DIP_PARAMS_BLOCK_MIX] = sent_[MTK_DIP_PARAMS_BLOCK_MIX];
+
+	/*
+	 * The changed blocks in type order, as far as they fit into the
+	 * buffer (its size comes from the driver); the others follow with
+	 * the next buffer
+	 */
+	size_t size = sizeof(struct v4l2_isp_params_buffer);
+	included_.fill(false);
+	for (unsigned int type = 0; type < kBlockTypes; type++) {
+		const bool force = type == MTK_DIP_PARAMS_BLOCK_NR3D && forceNr3d;
+		if ((pending_[type] == sent_[type] && !force) ||
+		    size + pending_[type].size() > buffer.size())
+			continue;
+
+		included_[type] = true;
+		size += pending_[type].size();
+	}
+
+	if (size == sizeof(struct v4l2_isp_params_buffer))
+		return 0;
+
+	auto *head = reinterpret_cast<struct v4l2_isp_params_buffer *>(buffer.data());
+	head->version = MTK_DIP_PARAMS_VERSION_V1;
+	head->data_size = size - sizeof(*head);
+
+	uint8_t *data = buffer.data() + sizeof(*head);
+	for (unsigned int type = 0; type < kBlockTypes; type++) {
+		if (!included_[type])
+			continue;
+
+		memcpy(data, pending_[type].data(), pending_[type].size());
+		data += pending_[type].size();
+	}
+
+	return size;
+}
+
+/**
+ * \brief Record that the buffer of the last encode() was queued to the DIP
+ */
+void ParamsEncoder::commit()
+{
+	for (unsigned int type = 0; type < kBlockTypes; type++) {
+		if (!included_[type])
+			continue;
+
+		sent_[type] = pending_[type];
+		unknown_[type] = false;
+	}
+	included_.fill(false);
+}
+
+/**
+ * \brief Set the tuned tone curve
+ * \param[in] curve The curve, or std::nullopt for the power law of gamma
+ *
+ * The curve stays in effect across reset(). The next encode() sends the tone
+ * curve block if the result differs from what the DIP has.
+ */
+void ParamsEncoder::setToneCurve(std::optional<ToneCurve> curve)
+{
+	toneCurve_ = std::move(curve);
+}
+
+/**
+ * \brief Set the shadow lift of the tone curve
+ * \param[in] lift The lift (see shadowLift()), 0.0 for none
+ */
+void ParamsEncoder::setShadowLift(float lift)
+{
+	shadowLift_ = std::max(lift, 0.0f);
+}
+
+/**
+ * \brief Enable or disable the lens shading block
+ * \param[in] lsc The gains, or std::nullopt for no lens shading (disabled
+ * once after reset(), otherwise no block)
+ *
+ * Like the tone curve the setting stays in effect across reset().
+ */
+void ParamsEncoder::setLensShading(std::optional<LensShading> lsc)
+{
+	lensShading_ = std::move(lsc);
+}
+
+/**
+ * \brief Set the image quality blocks per sensitivity
+ * \param[in] quality The table, or std::nullopt to leave the modules to the
+ * driver defaults
+ */
+void ParamsEncoder::setQuality(std::optional<QualityTable> quality)
+{
+	quality_ = std::move(quality);
+}
+
+/**
+ * \brief Stop sending the second noise reduction stage
+ *
+ * For a driver without the block: the other quality blocks stay.
+ */
+void ParamsEncoder::dropNbc2()
+{
+	if (quality_)
+		quality_->dropNbc2();
+	unknown_[MTK_DIP_PARAMS_BLOCK_NBC2] = false;
+}
+
+} /* namespace ipa::mtkisp50 */
+
+} /* namespace libcamera */
