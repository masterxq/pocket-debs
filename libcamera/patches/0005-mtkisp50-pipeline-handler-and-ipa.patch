+class MtkIsp50AwbTest : public Test
+{
+protected:
+	int fail(const std::string &what)
+	{
+		std::cerr << what << std::endl;
+		return TestFail;
+	}
+
+	int testDark()
+	{
+		Sim sim;
+		if (sim.init() || sim.configure())
+			return fail("init");
+		auto &awb = sim.ctx().activeState.awb;
+
+		/* Blue mean 0.6: below the old fixed threshold, above the noise */
+		for (unsigned int i = 0; i < 8; i++)
+			sim.frame(warm(1.8));
+		if (awb.temperatureK > 2800)
+			return fail("dark warm scene: " + std::to_string(awb.temperatureK) + " K");
+		const unsigned int ct = awb.temperatureK;
+		const RGB<float> gains = awb.gains;
+
+		/* The same scene with half the analogue gain and the rest digital */
+		for (unsigned int i = 0; i < 8; i++)
+			sim.frame(warm(0.9), 6600, 8.0);
+		if (std::abs(static_cast<int>(awb.temperatureK) - static_cast<int>(ct)) > 60)
+			return fail("other gain split: " + std::to_string(awb.temperatureK) + " K");
+
+		/* Darker than the noise: the last estimate is held, not the start */
+		for (unsigned int i = 0; i < 20; i++)
+			sim.frame(warm(0.2));
+		if (std::abs(static_cast<int>(awb.temperatureK) - static_cast<int>(ct)) > 60 ||
+		    std::abs(awb.gains.b() / gains.b() - 1.0f) > 0.05f)
+			return fail("held estimate: " + std::to_string(awb.temperatureK) + " K");
+
+		/* A new configuration starts where the last stream ended */
+		if (sim.configure() || std::abs(static_cast<int>(awb.temperatureK) - static_cast<int>(ct)) > 60)
+			return fail("start after configuration: " + std::to_string(awb.temperatureK) + " K");
+
+		/* Never estimated: the start value of the tuning, until an estimate comes */
+		Sim fresh;
+		if (fresh.init() || fresh.configure())
+			return fail("init 2");
+		for (unsigned int i = 0; i < 6; i++)
+			fresh.frame(warm(0.2));
+		if (fresh.ctx().activeState.awb.temperatureK != 5000)
+			return fail("start value: " + std::to_string(fresh.ctx().activeState.awb.temperatureK));
+		/* The first estimate, even a weak one, counts fully (window of 4) */
+		for (unsigned int i = 0; i < 4; i++)
+			fresh.frame(warm(1.3));
+		if (fresh.ctx().activeState.awb.temperatureK > 2800)
+			return fail("first estimate: " + std::to_string(fresh.ctx().activeState.awb.temperatureK));
+
+		return TestPass;
+	}
+
+	int testPreference()
+	{
+		Sim sim;
+		if (sim.init() || sim.configure())
+			return fail("init");
+		for (unsigned int i = 0; i < 12; i++)
+			sim.frame(warm(20.0));
+
+		auto &awb = sim.ctx().activeState.awb;
+		/* Light value about 0: the dim row, at 2500 K */
+		if (std::abs(awb.tint.r() - 1.3f) > 0.03f || std::abs(awb.tint.b() - 0.6f) > 0.03f)
+			return fail("tint " + std::to_string(awb.tint.r()) + " " + std::to_string(awb.tint.b()) +
+				    " at " + std::to_string(awb.temperatureK) + " K");
+
+		/* After the matrix: rows of red and blue scaled, weaker at ISO 3200 */
+		const Matrix<float, 3, 3> m = sim.matrix();
+		const float s = 0.5f;
+		const float diag = 1.0f + (1.5f - 1.0f) * s;
+		if (std::abs(m[0][0] - awb.tint.r() * diag) > 1e-3f ||
+		    std::abs(m[2][2] - awb.tint.b() * diag) > 1e-3f ||
+		    std::abs(m[1][1] - diag) > 1e-3f || std::abs(m[1][0] + 0.25f * s) > 1e-3f)
+			return fail("matrix " + m.toString());
+
+		/* Interpolation: in mired, ends held, light value rows */
+		AwbPreference p = *AwbPreference::fromTuning((*tuningNode())["Awb"]["preference"]);
+		const RGB<double> mid = p.tint(1e6 / ((1e6 / 2500 + 1e6 / 4000) / 2), 7.5);
+		const double want = std::exp((std::log(1.3) + std::log(1.1)) / 4);
+		if (std::abs(mid.r() - want) > 1e-6 || std::abs(p.tint(8000, 12.0).b() - 1.0) > 1e-9 ||
+		    std::abs(p.tint(2000, std::nullopt).b() - 0.6) > 1e-9)
+			return fail("interpolation");
+
+		/* A fixed colour temperature: no preference */
+		ControlList c(controls::controls);
+		c.set(controls::AwbEnable, false);
+		c.set(controls::ColourTemperature, 3000);
+		sim.queue(c);
+		if (awb.tint.r() != 1.0f || awb.tint.b() != 1.0f)
+			return fail("tint with fixed gains");
+
+		return TestPass;
+	}
+
+	int testSensitivity()
+	{
+		Sim sim;
+		if (sim.init("AwbModule") || sim.configure())
+			return fail("init");
+		/* The module sees 10 % more red and 10 % less blue */
+		for (unsigned int i = 0; i < 12; i++)
+			sim.frame(RGB<double>({ 1.1 * 20.0, 20.0, 0.9 * 20.0 / 3.0 }));
+		auto &awb = sim.ctx().activeState.awb;
+		if (awb.temperatureK > 2600 || std::abs(awb.gains.r() - 1.0f / 1.1f) > 0.03f ||
+		    std::abs(awb.gains.b() - 3.0f / 0.9f) > 0.1f)
+			return fail("module: " + std::to_string(awb.temperatureK) + " K, gains " +
+				    std::to_string(awb.gains.r()) + " " + std::to_string(awb.gains.b()));
+		return TestPass;
+	}
+
+	/*
+	 * The calibration of the module over a tuning with the steady
+	 * rendering: the file replaces the curve and the sensitivity only, the
+	 * settings of the rendering stay and work with the module values
+	 */
+	int testUnitOverRendering()
+	{
+		char dir[] = "/tmp/libcamera.mtkisp50-awb.XXXXXX";
+		if (!mkdtemp(dir))
+			return fail("temporary directory");
+		const std::string path = std::string(dir) + "/sensor-unit.yaml";
+		{
+			std::ofstream out(path, std::ios::trunc);
+			out << kModuleUnit;
+		}
+		UniqueFD fd = MemFd::create("mtkisp50-awb-module", 0);
+		std::unique_ptr<ValueNode> tuning;
+		if (fd.isValid() && write(fd.get(), kModuleTuning, strlen(kModuleTuning)) > 0) {
+			File file("/proc/self/fd/" + std::to_string(fd.get()));
+			if (file.open(File::OpenModeFlag::ReadOnly))
+				tuning = YamlParser::parse(file);
+		}
+		const UnitTuning r = tuning ? UnitTuning::apply(*tuning, path)
+					    : UnitTuning{};
+		unlink(path.c_str());
+		rmdir(dir);
+		if (!tuning)
+			return fail("module tuning");
+
+		const std::vector<std::string> keys = { "Awb.colourGains", "Awb.sensitivity" };
+		if (r.status != UnitTuning::Status::Applied || r.keys != keys)
+			return fail("calibration of the module not applied");
+
+		const ValueNode &awbNode = algorithm(*tuning, "Awb");
+		if (awbNode["colourGains"].size() != 4 ||
+		    awbNode["rendering"]["band"].get<double>(0.0) != 30.0 ||
+		    awbNode["rendering"]["speed"].get<double>(0.0) != 0.1 ||
+		    awbNode["rendering"]["switch"].get<double>(0.0) != 60.0 ||
+		    awbNode["maxZoneLevel"].get<double>(0.0) != 0.6 ||
+		    awbNode["transversePos"].get<double>(0.0) != 0.06 ||
+		    awbNode["window"].get<unsigned int>(0) != 2 ||
+		    awbNode["speed"].get<double>(0.0) != 0.7)
+			return fail("keys of the tuning changed by the calibration");
+
+		Sim sim;
+		if (sim.init(algorithm(*tuning, "Ccm"), awbNode) || sim.configure())
+			return fail("init with the calibration of the module");
+
+		/* The module sees 10 % more red and 10 % less blue */
+		for (unsigned int i = 0; i < 12; i++)
+			sim.frame(RGB<double>({ 1.1 * 20.0, 20.0, 0.9 * 20.0 / 3.0 }));
+		const auto &awb = sim.ctx().activeState.awb;
+		if (awb.temperatureK > 2600 || std::abs(awb.gains.r() - 1.0f / 1.1f) > 0.03f ||
+		    std::abs(awb.gains.b() - 3.0f / 0.9f) > 0.1f)
+			return fail("module with rendering: " + std::to_string(awb.temperatureK) +
+				    " K, gains " + std::to_string(awb.gains.r()) + " " +
+				    std::to_string(awb.gains.b()));
+
+		/*
+		 * A drift of 4 % in B/G (about 17 mired on the curve): the gains
+		 * follow, the rendering stays
+		 */
+		const unsigned int ct = awb.temperatureK;
+		for (unsigned int i = 0; i < 12; i++)
+			sim.frame(RGB<double>({ 1.1 * 20.0, 20.0, 1.04 * 0.9 * 20.0 / 3.0 }));
+		if (std::abs(1e6 / ct - 1e6 / awb.temperatureK) > 2.0 ||
+		    std::abs(awb.gains.b() - 3.0f / 0.9f / 1.04f) > 0.1f)
+			return fail("drift with the calibration of the module: " +
+				    std::to_string(ct) + " -> " + std::to_string(awb.temperatureK) +
+				    " K, gain " + std::to_string(awb.gains.b()));
+
+		return TestPass;
+	}
+
+	/*
+	 * The white point is fitted exactly: a light a little off the curve
+	 * (less than the steps of the AwbBayes search across it) is
+	 * neutralised
+	 */
+	int testExactFit()
+	{
+		Sim sim;
+		if (sim.init("AwbRender") || sim.configure())
+			return fail("init");
+		/* Between 2500 and 4000 K on the curve, B/G 0.4 % above it */
+		const double r = 1.0 / 1.25, b = 1.004 / 2.5;
+		for (unsigned int i = 0; i < 20; i++)
+			sim.frame(RGB<double>({ 20.0 * r, 20.0, 20.0 * b }));
+		const auto &awb = sim.ctx().activeState.awb;
+		const double er = std::abs(std::log(r * awb.gains.r()));
+		const double eb = std::abs(std::log(b * awb.gains.b()));
+		if (er > 0.002 || eb > 0.002)
+			return fail("exact fit: residual " + std::to_string(er) + " " + std::to_string(eb));
+		return TestPass;
+	}
+
+	/*
+	 * The recorded drift of a light: the gains follow it, the colour
+	 * temperature of the rendering stays within the band
+	 */
+	int testRecorded()
+	{
+		Sim sim, plain;
+		if (sim.init("AwbRender") || sim.configure() || plain.init() || plain.configure())
+			return fail("init");
+		unsigned int lo = 100000, hi = 0, loPlain = 100000, hiPlain = 0;
+		double residual = 0.0;
+		unsigned int i = 0;
+		for (const Recorded &f : kRecorded) {
+			const RGB<double> m({ f.r, f.g, f.b });
+			sim.frame(m, f.exposure, f.gain);
+			plain.frame(m, f.exposure, f.gain);
+			if (i++ < 8)
+				continue;
+			const auto &a = sim.ctx().activeState.awb;
+			lo = std::min(lo, a.temperatureK);
+			hi = std::max(hi, a.temperatureK);
+			loPlain = std::min(loPlain, plain.ctx().activeState.awb.temperatureK);
+			hiPlain = std::max(hiPlain, plain.ctx().activeState.awb.temperatureK);
+			residual = std::max({ residual, std::abs(std::log(f.r / f.g * a.gains.r())),
+					      std::abs(std::log(f.b / f.g * a.gains.b())) });
+		}
+		const double spread = 1e6 / lo - 1e6 / hi;
+		const double spreadPlain = 1e6 / loPlain - 1e6 / hiPlain;
+		std::cout << "recorded drift: rendering " << lo << ".." << hi << " K, estimate only "
+			  << loPlain << ".." << hiPlain << " K, largest residual " << residual << std::endl;
+		if (spread > 30.0 || spreadPlain < 2.0 * spread + 10.0 || residual > 0.07)
+			return fail("recorded drift");
+		return TestPass;
+	}
+
+	/* A new light beyond the switch: the rendering follows within a few frames */
+	int testNewLight()
+	{
+		Sim sim;
+		if (sim.init("AwbRender") || sim.configure())
+			return fail("init");
+		for (unsigned int i = 0; i < 10; i++)
+			sim.frame(warm(20.0));
+		const auto &awb = sim.ctx().activeState.awb;
+		if (awb.temperatureK > 2600)
+			return fail("warm light: " + std::to_string(awb.temperatureK));
+		/* The light of the curve at 4000 K */
+		unsigned int frames = 0;
+		while (awb.temperatureK < 3900 && frames < 20) {
+			sim.frame(RGB<double>({ 20.0 / 1.5, 20.0, 20.0 / 2.0 }));
+			frames++;
+		}
+		if (frames > 8)
+			return fail("new light after " + std::to_string(frames) + " frames: " +
+				    std::to_string(awb.temperatureK) + " K");
+		return TestPass;
+	}
+
+	int run() override
+	{
+		int ret = testExactFit();
+		if (ret != TestPass)
+			return ret;
+		ret = testRecorded();
+		if (ret != TestPass)
+			return ret;
+		ret = testNewLight();
+		if (ret != TestPass)
+			return ret;
+		ret = testDark();
+		if (ret != TestPass)
+			return ret;
+		ret = testPreference();
+		if (ret != TestPass)
+			return ret;
+		ret = testSensitivity();
+		if (ret != TestPass)
+			return ret;
+		return testUnitOverRendering();
+	}
+
+private:
+	std::unique_ptr<ValueNode> &tuningNode()
+	{
+		if (!tuning_) {
+			UniqueFD fd = MemFd::create("mtkisp50-awb-tuning2", 0);
+			if (write(fd.get(), kTuning, strlen(kTuning)) > 0) {
+				File file("/proc/self/fd/" + std::to_string(fd.get()));
+				if (file.open(File::OpenModeFlag::ReadOnly))
+					tuning_ = YamlParser::parse(file);
+			}
+		}
+		return tuning_;
+	}
+
+	std::unique_ptr<ValueNode> tuning_;
+};
+
+TEST_REGISTER(MtkIsp50AwbTest)
