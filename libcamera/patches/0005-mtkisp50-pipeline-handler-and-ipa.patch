+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * mtkisp50 IPA: white balance in dark scenes and the rendering of warm light
+ */
+
+#include <cmath>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <memory>
+#include <stdlib.h>
+#include <string>
+#include <unistd.h>
+#include <vector>
+
+#include <libcamera/base/file.h>
+#include <libcamera/base/memfd.h>
+
+#include <libcamera/control_ids.h>
+
+#include "libcamera/internal/yaml_parser.h"
+
+#include "mtkisp50/algorithms/awb.h"
+#include "mtkisp50/algorithms/ccm.h"
+#include "mtkisp50/awb_preference.h"
+#include "mtkisp50/ipa_context.h"
+#include "mtkisp50/unit_tuning.h"
+
+#include "test.h"
+
+using namespace std::literals::chrono_literals;
+using namespace libcamera;
+using namespace libcamera::ipa::mtkisp50;
+
+namespace {
+
+/* A curve, a preference and identity matrices: values for the test only */
+const char *kTuning = R"(%YAML 1.1
+---
+Awb:
+  algorithm: bayes
+  speed: 0.5
+  colourGains:
+    - ct: 2500
+      gains: [ 1.0, 3.0 ]
+    - ct: 4000
+      gains: [ 1.5, 2.0 ]
+    - ct: 6500
+      gains: [ 2.0, 1.5 ]
+  priors:
+    - lux: 0
