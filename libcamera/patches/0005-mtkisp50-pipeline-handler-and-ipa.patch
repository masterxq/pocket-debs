+++ b/test/mtkisp50/streams.cpp
@@ -0,0 +1,254 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * mtkisp50 pipeline: assignment of the streams to the outputs of the ISP
+ */
+
+#include <iostream>
+#include <string>
+#include <vector>
+
+#include <libcamera/formats.h>
+#include <libcamera/stream.h>
+
+#include "streams.h"
+
+#include "test.h"
+
+using namespace libcamera;
+
+namespace {
+
+/* The modes of the main camera: 4x4 and 2x2 binned, both the whole field */
+const std::vector<Size> kModes = { { 2304, 1728 }, { 4624, 3472 } };
+
+StreamConfiguration stream(PixelFormat format, Size size)
+{
+	StreamConfiguration cfg;
+	cfg.pixelFormat = format;
+	cfg.size = size;
+	return cfg;
+}
+
+} /* namespace */
+
+class MtkIsp50StreamsTest : public Test
+{
+protected:
+	int fail(const std::string &what, const std::vector<StreamConfiguration> &configs)
+	{
+		std::cerr << what << ":";
+		for (const StreamConfiguration &cfg : configs)
+			std::cerr << " " << cfg.toString();
+		std::cerr << std::endl;
+		return TestFail;
+	}
+
+	int run() override
+	{
+		const PixelFormat raw10 = formats::SBGGR10_MTISP;
+		using Status = CameraConfiguration::Status;
+
+		/* Viewfinder alone: NV12 crop of the small mode, as before */
+		{
+			std::vector<StreamConfiguration> c = { stream(formats::XRGB8888, { 2304, 1728 }) };
+			MtkIsp50StreamPlan plan(kModes, true);
+			if (plan.plan(c) != Status::Adjusted || plan.main != 0 || plan.scaled != -1 ||
+			    c[0].pixelFormat != formats::NV12 || c[0].size != Size(2304, 1728) ||
+			    plan.mode != Size(2304, 1728) || plan.crop != Rectangle(0, 0, 2304, 1728))
+				return fail("viewfinder alone", c);
+		}
+
+		/* NV12 1920x1080 alone: crop of the small mode, valid */
+		{
+			std::vector<StreamConfiguration> c = { stream(formats::NV12, { 1920, 1080 }) };
+			MtkIsp50StreamPlan plan(kModes, true);
+			if (plan.plan(c) != Status::Valid || plan.mode != Size(2304, 1728) ||
+			    plan.crop != Rectangle(192, 324, 1920, 1080))
+				return fail("NV12 1920x1080", c);
+		}
+
+		/* Video: YUYV 1920x1080 scaled from 16:9 of the whole large mode */
+		{
+			std::vector<StreamConfiguration> c = { stream(formats::YUYV, { 1920, 1080 }) };
+			MtkIsp50StreamPlan plan(kModes, true);
+			if (plan.plan(c) != Status::Valid || plan.scaled != 0 || plan.main != -1 ||
+			    plan.mode != Size(4624, 3472) ||
+			    plan.crop != Rectangle(0, 436, 4624, 2600) ||
+			    c[0].size != Size(1920, 1080) || plan.outputs() != MtkIsp50OutputScaled)
+				return fail("video", c);
+		}
+
+		/* Small YUYV: the small mode is enough */
+		{
+			std::vector<StreamConfiguration> c = { stream(formats::YUYV, { 640, 480 }) };
+			MtkIsp50StreamPlan plan(kModes, true);
+			if (plan.plan(c) != Status::Valid || plan.mode != Size(2304, 1728) ||
+			    plan.crop != Rectangle(0, 0, 2304, 1728))
+				return fail("small YUYV", c);
+		}
+
+		/* YUYV larger than half the large mode: bounded with its ratio */
+		{
+			std::vector<StreamConfiguration> c = { stream(formats::YUYV, { 4000, 3000 }) };
+			MtkIsp50StreamPlan plan(kModes, true);
+			if (plan.plan(c) != Status::Adjusted || plan.mode != Size(4624, 3472) ||
+			    c[0].size != Size(2312, 1734))
+				return fail("large YUYV", c);
+		}
+
+		/* Viewfinder + still: still main, viewfinder scaled, same area */
+		{
+			std::vector<StreamConfiguration> c = {
+				stream(formats::YUYV, { 2304, 1728 }),
+				stream(formats::NV12, { 4624, 3472 }),
+			};
+			MtkIsp50StreamPlan plan(kModes, true);
+			if (plan.plan(c) != Status::Valid || plan.main != 1 || plan.scaled != 0 ||
+			    plan.mode != Size(4624, 3472) ||
+			    plan.crop != Rectangle(0, 0, 4624, 3472) ||
+			    plan.outputs() != (MtkIsp50OutputMain | MtkIsp50OutputScaled))
+				return fail("viewfinder + still", c);
+		}
+
+		/* Two of the same format: the larger one is the main output */
+		{
+			std::vector<StreamConfiguration> c = {
+				stream(formats::NV12, { 2304, 1728 }),
+				stream(formats::NV12, { 4624, 3472 }),
+			};
+			MtkIsp50StreamPlan plan(kModes, true);
+			if (plan.plan(c) != Status::Adjusted || plan.main != 1 || plan.scaled != 0 ||
+			    c[0].pixelFormat != formats::YUYV || c[0].size != Size(2304, 1728))
+				return fail("two NV12", c);
+		}
+
+		/* Viewfinder 4:3 next to a 16:9 video: ratio and limit of the area */
+		{
+			std::vector<StreamConfiguration> c = {
+				stream(formats::YUYV, { 1280, 960 }),
+				stream(formats::NV12, { 1920, 1080 }),
+			};
+			MtkIsp50StreamPlan plan(kModes, true);
+			if (plan.plan(c) != Status::Adjusted || plan.mode != Size(2304, 1728) ||
+			    c[0].size != Size(960, 540) || c[1].size != Size(1920, 1080))
+				return fail("viewfinder + video", c);
+		}
+
+		/* Scaled larger than half the main output: bounded */
+		{
+			std::vector<StreamConfiguration> c = {
+				stream(formats::NV12, { 2304, 1728 }),
+				stream(formats::YUYV, { 2304, 1728 }),
+			};
+			MtkIsp50StreamPlan plan(kModes, true);
+			if (plan.plan(c) != Status::Adjusted || plan.main != 0 ||
+			    c[1].size != Size(1152, 864))
+				return fail("scaled too large", c);
+		}
+
+		/* Smaller than 1/16: up to the limit */
+		{
+			std::vector<StreamConfiguration> c = {
+				stream(formats::NV12, { 4624, 3472 }),
+				stream(formats::YUYV, { 160, 120 }),
+			};
+			MtkIsp50StreamPlan plan(kModes, true);
+			if (plan.plan(c) != Status::Adjusted || c[1].size != Size(290, 218))
+				return fail("scaled too small", c);
+		}
+
+		/* Raw + viewfinder + still: all three, raw chooses the mode */
+		{
+			std::vector<StreamConfiguration> c = {
+				stream(formats::YUYV, { 2304, 1728 }),
+				stream(formats::NV12, { 4624, 3472 }),
+				stream(raw10, { 4624, 3472 }),
+			};
+			MtkIsp50StreamPlan plan(kModes, true);
+			if (plan.plan(c) != Status::Valid || plan.raw != 2 || plan.main != 1 ||
+			    plan.scaled != 0)
+				return fail("raw + viewfinder + still", c);
+		}
+
+		/* Raw of the small mode bounds the main output */
+		{
+			std::vector<StreamConfiguration> c = {
+				stream(formats::NV12, { 4624, 3472 }),
+				stream(raw10, { 2304, 1728 }),
+			};
+			MtkIsp50StreamPlan plan(kModes, true);
+			if (plan.plan(c) != Status::Adjusted || plan.mode != Size(2304, 1728) ||
+			    c[0].size != Size(2304, 1728))
+				return fail("raw bounds main", c);
+		}
+
+		/* A third processed stream and a second raw one are dropped */
+		{
+			std::vector<StreamConfiguration> c = {
+				stream(formats::NV12, { 4624, 3472 }),
+				stream(raw10, { 4624, 3472 }),
+				stream(formats::YUYV, { 1920, 1080 }),
+				stream(formats::NV12, { 640, 480 }),
+				stream(raw10, { 2304, 1728 }),
+			};
+			MtkIsp50StreamPlan plan(kModes, true);
+			if (plan.plan(c) != Status::Adjusted || c.size() != 3 || plan.main != 0 ||
+			    plan.raw != 1 || plan.scaled != 2 || c[1].size != Size(4624, 3472))
+				return fail("too many streams", c);
+		}
+
+		/* Without the scaled output: one processed stream, NV12 */
+		{
+			std::vector<StreamConfiguration> c = {
+				stream(formats::YUYV, { 1920, 1080 }),
+				stream(formats::NV12, { 4624, 3472 }),
+			};
+			MtkIsp50StreamPlan plan(kModes, true, false);
+			if (plan.plan(c) != Status::Adjusted || c.size() != 1 || plan.main != 0 ||
+			    plan.scaled != -1 || c[0].pixelFormat != formats::NV12 ||
+			    c[0].size != Size(1920, 1080))
+				return fail("no scaled output", c);
+		}
+
+		/* Without the ISP: the first stream becomes raw */
+		{
+			std::vector<StreamConfiguration> c = {
+				stream(formats::NV12, { 1920, 1080 }),
+				stream(formats::YUYV, { 640, 480 }),
+			};
+			MtkIsp50StreamPlan plan(kModes, false);
+			if (plan.plan(c) != Status::Adjusted || c.size() != 1 || plan.raw != 0 ||
+			    plan.outputs() || plan.mode != Size(2304, 1728))
+				return fail("no ISP", c);
+		}
+
+		/* Widths of the processed area the tiles cannot serve */
+		if (MtkIsp50StreamPlan::ispWidth(4540) != 4510 ||
+		    MtkIsp50StreamPlan::ispWidth(1920) != 1920 ||
+		    MtkIsp50StreamPlan::ispWidth(690) != 688) {
+			std::cerr << "band widths" << std::endl;
+			return TestFail;
+		}
+
+		/* NV12 in a band: rounded down */
+		{
+			std::vector<StreamConfiguration> c = { stream(formats::NV12, { 4540, 3000 }) };
+			MtkIsp50StreamPlan plan(kModes, true);
+			if (plan.plan(c) != Status::Adjusted || c[0].size != Size(4510, 3000) ||
+			    plan.crop.x % 4)
+				return fail("main in a band", c);
+		}
+
+		/* Nothing asked */
+		{
+			std::vector<StreamConfiguration> c;
+			MtkIsp50StreamPlan plan(kModes, true);
+			if (plan.plan(c) != Status::Invalid)
+				return fail("empty", c);
+		}
+
+		return TestPass;
+	}
+};
+
+TEST_REGISTER(MtkIsp50StreamsTest)
