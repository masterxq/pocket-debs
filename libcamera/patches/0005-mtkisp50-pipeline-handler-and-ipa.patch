+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Multi-frame still images of the mtkisp50 pipeline: the multi-frame
+ * blending block (MFB) and the worker that aligns and blends a series
+ */
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <memory>
+#include <stdint.h>
+#include <string>
+#include <vector>
+
+#include <libcamera/base/object.h>
+#include <libcamera/base/shared_fd.h>
+#include <libcamera/base/signal.h>
+#include <libcamera/base/unique_fd.h>
+
+namespace libcamera {
+
+class MediaDevice;
+
+namespace mtkisp50 {
+class FrameAligner;
+} /* namespace mtkisp50 */
+
+/*
+ * The multi-frame blending block, media device "mtk-mfb", used through its
+ * video nodes directly (blocking, with a timeout): it runs in the worker
+ * thread, a blend at a time. Images are NV12 of one buffer, the weight maps
+ * GREY; all go in and out as DMABUFs.
+ */
+class MtkIsp50Mfb
+{
+public:
+	enum Node {
+		Base = 0,
+		Ref,
+		WeightIn,
+		Params,
+		Out,
+		WeightOut,
+		NodeCount,
+	};
+
+	/* Device nodes of the block, empty if the media device lacks one */
+	static std::vector<std::string> nodesOf(MediaDevice *media);
+
+	MtkIsp50Mfb() = default;
+	~MtkIsp50Mfb();
+
+	int open(const std::vector<std::string> &nodes);
+	void close();
+	bool isOpen() const { return fds_[Base].isValid(); }
+
+	/*
+	 * Image size and line length of all images; allocates up to @images
+	 * NV12 buffers and @maps weight maps from the camera memory and
+	 * exports them. Returns 0 or an error; fewer buffers when the memory
+	 * is short.
+	 */
+	int configure(unsigned int width, unsigned int height, unsigned int stride,
+		      unsigned int images, unsigned int maps,
+		      std::vector<UniqueFD> *imageFds, std::vector<UniqueFD> *mapFds);
+	void release();
+
+	size_t imageSize() const { return imageSize_; }
+	size_t mapSize() const { return mapSize_; }
+
+	/* A series of blends: start, blends, stop */
+	int start(const std::vector<uint8_t> &params);
+	int blend(int base, int ref, int weightIn, int out, int weightOut, unsigned int timeoutMs);
+	void stop();
+
+private:
+	int ioctlNode(Node node, unsigned long request, void *arg);
+	int setFormat(Node node, uint32_t fourcc, unsigned int width, unsigned int height,
+		      unsigned int stride, size_t *size);
+	int requestBuffers(Node node, unsigned int count, unsigned int memory);
+	int exportBuffers(Node node, unsigned int count, std::vector<UniqueFD> *fds);
+	int queue(Node node, int fd, size_t length, size_t bytesused);
+	int dequeue(Node node, unsigned int timeoutMs, bool *error);
+	int streamOn(Node node);
+	void streamOff(Node node);
+
+	std::array<UniqueFD, NodeCount> fds_;
+	std::array<bool, NodeCount> streaming_{};
+	size_t imageSize_ = 0;
+	size_t mapSize_ = 0;
+	void *paramsMap_ = nullptr;
+	size_t paramsLength_ = 0;
+	bool paramsPending_ = false;
+	unsigned int blends_ = 0;
+};
+
+/* One NV12 image buffer of a series, mapped for the CPU in the worker */
+struct MtkIsp50SeriesImage {
+	SharedFD fd;
+	size_t length = 0;
+};
+
+struct MtkIsp50SeriesJob {
+	/* Images of the series in capture order, indices into the image list */
+	std::vector<unsigned int> frames;
+	/* The image the application gets the still image in */
+	unsigned int appImage = 0;
+	/* Image the aligned reference frames are written to */
+	unsigned int warpImage = 0;
+	/* Images without a frame (frames that failed), free for blends */
+	std::vector<unsigned int> free;
+	/* Parameters of the blending block */
+	std::vector<uint8_t> blendParams;
+};
+
+/*
+ * One blend of a series: the reference frame (index into the frames of the
+ * job), aligned into the warp image, blended onto the image @base into the
+ * image @out; the weight maps in and out (index of the two maps, -1 for no
+ * map in for the first blend)
+ */
+struct MtkIsp50BlendStep {
+	unsigned int frame;
+	unsigned int base;
+	unsigned int out;
+	int mapIn;
+	unsigned int mapOut;
+};
+
+/*
+ * The blends of a series in their order: the references in capture order,
+ * the application image first so that it never holds the last blend (the
+ * last ISP job reads the last blend and writes the application image). Each
+ * blend writes into the image of its reference (free once aligned into the
+ * warp image), the last one into a free image when its reference is the
+ * application image; without one that reference is left out. @usable tells
+ * the references the alignment can use (one per frame, the base frame
+ * ignored).
+ */
+std::vector<MtkIsp50BlendStep> mtkIsp50PlanBlends(const MtkIsp50SeriesJob &job, unsigned int baseIndex,
+						  const std::vector<bool> &usable);
+
+struct MtkIsp50SeriesResult {
+	/* 0, or the error that stopped the series (no blend result) */
+	int status = 0;
+	/* Images: the base frame, the last blend, free for the base frame */
+	int base = -1;
+	int blended = -1;
+	int spare = -1;
+	/* The weight map of the last blend, -1 without blend */
+	int map = -1;
+	unsigned int blends = 0;
+	unsigned int unusable = 0;
+	/* Times in ms: map and sync, estimate, warp, blend */
+	double tEstimate = 0.0;
+	/* Phases of the estimate: reduce the frames, match, fit the models */
+	double tReduce = 0.0;
+	double tMatch = 0.0;
+	double tFit = 0.0;
+	double tWarp = 0.0;
+	double tBlend = 0.0;
+	double tTotal = 0.0;
+};
+
+/*
+ * Aligns and blends a series in a thread of its own, so that the pipeline
+ * thread stays responsive: base frame and motion from the aligner, each
+ * usable reference frame aligned onto the base frame and blended in the MFB.
+ */
+class MtkIsp50SeriesWorker : public Object
+{
+public:
+	MtkIsp50SeriesWorker();
+	~MtkIsp50SeriesWorker();
+
+	int open(const std::vector<std::string> &nodes);
+	bool available() const { return mfb_.isOpen(); }
+
+	/*
+	 * Allocate up to @images NV12 images and the two weight maps of the
+	 * blends; fewer images when the memory is short. Returns 0 or an
+	 * error (no weight maps, fewer than @minImages images).
+	 */
+	int configure(unsigned int width, unsigned int height, unsigned int stride,
+		      unsigned int images, unsigned int minImages,
+		      std::vector<SharedFD> *imageFds, std::vector<SharedFD> *mapFds);
+	void release();
+	size_t imageSize() const { return mfb_.imageSize(); }
+	size_t mapSize() const { return mfb_.mapSize(); }
+
+	/*
+	 * Images a job refers to: the allocated ones in their order, then the
+	 * buffer of the application (changes from still image to still image)
+	 */
+	void setImages(const std::vector<MtkIsp50SeriesImage> &images);
+
+	void process(const MtkIsp50SeriesJob &job);
+
+	/*
+	 * From any thread: the series being processed stops after the current
+	 * step and reports an error, until sync() (in the thread of the worker:
+	 * once the series is done)
+	 */
+	void abort() { abort_ = true; }
+	void sync() { abort_ = false; }
+
+	Signal<const MtkIsp50SeriesResult &> done;
+
+private:
+	struct Mapped {
+		uint8_t *data = nullptr;
+		size_t length = 0;
+	};
+
+	int map(unsigned int index);
+	void unmapAll();
+	unsigned int usableFrames() const;
+
+	MtkIsp50Mfb mfb_;
+	std::unique_ptr<mtkisp50::FrameAligner> aligner_;
+	std::vector<SharedFD> maps_;
+
+	unsigned int width_ = 0;
+	unsigned int height_ = 0;
+	unsigned int stride_ = 0;
+
+	std::vector<MtkIsp50SeriesImage> images_;
+	std::vector<Mapped> mapped_;
+
+	std::atomic<bool> abort_ = false;
+};
+
+} /* namespace libcamera */
