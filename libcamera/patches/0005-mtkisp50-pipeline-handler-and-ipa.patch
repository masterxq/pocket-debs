+
+void FrameAligner::displacement(unsigned int index, float x, float y, float *dx, float *dy) const
+{
+	const Impl &d = *impl_;
+	const Frame &f = d.frames.at(index);
+	const float ds = d.cfg.downscale;
+	const float xc = x + 0.5f, yc = y + 0.5f;
+	double ox, oy;
+	applyH(f.h, xc / ds, yc / ds, &ox, &oy);
+	const Vec2 s = index == d.baseIndex ? Vec2{ 0, 0 } : d.localAt(f, xc / ds, yc / ds);
+	*dx = float((ox + s.x) * ds - xc);
+	*dy = float((oy + s.y) * ds - yc);
+}
