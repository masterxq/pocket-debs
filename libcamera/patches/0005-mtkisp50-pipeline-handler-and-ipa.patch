+/* ---- Warp ---------------------------------------------------------------- */
+
+namespace {
+
+/* Bilinear with fixed weights in 1/16: n output bytes, neighbours step
+ * bytes apart */
+inline void lerp2d(uint8_t *__restrict out, const uint8_t *__restrict s0,
+		   const uint8_t *__restrict s1, int n, int step, unsigned int fx, unsigned int fy)
+{
+	const uint16_t w00 = (16 - fx) * (16 - fy), w01 = fx * (16 - fy);
+	const uint16_t w10 = (16 - fx) * fy, w11 = fx * fy;
+	for (int i = 0; i < n; i++)
+		out[i] = uint8_t((uint16_t(s0[i] * w00 + s0[i + step] * w01 + s1[i] * w10 +
+					   s1[i + step] * w11) + 128) >> 8);
+}
+
+inline void lerpH(uint8_t *__restrict out, const uint8_t *__restrict s0, int n, int step,
+		  unsigned int fx)
+{
+	const uint16_t a = 16 - fx, b = fx;
+	for (int i = 0; i < n; i++)
+		out[i] = uint8_t((uint16_t(s0[i] * a + s0[i + step] * b) + 8) >> 4);
+}
+
+inline void lerpV(uint8_t *__restrict out, const uint8_t *__restrict s0,
+		  const uint8_t *__restrict s1, int n, unsigned int fy)
+{
+	const uint16_t a = 16 - fy, b = fy;
+	for (int i = 0; i < n; i++)
+		out[i] = uint8_t((uint16_t(s0[i] * a + s1[i] * b) + 8) >> 4);
+}
+
+/*
+ * Bilinear over a run whose source offset moves linearly: offsets in 1/65536
+ * pixel at the first sample (ox, oy, integer part constant over the run)
+ * and their change per sample. Weights in 1/16 per sample. Samples of
+ * 1 << Shift bytes (interleaved chroma: 2).
+ */
+template<int Shift>
+inline void lerpRun(uint8_t *__restrict out, const uint8_t *__restrict s0,
+		    const uint8_t *__restrict s1, int n, int32_t ox, int32_t dox, int32_t oy,
+		    int32_t doy)
+{
+	constexpr int c = 1 << Shift;
+	const int bytes = n << Shift;
+	for (int j = 0; j < bytes; j++) {
+		const int32_t i = j >> Shift;
+		const uint16_t fx = ((ox + i * dox) >> 12) & 15;
+		const uint16_t fy = ((oy + i * doy) >> 12) & 15;
+		const uint16_t a = s0[j] * (16 - fx) + s0[j + c] * fx;
+		const uint16_t b = s1[j] * (16 - fx) + s1[j + c] * fx;
+		out[j] = uint8_t(uint16_t(a * (16 - fy) + b * fy + 128) >> 8);
+	}
+}
+
+/* Samples until the integer part of o + k * d changes, at most n */
+inline int runLength(int32_t o, int32_t d, int n)
+{
+	if (d == 0)
+		return n;
+	const int64_t base = int64_t(o >> 16) << 16;
+	int64_t k;
+	if (d > 0)
+		k = (base + 65536 - o + d - 1) / d;
+	else
+		k = (o - base) / -int64_t(d) + 1;
+	return int(std::clamp<int64_t>(k, 1, n));
+}
+
+} /* namespace */
+
+/*
+ * Rows [r0, r1) of one plane: w samples of channels bytes per row. step is
+ * the control point distance in plane pixels, scale converts the frame
+ * displacement to plane pixels.
+ */
+void FrameAligner::Impl::warpPlane(const Frame &f, const uint8_t *src, unsigned int sstride,
+				   uint8_t *dst, unsigned int dstride, int w, int h, int channels,
+				   int step, float scale, int r0, int r1) const
+{
+	const int nc = nodeCols + 1;
+	std::vector<Vec2> d(nc);
+	for (int y = r0; y < r1; y++) {
+		uint8_t *out = dst + size_t(y) * dstride;
+		const float fyn = (y + 0.5f) / step;
+		const int j0 = std::clamp(int(fyn), 0, nodeRows - 1);
+		const float wy = std::clamp(fyn - j0, 0.0f, 1.0f);
+		const Vec2 *n0 = &f.nodes[size_t(j0) * nc], *n1 = n0 + nc;
+		for (int i = 0; i < nc; i++)
+			d[i] = { scale * ((1 - wy) * n0[i].x + wy * n1[i].x),
+				 scale * ((1 - wy) * n0[i].y + wy * n1[i].y) };
+
+		for (int i = 0; i < nodeCols; i++) {
+			const int xs = i * step, xe = std::min(w, xs + step);
+			if (xs >= xe)
+				break;
+			const Vec2 a = d[i], b = d[i + 1];
+			/* offset of the source at sample xs + k, rounded to 1/16:
+			 * o(k) = o0 + k * do (1/65536 pixel) */
+			const double gx = (b.x - a.x) / step, gy = (b.y - a.y) / step;
+			int32_t ox = int32_t(std::lround((a.x + gx * 0.5) * 65536)) + 2048;
+			int32_t oy = int32_t(std::lround((a.y + gy * 0.5) * 65536)) + 2048;
+			const int32_t dox = int32_t(std::lround(gx * 65536));
+			const int32_t doy = int32_t(std::lround(gy * 65536));
+			int x = xs;
+			while (x < xe) {
+				int n = xe - x;
+				n = std::min(runLength(ox, dox, n), runLength(oy, doy, n));
+				const int ix = ox >> 16, iy = oy >> 16;
+				const int sx = x + ix, sy = y + iy;
+				uint8_t *o = out + x * channels;
+				/* fractions over the run (constant if the offset does not move) */
+				const bool fx = dox || (ox & 0xf000), fy = doy || (oy & 0xf000);
+				if (sy >= 0 && sy + (fy ? 1 : 0) < h && sx >= 0 && sx + n - 1 + (fx ? 1 : 0) < w) {
+					const uint8_t *s0 = src + size_t(sy) * sstride + sx * channels;
+					const uint8_t *s1 = fy ? s0 + sstride : s0;
+					if (dox || doy) {
+						if (channels == 1)
+							lerpRun<0>(o, s0, s1, n, ox, dox, oy, doy);
+						else
+							lerpRun<1>(o, s0, s1, n, ox, dox, oy, doy);
+					} else {
+						const unsigned int cx = (ox >> 12) & 15, cy = (oy >> 12) & 15;
+						if (!cx && !cy)
+							memcpy(o, s0, n * channels);
+						else if (!cy)
+							lerpH(o, s0, n * channels, channels, cx);
+						else if (!cx)
+							lerpV(o, s0, s1, n * channels, cy);
+						else
+							lerp2d(o, s0, s1, n * channels, channels, cx, cy);
+					}
+				} else {
+					/* border: clamp every tap */
+					for (int k = 0; k < n; k++) {
+						const int32_t px = ox + k * dox, py = oy + k * doy;
+						const int qx = x + k + (px >> 16), qy = y + (py >> 16);
+						const unsigned int cx = (px >> 12) & 15, cy = (py >> 12) & 15;
+						const int xa = std::clamp(qx, 0, w - 1), xb = std::clamp(qx + 1, 0, w - 1);
+						const int ya = std::clamp(qy, 0, h - 1), yb = std::clamp(qy + 1, 0, h - 1);
+						const uint8_t *s0 = src + size_t(ya) * sstride, *s1 = src + size_t(yb) * sstride;
+						for (int c = 0; c < channels; c++) {
+							const unsigned int v =
+								(s0[xa * channels + c] * (16 - cx) + s0[xb * channels + c] * cx) * (16 - cy) +
+								(s1[xa * channels + c] * (16 - cx) + s1[xb * channels + c] * cx) * cy;
+							o[k * channels + c] = uint8_t((v + 128) >> 8);
+						}
+					}
+				}
+				ox += n * dox;
+				oy += n * doy;
+				x += n;
+			}
+		}
+	}
+}
+
+int FrameAligner::warp(unsigned int index, const Nv12Target &out)
+{
+	Impl &d = *impl_;
+	if (index >= d.frames.size() || !out.y || !out.uv || out.strideY < d.width ||
+	    out.strideUV < d.width)
+		return -1;
+	const Frame &f = d.frames[index];
+	const double t0 = nowMs();
+	const int h = d.height, hc = d.height / 2;
+	const int band = 16;
+	const int bandsY = (h + band - 1) / band, bandsC = (hc + band - 1) / band;
+	d.pool.run(bandsY + bandsC, [&](size_t item) {
+		if (int(item) < bandsY) {
+			const int r0 = item * band;
+			d.warpPlane(f, f.img.y, f.img.strideY, out.y, out.strideY, d.width, h, 1,
+				    d.nodeStep, 1.0f, r0, std::min(h, r0 + band));
+		} else {
+			const int r0 = (item - bandsY) * band;
+			d.warpPlane(f, f.img.uv, f.img.strideUV, out.uv, out.strideUV, d.width / 2, hc, 2,
+				    d.nodeStep / 2, 0.5f, r0, std::min(hc, r0 + band));
+		}
+	});
+	d.timing.warp = nowMs() - t0;
+	return 0;
+}
+
+int FrameAligner::expandReliability(unsigned int index, uint8_t *map, unsigned int stride) const
+{
+	const Impl &d = *impl_;
+	if (index >= d.frames.size() || !map || stride < d.width)
+		return -1;
+	const Frame &f = d.frames[index];
+	const BlockGrid &g = d.blockGrid;
+	const unsigned int *vr = f.result.validRect;
+	const int cols = g.cols, rows = g.rows;
+	std::vector<float> wx(d.width);
+	std::vector<int> ix(d.width);
+	for (unsigned int x = 0; x < d.width; x++) {
+		const float p = std::clamp((x + 0.5f - g.originX) / g.size - 0.5f, 0.0f, float(cols - 1));
+		ix[x] = std::min(int(p), std::max(0, cols - 2));
+		wx[x] = cols > 1 ? p - ix[x] : 0;
+	}
+	for (unsigned int y = 0; y < d.height; y++) {
+		uint8_t *o = map + size_t(y) * stride;
+		if (y < vr[1] || y >= vr[1] + vr[3]) {
+			memset(o, 0, d.width);
+			continue;
+		}
+		const float p = std::clamp((y + 0.5f - g.originY) / g.size - 0.5f, 0.0f, float(rows - 1));
+		const int j = std::min(int(p), std::max(0, rows - 2));
+		const float wy = rows > 1 ? p - j : 0;
+		const uint8_t *a = &f.rel[j * cols], *b = &f.rel[std::min(j + 1, rows - 1) * cols];
+		for (unsigned int x = 0; x < d.width; x++) {
+			if (x < vr[0] || x >= vr[0] + vr[2]) {
+				o[x] = 0;
+				continue;
+			}
+			const int i = ix[x], i1 = std::min(i + 1, cols - 1);
+			const float top = a[i] + (a[i1] - a[i]) * wx[x];
+			const float bot = b[i] + (b[i1] - b[i]) * wx[x];
+			o[x] = uint8_t(top + (bot - top) * wy + 0.5f);
+		}
+	}
+	return 0;
+}
+
+} /* namespace libcamera::mtkisp50 */
diff --git a/src/libcamera/pipeline/mtkisp50/align/frame_aligner.h b/src/libcamera/pipeline/mtkisp50/align/frame_aligner.h
new file mode 100644
index 0000000..1bb50fd
--- /dev/null
+++ b/src/libcamera/pipeline/mtkisp50/align/frame_aligner.h
@@ -0,0 +1,185 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Alignment of a burst of NV12 frames for multi-frame noise reduction
+ *
+ * Picks a base frame (the sharpest one), estimates the motion of every other
+ * frame against it and resamples those frames onto the base. The motion is a
+ * global model (shift, rotation, small perspective change: a homography) plus
+ * a smooth local correction. Blocks that do not follow that motion (moving
+ * objects, occlusions) are not followed but marked as unreliable, so that the
+ * merge can weight them down.
+ *
+ * Coarse to fine block matching on a reduced luma pyramid with sub-pixel
+ * refinement (Lucas-Kanade), a robust fit of the global model and a robust
+ * smoothing of the local residual. The warp is done at full size for luma and
+ * chroma, from a displacement field that is interpolated between control
+ * points, so there are no block seams.
+ *
+ * No device, no allocation of image buffers: the caller passes the frames
+ * and the output buffers. Working memory is the reduced pyramids of all
+ * frames (see workingMemory()), released at the end of estimate().
+ */
+
+#pragma once
+
+#include <memory>
+#include <stddef.h>
+#include <stdint.h>
+
+namespace libcamera::mtkisp50 {
+
+/* An NV12 frame: luma plane and interleaved CbCr plane at half size */
+struct Nv12Frame {
+	const uint8_t *y;
+	unsigned int strideY;
+	const uint8_t *uv;
+	unsigned int strideUV;
+};
+
+/* Writable NV12 buffer of the frame size */
+struct Nv12Target {
+	uint8_t *y;
+	unsigned int strideY;
+	uint8_t *uv;
+	unsigned int strideUV;
+};
+
+enum class Model {
+	Translation,
+	Similarity,
+	Affine,
+	Homography,
+};
+
+struct AlignConfig {
+	/* Worker threads including the caller, 0 = number of CPUs */
+	unsigned int threads = 0;
+	/* Reduction of the finest matching level against the frame: 2 or 4 */
+	unsigned int downscale = 4;
+	/* Block size on the finest matching level (pixels of that level) */
+	unsigned int block = 16;
+	/* Largest global model; smaller ones are used if the data is too poor */
+	Model model = Model::Homography;
+	/* Base frame, -1 = choose by sharpness */
+	int baseIndex = -1;
+	/* Frames within this fraction of the best sharpness count as equal, the
+	 * one nearest to the middle of the burst wins */
+	float baseTolerance = 0.03f;
+	/* Exhaustive search of the global shift on the coarsest level, in pixels
+	 * of that level (coarsest = finest / 8 for big frames) */
+	unsigned int coarseSearch = 8;
+	/* Largest local correction in frame pixels */
+	float maxLocal = 4.0f;
+	/* Deviation from the smooth motion (frame pixels) that marks a block as
+	 * moving */
+	float motionThreshold = 1.5f;
+	/* Match error against the noise level: below errorLow a block is fully
+	 * reliable, above errorHigh it is unreliable */
+	float errorLow = 1.5f;
+	float errorHigh = 3.0f;
+	/* A frame is usable if fewer blocks are rejected and its residual is
+	 * smaller than this (frame pixels) */
+	float maxRejected = 0.5f;
+	float maxResidual = 1.0f;
+};
+
+/*
+ * Result of one frame. Coordinates are frame pixels with the centre of pixel
+ * (i, j) at (i + 0.5, j + 0.5).
+ */
+struct FrameResult {
+	/* Estimation done (false for the base frame and on failure) */
+	bool valid;
+	/* Good enough to be merged */
+	bool usable;
+	/* Sharpness used for the choice of the base frame (relative) */
+	float sharpness;
+	/* Global model actually fitted */
+	Model model;
+	/* Global model: base position -> position in this frame, row major */
+	double homography[9];
+	/* RMS deviation of the reliable structured blocks from the final
+	 * motion beyond their measurement noise, pixels (0 = consistent) */
+	float residual;
+	/* Fraction of blocks with reliability below 128 */
+	float rejected;
+	/* Median match error after alignment relative to the noise (1 = noise) */
+	float matchError;
+	/* Noise of the reduced luma (8 bit units) at mid grey, for information */
+	float noise;
+	/* Part of the base frame (x, y, width, height) whose source lies inside
+	 * this frame; outside, the output repeats the edge */
+	unsigned int validRect[4];
+};
+
+/* Block grid of the reliability maps, in frame pixels */
+struct BlockGrid {
+	unsigned int cols;
+	unsigned int rows;
+	/* Top left corner of the first block and block size */
+	unsigned int originX;
+	unsigned int originY;
+	unsigned int size;
+};
+
+class FrameAligner
+{
+public:
+	explicit FrameAligner(const AlignConfig &config = AlignConfig());
+	~FrameAligner();
+
+	FrameAligner(const FrameAligner &) = delete;
+	FrameAligner &operator=(const FrameAligner &) = delete;
+
+	/* Bytes of working memory for count frames of width x height */
+	static size_t workingMemory(unsigned int width, unsigned int height,
+				    unsigned int count, const AlignConfig &config = AlignConfig());
+
+	/*
+	 * Choose the base frame and estimate the motion of all others. Width and
+	 * height must be even and at least 64. The frames must stay valid until
+	 * the last warp(). Returns the base index, or -1 on bad arguments.
+	 */
+	int estimate(const Nv12Frame *frames, unsigned int count,
+		     unsigned int width, unsigned int height);
+
+	/* Base frame of the next estimate(), -1 = choose by sharpness */
+	void setBaseIndex(int index);
+
+	unsigned int count() const;
+	unsigned int base() const;
+	const FrameResult &result(unsigned int index) const;
+
+	/* Reliability per block (0..255), grid() order, row by row */
+	const BlockGrid &grid() const;
+	const uint8_t *reliability(unsigned int index) const;
+
+	/* Displacement of frame index at base position (x, y): the source of the
+	 * base pixel is at (x + dx, y + dy) in that frame */
+	void displacement(unsigned int index, float x, float y, float *dx, float *dy) const;
+
+	/*
+	 * Resample frame index onto the base frame into out (frame size). The
+	 * output must not overlap any input frame. Returns 0 or -1.
+	 */
+	int warp(unsigned int index, const Nv12Target &out);
+
+	/* Reliability as a full size 8 bit map (bilinear between block centres,
+	 * 0 outside validRect) */
+	int expandReliability(unsigned int index, uint8_t *map, unsigned int stride) const;
+
+	/* Time in ms of the phases of the last estimate() and warp() calls */
+	struct Timing {
+		double reduce;
+		double match;
+		double fit;
+		double warp;
+	};
+	const Timing &timing() const;
+
+private:
+	struct Impl;
+	std::unique_ptr<Impl> impl_;
+};
+
+} /* namespace libcamera::mtkisp50 */
diff --git a/src/libcamera/pipeline/mtkisp50/frames.cpp b/src/libcamera/pipeline/mtkisp50/frames.cpp
new file mode 100644
index 0000000..c094475
--- /dev/null
+++ b/src/libcamera/pipeline/mtkisp50/frames.cpp
@@ -0,0 +1,346 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Per request bookkeeping of the mtkisp50 pipeline
+ */
+
+#include "frames.h"
+
+#include <algorithm>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/framebuffer.h>
+
+namespace libcamera {
+
+LOG_DECLARE_CATEGORY(MtkIsp50)
+
+MtkIsp50Frames::MtkIsp50Frames()
+{
+}
+
+void MtkIsp50Frames::init(const std::vector<std::unique_ptr<FrameBuffer>> &paramsBuffers,
+			  const std::vector<std::unique_ptr<FrameBuffer>> &statsBuffers,
+			  unsigned int reserved)
+{
+	for (size_t i = 0; i + reserved < paramsBuffers.size(); i++)
+		availableParamsBuffers_.push(paramsBuffers[i].get());
+
+	for (const std::unique_ptr<FrameBuffer> &buffer : statsBuffers)
+		availableStatsBuffers_.push(buffer.get());
+
+	frameInfo_.clear();
+}
+
+void MtkIsp50Frames::clear()
+{
+	availableParamsBuffers_ = {};
+	availableStatsBuffers_ = {};
+	frameInfo_.clear();
+
+	ispOutputs_ = ~0u;
+	ispBusy_ = 0;
+	ispWaiting_.clear();
+	ispHeld_ = false;
+}
+
+MtkIsp50Frames::Info *MtkIsp50Frames::create(unsigned int id, Request *request,
+					     FrameBuffer *rawBuffer, bool rawFromRequest,
+					     FrameBuffer *outputBuffer, FrameBuffer *scaledBuffer)
+{
+	if (availableParamsBuffers_.empty()) {
+		LOG(MtkIsp50, Error) << "Parameters buffer underrun";
+		return nullptr;
+	}
+
+	if (availableStatsBuffers_.empty()) {
+		LOG(MtkIsp50, Error) << "Statistics buffer underrun";
+		return nullptr;
+	}
+
+	if (frameInfo_.count(id)) {
+		LOG(MtkIsp50, Error) << "Frame " << id << " already queued";
+		return nullptr;
+	}
+
+	auto info = std::make_unique<Info>();
+	info->id = id;
+	info->request = request;
+	info->rawBuffer = rawBuffer;
+	info->rawFromRequest = rawFromRequest;
+	info->outputBuffer = outputBuffer;
+	info->scaledBuffer = scaledBuffer;
+	info->paramsBuffer = availableParamsBuffers_.front();
+	info->statsBuffer = availableStatsBuffers_.front();
+	info->rawSequence = 0;
+	info->rawTimestamp = 0;
+	info->pdBuffer = nullptr;
+	info->paramsBytesused = 0;
+	info->captured = false;
+	info->ispQueued = false;
+	info->outputQueued = false;
+	info->scaledQueued = false;
+	info->ispBack = false;
+	info->rawDone = false;
+	info->outputDone = !outputBuffer;
+	info->scaledDone = !scaledBuffer;
+	info->paramsDone = false;
+	info->metadataDone = false;
+	info->error = false;
+	info->series = false;
+	info->held = false;
+
+	availableParamsBuffers_.pop();
+	availableStatsBuffers_.pop();
+
+	Info *ret = info.get();
+	frameInfo_[id] = std::move(info);
+
+	return ret;
+}
+
+void MtkIsp50Frames::remove(Info *info)
+{
+	/* Return the buffers to the pools */
+	availableParamsBuffers_.push(info->paramsBuffer);
+	availableStatsBuffers_.push(info->statsBuffer);
+
+	auto it = std::find(ispWaiting_.begin(), ispWaiting_.end(), info);
+	if (it != ispWaiting_.end())
+		ispWaiting_.erase(it);
+
+	frameInfo_.erase(info->id);
+}
+
+int MtkIsp50Frames::queueIspJob(Info *info, uint32_t paramsBytesused,
+				MtkIsp50IspQueue &queue)
+{
+	/* Raw only: no job, the raw frame is done once captured */
+	if (!outputsOf(info)) {
+		info->rawDone = true;
+		info->paramsDone = true;
+		return 0;
+	}
+
+	int ret = queue.queueRaw(info->rawBuffer);
+	if (ret) {
+		/* Nothing queued, the queues stay matched */
+		info->rawDone = true;
+		info->paramsDone = true;
+		info->outputDone = true;
+		info->scaledDone = true;
+		info->error = true;
+		return ret;
+	}
+
+	/* The raw buffer is in the ISP now */
+	info->ispQueued = true;
+
+	/*
+	 * The params node never holds a job back: without a params buffer the
+	 * ISP keeps the values of the previous job.
+	 */
+	if (paramsBytesused) {
+		if (queue.queueParams(info->paramsBuffer, paramsBytesused)) {
+			LOG(MtkIsp50, Warning)
+				<< "Failed to queue the parameters of frame " << info->id;
+			info->paramsDone = true;
+		}
+	} else {
+		info->paramsDone = true;
+	}
+
+	if (info->outputBuffer) {
+		ret = queue.queueOutput(info->outputBuffer);
+		if (!ret)
+			info->outputQueued = true;
+	}
+
+	if (!ret && info->scaledBuffer) {
+		ret = queue.queueScaled(info->scaledBuffer);
+		if (!ret)
+			info->scaledQueued = true;
+	}
+
+	if (ret) {
+		/*
+		 * The job is queued in part: the caller restarts the ISP, which
+		 * returns the buffers in it
+		 */
+		if (!info->outputQueued)
+			info->outputDone = true;
+		if (!info->scaledQueued)
+			info->scaledDone = true;
+		info->error = true;
+		return ret;
+	}
+
+	return 0;
+}
+
+unsigned int MtkIsp50Frames::outputsOf(const Info *info)
+{
+	return (info->outputBuffer ? MtkIsp50OutputMain : 0) |
+	       (info->scaledBuffer ? MtkIsp50OutputScaled : 0);
+}
+
+void MtkIsp50Frames::startIsp(unsigned int outputs)
+{
+	ispOutputs_ = outputs;
+	ispBusy_ = 0;
+	ispWaiting_.clear();
+	ispHeld_ = false;
+}
+
+void MtkIsp50Frames::submitIspJob(Info *info, uint32_t paramsBytesused)
+{
+	info->paramsBytesused = paramsBytesused;
+
+	if (!outputsOf(info)) {
+		info->rawDone = true;
+		info->paramsDone = true;
+		return;
+	}
+
+	ispWaiting_.push_back(info);
+}
+
+int MtkIsp50Frames::runIspJobs(MtkIsp50IspQueue &queue, Info **failed)
+{
+	while (!ispHeld_ && !ispWaiting_.empty()) {
+		Info *info = ispWaiting_.front();
+		const unsigned int outputs = outputsOf(info);
+
+		if (outputs != ispOutputs_) {
+			if (ispBusy_)
+				return 0;
+
+			int ret = queue.setOutputs(outputs);
+			if (ret) {
+				/* The job cannot run, nothing of it is queued */
+				ispOutputs_ = ~0u;
+				ispWaiting_.pop_front();
+				info->rawDone = true;
+				info->paramsDone = true;
+				info->outputDone = true;
+				info->scaledDone = true;
+				info->error = true;
+				*failed = info;
+				return ret;
+			}
+
+			ispOutputs_ = outputs;
+		}
+
+		ispWaiting_.pop_front();
+
+		int ret = queueIspJob(info, info->paramsBytesused, queue);
+		if (info->ispQueued)
+			ispBusy_++;
+		if (ret) {
+			*failed = info;
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+bool MtkIsp50Frames::ispJobBack(Info *info)
+{
+	if (!info->ispQueued || info->ispBack || !info->rawDone ||
+	    !info->outputDone || !info->scaledDone)
+		return false;
+
+	info->ispBack = true;
+	if (ispBusy_)
+		ispBusy_--;
+
+	return true;
+}
+
+bool MtkIsp50Frames::tryComplete(Info *info)
+{
+	if (!info->rawDone || !info->outputDone || !info->scaledDone ||
+	    !info->paramsDone || !info->metadataDone || info->held)
+		return false;
+
+	remove(info);
+
+	return true;
+}
+
+MtkIsp50Frames::Info *MtkIsp50Frames::first()
+{
+	if (frameInfo_.empty())
+		return nullptr;
+
+	return frameInfo_.begin()->second.get();
+}
+
+MtkIsp50Frames::Info *MtkIsp50Frames::find(unsigned int id)
+{
+	const auto &itInfo = frameInfo_.find(id);
+
+	if (itInfo != frameInfo_.end())
+		return itInfo->second.get();
+
+	return nullptr;
+}
+
+MtkIsp50Frames::Info *MtkIsp50Frames::findCapture(const FrameBuffer *buffer)
+{
+	for (auto const &itInfo : frameInfo_) {
+		Info *info = itInfo.second.get();
+		if (info->rawBuffer == buffer && !info->captured)
+			return info;
+	}
+
+	return nullptr;
+}
+
+MtkIsp50Frames::Info *MtkIsp50Frames::findIspRaw(const FrameBuffer *buffer)
+{
+	for (auto const &itInfo : frameInfo_) {
+		Info *info = itInfo.second.get();
+		if (info->rawBuffer == buffer && info->ispQueued && !info->rawDone)
+			return info;
+	}
+
+	return nullptr;
+}
+
+MtkIsp50Frames::Info *MtkIsp50Frames::findOutput(const FrameBuffer *buffer)
+{
+	for (auto const &itInfo : frameInfo_) {
+		Info *info = itInfo.second.get();
+		if (info->outputBuffer == buffer && !info->outputDone)
+			return info;
+	}
+
+	return nullptr;
+}
+
+MtkIsp50Frames::Info *MtkIsp50Frames::findScaled(const FrameBuffer *buffer)
+{
+	for (auto const &itInfo : frameInfo_) {
+		Info *info = itInfo.second.get();
+		if (info->scaledBuffer == buffer && !info->scaledDone)
+			return info;
+	}
+
+	return nullptr;
+}
+
+MtkIsp50Frames::Info *MtkIsp50Frames::findParams(const FrameBuffer *buffer)
+{
+	for (auto const &itInfo : frameInfo_) {
+		Info *info = itInfo.second.get();
+		if (info->paramsBuffer == buffer && !info->paramsDone)
+			return info;
+	}
+
+	return nullptr;
+}
+
+} /* namespace libcamera */
diff --git a/src/libcamera/pipeline/mtkisp50/frames.h b/src/libcamera/pipeline/mtkisp50/frames.h
new file mode 100644
index 0000000..5f29fd6
--- /dev/null
+++ b/src/libcamera/pipeline/mtkisp50/frames.h
@@ -0,0 +1,184 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Per request bookkeeping of the mtkisp50 pipeline
+ */
+
+#pragma once
+
+#include <deque>
+#include <map>
+#include <memory>
+#include <queue>
+#include <stdint.h>
+#include <vector>
+
+namespace libcamera {
+
+class FrameBuffer;
+class Request;
+
+/* Processed outputs of the ISP, bits of a mask */
+constexpr unsigned int MtkIsp50OutputMain = 1 << 0;
+constexpr unsigned int MtkIsp50OutputScaled = 1 << 1;
+
+/*
+ * Queues of the memory-to-memory ISP. A job runs when a raw buffer and a
+ * buffer of every streaming output are queued; a params buffer that is
+ * queued before them belongs to the same job. An output that starts or
+ * stops streaming joins or leaves from the next job on.
+ */
+class MtkIsp50IspQueue
+{
+public:
+	virtual ~MtkIsp50IspQueue() = default;
+
+	virtual int queueRaw(FrameBuffer *buffer) = 0;
+	virtual int queueParams(FrameBuffer *buffer, uint32_t bytesused) = 0;
+	virtual int queueOutput(FrameBuffer *buffer) = 0;
+	virtual int queueScaled(FrameBuffer *buffer) = 0;
+	/* Stream exactly the outputs of the mask */
+	virtual int setOutputs(unsigned int outputs) = 0;
+};
+
+class MtkIsp50Frames
+{
+public:
+	struct Info {
+		unsigned int id;
+		/* nullptr for a frame of the handler (multi-frame series) */
+		Request *request;
+
+		/* Raw frame of the capture device, from the pool or the request */
+		FrameBuffer *rawBuffer;
+		bool rawFromRequest;
+		/* Processed outputs of the request, nullptr if not in it */
+		FrameBuffer *outputBuffer;
+		FrameBuffer *scaledBuffer;
+		FrameBuffer *paramsBuffer;
+		FrameBuffer *statsBuffer;
+
+		uint32_t rawSequence;
+		uint64_t rawTimestamp;
+		/* Phase detection frame of the same sensor frame, if any */
+		FrameBuffer *pdBuffer;
+		/* Size of the parameters of the ISP job, 0 for none */
+		uint32_t paramsBytesused;
+
+		/* Steps done */
+		bool captured;
+		/* The raw buffer was queued to the ISP */
+		bool ispQueued;
+		bool outputQueued;
+		bool scaledQueued;
+		/* All buffers of the ISP job are back */
+		bool ispBack;
+		bool rawDone;
+		bool outputDone;
+		bool scaledDone;
+		bool paramsDone;
+		bool metadataDone;
+		bool error;
+
+		/*
+		 * Multi-frame series: the output buffer is an image of the
+		 * series (internal frames, and the still image whose buffer
+		 * takes the first frame and later the result); held: the
+		 * frame waits for the result of the series
+		 */
+		bool series;
+		bool held;
+	};
+
+	MtkIsp50Frames();
+
+	/* The last @reserved params buffers are left out (other jobs) */
+	void init(const std::vector<std::unique_ptr<FrameBuffer>> &paramsBuffers,
+		  const std::vector<std::unique_ptr<FrameBuffer>> &statsBuffers,
+		  unsigned int reserved = 0);
+	void clear();
+
+	/* nullptr if no params or statistics buffer is free */
+	Info *create(unsigned int id, Request *request, FrameBuffer *rawBuffer,
+		     bool rawFromRequest, FrameBuffer *outputBuffer,
+		     FrameBuffer *scaledBuffer = nullptr);
+	void remove(Info *info);
+
+	/*
+	 * Queue the ISP job of a frame: raw first (the only buffer the ISP
+	 * may refuse, an imported DMABUF), then params if bytesused > 0, then
+	 * the main and the scaled output. A frame without output has no job.
+	 * Returns 0 or the error of the first queue that failed; buffers not
+	 * queued are marked done (the caller cancels the outputs that are not
+	 * queued, and restarts the ISP if the raw buffer is in it).
+	 */
+	int queueIspJob(Info *info, uint32_t paramsBytesused, MtkIsp50IspQueue &queue);
+
+	/* Outputs the job of a frame writes */
+	static unsigned int outputsOf(const Info *info);
+
+	/*
+	 * Scheduling of the ISP jobs. Jobs go to the ISP in frame order. A
+	 * job whose outputs differ from the streaming ones waits until the
+	 * jobs in the ISP are back, then the outputs are switched: a job in
+	 * the ISP takes a buffer of every streaming output.
+	 */
+	void startIsp(unsigned int outputs);
+	/* A frame whose parameters are ready; frames without job are done */
+	void submitIspJob(Info *info, uint32_t paramsBytesused);
+	/*
+	 * Queue the waiting jobs that may go. Returns 0, or an error with the
+	 * frame that failed in @failed (call again for the others).
+	 */
+	int runIspJobs(MtkIsp50IspQueue &queue, Info **failed);
+	/* True if the buffers of the job of @info are all back just now */
+	bool ispJobBack(Info *info);
+	/* No jobs go while held (stop and restart of the ISP) */
+	void holdIsp(bool held) { ispHeld_ = held; }
+	/*
+	 * The ISP runs again with these outputs streaming, after other jobs
+	 * (the waiting jobs stay)
+	 */
+	void resumeIsp(unsigned int outputs)
+	{
+		ispOutputs_ = outputs;
+		ispBusy_ = 0;
+		ispHeld_ = false;
+	}
+
+	size_t ispBusy() const { return ispBusy_; }
+	size_t ispWaiting() const { return ispWaiting_.size(); }
+	unsigned int ispOutputs() const { return ispOutputs_; }
+
+	/* True if everything of the frame is done; the frame is then removed */
+	bool tryComplete(Info *info);
+
+	/* Oldest frame, nullptr if none */
+	Info *first();
+	Info *find(unsigned int id);
+	/* Frame waiting for its raw buffer from the capture device */
+	Info *findCapture(const FrameBuffer *buffer);
+	/* Frame whose raw buffer is queued to the ISP */
+	Info *findIspRaw(const FrameBuffer *buffer);
+	Info *findOutput(const FrameBuffer *buffer);
+	Info *findScaled(const FrameBuffer *buffer);
+	Info *findParams(const FrameBuffer *buffer);
+
+	size_t size() const { return frameInfo_.size(); }
+	size_t freeParams() const { return availableParamsBuffers_.size(); }
+	size_t freeStats() const { return availableStatsBuffers_.size(); }
+
+private:
+	std::queue<FrameBuffer *> availableParamsBuffers_;
+	std::queue<FrameBuffer *> availableStatsBuffers_;
+
+	std::map<unsigned int, std::unique_ptr<Info>> frameInfo_;
+
+	/* Outputs that stream, all bits set if unknown */
+	unsigned int ispOutputs_ = ~0u;
+	/* Jobs in the ISP, and those waiting for it */
+	unsigned int ispBusy_ = 0;
+	std::deque<Info *> ispWaiting_;
+	bool ispHeld_ = false;
+};
+
+} /* namespace libcamera */
