+};
+
+/* Lens shading gains on the corner grid (r, gr, gb, b) with a strength */
+class LensShadingCorrection : public Algorithm
+{
+public:
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+};
+
+/* Edge enhancement, noise reduction and demosaicing blocks per ISO */
+class NoiseReduction : public Algorithm
+{
+public:
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+};
+
+/*
+ * Multi-frame still images: frames per ISO, blend tuning, and the noise
+ * reduction mode of the requests (high quality: a series where the
+ * sensitivity calls for one, fast: single frames)
+ */
+class MultiFrame : public Algorithm
+{
+public:
+	int init(IPAContext &context, const ValueNode &tuningData) override;
