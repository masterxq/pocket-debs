+			     const Statistics *stats, double metered);
+	double highlightLevel(const IPAContext &context, const Statistics *stats) const;
+	static double interpolate(const std::vector<double> &x, const std::vector<double> &y, double v);
+	double stepFactor(double error) const;
+	double zoneMean(const IPAContext &context, const Statistics *stats) const;
+	RGB<double> shadingGain(const IPAContext &context, double x, double y) const;
+	void applyManual(IPAContext &context, IPAFrameContext &frameContext);
+	void updateFrameLimits(IPAContext &context) const;
+	int32_t exposureLimit(const IPAContext &context, int32_t exposure) const;
+	void fitExposure(const IPAContext &context, int32_t &exposure, double &again,
+			 int32_t limit) const;
+
+	/* Metering zones in each direction for zone metering */
+	static constexpr unsigned int kMeteringZones = 5;
+	double meteredMean(const Statistics::Histogram &histogram,
+			   unsigned int first) const;
+
+	float proportionalGain_;
+	float maxStep_;
+	std::optional<double> minGainStep_;
+	double maxExposureFactor_;
+	std::optional<double> extensionGain_;
+	std::optional<double> exposureTarget_;
+	double maxDigitalGain_;
+	bool afFrameRate_ = false;
+	std::optional<double> exposureSpeed_;
+	double maxExposureStep_;
+	double meterLow_;
+	double meterHigh_;
+	double tolerance_;
+	bool zoneMetering_ = false;
+	bool useColourGains_ = true;
+	std::array<double, 3> channelWeights_ = { 77.0, 150.0, 29.0 };
+	std::array<double, kMeteringZones * kMeteringZones> zoneWeights_ = [] {
+		std::array<double, kMeteringZones * kMeteringZones> w;
+		w.fill(1.0);
+		return w;
+	}();
+	/* Weights of the metering modes: tuned centre weighted, spot, matrix */
+	std::array<double, kMeteringZones * kMeteringZones> tunedWeights_{};
+	/* Measure after the lens shading correction, and its scale */
+	bool meteringShading_ = false;
+	double meteringScale_ = 1.0;
+
+	/*
+	 * Exposure program per use (preview, video, still) and its state:
+	 * the regulated total exposure (us x total gain), the use of the
+	 * session
+	 */
+	std::array<std::optional<ExposureProgram>, 3> programs_;
+	double total_ = 0.0;
+	unsigned int useCase_ = 0;
+	double fNumber_ = 2.0;
+	/* Target over the brightness of the scene: offset in stops over BV */
