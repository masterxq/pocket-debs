+void flatten(const ValueNode &node, std::vector<int64_t> &out, bool &valid)
+{
+	if (node.isList()) {
+		for (const ValueNode &v : node.asList())
+			flatten(v, out, valid);
+		return;
+	}
+
+	std::optional<int32_t> v = node.get<int32_t>();
+	if (!v) {
+		valid = false;
+		return;
+	}
+	out.push_back(*v);
+}
+
+/*
+ * Fill a block from a dictionary with one entry per field (lists for arrays,
+ * nested lists for two-dimensional ones). Every field has to be given and
+ * fit its type; the ranges of the fields are checked by the driver.
+ */
+template<typename T, std::size_t N>
+std::optional<T> parseBlock(const ValueNode &node, uint16_t type, const QualityField (&fields)[N],
+			    const char *module)
+{
+	if (!node.isDictionary()) {
+		LOG(IPAMtkIsp50Dip, Error) << "mtk-dip quality: " << module << " is not a dictionary";
+		return std::nullopt;
+	}
+
+	T block = {};
+	block.header.type = type;
+	block.header.flags = MTK_DIP_PARAMS_BLOCK_FL_ENABLE;
+	block.header.size = sizeof(T);
+
+	uint8_t *base = reinterpret_cast<uint8_t *>(&block);
+	for (const QualityField &f : fields) {
+		std::vector<int64_t> values;
+		bool valid = node.contains(f.name);
+		if (valid)
+			flatten(node[f.name], values, valid);
+		if (!valid || values.size() != f.count) {
+			LOG(IPAMtkIsp50Dip, Error)
+				<< "mtk-dip quality: " << module << "." << f.name
+				<< " missing or not " << f.count << " integers";
+			return std::nullopt;
+		}
+
+		const int64_t min = f.isSigned ? -(int64_t(1) << (8 * f.elementSize - 1)) : 0;
+		const int64_t max = f.isSigned ? (int64_t(1) << (8 * f.elementSize - 1)) - 1
+					       : (int64_t(1) << (8 * f.elementSize)) - 1;
+		for (std::size_t i = 0; i < f.count; i++) {
+			if (values[i] < min || values[i] > max) {
+				LOG(IPAMtkIsp50Dip, Error)
+					<< "mtk-dip quality: " << module << "." << f.name
+					<< " value " << values[i] << " out of type range";
+				return std::nullopt;
+			}
+
+			uint8_t *dst = base + f.offset + i * f.elementSize;
+			if (f.elementSize == 1) {
+				const uint8_t v = static_cast<uint8_t>(values[i]);
+				memcpy(dst, &v, 1);
+			} else {
+				const uint16_t v = static_cast<uint16_t>(values[i]);
+				memcpy(dst, &v, 2);
+			}
+		}
+	}
+
+	return block;
+}
+
+std::vector<uint8_t> disabledBlock(uint16_t type)
+{
+	struct v4l2_isp_params_block_header off = {};
+	off.type = type;
+	off.flags = MTK_DIP_PARAMS_BLOCK_FL_DISABLE;
+	off.size = sizeof(off);
+	const uint8_t *p = reinterpret_cast<const uint8_t *>(&off);
+	return std::vector<uint8_t>(p, p + sizeof(off));
+}
+
+template<typename T>
+std::vector<uint8_t> qualityBytes(const std::optional<T> &block, uint16_t type)
+{
+	if (!block)
+		return disabledBlock(type);
+
+	const uint8_t *p = reinterpret_cast<const uint8_t *>(&*block);
+	return std::vector<uint8_t>(p, p + sizeof(T));
+}
+
+} /* namespace */
+
+/**
+ * \class QualityTable
+ * \brief Image quality blocks of the DIP per sensitivity, from the tuning file
+ *
+ * The section "quality" of "mtk-dip" holds "points", a list of sensitivities
+ * ("iso") with the blocks "ee", "ycnr", "demosaic" and "nbc2", each a
+ * dictionary with the fields of struct mtk_dip_params_ee, _ycnr, _demosaic and
+ * _nbc2 (names as in the UAPI header, arrays as lists). The sensitivity of a frame is "isoPerGain"
+ * (default 100) times its analogue and digital gain. The point nearest to it
+ * on a logarithmic scale is used; a new point is only taken when it is nearer
+ * by more than "hysteresis" stops (default 0.25), so that the blocks do not
+ * flip at the middle between two points. The blocks are not interpolated
+ * between points: they contain switches, selections and curve points with
+ * their slopes, for which a mean is no valid setting.
+ */
+
+/**
+ * \brief Read the quality table from the "quality" section
+ * \param[in] node The section
+ * \return The table, or std::nullopt if it is invalid
+ */
+std::optional<QualityTable> QualityTable::fromTuning(const ValueNode &node)
+{
+	QualityTable table;
+
+	table.isoPerGain_ = node["isoPerGain"].get<double>(100.0);
+	table.hysteresis_ = node["hysteresis"].get<double>(0.25);
+	if (!(table.isoPerGain_ > 0.0) || !(table.hysteresis_ >= 0.0 && table.hysteresis_ <= 2.0)) {
+		LOG(IPAMtkIsp50Dip, Error) << "mtk-dip quality: invalid isoPerGain or hysteresis";
+		return std::nullopt;
+	}
+
+	const ValueNode &points = node["points"];
+	if (!points.isList() || points.asList().begin() == points.asList().end()) {
+		LOG(IPAMtkIsp50Dip, Error) << "mtk-dip quality: no points";
+		return std::nullopt;
+	}
+
+	for (const ValueNode &p : points.asList()) {
+		QualityPoint point;
+		point.iso = p["iso"].get<double>(0.0);
+		if (!(point.iso > 0.0) ||
+		    (!table.points_.empty() && !(point.iso > table.points_.back().iso))) {
+			LOG(IPAMtkIsp50Dip, Error) << "mtk-dip quality: iso missing or not rising";
+			return std::nullopt;
+		}
+
+		if (p.contains("ee")) {
+			point.ee = parseBlock<struct mtk_dip_params_ee>(p["ee"], MTK_DIP_PARAMS_BLOCK_EE,
+									  kEeFields, "ee");
+			if (!point.ee)
+				return std::nullopt;
+			table.usesEe_ = true;
+		}
+		if (p.contains("ycnr")) {
+			point.ycnr = parseBlock<struct mtk_dip_params_ycnr>(p["ycnr"], MTK_DIP_PARAMS_BLOCK_YCNR,
+									      kYcnrFields, "ycnr");
+			if (!point.ycnr)
+				return std::nullopt;
+			table.usesYcnr_ = true;
+		}
+		if (p.contains("demosaic")) {
+			point.demosaic = parseBlock<struct mtk_dip_params_demosaic>(
+				p["demosaic"], MTK_DIP_PARAMS_BLOCK_DEMOSAIC, kDemosaicFields, "demosaic");
+			if (!point.demosaic)
+				return std::nullopt;
+			table.usesDemosaic_ = true;
+		}
+		if (p.contains("nbc2")) {
+			point.nbc2 = parseBlock<struct mtk_dip_params_nbc2>(p["nbc2"], MTK_DIP_PARAMS_BLOCK_NBC2,
+									      kNbc2Fields, "nbc2");
+			if (!point.nbc2)
+				return std::nullopt;
+			table.usesNbc2_ = true;
+		}
+
+		table.points_.push_back(std::move(point));
+	}
+
+	return table;
+}
+
+/**
+ * \brief Select the point for a frame
+ * \param[in] totalGain Analogue times digital gain of the frame
+ * \return The point to use
+ */
+const QualityPoint &QualityTable::select(float totalGain)
+{
+	const double iso = isoPerGain_ * std::max(totalGain, 1e-3f);
+	auto distance = [&](unsigned int i) {
+		return std::abs(std::log2(iso / points_[i].iso));
+	};
+
+	unsigned int best = 0;
+	for (unsigned int i = 1; i < points_.size(); i++) {
+		if (distance(i) < distance(best))
+			best = i;
+	}
+
+	if (!current_ || (best != *current_ && distance(*current_) - distance(best) > hysteresis_))
+		current_ = best;
+
+	return points_[*current_];
+}
+
+/**
+ * \brief Stop using the second noise reduction stage (a driver without it)
+ */
+void QualityTable::dropNbc2()
+{
+	for (QualityPoint &point : points_)
+		point.nbc2.reset();
+	usesNbc2_ = false;
+}
+
+/**
+ * \class ParamsEncoder
+ * \brief Serialise DipFrameParams into a DIP parameter buffer
+ *
+ * The DIP keeps the values of the previous job for every block a params
+ * buffer omits, and runs jobs without a params buffer with the previous
+ * values. The encoder therefore writes only the blocks that differ from what
+ * the DIP has received. encode() fills a buffer, commit() records that the
+ * buffer was queued.
+ */
+
+/**
+ * \brief Forget the blocks sent so far, the next buffer carries all blocks
+ *
+ * The DIP keeps the blocks of the last job across jobs and across
+ * VIDIOC_STREAMOFF, also from another process. The optional blocks (lens
+ * shading and the image quality blocks) that the tuning does not configure
+ * are therefore sent disabled once with the next buffer, so that a stream
+ * does not inherit them from a previous one.
+ */
+void ParamsEncoder::reset()
+{
+	for (auto &block : sent_)
+		block.clear();
+
+	unknown_.fill(false);
+	for (unsigned int type : { MTK_DIP_PARAMS_BLOCK_LSC, MTK_DIP_PARAMS_BLOCK_EE,
+				   MTK_DIP_PARAMS_BLOCK_YCNR, MTK_DIP_PARAMS_BLOCK_DEMOSAIC,
+				   MTK_DIP_PARAMS_BLOCK_NBC2 })
+		unknown_[type] = true;
+}
+
+/**
+ * \brief Stop sending the disabled blocks of reset()
+ * \param[in] minType Only for block types from this one on (the newer ones)
+ *
+ * For a driver that refuses the buffer because it does not know an optional
+ * block type: such a driver has no state of that block to reset.
+ *
+ * \return True if the pending buffer carried such blocks, false otherwise
+ */
+bool ParamsEncoder::dropStartDisables(unsigned int minType)
+{
+	bool dropped = false;
+
+	for (unsigned int type = minType; type < kBlockTypes; type++) {
+		if (unknown_[type] && sent_[type].empty() && included_[type] &&
+		    pending_[type] == disabledBlock(type))
+			dropped = true;
+		unknown_[type] = false;
+	}
+
+	return dropped;
+}
+
+namespace {
+
+template<typename T>
+std::vector<uint8_t> blockBytes(const T &block)
+{
+	const uint8_t *p = reinterpret_cast<const uint8_t *>(&block);
+	return std::vector<uint8_t>(p, p + sizeof(block));
+}
+
+} /* namespace */
+
+/**
+ * \brief Serialise the changed blocks into a buffer
+ * \param[in] params The parameters
+ * \param[in] order Bayer order of the raw format set on the DIP input
+ * \param[out] buffer The params buffer (mapped)
+ * \return The number of bytes used, or 0 if no block changed (nothing to
+ * queue) or none fits into the buffer
+ *
+ * Changed blocks that do not fit into the buffer are left for the next one;
+ * commit() records only the blocks the buffer carries.
+ */
+size_t ParamsEncoder::encode(const DipFrameParams &params, BayerFormat::Order order,
+			     Span<uint8_t> buffer)
+{
+	const auto channels = bayerChannels(order);
+
+	const float common = commonGain(params);
+
+	struct mtk_dip_params_blc blc = {};
+	fillHeader(&blc, MTK_DIP_PARAMS_BLOCK_BLC);
+	for (unsigned int i = 0; i < MTK_DIP_BAYER_CHANNELS; i++) {
+		const float level = std::clamp(params.blackLevel[channels[i]], 0.0f, 0.99f);
+		blc.level[i] = toBlackLevel(level);
+		/*
+		 * Stretch the range above the black level back to full scale,
+		 * with the part of the colour gains common to all channels
+		 */
+		blc.gain[i] = toUnsignedQ4_12(common / (1.0f - level));
+	}
+
+	struct mtk_dip_params_wb wb = {};
+	fillHeader(&wb, MTK_DIP_PARAMS_BLOCK_WB);
+	for (unsigned int i = 0; i < MTK_DIP_BAYER_CHANNELS; i++)
+		wb.gain[i] = toUnsignedQ4_12(params.gains[channels[i]] / common);
+
+	struct mtk_dip_params_ccm ccm = {};
+	fillHeader(&ccm, MTK_DIP_PARAMS_BLOCK_CCM);
+	for (unsigned int row = 0; row < 3; row++)
+		for (unsigned int col = 0; col < 3; col++)
+			ccm.coeff[row][col] = toSignedQ4_12(params.combinedMatrix[row][col]);
+
+	struct mtk_dip_params_gamma gamma = {};
+	fillHeader(&gamma, MTK_DIP_PARAMS_BLOCK_GAMMA);
+	static_assert(kGammaPoints == MTK_DIP_GAMMA_POINTS);
+	for (unsigned int i = 0; i < kGammaPoints; i++) {
+		const float x = static_cast<float>(gammaInputPosition(i)) / kGammaInputScale;
+		const float y = toneCurve(x, params.gamma, params.contrastExp,
+					  toneCurve_ ? &*toneCurve_ : nullptr, shadowLift_);
+		const uint16_t out = static_cast<uint16_t>(
+			std::clamp(std::lround(y * 1023.0f), 0L, 1023L));
+
+		for (unsigned int c = 0; c < 3; c++)
+			gamma.lut[c][i] = out;
+	}
+
+	/*
+	 * An optional block the tuning does not configure: disabled once if
+	 * it was sent before or its state in the DIP is unknown (reset()),
+	 * otherwise left out, as drivers without the block reject its type
+	 */
+	auto neutral = [this](unsigned int type) {
+		pending_[type] = sent_[type].empty() && !unknown_[type]
+					 ? std::vector<uint8_t>{}
+					 : disabledBlock(type);
+	};
+
+	pending_[MTK_DIP_PARAMS_BLOCK_BLC] = blockBytes(blc);
+	pending_[MTK_DIP_PARAMS_BLOCK_WB] = blockBytes(wb);
+	pending_[MTK_DIP_PARAMS_BLOCK_CCM] = blockBytes(ccm);
+	pending_[MTK_DIP_PARAMS_BLOCK_GAMMA] = blockBytes(gamma);
+
+	/*
+	 * The lens shading block is only sent when the tuning enables it:
+	 * drivers without support reject it. Disabling it again later, or
+	 * the first buffer after reset() without it, sends a disabling header.
+	 */
+	if (lensShading_) {
+		struct mtk_dip_params_lsc lsc = {};
+		fillHeader(&lsc, MTK_DIP_PARAMS_BLOCK_LSC);
+		const auto lscPos = lscChannels(order);
+		for (unsigned int i = 0; i < MTK_DIP_BAYER_CHANNELS; i++)
+			for (unsigned int y = 0; y < LensShading::kGridPoints; y++)
+				for (unsigned int x = 0; x < LensShading::kGridPoints; x++)
+					lsc.gain[i][y][x] = toUnsignedQ4_12(
+						lensShading_->gain[lscPos[i]][y * LensShading::kGridPoints + x]);
+		pending_[MTK_DIP_PARAMS_BLOCK_LSC] = blockBytes(lsc);
+	} else {
+		neutral(MTK_DIP_PARAMS_BLOCK_LSC);
+	}
+
+	/*
+	 * Image quality blocks of the point selected for the gain of the frame.
+	 * Like all blocks they are only sent when they differ from what the DIP
+	 * has, i.e. when the point changes and after reset().
+	 */
+	if (quality_) {
+		const QualityPoint &point = quality_->select(params.totalGain);
+
+		if (quality_->usesEe())
+			pending_[MTK_DIP_PARAMS_BLOCK_EE] = qualityBytes(point.ee, MTK_DIP_PARAMS_BLOCK_EE);
+		else
+			neutral(MTK_DIP_PARAMS_BLOCK_EE);
+		if (quality_->usesYcnr())
+			pending_[MTK_DIP_PARAMS_BLOCK_YCNR] =
+				qualityBytes(point.ycnr, MTK_DIP_PARAMS_BLOCK_YCNR);
+		else
+			neutral(MTK_DIP_PARAMS_BLOCK_YCNR);
+		if (quality_->usesDemosaic())
+			pending_[MTK_DIP_PARAMS_BLOCK_DEMOSAIC] =
+				qualityBytes(point.demosaic, MTK_DIP_PARAMS_BLOCK_DEMOSAIC);
+		else
+			neutral(MTK_DIP_PARAMS_BLOCK_DEMOSAIC);
+		if (quality_->usesNbc2())
+			pending_[MTK_DIP_PARAMS_BLOCK_NBC2] =
+				qualityBytes(point.nbc2, MTK_DIP_PARAMS_BLOCK_NBC2);
+		else
+			neutral(MTK_DIP_PARAMS_BLOCK_NBC2);
+	} else {
+		/* Quality switched off: back to the driver defaults once */
+		for (unsigned int type : { MTK_DIP_PARAMS_BLOCK_EE, MTK_DIP_PARAMS_BLOCK_YCNR,
+					   MTK_DIP_PARAMS_BLOCK_DEMOSAIC, MTK_DIP_PARAMS_BLOCK_NBC2 })
+			neutral(type);
+	}
+
+	/*
+	 * The changed blocks in type order, as far as they fit into the
+	 * buffer (its size comes from the driver); the others follow with
+	 * the next buffer
+	 */
+	size_t size = sizeof(struct v4l2_isp_params_buffer);
+	included_.fill(false);
+	for (unsigned int type = 0; type < kBlockTypes; type++) {
+		if (pending_[type] == sent_[type] || size + pending_[type].size() > buffer.size())
+			continue;
+
+		included_[type] = true;
+		size += pending_[type].size();
+	}
+
+	if (size == sizeof(struct v4l2_isp_params_buffer))
+		return 0;
+
+	auto *head = reinterpret_cast<struct v4l2_isp_params_buffer *>(buffer.data());
+	head->version = MTK_DIP_PARAMS_VERSION_V1;
+	head->data_size = size - sizeof(*head);
+
+	uint8_t *data = buffer.data() + sizeof(*head);
+	for (unsigned int type = 0; type < kBlockTypes; type++) {
+		if (!included_[type])
+			continue;
+
+		memcpy(data, pending_[type].data(), pending_[type].size());
+		data += pending_[type].size();
+	}
+
+	return size;
+}
+
+/**
+ * \brief Record that the buffer of the last encode() was queued to the DIP
+ */
+void ParamsEncoder::commit()
+{
+	for (unsigned int type = 0; type < kBlockTypes; type++) {
+		if (!included_[type])
+			continue;
+
+		sent_[type] = pending_[type];
+		unknown_[type] = false;
+	}
+	included_.fill(false);
+}
+
+/**
+ * \brief Set the tuned tone curve
+ * \param[in] curve The curve, or std::nullopt for the power law of gamma
+ *
+ * The curve stays in effect across reset(). The next encode() sends the tone
+ * curve block if the result differs from what the DIP has.
+ */
+void ParamsEncoder::setToneCurve(std::optional<ToneCurve> curve)
+{
+	toneCurve_ = std::move(curve);
+}
+
+/**
+ * \brief Set the shadow lift of the tone curve
+ * \param[in] lift The lift (see shadowLift()), 0.0 for none
+ */
+void ParamsEncoder::setShadowLift(float lift)
+{
+	shadowLift_ = std::max(lift, 0.0f);
+}
+
+/**
+ * \brief Enable or disable the lens shading block
+ * \param[in] lsc The gains, or std::nullopt for no lens shading (disabled
+ * once after reset(), otherwise no block)
+ *
+ * Like the tone curve the setting stays in effect across reset().
+ */
+void ParamsEncoder::setLensShading(std::optional<LensShading> lsc)
+{
+	lensShading_ = std::move(lsc);
+}
+
+/**
+ * \brief Set the image quality blocks per sensitivity
+ * \param[in] quality The table, or std::nullopt to leave the modules to the
+ * driver defaults
+ */
+void ParamsEncoder::setQuality(std::optional<QualityTable> quality)
+{
+	quality_ = std::move(quality);
+}
+
+/**
+ * \brief Stop sending the second noise reduction stage
+ *
+ * For a driver without the block: the other quality blocks stay.
+ */
+void ParamsEncoder::dropNbc2()
+{
+	if (quality_)
+		quality_->dropNbc2();
+	unknown_[MTK_DIP_PARAMS_BLOCK_NBC2] = false;
+}
