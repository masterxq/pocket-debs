diff --git a/src/ipa/mtkisp50/dip_params.cpp b/src/ipa/mtkisp50/dip_params.cpp
new file mode 100644
index 0000000..f36ae24
--- /dev/null
+++ b/src/ipa/mtkisp50/dip_params.cpp
@@ -0,0 +1,1101 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Translation of the frame parameters of the mtkisp50 IPA into MT6785 DIP
+ * parameter blocks (taken over from the DIP backend of the software ISP)
+ */
+
+#include "dip_params.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <iterator>
+#include <stddef.h>
+#include <string.h>
+#include <type_traits>
+
+#include <linux/media/mediatek/mtk-dip-mt6785.h>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/value_node.h"
+
+/**
+ * \file mtk_dip_params.h
+ * \brief Translation of DipFrameParams into the parameter buffer of the
+ * MediaTek MT6785 DIP
+ *
+ * The DIP processes a raw frame in this order: black level and first digital
+ * gain (BLC block), white balance gains (WB), demosaicing, colour matrix
+ * (CCM), tone curve (GAMMA), conversion to YUV. The software ISP parameters
+ * describe the same chain in normalised units (see the GPU debayer shader):
+ *
+ *   rgb = (rgb - blackLevel) / (1 - blackLevel)
+ *   rgb = clamp(rgb * gains, 0, 1)
+ *   rgb = combinedMatrix * rgb
+ *   rgb = pow(contrast(clamp(rgb, 0, 1)), gamma)
+ *
+ * Each factor goes into exactly one block: the black level and the
+ * normalisation 1 / (1 - blackLevel) into BLC, the colour gains into WB
+ * (their common part above 1.0 into BLC, see commonGain()), the
+ * combined matrix (colour correction and saturation, identity without a CCM)
+ * into CCM, contrast and gamma into the tone curve.
+ *
+ * A tuning file can replace the power law of the tone curve by a sampled curve
+ * (ToneCurve, set with ParamsEncoder::setToneCurve()). The contrast S-curve is
+ * applied before it, and DipFrameParams::gamma then acts relative to the soft
+ * IPA default kReferenceGamma, so the default gamma leaves the tuned curve
+ * unchanged.
+ *
+ * The tuning can further raise the shadows with a gain that falls off towards
+ * the highlights (shadowLift(), ParamsEncoder::setShadowLift()), applied to the
+ * linear values in front of the tone curve, and enable a lens shading gain
+ * grid (LensShading, ParamsEncoder::setLensShading()). Neither has a
+ * counterpart in DipFrameParams.
+ */
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPAMtkIsp50Dip)
+
+namespace ipa::mtkisp50 {
+
+namespace {
+
+enum Channel {
+	Red = 0,
+	Green = 1,
+	Blue = 2,
+};
+
+/* Colour of the four Bayer positions in raster order (TL, TR, BL, BR) */
+std::array<Channel, MTK_DIP_BAYER_CHANNELS> bayerChannels(BayerFormat::Order order)
+{
+	switch (order) {
+	case BayerFormat::BGGR:
+		return { Blue, Green, Green, Red };
+	case BayerFormat::GBRG:
+		return { Green, Blue, Red, Green };
+	case BayerFormat::GRBG:
+		return { Green, Red, Blue, Green };
+	case BayerFormat::RGGB:
+	default:
+		return { Red, Green, Green, Blue };
+	}
+}
+
+template<typename T>
+void fillHeader(T *block, uint16_t type)
+{
+	block->header.type = type;
+	block->header.flags = MTK_DIP_PARAMS_BLOCK_FL_ENABLE;
+	block->header.size = sizeof(T);
+}
+
+} /* namespace */
+
+/**
+ * \brief Input position of a gamma curve point
+ * \param[in] index The point index, 0 to kGammaPoints - 1
+ * \return The input value of the point in units of 1/kGammaInputScale of full
+ * scale
+ */
+unsigned int gammaInputPosition(unsigned int index)
+{
+	unsigned int position = 0;
+
+	for (const GammaSegment &segment : kGammaSegments) {
+		if (index < segment.points)
+			return position + segment.step * index;
+
+		position += segment.step * segment.points;
+		index -= segment.points;
+	}
+
+	return position;
+}
+
+/**
+ * \brief Convert a non-negative factor to unsigned Q4.12, saturating
+ */
+uint16_t toUnsignedQ4_12(float value)
+{
+	if (!(value > 0.0f))
+		return 0;
+
+	return static_cast<uint16_t>(std::min(std::lround(value * 4096.0f), 0xffffL));
+}
+
+/**
+ * \brief Convert a factor to signed Q4.12 (-8.0 to just below 8.0), saturating
+ */
+int16_t toSignedQ4_12(float value)
+{
+	if (std::isnan(value))
+		return 0;
+
+	long v = std::lround(value * 4096.0f);
+	return static_cast<int16_t>(std::clamp(v, -32768L, 32767L));
+}
+
+/**
+ * \brief Convert a software ISP black level to Q0.16 of full scale
+ *
+ * The software ISP expresses the black level as an 8-bit pixel value divided
+ * by 255 (see the simple IPA), independent of the sensor bit depth. The DIP
+ * expects a fraction of full scale in 16 bits, so 16 / 255 (64 at 10 bits)
+ * becomes 16 << 8.
+ */
+uint16_t toBlackLevel(float level)
+{
+	if (!(level > 0.0f))
+		return 0;
+
+	return static_cast<uint16_t>(std::min(std::lround(level * 255.0f * 256.0f), 0xffffL));
+}
+
+/**
+ * \class ToneCurve
+ * \brief A tone curve given by points, linear between them
+ *
+ * The curve maps linear values (0.0 to 1.0, after the colour matrix) to
+ * output values (0.0 to 1.0, before the conversion to YUV). Below the first
+ * point and above the last one it holds the value of that point.
+ */
+
+/**
+ * \brief Create a tone curve from a list of points
+ * \param[in] xy The points as x0, y0, x1, y1, ...
+ *
+ * The list needs at least two points; x has to rise strictly, x and y have to
+ * be within 0.0 to 1.0.
+ *
+ * \return The curve, or std::nullopt if the points are invalid
+ */
+std::optional<ToneCurve> ToneCurve::fromPoints(Span<const float> xy)
+{
+	if (xy.size() < 4 || xy.size() % 2)
+		return std::nullopt;
+
+	ToneCurve curve;
+	for (std::size_t i = 0; i < xy.size(); i += 2) {
+		const float x = xy[i];
+		const float y = xy[i + 1];
+
+		if (!(x >= 0.0f && x <= 1.0f && y >= 0.0f && y <= 1.0f))
+			return std::nullopt;
+		if (!curve.points_.empty() && !(x > curve.points_.back().first))
+			return std::nullopt;
+
+		curve.points_.emplace_back(x, y);
+	}
+
+	return curve;
+}
+
+/**
+ * \fn ToneCurve::size()
+ * \brief Retrieve the number of points
+ */
+
+/**
+ * \brief Evaluate the curve
+ * \param[in] x The input value
+ * \return The output value, linearly interpolated between the points
+ */
+float ToneCurve::operator()(float x) const
+{
+	if (x <= points_.front().first)
+		return points_.front().second;
+	if (x >= points_.back().first)
+		return points_.back().second;
+
+	auto it = std::upper_bound(points_.begin(), points_.end(), x,
+				   [](float v, const std::pair<float, float> &p) {
+					   return v < p.first;
+				   });
+	const auto &[x1, y1] = *it;
+	const auto &[x0, y0] = *std::prev(it);
+
+	return y0 + (y1 - y0) * (x - x0) / (x1 - x0);
+}
+
+/**
+ * \brief Raise the shadows, keep black and white
+ * \param[in] value Linear input, 0.0 to 1.0
+ * \param[in] lift Shadow lift, 0.0 for none
+ *
+ * value * (1 + lift) / (1 + lift * value): a gain of 1 + lift at black that
+ * falls off to 1 / (1 + lift) at white, so highlights are compressed instead
+ * of clipped, like a digital gain with a soft shoulder.
+ *
+ * \return The lifted value
+ */
+float shadowLift(float value, float lift)
+{
+	if (!(lift > 0.0f))
+		return value;
+
+	return value * (1.0f + lift) / (1.0f + lift * value);
+}
+
+/**
+ * \brief Tone curve of the software ISP: contrast S-curve, then gamma
+ * \param[in] value Linear input, 0.0 to 1.0
+ * \param[in] gamma Exponent (DipFrameParams::gamma, e.g. 1 / 2.2)
+ * \param[in] contrastExp Contrast exponent (DipFrameParams::contrastExp)
+ * \param[in] curve Tuned tone curve, or nullptr for the power law
+ * \param[in] lift Shadow lift (see shadowLift()) applied first
+ *
+ * With a tuned curve the output is curve(contrast(value)) raised to
+ * gamma * kReferenceGamma, which is 1.0 at the default gamma.
+ */
+float toneCurve(float value, float gamma, float contrastExp, const ToneCurve *curve,
+		float lift)
+{
+	value = shadowLift(std::clamp(value, 0.0f, 1.0f), lift);
+
+	if (value < 0.5f)
+		value = 0.5f * std::pow(value / 0.5f, contrastExp);
+	else
+		value = 1.0f - 0.5f * std::pow((1.0f - value) / 0.5f, contrastExp);
+
+	if (!curve)
+		return std::pow(value, gamma);
+
+	const float exponent = gamma * kReferenceGamma;
+	value = (*curve)(value);
+	if (std::abs(exponent - 1.0f) < 1e-4f)
+		return value;
+
+	return std::pow(value, exponent);
+}
+
+/**
+ * \brief Part of the colour gains that goes into the BLC block
+ * \param[in] params The parameters
+ *
+ * The colour gains (white balance, and a digital gain of the IPA multiplied
+ * into them) can exceed the range of the WB block (below 16). The smallest
+ * of the three gains, if above 1.0, is common to all channels and goes into
+ * the gain of the BLC block, which comes right before WB, the rest stays in
+ * WB. The remaining WB gains are then 1.0 or more, so a pixel clipped in BLC
+ * stays clipped and highlights keep their colour. The BLC gain also carries
+ * the stretch 1 / (1 - blackLevel) and is limited to below 16.
+ *
+ * \return The common gain, 1.0 or more
+ */
+float commonGain(const DipFrameParams &params)
+{
+	float common = std::min({ params.gains[0], params.gains[1], params.gains[2] });
+	if (!(common > 1.0f))
+		return 1.0f;
+
+	const float level = std::clamp(std::max({ params.blackLevel[0], params.blackLevel[1],
+						  params.blackLevel[2] }),
+				       0.0f, 0.99f);
+	const float maxCommon = kMaxBlcGain * (1.0f - level);
+
+	return std::min(common, maxCommon);
+}
+
+/**
+ * \struct LensShading
+ * \brief Lens shading gains at the corners of the 16x16 block grid of the DIP
+ */
+
+/**
+ * \brief Build the gains from tuned grids
+ * \param[in] grids Per colour channel (LensShading::Channel order) the gains
+ * of kGridPoints x kGridPoints points, row by row from the top left
+ * \param[in] strength Share of the correction applied, 1 + strength * (g - 1)
+ *
+ * Gains have to be positive. With the strength applied they are limited to
+ * the range of the block (below 16).
+ *
+ * \return The gains, or std::nullopt if a grid has the wrong size or a gain
+ * is out of range
+ */
+std::optional<LensShading> LensShading::fromGrids(const std::array<std::vector<float>, 4> &grids,
+						  float strength)
+{
+	if (!(strength >= 0.0f && strength <= 2.0f))
+		return std::nullopt;
+
+	LensShading lsc;
+	for (unsigned int c = 0; c < 4; c++) {
+		if (grids[c].size() != kPoints)
+			return std::nullopt;
+
+		for (unsigned int i = 0; i < kPoints; i++) {
+			const float g = grids[c][i];
+			if (!(g > 0.0f && g < 16.0f))
+				return std::nullopt;
+
+			lsc.gain[c][i] = std::clamp(1.0f + strength * (g - 1.0f), 0.0f, kMaxBlcGain);
+		}
+	}
+
+	return lsc;
+}
+
+namespace {
+
+/* Colour channel of the lens shading grid at the four Bayer positions */
+std::array<LensShading::Channel, MTK_DIP_BAYER_CHANNELS> lscChannels(BayerFormat::Order order)
+{
+	switch (order) {
+	case BayerFormat::BGGR:
+		return { LensShading::B, LensShading::Gb, LensShading::Gr, LensShading::R };
+	case BayerFormat::GBRG:
+		return { LensShading::Gb, LensShading::B, LensShading::R, LensShading::Gr };
+	case BayerFormat::GRBG:
+		return { LensShading::Gr, LensShading::R, LensShading::B, LensShading::Gb };
+	case BayerFormat::RGGB:
+	default:
+		return { LensShading::R, LensShading::Gr, LensShading::Gb, LensShading::B };
+	}
+}
