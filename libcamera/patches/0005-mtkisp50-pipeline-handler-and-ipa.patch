diff --git a/src/ipa/mtkisp50/algorithms/temporal_denoise.cpp b/src/ipa/mtkisp50/algorithms/temporal_denoise.cpp
new file mode 100644
index 0000000..b7d239e
--- /dev/null
+++ b/src/ipa/mtkisp50/algorithms/temporal_denoise.cpp
@@ -0,0 +1,172 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Temporal noise reduction of the preview and video jobs
+ *
+ * The DIP blends each job with the output of the job before. The tuning gives
+ * the settings per sensitivity for the jobs of a preview and of a video; the
+ * jobs of still images run without the module. Jumps of exposure, white
+ * balance and scene brightness and a moving lens start a new reference, so
+ * that the old image does not linger.
+ */
+
+#include "temporal_denoise.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/value_node.h"
+
+namespace libcamera {
+
+namespace ipa::mtkisp50::algorithms {
+
+LOG_DEFINE_CATEGORY(IPAMtkIsp50TemporalNr)
+
+/*
+ * TemporalNoiseReduction: "preview" and optionally "video", each with
+ * "points" (see TemporalNrTable; video jobs use the preview points without a
+ * video set), "isoPerGain" (default 100), "sceneStops" (default 1.0, a change
+ * of the scene brightness between two statistics that starts a new
+ * reference), and "restart" with the limits of TemporalNrRestart:
+ * "exposureStops", "colourGain", "lensSteps" and "frames".
+ */
+int TemporalNoiseReduction::init([[maybe_unused]] IPAContext &context,
+				 const ValueNode &tuningData)
+{
+	static constexpr const char *sets[] = { "preview", "video" };
+
+	for (unsigned int i = 0; i < tables_.size(); i++) {
+		if (!tuningData.contains(sets[i]))
+			continue;
+		tables_[i] = TemporalNrTable::fromTuning(tuningData[sets[i]]["points"]);
+		if (!tables_[i]) {
+			LOG(IPAMtkIsp50TemporalNr, Error)
+				<< "Invalid " << sets[i] << " set, no temporal noise reduction";
+			tables_ = {};
+			return 0;
+		}
+	}
+	if (!tables_[0]) {
+		LOG(IPAMtkIsp50TemporalNr, Error) << "No preview set, no temporal noise reduction";
+		tables_ = {};
+		return 0;
+	}
+
+	isoPerGain_ = tuningData["isoPerGain"].get<double>(100.0);
+	sceneStops_ = tuningData["sceneStops"].get<double>(1.0);
+
+	TemporalNrRestart::Limits limits;
+	const ValueNode &restart = tuningData["restart"];
+	limits.exposureStops = restart["exposureStops"].get<double>(limits.exposureStops);
+	limits.colourGain = restart["colourGain"].get<double>(limits.colourGain);
+	limits.lensSteps = restart["lensSteps"].get<int32_t>(limits.lensSteps);
+	limits.frames = std::min(restart["frames"].get<unsigned int>(limits.frames), 30u);
+	if (!(isoPerGain_ > 0.0) || !(sceneStops_ > 0.0) || !(limits.exposureStops > 0.0) ||
+	    !(limits.colourGain > 0.0) || limits.lensSteps < 1) {
+		LOG(IPAMtkIsp50TemporalNr, Error) << "Invalid limits, no temporal noise reduction";
+		tables_ = {};
+		return 0;
+	}
+	restart_.setLimits(limits);
+
+	LOG(IPAMtkIsp50TemporalNr, Info)
+		<< "Temporal noise reduction: " << tables_[0]->size() << " preview points"
+		<< (tables_[1] ? ", video set" : "") << ", restart after "
+		<< limits.exposureStops << " stops, " << limits.colourGain
+		<< " colour gain, " << limits.lensSteps << " lens steps for "
+		<< limits.frames << " frames";
+
+	return 0;
+}
+
+int TemporalNoiseReduction::configure([[maybe_unused]] IPAContext &context,
+				      const IPAConfigInfo &configInfo)
+{
+	const bool driver = driverHasTemporalNr(configInfo.paramsBufferSize);
+	active_ = tables_[0] && driver && configInfo.temporalNr;
+
+	if (tables_[0] && !active_)
+		LOG(IPAMtkIsp50TemporalNr, Info)
+			<< "Temporal noise reduction off: "
+			<< (!driver ? "the driver does not have it"
+				    : "not in this session (still images, or too few main buffers)");
+
+	restart_.reset();
+	lastScene_ = 0.0;
+
+	return 0;
+}
+
+void TemporalNoiseReduction::prepare(IPAContext &context, const uint32_t frame,
+				     IPAFrameContext &frameContext, DipFrameParams *params)
+{
+	params->nr3d.reset();
+	if (!active_ || params->useCase == static_cast<uint8_t>(UseCase::Still))
+		return;
+
+	const IPAActiveState &state = context.activeState;
+	TemporalNrRestart::State now;
+	now.exposure = state.agc.exposure * state.agc.again * frameContext.digitalGain;
+	now.gains = { state.awb.gains.r(), state.awb.gains.g(), state.awb.gains.b() };
+	if (!context.lensControls.empty())
+		now.lensPosition = state.af.lensPosition;
+	const bool restart = restart_.update(now);
+
+	const unsigned int set = params->useCase == static_cast<uint8_t>(UseCase::Video) &&
+				 tables_[1] ? 1 : 0;
+	const double iso = isoPerGain_ * std::max(params->totalGain, 1e-3f);
+	struct mtk_dip_params_nr3d block = tables_[set]->at(iso);
+	block.flags = restart ? MTK_DIP_NR3D_FL_RESTART : 0;
+	block.motion_x = 0;
+	block.motion_y = 0;
+	params->nr3d = block;
+
+	if (restart)
+		LOG(IPAMtkIsp50TemporalNr, Debug) << "Frame " << frame << ": new reference";
+}
+
+/*
+ * A scene cut: the brightness of the scene (mean level per exposure) jumps
+ * between two statistics at the same or another exposure
+ */
+void TemporalNoiseReduction::process([[maybe_unused]] IPAContext &context,
+				     const uint32_t frame, IPAFrameContext &frameContext,
+				     const Statistics *stats,
+				     [[maybe_unused]] ControlList &metadata)
+{
+	if (!active_ || !stats || !stats->valid)
+		return;
+
+	uint64_t sum = 0;
+	uint64_t count = 0;
+	for (unsigned int i = 0; i < stats->zoneSum.size(); i++) {
+		sum += stats->zoneSum[i].g();
+		count += stats->zoneCount[i];
+	}
+	const double exposure = frameContext.sensor.exposure * frameContext.sensor.gain;
+	if (!count || !(exposure > 0.0))
+		return;
+
+	/* Clipped or black scenes say nothing about the brightness */
+	const double level = static_cast<double>(sum) / count;
+	if (level < 2.0 || level > 240.0) {
+		lastScene_ = 0.0;
+		return;
+	}
+
+	const double scene = level / exposure;
+	if (lastScene_ > 0.0 && std::abs(std::log2(scene / lastScene_)) > sceneStops_) {
+		restart_.trigger();
+		LOG(IPAMtkIsp50TemporalNr, Debug)
+			<< "Frame " << frame << ": scene cut, new reference";
+	}
+	lastScene_ = scene;
+}
+
+REGISTER_IPA_ALGORITHM(TemporalNoiseReduction, "TemporalNoiseReduction")
+
+} /* namespace ipa::mtkisp50::algorithms */
+
+} /* namespace libcamera */
