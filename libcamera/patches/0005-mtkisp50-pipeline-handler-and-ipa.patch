diff --git a/test/mtkisp50/af.cpp b/test/mtkisp50/af.cpp
new file mode 100644
index 0000000..5554fee
--- /dev/null
+++ b/test/mtkisp50/af.cpp
@@ -0,0 +1,249 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * mtkisp50 IPA: autofocus state over a new configuration of the camera
+ */
+
+#include <cmath>
+#include <cstring>
+#include <iostream>
+#include <map>
+#include <memory>
+#include <string>
+#include <unistd.h>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/file.h>
+#include <libcamera/base/memfd.h>
+
+#include <libcamera/control_ids.h>
+
+#include "libcamera/internal/yaml_parser.h"
+
+#include "mtkisp50/algorithms/af.h"
+#include "mtkisp50/ipa_context.h"
+
+#include "test.h"
+
+using namespace libcamera;
+using namespace libcamera::ipa::mtkisp50;
+
+namespace {
+
+/* Lens 468 at 0.1 dpt to 775 at 10 dpt; search over the whole range */
+const char *kTuning = R"(%YAML 1.1
+---
+Af:
+  map: [ 0.1, 468, 10.0, 775 ]
+  default: 0.4
+  range: [ -0.8, 10.5 ]
+  step: 1.25
+  mode: auto
+  settleFrames: 2
+)";
+
+/* The scene is sharpest at this lens position */
+constexpr int32_t kSharpAt = 620;
+
+/*
+ * The autofocus between a simulated sensor and lens: statistics every
+ * frame, a focus grid whose contrast peaks at kSharpAt, the lens taking a
+ * new position two frames after the command.
+ */
+class Sim
+{
+public:
+	Sim()
+		: ctx_(16)
+	{
+		ControlInfoMap::Map map;
+		map.emplace(&focusId_, ControlInfo(0, 1023, 0));
+		ctx_.lensControls = ControlInfoMap(std::move(map), idMap_);
+		ctx_.sensorInfo.outputSize = Size(2304, 1728);
+	}
+
+	int init()
+	{
+		UniqueFD fd = MemFd::create("mtkisp50-af-tuning", 0);
+		if (!fd.isValid() || write(fd.get(), kTuning, strlen(kTuning)) < 0)
+			return -EIO;
+
+		File file("/proc/self/fd/" + std::to_string(fd.get()));
+		if (!file.open(File::OpenModeFlag::ReadOnly))
+			return -EIO;
+
+		tuning_ = YamlParser::parse(file);
+		if (!tuning_)
+			return -EINVAL;
+
+		return af_.init(ctx_, (*tuning_)["Af"]);
+	}
+
+	/* A new configuration: the IPA starts with a new active state */
+	void configure()
+	{
+		ctx_.activeState = {};
+		ctx_.activeState.blc.level = 16;
+		IPAConfigInfo config{};
+		af_.configure(ctx_, config);
+		frame_ = 0;
+	}
+
+	ControlList frame(const ControlList *request = nullptr)
+	{
+		const uint32_t n = frame_++;
+		IPAFrameContext fc;
+		if (request)
+			af_.queueRequest(ctx_, n, fc, *request);
+
+		auto it = pending_.find(n);
+		if (it != pending_.end()) {
+			effective_ = it->second;
+			pending_.erase(it);
+		}
+
+		DipFrameParams params;
+		af_.prepare(ctx_, n, fc, &params);
+
+		stats_.valid = true;
+		stats_.afGridValid = true;
+		stats_.afGridWidth = 16;
+		stats_.afGridHeight = 12;
+		stats_.afCellSize = 16;
+		stats_.afCellSamples = 64;
+		const double d = (effective_ - kSharpAt) / 40.0;
+		const double amplitude = 20.0 + 1000.0 * std::exp(-d * d);
+		for (unsigned int y = 0; y < 12; y++)
+			for (unsigned int x = 0; x < 16; x++)
+				stats_.afGrid[y * 16 + x] =
+					static_cast<uint32_t>(64 * (2000 + ((x + y) & 1 ? amplitude : -amplitude)));
+
+		ControlList metadata(controls::controls);
+		ctx_.activeState.agc.converging = false;
+		af_.process(ctx_, n, fc, &stats_, metadata);
+
+		if (ctx_.activeState.af.update) {
+			lens = ctx_.activeState.af.lensPosition;
+			pending_[n + 2] = lens;
+			ctx_.activeState.af.update = false;
+			moves++;
+		}
+
+		return metadata;
+	}
+
+	/* Frames until the state is one of Focused or Failed, -1 if none */
+	int untilDone(unsigned int limit)
+	{
+		for (unsigned int i = 0; i < limit; i++) {
+			ControlList md = frame();
+			auto state = md.get(controls::AfState);
+			if (state && (*state == controls::AfStateFocused ||
+				      *state == controls::AfStateFailed))
+				return *state;
+		}
+		return -1;
+	}
+
+	IPAContext &ctx() { return ctx_; }
+
+	int32_t lens = 0;
+	unsigned int moves = 0;
+
+private:
+	ControlId focusId_{ V4L2_CID_FOCUS_ABSOLUTE, "Focus, Absolute", "v4l2",
+			    ControlTypeInteger32, ControlId::Direction::In };
+	ControlIdMap idMap_{ { V4L2_CID_FOCUS_ABSOLUTE, &focusId_ } };
+	IPAContext ctx_;
+	std::unique_ptr<ValueNode> tuning_;
+	algorithms::Af af_;
+	Statistics stats_{};
+	std::map<uint32_t, int32_t> pending_;
+	int32_t effective_ = 0;
+	uint32_t frame_ = 0;
+};
+
+ControlList trigger()
+{
+	ControlList c(controls::controls);
+	c.set(controls::AfMode, controls::AfModeAuto);
+	c.set(controls::AfTrigger, controls::AfTriggerStart);
+	return c;
+}
+
+} /* namespace */
+
+class MtkIsp50AfTest : public Test
+{
+protected:
+	int fail(const std::string &what)
+	{
+		std::cerr << what << std::endl;
+		return TestFail;
+	}
+
+	int run() override
+	{
+		/* Scan to the sharp position, then run on for many frames */
+		Sim sim;
+		if (sim.init())
+			return fail("init");
+
+		sim.configure();
+		sim.frame();
+		ControlList start = trigger();
+		sim.frame(&start);
+		if (sim.untilDone(200) != controls::AfStateFocused ||
+		    std::abs(sim.lens - kSharpAt) > 20)
+			return fail("first scan: lens " + std::to_string(sim.lens));
+
+		const int32_t focused = sim.lens;
+		for (unsigned int i = 0; i < 300; i++)
+			sim.frame();
+
+		/* New configuration (a mode change): lens and state stay */
+		sim.moves = 0;
+		sim.configure();
+		if (sim.ctx().activeState.af.lensPosition != focused ||
+		    !sim.ctx().activeState.af.update)
+			return fail("lens not kept over the configuration");
+
+		ControlList md = sim.frame();
+		if (md.get(controls::AfState) != controls::AfStateFocused)
+			return fail("state not kept over the configuration");
+
+		for (unsigned int i = 0; i < 30; i++)
+			sim.frame();
+		if (sim.lens != focused || sim.moves != 1)
+			return fail("lens moved after the configuration: " +
+				    std::to_string(sim.moves) + " moves");
+
+		/*
+		 * Frame numbers start again: a scan of the new session
+		 * measures (the frame counters of the old one would hold it).
+		 */
+		ControlList again = trigger();
+		sim.frame(&again);
+		const unsigned int before = sim.moves;
+		if (sim.untilDone(200) != controls::AfStateFocused || sim.moves == before ||
+		    std::abs(sim.lens - kSharpAt) > 20)
+			return fail("scan after the configuration");
+
+		/* Manual position over a configuration */
+		ControlList manual(controls::controls);
+		manual.set(controls::AfMode, controls::AfModeManual);
+		manual.set(controls::LensPosition, 5.0f);
+		sim.frame(&manual);
+		sim.frame();
+		const int32_t manualLens = sim.lens;
+		sim.configure();
+		md = sim.frame();
+		if (sim.ctx().activeState.af.lensPosition != manualLens ||
+		    md.get(controls::AfMode) != controls::AfModeManual)
+			return fail("manual position not kept");
+
+		return TestPass;
+	}
+};
+
+TEST_REGISTER(MtkIsp50AfTest)
diff --git a/test/mtkisp50/af_pd.cpp b/test/mtkisp50/af_pd.cpp
new file mode 100644
index 0000000..92d2b68
--- /dev/null
+++ b/test/mtkisp50/af_pd.cpp
@@ -0,0 +1,459 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * mtkisp50 IPA: autofocus with phase detection
+ *
+ * A simulated sensor and lens: a contrast curve that peaks at the sharp lens
+ * position, and PD statistics whose shift is proportional to the distance of
+ * the lens from it (with a slope other than the tuned one, noise and an
+ * optional offset between the PD zero and the contrast peak).
+ */
+
+#include <cmath>
+#include <cstring>
+#include <iostream>
+#include <map>
+#include <memory>
+#include <string>
+#include <unistd.h>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/file.h>
+#include <libcamera/base/memfd.h>
+
+#include <libcamera/control_ids.h>
+
+#include "libcamera/internal/yaml_parser.h"
+
+#include "mtkisp50/algorithms/af.h"
+#include "mtkisp50/ipa_context.h"
+
+#include "test.h"
+
+using namespace libcamera;
+using namespace libcamera::ipa::mtkisp50;
+
+namespace {
+
+const char *kTuning = R"(%YAML 1.1
+---
+Af:
+  map: [ 0.1, 468, 10.0, 775 ]
+  default: 0.4
+  range: [ -0.8, 10.5 ]
+  step: 1.25
+  mode: continuous
+  search: climb
+  climbStep: 1.6
+  region: 0.25
+  settleFrames: 2
+  sceneChangeFrames: 20
+  monitorInterval: 2
+  pd:
+    slope: 21.0
+    minConfidence: 50
+    grid: [ 3, 3 ]
+    deadband: 12
+    agreement: 16
+    confirmFrames: 3
+    startFrames: 2
+    waitFrames: 6
+    fineRange: 24
+    fineStep: 8
+)";
+
+/* Lens units per pixel of shift of the simulated module */
+constexpr double kTrueSlope = 25.0;
+
+class Sim
+{
+public:
+	Sim()
+		: ctx_(16)
+	{
+		ControlInfoMap::Map map;
+		map.emplace(&focusId_, ControlInfo(0, 1023, 0));
+		ctx_.lensControls = ControlInfoMap(std::move(map), idMap_);
+		ctx_.sensorInfo.outputSize = Size(4624, 3472);
+	}
+
+	int init()
+	{
+		UniqueFD fd = MemFd::create("mtkisp50-af-pd-tuning", 0);
+		if (!fd.isValid() || write(fd.get(), kTuning, strlen(kTuning)) < 0)
+			return -EIO;
+
+		File file("/proc/self/fd/" + std::to_string(fd.get()));
+		if (!file.open(File::OpenModeFlag::ReadOnly))
+			return -EIO;
+
+		tuning_ = YamlParser::parse(file);
+		if (!tuning_)
+			return -EINVAL;
+
+		return af_.init(ctx_, (*tuning_)["Af"]);
+	}
+
+	void configure(bool available = true)
+	{
+		ctx_.activeState = {};
+		ctx_.activeState.blc.level = 16;
+		IPAConfigInfo config{};
+		config.pdAvailable = available;
+		af_.configure(ctx_, config);
+		frame_ = 0;
+	}
+
+	/* Pseudo random noise in [-1, 1] */
+	double noise()
+	{
+		seed_ = seed_ * 1103515245u + 12345u;
+		return ((seed_ >> 8) & 0xffff) / 32767.5 - 1.0;
+	}
+
+	ControlList frame(const ControlList *request = nullptr)
+	{
+		const uint32_t n = frame_++;
+		IPAFrameContext fc;
+		if (request)
+			af_.queueRequest(ctx_, n, fc, *request);
+
+		auto it = pending_.find(n);
+		if (it != pending_.end()) {
+			effective_ = it->second;
+			pending_.erase(it);
+		}
+
+		DipFrameParams params;
+		af_.prepare(ctx_, n, fc, &params);
+		pdRequested = params.pd;
+
+		stats_.valid = true;
+		stats_.afGridValid = true;
+		stats_.afGridWidth = 16;
+		stats_.afGridHeight = 12;
+		stats_.afCellSize = 16;
+		stats_.afCellSamples = 64;
+		const double d = (effective_ - sharpAt) / 40.0;
+		const double amplitude = dark ? 0.0 : 20.0 + 1000.0 * std::exp(-d * d) *
+							  (1.0 + contrastNoise * noise());
+		const uint32_t base = dark ? 16 : 2000;
+		for (unsigned int y = 0; y < 12; y++)
+			for (unsigned int x = 0; x < 16; x++)
+				stats_.afGrid[y * 16 + x] =
+					static_cast<uint32_t>(64 * (base + ((x + y) & 1 ? amplitude : -amplitude)));
+
+		stats_.pdValid = pd && params.pd;
+		stats_.pdGridWidth = 3;
+		stats_.pdGridHeight = 3;
+		const double shift = (sharpAt + pdBias - effective_) / kTrueSlope + pdNoise * noise();
+		Statistics::PdWindow w{};
+		w.shift = shift;
+		w.confidence = textured && !dark ? 80.0 : 10.0;
+		w.level = dark ? 2.0 : 100.0;
+		for (unsigned int i = 0; i < 9; i++) {
+			stats_.pdWindows[i] = w;
+			if (mixed) {
+				/*
+				 * Two subjects: the far one left (3), a near
+				 * one right (5), each more reliable in turn,
+				 * nothing reliable elsewhere
+				 */
+				stats_.pdWindows[i].confidence = 10.0;
+				if (i == 3)
+					stats_.pdWindows[i].confidence = n % 2 ? 90.0 : 70.0;
+				if (i == 5) {
+					stats_.pdWindows[i].confidence = n % 2 ? 70.0 : 90.0;
+					stats_.pdWindows[i].shift += 150.0 / kTrueSlope;
+				}
+			}
+		}
+		stats_.pdRegion = w;
+		if (mixed)
+			stats_.pdRegion.confidence = 20.0;
+
+		ControlList metadata(controls::controls);
+		ctx_.activeState.agc.converging = false;
+		af_.process(ctx_, n, fc, &stats_, metadata);
+
+		if (ctx_.activeState.af.update) {
+			if (ctx_.activeState.af.lensPosition != lens)
+				path += std::abs(ctx_.activeState.af.lensPosition - lens);
+			lens = ctx_.activeState.af.lensPosition;
+			pending_[n + 2] = lens;
+			ctx_.activeState.af.update = false;
+			moves++;
+		}
+
+		const auto state = metadata.get(controls::AfState);
+		if (state && *state == controls::AfStateScanning && lastState != controls::AfStateScanning)
+			scans++;
+		lastState = state ? *state : -1;
+
+		return metadata;
+	}
+
+	/* Frames until Focused or Failed, -1 if none within the limit */
+	int untilDone(unsigned int limit, unsigned int *frames = nullptr)
+	{
+		for (unsigned int i = 0; i < limit; i++) {
+			ControlList md = frame();
+			auto state = md.get(controls::AfState);
+			if (state && (*state == controls::AfStateFocused ||
+				      *state == controls::AfStateFailed)) {
+				if (frames)
+					*frames = i + 1;
+				return *state;
+			}
+		}
+		return -1;
+	}
+
+	/* The scene and the PD */
+	int32_t sharpAt = 620;
+	double pdBias = 0.0;
+	double pdNoise = 0.05;
+	double contrastNoise = 0.0;
+	bool textured = true;
+	bool pd = true;
+	bool dark = false;
+	bool mixed = false;
+
+	int32_t lens = 0;
+	unsigned int moves = 0;
+	unsigned int scans = 0;
+	int path = 0;
+	int lastState = -1;
+	bool pdRequested = false;
+
+private:
+	ControlId focusId_{ V4L2_CID_FOCUS_ABSOLUTE, "Focus, Absolute", "v4l2",
+			    ControlTypeInteger32, ControlId::Direction::In };
+	ControlIdMap idMap_{ { V4L2_CID_FOCUS_ABSOLUTE, &focusId_ } };
+	IPAContext ctx_;
+	std::unique_ptr<ValueNode> tuning_;
+	algorithms::Af af_;
+	Statistics stats_{};
+	std::map<uint32_t, int32_t> pending_;
+	int32_t effective_ = 0;
+	uint32_t frame_ = 0;
+	uint32_t seed_ = 1;
+};
+
+ControlList window(int x, int y)
+{
+	ControlList c(controls::controls);
+	c.set(controls::AfMetering, controls::AfMeteringWindows);
+	c.set(controls::AfWindows, Span<const Rectangle, 1>({ Rectangle(x, y, 400, 300) }));
+	return c;
+}
+
+} /* namespace */
+
+class MtkIsp50AfPdTest : public Test
+{
+protected:
+	int fail(const std::string &what)
+	{
+		std::cerr << what << std::endl;
+		return TestFail;
+	}
+
+	int run() override
+	{
+		unsigned int frames;
+
+		/* Start: PD moves the lens close, a short fine search ends it */
+		{
+			Sim sim;
+			if (sim.init())
+				return fail("init");
+			sim.configure();
+			/* The path from the default position on */
+			sim.frame();
+			sim.path = 0;
+			if (sim.untilDone(60, &frames) != controls::AfStateFocused ||
+			    std::abs(sim.lens - sim.sharpAt) > 8)
+				return fail("start: lens " + std::to_string(sim.lens));
+			if (frames > 20 || sim.path > (sim.sharpAt - 477) + 100)
+				return fail("start: " + std::to_string(frames) + " frames, path " +
+					    std::to_string(sim.path));
+			if (!sim.pdRequested)
+				return fail("PD statistics not requested");
+
+			/* A quiet scene: no search, the lens stays */
+			const int32_t focused = sim.lens;
+			sim.scans = 0;
+			sim.moves = 0;
+			sim.pdNoise = 0.6;
+			sim.contrastNoise = 0.3;
+			for (unsigned int i = 0; i < 600; i++)
+				sim.frame();
+			if (sim.scans || sim.lens != focused)
+				return fail("quiet scene: " + std::to_string(sim.scans) + " searches, lens " +
+					    std::to_string(sim.lens));
+
+			/* The subject moves: PD refocuses without a full scan */
+			sim.pdNoise = 0.05;
+			sim.contrastNoise = 0.0;
+			sim.sharpAt = 500;
+			sim.path = 0;
+			bool ok = false;
+			for (unsigned int i = 0; i < 40 && !ok; i++) {
+				ControlList md = sim.frame();
+				ok = md.get(controls::AfState) == controls::AfStateFocused &&
+				     std::abs(sim.lens - sim.sharpAt) <= 8;
+			}
+			if (!ok || sim.path > 250)
+				return fail("refocus: lens " + std::to_string(sim.lens) + " path " +
+					    std::to_string(sim.path));
+
+			/* A tap: the PD of the new window decides */
+			sim.sharpAt = 700;
+			sim.path = 0;
+			ControlList tap = window(4000, 3000);
+			sim.frame(&tap);
+			if (sim.untilDone(40, &frames) != controls::AfStateFocused ||
+			    std::abs(sim.lens - sim.sharpAt) > 8 || sim.path > 400)
+				return fail("tap: lens " + std::to_string(sim.lens) + " path " +
+					    std::to_string(sim.path) + " frames " + std::to_string(frames));
+		}
+
+		/* PD zero off the contrast peak: no back and forth afterwards */
+		{
+			Sim sim;
+			if (sim.init())
+				return fail("init");
+			sim.pdBias = 20;
+			sim.configure();
+			if (sim.untilDone(60) != controls::AfStateFocused)
+				return fail("bias: not focused");
+			const int32_t focused = sim.lens;
+			sim.scans = 0;
+			for (unsigned int i = 0; i < 300; i++)
+				sim.frame();
+			if (sim.scans || sim.lens != focused)
+				return fail("bias: " + std::to_string(sim.scans) + " searches after focus");
+		}
+
+		/* PD zero far off the contrast peak: one move to PD, then calm */
+		{
+			Sim sim;
+			if (sim.init())
+				return fail("init");
+			sim.pdBias = 50;
+			sim.configure();
+			if (sim.untilDone(60) != controls::AfStateFocused)
+				return fail("large bias: not focused");
+			for (unsigned int i = 0; i < 60; i++)
+				sim.frame();
+			const int32_t settled = sim.lens;
+			sim.scans = 0;
+			for (unsigned int i = 0; i < 300; i++)
+				sim.frame();
+			if (sim.scans || sim.lens != settled)
+				return fail("large bias: " + std::to_string(sim.scans) + " searches, lens " +
+					    std::to_string(settled) + " -> " + std::to_string(sim.lens));
+		}
+
+		/* Windows at two distances, each more reliable in turn: no hopping */
+		{
+			Sim sim;
+			if (sim.init())
+				return fail("init");
+			sim.mixed = true;
+			sim.configure();
+			sim.frame();
+			sim.path = 0;
+			/* Either subject, but one move towards it */
+			if (sim.untilDone(60, &frames) != controls::AfStateFocused || frames > 25 ||
+			    sim.path > 380 ||
+			    (std::abs(sim.lens - 620) > 30 && std::abs(sim.lens - 770) > 30))
+				return fail("mixed: frames " + std::to_string(frames) + " path " +
+					    std::to_string(sim.path) + " lens " + std::to_string(sim.lens));
+			const int32_t focused = sim.lens;
+			sim.scans = 0;
+			for (unsigned int i = 0; i < 300; i++)
+				sim.frame();
+			if (sim.scans || sim.lens != focused)
+				return fail("mixed: " + std::to_string(sim.scans) + " searches after focus");
+		}
+
+		/* PD not reliable: the contrast search finds the peak */
+		{
+			Sim sim;
+			if (sim.init())
+				return fail("init");
+			sim.textured = false;
+			sim.configure();
+			if (sim.untilDone(200) != controls::AfStateFocused ||
+			    std::abs(sim.lens - sim.sharpAt) > 20)
+				return fail("contrast fallback: lens " + std::to_string(sim.lens));
+		}
+
+		/* PD expected but no PD statistics come */
+		{
+			Sim sim;
+			if (sim.init())
+				return fail("init");
+			sim.pd = false;
+			sim.configure(true);
+			if (sim.untilDone(200) != controls::AfStateFocused ||
+			    std::abs(sim.lens - sim.sharpAt) > 20)
+				return fail("no PD frames: lens " + std::to_string(sim.lens));
+		}
+
+		/* Too dark: waits without searching and without hanging busy */
+		{
+			Sim sim;
+			if (sim.init())
+				return fail("init");
+			sim.dark = true;
+			sim.configure();
+			for (unsigned int i = 0; i < 60; i++)
+				sim.frame();
+			if (sim.scans)
+				return fail("dark: searched");
+			sim.dark = false;
+			if (sim.untilDone(120) != controls::AfStateFocused ||
+			    std::abs(sim.lens - sim.sharpAt) > 20)
+				return fail("after dark: lens " + std::to_string(sim.lens));
+		}
+
+		/* Auto mode: a trigger waits for PD, then moves */
+		{
+			Sim sim;
+			if (sim.init())
+				return fail("init");
+			sim.configure();
+			ControlList c(controls::controls);
+			c.set(controls::AfMode, controls::AfModeAuto);
+			sim.frame(&c);
+			sim.path = 0;
+			c.set(controls::AfTrigger, controls::AfTriggerStart);
+			sim.frame(&c);
+			if (sim.untilDone(60, &frames) != controls::AfStateFocused ||
+			    std::abs(sim.lens - sim.sharpAt) > 8 || frames > 25)
+				return fail("auto trigger: lens " + std::to_string(sim.lens) + " frames " +
+					    std::to_string(frames));
+		}
+
+		/* Without PD in the sensor mode: contrast as before */
+		{
+			Sim sim;
+			if (sim.init())
+				return fail("init");
+			sim.configure(false);
+			sim.frame();
+			if (sim.pdRequested)
+				return fail("PD requested without PD in the mode");
+			if (sim.untilDone(200) != controls::AfStateFocused ||
+			    std::abs(sim.lens - sim.sharpAt) > 20)
+				return fail("no PD mode: lens " + std::to_string(sim.lens));
+		}
+
+		return TestPass;
+	}
+};
+
+TEST_REGISTER(MtkIsp50AfPdTest)
diff --git a/test/mtkisp50/agc.cpp b/test/mtkisp50/agc.cpp
new file mode 100644
index 0000000..b8eac90
--- /dev/null
+++ b/test/mtkisp50/agc.cpp
@@ -0,0 +1,390 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * mtkisp50 IPA: frame length of the exposure regulation
+ */
+
+#include <cmath>
+#include <cstring>
+#include <iostream>
+#include <memory>
+#include <string>
+#include <unistd.h>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/file.h>
+#include <libcamera/base/memfd.h>
+
+#include <libcamera/control_ids.h>
+
+#include "libcamera/internal/yaml_parser.h"
+
+#include "mtkisp50/algorithms/af.h"
+#include "mtkisp50/algorithms/agc.h"
+#include "mtkisp50/frame_length.h"
+#include "mtkisp50/ipa_context.h"
+
+#include "test.h"
+
+using namespace std::literals::chrono_literals;
+using namespace libcamera;
+using namespace libcamera::ipa::mtkisp50;
+
+namespace {
+
+/*
+ * Regulation as tuned for the main camera (zone metering, speed, frame length
+ * extension by a factor of two from a gain of 8, the frame rate kept while
+ * the autofocus searches); the autofocus continuous.
+ */
+const char *kTuning = R"(%YAML 1.1
+---
+Agc:
+  maxExposureFactor: 2.0
+  extensionGain: 8.0
+  exposureTarget: 0.18
+  exposureSpeed: 0.6
+  metering: zones
+  colourGains: false
+  afFrameRate: true
+Af:
+  map: [ 0.1, 468, 10.0, 775 ]
+  default: 0.4
+  range: [ -0.8, 10.5 ]
+  step: 1.25
+  settleFrames: 2
+)";
+
+/* A sensor mode: lines, line duration, VBLANK range (step 2) */
+struct Mode {
+	int32_t defaultLines;
+	int32_t exposureMax;
+	utils::Duration line;
+	int32_t vblankDefault;
+	int32_t vblankMax;
+};
+
+/* Full resolution mode: 4102 lines of 8.124 us, 33.3 ms */
+const Mode kFull = { 4102, 4070, 8124.0ns, 4102 - 3472, 0xffffe8 - 3472 };
+/* Binned mode: 6000 lines of 5.555 us, 33.3 ms */
+const Mode kBinned = { 6000, 5968, 5555.0ns, 6000 - 1728, 0xffffe8 - 1728 };
+
+constexpr int32_t kBlack = 16;
+
+/*
+ * Exposure regulation and autofocus between a simulated sensor without
+ * delays and a dark scene: the image level above the black level is
+ * brightness * exposure lines * analogue gain (8 bit scale), the focus grid
+ * has a small contrast at that level.
+ */
+class Sim
+{
+public:
+	Sim()
+		: ctx_(16), stats_(std::make_unique<Statistics>())
+	{
+	}
+
+	int init()
+	{
+		UniqueFD fd = MemFd::create("mtkisp50-agc-tuning", 0);
+		if (!fd.isValid() || write(fd.get(), kTuning, strlen(kTuning)) < 0)
+			return -EIO;
+
+		File file("/proc/self/fd/" + std::to_string(fd.get()));
+		if (!file.open(File::OpenModeFlag::ReadOnly))
+			return -EIO;
+
+		tuning_ = YamlParser::parse(file);
+		if (!tuning_)
+			return -EINVAL;
+
+		ControlInfoMap::Map map;
+		map.emplace(&focusId_, ControlInfo(0, 1023, 0));
+		ctx_.lensControls = ControlInfoMap(std::move(map), lensIdMap_);
+
+		int ret = agc_.init(ctx_, (*tuning_)["Agc"]);
+		if (ret)
+			return ret;
+		return af_.init(ctx_, (*tuning_)["Af"]);
+	}
+
+	/* A new configuration in a mode, as IPAMtkIsp50::configure() */
+	int configure(const Mode &mode)
+	{
+		mode_ = mode;
+		ctx_.configuration = {};
+		ctx_.activeState = {};
+		ctx_.activeState.blc.level = kBlack;
+		ctx_.activeState.agc.digitalGain = 1.0;
+		ctx_.activeState.awb.gains = RGB<float>({ 1.0f, 1.0f, 1.0f });
+		ctx_.sensorInfo.minFrameLength = mode.defaultLines;
+		ctx_.sensorInfo.outputSize = Size(2304, 1728);
+
+		auto &agc = ctx_.configuration.agc;
+		agc.lineDuration = mode.line;
+		agc.exposureMin = 16;
+		agc.exposureMax = mode.exposureMax;
+		agc.againMin = 1.0;
+		agc.againMax = 15.5;
+		agc.again10 = 1.0;
+		agc.againMinStep = 0.02;
+
+		ControlInfoMap::Map map;
+		map.emplace(&vblankId_, ControlInfo(mode.vblankDefault, mode.vblankMax, mode.vblankDefault));
+		IPAConfigInfo config{};
+		config.sensorControls = ControlInfoMap(std::move(map), sensorIdMap_);
+
+		int ret = agc_.configure(ctx_, config);
+		if (ret)
+			return ret;
+		ret = af_.configure(ctx_, config);
+		if (ret)
+			return ret;
+
+		exposure_ = mode.exposureMax / 2;
+		gain_ = 1.0;
+		frame_ = 0;
+		return 0;
+	}
+
+	ControlList frame(const ControlList *request = nullptr)
+	{
+		const uint32_t n = frame_++;
+		IPAFrameContext fc{};
+		if (request) {
+			agc_.queueRequest(ctx_, n, fc, *request);
+			af_.queueRequest(ctx_, n, fc, *request);
+		}
+
+		DipFrameParams params{};
+		agc_.prepare(ctx_, n, fc, &params);
+		af_.prepare(ctx_, n, fc, &params);
+
+		/* The sensor applies what it was given */
+		fc.sensor.exposure = exposure_;
+		fc.sensor.gain = gain_;
+		frameLines = ctx_.configuration.agc.vblankEnabled
+				     ? mode_.defaultLines + vblank_ - mode_.vblankDefault
+				     : mode_.defaultLines;
+
+		const double level = std::min(brightness * exposure_ * gain_, 255.0 - kBlack);
+		Statistics &s = *stats_;
+		s.valid = true;
+		for (unsigned int i = 0; i < Statistics::kZones * Statistics::kZones; i++) {
+			const uint64_t v = static_cast<uint64_t>((kBlack + level) * 100);
+			s.zoneSum[i] = RGB<uint64_t>({ v, v, v });
+			s.zoneCount[i] = 100;
+		}
+		s.afGridValid = true;
+		s.afGridWidth = 16;
+		s.afGridHeight = 12;
+		s.afCellSize = 16;
+		s.afCellSamples = 64;
+		for (unsigned int y = 0; y < 12; y++)
+			for (unsigned int x = 0; x < 16; x++)
+				s.afGrid[y * 16 + x] = static_cast<uint32_t>(
+					64 * (kBlack + level * ((x + y) & 1 ? 1.1 : 0.9)));
+
+		ControlList metadata(controls::controls);
+		agc_.process(ctx_, n, fc, stats_.get(), metadata);
+		af_.process(ctx_, n, fc, stats_.get(), metadata);
+		ctx_.activeState.af.update = false;
+
+		/* Controls for the next frame, as IPAMtkIsp50::processStats() */
+		exposure_ = fc.sensor.exposure;
+		gain_ = fc.sensor.gain;
+		const auto &agc = ctx_.configuration.agc;
+		if (agc.vblankEnabled) {
+			vblank_ = agc.frame.vblankFor(exposure_, ctx_.activeState.agc.minFrameLines);
+			/* The driver: steps of two lines from the default up */
+			vblank_ = mode_.vblankDefault +
+				  (vblank_ - mode_.vblankDefault + 1) / 2 * 2;
+		}
+
+		return metadata;
+	}
+
+	IPAContext &ctx() { return ctx_; }
+	int32_t exposure() const { return exposure_; }
+	double gain() const { return gain_; }
+
+	double brightness = 0.0;
+	/* Frame length of the last frame, in lines */
+	int32_t frameLines = 0;
+
+private:
+	ControlId vblankId_{ V4L2_CID_VBLANK, "Vertical Blanking", "v4l2",
+			     ControlTypeInteger32, ControlId::Direction::In };
+	ControlIdMap sensorIdMap_{ { V4L2_CID_VBLANK, &vblankId_ } };
+	ControlId focusId_{ V4L2_CID_FOCUS_ABSOLUTE, "Focus, Absolute", "v4l2",
+			    ControlTypeInteger32, ControlId::Direction::In };
+	ControlIdMap lensIdMap_{ { V4L2_CID_FOCUS_ABSOLUTE, &focusId_ } };
+	IPAContext ctx_;
+	std::unique_ptr<ValueNode> tuning_;
+	algorithms::Agc agc_;
+	algorithms::Af af_;
+	std::unique_ptr<Statistics> stats_;
+	Mode mode_{};
+	int32_t exposure_ = 0;
+	double gain_ = 1.0;
+	int32_t vblank_ = 0;
+	uint32_t frame_ = 0;
+};
+
+ControlList limits(int64_t minUs, int64_t maxUs)
+{
+	ControlList c(controls::controls);
+	c.set(controls::FrameDurationLimits, Span<const int64_t, 2>({ minUs, maxUs }));
+	return c;
+}
+
+int64_t micros(utils::Duration d)
+{
+	return static_cast<int64_t>(d.get<std::micro>());
+}
+
+} /* namespace */
+
+class MtkIsp50AgcTest : public Test
+{
+protected:
+	int fail(const std::string &what)
+	{
+		std::cerr << what << std::endl;
+		return TestFail;
+	}
+
+	/* Frame length arithmetic against the rounding of the driver */
+	int testFrameLength()
+	{
+		FrameLength f;
+		f.defaultLines = 4102;
+		f.exposureMax = 4070;
+		f.vblankDefault = 630;
+
+		for (int32_t e = 16; e <= 9000; e += 2) {
+			const int32_t lines = f.linesFor(e);
+			/* The sensor needs 31 lines beyond the exposure */
+			if (lines < std::max(e + 31, f.defaultLines) ||
+			    (lines - f.defaultLines) % FrameLength::kVblankStep ||
+			    f.vblankFor(e) - f.vblankDefault != lines - f.defaultLines)
+				return fail("frame length for exposure " + std::to_string(e));
+		}
+
+		for (int32_t lines = f.defaultLines - 10; lines <= 9000; lines++) {
+			const int32_t e = f.exposureWithin(lines);
+			if (f.linesFor(e) > std::max(lines, f.defaultLines) || e % 2)
+				return fail("exposure within " + std::to_string(lines) + " lines");
+			/* The longest one: two lines more need a longer frame */
+			if (lines >= f.defaultLines && f.linesFor(e + 2) <= lines)
+				return fail("exposure within " + std::to_string(lines) +
+					    " lines not the longest");
+		}
+
+		if (f.linesFor(100, 5000) != 5000 || f.linesFor(6000, 5000) != f.linesFor(6000))
+			return fail("shortest frame length");
+
+		return TestPass;
+	}
+
+	/*
+	 * Dark scene: the image at the longest exposure of the default frame
+	 * length and the highest gain is too dark for the focus measure.
+	 */
+	int testDark(const Mode &mode, const char *name)
+	{
+		Sim sim;
+		if (sim.init() || sim.configure(mode))
+			return fail(std::string(name) + ": init");
+		sim.brightness = 0.8 / (mode.exposureMax * 15.5);
+
+		const auto &agc = sim.ctx().configuration.agc;
+		ControlList md;
+		for (unsigned int i = 0; i < 600; i++)
+			md = sim.frame();
+
+		if (sim.exposure() != agc.exposureMaxExtended || sim.gain() < 15.5)
+			return fail(std::string(name) + ": dark scene, exposure " +
+				    std::to_string(sim.exposure()) + " of " +
+				    std::to_string(agc.exposureMaxExtended) + ", gain " +
+				    std::to_string(sim.gain()));
+
+		/* The reported ranges are the ones reached */
+		const ControlInfo &frameInfo = sim.ctx().ctrlMap.at(&controls::FrameDurationLimits);
+		const ControlInfo &expInfo = sim.ctx().ctrlMap.at(&controls::ExposureTime);
+		const int64_t duration = md.get(controls::FrameDuration).value_or(0);
+		const int64_t lineDuration = micros(agc.lineDuration * sim.frameLines);
+		if (frameInfo.max().get<int64_t>() != duration ||
+		    std::abs(duration - lineDuration) > 1 ||
+		    expInfo.max().get<int32_t>() != md.get(controls::ExposureTime).value_or(0) ||
+		    frameInfo.min().get<int64_t>() != micros(agc.lineDuration * mode.defaultLines))
+			return fail(std::string(name) + ": ranges " + frameInfo.toString() + " " +
+				    expInfo.toString() + ", reached " + std::to_string(duration) +
+				    " (sensor " + std::to_string(lineDuration) + ")");
+
+		/* A fixed frame rate of 30 fps from the application */
+		const int64_t fixed = 33333;
+		ControlList fps = limits(fixed, fixed);
+		sim.frame(&fps);
+		if (sim.ctx().activeState.agc.exposure > agc.exposureMax ||
+		    sim.ctx().activeState.agc.again < 15.5)
+			return fail(std::string(name) + ": the limit did not apply at once");
+		for (unsigned int i = 0; i < 100; i++) {
+			md = sim.frame();
+			if (i < 2)
+				continue;
+			if (micros(agc.lineDuration * sim.frameLines) > fixed ||
+			    md.get(controls::FrameDuration).value_or(0) > fixed ||
+			    sim.exposure() > agc.exposureMax)
+				return fail(std::string(name) + ": 30 fps not held, frame " +
+					    std::to_string(sim.frameLines) + " lines, exposure " +
+					    std::to_string(sim.exposure()));
+		}
+		if (sim.gain() < 15.5)
+			return fail(std::string(name) + ": gain not at its limit at 30 fps");
+
+		/* Up to 20 fps */
+		const int64_t longest = 50000;
+		ControlList up(limits(fixed, longest));
+		sim.frame(&up);
+		for (unsigned int i = 0; i < 200; i++)
+			md = sim.frame();
+		const int64_t frame = micros(agc.lineDuration * sim.frameLines);
+		if (frame > longest || frame < longest - 2 * micros(agc.lineDuration * 2) ||
+		    sim.exposure() != sim.ctx().activeState.agc.exposureLimit)
+			return fail(std::string(name) + ": 20 fps, frame " + std::to_string(frame) +
+				    " us, exposure " + std::to_string(sim.exposure()));
+
+		/* A fixed 20 fps in a brighter scene: the frame stays long, the gain comes down */
+		sim.brightness *= 100;
+		ControlList slow(limits(longest, longest));
+		sim.frame(&slow);
+		for (unsigned int i = 0; i < 200; i++)
+			md = sim.frame();
+		const int64_t slowFrame = micros(agc.lineDuration * sim.frameLines);
+		if (slowFrame > longest || slowFrame < longest - micros(agc.lineDuration * 2) ||
+		    sim.exposure() > sim.ctx().activeState.agc.exposureLimit ||
+		    sim.gain() > 8.0)
+			return fail(std::string(name) + ": fixed 20 fps, frame " +
+				    std::to_string(slowFrame) + " us, exposure " +
+				    std::to_string(sim.exposure()));
+
+		return TestPass;
+	}
+
+	int run() override
+	{
+		int ret = testFrameLength();
+		if (ret != TestPass)
+			return ret;
+
+		ret = testDark(kFull, "full");
+		if (ret != TestPass)
+			return ret;
+
+		return testDark(kBinned, "binned");
+	}
+};
+
+TEST_REGISTER(MtkIsp50AgcTest)
