+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detect autofocus for the software ISP
+ */
+
+#pragma once
+
+#include <stdint.h>
+#include <utility>
+#include <vector>
+
+#include <libcamera/control_ids.h>
+
+#include <libcamera/geometry.h>
+
+#include "af_search.h"
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::mtkisp50::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void prepare(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     DipFrameParams *params) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const Statistics *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class Phase {
+		Idle,		/* manual position, or auto mode without a scan */
+		Wait,		/* continuous: wait for a steady scene, then scan */
+		Scan,
+		Monitor,	/* continuous: watch for a scene change */
+		PdWait,		/* trigger: wait a few frames for a reliable PD */
+		PdMove,		/* moved to the PD target: check it, then refine */
+	};
+
+	/* A phase detection result turned into a lens target */
+	struct PdEstimate {
+		bool valid = false;
+		double shift = 0.0;
+		double confidence = 0.0;
+		int32_t target = 0;
+		/* The window it comes from, -1 for all windows together */
+		int window = -1;
+	};
+
+	int32_t toCode(double dioptres) const;
+	static bool readWindow(const ControlValue &value, Rectangle *window);
+	Rectangle toOutputFrame(const Rectangle &window) const;
+	double toDioptres(int32_t code) const;
+	void moveLens(IPAContext &context, int32_t code);
+	void startScan(IPAContext &context);
+	void endScan(IPAContext &context, AfSearch::Result result,
+		     const AfMeasurement &m);
+	void monitor(const AfMeasurement &m, bool exposureSteady, bool pdFocused);
+
+	PdEstimate pdEstimate(const Statistics &stats) const;
+	void trackPd(const PdEstimate &est);
+	bool processPd(IPAContext &context, const PdEstimate &est);
+	void pdStart(IPAContext &context);
+	void pdJump(IPAContext &context, int32_t target);
+	void startFine(IPAContext &context);
+	void enterWait(uint32_t from);
+	bool pdHolds() const;
+
+	bool enabled_ = false;
+
+	/* Tuning */
+	std::vector<std::pair<double, double>> map_;	/* dioptres, lens units */
+	double defaultDioptres_ = 0.0;
+	double rangeMin_ = 0.0;
+	double rangeMax_ = 0.0;
