+++ b/src/ipa/mtkisp50/algorithms/awb.cpp
@@ -0,0 +1,373 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2024-2026 Red Hat Inc.
+ *
+ * Auto white balance
+ */
+
+#include "awb.h"
+
+#include <algorithm>
+#include <cmath>
+#include <numeric>
+#include <stdint.h>
+#include <string>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+#include "libipa/awb_bayes.h"
+#include "libipa/colours.h"
+#include "mtkisp50/ipa_context.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPAMtkIsp50Awb)
+
+namespace ipa::mtkisp50::algorithms {
+
+namespace {
+
+/* Initial colour temperature of the search along the curve */
+constexpr double kDefaultColourTemperature = 5000.0;
+
+/*
+ * Statistics for the search along the colour temperature curve: the means of
+ * the colour channels above the black level, grey world like, as the rkisp1
+ * IPA does with its single AWB window.
+ */
+class SoftAwbStats final : public AwbStats
+{
+public:
+	SoftAwbStats(const RGB<double> &rgbMeans, bool whitePoint)
+		: rgbMeans_(rgbMeans), whitePoint_(whitePoint)
+	{
+		rg_ = rgbMeans_.r() / rgbMeans_.g();
+		bg_ = rgbMeans_.b() / rgbMeans_.g();
+	}
+
+	double computeColourError(const RGB<double> &gains) const override
+	{
+		/*
+		 * Either the relative error of the corrected means (as rkisp1),
+		 * or the distance of the measured white point R/G, B/G from the
+		 * white point of the gains, the space the curve is given in.
+		 */
+		const double deltaR = whitePoint_ ? 1.0 / gains.r() - rg_ : gains.r() * rg_ - 1.0;
+		const double deltaB = whitePoint_ ? 1.0 / gains.b() - bg_ : gains.b() * bg_ - 1.0;
+
+		return deltaR * deltaR + deltaB * deltaB;
+	}
+
+	RGB<double> rgbMeans() const override
+	{
+		return rgbMeans_;
+	}
+
+private:
+	RGB<double> rgbMeans_;
+	bool whitePoint_;
+	double rg_;
+	double bg_;
+};
+
+} /* namespace */
+
+/**
+ * \brief Read the optional tuning parameters
+ *
+ * Without parameters the gains come from the grey world of the statistics,
+ * limited to 4.0. With "algorithm: bayes" the gains are searched along a curve
+ * of colour gains over the colour temperature (libipa AwbBayes, tuning keys
+ * colourGains, priors, AwbMode, transversePos, transverseNeg as for rkisp1):
+ * only plausible light sources result, and the colour temperature handed to
+ * the Ccm algorithm is the one of the curve. As the software ISP measures no
+ * lux the prior of the lowest lux entry applies.
+ *
+ * - speed: share of a new result taken per statistics frame (0.0 to 1.0,
+ *   default 1.0), smooths the gains and the colour temperature
+ * - minMean: smallest mean of a colour channel above the black level, on
+ *   the 8-bit scale, below which the gains are kept (default 2.0)
+ * - colourError (curve search): "gains" (default, relative error of the
+ *   corrected means, as rkisp1) or "whitepoint" (distance of the measured
+ *   R/G, B/G from the white point of the curve)
+ * - statistics (curve search): "mean" (default, the whole statistics window)
+ *   or "zones": only the zones of the statistics zone grid whose white point
+ *   lies within greyDistance (default 0.02, in R/G and B/G) of the curve and
+ *   that are neither dark (minMean) nor near saturation count, so that
+ *   coloured surfaces do not pull the estimate along the curve; without such
+ *   zones the whole window is used
+ */
+int Awb::init(IPAContext &context, const ValueNode &tuningData)
+{
+	context.ctrlMap[&controls::AwbEnable] = ControlInfo(false, true, true);
+	context.ctrlMap[&controls::ColourGains] = ControlInfo(0.0f, 8.0f);
+
+	speed_ = tuningData["speed"].get<double>(1.0);
+	minMean_ = tuningData["minMean"].get<double>(2.0);
+	if (!(speed_ > 0.0 && speed_ <= 1.0) || !(minMean_ >= 0.0)) {
+		LOG(IPAMtkIsp50Awb, Error) << "Invalid Awb speed or minMean";
+		return -EINVAL;
+	}
+
+	const std::string algorithm = tuningData["algorithm"].get<std::string>("grey");
+	if (algorithm == "grey")
+		return 0;
+
+	if (algorithm != "bayes") {
+		LOG(IPAMtkIsp50Awb, Error) << "Unknown Awb algorithm " << algorithm;
+		return -EINVAL;
+	}
+
+	curve_ = std::make_unique<AwbBayes>();
+	int ret = curve_->init(tuningData);
+	if (ret) {
+		LOG(IPAMtkIsp50Awb, Error) << "Awb: invalid colour temperature curve";
+		return ret;
+	}
+
+	const std::string error = tuningData["colourError"].get<std::string>("gains");
+	const std::string statistics = tuningData["statistics"].get<std::string>("mean");
+	greyDistance_ = tuningData["greyDistance"].get<double>(0.02);
+	if ((error != "gains" && error != "whitepoint") ||
+	    (statistics != "mean" && statistics != "zones") || !(greyDistance_ > 0.0)) {
+		LOG(IPAMtkIsp50Awb, Error) << "Invalid Awb colourError, statistics or greyDistance";
+		return -EINVAL;
+	}
+	whitePointError_ = error == "whitepoint";
+	zones_ = statistics == "zones";
+
+	/* White points along the curve for the zone selection */
+	whitePoints_.clear();
+	double ctMin = 1e9, ctMax = 0.0;
+	for (const ValueNode &p : tuningData["colourGains"].asList()) {
+		const double ct = p["ct"].get<double>(0.0);
+		ctMin = std::min(ctMin, ct);
+		ctMax = std::max(ctMax, ct);
+	}
+	for (double ct = ctMin; ct <= ctMax; ct += 10.0) {
+		auto g = curve_->gainsFromColourTemperature(ct);
+		if (g && g->r() > 0.0 && g->b() > 0.0)
+			whitePoints_.push_back({ 1.0 / g->r(), 1.0 / g->b() });
+	}
+
+	for (const auto &[id, info] : curve_->controls())
+		context.ctrlMap[id] = info;
+	context.ctrlMap[&controls::ColourTemperature] = ControlInfo(2000, 10000, 5000);
+
+	LOG(IPAMtkIsp50Awb, Info) << "Awb: search along the colour temperature curve";
+
+	return 0;
+}
+
+int Awb::configure(IPAContext &context,
+		   [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	auto &gains = context.activeState.awb.gains;
+	gains = { { 1.0, 1.0, 1.0 } };
+	context.activeState.awb.temperatureK = 0;
+
+	if (curve_) {
+		auto start = curve_->gainsFromColourTemperature(kDefaultColourTemperature);
+		if (start) {
+			gains = { { static_cast<float>(start->r()), 1.0f,
+				    static_cast<float>(start->b()) } };
+			context.activeState.awb.temperatureK = kDefaultColourTemperature;
+		}
+	}
+
+	return 0;
+}
+
+void Awb::queueRequest(IPAContext &context,
+		       [[maybe_unused]] const uint32_t frame,
+		       [[maybe_unused]] IPAFrameContext &frameContext,
+		       const ControlList &controls)
+{
+	if (curve_)
+		curve_->handleControls(controls);
+
+	if (const auto &v = controls.get(controls::AwbEnable)) {
+		enabled_ = *v;
+		if (enabled_) {
+			manualGains_.reset();
+			manualTemperature_.reset();
+		}
+	}
+
+	/* Fixed gains: either directly or from a colour temperature */
+	if (const auto &v = controls.get(controls::ColourGains)) {
+		manualGains_ = RGB<float>({ (*v)[0], 1.0f, (*v)[1] });
+		manualTemperature_.reset();
+	}
+	if (const auto &v = controls.get(controls::ColourTemperature); v && curve_) {
+		auto g = curve_->gainsFromColourTemperature(*v);
+		if (g) {
+			manualGains_ = RGB<float>({ static_cast<float>(g->r()), 1.0f,
+						    static_cast<float>(g->b()) });
+			manualTemperature_ = *v;
+		}
+	}
+
+	if (!enabled_ && manualGains_) {
+		context.activeState.awb.gains = *manualGains_;
+		if (manualTemperature_)
+			context.activeState.awb.temperatureK = *manualTemperature_;
+		else
+			context.activeState.awb.temperatureK = estimateCCT(
+				RGB<double>({ 1.0 / manualGains_->r(), 1.0, 1.0 / manualGains_->b() }));
+	}
+}
+
+void Awb::prepare(IPAContext &context,
+		  [[maybe_unused]] const uint32_t frame,
+		  IPAFrameContext &frameContext,
+		  DipFrameParams *params)
+{
+	auto &gains = context.activeState.awb.gains;
+
+	frameContext.gains = gains;
+	params->gains = gains;
+}
+
+/*
+ * Sum of the zones near the curve; leaves \a means unchanged and returns 0
+ * if there are none
+ */
+unsigned int Awb::greyZoneMeans(const Statistics *stats, double black, RGB<double> &means) const
+{
+	RGB<double> sum({ 0.0, 0.0, 0.0 });
+	uint64_t count = 0;
+	unsigned int zones = 0;
+
+	for (unsigned int i = 0; i < Statistics::kZones * Statistics::kZones; i++) {
+		const uint32_t n = stats->zoneCount[i];
+		if (!n)
+			continue;
+
+		RGB<double> m;
+		for (unsigned int c = 0; c < 3; c++)
+			m[c] = stats->zoneSum[i][c] / static_cast<double>(n) - black;
+
+		/* Dark zones are noise, bright ones may be clipped in a channel */
+		const double lo = std::min({ m.r(), m.g(), m.b() });
+		const double hi = std::max({ m.r(), m.g(), m.b() });
+		if (lo < minMean_ || hi > 0.9 * (255.0 - black))
+			continue;
+
+		const double r = m.r() / m.g();
+		const double b = m.b() / m.g();
+		double best = 1e9;
+		for (const auto &[wr, wb] : whitePoints_)
+			best = std::min(best, (wr - r) * (wr - r) + (wb - b) * (wb - b));
+		if (best > greyDistance_ * greyDistance_)
+			continue;
+
+		sum += m * static_cast<double>(n);
+		count += n;
+		zones++;
+	}
+
+	if (!zones || !count)
+		return 0;
+
+	means = sum / static_cast<double>(count);
+	return zones;
+}
+
+void Awb::process(IPAContext &context,
+		  [[maybe_unused]] const uint32_t frame,
+		  IPAFrameContext &frameContext,
+		  const Statistics *stats,
+		  ControlList &metadata)
+{
+	const Statistics::Histogram &histogram = stats->yHistogram;
+	const uint8_t blackLevel = context.activeState.blc.level;
+
+	metadata.set(controls::ColourGains, { frameContext.gains.r(),
+					      frameContext.gains.b() });
+	if (context.activeState.awb.temperatureK)
+		metadata.set(controls::ColourTemperature, context.activeState.awb.temperatureK);
+	metadata.set(controls::AwbEnable, enabled_);
+
+	/* Fixed or held gains */
+	if (!stats->valid || !enabled_)
+		return;
+
+	/*
+	 * Black level must be subtracted to get the correct AWB ratios, they
+	 * would be off if they were computed from the whole brightness range
+	 * rather than from the sensor range.
+	 */
+	const uint64_t nPixels = std::accumulate(
+		histogram.begin(), histogram.end(), uint64_t(0));
+	const uint64_t offset = blackLevel * nPixels;
+	const uint64_t minValid = 1;
+	/*
+	 * Make sure the sums are at least minValid, while preventing unsigned
+	 * integer underflow.
+	 */
+	const RGB<uint64_t> sum = stats->sum_.max(offset + minValid) - offset;
+
+	auto &gains = context.activeState.awb.gains;
+
+	if (curve_) {
+		/* Means on the 8-bit scale, over the sampled pixels */
+		const double n = std::max<uint64_t>(nPixels, 1);
+		const RGB<double> means{ { sum.r() / n, sum.g() / n, sum.b() / n } };
+
+		if (means.r() < minMean_ || means.g() < minMean_ || means.b() < minMean_) {
+			LOG(IPAMtkIsp50Awb, Debug) << "Too dark for Awb, means " << means;
+			return;
+		}
+
+		RGB<double> measured = means;
+		unsigned int greyZones = 0;
+		if (zones_)
+			greyZones = greyZoneMeans(stats, blackLevel, measured);
+
+		AwbResult result = curve_->calculateAwb(SoftAwbStats(measured, whitePointError_), 0);
+		const double ct = context.activeState.awb.temperatureK
+					  ? speed_ * result.colourTemperature +
+						    (1.0 - speed_) * context.activeState.awb.temperatureK
+					  : result.colourTemperature;
+		for (unsigned int i = 0; i < 3; i++)
+			gains[i] = static_cast<float>(speed_ * result.gains[i] +
+						      (1.0 - speed_) * gains[i]);
+		context.activeState.awb.temperatureK = std::lround(ct);
+		LOG(IPAMtkIsp50Awb, Debug)
+			<< "means " << measured << " (" << greyZones << " grey zones) curve gains "
+			<< result.gains
+			<< " ct " << result.colourTemperature << " -> gains " << gains
+			<< " ct " << context.activeState.awb.temperatureK;
+	} else {
+		/*
+		 * Calculate red and blue gains for AWB.
+		 * Clamp max gain at 4.0, this also avoids 0 division.
+		 */
+		RGB<float> grey{ {
+			sum.r() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.r(),
+			1.0,
+			sum.b() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.b(),
+		} };
+		gains = speed_ < 1.0 ? grey * static_cast<float>(speed_) +
+					       gains * static_cast<float>(1.0 - speed_)
+				     : grey;
+
+		RGB<double> rgbGains{ { 1 / gains.r(), 1 / gains.g(), 1 / gains.b() } };
+		context.activeState.awb.temperatureK = estimateCCT(rgbGains);
+	}
+
+	metadata.set(controls::ColourTemperature, context.activeState.awb.temperatureK);
+
+	LOG(IPAMtkIsp50Awb, Debug)
+		<< "gain R/B: " << gains << "; temperature: "
+		<< context.activeState.awb.temperatureK;
+}
+
+REGISTER_IPA_ALGORITHM(Awb, "Awb")
+
+} /* namespace ipa::mtkisp50::algorithms */
+
+} /* namespace libcamera */
