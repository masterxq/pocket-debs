+
+void flatten(const ValueNode &node, std::vector<int64_t> &out, bool &valid)
+{
+	if (node.isList()) {
+		for (const ValueNode &v : node.asList())
+			flatten(v, out, valid);
+		return;
+	}
+
+	std::optional<int32_t> v = node.get<int32_t>();
+	if (!v) {
+		valid = false;
+		return;
+	}
+	out.push_back(*v);
+}
+
+/*
+ * Fill a block from a dictionary with one entry per field (lists for arrays,
+ * nested lists for two-dimensional ones). Every field has to be given and
+ * fit its type; the ranges of the fields are checked by the driver.
+ */
+template<typename T, std::size_t N>
+std::optional<T> parseBlock(const ValueNode &node, uint16_t type, const QualityField (&fields)[N],
+			    const char *module)
+{
+	if (!node.isDictionary()) {
+		LOG(IPAMtkIsp50Dip, Error) << "mtk-dip quality: " << module << " is not a dictionary";
+		return std::nullopt;
+	}
+
+	T block = {};
+	block.header.type = type;
+	block.header.flags = MTK_DIP_PARAMS_BLOCK_FL_ENABLE;
+	block.header.size = sizeof(T);
+
+	uint8_t *base = reinterpret_cast<uint8_t *>(&block);
+	for (const QualityField &f : fields) {
+		std::vector<int64_t> values;
+		bool valid = node.contains(f.name);
+		if (valid)
+			flatten(node[f.name], values, valid);
+		if (!valid || values.size() != f.count) {
+			LOG(IPAMtkIsp50Dip, Error)
+				<< "mtk-dip quality: " << module << "." << f.name
+				<< " missing or not " << f.count << " integers";
+			return std::nullopt;
+		}
+
+		const int64_t min = f.isSigned ? -(int64_t(1) << (8 * f.elementSize - 1)) : 0;
+		const int64_t max = f.isSigned ? (int64_t(1) << (8 * f.elementSize - 1)) - 1
+					       : (int64_t(1) << (8 * f.elementSize)) - 1;
+		for (std::size_t i = 0; i < f.count; i++) {
+			if (values[i] < min || values[i] > max) {
+				LOG(IPAMtkIsp50Dip, Error)
+					<< "mtk-dip quality: " << module << "." << f.name
+					<< " value " << values[i] << " out of type range";
+				return std::nullopt;
+			}
+
+			uint8_t *dst = base + f.offset + i * f.elementSize;
+			if (f.elementSize == 1) {
+				const uint8_t v = static_cast<uint8_t>(values[i]);
+				memcpy(dst, &v, 1);
+			} else {
+				const uint16_t v = static_cast<uint16_t>(values[i]);
+				memcpy(dst, &v, 2);
+			}
+		}
+	}
+
+	return block;
+}
+
+std::vector<uint8_t> disabledBlock(uint16_t type)
+{
+	struct v4l2_isp_params_block_header off = {};
+	off.type = type;
+	off.flags = MTK_DIP_PARAMS_BLOCK_FL_DISABLE;
+	off.size = sizeof(off);
+	const uint8_t *p = reinterpret_cast<const uint8_t *>(&off);
+	return std::vector<uint8_t>(p, p + sizeof(off));
+}
+
+template<typename T>
+std::vector<uint8_t> qualityBytes(const std::optional<T> &block, uint16_t type)
+{
+	if (!block)
+		return disabledBlock(type);
+
+	const uint8_t *p = reinterpret_cast<const uint8_t *>(&*block);
+	return std::vector<uint8_t>(p, p + sizeof(T));
+}
