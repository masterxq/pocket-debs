+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Multi-frame still images of the mtkisp50 pipeline: the multi-frame
+ * blending block (MFB) and the worker that aligns and blends a series
+ */
+
+#include "multi_frame.h"
+
+#include <algorithm>
+#include <chrono>
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <linux/media/mediatek/mtk-mfb-mt6785.h>
+#include <linux/videodev2.h>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/dma_buf_allocator.h"
+#include "libcamera/internal/media_device.h"
+
+#include "align/frame_aligner.h"
+
+namespace libcamera {
+
+LOG_DECLARE_CATEGORY(MtkIsp50)
+
+namespace {
+
+constexpr const char *kMfbEntities[MtkIsp50Mfb::NodeCount] = {
+	"mtk-mfb-base", "mtk-mfb-ref", "mtk-mfb-weight-in",
+	"mtk-mfb-params", "mtk-mfb-out", "mtk-mfb-weight-out",
+};
+
+bool isCapture(MtkIsp50Mfb::Node node)
+{
+	return node == MtkIsp50Mfb::Out || node == MtkIsp50Mfb::WeightOut;
+}
+
+uint32_t bufferType(MtkIsp50Mfb::Node node)
+{
+	if (node == MtkIsp50Mfb::Params)
+		return V4L2_BUF_TYPE_META_OUTPUT;
+	return isCapture(node) ? V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE
+			       : V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+}
+
+double msSince(std::chrono::steady_clock::time_point t)
+{
+	return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t).count();
+}
+
+} /* namespace */
+
+/* -----------------------------------------------------------------------------
+ * MtkIsp50Mfb
+ */
+
+std::vector<std::string> MtkIsp50Mfb::nodesOf(MediaDevice *media)
+{
+	std::vector<std::string> nodes;
+
+	for (const char *name : kMfbEntities) {
+		MediaEntity *entity = media->getEntityByName(name);
+		if (!entity || entity->deviceNode().empty())
+			return {};
+		nodes.push_back(entity->deviceNode());
+	}
+
+	return nodes;
+}
+
+MtkIsp50Mfb::~MtkIsp50Mfb()
+{
+	close();
+}
+
+int MtkIsp50Mfb::open(const std::vector<std::string> &nodes)
+{
+	if (nodes.size() != NodeCount)
+		return -ENODEV;
+
+	for (unsigned int i = 0; i < NodeCount; i++) {
+		int fd = ::open(nodes[i].c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC);
+		if (fd < 0) {
+			int ret = -errno;
+			close();
+			return ret;
+		}
+		fds_[i] = UniqueFD(fd);
+	}
+
+	struct v4l2_capability cap = {};
+	int ret = ioctlNode(Base, VIDIOC_QUERYCAP, &cap);
+	if (ret || strcmp(reinterpret_cast<const char *>(cap.driver), "mtk-mfb")) {
+		close();
+		return ret ? ret : -ENODEV;
+	}
+
+	return 0;
+}
+
+void MtkIsp50Mfb::close()
+{
+	release();
+	for (UniqueFD &fd : fds_)
+		fd.reset();
+}
+
+int MtkIsp50Mfb::ioctlNode(Node node, unsigned long request, void *arg)
+{
+	if (::ioctl(fds_[node].get(), request, arg) < 0)
+		return -errno;
+	return 0;
+}
+
+int MtkIsp50Mfb::setFormat(Node node, uint32_t fourcc, unsigned int width, unsigned int height,
+			   unsigned int stride, size_t *size)
+{
+	struct v4l2_format f = {};
+	f.type = bufferType(node);
+	f.fmt.pix_mp.width = width;
+	f.fmt.pix_mp.height = height;
+	f.fmt.pix_mp.pixelformat = fourcc;
+	f.fmt.pix_mp.field = V4L2_FIELD_NONE;
+	f.fmt.pix_mp.num_planes = 1;
+	f.fmt.pix_mp.plane_fmt[0].bytesperline = stride;
+
+	int ret = ioctlNode(node, VIDIOC_S_FMT, &f);
+	if (ret)
+		return ret;
+
+	if (f.fmt.pix_mp.width != width || f.fmt.pix_mp.height != height ||
+	    f.fmt.pix_mp.pixelformat != fourcc || f.fmt.pix_mp.plane_fmt[0].bytesperline != stride) {
+		LOG(MtkIsp50, Error)
+			<< kMfbEntities[node] << ": format " << f.fmt.pix_mp.width << "x"
+			<< f.fmt.pix_mp.height << " stride " << f.fmt.pix_mp.plane_fmt[0].bytesperline;
+		return -EINVAL;
+	}
+
+	*size = f.fmt.pix_mp.plane_fmt[0].sizeimage;
+	return 0;
+}
+
+int MtkIsp50Mfb::requestBuffers(Node node, unsigned int count, unsigned int memory)
+{
+	struct v4l2_requestbuffers req = {};
+	req.count = count;
+	req.type = bufferType(node);
+	req.memory = memory;
+
+	int ret = ioctlNode(node, VIDIOC_REQBUFS, &req);
+	if (ret)
+		return ret;
+
+	return req.count;
+}
+
+/*
+ * Buffers of the camera memory: allocated on the node, exported, and the
+ * node lets them go again (the DMABUFs keep the memory)
+ */
+int MtkIsp50Mfb::exportBuffers(Node node, unsigned int count, std::vector<UniqueFD> *fds)
+{
+	int n = requestBuffers(node, count, V4L2_MEMORY_MMAP);
+	if (n < 0)
+		return n;
+
+	int ret = 0;
+	for (int i = 0; i < n; i++) {
+		struct v4l2_exportbuffer exp = {};
+		exp.type = bufferType(node);
+		exp.index = i;
+		exp.plane = 0;
+		exp.flags = O_RDWR | O_CLOEXEC;
+		ret = ioctlNode(node, VIDIOC_EXPBUF, &exp);
+		if (ret)
+			break;
+		fds->emplace_back(exp.fd);
+	}
+
+	requestBuffers(node, 0, V4L2_MEMORY_MMAP);
+	return ret ? ret : n;
+}
+
+int MtkIsp50Mfb::configure(unsigned int width, unsigned int height, unsigned int stride,
+			   unsigned int images, unsigned int maps,
+			   std::vector<UniqueFD> *imageFds, std::vector<UniqueFD> *mapFds)
+{
+	release();
+
+	int ret = 0;
+	size_t size;
+	for (Node node : { Base, Ref, Out }) {
+		ret = setFormat(node, V4L2_PIX_FMT_NV12, width, height, stride, &size);
+		if (ret)
+			return ret;
+		imageSize_ = size;
+	}
+	for (Node node : { WeightIn, WeightOut }) {
+		ret = setFormat(node, V4L2_PIX_FMT_GREY, width, height, stride, &size);
+		if (ret)
+			return ret;
+		mapSize_ = size;
+	}
+
+	struct v4l2_format f = {};
+	f.type = V4L2_BUF_TYPE_META_OUTPUT;
+	f.fmt.meta.dataformat = V4L2_META_FMT_MTK_MFB_PARAMS;
+	f.fmt.meta.buffersize = MTK_MFB_PARAMS_MAX_SIZE;
+	ret = ioctlNode(Params, VIDIOC_S_FMT, &f);
+	if (ret)
+		return ret;
+
+	/* The maps first: without both no series */
+	ret = exportBuffers(WeightOut, maps, mapFds);
+	if (ret >= 0 && static_cast<unsigned int>(ret) < maps)
+		ret = -ENOMEM;
+	if (ret < 0)
+		return ret;
+
+	ret = exportBuffers(Out, images, imageFds);
+	if (ret < 0)
+		return ret;
+
+	for (Node node : { Base, Ref, WeightIn, Out, WeightOut }) {
+		ret = requestBuffers(node, 1, V4L2_MEMORY_DMABUF);
+		if (ret < 0)
+			return ret;
+	}
+
+	ret = requestBuffers(Params, 1, V4L2_MEMORY_MMAP);
+	if (ret < 1)
+		return ret < 0 ? ret : -ENOMEM;
+
+	struct v4l2_buffer buf = {};
+	buf.type = V4L2_BUF_TYPE_META_OUTPUT;
+	buf.memory = V4L2_MEMORY_MMAP;
+	buf.index = 0;
+	ret = ioctlNode(Params, VIDIOC_QUERYBUF, &buf);
+	if (ret)
+		return ret;
+
+	void *mem = mmap(nullptr, buf.length, PROT_READ | PROT_WRITE, MAP_SHARED,
+			 fds_[Params].get(), buf.m.offset);
+	if (mem == MAP_FAILED)
+		return -errno;
+	paramsMap_ = mem;
+	paramsLength_ = buf.length;
+
+	return 0;
+}
+
+void MtkIsp50Mfb::release()
+{
+	if (!isOpen())
+		return;
+
+	stop();
+
+	if (paramsMap_) {
+		munmap(paramsMap_, paramsLength_);
+		paramsMap_ = nullptr;
+	}
+
+	for (unsigned int i = 0; i < NodeCount; i++)
+		requestBuffers(static_cast<Node>(i), 0,
+			       i == Params ? V4L2_MEMORY_MMAP : V4L2_MEMORY_DMABUF);
+}
+
+int MtkIsp50Mfb::queue(Node node, int fd, size_t length, size_t bytesused)
+{
+	struct v4l2_plane plane = {};
+	struct v4l2_buffer buf = {};
+	buf.type = bufferType(node);
+	buf.index = 0;
+	buf.field = V4L2_FIELD_NONE;
+
+	if (node == Params) {
+		buf.memory = V4L2_MEMORY_MMAP;
+		buf.bytesused = bytesused;
+	} else {
+		buf.memory = V4L2_MEMORY_DMABUF;
+		buf.length = 1;
+		buf.m.planes = &plane;
+		plane.m.fd = fd;
+		plane.length = length;
+		plane.bytesused = isCapture(node) ? 0 : bytesused;
+	}
+
+	return ioctlNode(node, VIDIOC_QBUF, &buf);
+}
+
+int MtkIsp50Mfb::dequeue(Node node, unsigned int timeoutMs, bool *error)
+{
+	struct pollfd pfd = {};
+	pfd.fd = fds_[node].get();
+	pfd.events = isCapture(node) ? POLLIN : POLLOUT;
+
+	int ret = poll(&pfd, 1, timeoutMs);
+	if (ret < 0)
+		return -errno;
+	if (ret == 0)
+		return -ETIMEDOUT;
+
+	struct v4l2_plane plane = {};
+	struct v4l2_buffer buf = {};
+	buf.type = bufferType(node);
+	if (node == Params) {
+		buf.memory = V4L2_MEMORY_MMAP;
+	} else {
+		buf.memory = V4L2_MEMORY_DMABUF;
+		buf.length = 1;
+		buf.m.planes = &plane;
+	}
+
+	ret = ioctlNode(node, VIDIOC_DQBUF, &buf);
+	if (ret)
+		return ret;
+
+	if (buf.flags & V4L2_BUF_FLAG_ERROR)
+		*error = true;
+
+	return 0;
+}
+
+int MtkIsp50Mfb::streamOn(Node node)
+{
+	if (streaming_[node])
+		return 0;
+
+	int type = bufferType(node);
+	int ret = ioctlNode(node, VIDIOC_STREAMON, &type);
+	if (!ret)
+		streaming_[node] = true;
+	return ret;
+}
+
+void MtkIsp50Mfb::streamOff(Node node)
+{
+	if (!streaming_[node])
+		return;
+
+	int type = bufferType(node);
+	ioctlNode(node, VIDIOC_STREAMOFF, &type);
+	streaming_[node] = false;
+}
+
+/*
+ * Start a series: the weight map input joins from the second blend on, the
+ * parameters go with the first blend
+ */
+int MtkIsp50Mfb::start(const std::vector<uint8_t> &params)
+{
+	blends_ = 0;
+	paramsPending_ = false;
+
+	if (!params.empty()) {
+		if (!paramsMap_ || params.size() > paramsLength_)
+			return -EINVAL;
+		memcpy(paramsMap_, params.data(), params.size());
+		paramsPending_ = true;
+	}
+
+	for (Node node : { Base, Ref, Out, WeightOut, Params }) {
+		int ret = streamOn(node);
+		if (ret) {
+			stop();
+			return ret;
+		}
+	}
+
+	if (paramsPending_) {
+		int ret = queue(Params, -1, 0, params.size());
+		if (ret) {
+			stop();
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+int MtkIsp50Mfb::blend(int base, int ref, int weightIn, int out, int weightOut,
+		       unsigned int timeoutMs)
+{
+	int ret = 0;
+
+	if (weightIn >= 0) {
+		ret = streamOn(WeightIn);
+		if (ret)
+			return ret;
+	}
+
+	std::vector<Node> queued;
+	auto q = [&](Node node, int fd, size_t length) {
+		if (ret)
+			return;
+		ret = queue(node, fd, length, length);
+		if (!ret)
+			queued.push_back(node);
+	};
+
+	q(Out, out, imageSize_);
+	q(WeightOut, weightOut, mapSize_);
+	q(Base, base, imageSize_);
+	q(Ref, ref, imageSize_);
+	if (weightIn >= 0)
+		q(WeightIn, weightIn, mapSize_);
+	if (paramsPending_ && !ret) {
+		queued.push_back(Params);
+		paramsPending_ = false;
+	}
+
+	bool error = false;
+	for (Node node : queued) {
+		int r = dequeue(node, ret ? 0 : timeoutMs, &error);
+		if (r && !ret)
+			ret = r;
+	}
+
+	if (ret) {
+		/* Get the buffers back: the series cannot go on */
+		stop();
+		return ret;
+	}
+
+	blends_++;
+	return error ? -EIO : 0;
+}
+
+void MtkIsp50Mfb::stop()
+{
+	for (unsigned int i = 0; i < NodeCount; i++)
+		streamOff(static_cast<Node>(i));
+	paramsPending_ = false;
+}
+
+std::vector<MtkIsp50BlendStep> mtkIsp50PlanBlends(const MtkIsp50SeriesJob &job, unsigned int baseIndex,
+						  const std::vector<bool> &usable)
+{
+	const unsigned int n = job.frames.size();
+	std::vector<MtkIsp50BlendStep> plan;
+	if (baseIndex >= n || usable.size() < n)
+		return plan;
+
+	/* References in capture order, the application image first */
+	std::vector<unsigned int> refs;
+	for (unsigned int k = 0; k < n; k++) {
+		if (k == baseIndex || !usable[k])
+			continue;
+		if (job.frames[k] == job.appImage)
+			refs.insert(refs.begin(), k);
+		else
+			refs.push_back(k);
+	}
+
+	/* Images free for a blend: those without a frame, unusable references */
+	std::vector<unsigned int> spare(job.free.rbegin(), job.free.rend());
+	for (unsigned int k = 0; k < n; k++) {
+		if (k != baseIndex && !usable[k] && job.frames[k] != job.appImage)
+			spare.push_back(job.frames[k]);
+	}
+
+	const unsigned int baseImage = job.frames[baseIndex];
+	unsigned int current = baseImage;
+	int mapIn = -1;
+	unsigned int mapOut = 0;
+	for (unsigned int r = 0; r < refs.size(); r++) {
+		const unsigned int k = refs[r];
+		const unsigned int image = job.frames[k];
+
+		unsigned int out = image;
+		if (out == job.appImage && r + 1 == refs.size()) {
+			if (spare.empty())
+				continue;
+			out = spare.back();
+			spare.pop_back();
+		}
+
+		plan.push_back({ k, current, out, mapIn, mapOut });
+
+		if (current != baseImage && current != job.appImage)
+			spare.push_back(current);
+		if (out != image && image != job.appImage)
+			spare.push_back(image);
+		current = out;
+		mapIn = mapOut;
+		mapOut ^= 1;
+	}
+
+	return plan;
+}
+
+/* -----------------------------------------------------------------------------
+ * MtkIsp50SeriesWorker
+ */
+
+MtkIsp50SeriesWorker::MtkIsp50SeriesWorker()
+{
+}
+
+MtkIsp50SeriesWorker::~MtkIsp50SeriesWorker()
+{
+	release();
+}
+
+int MtkIsp50SeriesWorker::open(const std::vector<std::string> &nodes)
+{
+	return mfb_.open(nodes);
+}
+
+int MtkIsp50SeriesWorker::configure(unsigned int width, unsigned int height, unsigned int stride,
+				    unsigned int images, unsigned int minImages,
+				    std::vector<SharedFD> *imageFds, std::vector<SharedFD> *mapFds)
+{
+	release();
+
+	std::vector<UniqueFD> imgs, maps;
+	int ret = mfb_.configure(width, height, stride, images, 2, &imgs, &maps);
+	if (!ret && imgs.size() < minImages)
+		ret = -ENOMEM;
+	if (ret) {
+		mfb_.release();
+		return ret;
+	}
+
+	width_ = width;
+	height_ = height;
+	stride_ = stride;
+
+	for (UniqueFD &fd : imgs)
+		imageFds->emplace_back(std::move(fd));
+	for (UniqueFD &fd : maps)
+		maps_.emplace_back(std::move(fd));
+	*mapFds = maps_;
+
+	if (!aligner_)
+		aligner_ = std::make_unique<mtkisp50::FrameAligner>();
+
+	return 0;
+}
+
+void MtkIsp50SeriesWorker::release()
+{
+	unmapAll();
+	images_.clear();
+	maps_.clear();
+	mfb_.release();
+}
+
+void MtkIsp50SeriesWorker::setImages(const std::vector<MtkIsp50SeriesImage> &images)
+{
+	mapped_.resize(std::max(mapped_.size(), images.size()));
+	for (unsigned int i = 0; i < images.size(); i++) {
+		if (i < images_.size() && images_[i].fd == images[i].fd)
+			continue;
+		if (mapped_[i].data) {
+			munmap(mapped_[i].data, mapped_[i].length);
+			mapped_[i] = {};
+		}
+	}
+	images_ = images;
+}
+
+int MtkIsp50SeriesWorker::map(unsigned int index)
+{
+	if (index >= images_.size())
+		return -EINVAL;
+
+	Mapped &m = mapped_[index];
+	if (m.data)
+		return 0;
+
+	void *mem = mmap(nullptr, images_[index].length, PROT_READ | PROT_WRITE, MAP_SHARED,
+			 images_[index].fd.get(), 0);
+	if (mem == MAP_FAILED)
+		return -errno;
+
+	m.data = static_cast<uint8_t *>(mem);
+	m.length = images_[index].length;
+	return 0;
+}
+
+void MtkIsp50SeriesWorker::unmapAll()
+{
+	for (Mapped &m : mapped_) {
+		if (m.data)
+			munmap(m.data, m.length);
+		m = {};
+	}
+}
+
+/*
+ * The series: base frame and motion of all frames, then per usable reference
+ * frame its alignment into the warp image and a blend. Each blend writes into
+ * the image of its reference frame (free once aligned), the application
+ * image goes first among the references so that it never holds the last
+ * blend. The base frame stays for the noise reduction in the ISP.
+ */
+unsigned int MtkIsp50SeriesWorker::usableFrames() const
+{
+	unsigned int usable = 0;
+	for (unsigned int k = 0; k < aligner_->count(); k++)
+		usable += k != aligner_->base() && aligner_->result(k).usable;
+	return usable;
+}
+
+void MtkIsp50SeriesWorker::process(const MtkIsp50SeriesJob &job)
+{
+	using clock = std::chrono::steady_clock;
+	const auto t0 = clock::now();
+
+	MtkIsp50SeriesResult result;
+	const unsigned int n = job.frames.size();
+	const size_t uvOffset = static_cast<size_t>(stride_) * height_;
+
+	auto finish = [&](int status) {
+		result.status = status;
+		result.tTotal = msSince(t0);
+		done.emit(result);
+	};
+
+	if (!aligner_ || n < 2 || maps_.size() < 2) {
+		finish(-EINVAL);
+		return;
+	}
+
+	int ret = 0;
+	for (unsigned int i : job.frames)
+		ret = ret ? ret : map(i);
+	if (!ret)
+		ret = map(job.warpImage);
+	if (ret) {
+		LOG(MtkIsp50, Error) << "Series: images not mapped: " << strerror(-ret);
+		finish(ret);
+		return;
+	}
+
+	/* Base frame and motion */
+	std::vector<mtkisp50::Nv12Frame> frames;
+	{
+		std::vector<DmaSyncer> sync;
+		for (unsigned int i : job.frames) {
+			sync.emplace_back(images_[i].fd, DmaSyncer::SyncType::Read);
+			const uint8_t *data = mapped_[i].data;
+			frames.push_back({ data, stride_, data + uvOffset, stride_ });
+		}
+
+		const auto t = clock::now();
+		int base = aligner_->estimate(frames.data(), n, width_, height_);
+
+		/*
+		 * A base frame most frames do not match: a broken frame is
+		 * often the sharpest one. Once more with the frame of the still
+		 * image as base, then with the one of middle sharpness; the
+		 * base most frames match wins.
+		 */
+		unsigned int matched = base >= 0 ? usableFrames() : 0;
+		if (base >= 0 && n >= 3 && 2 * matched < n - 1) {
+			std::vector<std::pair<float, unsigned int>> sharp;
+			for (unsigned int k = 0; k < n; k++)
+				sharp.emplace_back(aligner_->result(k).sharpness, k);
+			std::sort(sharp.begin(), sharp.end());
+			const unsigned int still = std::find(job.frames.begin(), job.frames.end(),
+							     job.appImage) - job.frames.begin();
+
+			std::vector<unsigned int> tried = { static_cast<unsigned int>(base) };
+			unsigned int best = base;
+			for (unsigned int candidate : { still, sharp[n / 2].second }) {
+				if (candidate >= n || std::count(tried.begin(), tried.end(), candidate))
+					continue;
+				LOG(MtkIsp50, Warning)
+					<< "Series: " << matched << " of " << n - 1
+					<< " frames match base frame " << tried.back()
+					<< ", once more with frame " << candidate;
+				tried.push_back(candidate);
+				aligner_->setBaseIndex(candidate);
+				base = aligner_->estimate(frames.data(), n, width_, height_);
+				const unsigned int m = base >= 0 ? usableFrames() : 0;
+				if (m > matched || (m == matched && candidate == still)) {
+					matched = m;
+					best = candidate;
+				}
+				if (2 * matched >= n - 1)
+					break;
+			}
+			if (base >= 0 && static_cast<unsigned int>(base) != best) {
+				aligner_->setBaseIndex(best);
+				base = aligner_->estimate(frames.data(), n, width_, height_);
+			}
+			aligner_->setBaseIndex(-1);
+		}
+		result.tEstimate = msSince(t);
+		const mtkisp50::FrameAligner::Timing &timing = aligner_->timing();
+		result.tReduce = timing.reduce;
+		result.tMatch = timing.match;
+		result.tFit = timing.fit;
+		if (base < 0) {
+			finish(-EINVAL);
+			return;
+		}
+		result.base = job.frames[base];
+	}
+
+	const unsigned int baseIndex = aligner_->base();
+	std::vector<bool> usable(n);
+	for (unsigned int k = 0; k < n; k++)
+		usable[k] = k != baseIndex && aligner_->result(k).usable;
+
+	const std::vector<MtkIsp50BlendStep> plan = mtkIsp50PlanBlends(job, baseIndex, usable);
+	result.unusable = n - 1 - plan.size();
+
+	if (!plan.empty())
+		ret = mfb_.start(job.blendParams);
+	if (ret) {
+		LOG(MtkIsp50, Error) << "Series: blending block not started: " << strerror(-ret);
+		finish(ret);
+		return;
+	}
+
+	mtkisp50::Nv12Target warp{ mapped_[job.warpImage].data, stride_,
+				   mapped_[job.warpImage].data + uvOffset, stride_ };
+
+	for (const MtkIsp50BlendStep &step : plan) {
+		if (abort_) {
+			ret = -ECANCELED;
+			break;
+		}
+
+		const unsigned int image = job.frames[step.frame];
+		auto t = clock::now();
+		{
+			std::vector<DmaSyncer> sync;
+			sync.emplace_back(images_[image].fd, DmaSyncer::SyncType::Read);
+			sync.emplace_back(images_[job.warpImage].fd, DmaSyncer::SyncType::Write);
+			ret = aligner_->warp(step.frame, warp);
+		}
+		result.tWarp += msSince(t);
+		if (ret)
+			break;
+
+		t = clock::now();
+		ret = mfb_.blend(images_[step.base].fd.get(), images_[job.warpImage].fd.get(),
+				 step.mapIn >= 0 ? maps_[step.mapIn].get() : -1,
+				 images_[step.out].fd.get(), maps_[step.mapOut].get(), 1000);
+		result.tBlend += msSince(t);
+		if (ret) {
+			LOG(MtkIsp50, Error) << "Series: blend " << result.blends + 1
+					     << " failed: " << strerror(-ret);
+			break;
+		}
+
+		result.blended = step.out;
+		result.map = step.mapOut;
+		result.blends++;
+	}
+
+	mfb_.stop();
+
+	/* An image for the noise reduction of the base frame, never the application one */
+	result.spare = job.warpImage;
+
+	LOG(MtkIsp50, Debug)
+		<< "Series: base " << baseIndex << " of " << n << ", " << result.blends
+		<< " blends, " << result.unusable << " unusable";
+
+	/* The blends before a failure are good, not after a stop */
+	finish(abort_ ? -ECANCELED : result.blends ? 0 : ret);
+}
+
+} /* namespace libcamera */
