+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2024-2026, Red Hat Inc.
+ *
+ * Color correction matrix
+ */
+
+#pragma once
+
+#include <optional>
+#include <vector>
+
+#include "libcamera/internal/matrix.h"
+
+#include <libipa/interpolator.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::mtkisp50::algorithms {
+
+constexpr float kDefaultGamma = 2.2f;
+
+class Adjust : public Algorithm
+{
+public:
+	Adjust() = default;
+	~Adjust() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context,
+		      const IPAConfigInfo &configInfo) override;
+	void queueRequest(typename Module::Context &context,
+			  const uint32_t frame,
+			  typename Module::FrameContext &frameContext,
+			  const ControlList &controls) override;
+	void prepare(IPAContext &context,
+		     const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     DipFrameParams *params) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const Statistics *stats,
+		     ControlList &metadata) override;
+
+private:
+	/*
+	 * Default saturation over the colour temperature (linear in mired)
+	 * and optionally the light value of the scene, from the tuning file
+	 */
+	struct SaturationCurve {
+		std::vector<double> lv;
+		std::vector<double> ct;
+		std::vector<std::vector<double>> values;
+		double fNumber;
+		double lvOffset;
+	};
+
+	void applySaturation(Matrix<float, 3, 3> &ccm, float saturation);
+	int parseSaturationCurve(const ValueNode &node);
+	std::optional<float> curveSaturation(const IPAContext &context) const;
+
+	std::optional<SaturationCurve> saturationCurve_;
+};
+
+} /* namespace ipa::mtkisp50::algorithms */
+
+} /* namespace libcamera */
diff --git a/src/ipa/mtkisp50/algorithms/af.cpp b/src/ipa/mtkisp50/algorithms/af.cpp
new file mode 100644
index 0000000..5a37dc5
--- /dev/null
+++ b/src/ipa/mtkisp50/algorithms/af.cpp
@@ -0,0 +1,1286 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detect autofocus for the software ISP
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+#include <errno.h>
+#include <sstream>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/log.h>
+
+#include "mtkisp50/statistics.h"
+
+#include "mtkisp50/ipa_context.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPAMtkIsp50Af)
+
+namespace ipa::mtkisp50::algorithms {
+
+/*
+ * Continuous mode: focus grid samples (one per frame while waiting) to wait
+ * for a steady scene at most before scanning anyway
+ */
+static constexpr unsigned int kMaxWait = 15;
+
+/* Wait for a drifting exposure at most this many focus grid samples */
+static constexpr unsigned int kMaxExposureWait = 45;
+
+/* Steady scene: relative change of level and sharpness between samples */
+static constexpr double kSteadyLevel = 0.08;
+static constexpr double kSteadySharpness = 0.2;
+
+/**
+ * \class Af
+ * \brief Contrast detect autofocus with a voice coil lens
+ *
+ * The lens is driven through the lens controls the pipeline handler passes to
+ * the IPA (V4L2_CID_FOCUS_ABSOLUTE). Without a lens, or without an Af entry
+ * in the tuning file, the algorithm does nothing and registers no controls.
+ *
+ * Tuning parameters:
+ * - map: pairs of dioptres and lens positions (driver units), at least two,
+ *   ascending; positions outside are extrapolated from the end segments
+ * - default: lens position in dioptres used in manual mode until a
+ *   LensPosition is set, at start and when a scan fails (default 0)
+ * - range: dioptres scanned by the search, [min, max]; min may be negative
+ *   to cover module tolerances beyond infinity (default the map ends)
+ * - step: coarse scan step in dioptres (default 1.0)
+ * - search: "climb" (default) from the current position with a probe to
+ *   either side, or "scan" of the whole range; climbStep: its step in
+ *   dioptres (default step)
+ * - region: centred fraction of the image in each direction that the focus
+ *   grid covers and the measurement uses (default 1/3; the older key
+ *   "window", a fraction of the central half, is still read)
+ * - settleFrames: frames after the last frame received when the lens was
+ *   moved, before the focus grid is used again (default 2)
+ * - monitorInterval: focus grid in every n-th frame with statistics while
+ *   watching for a scene change (default 1)
+ * - sceneChangeFrames: frames a scene change must last before a new search
+ *   (default 0: two samples in a row); changeLevel, changeSharpnessDrop,
+ *   changeSharpnessRise: its thresholds (defaults 0.3, 0.6, 1.8)
+ * - mode: initial AfMode, "manual", "auto" or "continuous" (default
+ *   continuous)
+ * - pd: phase detection, for sensors whose pipeline delivers PD statistics
+ *   (Statistics::pdValid); without it, or without PD in the sensor mode,
+ *   the focus is found by contrast alone. Keys:
+ *   - slope (required): lens units per pixel of phase shift, the lens target
+ *     is position + slope * (shift - offset); offset: shift in focus (0)
+ *   - minConfidence: PD confidence (0..100) a result needs (40); minLevel:
+ *     mean PD level above black, in raw units, below which PD is not used (30)
+ *   - grid: [w, h] windows (3x3); region: centred fraction of the frame
+ *     (default the focus region); tapSize: smallest fraction of the frame
+ *     around an AfWindows rectangle (0.2); maxShift: search range of the
+ *     match in profile samples (8)
+ *   - deadband: lens units a PD target must differ from the one seen when
+ *     focused to move the lens, at least three times the spread of the
+ *     results in focus (12); agreement: lens units within which results of
+ *     consecutive frames agree (16); confirmFrames: results in a row beyond
+ *     the deadband before a move in continuous mode while focused (3);
+ *     maxBias: lens units the PD target may differ from the focused position
+ *     before the lens goes to it once (30); startFrames:
+ *     the same when a search is due (2); waitFrames: frames a search waits
+ *     for a reliable PD result before it falls back to the contrast search
+ *     (6); holdFrames: frames a PD result in focus keeps the contrast watch
+ *     off (15); maxJumps: PD moves of one search (2)
+ *   - fineRange, fineStep: contrast search around the PD target, in lens
+ *     units (24, 8); fineRange 0 ends the search at the PD target
+ *   - margin: lens units a PD target may lie outside the scan range (60)
+ *
+ * With PD a search (continuous: at the start, after a scene change or a new
+ * AfWindows; auto: AfTrigger) moves the lens to the PD target as soon as
+ * startFrames results agree, checks it once more and refines it with a short
+ * contrast search. While focused in continuous mode the lens only moves when
+ * confirmFrames reliable results in a row ask for more than the deadband; a
+ * reliable result in focus keeps the contrast watch from starting a search.
+ * Without reliable PD the contrast search and watch work as without PD.
+ *
+ * While waiting for a steady scene and while searching the focus grid is
+ * requested on every frame (DipFrameParams::afEveryFrame). AfMetering Windows
+ * with AfWindows moves the region to the first rectangle, otherwise it is
+ * centred. The rectangles are in coordinates of the pixel array active area
+ * (the simple pipeline has no ScalerCropMaximum); they are mapped through the
+ * analogue crop of the sensor onto its output frame and bounded to it. An
+ * empty list, or a rectangle outside the frame, centres the region again.
+ * AfWindows is taken as a list or as a single rectangle; a value of another
+ * type is ignored with a warning.
+ */
+
+int Af::init(IPAContext &context, const ValueNode &tuningData)
+{
+	const auto lens = context.lensControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+	if (lens == context.lensControls.end()) {
+		LOG(IPAMtkIsp50Af, Info) << "No focus lens, autofocus disabled";
+		return 0;
+	}
+
+	lensMin_ = lens->second.min().get<int32_t>();
+	lensMax_ = lens->second.max().get<int32_t>();
+
+	auto map = tuningData["map"].get<std::vector<double>>();
+	if (!map || map->size() < 4 || map->size() % 2) {
+		LOG(IPAMtkIsp50Af, Error) << "Af needs a map of dioptres and lens positions";
+		return -EINVAL;
+	}
+
+	map_.clear();
+	for (unsigned int i = 0; i < map->size(); i += 2) {
+		if (!map_.empty() && ((*map)[i] <= map_.back().first ||
+				      (*map)[i + 1] <= map_.back().second)) {
+			LOG(IPAMtkIsp50Af, Error) << "Af map must be ascending";
+			return -EINVAL;
+		}
+		map_.emplace_back((*map)[i], (*map)[i + 1]);
+	}
+
+	defaultDioptres_ = tuningData["default"].get<double>(0.0);
+	auto range = tuningData["range"].get<std::vector<double>>();
+	if (range && range->size() == 2 && (*range)[0] < (*range)[1]) {
+		rangeMin_ = (*range)[0];
+		rangeMax_ = (*range)[1];
+	} else {
+		rangeMin_ = map_.front().first;
+		rangeMax_ = map_.back().first;
+	}
+	step_ = tuningData["step"].get<double>(1.0);
+	climbStep_ = tuningData["climbStep"].get<double>(step_);
+	climb_ = tuningData["search"].get<std::string>("climb") != "scan";
+	if (tuningData.contains("region"))
+		region_ = tuningData["region"].get<double>(1.0 / 3.0);
+	else
+		region_ = 0.5 * tuningData["window"].get<double>(2.0 / 3.0);
+	settleFrames_ = std::clamp(tuningData["settleFrames"].get<unsigned int>(2), 1u, 16u);
+	sceneChangeFrames_ = tuningData["sceneChangeFrames"].get<unsigned int>(0);
+	changeLevel_ = tuningData["changeLevel"].get<double>(0.3);
+	changeSharpnessDrop_ = tuningData["changeSharpnessDrop"].get<double>(0.6);
+	changeSharpnessRise_ = tuningData["changeSharpnessRise"].get<double>(1.8);
+	sensorSize_ = context.sensorInfo.outputSize;
+	analogCrop_ = context.sensorInfo.analogCrop;
+	if (analogCrop_.isNull())
+		analogCrop_ = Rectangle(sensorSize_);
+	monitorInterval_ = std::clamp(tuningData["monitorInterval"].get<unsigned int>(1), 1u, 255u);
+
+	pdTuned_ = false;
+	if (tuningData.contains("pd")) {
+		const ValueNode &pd = tuningData["pd"];
+		pdSlope_ = pd["slope"].get<double>(0.0);
+		pdOffset_ = pd["offset"].get<double>(0.0);
+		pdMinConfidence_ = pd["minConfidence"].get<double>(40.0);
+		pdMinLevel_ = pd["minLevel"].get<double>(30.0);
+		pdRegion_ = pd["region"].get<double>(region_);
+		pdTapSize_ = pd["tapSize"].get<double>(0.2);
+		auto grid = pd["grid"].get<std::vector<unsigned int>>();
+		if (grid && grid->size() == 2) {
+			pdGridWidth_ = (*grid)[0];
+			pdGridHeight_ = (*grid)[1];
+		}
+		pdMaxShift_ = std::clamp(pd["maxShift"].get<unsigned int>(8), 2u, 32u);
+		pdDeadband_ = pd["deadband"].get<int32_t>(12);
+		pdAgreement_ = pd["agreement"].get<int32_t>(16);
+		pdConfirmFrames_ = std::max(1u, pd["confirmFrames"].get<unsigned int>(3));
+		pdStartFrames_ = std::max(1u, pd["startFrames"].get<unsigned int>(2));
+		pdWaitFrames_ = pd["waitFrames"].get<unsigned int>(6);
+		pdHoldFrames_ = pd["holdFrames"].get<unsigned int>(15);
+		pdMaxJumps_ = std::max(1u, pd["maxJumps"].get<unsigned int>(2));
+		pdFineRange_ = std::max(0, pd["fineRange"].get<int32_t>(24));
+		pdFineStep_ = std::max(1, pd["fineStep"].get<int32_t>(8));
+		pdMargin_ = std::max(0, pd["margin"].get<int32_t>(60));
+		pdMaxBias_ = std::max(0, pd["maxBias"].get<int32_t>(30));
+
+		if (pdSlope_ == 0.0 || pdRegion_ <= 0.0 || pdRegion_ > 1.0 ||
+		    pdTapSize_ <= 0.0 || pdTapSize_ > 1.0 || !pdGridWidth_ || !pdGridHeight_ ||
+		    pdGridWidth_ * pdGridHeight_ > Statistics::kPdMaxWindows) {
+			LOG(IPAMtkIsp50Af, Error) << "Invalid Af pd tuning parameters";
+			return -EINVAL;
+		}
+		pdTuned_ = true;
+	}
+
+	std::string mode = tuningData["mode"].get<std::string>("continuous");
+	if (mode == "manual")
+		initialMode_ = controls::AfModeManual;
+	else if (mode == "auto")
+		initialMode_ = controls::AfModeAuto;
+	else if (mode == "continuous")
+		initialMode_ = controls::AfModeContinuous;
+	else {
+		LOG(IPAMtkIsp50Af, Error) << "Unknown Af mode " << mode;
+		return -EINVAL;
+	}
+
+	if (step_ <= 0.0 || climbStep_ <= 0.0 || region_ <= 0.0 || region_ > 1.0) {
+		LOG(IPAMtkIsp50Af, Error) << "Invalid Af tuning parameters";
+		return -EINVAL;
+	}
+
+	const double maxDioptres = std::max(std::min(toDioptres(lensMax_), rangeMax_), 0.0);
+	const double defDioptres = std::clamp(defaultDioptres_, 0.0, maxDioptres);
+
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(controls::AfModeValues, ControlValue(static_cast<int32_t>(initialMode_)));
+	context.ctrlMap[&controls::AfTrigger] = ControlInfo(controls::AfTriggerValues);
+	context.ctrlMap[&controls::AfPause] = ControlInfo(controls::AfPauseValues);
+	context.ctrlMap[&controls::AfMetering] = ControlInfo(controls::AfMeteringValues);
+	context.ctrlMap[&controls::AfWindows] =
+		ControlInfo(Rectangle{},
+			    Rectangle(0, 0, analogCrop_.x + analogCrop_.width,
+				      analogCrop_.y + analogCrop_.height),
+			    Rectangle{});
+	context.ctrlMap[&controls::LensPosition] =
+		ControlInfo(0.0f, static_cast<float>(maxDioptres),
+			    static_cast<float>(defDioptres));
+
+	enabled_ = true;
+	mode_ = initialMode_;
+
+	LOG(IPAMtkIsp50Af, Info)
+		<< "Af: lens " << lensMin_ << "-" << lensMax_
+		<< ", scan " << toCode(rangeMin_) << "-" << toCode(rangeMax_)
+		<< " step " << step_ << " dpt, default " << toCode(defaultDioptres_)
+		<< (pdTuned_ ? ", phase detection" : "");
+
+	return 0;
+}
+
+/* Piecewise linear, extrapolated from the end segments */
+static double interpolate(const std::vector<std::pair<double, double>> &map,
+			  double x, bool inverse)
+{
+	auto key = [&](unsigned int i) { return inverse ? map[i].second : map[i].first; };
+	auto val = [&](unsigned int i) { return inverse ? map[i].first : map[i].second; };
+
+	unsigned int i = 1;
+	while (i + 1 < map.size() && x > key(i))
+		i++;
+
+	const double x0 = key(i - 1), x1 = key(i);
+	return val(i - 1) + (x - x0) * (val(i) - val(i - 1)) / (x1 - x0);
+}
+
+int32_t Af::toCode(double dioptres) const
+{
+	const double code = interpolate(map_, dioptres, false);
+
+	return std::clamp<int32_t>(std::lround(code), lensMin_, lensMax_);
+}
+
+double Af::toDioptres(int32_t code) const
+{
+	return interpolate(map_, code, true);
+}
+
+int Af::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+	if (!enabled_)
+		return 0;
+
+	/* Frame numbers start again with the new session */
+	frame_ = 0;
+	lastPrepared_ = 0;
+	moveFrame_ = 0;
+
+	/* Phase detection where the sensor mode has it */
+	pdActive_ = pdTuned_ && configInfo.pdAvailable;
+	pdFrom_ = 0;
+	pdCount_ = 0;
+	pdWindow_ = kPdAnyWindow;
+	pdLastReliable_ = 0;
+	pdInFocus_ = 0;
+	pdSeenInFocus_ = false;
+	pdJumps_ = 0;
+	fine_ = false;
+	LOG(IPAMtkIsp50Af, Debug) << "Phase detection " << (pdActive_ ? "on" : "off");
+
+	if (configured_ && lensCode_) {
+		/*
+		 * A new configuration of the same camera (a mode change, for
+		 * instance from the preview to a photo): the lens stays where
+		 * it is and the focus state is kept. The position is sent
+		 * again with the first statistics, the capture side may have
+		 * moved the lens at the start of the stream; the first frames
+		 * are not measured until it has settled.
+		 */
+		context.activeState.af.lensPosition = lensCode_;
+		context.activeState.af.update = true;
+		moved_ = true;
+
+		if (mode_ == controls::AfModeContinuous) {
+			/*
+			 * Focused before: watch for a change against a new
+			 * reference (the focus grid of the new mode has other
+			 * cells), else wait for a steady scene and scan.
+			 */
+			if (state_ == controls::AfStateFocused ||
+			    state_ == controls::AfStateFailed) {
+				phase_ = Phase::Monitor;
+				rebase_ = true;
+			} else {
+				phase_ = Phase::Wait;
+				state_ = controls::AfStateIdle;
+			}
+		} else {
+			/* A scan of the old session does not go on */
+			if (phase_ == Phase::Scan || phase_ == Phase::PdWait ||
+			    phase_ == Phase::PdMove)
+				state_ = controls::AfStateIdle;
+			phase_ = Phase::Idle;
+		}
+
+		dark_ = false;
+		context.activeState.af.busy = phase_ == Phase::Wait;
+		levelIndex_ = 0;
+		waitCount_ = 0;
+		steadyCount_ = 0;
+		changeCount_ = 0;
+		lastSharpness_ = 0.0;
+		lastLevel_ = 0.0;
+		levelRebase_ = false;
+		exposureWait_ = 0;
+
+		LOG(IPAMtkIsp50Af, Debug)
+			<< "New configuration: lens kept at " << lensCode_
+			<< ", state " << static_cast<int>(state_);
+		return 0;
+	}
+	configured_ = true;
+
+	if (mode_ != controls::AfModeManual)
+		lensCode_ = toCode(defaultDioptres_);
+	else if (!lensCode_)
+		lensCode_ = toCode(defaultDioptres_);
+
+	/* Send the position with the first statistics of the session. */
+	context.activeState.af.lensPosition = lensCode_;
+	context.activeState.af.update = true;
+	moved_ = false;
+
+	state_ = controls::AfStateIdle;
+	phase_ = mode_ == controls::AfModeContinuous ? Phase::Wait : Phase::Idle;
+	levelIndex_ = 0;
+	dark_ = false;
+	context.activeState.af.busy = phase_ == Phase::Wait;
+	waitCount_ = 0;
+	steadyCount_ = 0;
+	changeCount_ = 0;
+	lastSharpness_ = 0.0;
+	lastLevel_ = 0.0;
+	rebase_ = false;
+	levelRebase_ = false;
+	exposureWait_ = 0;
+
+	return 0;
+}
+
+void Af::moveLens(IPAContext &context, int32_t code)
+{
+	code = std::clamp(code, lensMin_, lensMax_);
+	if (code == lensCode_ && !context.activeState.af.update)
+		return;
+
+	lensCode_ = code;
+	context.activeState.af.lensPosition = code;
+	context.activeState.af.update = true;
+	/*
+	 * The move acts during the frames after the last one received; the
+	 * statistics of the frame being processed may lag behind that.
+	 */
+	moveFrame_ = std::max(frame_, lastPrepared_);
+	moved_ = true;
+}
+
+void Af::startScan(IPAContext &context)
+{
+	AfSearch::Config config;
+
+	dark_ = false;
+	config.min = toCode(rangeMin_);
+	config.max = toCode(rangeMax_);
+	config.climb = climb_;
+	config.start = lensCode_;
+	const double step = climb_ ? climbStep_ : step_;
+	config.step = std::max<int32_t>(1, std::lround(toCode(rangeMin_ + step) -
+						       toCode(rangeMin_)));
+	config.peakDrop = 0.85;
+	config.minContrast = 1.15;
+
+	search_.start(config);
+	phase_ = Phase::Scan;
+	state_ = controls::AfStateScanning;
+	scanStart_ = frame_;
+	fine_ = false;
+	pdWindow_ = kPdAnyWindow;
+	moveLens(context, search_.target());
+
+	LOG(IPAMtkIsp50Af, Debug) << "Scan " << config.min << "-" << config.max
+			      << " step " << config.step;
+}
+
+void Af::endScan(IPAContext &context, AfSearch::Result result,
+		 const AfMeasurement &m)
+{
+	if (result == AfSearch::Result::Done) {
+		state_ = controls::AfStateFocused;
+		moveLens(context, search_.target());
+		baseSharpness_ = search_.peak();
+		rebase_ = false;
+	} else if (fine_) {
+		/* No contrast peak around the PD target: the target holds */
+		state_ = controls::AfStateFocused;
+		moveLens(context, fineCenter_);
+		rebase_ = true;
+	} else {
+		state_ = controls::AfStateFailed;
+		moveLens(context, toCode(defaultDioptres_));
+		/* The first measurement at the default position is the reference. */
+		rebase_ = true;
+	}
+
+	baseLevel_ = m.level;
+	changeCount_ = 0;
+	phase_ = mode_ == controls::AfModeContinuous ? Phase::Monitor : Phase::Idle;
+	/* The PD reference comes from the next frames at the new position */
+	pdRefValid_ = false;
+	pdRefCount_ = 0;
+	pdRefSum_ = 0.0;
+	pdOut_ = 0;
+	pdSeenInFocus_ = false;
+	pdFrom_ = std::max(moveFrame_ + settleFrames_, frame_ + 1);
+	if (pauseDeferred_) {
+		pauseDeferred_ = false;
+		paused_ = true;
+		phase_ = Phase::Idle;
+	}
+
+	LOG(IPAMtkIsp50Af, Info)
+		<< (state_ == controls::AfStateFocused ? "Focused" : "Focus failed")
+		<< " at " << lensCode_ << " (" << toDioptres(lensCode_)
+		<< " dpt) after " << frame_ - scanStart_ << " frames"
+		<< (fine_ ? (result == AfSearch::Result::Done ? ", PD and contrast"
+							      : ", PD target") : "");
+	fine_ = false;
+	pdJumps_ = 0;
+	pdCount_ = 0;
+}
+
+/*
+ * @pdFocused: PD saw the subject in focus since the search. A change of the
+ * level alone (the light) or a scene too dark to measure is then no reason
+ * for a search: PD tells when the subject moves.
+ */
+void Af::monitor(const AfMeasurement &m, bool exposureSteady, bool pdFocused)
+{
+	/*
+	 * While the exposure moves, level and (at low levels, through the
+	 * noise) sharpness move with it: no scene change is counted. The level
+	 * after the exposure has settled is the new reference, the sharpness
+	 * stays comparable.
+	 */
+	if (!exposureSteady) {
+		changeCount_ = 0;
+		levelRebase_ = true;
+		return;
+	}
+
+	/*
+	 * After a failed scan a dark or flat scene may gain light or texture;
+	 * after a successful one the subject may move. Both show up as a
+	 * change of level or sharpness against the end of the scan.
+	 */
+	if (rebase_) {
+		baseSharpness_ = m.sharpness;
+		baseLevel_ = m.level;
+		rebase_ = false;
+		levelRebase_ = false;
+		return;
+	}
+
+	if (levelRebase_) {
+		baseLevel_ = m.level;
+		levelRebase_ = false;
+	}
+
+	/* Below a level of 1 the level is mostly noise, only a valid measurement counts. */
+	const bool levelChange = !pdFocused && baseLevel_ >= 1.0 &&
+				 std::abs(m.level / baseLevel_ - 1.0) > changeLevel_;
+	const bool sharpnessChange = m.sharpness >= 0.0 && baseSharpness_ > 0.0 &&
+				     (m.sharpness < baseSharpness_ * changeSharpnessDrop_ ||
+				      m.sharpness > baseSharpness_ * changeSharpnessRise_);
+	const bool invalidChange = !pdFocused &&
+				   (m.sharpness < 0.0) != (baseSharpness_ < 0.0);
+
+	if (levelChange || sharpnessChange || invalidChange) {
+		if (!changeCount_++)
+			changeSince_ = frame_;
+	} else {
+		changeCount_ = 0;
+		/* Follow slow drifts of the scene. */
+		if (m.sharpness > 0.0 && baseSharpness_ > 0.0)
+			baseSharpness_ = 0.9 * baseSharpness_ + 0.1 * m.sharpness;
+	}
+
+	/* A change that lasts: two samples in a row and sceneChangeFrames */
+	if (changeCount_ >= 2 && frame_ - changeSince_ >= sceneChangeFrames_) {
+		LOG(IPAMtkIsp50Af, Debug)
+			<< "Scene change (level " << m.level << " against " << baseLevel_
+			<< ", sharpness " << m.sharpness << " against " << baseSharpness_
+			<< "), refocus";
+		enterWait(frame_ + 1);
+	}
+}
+
+/*
+ * The first rectangle of an AfWindows value, which applications send as a
+ * list (the type of the control) or as a single rectangle. An empty list
+ * gives a null rectangle (centred region). Returns false for a value that is
+ * not a rectangle.
+ */
+bool Af::readWindow(const ControlValue &value, Rectangle *window)
+{
+	*window = {};
+	if (value.type() != ControlTypeRectangle) {
+		LOG(IPAMtkIsp50Af, Warning)
+			<< "AfWindows of type " << value.type() << " ignored";
+		return false;
+	}
+	if (!value.isArray()) {
+		*window = value.get<Rectangle>();
+		return true;
+	}
+	const auto list = value.get<Span<const Rectangle>>();
+	if (!list.empty())
+		*window = list[0];
+
+	return true;
+}
+
+/*
+ * A rectangle in active area coordinates in pixels of the sensor output frame,
+ * bounded to the frame; null when nothing of it lies inside the frame.
+ */
+Rectangle Af::toOutputFrame(const Rectangle &window) const
+{
+	if (window.isNull() || analogCrop_.isNull() || sensorSize_.isNull())
+		return {};
+
+	auto map = [](int64_t v, int64_t origin, int64_t cropSize, int64_t outSize) {
+		return std::clamp<int64_t>((v - origin) * outSize / cropSize, 0, outSize);
+	};
+	const int64_t x0 = map(window.x, analogCrop_.x, analogCrop_.width, sensorSize_.width);
+	const int64_t y0 = map(window.y, analogCrop_.y, analogCrop_.height, sensorSize_.height);
+	const int64_t x1 = map(static_cast<int64_t>(window.x) + window.width, analogCrop_.x,
+			       analogCrop_.width, sensorSize_.width);
+	const int64_t y1 = map(static_cast<int64_t>(window.y) + window.height, analogCrop_.y,
+			       analogCrop_.height, sensorSize_.height);
+	if (x1 <= x0 || y1 <= y0) {
+		LOG(IPAMtkIsp50Af, Debug) << "AfWindows " << window << " outside the frame, centred region";
+		return {};
+	}
+
+	return Rectangle(x0, y0, x1 - x0, y1 - y0);
+}
+
+void Af::queueRequest(IPAContext &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	if (!enabled_)
+		return;
+
+	const auto &mode = controls.get(controls::AfMode);
+	if (mode && *mode != mode_) {
+		mode_ = static_cast<controls::AfModeEnum>(*mode);
+		state_ = controls::AfStateIdle;
+		fine_ = false;
+		if (mode_ == controls::AfModeContinuous)
+			enterWait(frame);
+		else
+			phase_ = Phase::Idle;
+	}
+
+	if (mode && mode_ != controls::AfModeContinuous) {
+		paused_ = false;
+		pauseDeferred_ = false;
+	}
+
+	/* AfPause: continuous mode only */
+	const auto &pause = controls.get(controls::AfPause);
+	if (pause && mode_ == controls::AfModeContinuous) {
+		switch (*pause) {
+		case controls::AfPauseImmediate:
+			if (phase_ == Phase::Scan || phase_ == Phase::Wait ||
+			    phase_ == Phase::PdWait || phase_ == Phase::PdMove)
+				state_ = controls::AfStateIdle;
+			paused_ = true;
+			pauseDeferred_ = false;
+			phase_ = Phase::Idle;
+			break;
+		case controls::AfPauseDeferred:
+			if (phase_ == Phase::Scan || phase_ == Phase::PdWait ||
+			    phase_ == Phase::PdMove) {
+				pauseDeferred_ = true;
+			} else {
+				paused_ = true;
+				phase_ = Phase::Idle;
+			}
+			break;
+		case controls::AfPauseResume:
+			if (paused_ || pauseDeferred_) {
+				paused_ = false;
+				pauseDeferred_ = false;
+				if (state_ == controls::AfStateFocused || state_ == controls::AfStateFailed) {
+					phase_ = Phase::Monitor;
+					rebase_ = true;
+				} else if (phase_ != Phase::Scan && phase_ != Phase::PdWait &&
+					   phase_ != Phase::PdMove) {
+					enterWait(frame);
+				}
+			}
+			break;
+		}
+	}
+
+	if (mode_ == controls::AfModeManual) {
+		const auto &position = controls.get(controls::LensPosition);
+		if (position)
+			moveLens(context, toCode(*position));
+	}
+
+	/* Focus region: the first AfWindows rectangle with AfMetering Windows */
+	const auto &metering = controls.get(controls::AfMetering);
+	const bool windows = controls.contains(controls::AfWindows.id());
+	if (metering || windows) {
+		const bool wasWindows = meteringWindows_;
+		const Rectangle oldWindow = afWindow_;
+		if (metering)
+			meteringWindows_ = *metering == controls::AfMeteringWindows;
+		if (windows) {
+			Rectangle window;
+			if (readWindow(controls.get(controls::AfWindows.id()), &window))
+				afWindow_ = toOutputFrame(window);
+		}
+		const bool useWindows = meteringWindows_ && !afWindow_.isNull();
+		const bool changed = useWindows != (wasWindows && !oldWindow.isNull()) ||
+				     (useWindows && afWindow_ != oldWindow);
+
+		/*
+		 * A new region in continuous mode: focus again. PD results of
+		 * frames before this one are of the old region.
+		 */
+		if (changed && mode_ == controls::AfModeContinuous && phase_ != Phase::Idle && !paused_) {
+			fine_ = false;
+			pdJumps_ = 0;
+			enterWait(frame);
+			state_ = controls::AfStateScanning;
+		} else if (changed) {
+			pdFrom_ = frame;
+			pdCount_ = 0;
+			pdWindow_ = kPdAnyWindow;
+		}
+	}
+
+	if (mode_ == controls::AfModeAuto) {
+		const auto &trigger = controls.get(controls::AfTrigger);
+		if (trigger && *trigger == controls::AfTriggerStart) {
+			if (pdActive_) {
+				/* Wait for a PD result of the frames from this one */
+				phase_ = Phase::PdWait;
+				state_ = controls::AfStateScanning;
+				scanStart_ = frame_;
+				pdJumps_ = 0;
+				pdBiasMoves_ = 0;
+				pdFrom_ = frame;
+				pdCount_ = 0;
+				pdMisses_ = 0;
+				pdWindow_ = kPdAnyWindow;
+				fine_ = false;
+			} else {
+				startScan(context);
+			}
+		} else if (trigger && *trigger == controls::AfTriggerCancel &&
+			   (phase_ == Phase::Scan || phase_ == Phase::PdWait ||
+			    phase_ == Phase::PdMove)) {
+			phase_ = Phase::Idle;
+			state_ = controls::AfStateIdle;
+			fine_ = false;
+		}
+	}
+}
+
+/*
+ * The focus grid costs CPU time: it is gathered in every frame with
+ * statistics while waiting for a steady scene and while searching, in every
+ * monitorInterval-th one while watching for a scene change, and not at all
+ * otherwise. The PD statistics are cheap: every frame unless idle.
+ */
+void Af::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext, DipFrameParams *params)
+{
+	if (!enabled_)
+		return;
+
+	lastPrepared_ = std::max(lastPrepared_, frame);
+
+	/* The focus grid in every frame while waiting or searching */
+	const bool searching = phase_ == Phase::Scan || phase_ == Phase::PdWait ||
+			       phase_ == Phase::PdMove;
+	const bool measuring = phase_ == Phase::Wait || searching;
+	context.activeState.af.busy = searching || (phase_ == Phase::Wait && !dark_);
+	params->afStatsInterval = measuring ? 1 : phase_ == Phase::Monitor ? monitorInterval_ : 0;
+	params->afEveryFrame = measuring;
+
+	auto frac = [](int64_t v, unsigned int size) {
+		return static_cast<uint16_t>(std::clamp<int64_t>(v * 65535 / size, 0, 65535));
+	};
+
+	const bool windows = meteringWindows_ && !afWindow_.isNull() &&
+			     sensorSize_.width && sensorSize_.height;
+	if (windows) {
+		params->afRegionMode = 1;
+		params->afRegion = { frac(afWindow_.x, sensorSize_.width), frac(afWindow_.y, sensorSize_.height),
+				     frac(afWindow_.width, sensorSize_.width),
+				     frac(afWindow_.height, sensorSize_.height) };
+	} else {
+		const uint16_t r = static_cast<uint16_t>(std::lround(region_ * 65535));
+		params->afRegionMode = 0;
+		params->afRegion = { 0, 0, r, r };
+	}
+
+	/* PD in every frame, also idle (the result goes to the log) */
+	params->pd = pdActive_;
+	if (!params->pd)
+		return;
+
+	/*
+	 * PD region: around the AfWindows rectangle, at least tapSize of the
+	 * frame, else the centred PD region
+	 */
+	Rectangle pd;
+	if (windows) {
+		const unsigned int w = std::max<unsigned int>(afWindow_.width,
+							      std::lround(pdTapSize_ * sensorSize_.width));
+		const unsigned int h = std::max<unsigned int>(afWindow_.height,
+							      std::lround(pdTapSize_ * sensorSize_.height));
+		const Point c = afWindow_.center();
+		pd = Rectangle(c.x - static_cast<int>(w / 2), c.y - static_cast<int>(h / 2), w, h)
+			     .enclosedIn(Rectangle(sensorSize_));
+		if (pd.width < w || pd.height < h) {
+			/* Shifted inside the frame, not cut */
+			const int x = std::clamp<int>(c.x - static_cast<int>(w / 2), 0,
+						      static_cast<int>(sensorSize_.width) - static_cast<int>(w));
+			const int y = std::clamp<int>(c.y - static_cast<int>(h / 2), 0,
+						      static_cast<int>(sensorSize_.height) - static_cast<int>(h));
+			pd = Rectangle(x, y, std::min(w, sensorSize_.width), std::min(h, sensorSize_.height));
+		}
+	} else {
+		const unsigned int w = std::lround(pdRegion_ * sensorSize_.width);
+		const unsigned int h = std::lround(pdRegion_ * sensorSize_.height);
+		pd = Rectangle((sensorSize_.width - w) / 2, (sensorSize_.height - h) / 2, w, h);
+	}
+
+	params->pdRegion = { frac(pd.x, sensorSize_.width), frac(pd.y, sensorSize_.height),
+			     frac(pd.width, sensorSize_.width), frac(pd.height, sensorSize_.height) };
+	params->pdGridWidth = pdGridWidth_;
+	params->pdGridHeight = pdGridHeight_;
+	params->pdMaxShift = pdMaxShift_;
+	/* The black level is on an 8 bit scale, the PD samples have 10 bits */
+	params->pdBlackLevel = context.activeState.blc.level * 4;
+}
+
+/*
+ * The lens target of a PD frame: all windows together if they are reliable,
+ * else the most reliable window. Not valid for results below the confidence
+ * or the level, or with a target far outside the scan range.
+ */
+Af::PdEstimate Af::pdEstimate(const Statistics &stats) const
+{
+	PdEstimate est;
+
+	/*
+	 * Windows at different distances blur the result of all of them:
+	 * then the reliable window nearest to the centre of the region, the
+	 * more reliable of those as far from it.
+	 */
+	const Statistics::PdWindow *best = nullptr;
+	int index = -1;
+	const int windows = stats.pdGridWidth * stats.pdGridHeight;
+	if (pdWindow_ != kPdAnyWindow) {
+		/* Kept to one window */
+		index = pdWindow_;
+		if (index < windows)
+			best = index < 0 ? &stats.pdRegion : &stats.pdWindows[index];
+		if (best && best->confidence < pdMinConfidence_)
+			best = nullptr;
+	} else if (stats.pdRegion.confidence >= pdMinConfidence_) {
+		best = &stats.pdRegion;
+	} else {
+		const double cx = (stats.pdGridWidth - 1) / 2.0;
+		const double cy = (stats.pdGridHeight - 1) / 2.0;
+		auto ring = [&](unsigned int i) {
+			return std::ceil(std::hypot(i % stats.pdGridWidth - cx,
+						    i / stats.pdGridWidth - cy) - 0.01);
+		};
+		double bestScore = 0.0;
+		for (unsigned int i = 0; i < stats.pdGridWidth * stats.pdGridHeight; i++) {
+			const Statistics::PdWindow &w = stats.pdWindows[i];
+			if (w.confidence < pdMinConfidence_)
+				continue;
+			const double score = w.confidence - 1000.0 * ring(i);
+			if (!best || score > bestScore) {
+				best = &w;
+				bestScore = score;
+				index = i;
+			}
+		}
+
+		/* The window of the results so far, while it is as good a choice */
+		const int t = pdTrackWindow_;
+		if (best && pdCount_ && t >= 0 && t < windows && t != index &&
+		    stats.pdWindows[t].confidence >= pdMinConfidence_ && ring(t) <= ring(index)) {
+			best = &stats.pdWindows[t];
+			index = t;
+		}
+	}
+
+	if (!best || best->level < pdMinLevel_)
+		return est;
+
+	const double target = lensCode_ + pdSlope_ * (best->shift - pdOffset_);
+	if (target < toCode(rangeMin_) - pdMargin_ || target > toCode(rangeMax_) + pdMargin_)
+		return est;
+
+	est.valid = true;
+	est.window = index;
+	est.shift = best->shift;
+	est.confidence = best->confidence;
+	est.target = std::clamp<int32_t>(std::lround(target), lensMin_, lensMax_);
+
+	return est;
+}
+
+/* Reliable results in a row whose targets agree */
+void Af::trackPd(const PdEstimate &est)
+{
+	if (!est.valid) {
+		pdCount_ = 0;
+		return;
+	}
+
+	pdLastReliable_ = frame_;
+
+	if (pdCount_ && est.window == pdTrackWindow_ &&
+	    std::abs(est.target - pdTarget_) <= pdAgreement_) {
+		pdTarget_ = (pdTarget_ * pdCount_ + est.target) / (pdCount_ + 1);
+		pdCount_++;
+	} else {
+		pdTarget_ = est.target;
+		pdTrackWindow_ = est.window;
+		pdCount_ = 1;
+	}
+
+	if (phase_ != Phase::Monitor)
+		return;
+
+	/* The reference: the mean of the first results after focusing */
+	if (!pdRefValid_) {
+		if (pdRefCount_ && est.window != pdRefWindow_) {
+			pdRefCount_ = 0;
+			pdRefSum_ = 0.0;
+		}
+		pdRefWindow_ = est.window;
+		pdRefSum_ += est.target;
+		if (++pdRefCount_ >= kPdRefFrames) {
+			pdRef_ = pdRefSum_ / pdRefCount_;
+			pdRefValid_ = true;
+			pdWindow_ = pdRefWindow_;
+			pdRefChecked_ = false;
+			pdVariance_ = pdDeadband_ * pdDeadband_ / 4.0;
+			pdOut_ = 0;
+			LOG(IPAMtkIsp50Af, Debug)
+				<< "PD reference " << pdRef_ << " at lens " << lensCode_
+				<< ", window " << pdWindow_;
+		}
+		return;
+	}
+
+	/*
+	 * Within the deadband, or within three times the spread of the
+	 * results in focus: in focus, the reference follows slowly. Beyond
+	 * it: count the results in a row on the same side.
+	 */
+	const double dev = est.target - pdRef_;
+	const double limit = std::max<double>(pdDeadband_, 3.0 * std::sqrt(pdVariance_));
+	if (std::abs(dev) <= limit) {
+		pdInFocus_ = frame_;
+		pdSeenInFocus_ = true;
+		pdOut_ = 0;
+		pdRef_ += 0.05 * dev;
+		pdVariance_ = 0.9 * pdVariance_ + 0.1 * dev * dev;
+		return;
+	}
+
+	const int side = dev > 0 ? 1 : -1;
+	if (!pdOut_ || side != pdOutSide_) {
+		pdOut_ = 0;
+		pdOutSum_ = 0.0;
+	}
+	pdOutSide_ = side;
+	pdOut_++;
+	pdOutSum_ += dev;
+}
+
+/* A PD result in focus not long ago: the contrast watch stays off */
+bool Af::pdHolds() const
+{
+	return pdActive_ && pdSeenInFocus_ && frame_ - pdInFocus_ <= pdHoldFrames_;
+}
+
+/* Wait for a steady scene (continuous mode), PD results from @from on */
+void Af::enterWait(uint32_t from)
+{
+	pdBiasMoves_ = 0;
+	pdMisses_ = 0;
+	pdWindow_ = kPdAnyWindow;
+	phase_ = Phase::Wait;
+	levelIndex_ = 0;
+	exposureWait_ = 0;
+	waitCount_ = 0;
+	steadyCount_ = 0;
+	pdFrom_ = from;
+	pdCount_ = 0;
+	pdJumps_ = 0;
+}
+
+/* A search with an agreeing PD target: move there, or refine where it is */
+void Af::pdStart(IPAContext &context)
+{
+	const int32_t target = std::lround(pdTarget_);
+
+	if (phase_ != Phase::PdWait)
+		scanStart_ = frame_;
+	state_ = controls::AfStateScanning;
+	pdJumps_ = 0;
+	pdWindow_ = pdTrackWindow_;
+
+	if (std::abs(target - lensCode_) > pdDeadband_)
+		pdJump(context, target);
+	else
+		startFine(context);
+}
+
+void Af::pdJump(IPAContext &context, int32_t target)
+{
+	LOG(IPAMtkIsp50Af, Debug)
+		<< "PD move " << lensCode_ << " -> " << target
+		<< " (" << pdCount_ << " results)";
+
+	pdJumps_++;
+	pdCount_ = 0;
+	phase_ = Phase::PdMove;
+	state_ = controls::AfStateScanning;
+	moveLens(context, target);
+	pdFrom_ = moveFrame_ + settleFrames_;
+}
+
+/* Contrast search in a small range around the lens position */
+void Af::startFine(IPAContext &context)
+{
+	fineCenter_ = lensCode_;
+
+	if (!pdFineRange_) {
+		fine_ = true;
+		const AfMeasurement none{ -1.0, 0.0 };
+		endScan(context, AfSearch::Result::Failed, none);
+		return;
+	}
+
+	AfSearch::Config config;
+	config.min = std::max(lensMin_, lensCode_ - pdFineRange_);
+	config.max = std::min(lensMax_, lensCode_ + pdFineRange_);
+	config.step = pdFineStep_;
+	config.climb = true;
+	config.near = true;
+	config.start = lensCode_;
+	config.peakDrop = 0.85;
+	config.minContrast = 1.02;
+
+	search_.start(config);
+	phase_ = Phase::Scan;
+	state_ = controls::AfStateScanning;
+	fine_ = true;
+	moveLens(context, search_.target());
+
+	LOG(IPAMtkIsp50Af, Debug) << "Fine search " << config.min << "-" << config.max
+				  << " step " << config.step;
+}
+
+/*
+ * The PD part of a frame with PD statistics. Returns true when it decided
+ * the frame (a lens move, or waiting for the next PD result).
+ */
+bool Af::processPd(IPAContext &context, const PdEstimate &est)
+{
+	switch (phase_) {
+	case Phase::Wait:
+	case Phase::PdWait:
+		if (est.valid && pdCount_ >= pdStartFrames_) {
+			pdStart(context);
+			return true;
+		}
+		return false;
+
+	case Phase::PdMove:
+		if (est.valid && pdCount_ >= pdStartFrames_ &&
+		    std::abs(pdTarget_ - lensCode_) > pdDeadband_ && pdJumps_ < pdMaxJumps_) {
+			pdJump(context, std::lround(pdTarget_));
+			return true;
+		}
+		if (est.valid && pdCount_ < pdStartFrames_ &&
+		    std::abs(est.target - lensCode_) > pdDeadband_)
+			return true;
+		if (est.valid) {
+			startFine(context);
+			return true;
+		}
+		return false;
+
+	case Phase::Monitor:
+		if (!est.valid || !pdRefValid_)
+			return false;
+
+		/*
+		 * Focused further from the PD target than PD and contrast
+		 * differ otherwise (a contrast search on a weak peak, or a PD
+		 * move on noise): once to the PD target.
+		 */
+		if (!pdRefChecked_) {
+			pdRefChecked_ = true;
+			if (std::abs(pdRef_ - lensCode_) > pdMaxBias_ && pdBiasMoves_ < 1) {
+				LOG(IPAMtkIsp50Af, Debug)
+					<< "Focused at " << lensCode_ << ", PD target " << pdRef_;
+				pdBiasMoves_++;
+				scanStart_ = frame_;
+				pdJumps_ = 0;
+				pdJump(context, std::lround(pdRef_));
+				return true;
+			}
+		}
+
+		if (pdOut_ >= pdConfirmFrames_) {
+			const int32_t target = std::clamp<int32_t>(
+				lensCode_ + std::lround(pdOutSum_ / pdOut_), lensMin_, lensMax_);
+			LOG(IPAMtkIsp50Af, Debug)
+				<< "PD out of focus (" << pdOutSum_ / pdOut_ << " from " << pdRef_
+				<< " over " << pdOut_ << " frames), refocus";
+			scanStart_ = frame_;
+			pdJumps_ = 0;
+			pdOut_ = 0;
+			pdJump(context, target);
+			return true;
+		}
+		return false;
+
+	case Phase::Idle:
+	case Phase::Scan:
+		break;
+	}
+
+	return false;
+}
+
+/* PD results of a frame for the log: all windows together, then each */
+static std::string pdText(const Statistics &stats)
+{
+	std::ostringstream o;
+	o.setf(std::ios::fixed);
+	o.precision(2);
+	o << " pd " << stats.pdRegion.shift << "/" << static_cast<int>(stats.pdRegion.confidence)
+	  << " level " << static_cast<int>(stats.pdRegion.level) << " win";
+	for (unsigned int i = 0; i < stats.pdGridWidth * stats.pdGridHeight; i++)
+		o << " " << stats.pdWindows[i].shift << "/"
+		  << static_cast<int>(stats.pdWindows[i].confidence);
+	return o.str();
+}
+
+void Af::process(IPAContext &context, const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const Statistics *stats,
+		 ControlList &metadata)
+{
+	if (!enabled_)
+		return;
+
+	frame_ = frame;
+
+	metadata.set(controls::AfMode, mode_);
+	metadata.set(controls::AfState, state_);
+	if (mode_ == controls::AfModeContinuous)
+		metadata.set(controls::AfPauseState,
+			     paused_ ? controls::AfPauseStatePaused
+			     : pauseDeferred_ ? controls::AfPauseStatePausing
+					      : controls::AfPauseStateRunning);
+	metadata.set(controls::LensPosition,
+		     static_cast<float>(std::max(toDioptres(lensCode_), 0.0)));
+
+	if (phase_ == Phase::Idle) {
+		if (pdActive_ && stats->pdValid)
+			LOG(IPAMtkIsp50Af, Debug)
+				<< "frame " << frame << " lens " << lensCode_ << " idle" << pdText(*stats);
+		return;
+	}
+
+	if (stats->valid && (!stats->afGridWidth || !stats->afGridHeight)) {
+		LOG(IPAMtkIsp50Af, Warning) << "No focus statistics, autofocus off";
+		enabled_ = false;
+		return;
+	}
+
+	/* Statistics exposed while the lens was still moving */
+	if (moved_ && frame < moveFrame_ + settleFrames_)
+		return;
+
+	/* Phase detection of this frame, of the current region */
+	if (pdActive_ && stats->pdValid && frame >= pdFrom_) {
+		const PdEstimate est = pdEstimate(*stats);
+		trackPd(est);
+		pdMisses_ = est.valid ? 0 : pdMisses_ + 1;
+
+		LOG(IPAMtkIsp50Af, Debug)
+			<< "frame " << frame << " lens " << lensCode_
+			<< (est.valid ? " target " + std::to_string(est.target) : std::string(" unreliable"))
+			<< " count " << pdCount_ << pdText(*stats);
+
+		if (processPd(context, est))
+			return;
+	}
+
+	/* Frame without the focus grid (not requested, see prepare()) */
+	if (!stats->afGridValid || !stats->afGridWidth || !stats->afGridHeight)
+		return;
+
+	/* The grid covers the focus region: measure all of it */
+	const AfMeasurement m = afMeasure(stats->afGrid.data(), stats->afGridWidth,
+					  stats->afGridHeight, stats->afCellSamples,
+					  context.activeState.blc.level, 1.0);
+
+	const bool exposureSteady = !context.activeState.agc.converging;
+
+	LOG(IPAMtkIsp50Af, Debug)
+		<< "frame " << frame << " lens " << lensCode_
+		<< " sharpness " << m.sharpness << " level " << m.level
+		<< (exposureSteady ? "" : " (exposure moving)");
+
+	/*
+	 * PD gets the first frames of a search, the contrast search follows;
+	 * at once when PD frames come and none of them is reliable
+	 */
+	const bool pdTurn = pdActive_ && frame < pdFrom_ + pdWaitFrames_ &&
+			    pdMisses_ < pdStartFrames_;
+
+	switch (phase_) {
+	case Phase::Idle:
+		break;
+
+	case Phase::PdWait:
+		if (!pdTurn)
+			startScan(context);
+		break;
+
+	case Phase::PdMove:
+		/* No reliable PD result at the target: refine there by contrast */
+		if (!pdTurn)
+			startFine(context);
+		break;
+
+	case Phase::Wait: {
+		/*
+		 * Let exposure settle and the scene calm down before a scan. A
+		 * scene too dark to measure keeps the lens where it is. While
+		 * the exposure still moves the sharpness measure is not
+		 * comparable between frames (noise at low levels), the scan
+		 * waits for it, but not forever (flicker may keep it moving).
+		 */
+		if (m.sharpness < 0.0) {
+			steadyCount_ = 0;
+			waitCount_ = 0;
+			dark_ = true;
+			context.activeState.af.busy = false;
+			break;
+		}
+		dark_ = false;
+
+		/*
+		 * While the exposure moves, the level must also be steady over
+		 * the last kLevelHistory samples: a slow ramp passes the check
+		 * between neighbouring frames.
+		 */
+		const double oldLevel = levelHistory_[levelIndex_ % kLevelHistory];
+		const bool drifting = !exposureSteady && levelIndex_ >= kLevelHistory &&
+				      oldLevel > 0.0 && std::abs(m.level / oldLevel - 1.0) >= kSteadyLevel;
+		levelHistory_[levelIndex_++ % kLevelHistory] = m.level;
+
+		const bool steady = m.sharpness >= 0.0 && lastLevel_ > 0.0 &&
+				    lastSharpness_ > 0.0 && !drifting &&
+				    std::abs(m.level / lastLevel_ - 1.0) < kSteadyLevel &&
+				    std::abs(m.sharpness / lastSharpness_ - 1.0) < kSteadySharpness;
+
+		steadyCount_ = steady ? steadyCount_ + 1 : 0;
+		lastLevel_ = m.level;
+		lastSharpness_ = m.sharpness;
+
+		/* The PD search has its turn first */
+		if (pdTurn)
+			break;
+
+		if (drifting) {
+			/* Not forever: flicker may keep the exposure moving */
+			if (++exposureWait_ >= kMaxExposureWait)
+				startScan(context);
+		} else if (steadyCount_ >= 2 || ++waitCount_ >= kMaxWait) {
+			startScan(context);
+		}
+		break;
+	}
+
+	case Phase::Scan: {
+		if (m.sharpness < 0.0) {
+			/* Too dark to measure */
+			endScan(context, AfSearch::Result::Failed, m);
+			break;
+		}
+
+		const AfSearch::Result result = search_.update(m.sharpness);
+		if (result == AfSearch::Result::Move)
+			moveLens(context, search_.target());
+		else
+			endScan(context, result, m);
+		break;
+	}
+
+	case Phase::Monitor:
+		if (pdHolds()) {
+			/*
+			 * PD sees the subject in focus: no search from the
+			 * contrast; its reference follows the scene.
+			 */
+			changeCount_ = 0;
+			rebase_ = true;
+			break;
+		}
+		monitor(m, exposureSteady, pdActive_ && pdSeenInFocus_);
+		break;
+	}
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::mtkisp50::algorithms */
+
+} /* namespace libcamera */
