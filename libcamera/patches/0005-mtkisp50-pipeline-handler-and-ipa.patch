+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Phase detection data of the mtkisp50 pipeline
+ */
+
+#include "pd.h"
+
+#include <algorithm>
+#include <cmath>
+#include <numeric>
+
+#include <linux/media-bus-format.h>
+
+namespace libcamera {
+
+using namespace mtkisp50;
+
+namespace {
+
+/*
+ * OV64B40: in the 4624x3472 mode the sensor sends its PD pixels on virtual
+ * channel 1 next to the image, RAW10, 1136 samples per line and 860 lines.
+ * Pattern as described by the GPL sensor driver of the vendor kernel: blocks
+ * of 16 x 16 pixels from (40, 16), 284 x 215 blocks, in each block 8 pairs of
+ * a right and a left pixel, the left one at x + 1. A line holds one of the
+ * four pixel rows with pairs of all blocks of a block row, right and left in
+ * turn.
+ */
+const MtkIsp50PdLayout kLayouts[] = {
+	{
+		.model = "ov64b40",
+		.sensorSize = { 4624, 3472 },
+		.stream = 1,
+		.mbusCode = MEDIA_BUS_FMT_Y10_1X10,
+		.size = { 1136, 860 },
+		.bitDepth = 10,
+		.offset = { 40, 16 },
+		.block = 16,
+		.blocks = { 284, 215 },
+		.rowY = { 18, 22, 26, 30 },
+		.pairX = { { 46, 54 }, { 42, 50 }, { 46, 54 }, { 42, 50 } },
+		.leftOffset = 1,
+	},
+};
+
+/*
+ * Each pattern position along x keeps a slow pattern of its own (it moves
+ * with the shading and the pixel kind, not with the scene) that matches at no
+ * shift and at whole blocks: it is taken out with a running mean over this
+ * many blocks.
+ */
+constexpr unsigned int kTrendBlocks = 9;
+
+/*
+ * Confidence: the depth of the match minimum against the median of the match
+ * curve, relative to the minimum (the noise left at the best match). Full
+ * confidence at this depth.
+ */
+constexpr double kFullDepth = 1.0;
+
+} /* namespace */
+
+const MtkIsp50PdLayout *MtkIsp50PdLayout::find(const std::string &model, const Size &sensorSize)
+{
+	for (const MtkIsp50PdLayout &layout : kLayouts) {
+		if (layout.model == model && layout.sensorSize == sensorSize)
+			return &layout;
+	}
+
+	return nullptr;
+}
+
+bool MtkIsp50PdLayout::known(const std::string &model)
+{
+	return std::any_of(std::begin(kLayouts), std::end(kLayouts),
+			   [&](const MtkIsp50PdLayout &l) { return l.model == model; });
+}
+
+unsigned int MtkIsp50PdLayout::samplesPerLine() const
+{
+	return blocks.width * pairsPerLine() * 2;
+}
+
+MtkIsp50PdStats::MtkIsp50PdStats(const MtkIsp50PdLayout &layout)
+	: layout_(layout)
+{
+	/* The profile positions: the right pixel x of all lines, in order */
+	std::vector<unsigned int> xs;
+	for (const auto &line : layout.pairX)
+		xs.insert(xs.end(), line.begin(), line.end());
+	std::sort(xs.begin(), xs.end());
+	xs.erase(std::unique(xs.begin(), xs.end()), xs.end());
+
+	positions_ = xs.size();
+	pitch_ = positions_ ? static_cast<double>(layout.block) / positions_ : 1.0;
+
+	position_.clear();
+	for (const auto &line : layout.pairX) {
+		std::vector<unsigned int> pos;
+		for (unsigned int x : line)
+			pos.push_back(std::find(xs.begin(), xs.end(), x) - xs.begin());
+		position_.push_back(pos);
+	}
+
+	/* A sample this close to the top counts as saturated */
+	saturation_ = ((1u << layout.bitDepth) - 1) * 1000 / 1023;
+}
+
+void MtkIsp50PdStats::unpackLine(const uint8_t *line, unsigned int samples, uint16_t *out)
+{
+	for (unsigned int i = 0; i + 4 <= samples; i += 4, line += 5) {
+		out[i] = line[0] | ((line[1] & 0x03) << 8);
+		out[i + 1] = (line[1] >> 2) | ((line[2] & 0x0f) << 6);
+		out[i + 2] = (line[2] >> 4) | ((line[3] & 0x3f) << 4);
+		out[i + 3] = (line[3] >> 6) | (line[4] << 2);
+	}
+}
+
+std::vector<Rectangle> MtkIsp50PdStats::windows(const MtkIsp50PdConfig &config) const
+{
+	const Size &s = layout_.sensorSize;
+	auto px = [](uint16_t frac, unsigned int size) {
+		return static_cast<int64_t>(frac) * size / 65536;
+	};
+
+	const int64_t x = px(config.region[0], s.width);
+	const int64_t y = px(config.region[1], s.height);
+	const int64_t w = px(config.region[2], s.width);
+	const int64_t h = px(config.region[3], s.height);
+	const unsigned int nx = std::max(1u, config.gridWidth);
+	const unsigned int ny = std::max(1u, config.gridHeight);
+
+	std::vector<Rectangle> wins;
+	for (unsigned int j = 0; j < ny; j++) {
+		for (unsigned int i = 0; i < nx; i++)
+			wins.emplace_back(x + i * w / nx, y + j * h / ny,
+					  static_cast<unsigned int>(w / nx),
+					  static_cast<unsigned int>(h / ny));
+	}
+
+	return wins;
+}
+
+void MtkIsp50PdStats::profile(const std::vector<uint16_t> &lines, unsigned int bx0,
+			      unsigned int bx1, unsigned int by0, unsigned int by1,
+			      unsigned int blackLevel, Profile *p) const
+{
+	const unsigned int n = (bx1 - bx0) * positions_;
+	const unsigned int perLine = layout_.samplesPerLine();
+	const unsigned int linesPerBlock = layout_.linesPerBlock();
+	const unsigned int pairs = layout_.pairsPerLine();
+
+	std::vector<double> sumL(n, 0.0), sumR(n, 0.0);
+	std::vector<unsigned int> count(n, 0);
+
+	for (unsigned int by = by0; by < by1; by++) {
+		for (unsigned int k = 0; k < linesPerBlock; k++) {
+			const uint16_t *line = &lines[(by * linesPerBlock + k) * perLine];
+			const std::vector<unsigned int> &pos = position_[k];
+
+			for (unsigned int bx = bx0; bx < bx1; bx++) {
+				const uint16_t *s = line + bx * pairs * 2;
+				for (unsigned int q = 0; q < pairs; q++) {
+					const unsigned int right = s[2 * q];
+					const unsigned int left = s[2 * q + 1];
+					const unsigned int i = (bx - bx0) * positions_ + pos[q];
+
+					sumR[i] += right;
+					sumL[i] += left;
+					count[i]++;
+					p->sum += right + left;
+					p->samples += 2;
+					p->saturated += (right >= saturation_) + (left >= saturation_);
+				}
+			}
+		}
+	}
+
+	p->left.resize(n);
+	p->right.resize(n);
+	for (unsigned int i = 0; i < n; i++) {
+		const double c = std::max(count[i], 1u);
+		p->left[i] = std::max(sumL[i] / c - blackLevel, 0.0);
+		p->right[i] = std::max(sumR[i] / c - blackLevel, 0.0);
+	}
+	p->sum -= static_cast<double>(blackLevel) * p->samples;
+}
+
+/* Samples k, k + positions_, ... to their mean, then less their running mean */
+void MtkIsp50PdStats::normalise(std::vector<double> *profile, unsigned int k) const
+{
+	std::vector<double> &p = *profile;
+	std::vector<double> q;
+	for (unsigned int j = k; j < p.size(); j += positions_)
+		q.push_back(p[j]);
+	if (q.empty())
+		return;
+
+	const double mean = std::max(std::accumulate(q.begin(), q.end(), 0.0) / q.size(), 1e-6);
+	for (double &v : q)
+		v /= mean;
+
+	/* Running mean, the ends repeated */
+	const int half = kTrendBlocks / 2;
+	const int m = q.size();
+	std::vector<double> out(m);
+	for (int j = 0; j < m; j++) {
+		double sum = 0.0;
+		for (int t = j - half; t <= j + half; t++)
+			sum += q[std::clamp(t, 0, m - 1)];
+		out[j] = q[j] - sum / kTrendBlocks;
+	}
+
+	for (int j = 0; j < m; j++)
+		p[k + j * positions_] = out[j];
+}
+
+MtkIsp50PdStats::Match MtkIsp50PdStats::match(const Profile &p, unsigned int maxShift)
+{
+	Match m;
+	const unsigned int n = p.left.size();
+
+	if (n < 2 * maxShift + 8)
+		return m;
+
+	m.sad.assign(2 * maxShift + 1, 0.0);
+
+	const unsigned int lo = maxShift;
+	const unsigned int hi = n - maxShift;
+
+	for (unsigned int d = 0; d < m.sad.size(); d++) {
+		double sum = 0.0;
+		const int off = static_cast<int>(d) - static_cast<int>(maxShift);
+		for (unsigned int i = lo; i < hi; i++)
+			sum += std::abs(p.left[i + off] - p.right[i]);
+		m.sad[d] = sum / (hi - lo);
+	}
+
+	double contrast = 0.0;
+	for (unsigned int i = lo; i + 1 < hi; i++)
+		contrast += std::abs(p.right[i + 1] - p.right[i]);
+	m.contrast = contrast / (hi - lo - 1);
+	m.valid = true;
+
+	return m;
+}
+
+void MtkIsp50PdStats::result(const std::vector<double> &sad, double contrast,
+			     double saturation, double level, StatsPdWindow *w) const
+{
+	w->shift = 0.0f;
+	w->confidence = 0.0f;
+	w->curvature = 0.0f;
+	w->contrast = contrast;
+	w->saturation = saturation;
+	w->level = level;
+
+	if (sad.size() < 3)
+		return;
+
+	const int maxShift = (sad.size() - 1) / 2;
+	const unsigned int i = std::min_element(sad.begin(), sad.end()) - sad.begin();
+	double frac = 0.0;
+	double curv = 0.0;
+	if (i > 0 && i + 1 < sad.size()) {
+		const double y0 = sad[i - 1], y1 = sad[i], y2 = sad[i + 1];
+		const double den = y0 - 2 * y1 + y2;
+		if (den > 0.0) {
+			frac = 0.5 * (y0 - y2) / den;
+			curv = den;
+		}
+	}
+
+	std::vector<double> sorted = sad;
+	std::nth_element(sorted.begin(), sorted.begin() + sorted.size() / 2, sorted.end());
+	const double median = sorted[sorted.size() / 2];
+	const double depth = (median - sad[i]) / std::max(sad[i], 1e-9);
+
+	double c = 100.0 * std::clamp(depth / kFullDepth, 0.0, 1.0) *
+		   std::max(0.0, 1.0 - 4.0 * saturation);
+	if (curv <= 0.0)
+		c *= 0.25;
+
+	const double d = static_cast<double>(static_cast<int>(i) - maxShift) + frac;
+	w->shift = static_cast<float>(-pitch_ * d - layout_.leftOffset);
+	w->confidence = static_cast<float>(std::round(c));
+	w->curvature = static_cast<float>(curv);
+}
+
+bool MtkIsp50PdStats::compute(const uint8_t *data, size_t length, unsigned int stride,
+			      const MtkIsp50PdConfig &config, StatsBuffer *out)
+{
+	out->valid &= ~StatsValidPd;
+	out->pdGridWidth = 0;
+	out->pdGridHeight = 0;
+
+	const unsigned int perLine = layout_.samplesPerLine();
+	const unsigned int lineBytes = (perLine * layout_.bitDepth + 7) / 8;
+	const unsigned int height = layout_.size.height;
+	if (!positions_ || perLine != layout_.size.width || stride < lineBytes ||
+	    length < static_cast<size_t>(stride) * (height - 1) + lineBytes)
+		return false;
+
+	const std::vector<Rectangle> wins = windows(config);
+	if (wins.empty() || wins.size() > StatsBuffer::kMaxPdWindows)
+		return false;
+
+	/* Blocks of a window, bounded to the pattern */
+	struct Blocks {
+		unsigned int bx0, bx1, by0, by1;
+	};
+	auto blocksOf = [&](const Rectangle &r) {
+		const int64_t b = layout_.block;
+		auto lowBlock = [&](int64_t v, int64_t origin, unsigned int count) {
+			return static_cast<unsigned int>(std::clamp<int64_t>((v - origin) / b, 0, count));
+		};
+		auto highBlock = [&](int64_t v, int64_t origin, unsigned int count) {
+			return static_cast<unsigned int>(std::clamp<int64_t>((v - origin + b - 1) / b, 0, count));
+		};
+		return Blocks{ lowBlock(r.x, layout_.offset.x, layout_.blocks.width),
+			       highBlock(r.x + static_cast<int64_t>(r.width), layout_.offset.x,
+					 layout_.blocks.width),
+			       lowBlock(r.y, layout_.offset.y, layout_.blocks.height),
+			       highBlock(r.y + static_cast<int64_t>(r.height), layout_.offset.y,
+					 layout_.blocks.height) };
+	};
+
+	/* Unpack the lines of the block rows the windows cover */
+	unsigned int byMin = layout_.blocks.height, byMax = 0;
+	for (const Rectangle &r : wins) {
+		const Blocks b = blocksOf(r);
+		byMin = std::min(byMin, b.by0);
+		byMax = std::max(byMax, b.by1);
+	}
+
+	const unsigned int linesPerBlock = layout_.linesPerBlock();
+	lines_.resize(static_cast<size_t>(perLine) * height);
+	for (unsigned int line = byMin * linesPerBlock;
+	     line < std::min(byMax * linesPerBlock, height); line++)
+		unpackLine(data + static_cast<size_t>(line) * stride, perLine,
+			   &lines_[static_cast<size_t>(line) * perLine]);
+
+	const unsigned int maxShift = std::max(1u, config.maxShift);
+	std::vector<double> total(2 * maxShift + 1, 0.0);
+	unsigned int matched = 0;
+	double contrastSum = 0.0, levelSum = 0.0, saturationMax = 0.0;
+
+	for (unsigned int i = 0; i < wins.size(); i++) {
+		const Rectangle &r = wins[i];
+		StatsPdWindow &w = out->pd[i];
+		w = {};
+		w.x = r.x;
+		w.y = r.y;
+		w.width = r.width;
+		w.height = r.height;
+
+		const Blocks b = blocksOf(r);
+		if (b.bx1 <= b.bx0 || b.by1 <= b.by0)
+			continue;
+
+		Profile p;
+		profile(lines_, b.bx0, b.bx1, b.by0, b.by1, config.blackLevel, &p);
+
+		/*
+		 * Each pattern position to its mean (shading, pixel gains),
+		 * then without its running mean along x
+		 */
+		for (unsigned int k = 0; k < positions_; k++) {
+			normalise(&p.left, k);
+			normalise(&p.right, k);
+		}
+
+		const double saturation = p.samples ? static_cast<double>(p.saturated) / p.samples : 0.0;
+		const double level = p.samples ? p.sum / p.samples : 0.0;
+
+		const Match m = match(p, maxShift);
+		if (!m.valid) {
+			w.saturation = saturation;
+			w.level = level;
+			continue;
+		}
+
+		result(m.sad, m.contrast, saturation, level, &w);
+
+		for (unsigned int d = 0; d < total.size(); d++)
+			total[d] += m.sad[d];
+		matched++;
+		contrastSum += m.contrast;
+		levelSum += level;
+		saturationMax = std::max(saturationMax, saturation);
+	}
+
+	/* All windows together: the mean of their match curves */
+	StatsPdWindow &all = out->pdRegion;
+	all = {};
+	if (!wins.empty()) {
+		all.x = wins.front().x;
+		all.y = wins.front().y;
+		all.width = wins.back().x + wins.back().width - all.x;
+		all.height = wins.back().y + wins.back().height - all.y;
+	}
+	if (matched) {
+		for (double &v : total)
+			v /= matched;
+		result(total, contrastSum / matched, saturationMax, levelSum / matched, &all);
+	}
+
+	out->pdGridWidth = std::max(1u, config.gridWidth);
+	out->pdGridHeight = std::max(1u, config.gridHeight);
+	out->valid |= StatsValidPd;
+
+	return true;
+}
+
+void MtkIsp50PdMatcher::push(const Frame &frame, std::vector<FrameBuffer *> *release)
+{
+	waiting_.push_back(frame);
+	newest_ = std::max(newest_, frame.timestamp);
+
+	while (waiting_.size() > maxWaiting_) {
+		release->push_back(waiting_.front().buffer);
+		waiting_.pop_front();
+	}
+}
+
+FrameBuffer *MtkIsp50PdMatcher::take(uint64_t rawTimestamp, std::vector<FrameBuffer *> *release,
+				     Frame *taken)
+{
+	FrameBuffer *match = nullptr;
+
+	while (!waiting_.empty()) {
+		const Frame &f = waiting_.front();
+		const int64_t delta = static_cast<int64_t>(f.timestamp - rawTimestamp);
+
+		if (delta < -static_cast<int64_t>(tolerance_)) {
+			/* Older than the raw frame: its raw frame is gone */
+			release->push_back(f.buffer);
+			waiting_.pop_front();
+			continue;
+		}
+
+		if (delta <= static_cast<int64_t>(tolerance_)) {
+			match = f.buffer;
+			if (taken)
+				*taken = f;
+			waiting_.pop_front();
+		}
+		break;
+	}
+
+	return match;
+}
+
+bool MtkIsp50PdMatcher::mayCome(uint64_t rawTimestamp) const
+{
+	/* A PD frame within the tolerance would be waiting already */
+	return newest_ + tolerance_ < rawTimestamp;
+}
+
+void MtkIsp50PdMatcher::drain(std::vector<FrameBuffer *> *release)
+{
+	for (const Frame &f : waiting_)
+		release->push_back(f.buffer);
+	waiting_.clear();
+	newest_ = 0;
+}
+
+} /* namespace libcamera */
diff --git a/src/libcamera/pipeline/mtkisp50/pd.h b/src/libcamera/pipeline/mtkisp50/pd.h
new file mode 100644
index 0000000..2606226
--- /dev/null
+++ b/src/libcamera/pipeline/mtkisp50/pd.h
@@ -0,0 +1,191 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Phase detection data of the mtkisp50 pipeline
+ *
+ * Some sensors send their phase detection (PD) pixels on a stream of their
+ * own (a virtual channel next to the image), in one sensor mode only. The
+ * capture side writes it to memory through a second capture device. This
+ * file has what does not need a device: the layout of the PD frame of a
+ * sensor, the computation of the PD statistics of a frame, and the pairing
+ * of PD frames with raw frames.
+ */
+
+#pragma once
+
+#include <array>
+#include <deque>
+#include <stdint.h>
+#include <string>
+#include <vector>
+
+#include <libcamera/geometry.h>
+
+#include "libcamera/internal/mtkisp50/stats.h"
+
+namespace libcamera {
+
+class FrameBuffer;
+
+/*
+ * Where the PD pixels of a sensor are and how its PD frame is built. The
+ * pattern repeats in blocks of block x block pixels; a line of the PD frame
+ * holds one pixel row of all blocks in a row, the samples of a block in the
+ * order of pairX of that row (rows of a block in the order of rowY). Each
+ * pair is a right and a left pixel, the left one leftOffset pixels to the
+ * right of the right one.
+ */
+struct MtkIsp50PdLayout {
+	/* Sensor model and the mode that sends the PD stream */
+	std::string model;
+	Size sensorSize;
+	/* Stream of the sensor source pad, bus code and size of the PD frame */
+	unsigned int stream;
+	uint32_t mbusCode;
+	Size size;
+	/* Bits per sample, MediaTek packing (4 samples in 5 bytes, LSB first) */
+	unsigned int bitDepth;
+
+	/* Pattern in pixels of the sensor mode */
+	Point offset;
+	unsigned int block;
+	Size blocks;
+	/* Per line of a block: y and the x of the right pixel of each pair */
+	std::vector<unsigned int> rowY;
+	std::vector<std::vector<unsigned int>> pairX;
+	int leftOffset;
+
+	/* Layout of a sensor mode, nullptr if the mode sends no PD frame */
+	static const MtkIsp50PdLayout *find(const std::string &model, const Size &sensorSize);
+	/* A sensor model with a PD layout in any mode */
+	static bool known(const std::string &model);
+
+	/* Samples of a PD frame line, lines per block */
+	unsigned int samplesPerLine() const;
+	unsigned int linesPerBlock() const { return rowY.size(); }
+	unsigned int pairsPerLine() const { return pairX.empty() ? 0 : pairX[0].size(); }
+};
+
+/* What the PD statistics of a frame are computed over */
+struct MtkIsp50PdConfig {
+	/* Region in 1/65536 of the sensor output frame, cut in a grid */
+	std::array<uint16_t, 4> region;
+	unsigned int gridWidth;
+	unsigned int gridHeight;
+	/* Search range of the match in profile samples on either side */
+	unsigned int maxShift;
+	/* Black level in raw sample units of the PD frame */
+	unsigned int blackLevel;
+};
+
+/*
+ * PD statistics of one frame. For each window the mean of the right and of
+ * the left pixels at each pattern position along x (over the lines of the
+ * window), less the black level, gives two profiles; each pattern position is
+ * normalised to its mean (lens shading, gains of the pixel kinds) and freed
+ * of its running mean along x (a slow pattern of each position that would
+ * match at no shift). The shift is where the mean absolute difference of the
+ * two profiles is smallest, with a parabola through the minimum and its
+ * neighbours for the fraction. The confidence follows the depth of that
+ * minimum below the median of the curve, relative to the minimum.
+ */
+class MtkIsp50PdStats
+{
+public:
+	MtkIsp50PdStats(const MtkIsp50PdLayout &layout);
+
+	/*
+	 * Compute the statistics of the PD frame in @data (lines of @stride
+	 * bytes) into the PD part of @out and set StatsValidPd. Returns false
+	 * (and leaves StatsValidPd clear) if the frame is too short.
+	 */
+	bool compute(const uint8_t *data, size_t length, unsigned int stride,
+		     const MtkIsp50PdConfig &config, mtkisp50::StatsBuffer *out);
+
+	/* Unpack one line of the PD frame (MediaTek packing) */
+	static void unpackLine(const uint8_t *line, unsigned int samples, uint16_t *out);
+
+	/* The windows of a configuration in pixels of the sensor mode */
+	std::vector<Rectangle> windows(const MtkIsp50PdConfig &config) const;
+
+private:
+	struct Profile {
+		std::vector<double> left;
+		std::vector<double> right;
+		unsigned int saturated = 0;
+		unsigned int samples = 0;
+		double sum = 0.0;
+	};
+
+	struct Match {
+		std::vector<double> sad;
+		double contrast = 0.0;
+		bool valid = false;
+	};
+
+	void profile(const std::vector<uint16_t> &lines, unsigned int bx0, unsigned int bx1,
+		     unsigned int by0, unsigned int by1, unsigned int blackLevel,
+		     Profile *p) const;
+	void normalise(std::vector<double> *profile, unsigned int k) const;
+	static Match match(const Profile &p, unsigned int maxShift);
+	void result(const std::vector<double> &sad, double contrast, double saturation,
+		    double level, mtkisp50::StatsPdWindow *w) const;
+
+	const MtkIsp50PdLayout &layout_;
+	/* Profile samples per block and their distance in pixels */
+	unsigned int positions_;
+	double pitch_;
+	/* Profile position of each pair of each line of a block */
+	std::vector<std::vector<unsigned int>> position_;
+	unsigned int saturation_;
+	/* The unpacked frame, kept between frames */
+	std::vector<uint16_t> lines_;
+};
+
+/*
+ * Pairing of PD frames with raw frames of the same sensor frame. Both capture
+ * devices count their own frames and start at different times: the pairing
+ * goes by timestamp, a PD frame belongs to the raw frame whose timestamp is
+ * within the tolerance. PD frames wait for their raw frame; older ones,
+ * and the oldest when more than maxWaiting wait, go back to the capture
+ * device.
+ */
+class MtkIsp50PdMatcher
+{
+public:
+	struct Frame {
+		FrameBuffer *buffer;
+		uint64_t timestamp;
+		uint32_t sequence;
+	};
+
+	void reset() { waiting_.clear(); }
+	void setTolerance(uint64_t ns) { tolerance_ = ns; }
+	void setMaxWaiting(unsigned int count) { maxWaiting_ = count; }
+
+	/* A PD frame arrived; frames to give back go to @release */
+	void push(const Frame &frame, std::vector<FrameBuffer *> *release);
+
+	/*
+	 * The PD frame of a raw frame, nullptr if none waits. PD frames older
+	 * than the raw frame go to @release.
+	 */
+	FrameBuffer *take(uint64_t rawTimestamp, std::vector<FrameBuffer *> *release,
+			  Frame *taken = nullptr);
+
+	/* A PD frame of this raw frame may still come */
+	bool mayCome(uint64_t rawTimestamp) const;
+
+	/* Give back everything */
+	void drain(std::vector<FrameBuffer *> *release);
+
+	size_t waiting() const { return waiting_.size(); }
+
+private:
+	std::deque<Frame> waiting_;
+	uint64_t tolerance_ = 10000000;
+	unsigned int maxWaiting_ = 2;
+	/* Newest PD timestamp seen */
+	uint64_t newest_ = 0;
+};
+
+} /* namespace libcamera */
diff --git a/src/libcamera/pipeline/mtkisp50/raw_stats_af.h b/src/libcamera/pipeline/mtkisp50/raw_stats_af.h
new file mode 100644
index 0000000..00fe4f6
--- /dev/null
+++ b/src/libcamera/pipeline/mtkisp50/raw_stats_af.h
@@ -0,0 +1,124 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Focus grid accumulation of the mtkisp50 CPU statistics (copy of the software
+ * ISP focus grid)
+ */
+
+#pragma once
+
+#include <stdint.h>
+
+#include "libcamera/internal/software_isp/mtisp.h"
+
+namespace libcamera {
+
+namespace raw_stats_af {
+
+/*
+ * Each function adds the green samples of one Bayer line pair to a row of
+ * focus grid cells. src0 and src1 point to the first pixel of the grid on the
+ * two lines of the pair, cellSize is the cell edge length in pixels (a
+ * multiple of 4), cells the number of cells in the row. All sums are on an
+ * 8 bit scale.
+ */
+
+/*
+ * Unpacked samples, ordered such that line 0 holds the green sample at odd x
+ * and line 1 at even x (B G / G R after the line swap and x shift done for the
+ * other statistics). shift scales the samples down to 8 bits.
+ */
+template<typename T>
+inline void accumulateUnpacked(const T *src0, const T *src1, unsigned int shift,
+			       unsigned int cellSize, unsigned int cells,
+			       uint32_t *grid)
+{
+	for (unsigned int c = 0; c < cells; c++) {
+		uint32_t sum = 0;
+
+		for (unsigned int x = 0; x < cellSize; x += 2)
+			sum += (src0[x + 1] >> shift) + (src1[x] >> shift);
+
+		grid[c] += sum;
+		src0 += cellSize;
+		src1 += cellSize;
+	}
+}
+
+/*
+ * CSI-2 packed 10 bit: 5 bytes for 4 pixels, the first 4 bytes hold the 8 most
+ * significant bits. greenOdd tells whether line 0 has its green samples at odd
+ * pixel positions (BGGR/GRBG after the line swap) or at even ones (GBRG/RGGB).
+ */
+inline void accumulate10P(const uint8_t *src0, const uint8_t *src1, bool greenOdd,
+			  unsigned int cellSize, unsigned int cells, uint32_t *grid)
+{
+	const unsigned int o0 = greenOdd ? 1 : 0;
+	const unsigned int o1 = greenOdd ? 0 : 1;
+	const unsigned int cellBytes = cellSize * 5 / 4;
+
+	for (unsigned int c = 0; c < cells; c++) {
+		uint32_t sum = 0;
+
+		for (unsigned int x = 0; x < cellBytes; x += 5)
+			sum += src0[x + o0] + src0[x + o0 + 2] +
+			       src1[x + o1] + src1[x + o1 + 2];
+
+		grid[c] += sum;
+		src0 += cellBytes;
+		src1 += cellBytes;
+	}
+}
+
+/* CSI-2 packed 12 bit: 3 bytes for 2 pixels, the first 2 bytes hold the MSBs. */
+inline void accumulate12P(const uint8_t *src0, const uint8_t *src1, bool greenOdd,
+			  unsigned int cellSize, unsigned int cells, uint32_t *grid)
+{
+	const unsigned int o0 = greenOdd ? 1 : 0;
+	const unsigned int o1 = greenOdd ? 0 : 1;
+	const unsigned int cellBytes = cellSize * 3 / 2;
+
+	for (unsigned int c = 0; c < cells; c++) {
+		uint32_t sum = 0;
+
+		for (unsigned int x = 0; x < cellBytes; x += 3)
+			sum += src0[x + o0] + src1[x + o1];
+
+		grid[c] += sum;
+		src0 += cellBytes;
+		src1 += cellBytes;
+	}
+}
+
+/*
+ * MediaTek ISP packed 10 bit: 5 bytes for 4 pixels as one bit stream, least
+ * significant bit first. greenOdd as for accumulate10P. The samples are scaled
+ * down to 8 bits.
+ */
+inline void accumulateMtisp10(const uint8_t *src0, const uint8_t *src1, bool greenOdd,
+			      unsigned int cellSize, unsigned int cells, uint32_t *grid)
+{
+	const unsigned int o0 = greenOdd ? 1 : 0;
+	const unsigned int o1 = greenOdd ? 0 : 1;
+	const unsigned int cellBytes = cellSize * 5 / 4;
+
+	for (unsigned int c = 0; c < cells; c++) {
+		uint32_t sum = 0;
+
+		for (unsigned int x = 0; x < cellBytes; x += 5) {
+			uint16_t p0[4], p1[4];
+
+			mtisp::unpackGroup(src0 + x, p0);
+			mtisp::unpackGroup(src1 + x, p1);
+			sum += (p0[o0] >> 2) + (p0[o0 + 2] >> 2) +
+			       (p1[o1] >> 2) + (p1[o1 + 2] >> 2);
+		}
+
+		grid[c] += sum;
+		src0 += cellBytes;
+		src1 += cellBytes;
+	}
+}
+
+} /* namespace raw_stats_af */
+
+} /* namespace libcamera */
diff --git a/src/libcamera/pipeline/mtkisp50/raw_stats_cpu.cpp b/src/libcamera/pipeline/mtkisp50/raw_stats_cpu.cpp
new file mode 100644
index 0000000..fa710f5
--- /dev/null
+++ b/src/libcamera/pipeline/mtkisp50/raw_stats_cpu.cpp
@@ -0,0 +1,956 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2023, Linaro Ltd
+ * Copyright (C) 2023, Red Hat Inc.
+ *
+ * Authors:
+ * Hans de Goede <hdegoede@redhat.com>
+ *
+ * CPU statistics of the mtkisp50 pipeline, derived from the CPU statistics of
+ * the software ISP (SwStatsCpu). Same sampling and arithmetic, the result goes
+ * to a statistics buffer in the layout of mtkisp50/stats.h.
+ */
+
+#include "raw_stats_cpu.h"
+
+#include <cmath>
+
+#include <algorithm>
+#include <atomic>
+#include <string.h>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/stream.h>
+
+#include "libcamera/internal/bayer_format.h"
+#include "libcamera/internal/mapped_framebuffer.h"
+
+#include "raw_stats_af.h"
+
+namespace libcamera {
+
+using namespace mtkisp50;
+
+LOG_DEFINE_CATEGORY(RawStatsCpu)
+
+RawStatsCpu::RawStatsCpu()
+{
+}
+
+static constexpr unsigned int kRedYMul = 77; /* 0.299 * 256 */
+static constexpr unsigned int kGreenYMul = 150; /* 0.587 * 256 */
+static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
+
+#define SWSTATS_START_LINE_STATS(pixel_t)                                      \
+	pixel_t r, g, g2, b;                                                   \
+	uint64_t yVal;                                                         \
+                                                                               \
+	uint64_t sumR = 0;                                                     \
+	uint64_t sumG = 0;                                                     \
+	uint64_t sumB = 0;                                                     \
+                                                                               \
+	/* Zone of each sampled block (every 4 pixels) along the line */       \
+	const uint8_t *zoneCol = zoneColumns_.data();                         \
+	RGB<uint64_t> *zone = &stats.zoneSum[zoneRow * RawStatsAccumulator::kZones];    \
+	uint32_t *zoneCount = &stats.zoneCount[zoneRow * RawStatsAccumulator::kZones];
+
+#define SWSTATS_ACCUMULATE_LINE_STATS(div) \
+	sumR += r;                         \
+	sumG += g;                         \
+	sumB += b;                         \
+	{                                  \
+		const uint8_t zc = *zoneCol++; \
+		zone[zc].r() += r;         \
+		zone[zc].g() += g;         \
+		zone[zc].b() += b;         \
+		zoneCount[zc]++;           \
+	}                                  \
+                                           \
+	yVal = r * kRedYMul;               \
+	yVal += g * kGreenYMul;            \
+	yVal += b * kBlueYMul;             \
+	stats.yHistogram[yVal * RawStatsAccumulator::kYHistogramSize / (256 * 256 * (div))]++;
+
+#define SWSTATS_FINISH_LINE_STATS() \
+	stats.sum_.r() += sumR;     \
+	stats.sum_.g() += sumG;     \
+	stats.sum_.b() += sumB;
+
+void RawStatsCpu::statsBGGR8Line0(const uint8_t *src[], RawStatsAccumulator &stats, unsigned int zoneRow)
+{
+	const uint8_t *src0 = src[1] + window_.x;
+	const uint8_t *src1 = src[2] + window_.x;
+
+	SWSTATS_START_LINE_STATS(uint8_t)
+
+	if (swapLines_)
+		std::swap(src0, src1);
+
+	/* x += 4 sample every other 2x2 block */
+	for (unsigned int x = 0; x < window_.width; x += 4 * blockStep_) {
+		b = src0[x];
+		g = src0[x + 1];
+		g2 = src1[x];
+		r = src1[x + 1];
+
+		g = (g + g2) / 2;
+
+		SWSTATS_ACCUMULATE_LINE_STATS(1)
+	}
+
+	SWSTATS_FINISH_LINE_STATS()
+}
+
+void RawStatsCpu::statsBGGR10Line0(const uint8_t *src[], RawStatsAccumulator &stats, unsigned int zoneRow)
+{
+	const uint16_t *src0 = (const uint16_t *)src[1] + window_.x;
+	const uint16_t *src1 = (const uint16_t *)src[2] + window_.x;
+
+	SWSTATS_START_LINE_STATS(uint16_t)
+
+	if (swapLines_)
+		std::swap(src0, src1);
+
+	/* x += 4 sample every other 2x2 block */
+	for (unsigned int x = 0; x < window_.width; x += 4 * blockStep_) {
+		b = src0[x];
+		g = src0[x + 1];
+		g2 = src1[x];
+		r = src1[x + 1];
+
+		g = (g + g2) / 2;
+
+		/* divide Y by 4 for 10 -> 8 bpp value */
+		SWSTATS_ACCUMULATE_LINE_STATS(4)
+	}
+
+	SWSTATS_FINISH_LINE_STATS()
+}
+
+void RawStatsCpu::statsBGGR12Line0(const uint8_t *src[], RawStatsAccumulator &stats, unsigned int zoneRow)
+{
+	const uint16_t *src0 = (const uint16_t *)src[1] + window_.x;
+	const uint16_t *src1 = (const uint16_t *)src[2] + window_.x;
+
+	SWSTATS_START_LINE_STATS(uint16_t)
+
+	if (swapLines_)
+		std::swap(src0, src1);
+
+	/* x += 4 sample every other 2x2 block */
+	for (unsigned int x = 0; x < window_.width; x += 4 * blockStep_) {
+		b = src0[x];
+		g = src0[x + 1];
+		g2 = src1[x];
+		r = src1[x + 1];
+
+		g = (g + g2) / 2;
+
+		/* divide Y by 16 for 12 -> 8 bpp value */
+		SWSTATS_ACCUMULATE_LINE_STATS(16)
+	}
+
+	SWSTATS_FINISH_LINE_STATS()
+}
+
+void RawStatsCpu::statsBGGR10PLine0(const uint8_t *src[], RawStatsAccumulator &stats, unsigned int zoneRow)
+{
+	const uint8_t *src0 = src[1] + window_.x * 5 / 4;
+	const uint8_t *src1 = src[2] + window_.x * 5 / 4;
+	const unsigned int widthInBytes = window_.width * 5 / 4;
+
+	if (swapLines_)
+		std::swap(src0, src1);
+
+	SWSTATS_START_LINE_STATS(uint8_t)
+
+	/* x += 5 sample every other 2x2 block */
+	for (unsigned int x = 0; x < widthInBytes; x += 5 * blockStep_) {
+		/* BGGR */
+		b = src0[x];
+		g = src0[x + 1];
+		g2 = src1[x];
+		r = src1[x + 1];
+		g = (g + g2) / 2;
+		/* Data is already 8 bits, divide by 1 */
+		SWSTATS_ACCUMULATE_LINE_STATS(1)
+	}
+
+	SWSTATS_FINISH_LINE_STATS()
+}
+
+void RawStatsCpu::statsGBRG10PLine0(const uint8_t *src[], RawStatsAccumulator &stats, unsigned int zoneRow)
+{
+	const uint8_t *src0 = src[1] + window_.x * 5 / 4;
+	const uint8_t *src1 = src[2] + window_.x * 5 / 4;
+	const unsigned int widthInBytes = window_.width * 5 / 4;
+
+	if (swapLines_)
+		std::swap(src0, src1);
+
+	SWSTATS_START_LINE_STATS(uint8_t)
+
+	/* x += 5 sample every other 2x2 block */
+	for (unsigned int x = 0; x < widthInBytes; x += 5 * blockStep_) {
+		/* GBRG */
+		g = src0[x];
+		b = src0[x + 1];
+		r = src1[x];
+		g2 = src1[x + 1];
+		g = (g + g2) / 2;
+		/* Data is already 8 bits, divide by 1 */
+		SWSTATS_ACCUMULATE_LINE_STATS(1)
+	}
+
+	SWSTATS_FINISH_LINE_STATS()
+}
+
+void RawStatsCpu::statsBGGR12PLine0(const uint8_t *src[], RawStatsAccumulator &stats, unsigned int zoneRow)
+{
+	const uint8_t *src0 = src[1] + window_.x * 3 / 2;
+	const uint8_t *src1 = src[2] + window_.x * 3 / 2;
+	const unsigned int widthInBytes = window_.width * 3 / 2;
+
+	SWSTATS_START_LINE_STATS(uint8_t)
+
+	if (swapLines_)
+		std::swap(src0, src1);
+
+	/* x += 6 sample every other 2x2 block */
+	for (unsigned int x = 0; x < widthInBytes; x += 6 * blockStep_) {
+		b = src0[x];
+		g = src0[x + 1];
+		g2 = src1[x];
+		r = src1[x + 1];
+
+		g = (g + g2) / 2;
+
+		SWSTATS_ACCUMULATE_LINE_STATS(1)
+	}
+
+	SWSTATS_FINISH_LINE_STATS()
+}
+
+void RawStatsCpu::statsGBRG12PLine0(const uint8_t *src[], RawStatsAccumulator &stats, unsigned int zoneRow)
+{
+	const uint8_t *src0 = src[1] + window_.x * 3 / 2;
+	const uint8_t *src1 = src[2] + window_.x * 3 / 2;
+	const unsigned int widthInBytes = window_.width * 3 / 2;
+
+	SWSTATS_START_LINE_STATS(uint8_t)
+
+	if (swapLines_)
+		std::swap(src0, src1);
+
+	/* x += 6 sample every other 2x2 block */
+	for (unsigned int x = 0; x < widthInBytes; x += 6 * blockStep_) {
+		g = src0[x];
+		b = src0[x + 1];
+		r = src1[x];
+		g2 = src1[x + 1];
+
+		g = (g + g2) / 2;
+
+		SWSTATS_ACCUMULATE_LINE_STATS(1)
+	}
+
+	SWSTATS_FINISH_LINE_STATS()
+}
+
+/*
+ * MediaTek ISP packing: 4 pixels in 5 bytes, one little endian bit stream,
+ * least significant bit first. The first two pixels of a group are in the
+ * first three bytes.
+ */
+static inline uint16_t mtispPixel0(const uint8_t *p)
+{
+	return p[0] | ((p[1] & 0x03) << 8);
+}
+
+static inline uint16_t mtispPixel1(const uint8_t *p)
+{
+	return (p[1] >> 2) | ((p[2] & 0x0f) << 6);
+}
+
+void RawStatsCpu::statsBGGR10MtispLine0(const uint8_t *src[], RawStatsAccumulator &stats, unsigned int zoneRow)
+{
+	const uint8_t *src0 = src[1] + window_.x * 5 / 4;
+	const uint8_t *src1 = src[2] + window_.x * 5 / 4;
+	const unsigned int widthInBytes = window_.width * 5 / 4;
+
+	if (swapLines_)
+		std::swap(src0, src1);
+
+	SWSTATS_START_LINE_STATS(uint16_t)
+
+	/* x += 5 sample every other 2x2 block */
+	for (unsigned int x = 0; x < widthInBytes; x += 5 * blockStep_) {
+		/* BGGR */
+		b = mtispPixel0(src0 + x);
+		g = mtispPixel1(src0 + x);
+		g2 = mtispPixel0(src1 + x);
+		r = mtispPixel1(src1 + x);
+		g = (g + g2) / 2;
+
+		/* divide Y by 4 for 10 -> 8 bpp value */
+		SWSTATS_ACCUMULATE_LINE_STATS(4)
+	}
+
+	SWSTATS_FINISH_LINE_STATS()
+}
+
+void RawStatsCpu::statsGBRG10MtispLine0(const uint8_t *src[], RawStatsAccumulator &stats, unsigned int zoneRow)
+{
+	const uint8_t *src0 = src[1] + window_.x * 5 / 4;
+	const uint8_t *src1 = src[2] + window_.x * 5 / 4;
+	const unsigned int widthInBytes = window_.width * 5 / 4;
+
+	if (swapLines_)
+		std::swap(src0, src1);
+
+	SWSTATS_START_LINE_STATS(uint16_t)
+
+	/* x += 5 sample every other 2x2 block */
+	for (unsigned int x = 0; x < widthInBytes; x += 5 * blockStep_) {
+		/* GBRG */
+		g = mtispPixel0(src0 + x);
+		b = mtispPixel1(src0 + x);
+		r = mtispPixel0(src1 + x);
+		g2 = mtispPixel1(src1 + x);
+		g = (g + g2) / 2;
+
+		/* divide Y by 4 for 10 -> 8 bpp value */
+		SWSTATS_ACCUMULATE_LINE_STATS(4)
+	}
+
+	SWSTATS_FINISH_LINE_STATS()
+}
+
+/**
+ * \brief Reset state to start statistics gathering for a new frame
+ * \param[in] frame The frame number
+ *
+ * This may only be called after a successful setWindow() call.
+ */
+/*
+ * Focus grid: the green samples of each processed line pair inside the central
+ * half of the statistics window are summed up in square cells. The line
+ * pointers are prepared as for the other statistics (line swap and x shift
+ * for the unpacked formats), so line 0 holds green at odd positions there.
+ */
+void RawStatsCpu::afLine8(const uint8_t *src[], uint32_t *grid)
+{
+	const unsigned int x = window_.x + afWindow_.x;
+	const uint8_t *src0 = src[1] + x;
+	const uint8_t *src1 = src[2] + x;
+
+	if (swapLines_)
+		std::swap(src0, src1);
+
+	raw_stats_af::accumulateUnpacked(src0, src1, 0, afCellSize_,
+				       afGridSize_.width, grid);
+}
+
+void RawStatsCpu::afLine16(const uint8_t *src[], uint32_t *grid)
+{
+	const unsigned int x = window_.x + afWindow_.x;
+	const uint16_t *src0 = reinterpret_cast<const uint16_t *>(src[1]) + x;
+	const uint16_t *src1 = reinterpret_cast<const uint16_t *>(src[2]) + x;
+
+	if (swapLines_)
+		std::swap(src0, src1);
+
+	raw_stats_af::accumulateUnpacked(src0, src1, afShift_, afCellSize_,
+				       afGridSize_.width, grid);
+}
+
+void RawStatsCpu::afLine10P(const uint8_t *src[], uint32_t *grid)
+{
+	const unsigned int x = (window_.x + afWindow_.x) * 5 / 4;
+	const uint8_t *src0 = src[1] + x;
+	const uint8_t *src1 = src[2] + x;
+
+	if (swapLines_)
+		std::swap(src0, src1);
+
+	raw_stats_af::accumulate10P(src0, src1, afGreenOdd_, afCellSize_,
+				  afGridSize_.width, grid);
+}
+
+void RawStatsCpu::afLine12P(const uint8_t *src[], uint32_t *grid)
+{
+	const unsigned int x = (window_.x + afWindow_.x) * 3 / 2;
+	const uint8_t *src0 = src[1] + x;
+	const uint8_t *src1 = src[2] + x;
+
+	if (swapLines_)
+		std::swap(src0, src1);
+
+	raw_stats_af::accumulate12P(src0, src1, afGreenOdd_, afCellSize_,
+				  afGridSize_.width, grid);
+}
+
+void RawStatsCpu::afLineMtisp10(const uint8_t *src[], uint32_t *grid)
+{
+	const unsigned int x = (window_.x + afWindow_.x) * 5 / 4;
+	const uint8_t *src0 = src[1] + x;
+	const uint8_t *src1 = src[2] + x;
+
+	if (swapLines_)
+		std::swap(src0, src1);
+
+	raw_stats_af::accumulateMtisp10(src0, src1, afGreenOdd_, afCellSize_,
+				      afGridSize_.width, grid);
+}
+
+/*
+ * Place the focus grid in the central half of the statistics window. The cell
+ * size is the smallest power of two from 8 pixels up for which the grid fits
+ * into RawStatsAccumulator::afGrid. Cells start at a multiple of 4 lines, so that each
+ * one gets the same number of line pairs past ySkipMask_.
+ */
+void RawStatsCpu::setupAfWindow()
+{
+	afWindow_ = {};
+	afGridSize_ = {};
+	afCellSize_ = 8;
+
+	if (!afLine_)
+		return;
+
+	/* Requested region relative to the statistics window, default the central half */
+	unsigned int width = window_.width / 2;
+	unsigned int height = window_.height / 2;
+	int left = -1, top = -1;
+	if (afRegion_[2] && afRegion_[3]) {
+		if (afRegionMode_ == 0) {
+			width = static_cast<uint64_t>(window_.width) * afRegion_[2] / 65535;
+			height = static_cast<uint64_t>(window_.height) * afRegion_[3] / 65535;
+		} else if (inputSize_.width && inputSize_.height) {
+			/* Fractions of the input frame, clipped to the window */
+			const int64_t x0 = static_cast<int64_t>(inputSize_.width) * afRegion_[0] / 65535 - window_.x;
+			const int64_t y0 = static_cast<int64_t>(inputSize_.height) * afRegion_[1] / 65535 - window_.y;
+			const int64_t x1 = x0 + static_cast<int64_t>(inputSize_.width) * afRegion_[2] / 65535;
+			const int64_t y1 = y0 + static_cast<int64_t>(inputSize_.height) * afRegion_[3] / 65535;
+			const int64_t cx0 = std::clamp<int64_t>(x0, 0, window_.width);
+			const int64_t cy0 = std::clamp<int64_t>(y0, 0, window_.height);
+			const int64_t cx1 = std::clamp<int64_t>(x1, 0, window_.width);
+			const int64_t cy1 = std::clamp<int64_t>(y1, 0, window_.height);
+			if (cx1 > cx0 && cy1 > cy0) {
+				width = cx1 - cx0;
+				height = cy1 - cy0;
+				left = cx0;
+				top = cy0;
+			}
+			/* else outside the statistics window: the central half */
+		}
+		/* At least 24 pixels (three cells) in each direction */
+		width = std::clamp(width, 24u, static_cast<unsigned int>(window_.width));
+		height = std::clamp(height, 24u, static_cast<unsigned int>(window_.height));
+	}
+
+	while (width / afCellSize_ > RawStatsAccumulator::kAfGridMaxWidth ||
+	       height / afCellSize_ > RawStatsAccumulator::kAfGridMaxHeight)
+		afCellSize_ *= 2;
+
+	afGridSize_.width = width / afCellSize_;
+	afGridSize_.height = height / afCellSize_;
+	afWindow_.width = afGridSize_.width * afCellSize_;
+	afWindow_.height = afGridSize_.height * afCellSize_;
+	if (left < 0) {
+		afWindow_.x = ((window_.width - afWindow_.width) / 2) & ~3u;
+		afWindow_.y = ((window_.height - afWindow_.height) / 2) & ~3u;
+	} else {
+		/* Around the centre of the requested region, inside the window */
+		const int cx = left + static_cast<int>(width) / 2;
+		const int cy = top + static_cast<int>(height) / 2;
+		afWindow_.x = std::clamp<int>(cx - static_cast<int>(afWindow_.width) / 2, 0,
+					      window_.width - afWindow_.width) & ~3;
+		afWindow_.y = std::clamp<int>(cy - static_cast<int>(afWindow_.height) / 2, 0,
+					      window_.height - afWindow_.height) & ~3;
+	}
+
+	if (!afGridSize_.width || !afGridSize_.height) {
+		afWindow_ = {};
+		afGridSize_ = {};
+	}
+}
+
+void RawStatsCpu::startFrame(uint32_t frame)
+{
+	if (frame % kStatPerNumFrames)
+		return;
+
+	if (window_.width == 0)
+		LOG(RawStatsCpu, Error) << "Calling startFrame() without setWindow()";
+
+	stats_.sum_ = RGB<uint64_t>({ 0, 0, 0 });
+	stats_.yHistogram.fill(0);
+	std::fill_n(stats_.afGrid.begin(), afGridSize_.width * afGridSize_.height, 0);
+	stats_.zoneSum.fill(RGB<uint64_t>({ 0, 0, 0 }));
+	stats_.zoneCount.fill(0);
+}
+
+void RawStatsCpu::writeHeader(uint32_t frame, StatsBuffer *out) const
+{
+	out->version = StatsBuffer::kVersion;
+	out->source = static_cast<uint32_t>(StatsSource::Cpu);
+	out->frame = frame;
+	out->valid = 0;
+	out->skipped = 0;
+	out->bitDepth = bitDepth_;
+	out->blackLevelSubtracted = 0;
+	out->blackLevel = 0;
+	/* The luma histogram uses 77/150/29 of 256 without pre-gains */
+	out->yCoeffs[0] = out->yCoeffs[1] = out->yCoeffs[2] = 0;
+	out->preGains[0] = out->preGains[1] = out->preGains[2] = 512;
+	out->windowX = window_.x;
+	out->windowY = window_.y;
+	out->windowWidth = window_.width;
+	out->windowHeight = window_.height;
+	out->gridWidth = 0;
+	out->gridHeight = 0;
+	out->histogramCount = 0;
+	out->afX = window_.x + afWindow_.x;
+	out->afY = window_.y + afWindow_.y;
+	out->afWidth = 0;
+	out->afHeight = 0;
+	out->afBlockSize = afCellSize_;
+	/* Two green samples per 2x2 block, every other line pair. */
+	out->afBlockSamples = afCellSize_ * afCellSize_ / 4;
+	out->afMeasure = StatsAfLevelSum;
+	out->afBands = 0;
+}
+
+/*
+ * Finish the statistics of a frame: write the accumulated values to out. The
+ * cell means are in raw sample units of the input (sums before the shift to
+ * 8 bits divided by the number of samples); mean times count gives the sum
+ * back exactly.
+ */
+void RawStatsCpu::finishFrame(uint32_t frame, StatsBuffer *out)
+{
+	const bool valid = wantsFrame(frame) && statsThisFrame_;
+	const unsigned int gridCells = afGridSize_.width * afGridSize_.height;
+
+	if (!out)
+		return;
+
+	writeHeader(frame, out);
+
+	/* A frame skipped on purpose (longer interval): tell the consumer */
+	if (!valid && frame % kStatPerNumFrames == 0)
+		out->skipped = 1;
+
+	/*
+	 * The focus grid goes with every frame with statistics (zero if it
+	 * was not gathered, as the software ISP did), and with frames that
+	 * gathered the grid alone; StatsValidAf tells if it was gathered.
+	 */
+	const bool af = gridCells && (valid ? afThisFrame_ : (!statsThisFrame_ && afThisFrame_));
+	if ((valid || af) && gridCells) {
+		out->afWidth = afGridSize_.width;
+		out->afHeight = afGridSize_.height;
+		for (unsigned int j = 0; j < gridCells; j++)
+			out->af[j] = { stats_.afGrid[j], { 0, 0 } };
+	}
+	if (af)
+		out->valid |= StatsValidAf;
+
+	if (!valid)
+		return;
+
+	constexpr unsigned int zones = RawStatsAccumulator::kZones;
+	out->gridWidth = zones;
+	out->gridHeight = zones;
+	for (unsigned int j = 0; j < zones * zones; j++) {
+		StatsCell &cell = out->cells[j];
+		const uint32_t count = stats_.zoneCount[j];
+
+		cell.count = count;
+		cell.saturated = 0;
+		for (unsigned int c = 0; c < 3; c++)
+			cell.mean[c] = count ? static_cast<double>(stats_.zoneSum[j][c]) / count : 0.0;
+	}
+
+	out->histogramCount = 1;
+	StatsHistogram &hist = out->histograms[0];
+	hist.type = StatsHistogramLumaBt601;
+	hist.bins = RawStatsAccumulator::kYHistogramSize;
+	std::copy(stats_.yHistogram.begin(), stats_.yHistogram.end(), hist.data);
+
+	out->valid |= StatsValidCells | StatsValidHistograms;
+}
+
+/**
+ * \brief Setup RawStatsCpu object for standard Bayer orders
+ * \param[in] order The Bayer order
+ *
+ * Check if order is a standard Bayer order and setup xShift_ and swapLines_
+ * so that a single BGGR stats function can be used for all 4 standard orders.
+ */
+int RawStatsCpu::setupStandardBayerOrder(BayerFormat::Order order)
+{
+	switch (order) {
+	case BayerFormat::BGGR:
+		xShift_ = 0;
+		swapLines_ = false;
+		break;
+	case BayerFormat::GBRG:
+		xShift_ = 1; /* BGGR -> GBRG */
+		swapLines_ = false;
+		break;
+	case BayerFormat::GRBG:
+		xShift_ = 0;
+		swapLines_ = true; /* BGGR -> GRBG */
+		break;
+	case BayerFormat::RGGB:
+		xShift_ = 1; /* BGGR -> GBRG */
+		swapLines_ = true; /* GBRG -> RGGB */
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	patternSize_.height = 2;
+	patternSize_.width = 2;
+	ySkipMask_ = 0x02; /* Skip every 3th and 4th line */
+	return 0;
+}
+
+/* Configure the statistics for the input format, 0 or -EINVAL */
+int RawStatsCpu::configure(const StreamConfiguration &inputCfg)
+{
+	stride_ = inputCfg.stride;
+	inputSize_ = inputCfg.size;
+	afLine_ = nullptr;
+	afGreenOdd_ = true;
+	afShift_ = 0;
+	bytesNum_ = 1;
+	bytesDen_ = 1;
+
+	BayerFormat bayerFormat =
+		BayerFormat::fromPixelFormat(inputCfg.pixelFormat);
+
+	if (bayerFormat.packing == BayerFormat::Packing::None &&
+	    setupStandardBayerOrder(bayerFormat.order) == 0) {
+		processFrame_ = &RawStatsCpu::processBayerFrame2;
+		switch (bayerFormat.bitDepth) {
+		case 8:
+			stats0_ = &RawStatsCpu::statsBGGR8Line0;
+			sumShift_ = 0;
+			bitDepth_ = 8;
+			afLine_ = &RawStatsCpu::afLine8;
+			return 0;
+		case 10:
+			bytesNum_ = 2;
+			stats0_ = &RawStatsCpu::statsBGGR10Line0;
+			sumShift_ = 2;
+			bitDepth_ = 10;
+			afLine_ = &RawStatsCpu::afLine16;
+			afShift_ = 2;
+			return 0;
+		case 12:
+			bytesNum_ = 2;
+			stats0_ = &RawStatsCpu::statsBGGR12Line0;
+			sumShift_ = 4;
+			bitDepth_ = 12;
+			afLine_ = &RawStatsCpu::afLine16;
+			afShift_ = 4;
+			return 0;
+		}
+	}
+
+	uint8_t bitDepth = bayerFormat.bitDepth;
+
+	if ((bitDepth == 10 || bitDepth == 12) &&
+	    bayerFormat.packing == BayerFormat::Packing::CSI2) {
+		if (bitDepth == 10)
+			patternSize_.width = 4; /* 5 bytes per *4* pixels */
+		else
+			patternSize_.width = 2; /* 3 bytes for *2* pixels */
+		bytesNum_ = bitDepth == 10 ? 5 : 3;
+		bytesDen_ = bitDepth == 10 ? 4 : 2;
+
+		patternSize_.height = 2;
+
+		/* Skip every 3th and 4th line, sample every other 2x2 block */
+		ySkipMask_ = 0x02;
+		xShift_ = 0;
+		sumShift_ = 0;
+		bitDepth_ = 8;
+		processFrame_ = &RawStatsCpu::processBayerFrame2;
+
+		afLine_ = (bitDepth == 10) ? &RawStatsCpu::afLine10P : &RawStatsCpu::afLine12P;
+
+		switch (bayerFormat.order) {
+		case BayerFormat::BGGR:
+		case BayerFormat::GRBG:
+			stats0_ = (bitDepth == 10) ? &RawStatsCpu::statsBGGR10PLine0 : &RawStatsCpu::statsBGGR12PLine0;
+			swapLines_ = bayerFormat.order == BayerFormat::GRBG;
+			afGreenOdd_ = true;
+			return 0;
+		case BayerFormat::GBRG:
+		case BayerFormat::RGGB:
+			stats0_ = (bitDepth == 10) ? &RawStatsCpu::statsGBRG10PLine0 : &RawStatsCpu::statsGBRG12PLine0;
+			swapLines_ = bayerFormat.order == BayerFormat::RGGB;
+			afGreenOdd_ = false;
+			return 0;
+		default:
+			break;
+		}
+	}
+
+	if (bitDepth == 10 && bayerFormat.packing == BayerFormat::Packing::MTISP) {
+		patternSize_.width = 4; /* 5 bytes per *4* pixels */
+		bytesNum_ = 5;
+		bytesDen_ = 4;
+		patternSize_.height = 2;
+
+		/* Skip every 3th and 4th line, sample every other 2x2 block */
+		ySkipMask_ = 0x02;
+		xShift_ = 0;
+		sumShift_ = 2;
+		bitDepth_ = 10;
+		processFrame_ = &RawStatsCpu::processBayerFrame2;
+		afLine_ = &RawStatsCpu::afLineMtisp10;
+
+		switch (bayerFormat.order) {
+		case BayerFormat::BGGR:
+		case BayerFormat::GRBG:
+			stats0_ = &RawStatsCpu::statsBGGR10MtispLine0;
+			swapLines_ = bayerFormat.order == BayerFormat::GRBG;
+			afGreenOdd_ = true;
+			return 0;
+		case BayerFormat::GBRG:
+		case BayerFormat::RGGB:
+			stats0_ = &RawStatsCpu::statsGBRG10MtispLine0;
+			swapLines_ = bayerFormat.order == BayerFormat::RGGB;
+			afGreenOdd_ = false;
+			return 0;
+		default:
+			break;
+		}
+	}
+
+	LOG(RawStatsCpu, Info)
+		<< "Unsupported input format " << inputCfg.pixelFormat.toString();
+	return -EINVAL;
+}
+
+/**
+ * \brief Specify window coordinates over which to gather statistics
+ * \param[in] window The window object.
+ *
+ * This method specifies the image area over which to gather the statistics.
+ * It must be called to set the area, otherwise the default zero-sized
+ * \a Rectangle is used and no statistics is gathered.
+ *
+ * The specified \a window is relative to what is passed to the processLine*
+ * methods. For example, if statistics are to be gathered from the entire
+ * processed area, then \a window should be a rectangle with the top-left corner
+ * of (0,0) and the same size as the processed area. If only a part of the
+ * processed area (e.g. its centre) is to be considered for statistics, then
+ * \a window should specify such a restriction accordingly.
+ *
+ * It is the responsibility of the callers to provide sensible \a window values,
+ * most notably not exceeding the original image boundaries. This means, among
+ * other, that neither coordinate of the top-left corner shall be negative.
+ *
+ * Due to limitations of the implementation, the method may adjust the window
+ * slightly if it is not aligned according to the bayer pattern determined in
+ * \a RawStatsCpu::configure(). In that case the window will be modified such that
+ * the sides are no larger than the original, and that the new bottom-left
+ * corner will be no further from (0,0) (along either axis) than the original
+ * was.
+ */
+void RawStatsCpu::setWindow(const Rectangle &window)
+{
+	ASSERT(window.x >= 0 && window.y >= 0);
+
+	window_ = window;
+
+	window_.x &= ~(patternSize_.width - 1);
+	window_.x += xShift_;
+	window_.y &= ~(patternSize_.height - 1);
+
+	/* width_ - xShift_ to make sure the window fits */
+	window_.width = (window_.width > xShift_ ? window_.width - xShift_ : 0);
+	window_.width &= ~(patternSize_.width - 1);
+	window_.height &= ~(patternSize_.height - 1);
+
+	setupZoneColumns();
+	setupAfWindow();
+}
+
+/*
+ * Zone column of each sampled block: the line functions sample one block
+ * every 4 * blockStep_ pixels from the window start.
+ */
+void RawStatsCpu::setupZoneColumns()
+{
+	const unsigned int step = 4 * blockStep_;
+
+	zoneColumns_.assign(window_.width / step + 1, 0);
+	for (unsigned int i = 0; i < zoneColumns_.size(); i++)
+		zoneColumns_[i] = window_.width
+					  ? std::min<unsigned int>(step * i * RawStatsAccumulator::kZones / window_.width,
+								   RawStatsAccumulator::kZones - 1)
+					  : 0;
+}
+
+/**
+ * \brief Set the sampling of processFrame()
+ * \param[in] linePairStep Process one line pair out of this many (default 2)
+ * \param[in] blockStep Sample one 2x2 block out of this many of the default
+ * pattern along a line (default 1, every other block)
+ *
+ * Coarser sampling costs less, in particular reading uncached raw buffers.
+ * The focus grid keeps its own sampling (every other line pair, every
+ * pixel of its window). The line based interface (processLine0() and
+ * processLine2()) is not affected.
+ */
+void RawStatsCpu::setSampling(unsigned int linePairStep, unsigned int blockStep)
+{
+	linePairStep = std::max(linePairStep, 1u);
+	blockStep = std::max(blockStep, 1u);
+	if (linePairStep == linePairStep_ && blockStep == blockStep_)
+		return;
+
+	linePairStep_ = linePairStep;
+	blockStep_ = blockStep;
+	setupZoneColumns();
+}
+
+/**
+ * \brief Set how often processFrame() gathers statistics
+ * \param[in] frames Statistics on the frames whose number is a multiple of
+ * this, rounded up to a multiple of kStatPerNumFrames (default
+ * kStatPerNumFrames)
+ * \param[in] afInterval Focus grid in every afInterval-th frame with
+ * statistics, 0 for none (default 1)
+ *
+ * A frame number that is a multiple of kStatPerNumFrames but not of \a frames
+ * is recorded in RawStatsAccumulator::skippedFrame, so that the consumer can tell a
+ * skipped frame from a late one.
+ */
+void RawStatsCpu::setInterval(unsigned int frames, unsigned int afInterval, bool afEveryFrame)
+{
+	frames = std::max(frames, kStatPerNumFrames);
+	interval_ = (frames + kStatPerNumFrames - 1) / kStatPerNumFrames * kStatPerNumFrames;
+	afInterval_ = afInterval;
+	afEveryFrame_ = afEveryFrame;
+}
+
+/**
+ * \brief Set the region of the focus grid
+ * \param[in] mode 0: \a region[2] and \a region[3] are the width and height
+ * of a region centred in the statistics window, as fractions of its size;
+ * 1: \a region is x, y, width and height as fractions of the input frame
+ * \param[in] region The region, fractions in units of 1/65535
+ *
+ * A region of zero size selects the default, the central half of the
+ * statistics window. The region is limited to the statistics window.
+ */
+void RawStatsCpu::setAfRegion(unsigned int mode, const std::array<uint16_t, 4> &region)
+{
+	if (mode == afRegionMode_ && region == afRegion_)
+		return;
+
+	afRegionMode_ = mode;
+	afRegion_ = region;
+	setupAfWindow();
+}
+
+/* Byte range [start, end) of a line holding the pixels [x, x + width), with a margin */
+void RawStatsCpu::lineRange(unsigned int x, unsigned int width, unsigned int &start,
+			   unsigned int &end) const
+{
+	const unsigned int first = x * bytesNum_ / bytesDen_;
+	const unsigned int last = ((x + width) * bytesNum_ + bytesDen_ - 1) / bytesDen_;
+
+	start = first > 8 ? (first - 8) & ~7u : 0;
+	end = std::min(last + 8, stride_);
+}
+
+void RawStatsCpu::processBayerFrame2(MappedFrameBuffer &in)
+{
+	const uint8_t *src = in.planes()[0].data();
+	const uint8_t *linePointers[3];
+
+	/*
+	 * Raw buffers of camera receivers are usually mapped uncached, and
+	 * reading them sample by sample costs a bus access per byte. Copy the
+	 * part of each line pair that is used into a cached buffer with wide
+	 * reads first, at the same offsets; for a cached buffer the copy is
+	 * cheap. Only the line pairs of the sampling and, when the focus grid
+	 * is gathered, every other line pair inside its window are read.
+	 */
+	lineBuffer_.resize(2 * stride_);
+
+	unsigned int statsStart, statsEnd, afStart, afEnd;
+	lineRange(window_.x, window_.width, statsStart, statsEnd);
+	lineRange(window_.x + afWindow_.x, afWindow_.width, afStart, afEnd);
+	const bool af = afThisFrame_ && afLine_ && afWindow_.width;
+
+	/* Adjust src for starting at window_.y */
+	src += window_.y * stride_;
+
+	for (unsigned int y = 0; y < window_.height; y += 2, src += stride_ * 2) {
+		const unsigned int pair = y / 2;
+		const bool statsLine = statsThisFrame_ && pair % linePairStep_ == 0;
+		const bool afLine = af && pair % 2 == 0 &&
+				    y >= static_cast<unsigned int>(afWindow_.y) &&
+				    y < afWindow_.y + afWindow_.height;
+		if (!statsLine && !afLine)
+			continue;
+
+		const unsigned int start = statsLine ? statsStart : afStart;
+		const unsigned int end = statsLine ? statsEnd : afEnd;
+		memcpy(lineBuffer_.data() + start, src + start, end - start);
+		memcpy(lineBuffer_.data() + stride_ + start, src + stride_ + start, end - start);
+
+		/* linePointers[0] is not used by any stats0_ functions */
+		linePointers[1] = lineBuffer_.data();
+		linePointers[2] = lineBuffer_.data() + stride_;
+		if (statsLine)
+			(this->*stats0_)(linePointers, stats_, zoneRowOf(y));
+		if (afLine)
+			processAfLine(y, linePointers, stats_);
+	}
+}
+
+/*
+ * Statistics of a frame in one go: the full statistics on the frames that
+ * want them, else the focus grid alone if it is wanted on every frame, else
+ * nothing. The result goes to out in any case.
+ */
+void RawStatsCpu::processFrame(uint32_t frame, MappedFrameBuffer &input, StatsBuffer *out)
+{
+	const bool stats = wantsFrame(frame);
+	const bool afOnly = !stats && afEveryFrame_ && afLine_ && afGridSize_.width;
+
+	if (!stats && !afOnly) {
+		finishFrame(frame, out);
+		return;
+	}
+
+	if (stats) {
+		afThisFrame_ = afEveryFrame_ || (afInterval_ && afCount_++ % afInterval_ == 0);
+		startFrame(frame);
+	} else {
+		/* Focus grid only */
+		afThisFrame_ = true;
+		statsThisFrame_ = false;
+		std::fill_n(stats_.afGrid.begin(), afGridSize_.width * afGridSize_.height, 0);
+	}
+
+	(this->*processFrame_)(input);
+	finishFrame(frame, out);
+
+	afThisFrame_ = true;
+	statsThisFrame_ = true;
+}
+
+} /* namespace libcamera */
diff --git a/src/libcamera/pipeline/mtkisp50/raw_stats_cpu.h b/src/libcamera/pipeline/mtkisp50/raw_stats_cpu.h
new file mode 100644
index 0000000..c54b38b
--- /dev/null
+++ b/src/libcamera/pipeline/mtkisp50/raw_stats_cpu.h
@@ -0,0 +1,186 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2023, Linaro Ltd
+ * Copyright (C) 2023, Red Hat Inc.
+ *
+ * CPU statistics of the mtkisp50 pipeline, on the raw frames of the capture
+ * device. Derived from the CPU statistics of the software ISP (SwStatsCpu),
+ * writing the statistics buffer layout of mtkisp50/stats.h.
+ */
+
+#pragma once
+
+#include <array>
+#include <algorithm>
+#include <stdint.h>
+#include <vector>
+
+#include <libcamera/geometry.h>
+
+#include "libcamera/internal/bayer_format.h"
+#include "libcamera/internal/mtkisp50/stats.h"
+#include "libcamera/internal/vector.h"
+
+namespace libcamera {
+
+class MappedFrameBuffer;
+struct StreamConfiguration;
+
+/* Accumulator of the line functions, the layout of the former SwIspStats */
+struct RawStatsAccumulator {
+	static constexpr unsigned int kZones = 15;
+	static constexpr unsigned int kYHistogramSize = 64;
+	static constexpr unsigned int kAfGridMaxWidth = 160;
+	static constexpr unsigned int kAfGridMaxHeight = 120;
+
+	RGB<uint64_t> sum_;
+	std::array<RGB<uint64_t>, kZones * kZones> zoneSum;
+	std::array<uint32_t, kZones * kZones> zoneCount;
+	std::array<uint32_t, kYHistogramSize> yHistogram;
+	std::array<uint32_t, kAfGridMaxWidth * kAfGridMaxHeight> afGrid;
+};
+
+class RawStatsCpu
+{
+public:
+	/* Statistics need a frame number that is a multiple of this */
+	static constexpr uint32_t kStatPerNumFrames = 4;
+
+	RawStatsCpu();
+	~RawStatsCpu() = default;
+
+	const Size &patternSize() { return patternSize_; }
+
+	int configure(const StreamConfiguration &inputCfg);
+	void setWindow(const Rectangle &window);
+	void setSampling(unsigned int linePairStep, unsigned int blockStep);
+	void setInterval(unsigned int frames, unsigned int afInterval, bool afEveryFrame = false);
+	void setAfRegion(unsigned int mode, const std::array<uint16_t, 4> &region);
+	bool wantsFrame(uint32_t frame) const { return frame % interval_ == 0; }
+	bool afEveryFrame() const { return afEveryFrame_; }
+
+	/*
+	 * Gather the statistics of a frame (or nothing, if the frame has
+	 * none) and write them to out.
+	 */
+	void processFrame(uint32_t frame, MappedFrameBuffer &input, mtkisp50::StatsBuffer *out);
+	/* Write the buffer of a frame without statistics */
+	void finishFrame(uint32_t frame, mtkisp50::StatsBuffer *out);
+
+	unsigned int bitDepth() const { return bitDepth_; }
+
+private:
+	using statsProcessFn = void (RawStatsCpu::*)(const uint8_t *src[], RawStatsAccumulator &stats,
+						      unsigned int zoneRow);
+	using processFrameFn = void (RawStatsCpu::*)(MappedFrameBuffer &in);
+	using afLineFn = void (RawStatsCpu::*)(const uint8_t *src[], uint32_t *grid);
+
+	/* Zone row of a line, y relative to the statistics window */
+	unsigned int zoneRowOf(unsigned int y) const
+	{
+		if (!window_.height)
+			return 0;
+		return std::min<unsigned int>(y * RawStatsAccumulator::kZones / window_.height,
+					      RawStatsAccumulator::kZones - 1);
+	}
+
+	void startFrame(uint32_t frame);
+
+	int setupStandardBayerOrder(BayerFormat::Order order);
+	/* Bayer 8 bpp unpacked */
+	void statsBGGR8Line0(const uint8_t *src[], RawStatsAccumulator &stats, unsigned int zoneRow);
+	/* Bayer 10 bpp unpacked */
+	void statsBGGR10Line0(const uint8_t *src[], RawStatsAccumulator &stats, unsigned int zoneRow);
+	/* Bayer 12 bpp unpacked */
+	void statsBGGR12Line0(const uint8_t *src[], RawStatsAccumulator &stats, unsigned int zoneRow);
+	/* Bayer 10 bpp packed */
+	void statsBGGR10PLine0(const uint8_t *src[], RawStatsAccumulator &stats, unsigned int zoneRow);
+	void statsGBRG10PLine0(const uint8_t *src[], RawStatsAccumulator &stats, unsigned int zoneRow);
+	/* Bayer 12 bpp packed */
+	void statsBGGR12PLine0(const uint8_t *src[], RawStatsAccumulator &stats, unsigned int zoneRow);
+	void statsGBRG12PLine0(const uint8_t *src[], RawStatsAccumulator &stats, unsigned int zoneRow);
+	/* Bayer 10 bpp MediaTek ISP packed (bit stream, LSB first) */
+	void statsBGGR10MtispLine0(const uint8_t *src[], RawStatsAccumulator &stats, unsigned int zoneRow);
+	void statsGBRG10MtispLine0(const uint8_t *src[], RawStatsAccumulator &stats, unsigned int zoneRow);
+
+	/* Focus grid */
+	void afLine8(const uint8_t *src[], uint32_t *grid);
+	void afLine16(const uint8_t *src[], uint32_t *grid);
+	void afLine10P(const uint8_t *src[], uint32_t *grid);
+	void afLine12P(const uint8_t *src[], uint32_t *grid);
+	void afLineMtisp10(const uint8_t *src[], uint32_t *grid);
+	void setupAfWindow();
+
+	/* y relative to the statistics window, already filtered by ySkipMask_ */
+	void processAfLine(unsigned int y, const uint8_t *src[], RawStatsAccumulator &stats)
+	{
+		const unsigned int row = y - afWindow_.y;
+
+		if (!afLine_ || row >= afWindow_.height)
+			return;
+
+		(this->*afLine_)(src, &stats.afGrid[row / afCellSize_ * afGridSize_.width]);
+	}
+
+	void processBayerFrame2(MappedFrameBuffer &in);
+	void setupZoneColumns();
+	void lineRange(unsigned int x, unsigned int width, unsigned int &start, unsigned int &end) const;
+	void writeHeader(uint32_t frame, mtkisp50::StatsBuffer *out) const;
+
+	processFrameFn processFrame_ = nullptr;
+
+	/* Variables set by configure(), used every line */
+	statsProcessFn stats0_ = nullptr;
+	bool swapLines_ = false;
+
+	unsigned int ySkipMask_ = 0;
+
+	Rectangle window_;
+
+	Size patternSize_;
+
+	unsigned int xShift_ = 0;
+	unsigned int stride_ = 0;
+	unsigned int sumShift_ = 0;
+	unsigned int bitDepth_ = 8;
+
+	/* Focus grid, set by configure() and setWindow() */
+	afLineFn afLine_ = nullptr;
+	bool afGreenOdd_ = true;
+	unsigned int afShift_ = 0;
+	Rectangle afWindow_;
+	Size afGridSize_;
+	unsigned int afCellSize_ = 0;
+
+	/* Zone column of each sampled block of a line, set by setWindow() */
+	std::vector<uint8_t> zoneColumns_;
+
+	/* Cached copy of the line pair processFrame() works on */
+	std::vector<uint8_t> lineBuffer_;
+
+	/* Bytes per pixel of the input format as a fraction, for line ranges */
+	unsigned int bytesNum_ = 1;
+	unsigned int bytesDen_ = 1;
+
+	/* Sampling and interval of processFrame() */
+	unsigned int linePairStep_ = 2;
+	unsigned int blockStep_ = 1;
+	unsigned int interval_ = kStatPerNumFrames;
+	unsigned int afInterval_ = 1;
+	unsigned int afCount_ = 0;
+	bool afThisFrame_ = true;
+	/* Focus grid also on the frames without statistics */
+	bool afEveryFrame_ = false;
+	/* The frame being processed gets the full statistics */
+	bool statsThisFrame_ = true;
+
+	/* Region of the focus grid, see setAfRegion() */
+	unsigned int afRegionMode_ = 0;
+	std::array<uint16_t, 4> afRegion_ = {};
+
+	Size inputSize_;
+
+	RawStatsAccumulator stats_;
+};
+
+} /* namespace libcamera */
diff --git a/src/libcamera/pipeline/mtkisp50/streams.cpp b/src/libcamera/pipeline/mtkisp50/streams.cpp
new file mode 100644
index 0000000..8d1aeef
--- /dev/null
+++ b/src/libcamera/pipeline/mtkisp50/streams.cpp
@@ -0,0 +1,283 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Stream assignment of the mtkisp50 pipeline
+ */
+
+#include "streams.h"
+
+#include <algorithm>
+#include <array>
+#include <stdint.h>
+#include <utility>
+
+#include <libcamera/formats.h>
+
+#include "libcamera/internal/formats.h"
+
+namespace libcamera {
+
+MtkIsp50StreamPlan::MtkIsp50StreamPlan(const std::vector<Size> &modes, bool ispAvailable,
+				       bool scaledAvailable)
+	: modes_(modes), ispAvailable_(ispAvailable), scaledAvailable_(scaledAvailable)
+{
+}
+
+/*
+ * Widths of the processed area the tile computation cannot serve, with or
+ * without the edge enhancement (see the DIP interface header); the driver
+ * rounds them down.
+ */
+unsigned int MtkIsp50StreamPlan::ispWidth(unsigned int width)
+{
+	static constexpr std::array<std::pair<unsigned int, unsigned int>, 7> kBands{ {
+		{ 690, 728 },
+		{ 1322, 1366 },
+		{ 1960, 2004 },
+		{ 2598, 2642 },
+		{ 3236, 3280 },
+		{ 3874, 3918 },
+		{ 4512, 4556 },
+	} };
+
+	for (const auto &[low, high] : kBands) {
+		if (width >= low && width <= high)
+			return low - 2;
+	}
+
+	return width;
+}
+
+/* An aspect ratio within 1 % of the mode takes the whole mode on that axis */
+Rectangle MtkIsp50StreamPlan::areaFor(const Size &mode, const Size &size)
+{
+	uint64_t width = mode.width;
+	uint64_t height = mode.height;
+
+	if (!size.isNull()) {
+		if (static_cast<uint64_t>(size.width) * mode.height >=
+		    static_cast<uint64_t>(size.height) * mode.width)
+			height = static_cast<uint64_t>(mode.width) * size.height / size.width;
+		else
+			width = static_cast<uint64_t>(mode.height) * size.width / size.height;
+
+		if (mode.height - height <= mode.height / 100)
+			height = mode.height;
+		if (mode.width - width <= mode.width / 100)
+			width = mode.width;
+	}
+
+	Size area(ispWidth(static_cast<unsigned int>(width) & ~1u),
+		  static_cast<unsigned int>(height) & ~1u);
+	area.expandTo(kIspMinSize);
+	area.boundTo(mode);
+
+	return Rectangle(static_cast<int>(((mode.width - area.width) / 2) & ~3u),
+			 static_cast<int>(((mode.height - area.height) / 2) & ~1u),
+			 area);
+}
+
+Size MtkIsp50StreamPlan::fitScaled(const Size &area, const Size &wanted)
+{
+	auto even = [](uint64_t v) { return v & ~static_cast<uint64_t>(1); };
+
+	const uint64_t minW = std::max<uint64_t>(kScaledMinSize.width,
+						 even((area.width + kScaleMaxDown - 1) / kScaleMaxDown + 1));
+	const uint64_t minH = std::max<uint64_t>(kScaledMinSize.height,
+						 even((area.height + kScaleMaxDown - 1) / kScaleMaxDown + 1));
+	const uint64_t maxW = std::max<uint64_t>(even(area.width / 2), minW);
+	const uint64_t maxH = std::max<uint64_t>(even(area.height / 2), minH);
+
+	if (wanted.isNull())
+		return Size(maxW, maxH);
+
+	uint64_t w = wanted.width;
+	uint64_t h = wanted.height;
+
+	/* The aspect ratio of the area, within 1 % or two lines */
+	const uint64_t hForW = w * area.height / area.width;
+	const uint64_t diff = hForW > h ? hForW - h : h - hForW;
+	if (diff > std::max<uint64_t>(2, h / 100)) {
+		if (w * area.height > h * area.width)
+			w = h * area.width / area.height;
+		else
+			h = hForW;
+	}
+
+	/* Down to the largest size the scaler gives, keeping the ratio */
+	if (w > maxW) {
+		h = h * maxW / w;
+		w = maxW;
+	}
+	if (h > maxH) {
+		w = w * maxH / h;
+		h = maxH;
+	}
+
+	w = std::clamp(even(w), minW, maxW);
+	h = std::clamp(even(h), minH, maxH);
+
+	return Size(static_cast<unsigned int>(w), static_cast<unsigned int>(h));
+}
+
+Size MtkIsp50StreamPlan::modeFor(const Size &size) const
+{
+	for (const Size &m : modes_) {
+		if (m.width >= size.width && m.height >= size.height)
+			return m;
+	}
+
+	return modes_.back();
+}
+
+CameraConfiguration::Status MtkIsp50StreamPlan::plan(std::vector<StreamConfiguration> &configs)
+{
+	CameraConfiguration::Status status = CameraConfiguration::Valid;
+
+	raw = main = scaled = -1;
+	mode = {};
+	crop = {};
+
+	if (configs.empty() || modes_.empty())
+		return CameraConfiguration::Invalid;
+
+	auto isRaw = [](const StreamConfiguration &cfg) {
+		return PixelFormatInfo::info(cfg.pixelFormat).colourEncoding ==
+		       PixelFormatInfo::ColourEncodingRAW;
+	};
+
+	/*
+	 * Raw streams first, then the processed ones; without the ISP the
+	 * first processed stream becomes the raw one if there is none.
+	 */
+	const unsigned int maxProcessed = !ispAvailable_ ? 0 : scaledAvailable_ ? 2 : 1;
+	int rawIndex = -1;
+	std::vector<unsigned int> processed;
+
+	for (unsigned int i = 0; i < configs.size(); i++) {
+		if (isRaw(configs[i]) && rawIndex < 0)
+			rawIndex = i;
+	}
+	for (unsigned int i = 0; i < configs.size(); i++) {
+		if (static_cast<int>(i) == rawIndex || isRaw(configs[i]))
+			continue;
+		if (processed.size() < maxProcessed)
+			processed.push_back(i);
+		else if (!ispAvailable_ && rawIndex < 0)
+			rawIndex = i;
+	}
+
+	std::vector<StreamConfiguration> kept;
+	auto keep = [&](unsigned int index) {
+		kept.push_back(configs[index]);
+		return static_cast<int>(kept.size() - 1);
+	};
+
+	/* Keep the order of the application */
+	std::vector<int> newIndex(configs.size(), -1);
+	for (unsigned int i = 0; i < configs.size(); i++) {
+		if (static_cast<int>(i) == rawIndex ||
+		    std::find(processed.begin(), processed.end(), i) != processed.end())
+			newIndex[i] = keep(i);
+	}
+
+	if (kept.size() != configs.size())
+		status = CameraConfiguration::Adjusted;
+
+	/* Processed streams to the outputs */
+	int mainIndex = -1;
+	int scaledIndex = -1;
+	if (processed.size() == 1) {
+		if (scaledAvailable_ && configs[processed[0]].pixelFormat == formats::YUYV)
+			scaledIndex = processed[0];
+		else
+			mainIndex = processed[0];
+	} else if (processed.size() == 2) {
+		const StreamConfiguration &a = configs[processed[0]];
+		const StreamConfiguration &b = configs[processed[1]];
+		const bool yuyvA = a.pixelFormat == formats::YUYV;
+		const bool yuyvB = b.pixelFormat == formats::YUYV;
+
+		bool aMain;
+		if (yuyvA != yuyvB)
+			aMain = yuyvB;
+		else
+			aMain = static_cast<uint64_t>(a.size.width) * a.size.height >=
+				static_cast<uint64_t>(b.size.width) * b.size.height;
+
+		mainIndex = aMain ? processed[0] : processed[1];
+		scaledIndex = aMain ? processed[1] : processed[0];
+	}
+
+	configs = std::move(kept);
+	raw = rawIndex >= 0 ? newIndex[rawIndex] : -1;
+	main = mainIndex >= 0 ? newIndex[mainIndex] : -1;
+	scaled = scaledIndex >= 0 ? newIndex[scaledIndex] : -1;
+
+	if (raw < 0 && main < 0 && scaled < 0)
+		return CameraConfiguration::Invalid;
+
+	/* The raw stream, else the main output, else the scaled one: the mode */
+	Size need;
+	if (raw >= 0) {
+		need = configs[raw].size;
+	} else if (main >= 0) {
+		need = configs[main].size;
+	} else {
+		const Size &size = configs[scaled].size;
+		if (!size.isNull())
+			need = Size(size.width * 2, size.height * 2);
+	}
+	mode = need.isNull() ? modes_.back() : modeFor(need);
+
+	if (raw >= 0 && configs[raw].size != mode) {
+		configs[raw].size = mode;
+		status = CameraConfiguration::Adjusted;
+	}
+
+	/* The processed area: a centred crop of the mode */
+	if (main >= 0) {
+		StreamConfiguration &cfg = configs[main];
+		Size size = cfg.size.isNull() ? mode : cfg.size;
+		size.boundTo(mode);
+		size.expandTo(kIspMinSize);
+		size.alignDownTo(2, 2);
+		size.width = ispWidth(size.width);
+
+		if (size != cfg.size) {
+			cfg.size = size;
+			status = CameraConfiguration::Adjusted;
+		}
+		if (cfg.pixelFormat != formats::NV12) {
+			cfg.pixelFormat = formats::NV12;
+			status = CameraConfiguration::Adjusted;
+		}
+
+		/*
+		 * Even coordinates keep the Bayer phase, a multiple of 4 pixels
+		 * horizontally also starts on a group of the packed format.
+		 */
+		crop = Rectangle(static_cast<int>(((mode.width - size.width) / 2) & ~3u),
+				 static_cast<int>(((mode.height - size.height) / 2) & ~1u),
+				 size);
+	} else if (scaled >= 0) {
+		crop = areaFor(mode, configs[scaled].size);
+	}
+
+	if (scaled >= 0) {
+		StreamConfiguration &cfg = configs[scaled];
+		Size size = fitScaled(crop.size(), cfg.size);
+
+		if (size != cfg.size) {
+			cfg.size = size;
+			status = CameraConfiguration::Adjusted;
+		}
+		if (cfg.pixelFormat != formats::YUYV) {
+			cfg.pixelFormat = formats::YUYV;
+			status = CameraConfiguration::Adjusted;
+		}
+	}
+
+	return status;
+}
+
+} /* namespace libcamera */
diff --git a/src/libcamera/pipeline/mtkisp50/streams.h b/src/libcamera/pipeline/mtkisp50/streams.h
new file mode 100644
index 0000000..7bf2a50
--- /dev/null
+++ b/src/libcamera/pipeline/mtkisp50/streams.h
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Stream assignment of the mtkisp50 pipeline: which stream goes to which
+ * output of the ISP, the sensor mode and the processed area
+ */
+
+#pragma once
+
+#include <vector>
+
+#include <libcamera/camera.h>
+#include <libcamera/geometry.h>
+#include <libcamera/stream.h>
+
+#include "frames.h"
+
+namespace libcamera {
+
+/*
+ * The DIP writes up to two processed outputs from one raw frame and one
+ * processed area (a crop of the sensor mode):
+ *  - main: NV12, the size of the processed area (no scaling);
+ *  - scaled: YUYV, 1/2 down to 1/16 of the processed area on each axis.
+ * A raw stream gives the frames of the capture device.
+ *
+ * With one processed stream, YUYV goes to the scaled output and any other
+ * format to the main output as NV12. With two, a YUYV stream next to one of
+ * another format goes to the scaled output, otherwise the larger one goes to
+ * the main output and the smaller one to the scaled output. The scaled
+ * stream keeps the aspect ratio of the processed area.
+ */
+class MtkIsp50StreamPlan
+{
+public:
+	/* Limits of the DIP */
+	static constexpr Size kIspMinSize{ 128, 64 };
+	static constexpr Size kScaledMinSize{ 32, 16 };
+	static constexpr unsigned int kScaleMaxDown = 16;
+
+	/*
+	 * Sensor modes in rising size; without the ISP every stream is raw,
+	 * without the scaled output there is one processed stream
+	 */
+	MtkIsp50StreamPlan(const std::vector<Size> &modes, bool ispAvailable,
+			   bool scaledAvailable = true);
+
+	/*
+	 * Assign the streams to the outputs, choose the sensor mode and the
+	 * processed area, bound the sizes and set the formats of the
+	 * processed streams. Streams beyond one raw and two processed ones
+	 * are dropped. The raw stream gets the size of the mode, its format
+	 * is left to the caller.
+	 */
+	CameraConfiguration::Status plan(std::vector<StreamConfiguration> &configs);
+
+	/* Results: indices into the configurations, -1 for none */
+	int raw = -1;
+	int main = -1;
+	int scaled = -1;
+	Size mode;
+	Rectangle crop;
+
+	unsigned int outputs() const
+	{
+		return (main >= 0 ? MtkIsp50OutputMain : 0) |
+		       (scaled >= 0 ? MtkIsp50OutputScaled : 0);
+	}
+
+	/* A width of the processed area the tile computation serves */
+	static unsigned int ispWidth(unsigned int width);
+	/* The largest centred area of the mode with the aspect ratio of @size */
+	static Rectangle areaFor(const Size &mode, const Size &size);
+	/* The scaled size for @wanted from @area: limits, aspect ratio, even */
+	static Size fitScaled(const Size &area, const Size &wanted);
+	/* The smallest mode covering @size, or the largest mode */
+	Size modeFor(const Size &size) const;
+
+private:
+	std::vector<Size> modes_;
+	bool ispAvailable_;
+	bool scaledAvailable_;
+};
+
+} /* namespace libcamera */
