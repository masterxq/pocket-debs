+++ b/src/libcamera/pipeline/mtkisp50/mtkisp50.cpp
@@ -0,0 +1,2008 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Pipeline handler for the MediaTek MT6785 camera subsystem with the ISP pass 2
+ * (DIP) as memory-to-memory ISP
+ *
+ * The capture side (sensor -> seninf -> CAMSV, media device "mtk-camsys-mt6785")
+ * writes raw Bayer frames to memory. The DIP (media device "mtk-dip") turns a
+ * raw frame and a parameter buffer into an NV12 frame of a crop of it (main
+ * output) and a YUYV frame scaled down from the same crop (scaled output),
+ * each job writing the outputs whose buffers the request has. The statistics for the
+ * IPA come from the CPU (RawStatsCpu) and are handed over in the statistics
+ * buffer layout of mtkisp50/stats.h, which a hardware statistics unit can fill
+ * as well.
+ *
+ * Per request: the raw frame is captured into a buffer of an internal pool (or
+ * the buffer of the raw stream), the IPA computes the parameters of the frame,
+ * then the raw buffer, the parameters and the output buffer go to the DIP; in
+ * parallel the CPU statistics of the raw frame go to the IPA, which returns the
+ * metadata and the sensor controls.
+ */
+
+#include <algorithm>
+#include <array>
+#include <map>
+#include <memory>
+#include <optional>
+#include <queue>
+#include <regex>
+#include <set>
+#include <string>
+#include <vector>
+
+#include <sys/mman.h>
+
+#include <linux/media-bus-format.h>
+#include <linux/media/mediatek/mtk-dip-mt6785.h>
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/log.h>
+#include <libcamera/base/memfd.h>
+#include <libcamera/base/object.h>
+#include <libcamera/base/thread.h>
+#include <libcamera/base/unique_fd.h>
+#include <libcamera/base/utils.h>
+
+#include <libcamera/camera.h>
+#include <libcamera/color_space.h>
+#include <libcamera/control_ids.h>
+#include <libcamera/formats.h>
+#include <libcamera/framebuffer.h>
+#include <libcamera/property_ids.h>
+#include <libcamera/request.h>
+#include <libcamera/stream.h>
+
+#include <libcamera/ipa/core_ipa_interface.h>
+#include <libcamera/ipa/mtkisp50_ipa_interface.h>
+#include <libcamera/ipa/mtkisp50_ipa_proxy.h>
+
+#include "libcamera/internal/bayer_format.h"
+#include "libcamera/internal/camera.h"
+#include "libcamera/internal/camera_lens.h"
+#include "libcamera/internal/camera_manager.h"
+#include "libcamera/internal/camera_sensor.h"
+#include "libcamera/internal/camera_sensor_properties.h"
+#include "libcamera/internal/delayed_controls.h"
+#include "libcamera/internal/device_enumerator.h"
+#include "libcamera/internal/dma_buf_allocator.h"
+#include "libcamera/internal/formats.h"
+#include "libcamera/internal/framebuffer.h"
+#include "libcamera/internal/global_configuration.h"
+#include "libcamera/internal/mapped_framebuffer.h"
+#include "libcamera/internal/media_device.h"
+#include "libcamera/internal/mtkisp50/stats.h"
+#include "libcamera/internal/pipeline_handler.h"
+#include "libcamera/internal/request.h"
+#include "libcamera/internal/v4l2_subdevice.h"
+#include "libcamera/internal/v4l2_videodevice.h"
+
+#include "frames.h"
+#include "raw_stats_cpu.h"
+#include "streams.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(MtkIsp50)
+
+namespace {
+
+/* Raw buffers of the internal pool, and the most requests in flight */
+constexpr unsigned int kRawBufferCount = 4;
+constexpr unsigned int kParamsBufferCount = 8;
+constexpr unsigned int kStatsBufferCount = 8;
+constexpr unsigned int kMaxQueuedRequests = kRawBufferCount;
+constexpr unsigned int kOutputBufferCount = 4;
+/* A raw frame of the full sensor mode (about 20 MB) */
+constexpr unsigned int kLargeRawFrame = 10 << 20;
+
+/* Cookies of the buffers mapped into the IPA */
+constexpr unsigned int kParamsCookie = 0x100;
+constexpr unsigned int kStatsCookie = 0x200;
+
+/* Default size of the viewfinder: the smallest sensor mode covering it */
+constexpr Size kViewfinderMinSize{ 1280, 720 };
+/* Default size of a video stream */
+constexpr Size kVideoSize{ 1920, 1080 };
+/* Fewer buffers of a large main output next to the scaled one (memory) */
+constexpr unsigned int kLargeOutputFrame = 12 << 20;
+constexpr unsigned int kLargeOutputBufferCount = 2;
+
+} /* namespace */
+
+class PipelineHandlerMtkIsp50;
+
+/* The DIP, shared by the cameras of the handler (one at a time) */
+class MtkIsp50Dip : public MtkIsp50IspQueue
+{
+public:
+	int init(MediaDevice *media);
+
+	bool supports(const V4L2PixelFormat &format) const
+	{
+		return rawFormats_.count(format);
+	}
+
+	int queueRaw(FrameBuffer *buffer) override
+	{
+		return raw_->queueBuffer(buffer);
+	}
+
+	int queueParams(FrameBuffer *buffer, uint32_t bytesused) override
+	{
+		buffer->_d()->metadata().planes()[0].bytesused = bytesused;
+		return params_->queueBuffer(buffer);
+	}
+
+	int queueOutput(FrameBuffer *buffer) override
+	{
+		return main_->queueBuffer(buffer);
+	}
+
+	int queueScaled(FrameBuffer *buffer) override
+	{
+		return scaled_->queueBuffer(buffer);
+	}
+
+	int setOutputs(unsigned int outputs) override;
+
+	bool hasScaled() const { return scaled_ != nullptr; }
+	V4L2VideoDevice *outputNode(unsigned int output) const
+	{
+		return output == MtkIsp50OutputMain ? main_.get() : scaled_.get();
+	}
+
+	/* Params, the outputs of the mask, then raw; stop in reverse */
+	int start(unsigned int outputs);
+	void stop();
+
+	std::unique_ptr<V4L2VideoDevice> raw_;
+	std::unique_ptr<V4L2VideoDevice> params_;
+	std::unique_ptr<V4L2VideoDevice> main_;
+	/* Optional: drivers before the scaled output do not have it */
+	std::unique_ptr<V4L2VideoDevice> scaled_;
+
+	/* Outputs that stream */
+	unsigned int streaming_ = 0;
+
+private:
+	std::set<V4L2PixelFormat> rawFormats_;
+};
+
+int MtkIsp50Dip::init(MediaDevice *media)
+{
+	raw_ = V4L2VideoDevice::fromEntityName(media, "mtk-dip-raw");
+	params_ = V4L2VideoDevice::fromEntityName(media, "mtk-dip-params");
+	main_ = V4L2VideoDevice::fromEntityName(media, "mtk-dip-main");
+	if (!raw_ || !params_ || !main_)
+		return -ENODEV;
+
+	int ret = raw_->open();
+	if (!ret)
+		ret = params_->open();
+	if (!ret)
+		ret = main_->open();
+	if (ret)
+		return ret;
+
+	if (media->getEntityByName("mtk-dip-scaled")) {
+		scaled_ = V4L2VideoDevice::fromEntityName(media, "mtk-dip-scaled");
+		ret = scaled_ ? scaled_->open() : -ENODEV;
+		if (ret) {
+			LOG(MtkIsp50, Warning)
+				<< "Scaled output not usable: " << strerror(-ret);
+			scaled_.reset();
+		}
+	}
+
+	for (const auto &[format, sizes] : raw_->formats())
+		rawFormats_.insert(format);
+
+	/* The parameters link is on by default but may be switched off */
+	MediaEntity *isp = media->getEntityByName("mtk-dip");
+	if (!isp)
+		return -ENODEV;
+
+	for (MediaPad *pad : isp->pads()) {
+		for (MediaLink *link : pad->links()) {
+			if (link->flags() & MEDIA_LNK_FL_ENABLED)
+				continue;
+
+			ret = link->setEnabled(true);
+			if (ret)
+				return ret;
+		}
+	}
+
+	return 0;
+}
+
+/*
+ * Switch the streaming outputs. Only between jobs: a job in the ISP takes a
+ * buffer of every streaming output.
+ */
+int MtkIsp50Dip::setOutputs(unsigned int outputs)
+{
+	for (unsigned int output : { MtkIsp50OutputMain, MtkIsp50OutputScaled }) {
+		V4L2VideoDevice *node = outputNode(output);
+		const bool want = outputs & output;
+		const bool on = streaming_ & output;
+
+		if (want == on)
+			continue;
+		if (!node)
+			return -ENODEV;
+
+		if (on) {
+			node->streamOff();
+			streaming_ &= ~output;
+		} else {
+			int ret = node->streamOn();
+			if (ret)
+				return ret;
+			streaming_ |= output;
+		}
+	}
+
+	return 0;
+}
+
+int MtkIsp50Dip::start(unsigned int outputs)
+{
+	int ret = params_->streamOn();
+	if (ret)
+		return ret;
+
+	ret = setOutputs(outputs);
+	if (ret)
+		return ret;
+
+	return raw_->streamOn();
+}
+
+void MtkIsp50Dip::stop()
+{
+	raw_->streamOff();
+	setOutputs(0);
+	params_->streamOff();
+}
+
+/* CPU statistics in a thread of their own */
+class MtkIsp50StatsWorker : public Object
+{
+public:
+	int configure(const StreamConfiguration &rawConfig, const Rectangle &window)
+	{
+		int ret = stats_.configure(rawConfig);
+		if (ret)
+			return ret;
+		stats_.setWindow(window);
+		return 0;
+	}
+
+	void process(uint32_t frame, FrameBuffer *raw, mtkisp50::StatsBuffer *out,
+		     const ipa::mtkisp50::StatsConfig &config, bool sync);
+	void clear() { rawMaps_.clear(); }
+
+	Signal<uint32_t> done;
+
+private:
+	RawStatsCpu stats_;
+	/* Raw buffers mapped for the statistics, kept while streaming */
+	std::map<const FrameBuffer *, std::unique_ptr<MappedFrameBuffer>> rawMaps_;
+};
+
+void MtkIsp50StatsWorker::process(uint32_t frame, FrameBuffer *raw,
+				  mtkisp50::StatsBuffer *out,
+				  const ipa::mtkisp50::StatsConfig &config, bool sync)
+{
+	/* Sparse sampling by default: the ISP does the image */
+	static constexpr unsigned int kLinePairStep = 8;
+	static constexpr unsigned int kBlockStep = 1;
+
+	std::array<uint16_t, 4> region{};
+	std::copy_n(config.afRegion.begin(), std::min<size_t>(config.afRegion.size(), 4),
+		    region.begin());
+
+	stats_.setSampling(config.linePairStep ? config.linePairStep : kLinePairStep,
+			   config.blockStep ? config.blockStep : kBlockStep);
+	stats_.setInterval(config.interval, config.afInterval, config.afEveryFrame);
+	stats_.setAfRegion(config.afRegionMode, region);
+
+	if (!stats_.wantsFrame(frame) && !config.afEveryFrame) {
+		stats_.finishFrame(frame, out);
+		done.emit(frame);
+		return;
+	}
+
+	std::unique_ptr<MappedFrameBuffer> &in = rawMaps_[raw];
+	if (!in)
+		in = std::make_unique<MappedFrameBuffer>(raw, MappedFrameBuffer::MapFlag::Read);
+
+	if (in->isValid()) {
+		if (sync) {
+			DmaSyncer syncer(raw->planes()[0].fd, DmaSyncer::SyncType::Read);
+			stats_.processFrame(frame, *in, out);
+		} else {
+			stats_.processFrame(frame, *in, out);
+		}
+	} else {
+		LOG(MtkIsp50, Error) << "Failed to map the raw buffer for the statistics";
+		rawMaps_.erase(raw);
+		stats_.finishFrame(frame, out);
+	}
+
+	done.emit(frame);
+}
+
+class MtkIsp50CameraData : public Camera::Private
+{
+public:
+	MtkIsp50CameraData(PipelineHandler *pipe)
+		: Camera::Private(pipe)
+	{
+	}
+
+	PipelineHandlerMtkIsp50 *pipe();
+
+	int init(MediaEntity *sensorEntity);
+	int loadIPA();
+
+	/* A subdevice between the sensor and the capture video node */
+	struct Entity {
+		MediaEntity *entity;
+		const MediaPad *sink;
+		const MediaPad *source;
+		std::unique_ptr<V4L2Subdevice> subdev;
+	};
+
+	std::unique_ptr<CameraSensor> sensor_;
+	std::vector<Entity> entities_;
+	std::unique_ptr<V4L2VideoDevice> video_;
+
+	/* Main output (NV12, a crop), scaled output (YUYV) and raw frames */
+	Stream outputStream_;
+	Stream scaledStream_;
+	Stream rawStream_;
+
+	/* Sensor modes in rising size */
+	std::vector<Size> modes_;
+
+	/* The DIP can process the frames of this camera and the IPA runs */
+	bool ispAvailable_ = false;
+	std::unique_ptr<ipa::mtkisp50::IPAProxyMtkIsp50> ipa_;
+	ControlInfoMap ipaControls_;
+	std::unique_ptr<DelayedControls> delayedCtrls_;
+
+	/* Configuration */
+	V4L2SubdeviceFormat sensorFormat_;
+	V4L2DeviceFormat rawFormat_;
+	BayerFormat rawBayer_;
+	Rectangle crop_;
+	/* The processed area in active pixel array coordinates */
+	Rectangle scalerCrop_;
+	/* Outputs of the ISP in the configuration (mask) */
+	unsigned int outputs_ = 0;
+	bool rawActive_ = false;
+	/* runIspJobs() is on the stack */
+	bool ispRunning_ = false;
+	/* stopDevice() runs: nothing new goes to the capture device */
+	bool stopping_ = false;
+
+	bool ispActive() const { return outputs_ != 0; }
+
+	/* Streaming */
+	std::vector<std::unique_ptr<FrameBuffer>> rawBuffers_;
+	std::queue<FrameBuffer *> availableRawBuffers_;
+	/* Requests waiting for a raw buffer of the pool */
+	std::queue<Request *> pendingRequests_;
+	std::vector<std::unique_ptr<FrameBuffer>> paramsBuffers_;
+	std::vector<std::unique_ptr<FrameBuffer>> statsBuffers_;
+	std::map<const FrameBuffer *, mtkisp50::StatsBuffer *> statsMaps_;
+	std::vector<IPABuffer> ipaBuffers_;
+	MtkIsp50Frames frames_;
+	std::map<unsigned int, bool> statsDone_;
+
+	void setSensorControls(uint32_t frame, const ControlList &sensorControls,
+			       const ControlList &lensControls);
+	void paramsComputed(uint32_t frame, uint32_t bytesused,
+			    const ipa::mtkisp50::StatsConfig &config);
+	void metadataReady(uint32_t frame, const ControlList &metadata);
+};
