+    lv: [ 5.0, 10.0 ]
+    rg: [ [ 1.3, 1.0 ], [ 1.1, 1.0 ] ]
+    bg: [ [ 0.6, 1.0 ], [ 0.8, 1.0 ] ]
+    fNumber: 2.0
+AwbModule:
+  algorithm: bayes
+  colourGains:
+    - ct: 2500
+      gains: [ 1.0, 3.0 ]
+    - ct: 4000
+      gains: [ 1.5, 2.0 ]
+    - ct: 6500
+      gains: [ 2.0, 1.5 ]
+  priors:
+    - lux: 0
+      ct: [ 2000, 8000 ]
+      probability: [ 1.0, 1.0 ]
+  AwbMode:
+    AwbAuto:
+      lo: 2500
+      hi: 6500
+  colourError: whitepoint
+  sensitivity: [ 1.1, 0.9 ]
+AwbRender:
+  algorithm: bayes
+  speed: 0.7
+  window: 2
+  colourGains:
+    - ct: 2000
+      gains: [ 0.8, 3.6 ]
+    - ct: 2500
+      gains: [ 1.0, 3.0 ]
+    - ct: 4000
+      gains: [ 1.5, 2.0 ]
+    - ct: 6500
+      gains: [ 2.0, 1.5 ]
+  priors:
+    - lux: 0
+      ct: [ 2000, 8000 ]
+      probability: [ 1.0, 1.0 ]
+  AwbMode:
+    AwbAuto:
+      lo: 2000
+      hi: 6500
+  transversePos: 0.06
+  transverseNeg: 0.06
+  colourError: whitepoint
+  rendering:
