+/*
+ * Regulation as tuned for the main camera (zone metering, speed, frame length
+ * extension by a factor of two from a gain of 8, the frame rate kept while
+ * the autofocus searches); the autofocus continuous.
+ */
+const char *kTuning = R"(%YAML 1.1
+---
+Agc:
+  maxExposureFactor: 3.0
+  exposureTarget: 0.18
+  exposureSpeed: 0.6
+  metering: zones
+  colourGains: false
+  afFrameRate: true
+  fNumber: 2.0
+  program:
+    preview: [ [ 10000, 2.0 ], [ 20000, 4.0 ], [ 30000, 8.0 ], [ 40000, 16.0 ], [ 60000, 32.0 ], [ 100000, 120.0 ] ]
+    video: [ [ 10000, 2.0 ], [ 20000, 3.0 ], [ 30000, 16.0 ], [ 40000, 64.0 ] ]
+    still: [ [ 10000, 2.0 ], [ 20000, 4.0 ], [ 30000, 8.0 ], [ 40000, 16.0 ], [ 60000, 32.0 ], [ 100000, 240.0 ] ]
+Af:
+  map: [ 0.1, 468, 10.0, 775 ]
+  default: 0.4
+  range: [ -0.8, 10.5 ]
+  step: 1.25
+  settleFrames: 2
+)";
+
+/* The same with the exposure time for images taken by hand: 30 ms up to a gain of 120 */
+const char *kHandheldTuning = R"(%YAML 1.1
+---
+Agc:
+  maxExposureFactor: 3.0
+  exposureTarget: 0.18
+  exposureSpeed: 0.6
+  metering: zones
+  colourGains: false
+  afFrameRate: true
+  fNumber: 2.0
+  program:
+    preview: [ [ 10000, 2.0 ], [ 20000, 4.0 ], [ 30000, 8.0 ], [ 40000, 16.0 ], [ 60000, 32.0 ], [ 100000, 120.0 ] ]
+    video: [ [ 10000, 2.0 ], [ 20000, 3.0 ], [ 30000, 16.0 ], [ 40000, 64.0 ] ]
+    still: [ [ 10000, 2.0 ], [ 20000, 4.0 ], [ 30000, 8.0 ], [ 40000, 16.0 ], [ 60000, 32.0 ], [ 100000, 240.0 ] ]
+    handheld: [ 30000, 120.0 ]
+Af:
+  map: [ 0.1, 468, 10.0, 775 ]
+  default: 0.4
+  range: [ -0.8, 10.5 ]
+  step: 1.25
