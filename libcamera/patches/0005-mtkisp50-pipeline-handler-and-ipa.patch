+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Temporal noise reduction of the mtkisp50 IPA: when a job starts a new
+ * reference, the settings per sensitivity, the block in the parameter buffer
+ * and the fallback for a driver without it
+ */
+
+#include <array>
+#include <cstring>
+#include <iostream>
+#include <memory>
+#include <string>
+#include <unistd.h>
+#include <vector>
+
+#include <libcamera/base/file.h>
+#include <libcamera/base/memfd.h>
+
+#include "libcamera/internal/yaml_parser.h"
+
+#include "mtkisp50/algorithms/temporal_denoise.h"
+#include "mtkisp50/dip_params.h"
+#include "mtkisp50/ipa_context.h"
+#include "mtkisp50/temporal_nr.h"
+
+#include "test.h"
+
+using namespace libcamera;
+using namespace libcamera::ipa::mtkisp50;
+
+namespace {
+
+/* Round values of our own, two points, no values of a device */
+const char *kTuning = R"(
+TemporalNoiseReduction:
+  restart:
+    exposureStops: 0.5
+    colourGain: 0.1
+    lensSteps: 2
+    frames: 3
+  preview:
+    points:
+      - iso: 100
+        luma_enable: 1
+        chroma_enable: 1
+        radial_link: 0
+        strength_max: 20
+        blend_ratio: [8, 8, 8, 8]
+        noise_level: 10
+        noise_slope: 20
+        small_diff_th: 10
+        motion_penalty_th: 30
+        motion_penalty_weight: 8
+        block_diff_th: 4
+        block_luma: [30, 30, 30, 20, 10, 0, 0, 0]
+        block_chroma: [20, 20, 10, 0, 0, 0, 0, 0]
+        texture_level: [0, 10, 20, 30, 30, 30, 30, 30]
+        detail_base: [30, 30, 20, 10, 0, 0, 0, 0]
+        texture_base: [0, 10, 20, 30, 30, 30, 30, 30]
+        motion_curve: [0, 4, 8, 12, 16, 20, 24, 28]
+        variance_weight: [16, 8, 4, 2, 1, 1, 1, 1]
+        smooth_weight: [0, 2, 4, 8, 12, 16, 16, 16]
+        diff_level: [60, 50, 40, 30, 20, 10, 5, 2, 0]
+        pattern_mode: 0
+        pattern_cycle: [3, 5, 7, 9]
+        pattern_texture_th: [2, 4, 6, 8]
+        pattern_texture_offset: 10
+      - iso: 1100
+        luma_enable: 1
+        chroma_enable: 1
+        radial_link: 1
+        strength_max: 40
+        blend_ratio: [8, 8, 8, 8]
+        noise_level: 30
+        noise_slope: 20
+        small_diff_th: 10
+        motion_penalty_th: 30
+        motion_penalty_weight: 8
+        block_diff_th: 4
+        block_luma: [30, 30, 30, 20, 10, 0, 0, 0]
+        block_chroma: [20, 20, 10, 0, 0, 0, 0, 0]
+        texture_level: [0, 10, 20, 30, 30, 30, 30, 30]
+        detail_base: [30, 30, 20, 10, 0, 0, 0, 0]
+        texture_base: [0, 10, 20, 30, 30, 30, 30, 30]
+        motion_curve: [0, 4, 8, 12, 16, 20, 24, 28]
+        variance_weight: [16, 8, 4, 2, 1, 1, 1, 1]
+        smooth_weight: [0, 2, 4, 8, 12, 16, 16, 16]
+        diff_level: [60, 50, 40, 30, 20, 10, 5, 2, 0]
+        pattern_mode: 2
+        pattern_cycle: [3, 5, 7, 9]
+        pattern_texture_th: [2, 4, 6, 8]
+        pattern_texture_offset: 10
+Broken:
+  preview:
+    points:
+      - iso: 100
+        luma_enable: 1
+)";
+
+/* The blocks of a parameter buffer by type */
+std::vector<const v4l2_isp_params_block_header *> blocksOf(const std::vector<uint8_t> &buf,
+							   size_t used)
+{
+	std::vector<const v4l2_isp_params_block_header *> blocks;
+	const auto *head = reinterpret_cast<const v4l2_isp_params_buffer *>(buf.data());
+	if (!used || head->data_size + sizeof(*head) != used)
+		return blocks;
+	for (size_t off = 0; off < head->data_size;) {
+		const auto *h = reinterpret_cast<const v4l2_isp_params_block_header *>(head->data + off);
+		blocks.push_back(h);
+		off += h->size;
+	}
+	return blocks;
+}
+
+const v4l2_isp_params_block_header *findBlock(const std::vector<const v4l2_isp_params_block_header *> &blocks,
+					      uint16_t type)
+{
+	for (const auto *h : blocks)
+		if (h->type == type)
+			return h;
+	return nullptr;
+}
+
+} /* namespace */
+
+class MtkIsp50TemporalNrTest : public Test
+{
+protected:
+	int init() override
+	{
+		UniqueFD fd = MemFd::create("mtkisp50-nr3d-tuning", 0);
+		if (!fd.isValid() || write(fd.get(), kTuning, strlen(kTuning)) < 0)
+			return TestFail;
+		File file("/proc/self/fd/" + std::to_string(fd.get()));
+		if (!file.open(File::OpenModeFlag::ReadOnly))
+			return TestFail;
+		tuning_ = YamlParser::parse(file);
+		return tuning_ ? TestPass : TestFail;
+	}
+
+	int run() override
+	{
+		if (testRestart() != TestPass || testTable() != TestPass ||
+		    testEncoder() != TestPass || testAlgorithm() != TestPass)
+			return TestFail;
+		return TestPass;
+	}
+
+private:
+	int testRestart()
+	{
+		TemporalNrRestart r;
+		TemporalNrRestart::Limits limits;
+		limits.exposureStops = 0.5;
+		limits.colourGain = 0.1;
+		limits.lensSteps = 2;
+		limits.frames = 3;
+		r.setLimits(limits);
+
+		TemporalNrRestart::State s;
+		s.exposure = 1000.0;
+		s.lensPosition = 100;
+
+		/* Steady and small steps: no restart; the first job neither */
+		if (r.update(s))
+			return fail("first job restarts");
+		for (int i = 0; i < 10; i++) {
+			s.exposure *= 1.2; /* 0.26 stops per job */
+			s.lensPosition = 100 + (i & 1);
+			if (r.update(s))
+				return fail("small changes restart");
+		}
+
+		/* An exposure jump restarts this job and the next two */
+		s.exposure *= 2.0;
+		std::array<bool, 5> got;
+		got[0] = r.update(s);
+		for (unsigned int i = 1; i < got.size(); i++)
+			got[i] = r.update(s);
+		if (!got[0] || !got[1] || !got[2] || got[3] || got[4])
+			return fail("exposure jump: restarts not 3 frames");
+
+		/* Darker as well */
+		s.exposure *= 0.6;
+		if (!r.update(s))
+			return fail("exposure drop does not restart");
+		r.update(s);
+		r.update(s);
+
+		/* A colour gain jump */
+		s.gains = { 1.0f, 1.0f, 1.2f };
+		if (!r.update(s))
+			return fail("white balance jump does not restart");
+		r.update(s);
+		r.update(s);
+		if (r.update(s))
+			return fail("restart lasts too long");
+
+		/* A moving lens restarts as long as it moves, and 2 jobs after */
+		unsigned int count = 0;
+		for (int i = 0; i < 6; i++) {
+			s.lensPosition = *s.lensPosition + 5;
+			count += r.update(s);
+		}
+		for (int i = 0; i < 4; i++)
+			count += r.update(s);
+		if (count != 8)
+			return fail("lens movement: " + std::to_string(count) + " restarts, not 8");
+
+		/* Without a lens no lens criterion */
+		TemporalNrRestart::State n = s;
+		n.lensPosition.reset();
+		r.update(n);
+		n.lensPosition.reset();
+		if (r.update(n))
+			return fail("no lens restarts");
+
+		/* Scene cut and a new stream */
+		r.trigger();
+		if (!r.update(n) || !r.update(n) || !r.update(n) || r.update(n))
+			return fail("trigger: not 3 frames");
+		r.trigger();
+		r.reset();
+		if (r.update(n))
+			return fail("reset keeps a pending restart");
+		n.exposure *= 4.0;
+		r.reset();
+		if (r.update(n))
+			return fail("reset keeps the last state");
+
+		return TestPass;
+	}
+
+	int testTable()
+	{
+		std::optional<TemporalNrTable> t =
+			TemporalNrTable::fromTuning((*tuning_)["TemporalNoiseReduction"]["preview"]["points"]);
+		if (!t || t->size() != 2)
+			return fail("table not read");
+
+		if (TemporalNrTable::fromTuning((*tuning_)["Broken"]["preview"]["points"]))
+			return fail("incomplete point accepted");
+
+		const mtk_dip_params_nr3d lo = t->at(50);
+		const mtk_dip_params_nr3d mid = t->at(600);
+		const mtk_dip_params_nr3d hi = t->at(5000);
+		if (lo.noise_level != 10 || hi.noise_level != 30 || mid.noise_level != 20 ||
+		    mid.strength_max != 30)
+			return fail("interpolation of the levels");
+		/* Switches and modes from the point below */
+		if (mid.radial_link != 0 || mid.pattern_mode != 0 || hi.pattern_mode != 2)
+			return fail("switches interpolated");
+		if (mid.header.type != MTK_DIP_PARAMS_BLOCK_NR3D ||
+		    mid.header.size != sizeof(mtk_dip_params_nr3d) ||
+		    mid.header.flags != MTK_DIP_PARAMS_BLOCK_FL_ENABLE || mid.flags != 0)
+			return fail("header of the block");
+
+		return TestPass;
+	}
+
+	int testEncoder()
+	{
+		std::optional<TemporalNrTable> t =
+			TemporalNrTable::fromTuning((*tuning_)["TemporalNoiseReduction"]["preview"]["points"]);
+		std::vector<uint8_t> buf(MTK_DIP_PARAMS_MAX_SIZE);
+		std::vector<uint8_t> small(4096);
+		DipFrameParams p;
+		p.nr3d = t->at(400);
+
+		/* A driver without the block: never in a buffer */
+		ParamsEncoder old;
+		old.setTemporalNr(false);
+		old.reset();
+		size_t used = old.encode(p, BayerFormat::BGGR, small);
+		if (!used || findBlock(blocksOf(small, used), MTK_DIP_PARAMS_BLOCK_NR3D))
+			return fail("block sent to a driver without it");
+		old.commit();
+		p.nr3d->flags = MTK_DIP_NR3D_FL_RESTART;
+		used = old.encode(p, BayerFormat::BGGR, small);
+		if (used)
+			return fail("old driver: a buffer for the restart");
+
+		/* No tuning: disabled once after reset, then nothing */
+		ParamsEncoder e;
+		e.setTemporalNr(true);
+		e.reset();
+		DipFrameParams off;
+		used = e.encode(off, BayerFormat::BGGR, buf);
+		const auto *h = findBlock(blocksOf(buf, used), MTK_DIP_PARAMS_BLOCK_NR3D);
+		if (!h || h->flags != MTK_DIP_PARAMS_BLOCK_FL_DISABLE)
+			return fail("not disabled after reset");
+		e.commit();
+		used = e.encode(off, BayerFormat::BGGR, buf);
+		if (used && findBlock(blocksOf(buf, used), MTK_DIP_PARAMS_BLOCK_NR3D))
+			return fail("disabled again");
+
+		/* On: sent once, then only on change */
+		p.nr3d->flags = 0;
+		used = e.encode(p, BayerFormat::BGGR, buf);
+		h = findBlock(blocksOf(buf, used), MTK_DIP_PARAMS_BLOCK_NR3D);
+		if (!h || h->flags != MTK_DIP_PARAMS_BLOCK_FL_ENABLE || h->size != sizeof(mtk_dip_params_nr3d))
+			return fail("enabled block missing");
+		e.commit();
+		if (e.encode(p, BayerFormat::BGGR, buf))
+			return fail("unchanged block sent again");
+
+		/* Restart in consecutive jobs: each buffer carries the flag */
+		p.nr3d->flags = MTK_DIP_NR3D_FL_RESTART;
+		for (int i = 0; i < 3; i++) {
+			used = e.encode(p, BayerFormat::BGGR, buf);
+			h = findBlock(blocksOf(buf, used), MTK_DIP_PARAMS_BLOCK_NR3D);
+			if (!h || !(reinterpret_cast<const mtk_dip_params_nr3d *>(h)->flags &
+				    MTK_DIP_NR3D_FL_RESTART))
+				return fail("restart " + std::to_string(i) + " not in the buffer");
+			e.commit();
+		}
+		/* The job after: the block without the flag */
+		p.nr3d->flags = 0;
+		used = e.encode(p, BayerFormat::BGGR, buf);
+		h = findBlock(blocksOf(buf, used), MTK_DIP_PARAMS_BLOCK_NR3D);
+		if (!h || reinterpret_cast<const mtk_dip_params_nr3d *>(h)->flags)
+			return fail("flag not cleared");
+		e.commit();
+
+		/* A still image: the module off, then on again */
+		used = e.encode(off, BayerFormat::BGGR, buf);
+		h = findBlock(blocksOf(buf, used), MTK_DIP_PARAMS_BLOCK_NR3D);
+		if (!h || h->flags != MTK_DIP_PARAMS_BLOCK_FL_DISABLE)
+			return fail("still job without disabling");
+		e.commit();
+		used = e.encode(p, BayerFormat::BGGR, buf);
+		h = findBlock(blocksOf(buf, used), MTK_DIP_PARAMS_BLOCK_NR3D);
+		if (!h || h->flags != MTK_DIP_PARAMS_BLOCK_FL_ENABLE)
+			return fail("not on again after the still job");
+
+		return TestPass;
+	}
+
+	int testAlgorithm()
+	{
+		IPAContext ctx(16);
+		algorithms::TemporalNoiseReduction algo;
+		if (algo.init(ctx, (*tuning_)["TemporalNoiseReduction"]))
+			return fail("init");
+
+		IPAConfigInfo info{};
+		info.paramsBufferSize = MTK_DIP_PARAMS_MAX_SIZE;
+		info.temporalNr = true;
+		ctx.activeState.agc.exposure = 1000;
+		ctx.activeState.agc.again = 4.0;
+		ctx.activeState.awb.gains = RGB<float>({ 2.0f, 1.0f, 1.5f });
+
+		IPAFrameContext fc{};
+		fc.digitalGain = 1.0;
+		DipFrameParams p;
+		p.totalGain = 6.0f;
+
+		/* Preview job: block for ISO 600 */
+		algo.configure(ctx, info);
+		p.useCase = static_cast<uint8_t>(UseCase::Preview);
+		algo.prepare(ctx, 1, fc, &p);
+		if (!p.nr3d || p.nr3d->noise_level != 20 || p.nr3d->flags || p.nr3d->motion_x)
+			return fail("preview job");
+
+		/* Still job: none */
+		p.useCase = static_cast<uint8_t>(UseCase::Still);
+		algo.prepare(ctx, 2, fc, &p);
+		if (p.nr3d)
+			return fail("still job with the module");
+
+		/* Exposure jump in a video job */
+		p.useCase = static_cast<uint8_t>(UseCase::Video);
+		ctx.activeState.agc.again = 16.0;
+		algo.prepare(ctx, 3, fc, &p);
+		if (!p.nr3d || !(p.nr3d->flags & MTK_DIP_NR3D_FL_RESTART))
+			return fail("exposure jump without restart");
+
+		/* Old driver (buffer of 4096 bytes), too few main buffers */
+		info.paramsBufferSize = 4096;
+		algo.configure(ctx, info);
+		p.useCase = static_cast<uint8_t>(UseCase::Preview);
+		algo.prepare(ctx, 4, fc, &p);
+		if (p.nr3d)
+			return fail("old driver with the module");
+		info.paramsBufferSize = MTK_DIP_PARAMS_MAX_SIZE;
+		info.temporalNr = false;
+		algo.configure(ctx, info);
+		algo.prepare(ctx, 5, fc, &p);
+		if (p.nr3d)
+			return fail("module without enough main buffers");
+
+		return TestPass;
+	}
+
+	int fail(const std::string &what)
+	{
+		std::cerr << "temporal noise reduction: " << what << std::endl;
+		return TestFail;
+	}
+
+	std::unique_ptr<ValueNode> tuning_;
+};
+
+TEST_REGISTER(MtkIsp50TemporalNrTest)
diff --git a/test/mtkisp50/unit_tuning.cpp b/test/mtkisp50/unit_tuning.cpp
new file mode 100644
index 0000000..79a8e48
--- /dev/null
+++ b/test/mtkisp50/unit_tuning.cpp
@@ -0,0 +1,325 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * The calibration of the single camera module over the tuning of mtkisp50:
+ * single keys replaced, missing, broken and unknown files, algorithms the
+ * tuning does not have
+ */
+
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <memory>
+#include <stdlib.h>
+#include <string>
+#include <unistd.h>
+#include <vector>
+
+#include <libcamera/base/file.h>
+#include <libcamera/base/memfd.h>
+
+#include "libcamera/internal/yaml_parser.h"
+
+#include "unit_tuning.h"
+
+#include "test.h"
+
+using namespace libcamera;
+using namespace libcamera::ipa::mtkisp50;
+
+namespace {
+
+/* Round values of our own, no values of a device */
+const char *kTuning = R"(
+version: 1
+algorithms:
+  - BlackLevel:
+  - Awb:
+      colourGains: [1.0, 1.0]
+      sensitivity: [1.0, 1.0, 1.0]
+      speed: 0.5
+  - LensShadingCorrection:
+      grid: [4, 4]
+      sets:
+        - ct: 3000
+          r: [1, 2, 3, 4]
+  - Ccm:
+      ccms:
+        - ct: 5000
+          ccm: [1, 0, 0, 0, 1, 0, 0, 0, 1]
+)";
+
+const char *kUnit = R"(
+version: 1
+source: 0123456789abcdef
+algorithms:
+  - Awb:
+      colourGains: [2.0, 1.5]
+      offset: 7
+  - LensShadingCorrection:
+      sets:
+        - ct: 4000
+          r: [5, 6, 7, 8]
+)";
+
+/* Broken files, each of them leaves the tuning as it is */
+const std::vector<std::pair<const char *, const char *>> kBroken = {
+	{ "syntax", "version: 1\nalgorithms: [ { Awb: { colourGains: [2.0, 1.5 } } ]\n" },
+	{ "empty", "" },
+	{ "list", "- version: 1\n" },
+	{ "no version", "algorithms:\n  - Awb:\n      colourGains: [2.0, 1.5]\n" },
+	{ "version 2", "version: 2\nalgorithms:\n  - Awb:\n      colourGains: [2.0, 1.5]\n" },
+	{ "version text", "version: one\nalgorithms:\n  - Awb:\n      colourGains: [2.0, 1.5]\n" },
+	{ "no algorithms", "version: 1\n" },
+	{ "algorithms no list", "version: 1\nalgorithms:\n  Awb:\n    colourGains: [2.0, 1.5]\n" },
+	{ "two keys", "version: 1\nalgorithms:\n  - Awb: { colourGains: [2.0, 1.5] }\n    Ccm: { ccms: [] }\n" },
+	{ "params no dictionary", "version: 1\nalgorithms:\n  - Awb: [2.0, 1.5]\n" },
+	/* A valid first algorithm does not get through with a broken second one */
+	{ "second broken", "version: 1\nalgorithms:\n  - Awb: { colourGains: [2.0, 1.5] }\n  - Ccm: 3\n" },
+};
+
+/* The tree as text, to compare whole tunings */
+void dump(const ValueNode &node, std::string &out)
+{
+	if (node.isValue()) {
+		out += "'" + node.get<std::string>("") + "'";
+	} else if (node.isList()) {
+		out += "[";
+		for (const ValueNode &child : node.asList()) {
+			dump(child, out);
+			out += ",";
+		}
+		out += "]";
+	} else if (node.isDictionary()) {
+		out += "{";
+		for (const auto &[key, child] : node.asDict()) {
+			out += key + ":";
+			dump(child, out);
+			out += ",";
+		}
+		out += "}";
+	} else {
+		out += "~";
+	}
+}
+
+std::string dump(const ValueNode &node)
+{
+	std::string out;
+	dump(node, out);
+	return out;
+}
+
+const ValueNode &algorithm(const ValueNode &tuning, const std::string &name)
+{
+	static const ValueNode empty;
+
+	for (const ValueNode &algo : tuning["algorithms"].asList()) {
+		if (algo.contains(name))
+			return algo[name];
+	}
+	return empty;
+}
+
+} /* namespace */
+
+class MtkIsp50UnitTuningTest : public Test
+{
+protected:
+	int init() override
+	{
+		char dir[] = "/tmp/libcamera.mtkisp50.XXXXXX";
+		if (!mkdtemp(dir))
+			return TestFail;
+		dir_ = dir;
+		tuning_ = parse(kTuning);
+		return tuning_ ? TestPass : TestFail;
+	}
+
+	int run() override
+	{
+		if (testFile() != TestPass || testApply() != TestPass ||
+		    testMissing() != TestPass || testBroken() != TestPass ||
+		    testUnknown() != TestPass)
+			return TestFail;
+		return TestPass;
+	}
+
+	void cleanup() override
+	{
+		unlink(path().c_str());
+		rmdir(dir_.c_str());
+	}
+
+private:
+	std::unique_ptr<ValueNode> parse(const char *text)
+	{
+		UniqueFD fd = MemFd::create("mtkisp50-unit-tuning", 0);
+		if (!fd.isValid() || write(fd.get(), text, strlen(text)) < 0)
+			return nullptr;
+		File file("/proc/self/fd/" + std::to_string(fd.get()));
+		if (!file.open(File::OpenModeFlag::ReadOnly))
+			return nullptr;
+		return YamlParser::parse(file);
+	}
+
+	std::string path() const
+	{
+		return dir_ + "/sensor-unit.yaml";
+	}
+
+	bool writeUnit(const char *text)
+	{
+		std::ofstream out(path(), std::ios::trunc);
+		out << text;
+		return out.good();
+	}
+
+	int testFile()
+	{
+		setenv("LIBCAMERA_MTKISP50_UNIT_DIR", dir_.c_str(), 1);
+		if (UnitTuning::file("sensor") != path())
+			return fail("directory of the environment not used: " +
+				    UnitTuning::file("sensor"));
+
+		unsetenv("LIBCAMERA_MTKISP50_UNIT_DIR");
+		const std::string def = UnitTuning::file("sensor");
+		if (def.find("/libcamera/ipa/mtkisp50/sensor-unit.yaml") == std::string::npos)
+			return fail("default path " + def);
+
+		return TestPass;
+	}
+
+	int testApply()
+	{
+		std::unique_ptr<ValueNode> tuning = parse(kTuning);
+		if (!tuning || !writeUnit(kUnit))
+			return fail("test data");
+
+		UnitTuning r = UnitTuning::apply(*tuning, path());
+		if (r.status != UnitTuning::Status::Applied || !r.unknown.empty())
+			return fail("valid file not applied");
+
+		const std::vector<std::string> keys = {
+			"Awb.colourGains", "Awb.offset", "LensShadingCorrection.sets",
+		};
+		if (r.keys != keys)
+			return fail("wrong list of keys");
+
+		/* Replaced keys */
+		const ValueNode &awb = algorithm(*tuning, "Awb");
+		if (awb["colourGains"].get<std::vector<double>>() != std::vector<double>{ 2.0, 1.5 })
+			return fail("colourGains not replaced");
+		const ValueNode &lsc = algorithm(*tuning, "LensShadingCorrection");
+		if (lsc["sets"].size() != 1 || lsc["sets"][0]["ct"].get<int>(0) != 4000 ||
+		    lsc["sets"][0]["r"].get<std::vector<int>>() != std::vector<int>{ 5, 6, 7, 8 })
+			return fail("sets not replaced as a whole");
+
+		/* A key only the file has */
+		if (awb["offset"].get<int>(0) != 7)
+			return fail("key of the file missing");
+
+		/* Keys and algorithms the file does not name */
+		if (awb["sensitivity"].get<std::vector<double>>() != std::vector<double>{ 1.0, 1.0, 1.0 } ||
+		    awb["speed"].get<double>(0.0) != 0.5 ||
+		    lsc["grid"].get<std::vector<int>>() != std::vector<int>{ 4, 4 })
+			return fail("key the file does not name changed");
+		if (dump(algorithm(*tuning, "Ccm")) != dump(algorithm(*tuning_, "Ccm")) ||
+		    dump(algorithm(*tuning, "BlackLevel")) != dump(algorithm(*tuning_, "BlackLevel")))
+			return fail("algorithm the file does not name changed");
+
+		/* Order of the algorithms and of the keys kept, one key per entry */
+		const char *order[] = { "BlackLevel", "Awb", "LensShadingCorrection", "Ccm" };
+		const ValueNode &algorithms = (*tuning)["algorithms"];
+		if (algorithms.size() != 4)
+			return fail("number of algorithms changed");
+		for (unsigned int i = 0; i < 4; i++) {
+			if (algorithms[i].size() != 1 || !algorithms[i].contains(order[i]))
+				return fail("order of the algorithms changed");
+		}
+		std::string awbKeys;
+		for (const auto &[key, value] : awb.asDict())
+			awbKeys += key + " ";
+		if (awbKeys != "colourGains sensitivity speed offset ")
+			return fail("order of the keys: " + awbKeys);
+
+		/* The same file once more gives the same tuning */
+		const std::string once = dump(*tuning);
+		UnitTuning::apply(*tuning, path());
+		if (dump(*tuning) != once)
+			return fail("second application differs");
+
+		return TestPass;
+	}
+
+	int testMissing()
+	{
+		std::unique_ptr<ValueNode> tuning = parse(kTuning);
+		unlink(path().c_str());
+
+		UnitTuning r = UnitTuning::apply(*tuning, path());
+		if (r.status != UnitTuning::Status::Missing || dump(*tuning) != dump(*tuning_))
+			return fail("missing file changed the tuning");
+
+		return TestPass;
+	}
+
+	int testBroken()
+	{
+		for (const auto &[what, text] : kBroken) {
+			std::unique_ptr<ValueNode> tuning = parse(kTuning);
+			if (!tuning || !writeUnit(text))
+				return fail("test data");
+
+			UnitTuning r = UnitTuning::apply(*tuning, path());
+			if (r.status != UnitTuning::Status::Invalid)
+				return fail(std::string("broken file accepted: ") + what);
+			if (dump(*tuning) != dump(*tuning_))
+				return fail(std::string("broken file changed the tuning: ") + what);
+		}
+
+		/* A directory in place of the file */
+		std::unique_ptr<ValueNode> tuning = parse(kTuning);
+		UnitTuning r = UnitTuning::apply(*tuning, dir_);
+		if (r.status != UnitTuning::Status::Invalid || dump(*tuning) != dump(*tuning_))
+			return fail("directory accepted");
+
+		return TestPass;
+	}
+
+	int testUnknown()
+	{
+		std::unique_ptr<ValueNode> tuning = parse(kTuning);
+		if (!tuning || !writeUnit("version: 1\n"
+					  "algorithms:\n"
+					  "  - Foo:\n"
+					  "      bar: 3\n"
+					  "  - Awb:\n"
+					  "      speed: 0.25\n"))
+			return fail("test data");
+
+		UnitTuning r = UnitTuning::apply(*tuning, path());
+		if (r.status != UnitTuning::Status::Applied ||
+		    r.unknown != std::vector<std::string>{ "Foo" } ||
+		    r.keys != std::vector<std::string>{ "Awb.speed" })
+			return fail("unknown algorithm not left out");
+
+		if ((*tuning)["algorithms"].size() != 4 || algorithm(*tuning, "Foo"))
+			return fail("unknown algorithm added");
+		if (algorithm(*tuning, "Awb")["speed"].get<double>(0.0) != 0.25)
+			return fail("known algorithm next to an unknown one not applied");
+
+		return TestPass;
+	}
+
+	int fail(const std::string &what)
+	{
+		std::cerr << what << std::endl;
+		return TestFail;
+	}
+
+	std::string dir_;
+	/* The tuning as read, to compare */
+	std::unique_ptr<ValueNode> tuning_;
+};
+
+TEST_REGISTER(MtkIsp50UnitTuningTest)
