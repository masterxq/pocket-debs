diff --git a/include/libcamera/ipa/mtkisp50.mojom b/include/libcamera/ipa/mtkisp50.mojom
new file mode 100644
index 0000000..5dab6ff
--- /dev/null
+++ b/include/libcamera/ipa/mtkisp50.mojom
@@ -0,0 +1,99 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+/*
+ * \todo Document the interface and remove the related EXCLUDE_PATTERNS entry.
+ */
+
+module ipa.mtkisp50;
+
+import "include/libcamera/ipa/core.mojom";
+
+/* What the processed stream is used for, selects the tuning sets */
+enum UseCase {
+	Preview = 0,
+	Video = 1,
+	Still = 2,
+};
+
+struct IPAConfigInfo {
+	libcamera.IPACameraSensorInfo sensorInfo;
+	libcamera.ControlInfoMap sensorControls;
+	libcamera.ControlInfoMap lensControls;
+	/* Raw frame written by the capture device */
+	libcamera.Size rawSize;
+	/* Area of the raw frame processed by the ISP */
+	libcamera.Rectangle ispCrop;
+	/* Bayer order of the raw frame (libcamera BayerFormat::Order) */
+	uint32 bayerOrder;
+	/* Bit depth of the raw samples */
+	uint32 bitDepth;
+	UseCase useCase;
+	/* Size of a parameter buffer of the ISP */
+	uint32 paramsBufferSize;
+	/* Layout of the statistics buffers (StatsSource in mtkisp50/stats.h) */
+	uint32 statsSource;
+};
+
+/*
+ * Configuration of the statistics for the coming frames. It is the same for
+ * the CPU statistics and a hardware statistics unit: the cell grid, the luma
+ * coefficients and pre-gains of the histogram, the focus area, and how often
+ * statistics are wanted.
+ */
+struct StatsConfig {
+	/* Cell grid in raw frame pixels; an empty grid keeps the default */
+	libcamera.Rectangle window;
+	libcamera.Size gridSize;
+	/* Luma coefficients (sum 16) and pre-gains (1.0 = 512), may be empty */
+	array<uint16> yCoeffs;
+	array<uint16> preGains;
+	/* Statistics every interval-th frame (multiple of 4, at least 4) */
+	uint8 interval;
+	uint8 linePairStep;
+	uint8 blockStep;
+	/* Focus blocks every afInterval-th statistics frame, 0: none */
+	uint8 afInterval;
+	/* Focus blocks on every frame, also between statistics frames */
+	bool afEveryFrame;
+	/* Focus area: 0 centred square (region[2] = side), 1 rectangle */
+	uint8 afRegionMode;
+	/* Focus area in 1/65536 of the sensor output */
+	array<uint16> afRegion;
+};
+
+/*
+ * Result of start(): the sensor and lens controls to apply before the first
+ * frame, empty when the IPA keeps what the devices have
+ */
+struct StartResult {
+	libcamera.ControlList sensorControls;
+	libcamera.ControlList lensControls;
+	int32 ret;
+};
+
+interface IPAMtkIsp50Interface {
+	init(libcamera.IPASettings settings,
+	     libcamera.IPACameraSensorInfo sensorInfo,
+	     libcamera.ControlInfoMap sensorControls,
+	     libcamera.ControlInfoMap lensControls)
+		=> (int32 ret, libcamera.ControlInfoMap ipaControls);
+	start(libcamera.ControlList controls) => (StartResult result);
+	stop();
+	configure(IPAConfigInfo configInfo)
+		=> (int32 ret, libcamera.ControlInfoMap ipaControls);
+
+	mapBuffers(array<libcamera.IPABuffer> buffers);
+	unmapBuffers(array<uint32> ids);
+
+	[async] queueRequest(uint32 frame, libcamera.ControlList controls);
+	[async] computeParams(uint32 frame, uint32 paramsBufferId);
+	[async] processStats(uint32 frame, uint32 statsBufferId,
+			     libcamera.ControlList sensorControls);
+};
+
+interface IPAMtkIsp50EventInterface {
+	setSensorControls(uint32 frame, libcamera.ControlList sensorControls,
+			  libcamera.ControlList lensControls);
+	paramsComputed(uint32 frame, uint32 bytesused, StatsConfig statsConfig);
+	metadataReady(uint32 frame, libcamera.ControlList metadata);
+};
