@@ -0,0 +1,145 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * mtkisp50 IPA: replay of recorded white balance statistics (tuning aid)
+ *
+ * Without the environment variable MTKISP50_AWB_REPLAY the test is skipped.
+ * MTKISP50_AWB_REPLAY=<tuning.yaml>:<zones.txt>[:<out.txt>]: the file of zones
+ * has one statistics frame per line, "t exposure gain digitalGain" followed
+ * by 225 zone means "r g b" above the black level (8-bit scale). The Awb and
+ * Ccm algorithms of the tuning run on them; per frame the colour temperature,
+ * the gains, the tint and the combined matrix are written out.
+ */
+
+#include <cmath>
+#include <cstdlib>
+#include <fstream>
+#include <iostream>
+#include <memory>
+#include <sstream>
+#include <string>
+
+#include <libcamera/base/file.h>
+
+#include <libcamera/control_ids.h>
+
+#include "libcamera/internal/yaml_parser.h"
+
+#include "mtkisp50/algorithms/awb.h"
+#include "mtkisp50/algorithms/ccm.h"
+#include "mtkisp50/ipa_context.h"
+
+#include "test.h"
+
+using namespace std::literals::chrono_literals;
+using namespace libcamera;
+using namespace libcamera::ipa::mtkisp50;
+
+class MtkIsp50AwbReplay : public Test
+{
+protected:
+	int run() override
+	{
+		const char *env = getenv("MTKISP50_AWB_REPLAY");
+		if (!env)
+			return TestSkip;
+
+		std::istringstream spec(env);
+		std::string tuningPath, zonesPath, outPath;
+		std::getline(spec, tuningPath, ':');
+		std::getline(spec, zonesPath, ':');
+		std::getline(spec, outPath, ':');
+
+		File file(tuningPath);
+		if (!file.open(File::OpenModeFlag::ReadOnly))
+			return TestFail;
+		std::unique_ptr<ValueNode> tuning = YamlParser::parse(file);
+		if (!tuning)
+			return TestFail;
+
+		const ValueNode *awbNode = nullptr, *ccmNode = nullptr;
+		for (const ValueNode &a : (*tuning)["algorithms"].asList()) {
+			if (a.contains("Awb"))
+				awbNode = &a["Awb"];
+			if (a.contains("Ccm"))
+				ccmNode = &a["Ccm"];
+		}
+		if (!awbNode || !ccmNode)
+			return TestFail;
+
+		IPAContext ctx(16);
+		algorithms::Awb awb;
+		algorithms::Ccm ccm;
+		if (ccm.init(ctx, *ccmNode) || awb.init(ctx, *awbNode))
+			return TestFail;
+
+		const uint8_t black = 16;
+		ctx.activeState.blc.level = black;
+		ctx.configuration.agc.lineDuration = 8.126us;
+		IPAConfigInfo config{};
+		awb.configure(ctx, config);
+
+		std::ifstream in(zonesPath);
+		std::ofstream outFile;
+		if (!outPath.empty())
+			outFile.open(outPath);
+		std::ostream &out = outPath.empty() ? std::cout : outFile;
+
+		auto stats = std::make_unique<Statistics>();
+		std::string line;
+		uint32_t frame = 0;
+		while (std::getline(in, line)) {
+			std::istringstream l(line);
+			double t, gain, digital;
+			int32_t exposure;
+			if (!(l >> t >> exposure >> gain >> digital))
+				continue;
+
+			constexpr uint32_t kCount = 1024;
+			Statistics &s = *stats;
+			s.valid = true;
+			s.sum_ = RGB<uint64_t>({ 0, 0, 0 });
+			for (unsigned int i = 0; i < Statistics::kZones * Statistics::kZones; i++) {
+				double r, g, b;
+				l >> r >> g >> b;
+				const double m[3] = { r, g, b };
+				for (unsigned int c = 0; c < 3; c++) {
+					s.zoneSum[i][c] = static_cast<uint64_t>(std::llround(std::max(m[c] + black, 0.0) * kCount));
+					s.sum_[c] += s.zoneSum[i][c];
+				}
+				s.zoneCount[i] = kCount;
+			}
+			s.yHistogram.fill(0);
+			s.yHistogram[0] = kCount * Statistics::kZones * Statistics::kZones;
+
+			ctx.activeState.agc.exposure = exposure;
+			ctx.activeState.agc.again = gain;
+			ctx.activeState.agc.digitalGain = digital;
+			ctx.activeState.agc.valid = true;
+
+			IPAFrameContext fc{};
+			DipFrameParams params{};
+			awb.prepare(ctx, frame, fc, &params);
+			fc.sensor.exposure = exposure;
+			fc.sensor.gain = gain;
+			fc.digitalGain = digital;
+			ControlList metadata(controls::controls);
+			awb.process(ctx, frame, fc, stats.get(), metadata);
+
+			ctx.activeState.combinedMatrix = Matrix<float, 3, 3>::identity();
+			ccm.prepare(ctx, frame, fc, &params);
+			const auto &a = ctx.activeState.awb;
+			const Matrix<float, 3, 3> &m = ctx.activeState.combinedMatrix;
+			out << t << ' ' << a.temperatureK << ' ' << a.gains.r() << ' ' << a.gains.b() << ' '
+			    << a.tint.r() << ' ' << a.tint.b();
+			for (unsigned int i = 0; i < 3; i++)
+				for (unsigned int j = 0; j < 3; j++)
+					out << ' ' << m[i][j];
+			out << '\n';
+			frame += 4;
+		}
+
+		return TestPass;
+	}
+};
+
+TEST_REGISTER(MtkIsp50AwbReplay)
diff --git a/test/mtkisp50/frames.cpp b/test/mtkisp50/frames.cpp
new file mode 100644
index 0000000..42b7cdc
--- /dev/null
+++ b/test/mtkisp50/frames.cpp
@@ -0,0 +1,431 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * mtkisp50 pipeline: per request bookkeeping and the order of the ISP queues
+ */
+
+#include <iostream>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <libcamera/framebuffer.h>
+
+#include "frames.h"
+
+#include "test.h"
+
+using namespace libcamera;
+
+namespace {
+
+/* Records the queue operations, fails the ones asked for */
+class RecordingQueue : public MtkIsp50IspQueue
+{
+public:
+	int queueRaw(FrameBuffer *buffer) override
+	{
+		log.push_back("raw:" + name(buffer));
+		return failRaw ? -EINVAL : 0;
+	}
+
+	int queueParams(FrameBuffer *buffer, uint32_t bytesused) override
+	{
+		log.push_back("params:" + name(buffer) + ":" + std::to_string(bytesused));
+		return failParams ? -EINVAL : 0;
+	}
+
+	int queueOutput(FrameBuffer *buffer) override
+	{
+		log.push_back("output:" + name(buffer));
+		return failOutput ? -EINVAL : 0;
+	}
+
+	int queueScaled(FrameBuffer *buffer) override
+	{
+		log.push_back("scaled:" + name(buffer));
+		return failScaled ? -EINVAL : 0;
+	}
+
+	int setOutputs(unsigned int outputs) override
+	{
+		log.push_back("outputs:" + std::to_string(outputs));
+		return failOutputs ? -EPIPE : 0;
+	}
+
+	std::string name(const FrameBuffer *buffer) const
+	{
+		return std::to_string(buffer->cookie());
+	}
+
+	std::vector<std::string> log;
+	bool failRaw = false;
+	bool failParams = false;
+	bool failOutput = false;
+	bool failScaled = false;
+	bool failOutputs = false;
+};
+
+std::vector<std::unique_ptr<FrameBuffer>> makeBuffers(unsigned int count, unsigned int first)
+{
+	std::vector<std::unique_ptr<FrameBuffer>> buffers;
+	for (unsigned int i = 0; i < count; i++) {
+		FrameBuffer::Plane plane;
+		plane.offset = 0;
+		plane.length = 4096;
+		buffers.push_back(std::make_unique<FrameBuffer>(
+			std::vector<FrameBuffer::Plane>{ plane }, first + i));
+	}
+	return buffers;
+}
+
+} /* namespace */
+
+class MtkIsp50FramesTest : public Test
+{
+protected:
+	int fail(const std::string &what)
+	{
+		std::cerr << what << std::endl;
+		return TestFail;
+	}
+
+	bool logIs(const RecordingQueue &queue, const std::vector<std::string> &expected)
+	{
+		if (queue.log == expected)
+			return true;
+
+		std::cerr << "queue log:";
+		for (const std::string &s : queue.log)
+			std::cerr << " " << s;
+		std::cerr << std::endl;
+		return false;
+	}
+
+	int run() override
+	{
+		auto params = makeBuffers(2, 100);
+		auto stats = makeBuffers(2, 200);
+		auto raw = makeBuffers(3, 300);
+		auto output = makeBuffers(3, 400);
+
+		MtkIsp50Frames frames;
+		frames.init(params, stats);
+
+		/* Order: raw, params, output; params left out without changes */
+		{
+			RecordingQueue queue;
+			MtkIsp50Frames::Info *a = frames.create(0, nullptr, raw[0].get(), false,
+								output[0].get());
+			MtkIsp50Frames::Info *b = frames.create(1, nullptr, raw[1].get(), false,
+								output[1].get());
+			if (!a || !b)
+				return fail("frames not created");
+
+			if (frames.create(2, nullptr, raw[2].get(), false, output[2].get()))
+				return fail("frame created without free params buffer");
+
+			if (frames.queueIspJob(a, 512, queue) || frames.queueIspJob(b, 0, queue))
+				return fail("queueing failed");
+
+			if (!logIs(queue, { "raw:300", "params:100:512", "output:400",
+					    "raw:301", "output:401" }))
+				return fail("wrong queue order");
+
+			if (!a->ispQueued || a->paramsDone || !b->paramsDone)
+				return fail("wrong state after queueing");
+
+			/* Buffers come back in any order */
+			if (frames.findIspRaw(raw[1].get()) != b || frames.findOutput(output[0].get()) != a ||
+			    frames.findParams(params[0].get()) != a || frames.findParams(params[1].get()))
+				return fail("lookup of queued buffers");
+
+			a->rawDone = true;
+			a->outputDone = true;
+			if (frames.tryComplete(a))
+				return fail("completed without params and metadata");
+
+			a->paramsDone = true;
+			a->metadataDone = true;
+			if (!frames.tryComplete(a))
+				return fail("not completed");
+
+			if (frames.find(0) || frames.freeParams() != 1 || frames.freeStats() != 1)
+				return fail("buffers not returned");
+
+			b->rawDone = true;
+			b->outputDone = true;
+			b->metadataDone = true;
+			if (!frames.tryComplete(b) || frames.size())
+				return fail("second frame not completed");
+		}
+
+		/* Raw only: no job */
+		{
+			RecordingQueue queue;
+			MtkIsp50Frames::Info *info = frames.create(5, nullptr, raw[2].get(), true, nullptr);
+			if (!info || frames.queueIspJob(info, 100, queue) || !queue.log.empty())
+				return fail("raw only frame queued to the ISP");
+
+			if (!info->rawDone || !info->paramsDone || !info->outputDone)
+				return fail("raw only frame not done");
+
+			info->metadataDone = true;
+			if (!frames.tryComplete(info))
+				return fail("raw only frame not completed");
+		}
+
+		/* Raw refused: nothing else queued, frame done with error */
+		{
+			RecordingQueue queue;
+			queue.failRaw = true;
+			MtkIsp50Frames::Info *info = frames.create(6, nullptr, raw[0].get(), false,
+								   output[0].get());
+			if (frames.queueIspJob(info, 100, queue) != -EINVAL)
+				return fail("raw failure not reported");
+
+			if (!logIs(queue, { "raw:300" }) || info->ispQueued || !info->error ||
+			    !info->outputDone || !info->paramsDone || !info->rawDone)
+				return fail("wrong state after raw failure");
+
+			info->metadataDone = true;
+			if (!frames.tryComplete(info))
+				return fail("failed frame not completed");
+		}
+
+		/* Params refused: the job runs with the previous parameters */
+		{
+			RecordingQueue queue;
+			queue.failParams = true;
+			MtkIsp50Frames::Info *info = frames.create(7, nullptr, raw[0].get(), false,
+								   output[0].get());
+			if (frames.queueIspJob(info, 100, queue))
+				return fail("params failure stopped the job");
+
+			if (!info->paramsDone || !info->ispQueued || info->error)
+				return fail("wrong state after params failure");
+
+			info->rawDone = info->outputDone = info->metadataDone = true;
+			frames.tryComplete(info);
+		}
+
+		/* Output refused: the raw buffer is in the ISP, the caller restarts it */
+		{
+			RecordingQueue queue;
+			queue.failOutput = true;
+			MtkIsp50Frames::Info *info = frames.create(8, nullptr, raw[0].get(), false,
+								   output[0].get());
+			if (frames.queueIspJob(info, 0, queue) != -EINVAL)
+				return fail("output failure not reported");
+
+			if (!info->ispQueued || !info->error || !info->outputDone ||
+			    frames.findIspRaw(raw[0].get()) != info)
+				return fail("wrong state after output failure");
+
+			/* The restart returns the raw buffer */
+			info->rawDone = true;
+			info->metadataDone = true;
+			if (!frames.tryComplete(info))
+				return fail("frame not completed after restart");
+		}
+
+		/* A pool buffer in use again while an earlier frame waits for metadata */
+		{
+			RecordingQueue queue;
+			MtkIsp50Frames::Info *a = frames.create(10, nullptr, raw[0].get(), false,
+								output[0].get());
+			a->captured = true;
+			frames.queueIspJob(a, 0, queue);
+			a->rawDone = true;
+			a->outputDone = true;
+
+			MtkIsp50Frames::Info *b = frames.create(11, nullptr, raw[0].get(), false,
+								output[1].get());
+			if (frames.findCapture(raw[0].get()) != b || frames.findIspRaw(raw[0].get()))
+				return fail("reused raw buffer found for the wrong frame");
+
+			if (frames.first() != a)
+				return fail("oldest frame");
+
+			frames.clear();
+			if (frames.size() || frames.freeParams())
+				return fail("clear");
+		}
+
+		return testScheduling();
+	}
+
+	/* Back from the ISP: the buffers of the job, as the handler sees them */
+	static void back(MtkIsp50Frames &frames, MtkIsp50Frames::Info *info)
+	{
+		info->rawDone = true;
+		info->outputDone = true;
+		info->scaledDone = true;
+		info->paramsDone = true;
+		frames.ispJobBack(info);
+		info->metadataDone = true;
+		frames.tryComplete(info);
+	}
+
+	/* Jobs with different outputs: switching only between jobs */
+	int testScheduling()
+	{
+		auto params = makeBuffers(8, 100);
+		auto stats = makeBuffers(8, 200);
+		auto raw = makeBuffers(4, 300);
+		auto main = makeBuffers(2, 400);
+		auto scaled = makeBuffers(4, 500);
+		constexpr unsigned int both = MtkIsp50OutputMain | MtkIsp50OutputScaled;
+
+		MtkIsp50Frames frames;
+		frames.init(params, stats);
+		frames.startIsp(both);
+		MtkIsp50Frames::Info *failed = nullptr;
+
+		/* Viewfinder, viewfinder + still, viewfinder: still waits for the ISP */
+		{
+			RecordingQueue queue;
+			auto *a = frames.create(0, nullptr, raw[0].get(), false, nullptr, scaled[0].get());
+			auto *b = frames.create(1, nullptr, raw[1].get(), false, main[0].get(),
+						scaled[1].get());
+			auto *c = frames.create(2, nullptr, raw[2].get(), false, nullptr, scaled[2].get());
+
+			if (MtkIsp50Frames::outputsOf(a) != MtkIsp50OutputScaled ||
+			    MtkIsp50Frames::outputsOf(b) != both)
+				return fail("outputs of the frames");
+
+			frames.submitIspJob(a, 64);
+			frames.submitIspJob(b, 64);
+			frames.submitIspJob(c, 0);
+			if (frames.runIspJobs(queue, &failed))
+				return fail("scheduling failed");
+
+			/* a switches the main output off, b waits for a */
+			if (!logIs(queue, { "outputs:2", "raw:300", "params:100:64", "scaled:500" }) ||
+			    frames.ispBusy() != 1 || frames.ispWaiting() != 2 ||
+			    frames.ispOutputs() != MtkIsp50OutputScaled)
+				return fail("first job");
+
+			/* Part of a back is not enough */
+			a->rawDone = true;
+			if (frames.ispJobBack(a) || frames.ispBusy() != 1)
+				return fail("job back with the output in the ISP");
+
+			queue.log.clear();
+			back(frames, a);
+			if (frames.ispBusy() || frames.runIspJobs(queue, &failed))
+				return fail("job not back");
+
+			/* b switches main on; c waits for b */
+			if (!logIs(queue, { "outputs:3", "raw:301", "params:101:64", "output:400",
+					    "scaled:501" }) ||
+			    frames.ispBusy() != 1 || frames.ispWaiting() != 1)
+				return fail("still job");
+
+			queue.log.clear();
+			back(frames, b);
+			if (frames.runIspJobs(queue, &failed) ||
+			    !logIs(queue, { "outputs:2", "raw:302", "scaled:502" }))
+				return fail("viewfinder after the still");
+
+			/* Same outputs: no switch, no wait */
+			auto *d = frames.create(3, nullptr, raw[3].get(), false, nullptr, scaled[3].get());
+			queue.log.clear();
+			frames.submitIspJob(d, 0);
+			if (frames.runIspJobs(queue, &failed) ||
+			    !logIs(queue, { "raw:303", "scaled:503" }) || frames.ispBusy() != 2)
+				return fail("jobs with the same outputs");
+
+			back(frames, c);
+			back(frames, d);
+			if (frames.ispBusy() || frames.size())
+				return fail("frames left");
+		}
+
+		/* Held (stop, restart): nothing goes */
+		{
+			RecordingQueue queue;
+			auto *a = frames.create(10, nullptr, raw[0].get(), false, main[0].get(),
+						scaled[0].get());
+			frames.holdIsp(true);
+			frames.submitIspJob(a, 0);
+			if (frames.runIspJobs(queue, &failed) || !queue.log.empty())
+				return fail("job queued while held");
+
+			frames.holdIsp(false);
+			if (frames.runIspJobs(queue, &failed) ||
+			    !logIs(queue, { "outputs:3", "raw:300", "output:400", "scaled:500" }))
+				return fail("job not queued after the hold");
+			back(frames, a);
+		}
+
+		/* Outputs refused: the frame fails alone, the next one tries again */
+		{
+			RecordingQueue queue;
+			queue.failOutputs = true;
+			auto *a = frames.create(20, nullptr, raw[0].get(), false, nullptr, scaled[0].get());
+			auto *b = frames.create(21, nullptr, raw[1].get(), false, nullptr, scaled[1].get());
+			frames.submitIspJob(a, 0);
+			frames.submitIspJob(b, 0);
+
+			if (frames.runIspJobs(queue, &failed) != -EPIPE || failed != a ||
+			    !a->error || a->ispQueued || !a->rawDone || !a->scaledDone ||
+			    frames.ispWaiting() != 1)
+				return fail("refused outputs");
+
+			queue.failOutputs = false;
+			queue.log.clear();
+			if (frames.runIspJobs(queue, &failed) ||
+			    !logIs(queue, { "outputs:2", "raw:301", "scaled:501" }))
+				return fail("next job after refused outputs");
+
+			a->metadataDone = true;
+			if (!frames.tryComplete(a))
+				return fail("failed frame not completed");
+			back(frames, b);
+		}
+
+		/* Scaled refused: main is in the ISP, the restart returns it */
+		{
+			RecordingQueue queue;
+			queue.failScaled = true;
+			auto *a = frames.create(30, nullptr, raw[0].get(), false, main[0].get(),
+						scaled[0].get());
+			frames.submitIspJob(a, 0);
+			if (frames.runIspJobs(queue, &failed) != -EINVAL || failed != a ||
+			    !a->ispQueued || !a->outputQueued || a->scaledQueued ||
+			    a->outputDone || !a->scaledDone || frames.ispBusy() != 1)
+				return fail("refused scaled buffer");
+
+			if (frames.findOutput(main[0].get()) != a || frames.findScaled(scaled[0].get()))
+				return fail("lookup after refused scaled buffer");
+
+			back(frames, a);
+			if (frames.ispBusy() || frames.size())
+				return fail("frame after restart");
+		}
+
+		/* A waiting frame removed (stop) leaves the queue */
+		{
+			RecordingQueue queue;
+			auto *a = frames.create(40, nullptr, raw[0].get(), false, main[0].get(), nullptr);
+			auto *b = frames.create(41, nullptr, raw[1].get(), false, nullptr, scaled[1].get());
+			frames.submitIspJob(a, 0);
+			frames.submitIspJob(b, 0);
+			frames.runIspJobs(queue, &failed);
+			if (frames.ispWaiting() != 1)
+				return fail("frame not waiting");
+
+			frames.remove(b);
+			if (frames.ispWaiting())
+				return fail("removed frame still waiting");
+
+			frames.clear();
+			if (frames.ispBusy() || frames.ispWaiting())
+				return fail("clear of the scheduling");
+		}
+
+		return TestPass;
+	}
+};
+
+TEST_REGISTER(MtkIsp50FramesTest)
