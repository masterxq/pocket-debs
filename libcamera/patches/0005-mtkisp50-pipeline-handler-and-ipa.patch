+/*
+ * Statistics for the search along the colour temperature curve: the means of
+ * the colour channels above the black level, grey world like, as the rkisp1
+ * IPA does with its single AWB window.
+ */
+class SoftAwbStats final : public AwbStats
+{
+public:
+	SoftAwbStats(const RGB<double> &rgbMeans, bool whitePoint)
+		: rgbMeans_(rgbMeans), whitePoint_(whitePoint)
+	{
+		rg_ = rgbMeans_.r() / rgbMeans_.g();
+		bg_ = rgbMeans_.b() / rgbMeans_.g();
+	}
+
+	double computeColourError(const RGB<double> &gains) const override
+	{
+		/*
+		 * Either the relative error of the corrected means (as rkisp1),
+		 * or the distance of the measured white point R/G, B/G from the
+		 * white point of the gains, the space the curve is given in.
+		 */
+		const double deltaR = whitePoint_ ? 1.0 / gains.r() - rg_ : gains.r() * rg_ - 1.0;
+		const double deltaB = whitePoint_ ? 1.0 / gains.b() - bg_ : gains.b() * bg_ - 1.0;
+
+		return deltaR * deltaR + deltaB * deltaB;
+	}
+
+	RGB<double> rgbMeans() const override
+	{
+		return rgbMeans_;
+	}
+
+private:
+	RGB<double> rgbMeans_;
+	bool whitePoint_;
+	double rg_;
+	double bg_;
+};
+
+} /* namespace */
+
+/**
+ * \brief Read the optional tuning parameters
+ *
+ * Without parameters the gains come from the grey world of the statistics,
+ * limited to 4.0. With "algorithm: bayes" the gains are searched along a curve
+ * of colour gains over the colour temperature (libipa AwbBayes, tuning keys
+ * colourGains, priors, AwbMode, transversePos, transverseNeg as for rkisp1):
+ * only plausible light sources result, and the colour temperature handed to
+ * the Ccm algorithm is the one of the curve. As the software ISP measures no
+ * lux the prior of the lowest lux entry applies.
+ *
+ * - speed: share of a new result taken per statistics frame (0.0 to 1.0,
+ *   default 1.0), smooths the gains and the colour temperature
+ * - minSnr, lowSnr: confidence of the channel means (curve search). The
+ *   means of the last "window" statistics frames (default 4) are averaged
+ *   per unit of exposure (exposure lines times analogue gain, so that a
+ *   change of exposure or of the split between analogue and digital gain
+ *   within the window does not matter) and compared with their noise:
+ *   "blackError" (default 0.25, 8-bit scale), the uncertainty of the black
+ *   level, and the noise of the samples, "readVariance" plus "shotVariance"
+ *   times the mean (defaults 0.12 and 0.06, 8-bit scale) divided by the
+ *   number of samples. At the signal to noise ratio minSnr (default 4.0) of
+ *   the weakest channel the estimate counts fully; between lowSnr (default
+ *   1.5) and minSnr with a speed reduced in proportion; below lowSnr the last
+ *   estimate is held. The first estimate after the start counts fully.
+ * - minMean: additionally a smallest mean of a colour channel above the black
+ *   level, on the 8-bit scale (default 0.0, none)
+ * - sensitivity: [R/G, B/G] of the module relative to the module the curve
+ *   was made for (calibration data of the module, default [1.0, 1.0]); the
+ *   means are corrected before the search, the gains after it
+ * - startTemperature: colour temperature of the gains before the first
+ *   estimate of the camera (default 5000); later configurations start with
+ *   the last estimate
+ * - preference (curve search, mode auto): the colour that a neutral surface
+ *   keeps under warm light, as output R/G and B/G over the colour
+ *   temperature and the light value (see AwbPreference); "fNumber" (default
+ *   2.0) for the light value. Applied by the Ccm algorithm after the colour
+ *   matrix, without it on the colour gains.
+ * - colourError (curve search): "gains" (default, relative error of the
+ *   corrected means, as rkisp1) or "whitepoint" (distance of the measured
+ *   R/G, B/G from the white point of the curve)
+ * - transversePos, transverseNeg (curve search, as AwbBayes, default 0.01):
+ *   how far the white point may lie off the curve, in R/G and B/G units.
+ *   With colourError "whitepoint" the white point is fitted exactly: the
+ *   nearest point of the curve to the measured R/G, B/G (in mired, within
+ *   the range of the AwbMode) plus the offset across the curve up to these
+ *   limits. The steps of the AwbBayes search are only its start: they are
+ *   0.01 R/G, B/G apart across the curve, a jump of 3 % of B/G under warm
+ *   light, which the colour matrix doubles.
+ * - rendering (curve search): "band", "speed", "switch" (mired; defaults 0,
+ *   1.0, 0: the estimate itself): the colour temperature for the colour
+ *   matrix and the preference follows the estimate only beyond "band"
+ *   mired, with "speed" per statistics frame; beyond "switch" mired (a new
+ *   light) it goes all the way to the estimate with the speed of the
+ *   gains. The gains always follow the estimate, so the slow drift of a
+ *   light does not change the rendering while neutral surfaces stay
+ *   neutral. The colour temperature in the metadata is the rendering one.
+ * - maxZoneLevel (curve search): zones of the statistics grid with a channel
+ *   mean above this share of the range above the black level do not count
+ *   (default 1.0, all count): a lamp in the picture is clipped and grey
+ * - statistics (curve search): "mean" (default, the whole statistics window)
+ *   or "zones": only the zones of the statistics zone grid whose white point
+ *   lies within greyDistance (default 0.02, in R/G and B/G) of the curve and
+ *   that are neither dark (minMean) nor near saturation count, so that
+ *   coloured surfaces do not pull the estimate along the curve; without such
+ *   zones the whole window is used
+ */
+int Awb::init(IPAContext &context, const ValueNode &tuningData)
+{
+	context.ctrlMap[&controls::AwbEnable] = ControlInfo(false, true, true);
+	context.ctrlMap[&controls::ColourGains] = ControlInfo(0.0f, 8.0f);
+
+	speed_ = tuningData["speed"].get<double>(1.0);
+	minMean_ = tuningData["minMean"].get<double>(0.0);
+	minSnr_ = tuningData["minSnr"].get<double>(4.0);
+	lowSnr_ = tuningData["lowSnr"].get<double>(1.5);
+	blackError_ = tuningData["blackError"].get<double>(0.25);
+	readVariance_ = tuningData["readVariance"].get<double>(0.12);
+	shotVariance_ = tuningData["shotVariance"].get<double>(0.06);
+	window_ = tuningData["window"].get<unsigned int>(4);
+	startTemperature_ = tuningData["startTemperature"].get<double>(5000.0);
+	if (!(speed_ > 0.0 && speed_ <= 1.0) || !(minMean_ >= 0.0) ||
+	    !(lowSnr_ >= 0.0 && minSnr_ > lowSnr_) || !(blackError_ >= 0.0) ||
+	    !(readVariance_ >= 0.0) || !(shotVariance_ >= 0.0) || window_ < 1 || window_ > 64 ||
+	    !(startTemperature_ >= 1000.0 && startTemperature_ <= 20000.0)) {
+		LOG(IPAMtkIsp50Awb, Error) << "Invalid Awb speed, minMean, snr, noise, window or startTemperature";
+		return -EINVAL;
+	}
+
+	if (tuningData.contains("sensitivity")) {
+		auto v = tuningData["sensitivity"].get<std::vector<double>>();
+		if (!v || v->size() != 2 || !((*v)[0] > 0.5 && (*v)[0] < 2.0) ||
+		    !((*v)[1] > 0.5 && (*v)[1] < 2.0)) {
+			LOG(IPAMtkIsp50Awb, Error) << "Invalid Awb sensitivity";
+			return -EINVAL;
+		}
+		sensitivity_ = RGB<double>({ (*v)[0], 1.0, (*v)[1] });
+	}
+
+	const std::string algorithm = tuningData["algorithm"].get<std::string>("grey");
+	if (algorithm == "grey")
+		return 0;
+
+	if (algorithm != "bayes") {
+		LOG(IPAMtkIsp50Awb, Error) << "Unknown Awb algorithm " << algorithm;
+		return -EINVAL;
+	}
+
+	curve_ = std::make_unique<AwbBayes>();
+	int ret = curve_->init(tuningData);
+	if (ret) {
+		LOG(IPAMtkIsp50Awb, Error) << "Awb: invalid colour temperature curve";
+		return ret;
+	}
+
+	const std::string error = tuningData["colourError"].get<std::string>("gains");
+	const std::string statistics = tuningData["statistics"].get<std::string>("mean");
+	greyDistance_ = tuningData["greyDistance"].get<double>(0.02);
+	if ((error != "gains" && error != "whitepoint") ||
+	    (statistics != "mean" && statistics != "zones") || !(greyDistance_ > 0.0)) {
+		LOG(IPAMtkIsp50Awb, Error) << "Invalid Awb colourError, statistics or greyDistance";
+		return -EINVAL;
+	}
+	whitePointError_ = error == "whitepoint";
+	zones_ = statistics == "zones";
+	maxZoneLevel_ = tuningData["maxZoneLevel"].get<double>(1.0);
+	if (!(maxZoneLevel_ > 0.0 && maxZoneLevel_ <= 1.0)) {
+		LOG(IPAMtkIsp50Awb, Error) << "Invalid Awb maxZoneLevel";
+		return -EINVAL;
+	}
+	transversePos_ = tuningData["transversePos"].get<double>(0.01);
+	transverseNeg_ = tuningData["transverseNeg"].get<double>(0.01);
+
+	modeRanges_.clear();
+	if (tuningData.contains("AwbMode")) {
+		for (const auto &[name, node] : tuningData["AwbMode"].asDict()) {
+			const auto it = controls::AwbModeNameValueMap.find(name);
+			if (it == controls::AwbModeNameValueMap.end())
+				continue;
+			modeRanges_[it->second] = { node["lo"].get<double>(2000.0), node["hi"].get<double>(10000.0) };
+		}
+	}
+	mode_ = controls::AwbAuto;
+
+	if (tuningData.contains("rendering")) {
+		const ValueNode &r = tuningData["rendering"];
+		renderBand_ = r["band"].get<double>(0.0);
+		renderSpeed_ = r["speed"].get<double>(1.0);
+		renderSwitch_ = r["switch"].get<double>(0.0);
+		if (!(renderBand_ >= 0.0) || !(renderSpeed_ > 0.0 && renderSpeed_ <= 1.0) ||
+		    !(renderSwitch_ >= 0.0)) {
+			LOG(IPAMtkIsp50Awb, Error) << "Invalid Awb rendering";
+			return -EINVAL;
+		}
+	}
+
+	/* White points along the curve for the zone selection */
+	whitePoints_.clear();
+	double ctMin = 1e9, ctMax = 0.0;
+	for (const ValueNode &p : tuningData["colourGains"].asList()) {
+		const double ct = p["ct"].get<double>(0.0);
+		ctMin = std::min(ctMin, ct);
+		ctMax = std::max(ctMax, ct);
+	}
+	for (double ct = ctMin; ct <= ctMax; ct += 10.0) {
+		auto g = curve_->gainsFromColourTemperature(ct);
+		if (g && g->r() > 0.0 && g->b() > 0.0)
+			whitePoints_.push_back({ 1.0 / g->r(), 1.0 / g->b() });
+	}
+
+	if (tuningData.contains("preference")) {
+		preference_ = AwbPreference::fromTuning(tuningData["preference"]);
+		fNumber_ = tuningData["preference"]["fNumber"].get<double>(2.0);
+		if (!preference_ || !(fNumber_ > 0.0)) {
+			LOG(IPAMtkIsp50Awb, Error) << "Invalid Awb preference";
+			return -EINVAL;
+		}
+	}
+
+	for (const auto &[id, info] : curve_->controls())
+		context.ctrlMap[id] = info;
+	context.ctrlMap[&controls::ColourTemperature] = ControlInfo(2000, 10000, 5000);
+
+	LOG(IPAMtkIsp50Awb, Info) << "Awb: search along the colour temperature curve";
+
+	return 0;
+}
+
+int Awb::configure(IPAContext &context,
+		   [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	auto &gains = context.activeState.awb.gains;
+	gains = { { 1.0, 1.0, 1.0 } };
+	context.activeState.awb.temperatureK = 0;
+	context.activeState.awb.tint = RGB<float>({ 1.0f, 1.0f, 1.0f });
+	samples_.clear();
+
+	if (curve_) {
+		renderMired_ = 0.0;
+		renderSwitching_ = false;
+		if (haveEstimate_) {
+			/* Where the last stream of the camera ended */
+			gains = lastGains_;
+			context.activeState.awb.temperatureK = lastTemperature_;
+			if (lastTemperature_)
+				renderMired_ = 1e6 / lastTemperature_;
+		} else {
+			auto start = curve_->gainsFromColourTemperature(startTemperature_);
+			if (start) {
+				gains = applied(*start);
+				context.activeState.awb.temperatureK = startTemperature_;
+			}
+		}
+		updateTint(context);
+	}
+
+	return 0;
+}
+
+void Awb::queueRequest(IPAContext &context,
+		       [[maybe_unused]] const uint32_t frame,
+		       [[maybe_unused]] IPAFrameContext &frameContext,
+		       const ControlList &controls)
+{
+	if (curve_)
+		curve_->handleControls(controls);
+	if (const auto &v = controls.get(controls::AwbMode)) {
+		autoMode_ = *v == controls::AwbAuto;
+		mode_ = *v;
+	}
+
+	if (const auto &v = controls.get(controls::AwbEnable)) {
+		enabled_ = *v;
+		if (enabled_) {
+			manualGains_.reset();
+			manualTemperature_.reset();
+		}
+	}
+
+	/* Fixed gains: either directly or from a colour temperature */
+	if (const auto &v = controls.get(controls::ColourGains)) {
+		manualGains_ = RGB<float>({ (*v)[0], 1.0f, (*v)[1] });
+		manualTemperature_.reset();
+	}
+	if (const auto &v = controls.get(controls::ColourTemperature); v && curve_) {
+		auto g = curve_->gainsFromColourTemperature(*v);
+		if (g) {
+			manualGains_ = applied(*g);
+			manualTemperature_ = *v;
+		}
+	}
+
+	if (!enabled_ && manualGains_) {
+		context.activeState.awb.gains = *manualGains_;
+		context.activeState.awb.tint = RGB<float>({ 1.0f, 1.0f, 1.0f });
+		if (manualTemperature_)
+			context.activeState.awb.temperatureK = *manualTemperature_;
+		else
+			context.activeState.awb.temperatureK = estimateCCT(
+				RGB<double>({ 1.0 / manualGains_->r(), 1.0, 1.0 / manualGains_->b() }));
+	}
+}
+
+void Awb::prepare(IPAContext &context,
+		  [[maybe_unused]] const uint32_t frame,
+		  IPAFrameContext &frameContext,
+		  DipFrameParams *params)
+{
+	auto &gains = context.activeState.awb.gains;
+
+	frameContext.gains = gains;
+	params->gains = gains;
+	/* Without a colour matrix the preference goes on the gains */
+	if (!context.ccmEnabled) {
+		const RGB<float> &tint = context.activeState.awb.tint;
+		params->gains = RGB<float>({ gains.r() * tint.r(), gains.g(), gains.b() * tint.b() });
+	}
+}
+
+/* Gains for the module from gains of the curve */
+RGB<float> Awb::applied(const RGB<double> &curveGains) const
+{
+	return RGB<float>({ static_cast<float>(curveGains.r() / sensitivity_.r()), 1.0f,
+			    static_cast<float>(curveGains.b() / sensitivity_.b()) });
+}
+
+/*
+ * Output colour of a neutral surface for the colour temperature of the
+ * moment and the light value of the scene (neutral without a preference,
+ * with fixed gains or another mode than auto)
+ */
+void Awb::updateTint(IPAContext &context) const
+{
+	auto &tint = context.activeState.awb.tint;
+	tint = RGB<float>({ 1.0f, 1.0f, 1.0f });
+	if (!preference_ || !enabled_ || !autoMode_ || !context.activeState.awb.temperatureK)
+		return;
+
+	std::optional<double> lv;
+	const auto &agc = context.activeState.agc;
+	const double t = utils::Duration(context.configuration.agc.lineDuration * agc.exposure).get<std::ratio<1>>();
+	if (agc.valid && t > 0.0 && agc.again > 0.0)
+		lv = lightValue(fNumber_, t, agc.again * agc.digitalGain, agc.levelRatio);
+
+	const RGB<double> p = preference_->tint(context.activeState.awb.temperatureK, lv);
+	tint = RGB<float>({ static_cast<float>(p.r()), 1.0f, static_cast<float>(p.b()) });
+}
+
+/*
+ * Means of the zones without the bright ones (a lamp in the picture, clipped
+ * or nearly so, is grey in the statistics and pulls the estimate towards the
+ * curve's middle). Returns the number of samples behind \a means; leaves
+ * \a means unchanged and returns \a n if no zone remains.
+ */
+double Awb::brightZonesExcluded(const Statistics *stats, double black, RGB<double> &means, double n) const
+{
+	const double limit = maxZoneLevel_ * (255.0 - black);
+	RGB<double> sum({ 0.0, 0.0, 0.0 });
+	uint64_t count = 0;
+	for (unsigned int i = 0; i < Statistics::kZones * Statistics::kZones; i++) {
+		const uint32_t c = stats->zoneCount[i];
+		if (!c)
+			continue;
+		RGB<double> m;
+		for (unsigned int k = 0; k < 3; k++)
+			m[k] = stats->zoneSum[i][k] / static_cast<double>(c) - black;
+		if (std::max({ m.r(), m.g(), m.b() }) > limit)
+			continue;
+		sum += m * static_cast<double>(c);
+		count += c;
+	}
+	if (!count)
+		return n;
+	means = sum / static_cast<double>(count);
+	return static_cast<double>(count);
+}
+
+/* White point R/G, B/G of the curve at a colour temperature */
+std::optional<std::pair<double, double>> Awb::curveWhite(double temperatureK) const
+{
+	auto g = curve_->gainsFromColourTemperature(temperatureK);
+	if (!g || !(g->r() > 0.0) || !(g->b() > 0.0))
+		return std::nullopt;
+	return std::make_pair(1.0 / g->r(), 1.0 / g->b());
+}
+
+/*
+ * Exact fit of the measured R/G, B/G (sensitivity of the curve) to the curve:
+ * from \a temperatureK (the AwbBayes result) the nearest point of the curve in
+ * steps of 0.25 mired within 12 mired and the range of the mode, refined by a
+ * parabola, then the offset across the curve within the transverse limits.
+ * Returns false if the curve cannot be evaluated there.
+ */
+bool Awb::fitCurve(const RGB<double> &measured, double &temperatureK, RGB<double> &gains) const
+{
+	if (!(measured.g() > 0.0) || !(temperatureK > 0.0))
+		return false;
+	const double rm = measured.r() / measured.g();
+	const double bm = measured.b() / measured.g();
+
+	double loMired = 1e6 / 20000.0, hiMired = 1e6 / 1000.0;
+	if (auto it = modeRanges_.find(mode_); it != modeRanges_.end()) {
+		loMired = 1e6 / it->second.second;
+		hiMired = 1e6 / it->second.first;
+	}
+
+	/* Distance in the logarithm, so that R/G and B/G count relatively */
+	auto distance = [&](double mired) -> double {
+		auto w = curveWhite(1e6 / mired);
+		if (!w)
+			return 1e9;
+		const double dr = std::log(rm / w->first);
+		const double db = std::log(bm / w->second);
+		return dr * dr + db * db;
+	};
+
+	constexpr double kStep = 0.25;
+	constexpr int kSteps = 48;
+	const double m0 = 1e6 / temperatureK;
+	double best = 1e9, bestMired = m0;
+	for (int i = -kSteps; i <= kSteps; i++) {
+		const double m = std::clamp(m0 + i * kStep, loMired, hiMired);
+		const double d = distance(m);
+		if (d < best) {
+			best = d;
+			bestMired = m;
+		}
+	}
+	if (best >= 1e9)
+		return false;
+
+	/* Parabola through the neighbours */
+	const double dl = distance(bestMired - kStep);
+	const double dr = distance(bestMired + kStep);
+	const double den = dl - 2.0 * best + dr;
+	if (den > 0.0 && dl < 1e9 && dr < 1e9)
+		bestMired += std::clamp(0.5 * kStep * (dl - dr) / den, -kStep, kStep);
+	bestMired = std::clamp(bestMired, loMired, hiMired);
+
+	const double t = 1e6 / bestMired;
+	auto w = curveWhite(t);
+	auto wLo = curveWhite(1e6 / (bestMired + 1.0));
+	auto wHi = curveWhite(1e6 / std::max(bestMired - 1.0, 1.0));
+	if (!w || !wLo || !wHi)
+		return false;
+
+	/* Across the curve as AwbBayes: (dB, -dR) over a rising temperature */
+	double nr = wHi->second - wLo->second;
+	double nb = -(wHi->first - wLo->first);
+	const double len = std::hypot(nr, nb);
+	double r = w->first, b = w->second;
+	if (len > 0.0) {
+		nr /= len;
+		nb /= len;
+		const double offset = std::clamp((rm - r) * nr + (bm - b) * nb, -transverseNeg_, transversePos_);
+		r += offset * nr;
+		b += offset * nb;
+	}
+	if (!(r > 0.0) || !(b > 0.0))
+		return false;
+
+	temperatureK = t;
+	gains = RGB<double>({ 1.0 / r, 1.0, 1.0 / b });
+	return true;
+}
+
+/*
+ * The colour temperature of the rendering from the estimate (see init()),
+ * in kelvin
+ */
+unsigned int Awb::render(double temperatureK)
+{
+	const double m = 1e6 / temperatureK;
+	if (!renderMired_ || !(renderBand_ > 0.0 || renderSpeed_ < 1.0)) {
+		renderMired_ = m;
+	} else {
+		const double d = m - renderMired_;
+		const double beyond = std::abs(d) - renderBand_;
+		/* A new light: go all the way to the estimate, at the speed of the gains */
+		if (renderSwitch_ > 0.0 && std::abs(d) > renderSwitch_)
+			renderSwitching_ = true;
+		if (renderSwitching_) {
+			renderMired_ += std::max(speed_, renderSpeed_) * d;
+			if (std::abs(m - renderMired_) < 1.0)
+				renderSwitching_ = false;
+		} else if (beyond > 0.0) {
+			renderMired_ += std::copysign(renderSpeed_ * beyond, d);
+		}
+	}
+	return static_cast<unsigned int>(std::lround(1e6 / renderMired_));
+}
+
+/*
+ * Sum of the zones near the curve; leaves \a means unchanged and returns 0
+ * if there are none
+ */
+unsigned int Awb::greyZoneMeans(const Statistics *stats, double black, RGB<double> &means) const
+{
+	RGB<double> sum({ 0.0, 0.0, 0.0 });
+	uint64_t count = 0;
+	unsigned int zones = 0;
+
+	for (unsigned int i = 0; i < Statistics::kZones * Statistics::kZones; i++) {
+		const uint32_t n = stats->zoneCount[i];
+		if (!n)
+			continue;
+
+		RGB<double> m;
+		for (unsigned int c = 0; c < 3; c++)
+			m[c] = stats->zoneSum[i][c] / static_cast<double>(n) - black;
+
+		/* Dark zones are noise, bright ones may be clipped in a channel */
+		const double lo = std::min({ m.r(), m.g(), m.b() });
+		const double hi = std::max({ m.r(), m.g(), m.b() });
+		if (lo < std::max(minMean_, minSnr_ * blackError_) || hi > 0.9 * (255.0 - black))
+			continue;
+
+		const double r = m.r() / m.g();
+		const double b = m.b() / m.g();
+		double best = 1e9;
+		for (const auto &[wr, wb] : whitePoints_)
+			best = std::min(best, (wr - r) * (wr - r) + (wb - b) * (wb - b));
+		if (best > greyDistance_ * greyDistance_)
+			continue;
+
+		sum += m * static_cast<double>(n);
+		count += n;
+		zones++;
+	}
+
+	if (!zones || !count)
+		return 0;
+
+	means = sum / static_cast<double>(count);
+	return zones;
+}
+
+void Awb::process(IPAContext &context,
+		  [[maybe_unused]] const uint32_t frame,
+		  IPAFrameContext &frameContext,
+		  const Statistics *stats,
+		  ControlList &metadata)
+{
+	const Statistics::Histogram &histogram = stats->yHistogram;
+	const uint8_t blackLevel = context.activeState.blc.level;
+
+	metadata.set(controls::ColourGains, { frameContext.gains.r(),
+					      frameContext.gains.b() });
+	if (context.activeState.awb.temperatureK)
+		metadata.set(controls::ColourTemperature, context.activeState.awb.temperatureK);
+	metadata.set(controls::AwbEnable, enabled_);
+
+	/* Fixed or held gains */
+	if (!stats->valid)
+		return;
+
+	/* The raw statistics, also with fixed gains, for the tuning */
+	if (_LOG_CATEGORY(IPAMtkIsp50AwbZones)().severity() <= LogDebug) {
+		std::ostringstream z;
+		z.precision(4);
+		for (unsigned int i = 0; i < Statistics::kZones * Statistics::kZones; i++) {
+			const double n = std::max<uint32_t>(stats->zoneCount[i], 1);
+			z << ' ' << stats->zoneSum[i].r() / n - blackLevel << ',' << stats->zoneSum[i].g() / n - blackLevel
+			  << ',' << stats->zoneSum[i].b() / n - blackLevel;
+		}
+		LOG(IPAMtkIsp50AwbZones, Debug)
+			<< "frame " << frame << " exposure " << frameContext.sensor.exposure << " gain "
+			<< frameContext.sensor.gain << " digital " << frameContext.digitalGain << " zones" << z.str();
+	}
+
+	if (!enabled_)
+		return;
+
+	/*
+	 * Black level must be subtracted to get the correct AWB ratios, they
+	 * would be off if they were computed from the whole brightness range
+	 * rather than from the sensor range.
+	 */
+	const uint64_t nPixels = std::accumulate(
+		histogram.begin(), histogram.end(), uint64_t(0));
+	const uint64_t offset = blackLevel * nPixels;
+	const uint64_t minValid = 1;
+	/*
+	 * Make sure the sums are at least minValid, while preventing unsigned
+	 * integer underflow.
+	 */
+	const RGB<uint64_t> sum = stats->sum_.max(offset + minValid) - offset;
+
+	auto &gains = context.activeState.awb.gains;
+
+	if (curve_) {
+		double n = std::max<uint64_t>(nPixels, 1);
+		RGB<double> means{ { sum.r() / n, sum.g() / n, sum.b() / n } };
+		if (maxZoneLevel_ < 1.0)
+			n = brightZonesExcluded(stats, blackLevel, means, n);
+
+		/*
+		 * Means per unit of exposure, averaged over the window, back in
+		 * the units of this frame
+		 */
+		const double exposure = std::max(frameContext.sensor.exposure * frameContext.sensor.gain, 1e-3);
+		Sample sample;
+		for (unsigned int c = 0; c < 3; c++) {
+			sample.means[c] = means[c] / exposure;
+			sample.randomVariance[c] = (readVariance_ + shotVariance_ * std::max(means[c], 0.0)) /
+						   n / (exposure * exposure);
+		}
+		samples_.push_back(sample);
+		while (samples_.size() > window_)
+			samples_.pop_front();
+
+		RGB<double> avg({ 0.0, 0.0, 0.0 });
+		RGB<double> var({ 0.0, 0.0, 0.0 });
+		for (const Sample &s : samples_) {
+			avg += s.means;
+			var += s.randomVariance;
+		}
+		const double k = static_cast<double>(samples_.size());
+		double snr = 1e9;
+		RGB<double> measured;
+		for (unsigned int c = 0; c < 3; c++) {
+			measured[c] = avg[c] / k * exposure;
+			const double sigma = std::sqrt(blackError_ * blackError_ +
+						       var[c] / (k * k) * exposure * exposure);
+			snr = std::min(snr, sigma > 0.0 ? measured[c] / sigma : 1e9);
+			if (measured[c] < minMean_)
+				snr = 0.0;
+		}
+
+		if (snr < lowSnr_) {
+			LOG(IPAMtkIsp50Awb, Debug)
+				<< "Too dark for Awb, means " << means << " window " << measured
+				<< " snr " << snr << ", held";
+			updateTint(context);
+			return;
+		}
+		const double weight = std::min((snr - lowSnr_) / (minSnr_ - lowSnr_), 1.0);
+
+		unsigned int greyZones = 0;
+		if (zones_)
+			greyZones = greyZoneMeans(stats, blackLevel, measured);
+
+		/* Into the sensitivity of the module of the curve */
+		measured = RGB<double>({ measured.r() / sensitivity_.r(), measured.g(),
+					 measured.b() / sensitivity_.b() });
+
+		AwbResult result = curve_->calculateAwb(SoftAwbStats(measured, whitePointError_), 0);
+		if (whitePointError_)
+			fitCurve(measured, result.colourTemperature, result.gains);
+		const RGB<float> target = applied(result.gains);
+		/* The first estimate of the camera counts fully */
+		const double speed = haveEstimate_ ? speed_ * weight : 1.0;
+		/* The estimate is smoothed in mired, as the gains */
+		estimateMired_ = haveEstimate_ && estimateMired_ > 0.0
+					 ? speed * 1e6 / result.colourTemperature + (1.0 - speed) * estimateMired_
+					 : 1e6 / result.colourTemperature;
+		for (unsigned int i = 0; i < 3; i++)
+			gains[i] = static_cast<float>(speed * target[i] + (1.0 - speed) * gains[i]);
+		context.activeState.awb.temperatureK = render(1e6 / estimateMired_);
+		haveEstimate_ = true;
+		lastGains_ = gains;
+		lastTemperature_ = context.activeState.awb.temperatureK;
+		updateTint(context);
+		LOG(IPAMtkIsp50Awb, Debug)
+			<< "means " << means << " window " << measured << " snr " << snr
+			<< " (" << greyZones << " grey zones) curve gains " << result.gains
+			<< " ct " << result.colourTemperature << " -> gains " << gains
+			<< " estimate " << std::lround(1e6 / estimateMired_)
+			<< " ct " << context.activeState.awb.temperatureK
+			<< " tint " << context.activeState.awb.tint;
+	} else {
+		/*
+		 * Calculate red and blue gains for AWB.
+		 * Clamp max gain at 4.0, this also avoids 0 division.
+		 */
+		RGB<float> grey{ {
+			sum.r() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.r(),
+			1.0,
+			sum.b() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.b(),
+		} };
+		gains = speed_ < 1.0 ? grey * static_cast<float>(speed_) +
+					       gains * static_cast<float>(1.0 - speed_)
+				     : grey;
+
+		RGB<double> rgbGains{ { 1 / gains.r(), 1 / gains.g(), 1 / gains.b() } };
+		context.activeState.awb.temperatureK = estimateCCT(rgbGains);
+	}
+
+	metadata.set(controls::ColourTemperature, context.activeState.awb.temperatureK);
+
+	LOG(IPAMtkIsp50Awb, Debug)
+		<< "gain R/B: " << gains << "; temperature: "
+		<< context.activeState.awb.temperatureK;
+}
+
+REGISTER_IPA_ALGORITHM(Awb, "Awb")
+
+} /* namespace ipa::mtkisp50::algorithms */
+
+} /* namespace libcamera */
