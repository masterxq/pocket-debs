+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2024-2026 Red Hat, Inc.
+ *
+ * mtkisp50 IPA context
+ */
+
+#pragma once
+
+#include <array>
+#include <optional>
+#include <stdint.h>
+
+#include <libcamera/controls.h>
+
+#include "libcamera/internal/matrix.h"
+#include "libcamera/internal/vector.h"
+
+#include <libipa/fc_queue.h>
+
+#include "core_ipa_interface.h"
+
+#include "dip_params.h"
+#include "frame_length.h"
+
+namespace libcamera {
+
+namespace ipa::mtkisp50 {
+
+struct IPASessionConfiguration {
+	struct {
+		int32_t exposureMin, exposureMax;
+		double againMin, againMax, again10, againMinStep;
+		utils::Duration lineDuration;
+		/*
+		 * Frame length extension: exposureMax is the limit at the
+		 * default frame length, exposureMaxExtended the limit with
+		 * VBLANK raised up to the tuned factor (equal to exposureMax
+		 * without extension). The frame length is only extended once
+		 * the gain reached extensionGain.
+		 */
+		int32_t exposureMaxExtended;
+		double extensionGain;
+		bool vblankEnabled;
+		/* Frame length for an exposure (VBLANK when vblankEnabled) */
+		FrameLength frame;
+	} agc;
+	struct {
+		std::optional<uint8_t> level;
+	} black;
+	/* Raw frame and the area the statistics are taken over */
+	Size rawSize;
+	Rectangle statsWindow;
+};
+
+struct IPAActiveState {
+	struct {
+		int32_t exposure;
+		double again;
+		double digitalGain;
+		bool valid;
+		/*
+		 * The last regulation step changed exposure, gain or digital
+		 * gain: the image level is still moving
+		 */
+		bool converging;
+		/* The last step was small (AeState converged) */
+		bool settled;
+		/*
+		 * Longest exposure the regulation may use: the frame length
+		 * extension within the longest frame duration of the
+		 * application (FrameDurationLimits)
+		 */
+		int32_t exposureLimit;
+		/* Shortest frame length of the application, 0 for none */
+		int32_t minFrameLines;
+		/*
+		 * Measured level over the base target of the last statistics
+		 * frame (1.0 when the regulation reached its base target), for
+		 * the light value of the scene
+		 */
+		double levelRatio = 1.0;
+	} agc;
+
+	struct {
+		uint8_t level;
+		int32_t lastExposure;
+		double lastGain;
+	} blc;
+
+	struct {
+		RGB<float> gains;
+		unsigned int temperatureK;
+		/*
+		 * Output colour of a neutral surface (R/G, B/G), applied after
+		 * the colour matrix: the preference for warm light
+		 */
+		RGB<float> tint = RGB<float>({ 1.0f, 1.0f, 1.0f });
+	} awb;
+
+	Matrix<float, 3, 3> combinedMatrix;
+
+	struct {
+		float gamma;
+		/* 0..2 range, 1.0 = normal */
+		std::optional<float> contrast;
+		std::optional<float> saturation;
+	} knobs;
+	struct {
+		/* Lens position in driver units, sent when update is set */
+		int32_t lensPosition;
+		bool update;
+		/* Waiting for a steady scene or scanning: statistics needed */
+		bool busy = false;
+	} af;
+};
+
+struct IPAFrameContext : public FrameContext {
+	Matrix<float, 3, 3> ccm;
+
+	struct {
+		int32_t exposure;
+		double gain;
+	} sensor;
+
+	RGB<float> gains;
+	double digitalGain;
+
+	float gamma;
+	std::optional<float> contrast;
+	std::optional<float> saturation;
+
+	/* A still image of the frame may be a multi-frame series */
+	bool multiFrame = true;
+};
+
+struct IPAContext {
+	IPAContext(unsigned int frameContextSize)
+		: frameContexts(frameContextSize)
+	{
+	}
+
+	IPACameraSensorInfo sensorInfo;
+	IPASessionConfiguration configuration;
+	IPAActiveState activeState;
+	FCQueue<IPAFrameContext> frameContexts;
+	ControlInfoMap::Map ctrlMap;
+	bool ccmEnabled = false;
+	/* Controls of the focus lens, empty without a lens */
+	ControlInfoMap lensControls;
+
+	/*
+	 * DIP tuning, from the ToneCurve, LensShadingCorrection, NoiseReduction
+	 * and MultiFrame algorithms
+	 */
+	struct {
+		std::optional<ToneCurve> toneCurve;
+		float shadowLift = 0.0f;
+		std::optional<LensShading> lensShading;
+		std::optional<QualityTable> quality;
+		std::optional<MultiFrameTable> multiFrame;
+	} dip;
+};
+
+} /* namespace ipa::mtkisp50 */
+
+} /* namespace libcamera */
