diff --git a/include/libcamera/ipa/mtkisp50.mojom b/include/libcamera/ipa/mtkisp50.mojom
new file mode 100644
index 0000000..e1bc03b
--- /dev/null
+++ b/include/libcamera/ipa/mtkisp50.mojom
@@ -0,0 +1,154 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+/*
+ * \todo Document the interface and remove the related EXCLUDE_PATTERNS entry.
+ */
+
+module ipa.mtkisp50;
+
+import "include/libcamera/ipa/core.mojom";
+
+/* What the processed stream is used for, selects the tuning sets */
+enum UseCase {
+	Preview = 0,
+	Video = 1,
+	Still = 2,
+	/* A still image that may be a multi-frame series (the IPA decides) */
+	StillSeries = 3,
+	/* A further raw frame of a multi-frame series */
+	SeriesFrame = 4,
+};
+
+struct IPAConfigInfo {
+	libcamera.IPACameraSensorInfo sensorInfo;
+	libcamera.ControlInfoMap sensorControls;
+	libcamera.ControlInfoMap lensControls;
+	/* Raw frame written by the capture device */
+	libcamera.Size rawSize;
+	/* Area of the raw frame processed by the ISP */
+	libcamera.Rectangle ispCrop;
+	/* Bayer order of the raw frame (libcamera BayerFormat::Order) */
+	uint32 bayerOrder;
+	/* Bit depth of the raw samples */
+	uint32 bitDepth;
+	UseCase useCase;
+	/* Size of a parameter buffer of the ISP, as the driver gives it */
+	uint32 paramsBufferSize;
+
+	/*
+	 * Jobs may run with the temporal noise reduction: the driver keeps a
+	 * buffer of the main output until the next job, a main stream needs
+	 * enough buffers for it
+	 */
+	bool temporalNr;
+	/* Layout of the statistics buffers (StatsSource in mtkisp50/stats.h) */
+	uint32 statsSource;
+	/* The sensor mode sends phase detection frames and they are captured */
+	bool pdAvailable;
+	/*
+	 * Still images may be multi-frame series: the multi-frame blending
+	 * block and the blend inputs of the ISP are there
+	 */
+	bool multiFrame;
+};
+
+/*
+ * Configuration of the statistics for the coming frames. It is the same for
+ * the CPU statistics and a hardware statistics unit: the cell grid, the luma
+ * coefficients and pre-gains of the histogram, the focus area, and how often
+ * statistics are wanted.
+ */
+struct StatsConfig {
+	/* Cell grid in raw frame pixels; an empty grid keeps the default */
+	libcamera.Rectangle window;
+	libcamera.Size gridSize;
+	/* Luma coefficients (sum 16) and pre-gains (1.0 = 512), may be empty */
+	array<uint16> yCoeffs;
+	array<uint16> preGains;
+	/* Statistics every interval-th frame (multiple of 4, at least 4) */
+	uint8 interval;
+	uint8 linePairStep;
+	uint8 blockStep;
+	/* Focus blocks every afInterval-th statistics frame, 0: none */
+	uint8 afInterval;
+	/* Focus blocks on every frame, also between statistics frames */
+	bool afEveryFrame;
+	/* Focus area: 0 centred square (region[2] = side), 1 rectangle */
+	uint8 afRegionMode;
+	/* Focus area in 1/65536 of the sensor output */
+	array<uint16> afRegion;
+	/*
+	 * Phase detection statistics: a grid of windows over a region (in
+	 * 1/65536 of the sensor output), the search range of the match in
+	 * profile samples and the black level of the PD samples
+	 */
+	bool pd;
+	array<uint16> pdRegion;
+	uint8 pdGridWidth;
+	uint8 pdGridHeight;
+	uint8 pdMaxShift;
+	uint16 pdBlackLevel;
+};
+
+/*
+ * Result of start(): the sensor and lens controls to apply before the first
+ * frame, empty when the IPA keeps what the devices have
+ */
+struct StartResult {
+	libcamera.ControlList sensorControls;
+	libcamera.ControlList lensControls;
+	int32 ret;
+};
+
+interface IPAMtkIsp50Interface {
+	init(libcamera.IPASettings settings,
+	     libcamera.IPACameraSensorInfo sensorInfo,
+	     libcamera.ControlInfoMap sensorControls,
+	     libcamera.ControlInfoMap lensControls)
+		=> (int32 ret, libcamera.ControlInfoMap ipaControls);
+	start(libcamera.ControlList controls) => (StartResult result);
+	stop();
+	configure(IPAConfigInfo configInfo)
+		=> (int32 ret, libcamera.ControlInfoMap ipaControls);
+
+	mapBuffers(array<libcamera.IPABuffer> buffers);
+	unmapBuffers(array<uint32> ids);
+
+	[async] queueRequest(uint32 frame, libcamera.ControlList controls);
+	/*
+	 * jobUse: what the ISP job of the frame makes (a frame with a still
+	 * image of a session with still images, else the use of the session)
+	 */
+	[async] computeParams(uint32 frame, uint32 paramsBufferId, UseCase jobUse);
+	[async] processStats(uint32 frame, uint32 statsBufferId,
+			     libcamera.ControlList sensorControls);
+
+	/*
+	 * Multi-frame series, after paramsComputed() announced one for the
+	 * still image of a frame: the parameters of the multi-frame blending
+	 * block for the series (a
+	 * params buffer of that block), the end of the capture of the series
+	 * (exposure, white balance and focus are free again), and the
+	 * parameters of the two ISP jobs of the series: the noise reduction
+	 * of the base frame and the blend (bytes used, 0 for none).
+	 * seriesEnd() ends the series, also one that stopped before its ISP
+	 * jobs.
+	 */
+	blendParams(uint32 frame) => (array<uint8> params);
+	[async] seriesCaptured();
+	seriesParams(uint32 baseParamsBufferId, uint32 blendParamsBufferId)
+		=> (uint32 baseBytesused, uint32 blendBytesused);
+	[async] seriesEnd();
+};
+
+interface IPAMtkIsp50EventInterface {
+	setSensorControls(uint32 frame, libcamera.ControlList sensorControls,
+			  libcamera.ControlList lensControls);
+	/*
+	 * seriesFrames: the still image of the frame starts a multi-frame
+	 * series of that many frames, 0 for a single frame
+	 */
+	paramsComputed(uint32 frame, uint32 bytesused, StatsConfig statsConfig,
+		       uint32 seriesFrames);
+	metadataReady(uint32 frame, libcamera.ControlList metadata);
+};
diff --git a/include/linux/media/mediatek/mtk-dip-mt6785.h b/include/linux/media/mediatek/mtk-dip-mt6785.h
index fd901cc..a65e13b 100644
--- a/include/linux/media/mediatek/mtk-dip-mt6785.h
+++ b/include/linux/media/mediatek/mtk-dip-mt6785.h
@@ -1,7 +1,8 @@
 /* SPDX-License-Identifier: ((GPL-2.0+ WITH Linux-syscall-note) OR MIT) */
 /*
  * Userspace interface of the MT6785 ISP pass 2 ("DIP"): a memory-to-memory
- * image processor that turns one raw Bayer frame into YUV frames.
+ * image processor that turns one raw Bayer frame, or one NV12 frame, into
+ * YUV frames.
  *
  * Device model (media controller, driver and model "mtk-dip", one processing
  * entity "mtk-dip", no subdev controls):
@@ -10,22 +11,28 @@
  *   mtk-dip-raw           to the ISP     VIDEO_OUTPUT_MPLANE     raw Bayer (below)
  *   mtk-dip-params        to the ISP     META_OUTPUT             V4L2_META_FMT_MTK_DIP_PARAMS
  *   mtk-dip-main          from the ISP   VIDEO_CAPTURE_MPLANE    NV12
+ *   mtk-dip-scaled        from the ISP   VIDEO_CAPTURE_MPLANE    YUYV
+ *   mtk-dip-base          to the ISP     VIDEO_OUTPUT_MPLANE     NV12
+ *   mtk-dip-weight        to the ISP     VIDEO_OUTPUT_MPLANE     GREY
  *
- * A scaled output and a statistics node are planned; they are not part of
- * version 1 and their nodes do not exist yet.
+ * A statistics node is planned; it does not exist yet.
  *
- * The links of mtk-dip-raw and mtk-dip-main are enabled and immutable, the
- * link of mtk-dip-params is enabled by default and can be disabled. A job
- * runs when mtk-dip-raw and mtk-dip-main both stream and each holds a queued
- * buffer; buffers are taken in queue order. mtk-dip-params never holds a job
+ * The links of mtk-dip-raw, mtk-dip-main and mtk-dip-scaled are enabled and
+ * immutable, the link of mtk-dip-params is enabled by default and can be
+ * disabled. A job runs when mtk-dip-raw and at least one of mtk-dip-main and
+ * mtk-dip-scaled stream, and mtk-dip-raw and every streaming output hold a
+ * queued buffer: each job writes all streaming outputs from the same raw
+ * frame. Buffers are taken in queue order. An output that starts or stops
+ * streaming while the others stream joins or leaves from the next job on.
+ * mtk-dip-params never holds a job
  * back: if it streams with its link enabled and a buffer is queued, the first
  * one belongs to the next job; without a params buffer, or with one that
  * omits a block, the values of the previous job stay in effect. Before the
  * first job the driver uses neutral values (unity gains, identity matrix,
- * gamma bypass, no lens shading, no edge enhancement, no colour module) and
- * its default settings of the noise reduction and demosaicing modules. Sequence numbers
+ * gamma bypass, no lens shading, no edge enhancement) and its default
+ * settings of the noise reduction and demosaicing modules. Sequence numbers
  * and timestamps of the capture buffers are copied from the raw buffer. A
- * job that fails returns its raw, params and main buffers with
+ * job that fails returns its raw, params and output buffers with
  * V4L2_BUF_FLAG_ERROR, in queue order. STREAMOFF on any
  * node waits for the running job and returns the buffers of that node.
  *
@@ -45,6 +52,21 @@
  * bytesperline of mtk-dip-main is a multiple of 16, at least the width and
  * at most 9248.
  *
+ * mtk-dip-scaled scales the same area, from 1/2 down to 1/16 of its width
+ * and of its height (each axis on its own, so the aspect ratio may change),
+ * at least 32x16, width and height even. The scaler makes each output pixel
+ * from the input pixels it covers (an area average). TRY_FMT and S_FMT on
+ * mtk-dip-scaled take the crop rectangle of mtk-dip-raw at that time: set
+ * the raw format and the crop first. They round the size into these limits
+ * and the width down to one the tile computation serves with this area
+ * (with and without edge enhancement); streamon fails with -EPIPE if the
