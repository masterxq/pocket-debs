+      ccm: [ 1.5, -0.25, -0.25, -0.25, 1.5, -0.25, -0.25, -0.25, 1.5 ]
+    - ct: 6500
+      ccm: [ 1.5, -0.25, -0.25, -0.25, 1.5, -0.25, -0.25, -0.25, 1.5 ]
+  strength:
+    iso: [ 800, 3200 ]
+    value: [ 1.0, 0.5 ]
+)";
+
+/*
+ * A tuning file with the curve of a reference module and the settings of the
+ * steady rendering, and the calibration of a single module over it
+ */
+const char *kModuleTuning = R"(%YAML 1.1
+---
+version: 1
+algorithms:
+  - Awb:
+      algorithm: bayes
+      speed: 0.7
+      window: 2
+      colourGains:
