+
+PipelineHandlerMtkIsp50 *MtkIsp50CameraData::pipe()
+{
+	return static_cast<PipelineHandlerMtkIsp50 *>(Camera::Private::pipe());
+}
+
+/*
+ * Follow the links from the sensor to the capture video node. Entities with
+ * the routing API (seninf) are crossed through their active route from the
+ * sink pad, others through their only source pad.
+ */
+int MtkIsp50CameraData::init(MediaEntity *sensorEntity)
+{
+	sensor_ = CameraSensorFactoryBase::create(sensorEntity);
+	if (!sensor_)
+		return -ENODEV;
+
+	const MediaPad *source = nullptr;
+	for (const MediaPad *pad : sensorEntity->pads()) {
+		if (pad->flags() & MEDIA_PAD_FL_SOURCE) {
+			source = pad;
+			break;
+		}
+	}
+
+	while (source) {
+		const MediaLink *link = nullptr;
+		for (const MediaLink *l : source->links()) {
+			if (l->flags() & MEDIA_LNK_FL_ENABLED) {
+				link = l;
+				break;
+			}
+		}
+		if (!link) {
+			LOG(MtkIsp50, Error)
+				<< "No enabled link from " << source->entity()->name()
+				<< ":" << source->index();
+			return -ENODEV;
+		}
+
+		MediaEntity *entity = link->sink()->entity();
+		const MediaPad *sink = link->sink();
+
+		if (entity->function() == MEDIA_ENT_F_IO_V4L) {
+			video_ = std::make_unique<V4L2VideoDevice>(entity);
+			int ret = video_->open();
+			if (ret)
+				return ret;
+			break;
+		}
+
+		auto subdev = std::make_unique<V4L2Subdevice>(entity);
+		int ret = subdev->open();
+		if (ret)
+			return ret;
+
+		/* The route from the sink pad, if the subdevice has routing */
+		const MediaPad *next = nullptr;
+		V4L2Subdevice::Routing routing = {};
+		if (!subdev->getRouting(&routing, V4L2Subdevice::ActiveFormat)) {
+			for (const V4L2Subdevice::Route &route : routing) {
+				if (route.sink.pad == sink->index() &&
+				    (route.flags & V4L2_SUBDEV_ROUTE_FL_ACTIVE)) {
+					next = entity->getPadByIndex(route.source.pad);
+					break;
+				}
+			}
+		}
+
+		if (!next) {
+			std::vector<const MediaPad *> sources;
+			for (const MediaPad *pad : entity->pads()) {
+				if ((pad->flags() & MEDIA_PAD_FL_SOURCE) && !pad->links().empty())
+					sources.push_back(pad);
+			}
+			if (sources.size() != 1) {
+				LOG(MtkIsp50, Error)
+					<< "No route through " << entity->name()
+					<< " from pad " << sink->index();
+				return -ENODEV;
+			}
+			next = sources[0];
+		}
+
+		entities_.push_back({ entity, sink, next, std::move(subdev) });
+		source = next;
+	}
+
+	if (!video_) {
+		LOG(MtkIsp50, Error) << "No capture device for " << sensor_->id();
+		return -ENODEV;
+	}
+
+	properties_ = sensor_->properties();
+
+	const CameraSensorProperties::SensorDelays &delays = sensor_->sensorDelays();
+	std::unordered_map<uint32_t, DelayedControls::ControlParams> params = {
+		{ V4L2_CID_ANALOGUE_GAIN, { delays.gainDelay, false } },
+		{ V4L2_CID_EXPOSURE, { delays.exposureDelay, false } },
+	};
+	/* The IPA may raise the frame length for longer exposures. */
+	if (sensor_->controls().count(V4L2_CID_VBLANK))
+		params[V4L2_CID_VBLANK] = { delays.vblankDelay, true };
+	delayedCtrls_ = std::make_unique<DelayedControls>(sensor_->device(), params);
+
+	return 0;
+}
+
+int MtkIsp50CameraData::loadIPA()
+{
+	ipa_ = pipe()->createIPA<ipa::mtkisp50::IPAProxyMtkIsp50>(0, 0);
+	if (!ipa_)
+		return -ENOENT;
+
+	ipa_->setSensorControls.connect(this, &MtkIsp50CameraData::setSensorControls);
+	ipa_->paramsComputed.connect(this, &MtkIsp50CameraData::paramsComputed);
+	ipa_->metadataReady.connect(this, &MtkIsp50CameraData::metadataReady);
+
+	std::string tuningFile =
+		ipa_->configurationFile(sensor_->model() + ".yaml", "uncalibrated.yaml");
+
+	IPACameraSensorInfo sensorInfo{};
+	int ret = sensor_->sensorInfo(&sensorInfo);
+	if (ret) {
+		LOG(MtkIsp50, Error) << "Camera sensor information not available";
+		return ret;
+	}
+
+	ControlInfoMap lensControls;
+	if (sensor_->focusLens())
+		lensControls = sensor_->focusLens()->controls();
+
+	ret = ipa_->init({ tuningFile, sensor_->model() }, sensorInfo,
+			 sensor_->controls(), lensControls, &ipaControls_);
+	if (ret) {
+		LOG(MtkIsp50, Error) << "IPA initialisation failed with " << tuningFile;
+		return ret;
+	}
+
+	LOG(MtkIsp50, Info) << "Tuning of " << sensor_->id() << ": " << tuningFile;
+
+	return 0;
+}
+
+void MtkIsp50CameraData::setSensorControls([[maybe_unused]] uint32_t frame,
+					   const ControlList &sensorControls,
+					   const ControlList &lensControls)
+{
+	delayedCtrls_->push(sensorControls);
+
+	/*
+	 * Without a frame start event of the capture device the controls are
+	 * applied right away, as the simple pipeline handler does. A new frame
+	 * length goes first, the exposure limit of the sensor follows it.
+	 */
+	ControlList ctrls(sensorControls);
+	if (ctrls.contains(V4L2_CID_VBLANK)) {
+		ControlList vblank(sensor_->controls());
+		vblank.set(V4L2_CID_VBLANK, ctrls.get(V4L2_CID_VBLANK));
+		sensor_->setControls(&vblank);
+	}
+	sensor_->setControls(&ctrls);
+
+	CameraLens *lens = sensor_->focusLens();
+	if (lens && lensControls.contains(V4L2_CID_FOCUS_ABSOLUTE)) {
+		const ControlValue &position = lensControls.get(V4L2_CID_FOCUS_ABSOLUTE);
+		lens->setFocusPosition(position.get<int32_t>());
+	}
+}
+
+void MtkIsp50CameraData::paramsComputed(uint32_t frame, uint32_t bytesused,
+					const ipa::mtkisp50::StatsConfig &config)
+{
+	MtkIsp50Frames::Info *info = frames_.find(frame);
+	if (!info)
+		return;
+
+	PipelineHandlerMtkIsp50 *pipe = this->pipe();
+
+	/* The raw buffer stays until the statistics are done */
+	statsDone_[frame] = false;
+	FrameBuffer *raw = info->rawBuffer;
+	mtkisp50::StatsBuffer *out = statsMaps_[info->statsBuffer];
+
+	frames_.submitIspJob(info, bytesused);
+	pipe->runIspJobs(this);
+
+	/* The statistics of the raw frame, also while the ISP works on it */
+	pipe->statsWorker_->invokeMethod(&MtkIsp50StatsWorker::process,
+					 ConnectionTypeQueued, frame, raw, out,
+					 config, true);
+}
+
+void MtkIsp50CameraData::metadataReady(uint32_t frame, const ControlList &metadata)
+{
+	MtkIsp50Frames::Info *info = frames_.find(frame);
+	if (!info)
+		return;
+
+	info->request->_d()->metadata().merge(metadata);
+	info->metadataDone = true;
+
+	pipe()->tryComplete(this, info);
+}
+
+/* -----------------------------------------------------------------------------
+ * Camera configuration
+ */
+
+CameraConfiguration::Status MtkIsp50CameraConfiguration::validate()
+{
+	Status status = Valid;
+
+	if (config_.empty())
+		return Invalid;
+
+	status = validateColorSpaces(ColorSpaceFlag::StreamsShareColorSpace);
+
+	CameraSensor *sensor = data_->sensor_.get();
+	PipelineHandlerMtkIsp50 *pipe = data_->pipe();
+
+	/* 10 bit (or else 8 bit) Bayer codes of the sensor */
+	std::vector<unsigned int> mbusCodes;
+	for (unsigned int code : sensor->mbusCodes()) {
+		BayerFormat bayer = BayerFormat::fromMbusCode(code);
+		if (bayer.isValid() && (bayer.bitDepth == 10 || bayer.bitDepth == 8))
+			mbusCodes.push_back(code);
+	}
+	std::stable_sort(mbusCodes.begin(), mbusCodes.end(), [](unsigned int a, unsigned int b) {
+		return BayerFormat::fromMbusCode(a).bitDepth > BayerFormat::fromMbusCode(b).bitDepth;
+	});
+	if (mbusCodes.empty() || data_->modes_.empty())
+		return Invalid;
+
+	/* Streams to the outputs, sensor mode and processed area */
+	MtkIsp50StreamPlan plan(data_->modes_, data_->ispAvailable_, pipe->dip_.hasScaled());
+	const Status planned = plan.plan(config_);
+	if (planned == Invalid)
+		return Invalid;
+	if (planned == Adjusted)
+		status = Adjusted;
+
+	sensorFormat = sensor->getFormat(mbusCodes, plan.mode);
+	if (sensorFormat.size != plan.mode) {
+		LOG(MtkIsp50, Error)
+			<< "Sensor mode " << sensorFormat.size << " instead of " << plan.mode;
+		return Invalid;
+	}
+
+	BayerFormat bayer = BayerFormat::fromMbusCode(sensorFormat.code);
+	if (bayer.bitDepth == 10)
+		bayer.packing = BayerFormat::Packing::MTISP;
+
+	V4L2DeviceFormat rawFormat;
+	rawFormat.fourcc = PipelineHandlerMtkIsp50::rawPixelFormat(bayer);
+	rawFormat.size = sensorFormat.size;
+	int ret = data_->video_->tryFormat(&rawFormat);
+	if (ret)
+		return Invalid;
+
+	if (plan.raw >= 0) {
+		StreamConfiguration *rawCfg = &config_[plan.raw];
+		const PixelFormat format = PipelineHandlerMtkIsp50::rawFormatOf(bayer);
+		if (rawCfg->pixelFormat != format || rawCfg->size != sensorFormat.size) {
+			rawCfg->pixelFormat = format;
+			rawCfg->size = sensorFormat.size;
+			status = Adjusted;
+		}
+
+		rawCfg->stride = rawFormat.planes[0].bpl;
+		rawCfg->frameSize = rawFormat.planes[0].size;
+		if (rawCfg->colorSpace != ColorSpace::Raw) {
+			rawCfg->colorSpace = ColorSpace::Raw;
+			status = Adjusted;
+		}
+		if (!rawCfg->bufferCount)
+			rawCfg->bufferCount = kRawBufferCount;
+		rawCfg->setStream(const_cast<Stream *>(&data_->rawStream_));
+	}
+
+	crop = plan.crop;
+
+	if (plan.main >= 0) {
+		StreamConfiguration *outCfg = &config_[plan.main];
+
+		V4L2DeviceFormat format;
+		format.fourcc = V4L2PixelFormat(V4L2_PIX_FMT_NV12);
+		format.size = outCfg->size;
+		ret = pipe->dip_.main_->tryFormat(&format);
+		if (ret)
+			return Invalid;
+
+		if (format.size != outCfg->size) {
+			/* A size the planning does not know as impossible */
+			outCfg->size = format.size;
+			crop = Rectangle(static_cast<int>(((sensorFormat.size.width - format.size.width) / 2) & ~3u),
+					 static_cast<int>(((sensorFormat.size.height - format.size.height) / 2) & ~1u),
+					 format.size);
+			status = Adjusted;
+		}
+
+		outCfg->stride = format.planes[0].bpl;
+		outCfg->frameSize = format.planes[0].size;
+		if (!outCfg->bufferCount)
+			outCfg->bufferCount = plan.scaled >= 0 && outCfg->frameSize > kLargeOutputFrame
+						      ? kLargeOutputBufferCount
+						      : kOutputBufferCount;
+		outCfg->setStream(const_cast<Stream *>(&data_->outputStream_));
+	}
+
+	if (plan.scaled >= 0) {
+		StreamConfiguration *scaledCfg = &config_[plan.scaled];
+
+		Size size = MtkIsp50StreamPlan::fitScaled(crop.size(), scaledCfg->size);
+		unsigned int stride = utils::alignUp(size.width * 2, 16);
+
+		/*
+		 * The driver rounds the width down to one its tile computation
+		 * serves for the processed area of the raw node. While no
+		 * camera of the handler streams, the area is set for the check
+		 * (configure() sets it again); a busy node keeps the size.
+		 */
+		if (!pipe->streaming()) {
+			V4L2DeviceFormat ispRaw = rawFormat;
+			Rectangle area = crop;
+			V4L2DeviceFormat format;
+			format.fourcc = V4L2PixelFormat(V4L2_PIX_FMT_YUYV);
+			format.size = size;
+
+			if (!pipe->dip_.raw_->setFormat(&ispRaw) &&
+			    !pipe->dip_.raw_->setSelection(V4L2_SEL_TGT_CROP, &area) &&
+			    area == crop && !pipe->dip_.scaled_->tryFormat(&format)) {
+				size = format.size;
+				stride = format.planes[0].bpl;
+			}
+		}
+
+		if (size != scaledCfg->size) {
+			scaledCfg->size = size;
+			status = Adjusted;
+		}
+
+		scaledCfg->stride = stride;
+		scaledCfg->frameSize = stride * size.height;
+		if (!scaledCfg->bufferCount)
+			scaledCfg->bufferCount = kOutputBufferCount;
+		scaledCfg->setStream(const_cast<Stream *>(&data_->scaledStream_));
+	}
+
+	/* BT.601 full range on both processed outputs */
+	for (int index : { plan.main, plan.scaled }) {
+		if (index < 0)
+			continue;
+
+		StreamConfiguration &cfg = config_[index];
+		if (cfg.colorSpace != ColorSpace::Sycc) {
+			cfg.colorSpace = ColorSpace::Sycc;
+			status = Adjusted;
+		}
+	}
+
+	return status;
+}
+
+/* -----------------------------------------------------------------------------
+ * Pipeline handler
+ */
+
+PipelineHandlerMtkIsp50::PipelineHandlerMtkIsp50(CameraManager *manager)
+	: PipelineHandler(manager, kMaxQueuedRequests)
+{
+}
+
+PipelineHandlerMtkIsp50::~PipelineHandlerMtkIsp50()
+{
+	/* The thread of the worker ends first, then the worker goes */
+	if (statsThread_.isRunning()) {
+		statsThread_.exit();
+		statsThread_.wait();
+	}
+
+	statsWorker_.reset();
+}
