+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Tuning of the DIP blocks that the algorithms do not compute per frame: tone
+ * curve, lens shading and the image quality blocks per sensitivity
+ */
+
+#pragma once
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::mtkisp50::algorithms {
+
+/* Tone curve (points: x, y pairs) and shadow lift */
