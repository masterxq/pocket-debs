+
+class MtkIsp50ProgramTest : public Test
+{
+protected:
+	int fail(const std::string &what)
+	{
+		std::cerr << what << std::endl;
+		return TestFail;
+	}
+
+	/* Times of the stages are multiples of 10 ms (50 Hz) from 10 ms on */
+	static bool flickerFree(double time)
+	{
+		if (time < 9999.0)
+			return true;
+		const double k = std::round(time / 10000.0);
+		return std::abs(time - k * 10000.0) < 1.0;
+	}
+
+	int testSplit()
+	{
+		using Stage = ExposureProgram::Stage;
+		auto p = ExposureProgram::fromStages({ Stage{ 10000, 2.0 }, Stage{ 20000, 4.0 },
+						       Stage{ 30000, 8.0 }, Stage{ 40000, 16.0 },
+						       Stage{ 60000, 32.0 }, Stage{ 100000, 120.0 } });
+		if (!p)
+			return fail("program refused");
+
+		/* Rising times and rising products only */
+		if (ExposureProgram::fromStages({ Stage{ 20000, 2.0 }, Stage{ 10000, 8.0 } }) ||
+		    ExposureProgram::fromStages({ Stage{ 10000, 8.0 }, Stage{ 20000, 2.0 } }))
+			return fail("invalid program accepted");
+
+		struct Case {
+			double total;
+			double time;
+			double again;
+			double dgain;
+		};
+		const Case cases[] = {
+			/* Bright: the time shrinks at the smallest gain */
+			{ 500.0, 500.0, 1.0, 1.0 },
+			{ 10000.0, 10000.0, 1.0, 1.0 },
+			{ 15000.0, 10000.0, 1.5, 1.0 },
+			/* The next stage: 20 ms, the gain falls back */
+			{ 25000.0, 20000.0, 1.25, 1.0 },
+			{ 200000.0, 30000.0, 200.0 / 30.0, 1.0 },
+			{ 400000.0, 40000.0, 10.0, 1.0 },
+			/* The analogue gain first, then the digital one */
+			{ 60000.0 * 20.0, 60000.0, 15.5, 20.0 / 15.5 },
+			{ 100000.0 * 100.0, 100000.0, 15.5, 100.0 / 15.5 },
+			/* Beyond the program: the device limit */
+			{ 100000.0 * 200.0, 100000.0, 15.5, 8.0 },
+		};
+		for (const Case &c : cases) {
+			const auto s = p->split(c.total, 10.0, 100000.0, 1.0, 15.5, 8.0);
+			if (std::abs(s.time - c.time) > 0.5 || std::abs(s.again - c.again) > 1e-3 ||
+			    std::abs(s.dgain - c.dgain) > 1e-3)
+				return fail("split " + std::to_string(c.total) + ": " + std::to_string(s.time) +
+					    " us " + std::to_string(s.again) + " x " + std::to_string(s.dgain));
+		}
+
+		/* Every total: flicker free times, the analogue gain before the digital one */
+		for (double total = 50.0; total < 2e7; total *= 1.05) {
+			const auto s = p->split(total, 10.0, 100000.0, 1.0, 15.5, 8.0);
+			if (!flickerFree(s.time) || (s.dgain > 1.0 + 1e-9 && s.again < 15.5 - 1e-9) ||
+			    std::abs(s.time * s.again * s.dgain - std::min(total, 100000.0 * 15.5 * 8.0)) > 1e-6 * total)
+				return fail("split " + std::to_string(total) + ": " + std::to_string(s.time) +
+					    " us " + std::to_string(s.again) + " x " + std::to_string(s.dgain));
+		}
+
+		/* A longest exposure of 33.3 ms: the stage of 30 ms, the gain takes the rest */
+		const auto s = p->split(60000.0 * 20.0, 10.0, 33333.0, 1.0, 15.5, 8.0);
+		if (std::abs(s.time - 30000.0) > 0.5 || std::abs(s.again * s.dgain - 40.0) > 1e-3)
+			return fail("split within 33.3 ms: " + std::to_string(s.time));
+		/* A limit below the first stage: the limit itself */
+		const auto t = p->split(60000.0, 10.0, 8000.0, 1.0, 15.5, 8.0);
+		if (std::abs(t.time - 8000.0) > 0.5 || std::abs(t.again - 7.5) > 1e-3)
+			return fail("split within 8 ms: " + std::to_string(t.time));
+
+		return TestPass;
+	}
+
+	/* Regulation of a dark scene with the program */
+	int testRegulation()
+	{
+		Sim sim;
+		if (sim.init() || sim.configure(kFull))
+			return fail("init");
+		const auto &agc = sim.ctx().configuration.agc;
+		const double line = agc.lineDuration.get<std::micro>();
+
+		/* Needs 60 ms at a total gain of 20 for the target */
+		sim.brightness = (0.18 * (255.0 - kBlack)) / (60000.0 / line * 20.0);
+		for (unsigned int i = 0; i < 600; i++)
+			sim.frame();
+
+		const double time = sim.exposure() * line;
+		const double total = time * sim.gain() * sim.digitalGain();
+		if (std::abs(time - 60000.0) > line || sim.gain() < 15.5 - 1e-6 ||
+		    std::abs(total / (60000.0 * 20.0) - 1.0) > 0.08)
+			return fail("dark scene: " + std::to_string(time) + " us, gain " +
+				    std::to_string(sim.gain()) + " x " + std::to_string(sim.digitalGain()));
+
+		/* Darker: 100 ms, as far as the frame length extension reaches */
+		sim.brightness /= 4.0;
+		for (unsigned int i = 0; i < 600; i++)
+			sim.frame();
+		/* The longest exposure of the mode ends just short of 100 ms */
+		const double longest = std::min(100000.0, sim.ctx().activeState.agc.exposureLimit * line);
+		const double time2 = sim.exposure() * line;
+		if (std::abs(time2 - longest) > line || sim.gain() < 15.5 - 1e-6)
+			return fail("darker scene: " + std::to_string(time2) + " us, limit " +
+				    std::to_string(sim.ctx().activeState.agc.exposureLimit) + " busy " +
+				    std::to_string(sim.ctx().activeState.af.busy) + ", gain " +
+				    std::to_string(sim.gain()) + " x " + std::to_string(sim.digitalGain()));
+
+		/* 30 fps from the application: the stage of 30 ms */
+		ControlList fps = limits(33333, 33333);
+		sim.frame(&fps);
+		for (unsigned int i = 0; i < 300; i++)
+			sim.frame();
+		const double time3 = sim.exposure() * line;
+		if (std::abs(time3 - 30000.0) > line || sim.gain() < 15.5 - 1e-6)
+			return fail("30 fps: " + std::to_string(time3) + " us, gain " +
+				    std::to_string(sim.gain()) + " x " + std::to_string(sim.digitalGain()));
+
+		/*
+		 * Back to the longest frames: the time goes back to the stages,
+		 * the analogue gain stays at its limit while digital gain is
+		 * used (the autofocus searched in between)
+		 */
+		ControlList slow = limits(33333, 100000);
+		sim.frame(&slow);
+		for (unsigned int i = 0; i < 600; i++) {
+			sim.frame();
+			if (sim.digitalGain() > 1.0 + 1e-6 && sim.gain() < 15.5 - 1e-6)
+				return fail("digital gain " + std::to_string(sim.digitalGain()) +
+					    " with analogue gain " + std::to_string(sim.gain()));
+			if (!flickerFree(sim.exposure() * line) &&
+			    std::abs(sim.exposure() * line - longest) > line &&
+			    std::abs(sim.exposure() * line - 10000.0 * std::round(sim.exposure() * line / 10000.0)) > line)
+				return fail("exposure " + std::to_string(sim.exposure() * line) + " us not in 10 ms steps");
+		}
+		const double time4 = sim.exposure() * line;
+		if (std::abs(time4 - longest) > line)
+			return fail("longest frames: " + std::to_string(time4) + " us");
+
+		return TestPass;
+	}
+
+	/* Video: the video program, a stage of 40 ms at most */
+	int testVideo()
+	{
+		Sim sim;
+		if (sim.init() || sim.configure(kFull, UseCase::Video))
+			return fail("video init");
+		const auto &agc = sim.ctx().configuration.agc;
+		const double line = agc.lineDuration.get<std::micro>();
+		sim.brightness = (0.18 * (255.0 - kBlack)) / (100000.0 / line * 30.0);
+		for (unsigned int i = 0; i < 600; i++)
+			sim.frame();
+		const double time = sim.exposure() * line;
+		if (std::abs(time - 40000.0) > line || sim.gain() < 15.5 - 1e-6)
+			return fail("video: " + std::to_string(time) + " us, gain " +
+				    std::to_string(sim.gain()) + " x " + std::to_string(sim.digitalGain()));
+		return TestPass;
+	}
+
+	/* Still images: more digital gain than the preview in a very dark scene */
+	int testStill()
+	{
+		Sim sim;
+		if (sim.init() || sim.configure(kFull, UseCase::Still))
+			return fail("still init");
+		const auto &agc = sim.ctx().configuration.agc;
+		const double line = agc.lineDuration.get<std::micro>();
+		/* Needs a total gain of 200 at 100 ms */
+		sim.brightness = (0.18 * (255.0 - kBlack)) / (100000.0 / line * 200.0);
+		for (unsigned int i = 0; i < 800; i++)
+			sim.frame();
+		const double preview = sim.digitalGain();
+
+		const double still = sim.stillDigitalGain();
+		if (preview > 120.0 / 15.5 + 1e-3)
+			return fail("preview digital gain " + std::to_string(preview) + " beyond its program");
+		if (std::abs(still * 15.5 - 200.0) > 200.0 * 0.08)
+			return fail("still digital gain " + std::to_string(still) + ", preview " +
+				    std::to_string(preview));
+		return TestPass;
+	}
+
+	/* The program limited to an exposure time up to a total gain */
+	int testLimited()
+	{
+		using Stage = ExposureProgram::Stage;
+		auto p = ExposureProgram::fromStages({ Stage{ 10000, 2.0 }, Stage{ 20000, 4.0 },
+						       Stage{ 30000, 8.0 }, Stage{ 40000, 16.0 },
+						       Stage{ 60000, 32.0 }, Stage{ 100000, 120.0 } });
+		if (!p)
+			return fail("program refused");
+
+		/* 30 ms up to a gain of 64: the stages of 30 to 60 ms give way */
+		auto h = p->limited(30000, 64.0);
+		if (!h || h->stages().size() != 4 || h->stages()[2].time != 30000 ||
+		    h->stages()[2].gain != 64.0 || h->stages()[3].time != 100000)
+			return fail("limited program");
+
+		struct Case {
+			double total;
+			double time;
+		};
+		const Case cases[] = {
+			/* Up to the gain of the limit: 30 ms */
+			{ 30000.0 * 8.0, 30000.0 },
+			{ 30000.0 * 30.0, 30000.0 },
+			{ 30000.0 * 64.0, 30000.0 },
+			/* Beyond: the stage of 100 ms */
+			{ 30000.0 * 64.0 * 1.01, 100000.0 },
+			{ 100000.0 * 100.0, 100000.0 },
+			/* Below the limit as before */
+			{ 15000.0, 10000.0 },
+			{ 60000.0, 20000.0 },
+		};
+		for (const Case &c : cases) {
+			const auto s = h->split(c.total, 10.0, 100000.0, 1.0, 15.5, 8.0);
+			if (std::abs(s.time - c.time) > 0.5 ||
+			    std::abs(s.time * s.again * s.dgain - c.total) > 1e-6 * c.total)
+				return fail("limited split " + std::to_string(c.total) + ": " +
+					    std::to_string(s.time) + " us " + std::to_string(s.again) +
+					    " x " + std::to_string(s.dgain));
+		}
+		for (double total = 50.0; total < 1e7; total *= 1.05) {
+			const auto s = h->split(total, 10.0, 100000.0, 1.0, 15.5, 8.0);
+			if (!flickerFree(s.time) || (s.dgain > 1.0 + 1e-9 && s.again < 15.5 - 1e-9) ||
+			    (total <= 30000.0 * 64.0 && s.time > 30000.0 + 0.5))
+				return fail("limited split " + std::to_string(total) + ": " +
+					    std::to_string(s.time) + " us");
+		}
+
+		/* The gain of the limit beyond the last stage: the largest gain */
+		auto g = p->limited(30000, 200.0);
+		if (!g || g->maxGain() != 200.0 || g->stages().back().time != 100000)
+			return fail("limited program with a large gain");
+
+		/* A shorter stage reaches the total already: unchanged */
+		auto m = p->limited(25000, 2.0);
+		if (!m || m->stages().size() != p->stages().size())
+			return fail("limit within a shorter stage");
+
+		/* Not a program: a gain below 1.0 */
+		if (p->limited(5000, 0.5))
+			return fail("limit with a gain below 1.0 accepted");
+
+		return TestPass;
+	}
+
+	/*
+	 * Images taken by hand: a scene that needs 100 ms at a gain of 30
+	 * takes 30 ms at a gain of 100 at 30 fps, preview and still image;
+	 * darker scenes the longest exposure, video its own program
+	 */
+	int testHandheld()
+	{
+		Sim sim;
+		if (sim.init(kHandheldTuning) || sim.configure(kFull, UseCase::Still))
+			return fail("handheld init");
+		const auto &agc = sim.ctx().configuration.agc;
+		const double line = agc.lineDuration.get<std::micro>();
+
+		sim.brightness = (0.18 * (255.0 - kBlack)) / (100000.0 / line * 30.0);
+		for (unsigned int i = 0; i < 600; i++) {
+			sim.frame();
+			if (i > 100 && sim.exposure() * line > 30000.0 + line)
+				return fail("handheld: " + std::to_string(sim.exposure() * line) + " us");
+		}
+		const double time = sim.exposure() * line;
+		const double total = time * sim.gain() * sim.digitalGain();
+		if (std::abs(time - 30000.0) > line || sim.gain() < 15.5 - 1e-6 ||
+		    std::abs(total / (100000.0 * 30.0) - 1.0) > 0.08)
+			return fail("handheld: " + std::to_string(time) + " us, gain " +
+				    std::to_string(sim.gain()) + " x " + std::to_string(sim.digitalGain()));
+		if (sim.frameLines != kFull.defaultLines)
+			return fail("handheld frame of " + std::to_string(sim.frameLines) + " lines");
+		const double still = sim.stillDigitalGain();
+		if (std::abs(time * sim.gain() * still / total - 1.0) > 0.02)
+			return fail("handheld still digital gain " + std::to_string(still));
+
+		/* The frame durations of the application: 30 fps keeps 30 ms */
+		ControlList fps = limits(33333, 33333);
+		sim.frame(&fps);
+		for (unsigned int i = 0; i < 100; i++)
+			sim.frame();
+		if (std::abs(sim.exposure() * line - 30000.0) > line)
+			return fail("handheld at 30 fps: " + std::to_string(sim.exposure() * line) + " us");
+		ControlList slow = limits(33333, 100000);
+		sim.frame(&slow);
+
+		/* Darker than the limit reaches: the longest exposure */
+		sim.brightness /= 2.0;
+		for (unsigned int i = 0; i < 600; i++)
+			sim.frame();
+		const double longest = std::min(100000.0, sim.ctx().activeState.agc.exposureLimit * line);
+		if (std::abs(sim.exposure() * line - longest) > line)
+			return fail("handheld, darker: " + std::to_string(sim.exposure() * line) + " us");
+
+		/* Video keeps its program */
+		Sim video;
+		if (video.init(kHandheldTuning) || video.configure(kFull, UseCase::Video))
+			return fail("handheld video init");
+		video.brightness = (0.18 * (255.0 - kBlack)) / (100000.0 / line * 30.0);
+		for (unsigned int i = 0; i < 600; i++)
+			video.frame();
+		if (std::abs(video.exposure() * line - 40000.0) > line)
+			return fail("handheld video: " + std::to_string(video.exposure() * line) + " us");
+
+		return TestPass;
+	}
+
+	int run() override
+	{
+		int ret = testSplit();
+		if (ret != TestPass)
+			return ret;
+		ret = testLimited();
+		if (ret != TestPass)
+			return ret;
+		ret = testHandheld();
+		if (ret != TestPass)
+			return ret;
+		ret = testRegulation();
+		if (ret != TestPass)
+			return ret;
+		ret = testVideo();
+		if (ret != TestPass)
+			return ret;
+		return testStill();
+	}
+};
+
