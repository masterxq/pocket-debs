+/* Pyramid sizes of a frame */
+std::vector<std::pair<int, int>> pyramidSizes(unsigned int width, unsigned int height,
+					      const AlignConfig &cfg)
+{
+	std::vector<std::pair<int, int>> s;
+	int w = width / cfg.downscale, h = height / cfg.downscale;
+	s.push_back({ w, h });
+	while (s.size() < 4 && w / 2 >= 64 && h / 2 >= 48) {
+		w /= 2;
+		h /= 2;
+		s.push_back({ w, h });
+	}
+	return s;
+}
+
+} /* namespace */
+
+size_t FrameAligner::workingMemory(unsigned int width, unsigned int height, unsigned int count,
+				   const AlignConfig &cfg)
+{
+	size_t bytes = 0;
+	for (const auto &s : pyramidSizes(width, height, cfg))
+		bytes += size_t(s.first) * s.second * sizeof(uint16_t);
+	bytes *= count;
+	/* gradients of the base */
+	bytes += size_t(width / cfg.downscale) * (height / cfg.downscale) * 2 * sizeof(int16_t);
+	const size_t blocks = size_t(width / cfg.downscale / cfg.block + 1) *
+			      (height / cfg.downscale / cfg.block + 1);
+	bytes += count * blocks * (sizeof(Block) + sizeof(Vec2) * 3 + sizeof(Vec2i) * 2 + 1);
+	/* row buffers of the threads */
+	bytes += size_t(std::max(1u, cfg.threads ? cfg.threads : std::thread::hardware_concurrency())) *
+		 width * sizeof(uint16_t) * 2;
+	return bytes;
+}
+
+float FrameAligner::Impl::noiseAt(const Frame &f, float mean) const
+{
+	int i = std::clamp(int(mean * kNoiseBins / 4096.0f), 0, kNoiseBins - 1);
+	return f.noiseBins[i];
+}
+
+void FrameAligner::Impl::matchLevel(int level)
+{
+	const TileGrid &g = grids[level];
+	const bool coarsest = level == levels() - 1;
+	const bool finest = level == 0;
+	const int radius = coarsest ? 4 : 2;
+	const int margin = g.tile / 4;
+	const Frame &base = frames[baseIndex];
+	std::vector<unsigned int> refs;
+	for (unsigned int i = 0; i < frames.size(); i++)
+		if (i != baseIndex)
+			refs.push_back(i);
+
+	for (unsigned int i : refs)
+		frames[i].fields[level].assign(g.size(), { 0, 0 });
+
+	pool.run(refs.size() * g.rows, [&](size_t item) {
+		Frame &f = frames[refs[item / g.rows]];
+		const int ty = item % g.rows;
+		const Image16 &b = base.pyr[level], &r = f.pyr[level];
+		const int scale = 1 << (levels() - 1 - level);
+		const Vec2i global = { f.global.x * scale, f.global.y * scale };
+		for (int tx = 0; tx < g.cols; tx++) {
+			const int x0 = std::max(0, g.ox + tx * g.tile - margin);
+			const int y0 = std::max(0, g.oy + ty * g.tile - margin);
+			const int x1 = std::min(b.w, g.ox + (tx + 1) * g.tile + margin);
+			const int y1 = std::min(b.h, g.oy + (ty + 1) * g.tile + margin);
+
+			/* Candidates: global shift and the four nearest parents */
+			Vec2i cand[5];
+			int nc = 0;
+			cand[nc++] = global;
+			if (!coarsest) {
+				const TileGrid &pg = grids[level + 1];
+				const std::vector<Vec2i> &pf = f.fields[level + 1];
+				const float px = (g.cx(tx) / 2 - pg.ox) / pg.tile - 0.5f;
+				const float py = (g.cy(ty) / 2 - pg.oy) / pg.tile - 0.5f;
+				const int i0 = int(std::floor(px)), j0 = int(std::floor(py));
+				for (int dj = 0; dj < 2; dj++) {
+					for (int di = 0; di < 2; di++) {
+						const int i = std::clamp(i0 + di, 0, pg.cols - 1);
+						const int j = std::clamp(j0 + dj, 0, pg.rows - 1);
+						const Vec2i p = pf[j * pg.cols + i];
+						const Vec2i c = { 2 * p.x, 2 * p.y };
+						bool seen = false;
+						for (int k = 0; k < nc; k++)
+							seen |= cand[k].x == c.x && cand[k].y == c.y;
+						if (!seen)
+							cand[nc++] = c;
+					}
+				}
+			}
+			Vec2i start = cand[0];
+			float startCost = kInf;
+			for (int k = 0; k < nc; k++) {
+				float s = sad(b, r, x0, y0, x1, y1, cand[k].x, cand[k].y);
+				if (s < startCost) {
+					startCost = s;
+					start = cand[k];
+				}
+			}
+			/* finest level: the best candidate, the sub-pixel step
+			 * covers the rest */
+			f.fields[level][ty * g.cols + tx] = finest && !coarsest ? start :
+				searchAround(b, r, x0, y0, x1, y1, start, radius, nullptr);
+		}
+	});
+}
+
+/*
+ * Noise adds about count * sigma^2 / 2 to each diagonal entry of the
+ * structure tensor (central differences of white noise), sigma^2 being the
+ * noise of one frame = residual / 2. In dark, flat areas that is all there
+ * is, and such blocks must not count as structured. The factor is taken
+ * from the data (lowest fifth of the blocks: flat ones if there are any),
+ * as the residual underestimates the noise somewhat (bilinear sampling) and
+ * the noise is not white. A displacement only counts as measured where the
+ * signal exceeds the noise along the weakest direction; elsewhere the
+ * search may have locked on noise.
+ */
+void FrameAligner::Impl::signalTensors(Frame &f)
+{
+	std::vector<float> ratio;
+	for (const Block &bl : f.blocks) {
+		if (!bl.ok || bl.area < 0.75f || bl.clip > 0.1f)
+			continue;
+		const float m = 0.5f * (bl.gxx + bl.gyy);
+		const float r = std::sqrt(0.25f * (bl.gxx - bl.gyy) * (bl.gxx - bl.gyy) + bl.gxy * bl.gxy);
+		ratio.push_back((m - r) / (bl.count * noiseAt(f, bl.mean)));
+	}
+	float c = 0.25f;
+	if (ratio.size() >= 10) {
+		std::nth_element(ratio.begin(), ratio.begin() + ratio.size() / 5, ratio.end());
+		c = std::clamp(ratio[ratio.size() / 5], 0.0f, 0.5f);
+	}
+	for (Block &bl : f.blocks) {
+		const float noise = noiseAt(f, bl.mean);
+		const float gn = c * bl.count * noise;
+		const float m = 0.5f * (bl.gxx + bl.gyy);
+		const float r = std::sqrt(0.25f * (bl.gxx - bl.gyy) * (bl.gxx - bl.gyy) + bl.gxy * bl.gxy);
+		const float l1 = std::max(0.0f, m + r - gn), l2 = std::max(0.0f, m - r - gn);
+		/* same eigenvectors, eigenvalues reduced and clamped */
+		const float th = 0.5f * std::atan2(2 * bl.gxy, bl.gxx - bl.gyy);
+		const float cs = std::cos(th), sn = std::sin(th);
+		bl.sxx = l1 * cs * cs + l2 * sn * sn;
+		bl.syy = l1 * sn * sn + l2 * cs * cs;
+		bl.sxy = (l1 - l2) * cs * sn;
+		/* clipped areas: edges of the clipping, not of the scene */
+		const bool use = bl.ok && bl.clip <= 0.1f;
+		bl.var = (use && l2 >= gn && l2 > 0) ? noise * 0.5f * (l2 + gn) / (l2 * l2) : kInf;
+		bl.share = (use && l1 + l2 > 0) ? (l1 + l2) / (l1 + l2 + 2 * gn) : 0;
+		bl.fit = use && l1 >= gn;
+	}
+}
+
+/*
+ * Robust fit of the global model of a frame from its blocks: iteratively
+ * reweighted least squares (Tukey) with the information matrix of every
+ * block, the model growing from a similarity to the configured one. Then
+ * the noise of the block displacements is calibrated on the inliers (the
+ * measured scatter against the predicted one: the reduced image has
+ * correlated noise, so the prediction is too optimistic), and the model is
+ * chosen by the Bayesian information criterion, so that a homography is
+ * only used where the data supports it.
+ */
+void FrameAligner::Impl::fitFrame(Frame &f)
+{
+	const TileGrid &g = grids[0];
+	const Image16 &l0 = f.pyr[0];
+	const double cx = l0.w * 0.5, cy = l0.h * 0.5, s = std::max(l0.w, l0.h) * 0.5;
+	const int n = g.size();
+
+	/* points in normalised coordinates and their information matrices */
+	struct Point {
+		double x, y, tx, ty, wxx, wxy, wyy;
+	};
+	std::vector<Point> pts(n);
+	std::vector<double> rob(n, 0.0), res(n, 0.0);
+	for (int i = 0; i < n; i++) {
+		const Block &bl = f.blocks[i];
+		if (!bl.ok || !bl.fit)
+			continue;
+		const double var = std::max(1e-3, double(noiseAt(f, bl.mean)) * 0.5);
+		const double k = bl.share / var;
+		const int col = i % g.cols, row = i / g.cols;
+		const double x = (g.cx(col) - cx) / s, y = (g.cy(row) - cy) / s;
+		pts[i] = { x, y, x + bl.v.x / s, y + bl.v.y / s, k * bl.sxx, k * bl.sxy, k * bl.syy };
+		rob[i] = 1;
+	}
+	std::vector<bool> use(n);
+	for (int i = 0; i < n; i++)
+		use[i] = rob[i] > 0;
+	/* no block weighs more than three typical ones: a small, strongly
+	 * structured area (which may be moving) must not dominate */
+	{
+		std::vector<double> tr;
+		for (int i = 0; i < n; i++)
+			if (use[i])
+				tr.push_back(pts[i].wxx + pts[i].wyy);
+		if (!tr.empty()) {
+			std::nth_element(tr.begin(), tr.begin() + tr.size() / 2, tr.end());
+			const double cap = 3 * tr[tr.size() / 2];
+			for (int i = 0; i < n; i++) {
+				const double t = pts[i].wxx + pts[i].wyy;
+				if (use[i] && t > cap) {
+					pts[i].wxx *= cap / t;
+					pts[i].wxy *= cap / t;
+					pts[i].wyy *= cap / t;
+				}
+			}
+		}
+	}
+
+	/* measured minus model, finest level pixels */
+	auto residual = [&](const double *h, int i, double *ex, double *ey) {
+		double ox, oy;
+		applyH(h, pts[i].x, pts[i].y, &ox, &oy);
+		*ex = (pts[i].tx - ox) * s;
+		*ey = (pts[i].ty - oy) * s;
+	};
+	auto chi2 = [&](int i, double ex, double ey) {
+		return pts[i].wxx * ex * ex + 2 * pts[i].wxy * ex * ey + pts[i].wyy * ey * ey;
+	};
+
+	/* weighted least squares of model m, false if singular */
+	auto solveModel = [&](Model m, double *h) {
+		const int np = modelParams(m);
+		double a[64] = {}, rhs[8] = {};
+		double wsum = 0;
+		for (int i = 0; i < n; i++) {
+			if (rob[i] <= 0)
+				continue;
+			const Point &p = pts[i];
+			double rx[8], ry[8], bx, by;
+			modelRows(m, p.x, p.y, p.tx, p.ty, rx, ry, &bx, &by);
+			const double k = rob[i] * s * s;
+			const double wxx = k * p.wxx, wxy = k * p.wxy, wyy = k * p.wyy;
+			wsum += rob[i];
+			for (int u = 0; u < np; u++) {
+				const double ux = wxx * rx[u] + wxy * ry[u];
+				const double uy = wxy * rx[u] + wyy * ry[u];
+				for (int v = 0; v < np; v++)
+					a[u * np + v] += ux * rx[v] + uy * ry[v];
+				rhs[u] += ux * bx + uy * by;
+			}
+		}
+		/* priors: perspective terms small, others weak */
+		for (int u = 0; u < np; u++)
+			a[u * np + u] += (m == Model::Homography && u >= 6) ? 1e4 : 1e-2;
+		if (wsum < 3 || !solve(a, rhs, np))
+			return false;
+		modelMatrix(m, rhs, h);
+		return true;
+	};
+
+	/* start: median shift of the blocks (each counts once) */
+	std::vector<std::pair<double, double>> mx, my;
+	for (int i = 0; i < n; i++) {
+		if (!use[i])
+			continue;
+		mx.push_back({ f.blocks[i].v.x, 1.0 });
+		my.push_back({ f.blocks[i].v.y, 1.0 });
+	}
+	double p0[2] = { weightedMedian(mx) / s, weightedMedian(my) / s };
+	double h[9];
+	modelMatrix(Model::Translation, p0, h);
+
+	const double cMin = 0.4;	/* finest level pixels */
+	const Model target = cfg.model;
+	for (int it = 0; it < 8; it++) {
+		/* Tukey weights on the residual projected on the structure */
+		std::vector<std::pair<double, double>> rv;
+		for (int i = 0; i < n; i++) {
+			if (!use[i])
+				continue;
+			const Block &bl = f.blocks[i];
+			double ex, ey;
+			residual(h, i, &ex, &ey);
+			const double tr = bl.sxx + bl.syy;
+			res[i] = std::sqrt(std::max(0.0, 2 * (bl.sxx * ex * ex + 2 * bl.sxy * ex * ey +
+							      bl.syy * ey * ey) / tr));
+			rv.push_back({ res[i], pts[i].wxx + pts[i].wyy });
+		}
+		if (rv.size() < 3)
+			break;
+		for (auto &e : rv)
+			e.second = 1.0;
+		const double scale = std::max(0.03, 1.4826 * weightedMedian(rv));
+		const double c = std::max(cMin, 4.685 * scale);
+		for (int i = 0; i < n; i++)
+			rob[i] = use[i] ? tukey(res[i], c) : 0;
+		Model m = it < 2 && int(target) > int(Model::Similarity) ? Model::Similarity : target;
+		while (!solveModel(m, h) && m != Model::Translation)
+			m = Model(int(m) - 1);
+	}
+
+	/* scatter of the inliers against the prediction */
+	std::vector<double> z2;
+	for (int i = 0; i < n; i++) {
+		if (rob[i] < 0.5)
+			continue;
+		double ex, ey;
+		residual(h, i, &ex, &ey);
+		z2.push_back(chi2(i, ex, ey));
+	}
+	double kappa = 1;
+	if (z2.size() >= 10) {
+		std::nth_element(z2.begin(), z2.begin() + z2.size() / 2, z2.end());
+		/* median of chi-square with two degrees of freedom: 1.386 */
+		kappa = std::max(1.0, z2[z2.size() / 2] / 1.386);
+	}
+	f.kappa = kappa;
+
+	/* model choice: chi-square of the inliers plus parameters x log(n) */
+	const double penalty = std::log(std::max<double>(2, z2.size()));
+	double bestCost = std::numeric_limits<double>::infinity();
+	Model best = Model::Translation;
+	double hBest[9];
+	std::copy(h, h + 9, hBest);
+	for (int mi = 0; mi <= int(target); mi++) {
+		const Model m = Model(mi);
+		double hm[9];
+		if (!solveModel(m, hm))
+			continue;
+		double cost = modelParams(m) * penalty;
+		for (int i = 0; i < n; i++) {
+			if (rob[i] <= 0)
+				continue;
+			double ex, ey;
+			residual(hm, i, &ex, &ey);
+			cost += rob[i] * chi2(i, ex, ey) / kappa;
+		}
+		if (cost < bestCost) {
+			bestCost = cost;
+			best = m;
+			std::copy(hm, hm + 9, hBest);
+		}
+	}
+	std::copy(hBest, hBest + 9, h);
+
+	/* to corner coordinates of the finest level: x' = s H((x - c) / s) + c */
+	const double t[9] = { 1 / s, 0, -cx / s, 0, 1 / s, -cy / s, 0, 0, 1 };
+	const double ti[9] = { s, 0, cx, 0, s, cy, 0, 0, 1 };
+	double tmp[9], out[9];
+	for (int r = 0; r < 3; r++)
+		for (int c = 0; c < 3; c++) {
+			tmp[r * 3 + c] = 0;
+			for (int k = 0; k < 3; k++)
+				tmp[r * 3 + c] += h[r * 3 + k] * t[k * 3 + c];
+		}
+	for (int r = 0; r < 3; r++)
+		for (int c = 0; c < 3; c++) {
+			out[r * 3 + c] = 0;
+			for (int k = 0; k < 3; k++)
+				out[r * 3 + c] += ti[r * 3 + k] * tmp[k * 3 + c];
+		}
+	for (int k = 0; k < 9; k++)
+		f.h[k] = out[k] / out[8];
+	f.result.model = best;
+}
+
+/*
+ * Second measurement of the blocks of a row that disagree with the global model,
+ * the sub-pixel step starting at the model. Taken unless it fits
+ * significantly worse than the first one: then the first one had locked on
+ * noise (weak structure, coarse levels); a real local motion keeps its
+ * first measurement.
+ */
+int FrameAligner::Impl::remeasure(Frame &f, const Image16 &b, int ty)
+{
+	const TileGrid &g = grids[0];
+	const Image16 &r = f.pyr[0];
+	const int margin = g.tile / 4;
+	int changed = 0;
+	{
+		for (int tx = 0; tx < g.cols; tx++) {
+			Block &bl = f.blocks[ty * g.cols + tx];
+			double ox, oy;
+			applyH(f.h, g.cx(tx), g.cy(ty), &ox, &oy);
+			Vec2 v = { float(ox - g.cx(tx)), float(oy - g.cy(ty)) };
+			const bool agrees = bl.ok && std::fabs(bl.v.x - v.x) < 0.5f && std::fabs(bl.v.y - v.y) < 0.5f;
+			/* brightness difference above half a level: measure again with it */
+			if (agrees && std::fabs(bl.off) < 8)
+				continue;
+			if (agrees)
+				v = bl.v;
+			Block nb = bl;
+			refine(b, grad, r, g.ox + tx * g.tile - margin, g.oy + ty * g.tile - margin,
+			       g.ox + (tx + 1) * g.tile + margin, g.oy + (ty + 1) * g.tile + margin, v, nb, 6,
+			       bl.off);
+			if (!nb.ok)
+				continue;
+			if (agrees || !bl.ok || nb.mseFit < bl.mseFit + 0.3f * noiseAt(f, bl.mean)) {
+				bl = nb;
+				changed++;
+			}
+		}
+	}
+	return changed;
+}
+
+/*
+ * Smooth brightness difference of the frames (light flicker with the rolling
+ * shutter, shading): median of the block differences over 5 x 5 blocks.
+ */
+void FrameAligner::Impl::brightnessField(Frame &f)
+{
+	const TileGrid &g = grids[0];
+	std::vector<float> v;
+	v.reserve(25);
+	for (int row = 0; row < g.rows; row++) {
+		for (int col = 0; col < g.cols; col++) {
+			v.clear();
+			for (int j = std::max(0, row - 2); j <= std::min(g.rows - 1, row + 2); j++)
+				for (int i = std::max(0, col - 2); i <= std::min(g.cols - 1, col + 2); i++) {
+					const Block &bl = f.blocks[j * g.cols + i];
+					if (bl.ok && bl.clip <= 0.1f && bl.area >= 0.75f)
+						v.push_back(bl.offset);
+				}
+			float m = 0;
+			if (v.size() >= 5) {
+				std::nth_element(v.begin(), v.begin() + v.size() / 2, v.end());
+				m = v[v.size() / 2];
+			}
+			f.blocks[row * g.cols + col].off = m;
+		}
+	}
+}
+
+/* Smooth local correction of what the global model leaves */
+void FrameAligner::Impl::localField(Frame &f)
+{
+	const TileGrid &g = grids[0];
+	const int n = g.size();
+	const float ds = cfg.downscale;
+	const float thr = cfg.motionThreshold / ds;
+	const float maxLocal = cfg.maxLocal / ds;
+	std::vector<Vec2> r(n, { 0, 0 });
+	std::vector<float> w(n, 0), sd(n, 0);
+
+	for (int i = 0; i < n; i++) {
+		const Block &bl = f.blocks[i];
+		const int col = i % g.cols, row = i / g.cols;
+		double ox, oy;
+		applyH(f.h, g.cx(col), g.cy(row), &ox, &oy);
+		r[i] = { float(bl.v.x - (ox - g.cx(col))), float(bl.v.y - (oy - g.cy(row))) };
+		if (!bl.ok)
+			continue;
+		/* variance of the displacement along its weakest direction */
+		if (!(bl.var < kInf))
+			continue;
+		const float v = std::max(1e-4f, float(bl.var * f.kappa));
+		sd[i] = std::sqrt(v);
+		w[i] = 1.0f / v;
+	}
+
+	/* Gaussian over 5x5 blocks */
+	float k[5];
+	for (int i = 0; i < 5; i++)
+		k[i] = std::exp(-0.5f * (i - 2) * (i - 2) / (1.5f * 1.5f));
+
+	std::vector<Vec2> sm(n, { 0, 0 });
+	std::vector<float> inl(n, 0);
+	for (int pass = 0; pass < 2; pass++) {
+		for (int i = 0; i < n; i++) {
+			const float dx = r[i].x - sm[i].x, dy = r[i].y - sm[i].y;
+			const float lim = std::max(thr, 4 * sd[i]);
+			inl[i] = (w[i] > 0 && dx * dx + dy * dy < lim * lim) ? w[i] : 0;
+		}
+		std::vector<Vec2> next(n);
+		for (int row = 0; row < g.rows; row++) {
+			for (int col = 0; col < g.cols; col++) {
+				double sx = 0, sy = 0, sw = 0, sk2 = 0, sw2 = 0;
+				for (int dj = -2; dj <= 2; dj++) {
+					const int j = row + dj;
+					if (j < 0 || j >= g.rows)
+						continue;
+					for (int di = -2; di <= 2; di++) {
+						const int c = col + di;
+						if (c < 0 || c >= g.cols)
+							continue;
+						const int idx = j * g.cols + c;
+						const double kw = k[di + 2] * k[dj + 2];
+						const double ww = kw * inl[idx];
+						sx += ww * r[idx].x;
+						sy += ww * r[idx].y;
+						sw += ww;
+						sw2 += ww * ww;
+						sk2 += kw * kw * inl[idx];
+					}
+				}
+				/* at least three blocks' worth of support: a single block
+				 * that seems to deviate may have locked on noise */
+				Vec2 v = { 0, 0 };
+				if (sw > 0 && sw * sw >= 3 * sw2) {
+					v = { float(sx / sw), float(sy / sw) };
+					if (pass == 1) {
+						/* soft threshold at twice the standard error */
+						const float se = float(std::sqrt(sk2) / sw);
+						const float len = std::sqrt(v.x * v.x + v.y * v.y);
+						const float keep = len > 0 ? std::max(0.0f, 1 - 2 * se / len) : 0;
+						v.x *= keep;
+						v.y *= keep;
+						const float l2 = len * keep;
+						if (l2 > maxLocal) {
+							v.x *= maxLocal / l2;
+							v.y *= maxLocal / l2;
+						}
+					}
+				}
+				next[row * g.cols + col] = v;
+			}
+		}
+		sm.swap(next);
+	}
+	f.local = sm;
+}
+
+/* Bilinear local correction at a position of the finest level (corner
+ * coordinates), constant beyond the outer block centres */
+Vec2 FrameAligner::Impl::localAt(const Frame &f, float x, float y) const
+{
+	const TileGrid &g = grids[0];
+	const float fx = std::clamp((x - g.ox) / g.tile - 0.5f, 0.0f, float(g.cols - 1));
+	const float fy = std::clamp((y - g.oy) / g.tile - 0.5f, 0.0f, float(g.rows - 1));
+	const int i0 = std::min(int(fx), g.cols - 1), j0 = std::min(int(fy), g.rows - 1);
+	const int i1 = std::min(i0 + 1, g.cols - 1), j1 = std::min(j0 + 1, g.rows - 1);
+	const float ax = fx - i0, ay = fy - j0;
+	const Vec2 &a = f.local[j0 * g.cols + i0], &b = f.local[j0 * g.cols + i1];
+	const Vec2 &c = f.local[j1 * g.cols + i0], &d = f.local[j1 * g.cols + i1];
+	return { (1 - ay) * ((1 - ax) * a.x + ax * b.x) + ay * ((1 - ax) * c.x + ax * d.x),
+		 (1 - ay) * ((1 - ax) * a.y + ax * b.y) + ay * ((1 - ax) * c.y + ax * d.y) };
+}
+
+/* Reliability, quality figures and control points of a frame */
+void FrameAligner::Impl::finish(Frame &f)
+{
+	const TileGrid &g = grids[0];
+	const int n = g.size();
+	const float ds = cfg.downscale;
+	const float thr = cfg.motionThreshold / ds;
+	FrameResult &res = f.result;
+
+	double sumW = 0, sumR = 0;
+	int rejected = 0;
+	std::vector<float> q;
+	q.reserve(n);
+	for (int i = 0; i < n; i++) {
+		const Block &bl = f.blocks[i];
+		const int col = i % g.cols, row = i / g.cols;
+		double ox, oy;
+		applyH(f.h, g.cx(col), g.cy(row), &ox, &oy);
+		const Vec2 s = f.local[i];
+		const float gx = float(ox - g.cx(col)), gy = float(oy - g.cy(row));
+		/* deviation of the measured motion from the final one, projected
+		 * on the directions with structure */
+		const float ex = bl.v.x - gx - s.x, ey = bl.v.y - gy - s.y;
+		const float tr = bl.sxx + bl.syy;
+		const float dev = tr > 0 ? std::sqrt(std::max(0.0f, 2 * (bl.sxx * ex * ex + 2 * bl.sxy * ex * ey +
+									 bl.syy * ey * ey) / tr))
+					 : std::sqrt(ex * ex + ey * ey);
+		/* precision of the measurement */
+		const float noise = noiseAt(f, bl.mean);
+		const float sd = std::sqrt(float(bl.var * f.kappa));
+		/* moving: the measured motion is significantly away from the final
+		 * one and fits significantly better (more than 4 standard
+		 * deviations of a mean of squares of about 100 independent
+		 * values) */
+		const bool moving = bl.ok && dev > std::max(thr, 4 * sd) &&
+				    bl.mse - bl.mseFit > 0.4f * noise;
+
+		/* match error at the final motion, stored in mse by the caller */
+		const float ratio = bl.mse / std::max(1e-3f, noise);
+		q.push_back(ratio);
+		float rel = std::clamp((cfg.errorHigh - ratio) / (cfg.errorHigh - cfg.errorLow), 0.0f, 1.0f);
+		rel *= std::clamp(2 * bl.area - 1, 0.0f, 1.0f);
+		if (moving)
+			rel = 0;
+		f.rel[i] = uint8_t(std::lround(rel * 255));
+		if (f.rel[i] < 128)
+			rejected++;
+		else if (bl.ok && sd < thr && !moving) {
+			/* deviations beyond the motion threshold count as the
+			 * threshold (those are outliers, not imprecision); the
+			 * expected scatter of the measurement is taken off */
+			const double w = 1.0 / std::max(1e-4f, sd * sd);
+			const double e = std::min(dev, thr);
+			sumW += w;
+			sumR += w * (e * e - double(sd) * sd);
+		}
+	}
+	res.rejected = float(rejected) / n;
+	res.residual = sumW > 0 ? float(std::sqrt(std::max(0.0, sumR / sumW))) * ds : 0;
+	std::nth_element(q.begin(), q.begin() + q.size() / 2, q.end());
+	res.matchError = q.empty() ? 0 : q[q.size() / 2];
+	res.noise = std::sqrt(noiseAt(f, 2048) * 0.5f) / 16;
+
+	/* control points in frame pixels (corner coordinates) */
+	const int step = nodeStep;
+	f.nodes.resize(size_t(nodeCols + 1) * (nodeRows + 1));
+	for (int j = 0; j <= nodeRows; j++) {
+		for (int i = 0; i <= nodeCols; i++) {
+			const double x = double(i) * step, y = double(j) * step;
+			double ox, oy;
+			applyH(f.h, x / ds, y / ds, &ox, &oy);
+			const Vec2 s = localAt(f, float(x / ds), float(y / ds));
+			f.nodes[j * (nodeCols + 1) + i] = { float((ox + s.x) * ds - x),
+							    float((oy + s.y) * ds - y) };
+		}
+	}
+	/* valid part: where the source of the border pixels lies inside */
+	auto at = [&](float x, float y) {
+		const float fx = std::clamp(x / step, 0.0f, float(nodeCols));
+		const float fy = std::clamp(y / step, 0.0f, float(nodeRows));
+		const int i = std::min(int(fx), nodeCols - 1), j = std::min(int(fy), nodeRows - 1);
+		const float ax = fx - i, ay = fy - j;
+		const Vec2 *n0 = &f.nodes[size_t(j) * (nodeCols + 1) + i], *n1 = n0 + nodeCols + 1;
+		return Vec2{ (1 - ay) * ((1 - ax) * n0[0].x + ax * n0[1].x) + ay * ((1 - ax) * n1[0].x + ax * n1[1].x),
+			     (1 - ay) * ((1 - ax) * n0[0].y + ax * n0[1].y) + ay * ((1 - ax) * n1[0].y + ax * n1[1].y) };
+	};
+	float minX = 0, maxX = 0, minY = 0, maxY = 0;
+	for (unsigned int k = 0; k <= height; k += step / 4) {
+		const float y = std::min<float>(k, height);
+		minX = std::max(minX, -at(0, y).x);
+		maxX = std::max(maxX, at(width, y).x);
+	}
+	for (unsigned int k = 0; k <= width; k += step / 4) {
+		const float x = std::min<float>(k, width);
+		minY = std::max(minY, -at(x, 0).y);
+		maxY = std::max(maxY, at(x, height).y);
+	}
+	const unsigned int x0 = std::min<unsigned int>(width / 2, unsigned(std::ceil(minX)) + 1);
+	const unsigned int y0 = std::min<unsigned int>(height / 2, unsigned(std::ceil(minY)) + 1);
+	const unsigned int x1 = width - std::min<unsigned int>(width / 2, unsigned(std::ceil(maxX)) + 1);
+	const unsigned int y1 = height - std::min<unsigned int>(height / 2, unsigned(std::ceil(maxY)) + 1);
+	res.validRect[0] = x0;
+	res.validRect[1] = y0;
+	res.validRect[2] = x1 > x0 ? x1 - x0 : 0;
+	res.validRect[3] = y1 > y0 ? y1 - y0 : 0;
+
+	/* homography in frame pixel centres: x_i = x_c - 0.5 */
+	double hf[9];
+	{
+		const double sc[9] = { ds, 0, 0, 0, ds, 0, 0, 0, 1 };
+		const double si[9] = { 1 / ds, 0, 0, 0, 1 / ds, 0, 0, 0, 1 };
+		const double to[9] = { 1, 0, -0.5, 0, 1, -0.5, 0, 0, 1 };
+		const double from[9] = { 1, 0, 0.5, 0, 1, 0.5, 0, 0, 1 };
+		const double *chain[5] = { to, sc, f.h, si, from };
+		double m[9] = { 1, 0, 0, 0, 1, 0, 0, 0, 1 };
+		for (const double *c : chain) {
+			double t[9];
+			for (int r = 0; r < 3; r++)
+				for (int k = 0; k < 3; k++) {
+					t[r * 3 + k] = 0;
+					for (int l = 0; l < 3; l++)
+						t[r * 3 + k] += m[r * 3 + l] * c[l * 3 + k];
+				}
+			std::copy(t, t + 9, m);
+		}
+		for (int k = 0; k < 9; k++)
+			hf[k] = m[k] / m[8];
+	}
+	std::copy(hf, hf + 9, res.homography);
+
+	res.valid = true;
+	res.usable = res.rejected < cfg.maxRejected && res.residual < cfg.maxResidual;
+}
+
+int FrameAligner::estimate(const Nv12Frame *in, unsigned int count, unsigned int width,
+			   unsigned int height)
+{
+	Impl &d = *impl_;
+	const AlignConfig &cfg = d.cfg;
+	if (!in || count < 1 || count > 16 || width < 64 || height < 64 || (width | height) & 1 ||
+	    (cfg.downscale != 2 && cfg.downscale != 4) || cfg.block < 4)
+		return -1;
+	for (unsigned int i = 0; i < count; i++)
+		if (!in[i].y || !in[i].uv || in[i].strideY < width || in[i].strideUV < width)
+			return -1;
+
+	double t0 = nowMs();
+	d.width = width;
+	d.height = height;
+	d.frames.assign(count, Frame());
+	const auto sizes = pyramidSizes(width, height, cfg);
+	const int nl = sizes.size();
+	d.grids.assign(nl, TileGrid());
+	for (int l = 0; l < nl; l++)
+		d.grids[l].setup(sizes[l].first, sizes[l].second,
+				 l == 0 ? cfg.block : (l == 1 ? 16 : 8));
+	const TileGrid &g0 = d.grids[0];
+	d.blockGrid = { unsigned(g0.cols), unsigned(g0.rows), g0.ox * cfg.downscale,
+			g0.oy * cfg.downscale, g0.tile * cfg.downscale };
+	d.nodeStep = g0.tile * cfg.downscale;
+	d.nodeCols = (width + d.nodeStep - 1) / d.nodeStep;
+	d.nodeRows = (height + d.nodeStep - 1) / d.nodeStep;
+
+	/* 1. reduction and sharpness */
+	for (unsigned int i = 0; i < count; i++) {
+		Frame &f = d.frames[i];
+		f.img = in[i];
+		f.pyr.resize(nl);
+		f.pyr[0].resize(sizes[0].first, sizes[0].second);
+		f.fields.resize(nl);
+		f.result = FrameResult();
+		f.result.model = Model::Translation;
+	}
+	const int band = 32;
+	const int bands = (sizes[0].second + band - 1) / band;
+	/* sharpness on every 16th row pair: 4 rows each */
+	const int sharpStep = 16;
+	const int sharpRowsTotal = (int(height) - 4) / sharpStep + 1;
+	std::vector<double> sharpParts(size_t(count) * bands, 0.0);
+	d.pool.run(size_t(count) * bands, [&](size_t item) {
+		thread_local std::vector<uint16_t> tmp;
+		Frame &f = d.frames[item / bands];
+		const int b = item % bands;
+		const int r0 = b * band, r1 = std::min(sizes[0].second, r0 + band);
+		reduceRows(f.img.y, f.img.strideY, cfg.downscale, f.pyr[0], r0, r1, tmp);
+		/* the share of the sharpness rows of this band */
+		const int s0 = b * sharpRowsTotal / bands, s1 = (b + 1) * sharpRowsTotal / bands;
+		double sum = 0;
+		for (int s = s0; s < s1; s++)
+			sum += sharpRows(f.img.y, f.img.strideY, width, s * sharpStep, s * sharpStep + 1, tmp);
+		sharpParts[item] = sum;
+	});
+	d.pool.run(count, [&](size_t i) {
+		thread_local std::vector<uint16_t> tmp;
+		Frame &f = d.frames[i];
+		smooth121(f.pyr[0], tmp);
+		for (int l = 1; l < nl; l++)
+			halve(f.pyr[l - 1], f.pyr[l]);
+		double s = 0;
+		for (int b = 0; b < bands; b++)
+			s += sharpParts[i * bands + b];
+		f.sharp = s / (double(sharpRowsTotal) * (width / 2));
+	});
+	double t1 = nowMs();
+
+	/* 2. base frame */
+	unsigned int base = 0;
+	if (cfg.baseIndex >= 0 && unsigned(cfg.baseIndex) < count) {
+		base = cfg.baseIndex;
+	} else {
+		double best = 0;
+		for (const Frame &f : d.frames)
+			best = std::max(best, f.sharp);
+		double mid = (count - 1) * 0.5, bestDist = 1e9;
+		for (unsigned int i = 0; i < count; i++) {
+			if (d.frames[i].sharp < best * (1 - cfg.baseTolerance))
+				continue;
+			if (std::fabs(i - mid) < bestDist) {
+				bestDist = std::fabs(i - mid);
+				base = i;
+			}
+		}
+	}
+	d.baseIndex = base;
+	for (unsigned int i = 0; i < count; i++)
+		d.frames[i].result.sharpness = float(d.frames[i].sharp / std::max(1e-9, d.frames[base].sharp));
+
+	std::vector<unsigned int> refs;
+	for (unsigned int i = 0; i < count; i++)
+		if (i != base)
+			refs.push_back(i);
+
+	/* 3. global shift on the coarsest level, then tiles coarse to fine */
+	d.pool.run(refs.size(), [&](size_t k) {
+		Frame &f = d.frames[refs[k]];
+		const Image16 &b = d.frames[base].pyr[nl - 1], &r = f.pyr[nl - 1];
+		const int rad = std::min<int>(cfg.coarseSearch, std::min(b.w, b.h) / 4);
+		f.global = d.grids.size() ? searchAround(b, r, rad, rad, b.w - rad, b.h - rad, { 0, 0 }, rad, nullptr)
+					  : Vec2i{ 0, 0 };
+	});
+	for (int l = nl - 1; l >= 0; l--)
+		d.matchLevel(l);
+
+	/* sub-pixel refinement on the finest level */
+	{
+		const Image16 &b = d.frames[base].pyr[0];
+		d.grad.w = b.w;
+		d.grad.h = b.h;
+		d.grad.gx.resize(size_t(b.w) * b.h);
+		d.grad.gy.resize(size_t(b.w) * b.h);
+		d.pool.run(bands, [&](size_t k) {
+			d.grad.rows(b, k * band, std::min<int>(b.h, (k + 1) * band));
+		});
+	}
+	const int margin = g0.tile / 4;
+	for (unsigned int i : refs)
+		d.frames[i].blocks.assign(g0.size(), Block());
+	d.pool.run(refs.size() * g0.rows, [&](size_t item) {
+		Frame &f = d.frames[refs[item / g0.rows]];
+		const int ty = item % g0.rows;
+		const Image16 &b = d.frames[base].pyr[0], &r = f.pyr[0];
+		for (int tx = 0; tx < g0.cols; tx++) {
+			const int idx = ty * g0.cols + tx;
+			const Vec2i iv = f.fields[0][idx];
+			Vec2 v = { float(iv.x), float(iv.y) };
+			refine(b, d.grad, r, g0.ox + tx * g0.tile - margin, g0.oy + ty * g0.tile - margin,
+			       g0.ox + (tx + 1) * g0.tile + margin, g0.oy + (ty + 1) * g0.tile + margin,
+			       v, f.blocks[idx], 6);
+		}
+	});
+	double t2 = nowMs();
+
+	/* 4.-6. noise model, global model, local field */
+	d.pool.run(refs.size(), [&](size_t k) {
+		Frame &f = d.frames[refs[k]];
+		std::vector<std::vector<float>> bins(kNoiseBins);
+		std::vector<float> all;
+		for (const Block &bl : f.blocks) {
+			if (!bl.ok || bl.area < 0.75f || bl.clip > 0.1f)
+				continue;
+			const int i = std::clamp(int(bl.mean * kNoiseBins / 4096.0f), 0, kNoiseBins - 1);
+			bins[i].push_back(bl.mse);
+			all.push_back(bl.mse);
+		}
+		auto median = [](std::vector<float> &v) {
+			std::nth_element(v.begin(), v.begin() + v.size() / 2, v.end());
+			return v[v.size() / 2];
+		};
+		const float fallback = all.empty() ? 1.0f : median(all);
+		f.noiseBins.assign(kNoiseBins, -1.0f);
+		for (int i = 0; i < kNoiseBins; i++)
+			if (bins[i].size() >= 8)
+				f.noiseBins[i] = median(bins[i]);
+		/* fill gaps by linear interpolation, constant at the ends */
+		int last = -1;
+		for (int i = 0; i < kNoiseBins; i++) {
+			if (f.noiseBins[i] < 0)
+				continue;
+			if (last < 0) {
+				for (int j = 0; j < i; j++)
+					f.noiseBins[j] = f.noiseBins[i];
+			} else {
+				for (int j = last + 1; j < i; j++)
+					f.noiseBins[j] = f.noiseBins[last] + (f.noiseBins[i] - f.noiseBins[last]) *
+										     (j - last) / (i - last);
+			}
+			last = i;
+		}
+		if (last < 0)
+			f.noiseBins.assign(kNoiseBins, fallback);
+		else
+			for (int j = last + 1; j < kNoiseBins; j++)
+				f.noiseBins[j] = f.noiseBins[last];
+		/* clipped or very bright bins: not below a tenth of the typical noise */
+		for (float &v : f.noiseBins)
+			v = std::max({ v, 1.0f, 0.1f * fallback });
+
+		d.signalTensors(f);
+		d.fitFrame(f);
+		d.brightnessField(f);
+	});
+	/* second measurement near the model, then the final fit */
+	std::vector<std::atomic<int>> changed(count);
+	d.pool.run(refs.size() * g0.rows, [&](size_t item) {
+		const unsigned int i = refs[item / g0.rows];
+		changed[i] += d.remeasure(d.frames[i], d.frames[base].pyr[0], item % g0.rows);
+	});
+	d.pool.run(refs.size(), [&](size_t k) {
+		Frame &f = d.frames[refs[k]];
+		if (changed[refs[k]]) {
+			d.signalTensors(f);
+			d.fitFrame(f);
+		}
+		d.localField(f);
+	});
+
+	/* 7. match error at the final motion */
+	d.pool.run(refs.size() * g0.rows, [&](size_t item) {
+		Frame &f = d.frames[refs[item / g0.rows]];
+		const int ty = item % g0.rows;
+		const Image16 &b = d.frames[base].pyr[0], &r = f.pyr[0];
+		for (int tx = 0; tx < g0.cols; tx++) {
+			const int idx = ty * g0.cols + tx;
+			double ox, oy;
+			applyH(f.h, g0.cx(tx), g0.cy(ty), &ox, &oy);
+			const Vec2 s = f.local[idx];
+			const Vec2 v = { float(ox - g0.cx(tx)) + s.x, float(oy - g0.cy(ty)) + s.y };
+			Block &bl = f.blocks[idx];
+			residualAt(b, r, g0.ox + tx * g0.tile - margin, g0.oy + ty * g0.tile - margin,
+				   g0.ox + (tx + 1) * g0.tile + margin, g0.oy + (ty + 1) * g0.tile + margin,
+				   v, bl.off, &bl.mse, &bl.area);
+		}
+	});
+	d.pool.run(refs.size(), [&](size_t k) {
+		Frame &f = d.frames[refs[k]];
+		f.rel.assign(g0.size(), 0);
+		d.finish(f);
+	});
+
+	/* the base frame: identity */
+	{
+		Frame &f = d.frames[base];
+		f.rel.assign(g0.size(), 255);
+		f.local.assign(g0.size(), { 0, 0 });
+		f.nodes.assign(size_t(d.nodeCols + 1) * (d.nodeRows + 1), { 0, 0 });
+		const double id[9] = { 1, 0, 0, 0, 1, 0, 0, 0, 1 };
+		std::copy(id, id + 9, f.h);
+		std::copy(id, id + 9, f.result.homography);
+		f.result.valid = false;
+		f.result.usable = true;
+		f.result.validRect[0] = 0;
+		f.result.validRect[1] = 0;
+		f.result.validRect[2] = width;
+		f.result.validRect[3] = height;
+	}
+
+	/* release the pyramids */
+	std::vector<int16_t>().swap(d.grad.gx);
+	std::vector<int16_t>().swap(d.grad.gy);
+	for (Frame &f : d.frames) {
+		std::vector<Image16>().swap(f.pyr);
+		std::vector<std::vector<Vec2i>>().swap(f.fields);
+	}
+	double t3 = nowMs();
+	d.timing.reduce = t1 - t0;
+	d.timing.match = t2 - t1;
+	d.timing.fit = t3 - t2;
+	return base;
+}
+
