diff --git a/test/mtkisp50/raw_stats.cpp b/test/mtkisp50/raw_stats.cpp
new file mode 100644
index 0000000..bb16fec
--- /dev/null
+++ b/test/mtkisp50/raw_stats.cpp
@@ -0,0 +1,372 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * mtkisp50: the CPU statistics in the statistics buffer layout, read through
+ * the statistics view of the IPA, must equal what the software ISP statistics
+ * (SwStatsCpu) gave the simple IPA, frame by frame, for the same raw frames and
+ * settings.
+ *
+ * Synthetic MediaTek packed raw frames by default; with the environment
+ * variable MTKISP50_RAW set to "<width>x<height>:<stride>:<file>[,...]" real
+ * frames are used as well.
+ */
+
+#include <cstdlib>
+#include <fstream>
+#include <iostream>
+#include <memory>
+#include <random>
+#include <sstream>
+#include <stdint.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <vector>
+
+#include <libcamera/base/memfd.h>
+
+#include <libcamera/camera_manager.h>
+#include <libcamera/formats.h>
+#include <libcamera/framebuffer.h>
+#include <libcamera/stream.h>
+
+#include "libcamera/internal/mapped_framebuffer.h"
+#include "libcamera/internal/mtkisp50/stats.h"
+#include "libcamera/internal/software_isp/mtisp.h"
+#include "libcamera/internal/software_isp/swisp_stats.h"
+#include "libcamera/internal/software_isp/swstats_cpu.h"
+
+#include "mtkisp50/statistics.h"
+#include "raw_stats_cpu.h"
+
+#include "test.h"
+
+using namespace libcamera;
+
+namespace {
+
+struct Frame {
+	Size size;
+	unsigned int stride;
+	std::unique_ptr<FrameBuffer> buffer;
+};
+
+std::unique_ptr<FrameBuffer> makeBuffer(size_t size)
+{
+	UniqueFD fd = MemFd::create("mtkisp50-test", size);
+	if (!fd.isValid())
+		return nullptr;
+
+	FrameBuffer::Plane plane;
+	plane.fd = SharedFD(std::move(fd));
+	plane.offset = 0;
+	plane.length = size;
+	return std::make_unique<FrameBuffer>(std::vector<FrameBuffer::Plane>{ plane });
+}
+
+/* Synthetic BGGR scene: gradients per channel, a bright patch and noise */
+Frame syntheticFrame(const Size &size, unsigned int seed)
+{
+	Frame frame;
+	frame.size = size;
+	/* Line padded like the capture device: multiple of 8 bytes and more */
+	frame.stride = ((size.width * 10 / 8 + 7) & ~7u) + 16;
+	frame.buffer = makeBuffer(frame.stride * size.height);
+
+	MappedFrameBuffer map(frame.buffer.get(), MappedFrameBuffer::MapFlag::Write);
+	uint8_t *data = map.planes()[0].data();
+	std::mt19937 rng(seed);
+	std::uniform_int_distribution<int> noise(-40, 40);
+
+	for (unsigned int y = 0; y < size.height; y++) {
+		uint8_t *line = data + y * frame.stride;
+		for (unsigned int x = 0; x < size.width; x += 4) {
+			uint16_t px[4];
+			for (unsigned int i = 0; i < 4; i++) {
+				const unsigned int xx = x + i;
+				const unsigned int c = (y & 1) * 2 + (xx & 1);
+				int v = 64 + (c == 0 ? 3 * xx / 8 : c == 3 ? 2 * y / 5 : (xx + y) / 4);
+				if (xx > size.width / 3 && xx < size.width / 2 && y > size.height / 4 &&
+				    y < size.height / 3)
+					v += 600 + seed * 7;
+				v += noise(rng);
+				px[i] = std::clamp(v, 0, 1023);
+			}
+			mtisp::packGroup(px, line + x / 4 * 5);
+		}
+	}
+
+	return frame;
+}
+
+Frame fileFrame(const std::string &spec)
+{
+	Frame frame;
+	unsigned int w, h, stride;
+	char sep;
+	std::istringstream in(spec);
+	in >> w >> sep >> h >> sep >> stride >> sep;
+	std::string path;
+	std::getline(in, path);
+
+	std::ifstream file(path, std::ios::binary);
+	if (!file)
+		return frame;
+
+	frame.size = Size(w, h);
+	frame.stride = stride;
+	frame.buffer = makeBuffer(stride * h);
+	MappedFrameBuffer map(frame.buffer.get(), MappedFrameBuffer::MapFlag::Write);
+	file.read(reinterpret_cast<char *>(map.planes()[0].data()), stride * h);
+	if (!file)
+		frame.buffer.reset();
+
+	return frame;
+}
+
+/* What the simple IPA took from the shared statistics of SwStatsCpu */
+class OldView
+{
+public:
+	SwIspStats copy{};
+
+	void update(const SwIspStats *shared, uint32_t frame)
+	{
+		copy.valid = false;
+		copy.afGridValid = false;
+
+		if (frame % SwIspStats::kFramesPerStats) {
+			copyAfGrid(shared, frame);
+			return;
+		}
+
+		if (shared->valid && shared->frame == frame) {
+			copy = *shared;
+			if (copy.afGridFrame != frame)
+				copy.afGridValid = false;
+			return;
+		}
+
+		copy.valid = false;
+		copyAfGrid(shared, frame);
+	}
+
+private:
+	void copyAfGrid(const SwIspStats *shared, uint32_t frame)
+	{
+		copy.afGridValid = false;
+		if (!(shared->afGridValid && shared->afGridFrame == frame))
+			return;
+
+		const unsigned int cells = std::min<unsigned int>(shared->afGridWidth * shared->afGridHeight,
+								  copy.afGrid.size());
+		copy.afGridWidth = shared->afGridWidth;
+		copy.afGridHeight = shared->afGridHeight;
+		copy.afCellSize = shared->afCellSize;
+		copy.afCellSamples = shared->afCellSamples;
+		std::copy_n(shared->afGrid.begin(), cells, copy.afGrid.begin());
+		copy.afGridValid = true;
+		copy.afGridFrame = frame;
+	}
+};
+
+struct Settings {
+	unsigned int interval;
+	unsigned int afInterval;
+	bool afEveryFrame;
+	unsigned int linePairStep;
+	unsigned int afRegionMode;
+	std::array<uint16_t, 4> afRegion;
+};
+
+} /* namespace */
+
+class MtkIsp50RawStatsTest : public Test
+{
+protected:
+	int init() override
+	{
+		cm_ = std::make_unique<CameraManager>();
+		return TestPass;
+	}
+
+	int compare(const SwIspStats &a, const ipa::mtkisp50::Statistics &b, uint32_t frame)
+	{
+		std::ostringstream err;
+
+		if (a.valid != b.valid)
+			err << "valid " << a.valid << "/" << b.valid;
+
+		if (a.valid && b.valid) {
+			if (a.frame != b.frame || !(a.sum_ == b.sum_))
+				err << " sums " << a.sum_ << "/" << b.sum_;
+			for (unsigned int j = 0; j < SwIspStats::kZones * SwIspStats::kZones; j++) {
+				if (!(a.zoneSum[j] == b.zoneSum[j]) || a.zoneCount[j] != b.zoneCount[j]) {
+					err << " zone " << j << " " << a.zoneSum[j] << "/" << b.zoneSum[j]
+					    << " count " << a.zoneCount[j] << "/" << b.zoneCount[j];
+					break;
+				}
+			}
+			for (unsigned int j = 0; j < SwIspStats::kYHistogramSize; j++) {
+				if (a.yHistogram[j] != b.yHistogram[j]) {
+					err << " histogram bin " << j;
+					break;
+				}
+			}
+		}
+
+		if (a.afGridValid != b.afGridValid)
+			err << " afGridValid " << a.afGridValid << "/" << b.afGridValid;
+
+		if (a.afGridValid && b.afGridValid) {
+			if (a.afGridWidth != b.afGridWidth || a.afGridHeight != b.afGridHeight ||
+			    a.afCellSize != b.afCellSize || a.afCellSamples != b.afCellSamples)
+				err << " grid geometry";
+			for (unsigned int j = 0; j < a.afGridWidth * a.afGridHeight; j++) {
+				if (a.afGrid[j] != b.afGrid[j]) {
+					err << " grid cell " << j;
+					break;
+				}
+			}
+		}
+
+		if (err.str().empty())
+			return TestPass;
+
+		std::cerr << "frame " << frame << ":" << err.str() << std::endl;
+		return TestFail;
+	}
+
+	int runSequence(const std::vector<Frame *> &frames, const Rectangle &window,
+			unsigned int count, unsigned int &compared)
+	{
+		StreamConfiguration cfg;
+		cfg.pixelFormat = formats::SBGGR10_MTISP;
+		cfg.size = frames[0]->size;
+		cfg.stride = frames[0]->stride;
+
+		SwStatsCpu oldStats(*cm_);
+		RawStatsCpu newStats;
+		if (oldStats.configure(cfg) || newStats.configure(cfg)) {
+			std::cerr << "configure failed" << std::endl;
+			return TestFail;
+		}
+		oldStats.setWindow(window);
+		newStats.setWindow(window);
+
+		const SwIspStats *shared = static_cast<const SwIspStats *>(
+			mmap(nullptr, sizeof(SwIspStats), PROT_READ, MAP_SHARED,
+			     oldStats.getStatsFD().get(), 0));
+		if (shared == MAP_FAILED)
+			return TestFail;
+
+		auto out = std::make_unique<mtkisp50::StatsBuffer>();
+		auto view = std::make_unique<ipa::mtkisp50::Statistics>();
+		auto oldView = std::make_unique<OldView>();
+		*view = {};
+
+		/* Settings as the IPA changes them: settled, focus search, regions */
+		const std::vector<Settings> schedule = {
+			{ 4, 1, false, 8, 0, { 0, 0, 16384, 16384 } },
+			{ 4, 0, false, 8, 0, {} },
+			{ 8, 2, false, 8, 0, { 0, 0, 16384, 16384 } },
+			{ 4, 1, true, 8, 1, { 30000, 20000, 9000, 9000 } },
+			{ 16, 0, false, 2, 0, {} },
+			{ 4, 1, true, 2, 1, { 2000, 50000, 12000, 8000 } },
+		};
+
+		int ret = TestPass;
+		for (unsigned int frame = 0; frame < count; frame++) {
+			const Settings &s = schedule[(frame / 5) % schedule.size()];
+			FrameBuffer *raw = frames[frame % frames.size()]->buffer.get();
+			MappedFrameBuffer map(raw, MappedFrameBuffer::MapFlag::Read);
+
+			oldStats.setSampling(s.linePairStep, 1);
+			oldStats.setInterval(s.interval, s.afInterval, s.afEveryFrame);
+			oldStats.setAfRegion(s.afRegionMode, s.afRegion);
+			newStats.setSampling(s.linePairStep, 1);
+			newStats.setInterval(s.interval, s.afInterval, s.afEveryFrame);
+			newStats.setAfRegion(s.afRegionMode, s.afRegion);
+
+			/* As the DIP backend of the software ISP called it */
+			if (!oldStats.wantsFrame(frame) && !s.afEveryFrame)
+				oldStats.finishFrame(frame, 0);
+			else
+				oldStats.processFrame(frame, 0, map);
+
+			if (!newStats.wantsFrame(frame) && !s.afEveryFrame)
+				newStats.finishFrame(frame, out.get());
+			else
+				newStats.processFrame(frame, map, out.get());
+
+			oldView->update(shared, frame);
+			if (!view->parse(*out, frame)) {
+				std::cerr << "frame " << frame << ": buffer not parsed" << std::endl;
+				ret = TestFail;
+				break;
+			}
+
+			if (compare(oldView->copy, *view, frame) != TestPass) {
+				ret = TestFail;
+				break;
+			}
+			compared++;
+		}
+
+		munmap(const_cast<SwIspStats *>(shared), sizeof(SwIspStats));
+		return ret;
+	}
+
+	int run() override
+	{
+		unsigned int compared = 0;
+
+		std::vector<Frame> synthetic;
+		for (unsigned int i = 0; i < 3; i++)
+			synthetic.push_back(syntheticFrame(Size(1152, 864), i));
+
+		std::vector<Frame *> frames;
+		for (Frame &f : synthetic)
+			frames.push_back(&f);
+
+		if (runSequence(frames, Rectangle(0, 0, 1152, 864), 60, compared) != TestPass)
+			return TestFail;
+		/* Window of a centred crop, as with a smaller output */
+		if (runSequence(frames, Rectangle(64, 52, 1024, 768), 60, compared) != TestPass)
+			return TestFail;
+
+		const char *env = std::getenv("MTKISP50_RAW");
+		if (env) {
+			std::vector<Frame> real;
+			std::istringstream list(env);
+			std::string spec;
+			while (std::getline(list, spec, ',')) {
+				real.push_back(fileFrame(spec));
+				if (!real.back().buffer) {
+					std::cerr << "cannot read " << spec << std::endl;
+					return TestFail;
+				}
+			}
+
+			std::vector<Frame *> realFrames;
+			for (Frame &f : real)
+				realFrames.push_back(&f);
+
+			const Size &size = real[0].size;
+			if (runSequence(realFrames, Rectangle(size), 60, compared) != TestPass)
+				return TestFail;
+
+			Rectangle crop(((size.width - size.width / 2) / 2) & ~3,
+				       ((size.height - size.height / 2) / 2) & ~1,
+				       size.width / 2, size.height / 2);
+			if (runSequence(realFrames, crop, 60, compared) != TestPass)
+				return TestFail;
+		}
+
+		std::cout << compared << " frames equal" << std::endl;
+		return TestPass;
+	}
+
+private:
+	std::unique_ptr<CameraManager> cm_;
+};
+
+TEST_REGISTER(MtkIsp50RawStatsTest)
diff --git a/test/mtkisp50/streams.cpp b/test/mtkisp50/streams.cpp
new file mode 100644
index 0000000..a811b90
