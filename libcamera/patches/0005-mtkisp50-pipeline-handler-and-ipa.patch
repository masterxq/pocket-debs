+
+namespace libcamera {
+
+namespace ipa::mtkisp50::algorithms {
+
+class Awb : public Algorithm
+{
+public:
+	Awb() = default;
+	~Awb() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void prepare(IPAContext &context,
+		     const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     DipFrameParams *params) override;
+	void process(IPAContext &context,
+		     const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const Statistics *stats,
+		     ControlList &metadata) override;
+
+private:
+	unsigned int greyZoneMeans(const Statistics *stats, double black,
+				   RGB<double> &means) const;
+
+	/* Search along the colour temperature curve, nullptr for grey world */
+	std::unique_ptr<AwbAlgorithm> curve_;
+	double speed_ = 1.0;
+	double minMean_ = 2.0;
+	bool whitePointError_ = false;
+	bool zones_ = false;
+	double greyDistance_ = 0.02;
+	std::vector<std::pair<double, double>> whitePoints_;
+
+	/* Controls: automatic or fixed gains (ColourGains or ColourTemperature) */
+	bool enabled_ = true;
+	std::optional<RGB<float>> manualGains_;
+	std::optional<unsigned int> manualTemperature_;
+};
