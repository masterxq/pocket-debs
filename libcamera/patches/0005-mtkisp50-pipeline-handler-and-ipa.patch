+          hi: 6500
+      transversePos: 0.06
+      transverseNeg: 0.06
+      maxZoneLevel: 0.6
+      colourError: whitepoint
+      rendering:
+        band: 30
+        speed: 0.1
+        switch: 60
+  - Ccm:
+      ccms:
+        - ct: 2500
+          ccm: [ 1.5, -0.25, -0.25, -0.25, 1.5, -0.25, -0.25, -0.25, 1.5 ]
+        - ct: 6500
+          ccm: [ 1.5, -0.25, -0.25, -0.25, 1.5, -0.25, -0.25, -0.25, 1.5 ]
+)";
+
+const char *kModuleUnit = R"(%YAML 1.1
+---
+version: 1
+algorithms:
+  - Awb:
+      colourGains:
+        - ct: 2000
+          gains: [ 0.8, 3.6 ]
+        - ct: 2500
+          gains: [ 1.0, 3.0 ]
+        - ct: 4000
+          gains: [ 1.5, 2.0 ]
+        - ct: 6500
+          gains: [ 2.0, 1.5 ]
+      sensitivity: [ 1.1, 0.9 ]
+)";
+
+const ValueNode &algorithm(const ValueNode &tuning, const std::string &name)
+{
+	static const ValueNode empty;
+
+	for (const ValueNode &algo : tuning["algorithms"].asList()) {
+		if (algo.contains(name))
+			return algo[name];
+	}
+	return empty;
+}
+
+constexpr uint8_t kBlack = 16;
+constexpr uint32_t kSamples = 50000;
+
+class Sim
+{
+public:
+	Sim()
+		: ctx_(16), stats_(std::make_unique<Statistics>())
+	{
+	}
+
+	int init(const char *awbKey = "Awb")
+	{
+		UniqueFD fd = MemFd::create("mtkisp50-awb-tuning", 0);
+		if (!fd.isValid() || write(fd.get(), kTuning, strlen(kTuning)) < 0)
+			return -EIO;
+		File file("/proc/self/fd/" + std::to_string(fd.get()));
+		if (!file.open(File::OpenModeFlag::ReadOnly))
+			return -EIO;
+		tuning_ = YamlParser::parse(file);
+		if (!tuning_)
+			return -EINVAL;
+
+		return init((*tuning_)["Ccm"], (*tuning_)[awbKey]);
+	}
+
+	int init(const ValueNode &ccm, const ValueNode &awb)
+	{
+		int ret = ccm_.init(ctx_, ccm);
+		if (ret)
+			return ret;
+		return awb_.init(ctx_, awb);
+	}
+
+	int configure()
+	{
+		ctx_.configuration = {};
+		ctx_.activeState = {};
+		ctx_.activeState.blc.level = kBlack;
+		ctx_.configuration.agc.lineDuration = 10.0us;
+		/* A dim scene: 66 ms at a gain of 32, light value about 0 */
+		ctx_.activeState.agc.exposure = 6600;
+		ctx_.activeState.agc.again = 16.0;
+		ctx_.activeState.agc.digitalGain = 2.0;
+		ctx_.activeState.agc.valid = true;
+		IPAConfigInfo config{};
+		return awb_.configure(ctx_, config);
+	}
+
+	/* A frame with the channel means above the black level (8-bit scale) */
+	void frame(const RGB<double> &means, int32_t exposure = 6600, double gain = 16.0)
+	{
+		IPAFrameContext fc{};
+		DipFrameParams params{};
+		awb_.prepare(ctx_, frame_, fc, &params);
+		fc.sensor.exposure = exposure;
+		fc.sensor.gain = gain;
+
+		Statistics &s = *stats_;
+		s.valid = true;
+		s.yHistogram.fill(0);
+		s.yHistogram[10] = kSamples;
+		for (unsigned int c = 0; c < 3; c++)
+			s.sum_[c] = static_cast<uint64_t>(std::llround((kBlack + means[c]) * kSamples));
+		for (unsigned int i = 0; i < Statistics::kZones * Statistics::kZones; i++) {
+			s.zoneCount[i] = 0;
+		}
+
+		ControlList metadata(controls::controls);
+		awb_.process(ctx_, frame_, fc, stats_.get(), metadata);
+		frame_++;
+	}
+
+	void queue(const ControlList &controls)
+	{
+		IPAFrameContext fc{};
+		awb_.queueRequest(ctx_, frame_, fc, controls);
+	}
+
+	Matrix<float, 3, 3> matrix()
+	{
+		IPAFrameContext fc{};
+		DipFrameParams params{};
+		ctx_.activeState.combinedMatrix = Matrix<float, 3, 3>::identity();
+		ccm_.prepare(ctx_, frame_, fc, &params);
+		return ctx_.activeState.combinedMatrix;
+	}
+
+	IPAContext &ctx() { return ctx_; }
+
+private:
+	IPAContext ctx_;
+	std::unique_ptr<ValueNode> tuning_;
+	algorithms::Awb awb_;
+	algorithms::Ccm ccm_;
+	std::unique_ptr<Statistics> stats_;
+	uint32_t frame_ = 0;
+};
