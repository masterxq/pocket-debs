diff --git a/src/ipa/mtkisp50/algorithms/dip_tuning.cpp b/src/ipa/mtkisp50/algorithms/dip_tuning.cpp
new file mode 100644
index 0000000..1b48ba6
--- /dev/null
+++ b/src/ipa/mtkisp50/algorithms/dip_tuning.cpp
@@ -0,0 +1,149 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Tuning of the DIP blocks that the algorithms do not compute per frame
+ *
+ * Invalid tuning data of these blocks is reported and left out, the camera
+ * runs without the block as with a tuning file that does not have it.
+ */
+
+#include "dip_tuning.h"
+
+#include <array>
+#include <optional>
+#include <vector>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/value_node.h"
+
+namespace libcamera {
+
+namespace ipa::mtkisp50::algorithms {
+
+LOG_DEFINE_CATEGORY(IPAMtkIsp50DipTuning)
+
+namespace {
+
+std::optional<std::vector<float>> floatList(const ValueNode &node)
+{
+	if (!node.isList())
+		return std::nullopt;
+
+	std::vector<float> values;
+	for (const ValueNode &p : node.asList()) {
+		std::optional<float> v = p.get<float>();
+		if (!v)
+			return std::nullopt;
+		values.push_back(*v);
+	}
+
+	return values;
+}
+
+} /* namespace */
+
+/*
+ * ToneCurve: points, a list of x, y pairs in 0..1 (rising x); shadowLift,
+ * optional, 0..16. Without the algorithm the gamma of the Adjust algorithm
+ * makes the tone curve.
+ */
+int ToneCurveAlgo::init(IPAContext &context, const ValueNode &tuningData)
+{
+	const ValueNode &points = tuningData["points"];
+	if (points) {
+		std::optional<std::vector<float>> xy = floatList(points);
+		std::optional<ToneCurve> curve;
+		if (xy)
+			curve = ToneCurve::fromPoints(*xy);
+		if (!curve) {
+			LOG(IPAMtkIsp50DipTuning, Error)
+				<< "Invalid ToneCurve points, tone curve from the gamma";
+			return 0;
+		}
+
+		LOG(IPAMtkIsp50DipTuning, Info) << "Tone curve: " << curve->size() << " points";
+		context.dip.toneCurve = std::move(curve);
+	}
+
+	if (tuningData.contains("shadowLift")) {
+		std::optional<float> lift = tuningData["shadowLift"].get<float>();
+		if (!lift || *lift < 0.0f || *lift > 16.0f) {
+			LOG(IPAMtkIsp50DipTuning, Error) << "Invalid ToneCurve shadowLift, ignored";
+			return 0;
+		}
+
+		LOG(IPAMtkIsp50DipTuning, Info) << "Shadow lift " << *lift;
+		context.dip.shadowLift = *lift;
+	}
+
+	return 0;
+}
+
+/*
+ * LensShadingCorrection: enable (default true), strength (default 1.0), and
+ * the gains r, gr, gb, b on the corners of the grid of the DIP (17 x 17 per
+ * channel, rows from the top).
+ */
+int LensShadingCorrection::init(IPAContext &context, const ValueNode &tuningData)
+{
+	if (!tuningData["enable"].get<bool>(true))
+		return 0;
+
+	static constexpr const char *names[] = { "r", "gr", "gb", "b" };
+	std::array<std::vector<float>, 4> grids;
+
+	for (unsigned int c = 0; c < 4; c++) {
+		std::optional<std::vector<float>> grid = floatList(tuningData[names[c]]);
+		if (!grid) {
+			LOG(IPAMtkIsp50DipTuning, Error)
+				<< "LensShadingCorrection: " << names[c]
+				<< " missing, no lens shading correction";
+			return 0;
+		}
+		grids[c] = std::move(*grid);
+	}
+
+	const float strength = tuningData["strength"].get<float>(1.0f);
+	std::optional<LensShading> gains = LensShading::fromGrids(grids, strength);
+	if (!gains) {
+		LOG(IPAMtkIsp50DipTuning, Error)
+			<< "Invalid LensShadingCorrection grids, no lens shading correction";
+		return 0;
+	}
+
+	LOG(IPAMtkIsp50DipTuning, Info) << "Lens shading, strength " << strength;
+	context.dip.lensShading = std::move(gains);
+
+	return 0;
+}
+
+/*
+ * NoiseReduction: isoPerGain, hysteresis and points, each point with an iso
+ * and the blocks ee, ycnr, demosaic and optionally nbc2 as dictionaries of
+ * the fields of their structs in the DIP interface.
+ */
+int NoiseReduction::init(IPAContext &context, const ValueNode &tuningData)
+{
+	std::optional<QualityTable> quality = QualityTable::fromTuning(tuningData);
+	if (!quality) {
+		LOG(IPAMtkIsp50DipTuning, Error)
+			<< "Invalid NoiseReduction tuning, quality blocks not sent";
+		return 0;
+	}
+
+	LOG(IPAMtkIsp50DipTuning, Info)
+		<< "Quality blocks: " << quality->size() << " points, ISO = "
+		<< quality->isoPerGain() << " x gain"
+		<< (quality->usesNbc2() ? ", with NBC2" : "");
+	context.dip.quality = std::move(quality);
+
+	return 0;
+}
+
+REGISTER_IPA_ALGORITHM(ToneCurveAlgo, "ToneCurve")
+REGISTER_IPA_ALGORITHM(LensShadingCorrection, "LensShadingCorrection")
+REGISTER_IPA_ALGORITHM(NoiseReduction, "NoiseReduction")
+
+} /* namespace ipa::mtkisp50::algorithms */
+
+} /* namespace libcamera */
