diff --git a/src/ipa/mtkisp50/algorithms/ccm.cpp b/src/ipa/mtkisp50/algorithms/ccm.cpp
new file mode 100644
index 0000000..5addc73
--- /dev/null
+++ b/src/ipa/mtkisp50/algorithms/ccm.cpp
@@ -0,0 +1,138 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2024, Ideas On Board
+ * Copyright (C) 2024-2026, Red Hat Inc.
+ *
+ * Color correction matrix
+ */
+
+#include "ccm.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+#include <libcamera/base/utils.h>
+
+#include <libcamera/control_ids.h>
+
+#include "libcamera/internal/matrix.h"
+
+namespace {
+
+constexpr unsigned int kTemperatureThreshold = 100;
+
+}
+
+namespace libcamera {
+
+namespace ipa::mtkisp50::algorithms {
+
+LOG_DEFINE_CATEGORY(IPAMtkIsp50Ccm)
+
+/*
+ * Tuning: "ccms", matrices over the colour temperature; optionally
+ * "strength", the share of the matrix over the sensitivity of the frame:
+ * "iso" rising, "value" 0.0 (identity) to 1.0 (the matrix), linear in the
+ * logarithm of the ISO and held beyond the ends, ISO = "isoPerGain" (default
+ * 100) x analogue x digital gain. At high gain a weaker matrix amplifies the
+ * noise and errors of the colour estimate less. The neutral colour stays (the
+ * rows of the matrices sum to one).
+ *
+ * After the matrix the output colour of a neutral surface (Awb preference,
+ * activeState.awb.tint) is applied.
+ */
+int Ccm::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	int ret = ccm_.readYaml(tuningData["ccms"], "ct", "ccm");
+	if (ret < 0) {
+		LOG(IPAMtkIsp50Ccm, Error)
+			<< "Failed to parse 'ccm' parameter from tuning file.";
+		return ret;
+	}
+
+	if (tuningData.contains("strength")) {
+		const ValueNode &st = tuningData["strength"];
+		auto iso = st["iso"].get<std::vector<double>>();
+		auto value = st["value"].get<std::vector<double>>();
+		isoPerGain_ = st["isoPerGain"].get<double>(100.0);
+		bool ok = iso && value && !iso->empty() && iso->size() == value->size() && isoPerGain_ > 0.0;
+		for (unsigned int i = 0; ok && i < iso->size(); i++) {
+			ok = (*iso)[i] > 0.0 && (i == 0 || (*iso)[i] > (*iso)[i - 1]) &&
+			     (*value)[i] >= 0.0 && (*value)[i] <= 1.0;
+		}
+		if (!ok) {
+			LOG(IPAMtkIsp50Ccm, Error) << "Invalid Ccm strength";
+			return -EINVAL;
+		}
+		strengthIso_ = *iso;
+		strengthValue_ = *value;
+	}
+
+	context.ccmEnabled = true;
+
+	return 0;
+}
+
+void Ccm::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		  IPAFrameContext &frameContext, [[maybe_unused]] DipFrameParams *params)
+{
+	const unsigned int ct = context.activeState.awb.temperatureK;
+
+	/* Change CCM only on bigger temperature changes. */
+	if (!currentCcm_ ||
+	    utils::abs_diff(ct, lastCt_) >= kTemperatureThreshold) {
+		currentCcm_ = ccm_.getInterpolated(ct);
+		lastCt_ = ct;
+	}
+
+	Matrix<float, 3, 3> m = currentCcm_.value();
+	const float s = strength(context);
+	if (s < 1.0f) {
+		const Matrix<float, 3, 3> identity = Matrix<float, 3, 3>::identity();
+		m = m * s + identity * (1.0f - s);
+	}
+
+	const RGB<float> &tint = context.activeState.awb.tint;
+	for (unsigned int c = 0; c < 3; c++)
+		m[0][c] *= tint.r();
+	for (unsigned int c = 0; c < 3; c++)
+		m[2][c] *= tint.b();
+
+	context.activeState.combinedMatrix = m * context.activeState.combinedMatrix;
+	frameContext.ccm = m;
+}
+
+float Ccm::strength(const IPAContext &context) const
+{
+	if (strengthIso_.empty())
+		return 1.0f;
+
+	const auto &agc = context.activeState.agc;
+	const double iso = isoPerGain_ * std::max(agc.again * agc.digitalGain, 1e-3);
+	if (iso <= strengthIso_.front())
+		return strengthValue_.front();
+	if (iso >= strengthIso_.back())
+		return strengthValue_.back();
+
+	unsigned int i = 0;
+	while (iso > strengthIso_[i + 1])
+		i++;
+	const double w = std::log(iso / strengthIso_[i]) / std::log(strengthIso_[i + 1] / strengthIso_[i]);
+	return static_cast<float>(strengthValue_[i] + w * (strengthValue_[i + 1] - strengthValue_[i]));
+}
+
+void Ccm::process([[maybe_unused]] IPAContext &context,
+		  [[maybe_unused]] const uint32_t frame,
+		  IPAFrameContext &frameContext,
+		  [[maybe_unused]] const Statistics *stats,
+		  ControlList &metadata)
+{
+	metadata.set(controls::ColourCorrectionMatrix, frameContext.ccm.data());
+}
+
+REGISTER_IPA_ALGORITHM(Ccm, "Ccm")
+
+} /* namespace ipa::mtkisp50::algorithms */
+
+} /* namespace libcamera */
