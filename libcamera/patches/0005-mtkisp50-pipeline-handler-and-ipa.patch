+
+	SWSTATS_START_LINE_STATS(uint16_t)
+
+	/* x += 5 sample every other 2x2 block */
+	for (unsigned int x = 0; x < widthInBytes; x += 5 * blockStep_) {
+		/* GBRG */
+		g = mtispPixel0(src0 + x);
+		b = mtispPixel1(src0 + x);
+		r = mtispPixel0(src1 + x);
+		g2 = mtispPixel1(src1 + x);
+		g = (g + g2) / 2;
+
+		/* divide Y by 4 for 10 -> 8 bpp value */
+		SWSTATS_ACCUMULATE_LINE_STATS(4)
+	}
+
+	SWSTATS_FINISH_LINE_STATS()
+}
