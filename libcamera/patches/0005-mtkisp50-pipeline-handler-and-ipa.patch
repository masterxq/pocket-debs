+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Calibration of the single camera module over the tuning
+ */
+
+#pragma once
+
+#include <string>
+#include <vector>
+
+#include "libcamera/internal/value_node.h"
+
+namespace libcamera {
+
+namespace ipa::mtkisp50 {
+
+/*
+ * The tuning file holds the values of a reference module. A file per camera
+ * module next to it (written on the device, outside the tuning directories)
+ * holds the values calibrated for the single module:
+ *
+ *   version: 1
+ *   algorithms:
+ *     - Awb:
+ *         colourGains: ...
+ *
+ * Each key of an algorithm there replaces the key of the same name at the top
+ * level of that algorithm in the tuning; other keys and algorithms stay. An
+ * algorithm the tuning does not have is not added.
+ */
+struct UnitTuning {
+	enum class Status {
+		Missing,
+		Invalid,
+		Applied,
+	};
+
+	Status status = Status::Missing;
+	/* "Algorithm.key" for every key taken from the file */
+	std::vector<std::string> keys;
+	/* Algorithms of the file the tuning does not have */
+	std::vector<std::string> unknown;
+
+	static std::string file(const std::string &sensorModel);
+	static UnitTuning apply(ValueNode &tuning, const std::string &path);
+};
+
+} /* namespace ipa::mtkisp50 */
+
+} /* namespace libcamera */
diff --git a/src/libcamera/pipeline/mtkisp50/align/frame_aligner.cpp b/src/libcamera/pipeline/mtkisp50/align/frame_aligner.cpp
new file mode 100644
index 0000000..7a5d075
--- /dev/null
+++ b/src/libcamera/pipeline/mtkisp50/align/frame_aligner.cpp
@@ -0,0 +1,1981 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Alignment of a burst of NV12 frames for multi-frame noise reduction
+ *
+ * Steps of estimate():
+ *  1. Reduce the luma of every frame by the downscale factor (box filter,
+ *     kept as 12 bit sums), build a pyramid of three more halvings, and
+ *     measure the sharpness of every frame on a 2x2 binned subset of rows.
+ *  2. Base frame: the sharpest, among nearly equal ones the most central.
+ *  3. Per other frame: exhaustive search of a global shift on the coarsest
+ *     level, then tile matching (SAD) from coarse to fine; each tile starts
+ *     from the best of the global shift and the four nearest parent tiles.
+ *     On the finest level the integer result is refined by Lucas-Kanade
+ *     (translation, inverse compositional), which also gives the structure
+ *     tensor of the block and the residual (noise) level.
+ *  4. Noise model: residual against brightness, median per brightness bin.
+ *  5. Global model by iteratively reweighted least squares with Tukey
+ *     weights; every block weighs with its structure tensor over its noise
+ *     (its information matrix), so edges only count across the edge.
+ *  6. Local correction: robust, information weighted smoothing of what the
+ *     global model leaves, soft thresholded at twice its standard error and
+ *     clamped. Blocks that deviate from it are moving: not followed.
+ *  7. Match error of every block at the final motion against the noise
+ *     model gives its reliability; quality figures per frame.
+ *  8. Displacement at control points every block (frame pixels).
+ * warp() interpolates the control points bilinearly; every row is cut in
+ * segments over which the displacement changes by at most 1/16 pixel, each
+ * segment is resampled with fixed bilinear weights in 1/16 pixel steps
+ * (contiguous loads, vectorised by the compiler).
+ *
+ * Literature: block matching pyramid after Hasinoff et al., "Burst
+ * photography for high dynamic range and low-light imaging on mobile
+ * cameras" (SIGGRAPH Asia 2016); sub-pixel step after Lucas and Kanade
+ * (1981) in the inverse compositional form of Baker and Matthews (2004);
+ * robust fit after Holland and Welsch (1977, IRLS) with Tukey's biweight.
+ */
+
+#include "frame_aligner.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <condition_variable>
+#include <functional>
+#include <limits>
+#include <mutex>
+#include <stdlib.h>
+#include <string.h>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace libcamera::mtkisp50 {
+
+namespace {
+
+/* -------------------------------------------------------------------------
+ * Thread pool: items are taken one by one from a shared counter, so slow
+ * and fast cores share the work dynamically. The caller works too.
+ */
+class ThreadPool
+{
+public:
+	explicit ThreadPool(unsigned int n)
+	{
+		for (unsigned int i = 1; i < n; i++)
+			threads_.emplace_back([this] { worker(); });
+	}
+
+	~ThreadPool()
+	{
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			stop_ = true;
+		}
+		wake_.notify_all();
+		for (std::thread &t : threads_)
+			t.join();
+	}
+
+	unsigned int size() const { return threads_.size() + 1; }
+
+	void run(size_t count, const std::function<void(size_t)> &fn)
+	{
+		if (count == 0)
+			return;
+		if (threads_.empty() || count == 1) {
+			for (size_t i = 0; i < count; i++)
+				fn(i);
+			return;
+		}
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			fn_ = &fn;
+			count_ = count;
+			next_.store(0);
+			busy_ = threads_.size();
+			generation_++;
+		}
+		wake_.notify_all();
+		work(fn, count);
+		std::unique_lock<std::mutex> lock(mutex_);
+		done_.wait(lock, [this] { return busy_ == 0; });
+		fn_ = nullptr;
+	}
+
+private:
+	void work(const std::function<void(size_t)> &fn, size_t count)
+	{
+		for (;;) {
+			size_t i = next_.fetch_add(1);
+			if (i >= count)
+				break;
+			fn(i);
+		}
+	}
+
+	void worker()
+	{
+		uint64_t seen = 0;
+		for (;;) {
+			const std::function<void(size_t)> *fn;
+			size_t count;
+			{
+				std::unique_lock<std::mutex> lock(mutex_);
+				wake_.wait(lock, [&] { return stop_ || generation_ != seen; });
+				if (stop_)
+					return;
+				seen = generation_;
+				fn = fn_;
+				count = count_;
+			}
+			work(*fn, count);
+			{
+				std::lock_guard<std::mutex> lock(mutex_);
+				if (--busy_ == 0)
+					done_.notify_one();
+			}
+		}
+	}
+
+	std::vector<std::thread> threads_;
+	std::mutex mutex_;
+	std::condition_variable wake_;
+	std::condition_variable done_;
+	const std::function<void(size_t)> *fn_ = nullptr;
+	size_t count_ = 0;
+	std::atomic<size_t> next_{ 0 };
+	unsigned int busy_ = 0;
+	uint64_t generation_ = 0;
+	bool stop_ = false;
+};
+
+double nowMs()
+{
+	using namespace std::chrono;
+	return duration<double, std::milli>(steady_clock::now().time_since_epoch()).count();
+}
+
+/* Reduced luma, value = mean of the covered pixels x 16 (0..4080) */
+struct Image16 {
+	int w = 0;
+	int h = 0;
+	std::vector<uint16_t> px;
+
+	void resize(int width, int height)
+	{
+		w = width;
+		h = height;
+		px.assign(size_t(w) * h, 0);
+	}
+	uint16_t *row(int y) { return px.data() + size_t(y) * w; }
+	const uint16_t *row(int y) const { return px.data() + size_t(y) * w; }
+};
+
+struct Vec2 {
+	float x;
+	float y;
+};
+
+struct Vec2i {
+	int x;
+	int y;
+};
+
+/* Tiles of size tile, centred in the image; tile i covers
+ * [o + i * tile, o + (i + 1) * tile) */
+struct TileGrid {
+	int tile = 0;
+	int cols = 0;
+	int rows = 0;
+	int ox = 0;
+	int oy = 0;
+
+	void setup(int w, int h, int t)
+	{
+		tile = t;
+		cols = std::max(1, w / t);
+		rows = std::max(1, h / t);
+		ox = std::max(0, (w - cols * t) / 2);
+		oy = std::max(0, (h - rows * t) / 2);
+	}
+	/* Centres in corner coordinates (pixel i spans [i, i + 1)) */
+	float cx(int i) const { return ox + i * tile + tile * 0.5f; }
+	float cy(int j) const { return oy + j * tile + tile * 0.5f; }
+	int size() const { return cols * rows; }
+};
+
+/* Result of the refinement of one block on the finest level */
+struct Block {
+	Vec2 v;		/* displacement, level pixels */
+	float gxx, gxy, gyy;	/* structure tensor (sum over the window) */
+	float mse;	/* mean squared residual at v, later at the final motion */
+	float mseFit;	/* mean squared residual at v */
+	float mean;	/* mean of the base window */
+	float area;	/* valid fraction of the window */
+	float count;	/* pixels of the window */
+	float offset;	/* mean difference reference - base at v */
+	float off;	/* smooth brightness difference of the frames here */
+	float clip;	/* fraction of clipped (white) pixels */
+	bool ok;
+	/* Set from the noise model: tensor of the signal (the part of the
+	 * gradients that is not noise), variance of v along its weakest
+	 * direction, share of signal in the gradients */
+	float sxx, sxy, syy;
+	float var;
+	float share;
+	bool fit;	/* signal above noise in at least one direction */
+};
+
+struct Frame {
+	Nv12Frame img;
+	std::vector<Image16> pyr;
+	double sharp = 0;
+	std::vector<std::vector<Vec2i>> fields;
+	Vec2i global{ 0, 0 };
+	std::vector<Block> blocks;
+	std::vector<Vec2> local;
+	std::vector<uint8_t> rel;
+	std::vector<float> noiseBins;
+	/* Measured over predicted variance of the block displacements */
+	double kappa = 1;
+	/* Global model on the finest level (corner coordinates) */
+	double h[9];
+	/* Displacement at the control points, frame pixels */
+	std::vector<Vec2> nodes;
+	FrameResult result;
+};
+
+constexpr int kNoiseBins = 16;
+/* Reduced value of a clipped area (all pixels >= 254) */
+constexpr uint16_t kClip = 254 * 16;
+
+constexpr float kInf = std::numeric_limits<float>::infinity();
+
+/* ---- Reduction ---------------------------------------------------------- */
+
+/* Rows [r0, r1) of the reduced image from the full size luma */
+void reduceRows(const uint8_t *src, unsigned int stride, int factor, Image16 &dst,
+		int r0, int r1, std::vector<uint16_t> &tmp)
+{
+	const int w = dst.w;
+	const int n = w * factor;
+	tmp.resize(n);
+	uint16_t *t = tmp.data();
+	for (int y = r0; y < r1; y++) {
+		const uint8_t *s = src + size_t(y) * factor * stride;
+		uint16_t *d = dst.row(y);
+		if (factor == 4) {
+			const uint8_t *s1 = s + stride, *s2 = s1 + stride, *s3 = s2 + stride;
+			for (int x = 0; x < n; x++)
+				t[x] = s[x] + s1[x] + s2[x] + s3[x];
+			for (int x = 0; x < w; x++)
+				d[x] = t[4 * x] + t[4 * x + 1] + t[4 * x + 2] + t[4 * x + 3];
+		} else {
+			const uint8_t *s1 = s + stride;
+			for (int x = 0; x < n; x++)
+				t[x] = s[x] + s1[x];
+			for (int x = 0; x < w; x++)
+				d[x] = (t[2 * x] + t[2 * x + 1]) * 4;
+		}
+	}
+}
+
+/* Binomial 1-2-1 in both directions, in place (edges repeated). Takes the
+ * aliased top octave out of the box reduction; with it the bilinear
+ * sampling of the sub-pixel step has much less bias towards whole pixels */
+void smooth121(Image16 &img, std::vector<uint16_t> &tmp)
+{
+	const int w = img.w, h = img.h;
+	tmp.resize(size_t(w) * 3);
+	uint16_t *rows[3] = { tmp.data(), tmp.data() + w, tmp.data() + 2 * w };
+	auto horiz = [&](int y, uint16_t *d) {
+		const uint16_t *s = img.row(y);
+		d[0] = (3 * s[0] + s[1] + 2) >> 2;
+		for (int x = 1; x < w - 1; x++)
+			d[x] = (s[x - 1] + 2 * s[x] + s[x + 1] + 2) >> 2;
+		d[w - 1] = (s[w - 2] + 3 * s[w - 1] + 2) >> 2;
+	};
+	/* rows[0] = y - 1, rows[1] = y, rows[2] = y + 1, horizontally smoothed */
+	horiz(0, rows[1]);
+	memcpy(rows[0], rows[1], w * sizeof(uint16_t));
+	for (int y = 0; y < h; y++) {
+		horiz(std::min(y + 1, h - 1), rows[2]);
+		uint16_t *d = img.row(y);
+		const uint16_t *a = rows[0], *b = rows[1], *c = rows[2];
+		for (int x = 0; x < w; x++)
+			d[x] = (a[x] + 2 * b[x] + c[x] + 2) >> 2;
+		std::swap(rows[0], rows[1]);
+		std::swap(rows[1], rows[2]);
+	}
+}
+
+void halve(const Image16 &src, Image16 &dst)
+{
+	dst.resize(src.w / 2, src.h / 2);
+	for (int y = 0; y < dst.h; y++) {
+		const uint16_t *a = src.row(2 * y), *b = src.row(2 * y + 1);
+		uint16_t *d = dst.row(y);
+		for (int x = 0; x < dst.w; x++)
+			d[x] = (a[2 * x] + a[2 * x + 1] + b[2 * x] + b[2 * x + 1] + 2) >> 2;
+	}
+}
+
+/*
+ * Sharpness: squared differences of 2x2 binned luma, horizontal and
+ * vertical, on rows [r0, r1) of a sparse set of row pairs.
+ */
+double sharpRows(const uint8_t *y, unsigned int stride, int width, int r0, int r1,
+		 std::vector<uint16_t> &tmp)
+{
+	const int n = width / 2;
+	tmp.resize(2 * n);
+	uint16_t *a = tmp.data(), *b = a + n;
+	double sum = 0;
+	for (int r = r0; r < r1; r++) {
+		const uint8_t *s0 = y + size_t(r) * stride;
+		const uint8_t *s1 = s0 + stride, *s2 = s1 + stride, *s3 = s2 + stride;
+		for (int x = 0; x < n; x++) {
+			a[x] = s0[2 * x] + s0[2 * x + 1] + s1[2 * x] + s1[2 * x + 1];
+			b[x] = s2[2 * x] + s2[2 * x + 1] + s3[2 * x] + s3[2 * x + 1];
+		}
+		uint64_t acc = 0;
+		for (int x = 0; x + 1 < n; x++) {
+			int dh = int(a[x + 1]) - int(a[x]);
+			int dv = int(b[x]) - int(a[x]);
+			acc += uint32_t(dh * dh + dv * dv);
+		}
+		sum += double(acc);
+	}
+	return sum;
+}
+
+/* ---- Matching ----------------------------------------------------------- */
+
+inline __attribute__((always_inline)) uint32_t sadRow(const uint16_t *a, const uint16_t *b, int n)
+{
+	uint32_t s = 0;
+	for (int i = 0; i < n; i++) {
+		uint16_t d = a[i] > b[i] ? a[i] - b[i] : b[i] - a[i];
+		s += d;
+	}
+	return s;
+}
+
+/* Mean absolute difference of the base window [x0, x1) x [y0, y1) against
+ * the reference displaced by (dx, dy), over the part inside both images */
+float sad(const Image16 &b, const Image16 &r, int x0, int y0, int x1, int y1, int dx, int dy)
+{
+	const int ax0 = std::max(x0, -dx), ax1 = std::min(x1, r.w - dx);
+	const int ay0 = std::max(y0, -dy), ay1 = std::min(y1, r.h - dy);
+	if (ax1 <= ax0 || ay1 <= ay0)
+		return kInf;
+	const int area = (ax1 - ax0) * (ay1 - ay0);
+	if (2 * area < (x1 - x0) * (y1 - y0))
+		return kInf;
+	uint32_t s = 0;
+	const int n = ax1 - ax0;
+	/* the usual window widths with a constant trip count (unrolled) */
+	if (n == 24) {
+		for (int y = ay0; y < ay1; y++)
+			s += sadRow(b.row(y) + ax0, r.row(y + dy) + ax0 + dx, 24);
+	} else if (n == 12) {
+		for (int y = ay0; y < ay1; y++)
+			s += sadRow(b.row(y) + ax0, r.row(y + dy) + ax0 + dx, 12);
+	} else {
+		for (int y = ay0; y < ay1; y++)
+			s += sadRow(b.row(y) + ax0, r.row(y + dy) + ax0 + dx, n);
+	}
+	return float(s) / area;
+}
+
+/* Best integer displacement in c +- radius */
+Vec2i searchAround(const Image16 &b, const Image16 &r, int x0, int y0, int x1, int y1,
+		   Vec2i c, int radius, float *cost)
+{
+	Vec2i best = c;
+	float bestCost = kInf;
+	for (int dy = -radius; dy <= radius; dy++) {
+		for (int dx = -radius; dx <= radius; dx++) {
+			float s = sad(b, r, x0, y0, x1, y1, c.x + dx, c.y + dy);
+			/* prefer the centre on ties */
+			if (s < bestCost || (s == bestCost && std::abs(dx) + std::abs(dy) <
+						std::abs(best.x - c.x) + std::abs(best.y - c.y))) {
+				bestCost = s;
+				best = { c.x + dx, c.y + dy };
+			}
+		}
+	}
+	if (cost)
+		*cost = bestCost;
+	return best;
+}
+
+/* Gradients of the base on the finest level: differences of the two
+ * neighbours (twice the central derivative), 0 on the border */
+struct Gradients {
+	int w = 0;
+	int h = 0;
+	std::vector<int16_t> gx;
+	std::vector<int16_t> gy;
+
+	void rows(const Image16 &b, int r0, int r1)
+	{
+		for (int y = r0; y < r1; y++) {
+			int16_t *dx = gx.data() + size_t(y) * w, *dy = gy.data() + size_t(y) * w;
+			if (y == 0 || y == h - 1) {
+				std::fill(dx, dx + w, 0);
+				std::fill(dy, dy + w, 0);
+				continue;
+			}
+			const uint16_t *u = b.row(y - 1), *c = b.row(y), *d = b.row(y + 1);
+			dx[0] = dx[w - 1] = 0;
+			dy[0] = dy[w - 1] = 0;
+			for (int x = 1; x < w - 1; x++) {
+				dx[x] = int16_t(int(c[x + 1]) - int(c[x - 1]));
+				dy[x] = int16_t(int(d[x]) - int(u[x]));
+			}
+		}
+	}
+};
+
+/*
+ * Lucas-Kanade refinement of a translation over the window [x0, x1) x
+ * [y0, y1) of the finest level, starting at v (inverse compositional: the
+ * gradients and the tensor are those of the base), the reference taken as
+ * off brighter than the base. Also fills the structure tensor, the residual
+ * (without its mean: noise only) and the mean. Returns false if it did not
+ * converge near the start.
+ */
+bool refine(const Image16 &b, const Gradients &gr, const Image16 &r, int x0, int y0, int x1,
+	    int y1, Vec2 &v, Block &out, int iterations, float off = 0)
+{
+	x0 = std::max(x0, 1);
+	y0 = std::max(y0, 1);
+	x1 = std::min(x1, b.w - 1);
+	y1 = std::min(y1, b.h - 1);
+	const float full = float(std::max(1, (x1 - x0) * (y1 - y0)));
+	const Vec2 start = v;
+	bool ok = true;
+	/* tensor of the window part last used */
+	int tx0 = 0, tx1 = 0, ty0 = 0, ty1 = 0;
+	float gxx = 0, gxy = 0, gyy = 0;
+
+	for (int it = 0; it <= iterations; it++) {
+		const int ix = int(std::floor(v.x)), iy = int(std::floor(v.y));
+		const float fx = v.x - ix, fy = v.y - iy;
+		const int ax0 = std::max(x0, -ix), ax1 = std::min(x1, r.w - 1 - ix);
+		const int ay0 = std::max(y0, -iy), ay1 = std::min(y1, r.h - 1 - iy);
+		if (ax1 <= ax0 || ay1 <= ay0 || 2 * (ax1 - ax0) * (ay1 - ay0) < full) {
+			ok = false;
+			break;
+		}
+		const float n = float((ax1 - ax0) * (ay1 - ay0));
+		if (ax0 != tx0 || ax1 != tx1 || ay0 != ty0 || ay1 != ty1) {
+			/* statistics of the base part (once, or after a border change) */
+			float sxx = 0, sxy = 0, syy = 0, sb = 0;
+			int clipped = 0;
+			for (int y = ay0; y < ay1; y++) {
+				const int16_t *dx = gr.gx.data() + size_t(y) * gr.w;
+				const int16_t *dy = gr.gy.data() + size_t(y) * gr.w;
+				const uint16_t *bc = b.row(y);
+				for (int x = ax0; x < ax1; x++) {
+					const float gx = dx[x], gy = dy[x];
+					sxx += gx * gx;
+					sxy += gx * gy;
+					syy += gy * gy;
+					sb += bc[x];
+					clipped += bc[x] >= kClip;
+				}
+			}
+			gxx = 0.25f * sxx;
+			gxy = 0.25f * sxy;
+			gyy = 0.25f * syy;
+			out.clip = clipped / n;
+			out.mean = sb / n;
+			tx0 = ax0;
+			tx1 = ax1;
+			ty0 = ay0;
+			ty1 = ay1;
+		}
+		const float w00 = (1 - fx) * (1 - fy), w01 = fx * (1 - fy);
+		const float w10 = (1 - fx) * fy, w11 = fx * fy;
+		float bx = 0, by = 0, ee = 0, se = 0;
+		for (int y = ay0; y < ay1; y++) {
+			const int16_t *dx = gr.gx.data() + size_t(y) * gr.w;
+			const int16_t *dy = gr.gy.data() + size_t(y) * gr.w;
+			const uint16_t *bc = b.row(y);
+			const uint16_t *r0 = r.row(y + iy) + ix, *r1 = r.row(y + iy + 1) + ix;
+			for (int x = ax0; x < ax1; x++) {
+				const float rv = w00 * r0[x] + w01 * r0[x + 1] + w10 * r1[x] + w11 * r1[x + 1];
+				const float e = rv - float(bc[x]) - off;
+				bx += float(dx[x]) * e;
+				by += float(dy[x]) * e;
+				ee += e * e;
+				se += e;
+			}
+		}
+		const float me = se / n;
+		bx *= 0.5f;
+		by *= 0.5f;
+		out.offset = me + off;
+		out.gxx = gxx;
+		out.gxy = gxy;
+		out.gyy = gyy;
+		out.mse = std::max(0.0f, ee / n - me * me);
+		out.mseFit = out.mse;
+		out.area = n / full;
+		out.count = n;
+		if (it == iterations)
+			break;
+		/* Tikhonov term keeps flat blocks where they are */
+		const float reg = 1e-3f * (gxx + gyy) + 1.0f;
+		const float a = gxx + reg, c = gyy + reg;
+		const float det = a * c - gxy * gxy;
+		const float ddx = (c * bx - gxy * by) / det;
+		const float ddy = (a * by - gxy * bx) / det;
+		v.x -= ddx;
+		v.y -= ddy;
+		if (std::fabs(v.x - start.x) > 1.5f || std::fabs(v.y - start.y) > 1.5f) {
+			v = start;
+			ok = false;
+			iterations = it + 1;	/* one more pass for the statistics */
+			continue;
+		}
+		if (ddx * ddx + ddy * ddy < 2.5e-5f)
+			iterations = it + 1;
+	}
+	out.v = v;
+	out.ok = ok;
+	return ok;
+}
+
+/* Squared residual and valid fraction of a window at displacement v */
+void residualAt(const Image16 &b, const Image16 &r, int x0, int y0, int x1, int y1, Vec2 v,
+		float off, float *mse, float *area)
+{
+	x0 = std::max(x0, 0);
+	y0 = std::max(y0, 0);
+	x1 = std::min(x1, b.w);
+	y1 = std::min(y1, b.h);
+	const float full = float(std::max(1, (x1 - x0) * (y1 - y0)));
+	const int ix = int(std::floor(v.x)), iy = int(std::floor(v.y));
+	const float fx = v.x - ix, fy = v.y - iy;
+	const int ax0 = std::max(x0, -ix), ax1 = std::min(x1, r.w - 1 - ix);
+	const int ay0 = std::max(y0, -iy), ay1 = std::min(y1, r.h - 1 - iy);
+	if (ax1 <= ax0 || ay1 <= ay0) {
+		*mse = 0;
+		*area = 0;
+		return;
+	}
+	const float w00 = (1 - fx) * (1 - fy), w01 = fx * (1 - fy);
+	const float w10 = (1 - fx) * fy, w11 = fx * fy;
+	float ee = 0, se = 0;
+	for (int y = ay0; y < ay1; y++) {
+		const uint16_t *bc = b.row(y);
+		const uint16_t *r0 = r.row(y + iy) + ix, *r1 = r.row(y + iy + 1) + ix;
+		for (int x = ax0; x < ax1; x++) {
+			const float e = w00 * r0[x] + w01 * r0[x + 1] + w10 * r1[x] + w11 * r1[x + 1] - bc[x];
+			ee += e * e;
+			se += e;
+		}
+	}
+	const float n = float((ax1 - ax0) * (ay1 - ay0));
+	/* against the smooth brightness difference of the frames (flicker,
+	 * shading); a local one (a flat object moving) counts */
+	const float me = se / n;
+	*mse = ee / n - 2 * me * off + off * off;
+	*area = n / full;
+}
+
+/* ---- Global model ------------------------------------------------------- */
+
+int modelParams(Model m)
+{
+	switch (m) {
+	case Model::Translation:
+		return 2;
+	case Model::Similarity:
+		return 4;
+	case Model::Affine:
+		return 6;
+	default:
+		return 8;
+	}
+}
+
+/*
+ * Rows of the (linearised) model for a point (x, y) -> (tx, ty), the
+ * parameters being the deviation from identity, so that rx . p = bx and
+ * ry . p = by.
+ */
+void modelRows(Model m, double x, double y, double tx, double ty, double *rx, double *ry,
+	       double *bx, double *by)
+{
+	std::fill(rx, rx + 8, 0.0);
+	std::fill(ry, ry + 8, 0.0);
+	*bx = tx - x;
+	*by = ty - y;
+	switch (m) {
+	case Model::Translation:
+		rx[0] = 1;
+		ry[1] = 1;
+		break;
+	case Model::Similarity:
+		rx[0] = x; rx[1] = -y; rx[2] = 1;
+		ry[0] = y; ry[1] = x; ry[3] = 1;
+		break;
+	case Model::Affine:
+	case Model::Homography:
+		rx[0] = x; rx[1] = y; rx[2] = 1;
+		ry[3] = x; ry[4] = y; ry[5] = 1;
+		if (m == Model::Homography) {
+			rx[6] = -x * tx; rx[7] = -y * tx;
+			ry[6] = -x * ty; ry[7] = -y * ty;
+		}
+		break;
+	}
+}
+
+void modelMatrix(Model m, const double *p, double *h)
+{
+	double q[8] = {};
+	switch (m) {
+	case Model::Translation:
+		q[2] = p[0];
+		q[5] = p[1];
+		break;
+	case Model::Similarity:
+		q[0] = p[0]; q[1] = -p[1]; q[2] = p[2];
+		q[3] = p[1]; q[4] = p[0]; q[5] = p[3];
+		break;
+	case Model::Affine:
+		std::copy(p, p + 6, q);
+		break;
+	case Model::Homography:
+		std::copy(p, p + 8, q);
+		break;
+	}
+	h[0] = 1 + q[0]; h[1] = q[1]; h[2] = q[2];
+	h[3] = q[3]; h[4] = 1 + q[4]; h[5] = q[5];
+	h[6] = q[6]; h[7] = q[7]; h[8] = 1;
+}
+
+inline void applyH(const double *h, double x, double y, double *ox, double *oy)
+{
+	const double w = h[6] * x + h[7] * y + h[8];
+	*ox = (h[0] * x + h[1] * y + h[2]) / w;
+	*oy = (h[3] * x + h[4] * y + h[5]) / w;
+}
+
+/* Solve a symmetric positive system n x n in place (Cholesky); false if
+ * the smallest pivot is too small against the largest diagonal entry */
+bool solve(double *a, double *b, int n)
+{
+	double maxDiag = 0;
+	for (int i = 0; i < n; i++)
+		maxDiag = std::max(maxDiag, a[i * n + i]);
+	if (maxDiag <= 0)
+		return false;
+	for (int j = 0; j < n; j++) {
+		double d = a[j * n + j];
+		for (int k = 0; k < j; k++)
+			d -= a[j * n + k] * a[j * n + k];
+		if (d <= maxDiag * 1e-12)
+			return false;
+		d = std::sqrt(d);
+		a[j * n + j] = d;
+		for (int i = j + 1; i < n; i++) {
+			double s = a[i * n + j];
+			for (int k = 0; k < j; k++)
+				s -= a[i * n + k] * a[j * n + k];
+			a[i * n + j] = s / d;
+		}
+	}
+	for (int i = 0; i < n; i++) {
+		double s = b[i];
+		for (int k = 0; k < i; k++)
+			s -= a[i * n + k] * b[k];
+		b[i] = s / a[i * n + i];
+	}
+	for (int i = n - 1; i >= 0; i--) {
+		double s = b[i];
+		for (int k = i + 1; k < n; k++)
+			s -= a[k * n + i] * b[k];
+		b[i] = s / a[i * n + i];
+	}
+	return true;
+}
+
+double weightedMedian(std::vector<std::pair<double, double>> &v)
+{
+	if (v.empty())
+		return 0;
+	std::sort(v.begin(), v.end());
+	double total = 0;
+	for (const auto &p : v)
+		total += p.second;
+	double acc = 0;
+	for (const auto &p : v) {
+		acc += p.second;
+		if (acc >= total / 2)
+			return p.first;
+	}
+	return v.back().first;
+}
+
+inline double tukey(double r, double c)
+{
+	if (r >= c)
+		return 0;
+	const double u = 1 - (r / c) * (r / c);
+	return u * u;
+}
