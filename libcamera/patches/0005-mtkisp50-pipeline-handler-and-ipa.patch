diff --git a/src/ipa/mtkisp50/algorithms/af_search.cpp b/src/ipa/mtkisp50/algorithms/af_search.cpp
new file mode 100644
index 0000000..5c1d21c
--- /dev/null
+++ b/src/ipa/mtkisp50/algorithms/af_search.cpp
@@ -0,0 +1,270 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detect focus search
+ */
+
+#include "af_search.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace libcamera {
+
+namespace ipa::mtkisp50::algorithms {
+
+AfMeasurement afMeasure(const uint32_t *grid, unsigned int width,
+			unsigned int height, unsigned int cellSamples,
+			double blackLevel, double fraction)
+{
+	const unsigned int w = std::clamp<unsigned int>(width * fraction, 0, width);
+	const unsigned int h = std::clamp<unsigned int>(height * fraction, 0, height);
+
+	if (w < 3 || h < 3 || !cellSamples)
+		return { -1.0, 0.0 };
+
+	const unsigned int x0 = (width - w) / 2;
+	const unsigned int y0 = (height - h) / 2;
+	double sum = 0.0;
+	double diff = 0.0;
+
+	for (unsigned int y = y0; y < y0 + h; y++) {
+		const uint32_t *row = grid + y * width;
+
+		for (unsigned int x = x0; x < x0 + w; x++) {
+			const double v = row[x];
+
+			sum += v;
+			if (x + 1 < x0 + w) {
+				const double d = v - row[x + 1];
+				diff += d * d;
+			}
+			if (y + 1 < y0 + h) {
+				const double d = v - row[x + width];
+				diff += d * d;
+			}
+		}
+	}
+
+	const double pairs = 2.0 * w * h - w - h;
+	const double meanCell = sum / (w * h);
+	const double level = meanCell / cellSamples - blackLevel;
+
+	/* Below about 1/256 of the range there is nothing but noise. */
+	if (level < 1.0)
+		return { -1.0, level };
+
+	const double meanAboveBlack = level * cellSamples;
+
+	return { diff / pairs / (meanAboveBlack * meanAboveBlack), level };
+}
+
+/* A side sample counts as better or worse with this relative difference */
+static constexpr double kProbeMargin = 0.05;
+
+void AfSearch::start(const Config &config)
+{
+	config_ = config;
+	if (config_.step < 1)
+		config_.step = 1;
+	if (config_.max < config_.min)
+		config_.max = config_.min;
+
+	samples_.clear();
+	best_ = 0;
+	peak_ = 0.0;
+	dir_ = 1;
+
+	if (config_.climb) {
+		phase_ = Phase::Probe;
+		target_ = std::clamp(config_.start, config_.min, config_.max);
+	} else {
+		phase_ = Phase::Coarse;
+		target_ = config_.min;
+	}
+}
+
+AfSearch::Result AfSearch::startFullScan()
+{
+	phase_ = Phase::Coarse;
+	samples_.clear();
+	best_ = 0;
+	target_ = config_.min;
+	return Result::Move;
+}
+
+AfSearch::Result AfSearch::moveTo(int32_t position)
+{
+	target_ = position;
+	return Result::Move;
+}
+
+/* The last two samples lie past the best one and below peakDrop of it */
+bool AfSearch::scanEnded() const
+{
+	const unsigned int n = samples_.size();
+
+	if (n < best_ + 3)
+		return false;
+
+	const double limit = samples_[best_].sharpness * config_.peakDrop;
+
+	return samples_[n - 1].sharpness < limit &&
+	       samples_[n - 2].sharpness < limit;
+}
+
+AfSearch::Result AfSearch::finishScan(bool knownPeak)
+{
+	/* The samples in the order of their position, one per position */
+	std::vector<Sample> sorted = samples_;
+	std::sort(sorted.begin(), sorted.end(),
+		  [](const Sample &a, const Sample &b) { return a.position < b.position; });
+	sorted.erase(std::unique(sorted.begin(), sorted.end(),
+				 [](const Sample &a, const Sample &b) { return a.position == b.position; }),
+		     sorted.end());
+
+	unsigned int best = 0;
+	double worst = sorted[0].sharpness;
+	for (unsigned int i = 0; i < sorted.size(); i++) {
+		if (sorted[i].sharpness > sorted[best].sharpness)
+			best = i;
+		worst = std::min(worst, sorted[i].sharpness);
+	}
+
+	const Sample b = sorted[best];
+
+	if (b.sharpness <= 0.0 ||
+	    (!knownPeak && b.sharpness < worst * config_.minContrast)) {
+		/* A climb over a few samples proves little: scan the range */
+		if (phase_ == Phase::Probe || phase_ == Phase::Climb)
+			return startFullScan();
+
+		target_ = b.position;
+		return Result::Failed;
+	}
+
+	double position = b.position;
+
+	/*
+	 * Fit through the best sample and its neighbours. At either end of the
+	 * range take the two next samples inwards, the peak may then lie
+	 * between the end and the best sample.
+	 */
+	if (sorted.size() >= 3) {
+		const unsigned int mid = std::clamp<unsigned int>(best, 1, sorted.size() - 2);
+		const Sample &l = sorted[mid - 1];
+		const Sample &m = sorted[mid];
+		const Sample &r = sorted[mid + 1];
+		const double lo = best == 0 ? config_.min : l.position;
+		const double hi = best == sorted.size() - 1 ? config_.max : r.position;
+
+		if (l.sharpness > 0.0 && m.sharpness > 0.0 && r.sharpness > 0.0) {
+			/* Vertex of the parabola through the three log values. */
+			const double x0 = l.position, x1 = m.position, x2 = r.position;
+			const double y0 = std::log(l.sharpness);
+			const double y1 = std::log(m.sharpness);
+			const double y2 = std::log(r.sharpness);
+			const double num = (x1 - x0) * (x1 - x0) * (y1 - y2) -
+					   (x1 - x2) * (x1 - x2) * (y1 - y0);
+			const double den = (x1 - x0) * (y1 - y2) -
+					   (x1 - x2) * (y1 - y0);
+
+			/* Only a maximum (den > 0 for a concave fit) counts. */
+			if (den > 0.0) {
+				const double v = x1 - 0.5 * num / den;
+				const double step = config_.step;
+
+				position = std::clamp(v, std::max(lo, b.position - step),
+						      std::min(hi, b.position + step));
+			}
+		}
+	}
+
+	target_ = std::lround(position);
+	peak_ = b.sharpness;
+
+	if (target_ == b.position)
+		return Result::Done;
+
+	phase_ = Phase::Check;
+	return Result::Move;
+}
+
+AfSearch::Result AfSearch::update(double sharpness)
+{
+	if (phase_ == Phase::Check) {
+		/*
+		 * Keep the interpolated position unless it measured clearly
+		 * worse than the best scan sample, which happens with noise or
+		 * when the scene changed during the scan.
+		 */
+		const Sample &b = samples_[best_];
+		if (sharpness < b.sharpness * 0.8)
+			target_ = b.position;
+		else
+			peak_ = sharpness;
+
+		return Result::Done;
+	}
+
+	samples_.push_back({ target_, sharpness });
+	if (sharpness > samples_[best_].sharpness)
+		best_ = samples_.size() - 1;
+
+	const int32_t start = samples_[0].position;
+	const double s0 = samples_[0].sharpness;
+	const int32_t step = config_.step;
+
+	switch (phase_) {
+	case Phase::Probe:
+		if (samples_.size() == 1) {
+			/* First side: towards the larger part of the range */
+			dir_ = config_.max - start >= start - config_.min ? 1 : -1;
+			return moveTo(std::clamp(start + dir_ * step, config_.min, config_.max));
+		}
+
+		if (sharpness > s0 * (1.0 + kProbeMargin)) {
+			/* This side is better: climb on */
+			dir_ = target_ > start ? 1 : -1;
+			phase_ = Phase::Climb;
+			if ((dir_ > 0 && target_ >= config_.max) || (dir_ < 0 && target_ <= config_.min))
+				return finishScan();
+			return moveTo(std::clamp(target_ + dir_ * step, config_.min, config_.max));
+		}
+
+		if (samples_.size() == 2) {
+			const int32_t other = std::clamp(start - (target_ - start), config_.min, config_.max);
+			if (other != start && other != target_)
+				return moveTo(other);
+		}
+
+		/* Neither side better: a peak at the start, or a flat curve */
+		{
+			bool lower = true;
+			for (unsigned int i = 1; i < samples_.size(); i++)
+				lower &= samples_[i].sharpness < s0 * (1.0 - 2.0 * kProbeMargin);
+			if ((lower || config_.near) && s0 > 0.0)
+				return finishScan(true);
+		}
+		return startFullScan();
+
+	case Phase::Climb:
+		if (sharpness < samples_[best_].sharpness * config_.peakDrop ||
+		    (dir_ > 0 && target_ >= config_.max) || (dir_ < 0 && target_ <= config_.min))
+			return finishScan();
+		return moveTo(std::clamp(target_ + dir_ * step, config_.min, config_.max));
+
+	case Phase::Coarse:
+	case Phase::Check:
+		break;
+	}
+
+	if (scanEnded() || target_ >= config_.max)
+		return finishScan();
+
+	target_ = std::min(target_ + config_.step, config_.max);
+	return Result::Move;
+}
+
+} /* namespace ipa::mtkisp50::algorithms */
+
+} /* namespace libcamera */
diff --git a/src/ipa/mtkisp50/algorithms/af_search.h b/src/ipa/mtkisp50/algorithms/af_search.h
new file mode 100644
index 0000000..73cdd01
--- /dev/null
+++ b/src/ipa/mtkisp50/algorithms/af_search.h
@@ -0,0 +1,107 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detect focus search
+ */
+
+#pragma once
+
+#include <stdint.h>
+#include <vector>
+
+namespace libcamera {
+
+namespace ipa::mtkisp50::algorithms {
+
+/*
+ * Sharpness measure of a focus grid: mean squared difference between
+ * horizontally and vertically neighbouring cells, divided by the squared mean
+ * cell level after black level subtraction, so that it does not depend on
+ * exposure and gain. The region is the central fraction of the grid in each
+ * direction. Returns a negative value when the region is too small or too
+ * dark to measure.
+ */
+struct AfMeasurement {
+	double sharpness;
+	double level;	/* mean green level per sample, black level removed */
+};
+
+AfMeasurement afMeasure(const uint32_t *grid, unsigned int width,
+			unsigned int height, unsigned int cellSamples,
+			double blackLevel, double fraction);
+
+/*
+ * Two strategies, both ending with a move to the peak interpolated from the
+ * best sample and its neighbours in position (parabola through the
+ * logarithms, i.e. a Gaussian fit) and one check measurement there:
+ * - climb (default): measure at the current position, probe one step to
+ *   either side, then climb in the better direction until the sharpness
+ *   drops below peakDrop of the best value. A flat start (no side clearly
+ *   better or worse) falls back to the full scan.
+ * - full scan: coarse steps over the whole range from its lower end, with
+ *   an early end two samples past a clear peak.
+ */
+class AfSearch
+{
+public:
+	struct Config {
+		int32_t min;
+		int32_t max;
+		int32_t step;
+		/* End the scan after two samples below this fraction of the best. */
+		double peakDrop;
+		/* Fail when the best sample is not this much above the worst. */
+		double minContrast;
+		/* Climb from this position instead of scanning the whole range */
+		bool climb = false;
+		int32_t start = 0;
+		/*
+		 * The start is known to be close to the peak (phase detection):
+		 * a probe with no side better ends at the start
+		 */
+		bool near = false;
+	};
+
+	enum class Result {
+		Move,
+		Done,
+		Failed,
+	};
+
+	void start(const Config &config);
+	Result update(double sharpness);
+
+	/* The position to measure next (Move) or the result (Done) */
+	int32_t target() const { return target_; }
+	/* Sharpness at the result, valid after Done */
+	double peak() const { return peak_; }
+
+private:
+	struct Sample {
+		int32_t position;
+		double sharpness;
+	};
+
+	enum class Phase {
+		Probe,
+		Climb,
+		Coarse,
+		Check,
+	};
+
+	bool scanEnded() const;
+	Result finishScan(bool knownPeak = false);
+	Result startFullScan();
+	Result moveTo(int32_t position);
+
+	Config config_;
+	Phase phase_;
+	std::vector<Sample> samples_;
+	unsigned int best_;
+	int32_t target_;
+	double peak_;
+	int dir_ = 1;
+};
+
+} /* namespace ipa::mtkisp50::algorithms */
+
+} /* namespace libcamera */
