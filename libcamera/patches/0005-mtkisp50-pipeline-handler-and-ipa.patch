+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+
+private:
+	void updateExposure(IPAContext &context, IPAFrameContext &frameContext, double error);
+	void regulate(IPAContext &context, IPAFrameContext &frameContext, double error);
+	void regulateCascade(IPAContext &context, IPAFrameContext &frameContext, double factor);
+	void rebalanceForAf(IPAContext &context, IPAFrameContext &frameContext);
