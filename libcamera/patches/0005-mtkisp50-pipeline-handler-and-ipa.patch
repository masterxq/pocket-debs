+class MtkIsp50PdTest : public Test
+{
+protected:
+	int fail(const std::string &what)
+	{
+		std::cerr << what << std::endl;
+		return TestFail;
+	}
+
+	int synthetic()
+	{
+		const MtkIsp50PdLayout *l = MtkIsp50PdLayout::find("ov64b40", Size(4624, 3472));
+		if (!l || MtkIsp50PdLayout::find("ov64b40", Size(2304, 1728)) ||
+		    l->samplesPerLine() != l->size.width)
+			return fail("layout");
+
+		MtkIsp50PdStats pd(*l);
+		auto stats = std::make_unique<StatsBuffer>();
+
+		MtkIsp50PdConfig config{};
+		config.region = region(*l, 1156, 868, 2312, 1736);
+		config.gridWidth = 3;
+		config.gridHeight = 3;
+		config.maxShift = 8;
+		config.blackLevel = 64;
+
+		for (double s : { -20.0, -10.0, -3.0, 0.0, 2.0, 6.5, 16.0 }) {
+			const std::vector<uint8_t> frame = synth(*l, s, true, 1);
+			stats->valid = 0;
+			if (!pd.compute(frame.data(), frame.size(), kStride, config, stats.get()) ||
+			    !(stats->valid & StatsValidPd))
+				return fail("compute");
+
+			const StatsPdWindow &all = stats->pdRegion;
+			std::cout << "shift " << s << ": " << all.shift << " confidence " << all.confidence
+				  << " level " << all.level << std::endl;
+			if (std::abs(all.shift - s) > 1.0 || all.confidence < 60)
+				return fail("shift " + std::to_string(s) + " measured " +
+					    std::to_string(all.shift));
+			for (unsigned int i = 0; i < 9; i++) {
+				if (std::abs(stats->pd[i].shift - s) > 1.5 || stats->pd[i].confidence < 50)
+					return fail("window " + std::to_string(i) + " at shift " +
+						    std::to_string(s) + ": " +
+						    std::to_string(stats->pd[i].shift));
+			}
+			if (std::abs(all.level - 0.5 * 300.0) > 20.0)
+				return fail("level " + std::to_string(all.level));
+		}
+
+		/* Flat scene with the shared pattern: no confidence */
+		const std::vector<uint8_t> flat = synth(*l, 0.0, false, 2);
+		pd.compute(flat.data(), flat.size(), kStride, config, stats.get());
+		std::cout << "flat: " << stats->pdRegion.shift << " confidence "
+			  << stats->pdRegion.confidence << std::endl;
+		if (stats->pdRegion.confidence >= 40)
+			return fail("flat scene with confidence " +
+				    std::to_string(stats->pdRegion.confidence));
+
+		/* Windows of the configuration */
+		const std::vector<Rectangle> wins = pd.windows(config);
+		if (wins.size() != 9 || wins[0] != Rectangle(1156, 868, 770, 578))
+			return fail("windows " + wins[0].toString());
+
+		/* A short frame is refused */
+		if (pd.compute(flat.data(), flat.size() / 2, kStride, config, stats.get()) ||
+		    (stats->valid & StatsValidPd))
+			return fail("short frame accepted");
+
+		return TestPass;
+	}
+
+	int matcher()
+	{
+		FrameBuffer *a = reinterpret_cast<FrameBuffer *>(0x10);
+		FrameBuffer *b = reinterpret_cast<FrameBuffer *>(0x20);
+		FrameBuffer *c = reinterpret_cast<FrameBuffer *>(0x30);
+		constexpr uint64_t ms = 1000000;
+
+		MtkIsp50PdMatcher m;
+		m.setTolerance(12 * ms);
+		std::vector<FrameBuffer *> release;
+
+		/* No PD frame yet: it may come */
+		if (!m.mayCome(1000 * ms) || m.take(1000 * ms, &release))
+			return fail("matcher: empty");
+
+		m.push({ a, 1000 * ms + 3 * ms, 1 }, &release);
+		if (m.take(1000 * ms, &release) != a || !release.empty())
+			return fail("matcher: pair");
+
+		/* PD older than the raw frame goes back, a later one waits */
+		m.push({ b, 1033 * ms, 2 }, &release);
+		m.push({ c, 1066 * ms, 3 }, &release);
+		if (m.take(1067 * ms, &release) != c || release.size() != 1 || release[0] != b)
+			return fail("matcher: stale");
+		release.clear();
+
+		/* The PD frame of a raw frame came already and went: none may come */
+		if (m.mayCome(1066 * ms) || !m.mayCome(1100 * ms))
+			return fail("matcher: may come");
+
+		/* At most two wait */
+		m.push({ a, 1100 * ms, 4 }, &release);
+		m.push({ b, 1133 * ms, 5 }, &release);
+		m.push({ c, 1166 * ms, 6 }, &release);
+		if (release.size() != 1 || release[0] != a || m.waiting() != 2)
+			return fail("matcher: limit");
+		release.clear();
+		m.drain(&release);
+		if (release.size() != 2 || m.waiting())
+			return fail("matcher: drain");
+
+		return TestPass;
+	}
+
+	/* Real PD frames against the results of tests/kamera/pd-versatz.py */
+	int reference()
+	{
+		const char *path = getenv("MTKISP50_PD_REFERENCE");
+		if (!path) {
+			std::cout << "no reference frames (MTKISP50_PD_REFERENCE)" << std::endl;
+			return TestPass;
+		}
+
+		std::ifstream csv(path);
+		if (!csv)
+			return fail("reference not readable");
+		std::string dir(path);
+		dir = dir.substr(0, dir.rfind('/') + 1);
+
+		const MtkIsp50PdLayout *l = MtkIsp50PdLayout::find("ov64b40", Size(4624, 3472));
+		MtkIsp50PdStats pd(*l);
+		auto stats = std::make_unique<StatsBuffer>();
+
+		std::string line, lastFile;
+		std::vector<uint8_t> frame;
+		unsigned int count = 0, bad = 0;
+		std::getline(csv, line);
+		while (std::getline(csv, line)) {
+			std::istringstream in(line);
+			std::string file, v;
+			std::vector<double> f;
+			std::getline(in, file, ';');
+			while (std::getline(in, v, ';'))
+				f.push_back(std::stod(v));
+			if (f.size() < 7)
+				continue;
+
+			if (file != lastFile) {
+				std::ifstream raw(dir + file, std::ios::binary);
+				frame.assign(std::istreambuf_iterator<char>(raw), {});
+				lastFile = file;
+			}
+			const unsigned int stride = frame.size() / l->size.height;
+
+			MtkIsp50PdConfig config{};
+			config.region = region(*l, f[0], f[1], f[2], f[3]);
+			config.gridWidth = 1;
+			config.gridHeight = 1;
+			config.maxShift = f[6];
+			config.blackLevel = 64;
+			if (!pd.compute(frame.data(), frame.size(), stride, config, stats.get()))
+				return fail("reference: compute " + file);
+
+			const StatsPdWindow &w = stats->pd[0];
+			count++;
+			if (std::abs(w.shift - f[4]) > 0.05 || std::abs(w.confidence - f[5]) > 1.0) {
+				bad++;
+				std::cerr << file << " " << f[0] << "," << f[1] << ": shift " << w.shift
+					  << " / " << f[4] << ", confidence " << w.confidence << " / "
+					  << f[5] << std::endl;
+			}
+		}
+
+		std::cout << "reference: " << count << " windows, " << bad << " differ" << std::endl;
+		return count && !bad ? TestPass : TestFail;
+	}
+
+	int run() override
+	{
+		int ret = synthetic();
+		if (ret != TestPass)
+			return ret;
+		ret = matcher();
+		if (ret != TestPass)
+			return ret;
+		return reference();
+	}
+};
+
