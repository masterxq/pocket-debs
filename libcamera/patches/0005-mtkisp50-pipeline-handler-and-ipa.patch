@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Temporal noise reduction of the preview and video jobs
+ */
+
+#pragma once
+
+#include <array>
+#include <optional>
+
+#include "algorithm.h"
+#include "temporal_nr.h"
+
+namespace libcamera {
+
+namespace ipa::mtkisp50::algorithms {
+
+class TemporalNoiseReduction : public Algorithm
+{
+public:
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void prepare(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext, DipFrameParams *params) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext, const Statistics *stats,
+		     ControlList &metadata) override;
+
+private:
+	/* Tables of the preview and the video jobs (UseCase) */
+	std::array<std::optional<TemporalNrTable>, 2> tables_;
+	double isoPerGain_ = 100.0;
+	/* Change of the scene brightness between statistics, in stops */
+	double sceneStops_ = 1.0;
+
+	bool active_ = false;
+	TemporalNrRestart restart_;
+	/* Scene brightness (level per exposure) of the last statistics */
+	double lastScene_ = 0.0;
+};
+
+} /* namespace ipa::mtkisp50::algorithms */
+
+} /* namespace libcamera */
diff --git a/src/ipa/mtkisp50/awb_preference.cpp b/src/ipa/mtkisp50/awb_preference.cpp
new file mode 100644
index 0000000..6f71e13
--- /dev/null
+++ b/src/ipa/mtkisp50/awb_preference.cpp
@@ -0,0 +1,160 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Rendering of the white of warm light
+ */
+
+#include "awb_preference.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/value_node.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPAMtkIsp50AwbPreference)
+
+namespace ipa::mtkisp50 {
+
+namespace {
+
+std::optional<std::vector<double>> numbers(const ValueNode &node)
+{
+	if (!node.isList())
+		return std::nullopt;
+
+	std::vector<double> out;
+	for (const ValueNode &v : node.asList()) {
+		std::optional<double> d = v.get<double>();
+		if (!d)
+			return std::nullopt;
+		out.push_back(*d);
+	}
+	return out;
+}
+
+bool rising(const std::vector<double> &v)
+{
+	for (unsigned int i = 1; i < v.size(); i++) {
+		if (!(v[i] > v[i - 1]))
+			return false;
+	}
+	return !v.empty();
+}
+
+/* Index of the lower point and weight of the upper one, ends held */
+std::pair<unsigned int, double> locate(const std::vector<double> &x, double v)
+{
+	if (x.size() == 1 || v <= x.front())
+		return { 0, 0.0 };
+	if (v >= x.back())
+		return { static_cast<unsigned int>(x.size() - 2), 1.0 };
+
+	unsigned int i = 0;
+	while (v > x[i + 1])
+		i++;
+	return { i, (v - x[i]) / (x[i + 1] - x[i]) };
+}
+
+} /* namespace */
+
+std::optional<AwbPreference> AwbPreference::fromTuning(const ValueNode &node)
+{
+	AwbPreference p;
+
+	auto ct = numbers(node["ct"]);
+	if (!ct || !rising(*ct) || !((*ct)[0] > 0.0)) {
+		LOG(IPAMtkIsp50AwbPreference, Error) << "preference: ct missing or not rising";
+		return std::nullopt;
+	}
+	p.ct_ = *ct;
+
+	if (node.contains("lv")) {
+		auto lv = numbers(node["lv"]);
+		if (!lv || !rising(*lv)) {
+			LOG(IPAMtkIsp50AwbPreference, Error) << "preference: lv not rising";
+			return std::nullopt;
+		}
+		p.lv_ = *lv;
+	}
+
+	const unsigned int rows = std::max<std::size_t>(p.lv_.size(), 1);
+	auto table = [&](const char *key, std::vector<std::vector<double>> &out) {
+		const ValueNode &n = node[key];
+		if (!n.isList())
+			return false;
+		if (p.lv_.empty()) {
+			auto r = numbers(n);
+			if (!r)
+				return false;
+			out.push_back(*r);
+		} else {
+			for (const ValueNode &row : n.asList()) {
+				auto r = numbers(row);
+				if (!r)
+					return false;
+				out.push_back(*r);
+			}
+		}
+		if (out.size() != rows)
+			return false;
+		for (const auto &r : out) {
+			if (r.size() != p.ct_.size() ||
+			    std::any_of(r.begin(), r.end(), [](double v) { return !(v > 0.05 && v < 20.0); }))
+				return false;
+		}
+		return true;
+	};
+
+	if (!table("rg", p.rg_) || !table("bg", p.bg_)) {
+		LOG(IPAMtkIsp50AwbPreference, Error)
+			<< "preference: rg and bg need one list per lv with one value (0.05..20) per ct";
+		return std::nullopt;
+	}
+
+	return p;
+}
+
+double AwbPreference::value(const std::vector<std::vector<double>> &rows, double temperatureK,
+			    std::optional<double> lightValue) const
+{
+	/* Linear in mired: mired falls with the temperature, use -mired */
+	std::vector<double> negMired;
+	for (double ct : ct_)
+		negMired.push_back(-1e6 / ct);
+	const auto [ci, cw] = locate(negMired, -1e6 / std::max(temperatureK, 1.0));
+
+	auto rowValue = [&](const std::vector<double> &row) {
+		if (row.size() == 1)
+			return std::log(row[0]);
+		return (1.0 - cw) * std::log(row[ci]) + cw * std::log(row[ci + 1]);
+	};
+
+	if (lv_.empty())
+		return std::exp(rowValue(rows[0]));
+
+	/* Without a light value the dimmest row */
+	const auto [li, lw] = lightValue ? locate(lv_, *lightValue)
+					 : std::pair<unsigned int, double>(0, 0.0);
+	const double lo = rowValue(rows[li]);
+	const double hi = rows.size() > 1 ? rowValue(rows[li + 1]) : lo;
+	return std::exp(lo + lw * (hi - lo));
+}
+
+RGB<double> AwbPreference::tint(double temperatureK, std::optional<double> lightValue) const
+{
+	return RGB<double>({ value(rg_, temperatureK, lightValue), 1.0,
+			     value(bg_, temperatureK, lightValue) });
+}
+
+double lightValue(double fNumber, double exposureTime, double gain, double levelRatio)
+{
+	return std::log2(fNumber * fNumber / std::max(exposureTime, 1e-6)) -
+	       std::log2(std::max(gain, 1e-3)) + std::log2(std::max(levelRatio, 1e-6));
+}
+
+} /* namespace ipa::mtkisp50 */
+
+} /* namespace libcamera */
diff --git a/src/ipa/mtkisp50/awb_preference.h b/src/ipa/mtkisp50/awb_preference.h
new file mode 100644
index 0000000..6fee438
--- /dev/null
+++ b/src/ipa/mtkisp50/awb_preference.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Rendering of the white of warm light
+ */
+
+#pragma once
+
+#include <optional>
+#include <vector>
+
+#include "libcamera/internal/vector.h"
+
+namespace libcamera {
+
+class ValueNode;
+
+namespace ipa::mtkisp50 {
+
+/*
+ * A neutral surface under warm light is not rendered fully neutral: the
+ * colour of the light stays partly visible, more so in dim scenes. The
+ * preference gives the colour a neutral surface keeps, as R/G and B/G of the
+ * output (linear, after the colour matrix), over the colour temperature of the
+ * estimated light and the light value of the scene.
+ */
+class AwbPreference
+{
+public:
+	/*
+	 * Tuning keys: "ct", rising colour temperatures; "rg" and "bg", one
+	 * list per entry of "lv" (rising light values; one list without
+	 * "lv"), one value per colour temperature. Interpolation is linear
+	 * in mired and in the light value, on the logarithm of the values,
+	 * and the ends are held.
+	 */
+	static std::optional<AwbPreference> fromTuning(const ValueNode &node);
+
+	/* Output colour of a neutral surface, R/G and B/G (green 1.0) */
+	RGB<double> tint(double temperatureK, std::optional<double> lightValue) const;
+
+private:
+	AwbPreference() = default;
+
+	double value(const std::vector<std::vector<double>> &rows, double temperatureK,
+		     std::optional<double> lightValue) const;
+
+	std::vector<double> ct_;
+	std::vector<double> lv_;
+	std::vector<std::vector<double>> rg_;
+	std::vector<std::vector<double>> bg_;
+};
+
+/*
+ * Light value of a scene exposed with an exposure time in seconds and a total
+ * gain (ISO 100 at a gain of 1.0), and the ratio of the measured level to the
+ * level the exposure aims at (1.0 when the regulation reached its target):
+ * log2(fNumber^2 / time) - log2(gain) + log2(level ratio)
+ */
+double lightValue(double fNumber, double exposureTime, double gain, double levelRatio = 1.0);
+
+} /* namespace ipa::mtkisp50 */
+
+} /* namespace libcamera */
