diff --git a/src/ipa/mtkisp50/mtkisp50.cpp b/src/ipa/mtkisp50/mtkisp50.cpp
new file mode 100644
index 0000000..b3ccf28
--- /dev/null
+++ b/src/ipa/mtkisp50/mtkisp50.cpp
@@ -0,0 +1,596 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2023, Linaro Ltd
+ *
+ * mtkisp50 Image Processing Algorithm module, for the ISP pass 2 (DIP) of the
+ * MediaTek MT6785. The algorithms are those of the simple IPA (with the
+ * MediaTek extensions), the parameters are DIP parameter blocks and the
+ * statistics come from the statistics buffers of the pipeline.
+ */
+
+#include <algorithm>
+#include <cmath>
+#include <chrono>
+#include <map>
+#include <stdint.h>
+#include <string>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/file.h>
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+#include <libcamera/controls.h>
+
+#include <libcamera/ipa/ipa_interface.h>
+#include <libcamera/ipa/ipa_module_info.h>
+#include <libcamera/ipa/mtkisp50_ipa_interface.h>
+
+#include "libcamera/internal/bayer_format.h"
+#include "libcamera/internal/mapped_framebuffer.h"
+#include "libcamera/internal/mtkisp50/stats.h"
+#include "libcamera/internal/yaml_parser.h"
+
+#include "algorithms/adjust.h"
+#include "libipa/camera_sensor_helper.h"
+
+#include "dip_params.h"
+#include "module.h"
+#include "statistics.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPAMtkIsp50)
+
+using namespace std::literals::chrono_literals;
+
+namespace ipa::mtkisp50 {
+
+/* Maximum number of frame contexts to be held */
+static constexpr uint32_t kMaxFrameContexts = 16;
+
+class IPAMtkIsp50 : public IPAMtkIsp50Interface, public Module
+{
+public:
+	IPAMtkIsp50()
+		: context_(kMaxFrameContexts)
+	{
+	}
+
+	int init(const IPASettings &settings,
+		 const IPACameraSensorInfo &sensorInfo,
+		 const ControlInfoMap &sensorControls,
+		 const ControlInfoMap &lensControls,
+		 ControlInfoMap *ipaControls) override;
+	int configure(const IPAConfigInfo &configInfo, ControlInfoMap *ipaControls) override;
+	void start(const ControlList &controls, StartResult *result) override;
+	void stop() override;
+
+	void mapBuffers(const std::vector<IPABuffer> &buffers) override;
+	void unmapBuffers(const std::vector<unsigned int> &ids) override;
+
+	void queueRequest(const uint32_t frame, const ControlList &controls) override;
+	void computeParams(const uint32_t frame, const uint32_t paramsBufferId) override;
+	void processStats(const uint32_t frame, const uint32_t statsBufferId,
+			  const ControlList &sensorControls) override;
+
+protected:
+	std::string logPrefix() const override;
+
+private:
+	void resetParams();
+	void saveState();
+	void restoreState();
+
+	/* Parameters of the frames, kept from frame to frame as before */
+	DipFrameParams params_;
+	ParamsEncoder encoder_;
+	BayerFormat::Order bayerOrder_ = BayerFormat::BGGR;
+
+	Statistics stats_;
+
+	std::map<unsigned int, MappedFrameBuffer> buffers_;
+
+	/*
+	 * Statistics interval once exposure, white balance and focus have
+	 * settled, from the tuning file
+	 */
+	unsigned int statsIntervalSettled_ = Statistics::kFramesPerStats;
+	unsigned int statsLinePairStep_ = 0;
+	unsigned int statsBlockStep_ = 0;
+	unsigned int settledCount_ = 0;
+	RGB<float> lastGains_ = RGB<float>({ 0.0, 0.0, 0.0 });
+
+	/*
+	 * State carried over a new configuration of the same camera (mode
+	 * change), so that the first frames start close to where the
+	 * previous stream ended
+	 */
+	struct CarriedState {
+		bool valid = false;
+		utils::Duration exposureTime;
+		double again;
+		double digitalGain;
+		RGB<float> awbGains;
+		unsigned int temperatureK;
+		bool lensValid;
+	} carried_;
+	bool startControls_ = false;
+	bool configured_ = false;
+
+	std::unique_ptr<CameraSensorHelper> camHelper_;
+	ControlInfoMap sensorInfoMap_;
+
+	/* Local parameter storage */
+	struct IPAContext context_;
+};
+
+int IPAMtkIsp50::init(const IPASettings &settings,
+		      const IPACameraSensorInfo &sensorInfo,
+		      const ControlInfoMap &sensorControls,
+		      const ControlInfoMap &lensControls,
+		      ControlInfoMap *ipaControls)
+{
+	camHelper_ = CameraSensorHelperFactoryBase::create(settings.sensorModel);
+	if (!camHelper_) {
+		LOG(IPAMtkIsp50, Warning)
+			<< "Failed to create camera sensor helper for "
+			<< settings.sensorModel;
+	}
+
+	context_.sensorInfo = sensorInfo;
+	context_.lensControls = lensControls;
+
+	/* Load the tuning data file */
+	File file(settings.configurationFile);
+	if (!file.open(File::OpenModeFlag::ReadOnly)) {
+		int ret = file.error();
+		LOG(IPAMtkIsp50, Error)
+			<< "Failed to open configuration file "
+			<< settings.configurationFile << ": " << strerror(-ret);
+		return ret;
+	}
+
+	std::unique_ptr<ValueNode> data = YamlParser::parse(file);
+	if (!data)
+		return -EINVAL;
+
+	unsigned int version = (*data)["version"].get<uint32_t>(0);
+	LOG(IPAMtkIsp50, Debug) << "Tuning file version " << version;
+
+	if (!data->contains("algorithms")) {
+		LOG(IPAMtkIsp50, Error) << "Tuning file doesn't contain algorithms";
+		return -EINVAL;
+	}
+
+	int ret = createAlgorithms(context_, (*data)["algorithms"]);
+	if (ret)
+		return ret;
+
+	/*
+	 * Sampling of the statistics: every intervalSettled frames once
+	 * exposure, white balance and focus are steady, else every
+	 * kFramesPerStats frames; line pair and block steps (0: pipeline
+	 * default).
+	 */
+	const ValueNode &statistics = (*data)["statistics"];
+	statsIntervalSettled_ = std::clamp(statistics["intervalSettled"].get<unsigned int>(Statistics::kFramesPerStats),
+					   Statistics::kFramesPerStats, 64u);
+	statsIntervalSettled_ -= statsIntervalSettled_ % Statistics::kFramesPerStats;
+	statsLinePairStep_ = std::min(statistics["linePairStep"].get<unsigned int>(0), 64u);
+	statsBlockStep_ = std::min(statistics["blockStep"].get<unsigned int>(0), 64u);
+	if (statistics)
+		LOG(IPAMtkIsp50, Info)
+			<< "Statistics every " << statsIntervalSettled_ << " frames when settled, steps "
+			<< statsLinePairStep_ << "/" << statsBlockStep_ << " (0: pipeline default)";
+
+	/* DIP tuning collected by the ToneCurve, Lsc and Quality algorithms */
+	encoder_.setToneCurve(context_.dip.toneCurve);
+	encoder_.setShadowLift(context_.dip.shadowLift);
+	encoder_.setLensShading(context_.dip.lensShading);
+	encoder_.setQuality(context_.dip.quality);
+
+	resetParams();
+
+	/*
+	 * Ranges of the manual exposure controls for the sensor mode of the
+	 * moment, before the first configuration; configure() updates them.
+	 */
+	const auto expIt = sensorControls.find(V4L2_CID_EXPOSURE);
+	const auto gainIt = sensorControls.find(V4L2_CID_ANALOGUE_GAIN);
+	if (sensorInfo.pixelRate && expIt != sensorControls.end() && gainIt != sensorControls.end() &&
+	    context_.ctrlMap.count(&controls::ExposureTime)) {
+		const utils::Duration line = sensorInfo.minLineLength * 1.0s / sensorInfo.pixelRate;
+		const int32_t minUs = static_cast<int32_t>(
+			utils::Duration(line * std::max(expIt->second.min().get<int32_t>(), 1)).get<std::micro>());
+		const int32_t maxUs = static_cast<int32_t>(
+			utils::Duration(line * expIt->second.max().get<int32_t>()).get<std::micro>());
+		context_.ctrlMap[&controls::ExposureTime] =
+			ControlInfo(minUs, maxUs, std::clamp(10000, minUs, maxUs));
+		if (camHelper_)
+			context_.ctrlMap[&controls::AnalogueGain] =
+				ControlInfo(static_cast<float>(camHelper_->gain(gainIt->second.min().get<int32_t>())),
+					    static_cast<float>(camHelper_->gain(gainIt->second.max().get<int32_t>())),
+					    1.0f);
+	}
+
+	ControlInfoMap::Map ctrlMap = context_.ctrlMap;
+	*ipaControls = ControlInfoMap(std::move(ctrlMap), controls::controls);
+
+	/*
+	 * Check if the sensor driver supports the controls required by the
+	 * IPA. Don't save the min and max control values yet, as e.g. the
+	 * limits for V4L2_CID_EXPOSURE depend on the configured sensor mode.
+	 */
+	if (sensorControls.find(V4L2_CID_EXPOSURE) == sensorControls.end()) {
+		LOG(IPAMtkIsp50, Error) << "Don't have exposure control";
+		return -EINVAL;
+	}
+
+	if (sensorControls.find(V4L2_CID_ANALOGUE_GAIN) == sensorControls.end()) {
+		LOG(IPAMtkIsp50, Error) << "Don't have gain control";
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+/* Initial parameters, as the software ISP set them up */
+void IPAMtkIsp50::resetParams()
+{
+	params_ = {};
+	params_.blackLevel = { { 0.0, 0.0, 0.0 } };
+	params_.gamma = 1.0 / algorithms::kDefaultGamma;
+	params_.contrastExp = 1.0;
+	params_.gains = { { 1.0, 1.0, 1.0 } };
+}
+
+void IPAMtkIsp50::saveState()
+{
+	const IPAActiveState &state = context_.activeState;
+
+	carried_.valid = state.agc.valid;
+	if (!carried_.valid)
+		return;
+
+	carried_.exposureTime = context_.configuration.agc.lineDuration * state.agc.exposure;
+	carried_.again = state.agc.again;
+	carried_.digitalGain = state.agc.digitalGain;
+	carried_.awbGains = state.awb.gains;
+	carried_.temperatureK = state.awb.temperatureK;
+	carried_.lensValid = !context_.lensControls.empty();
+}
+
+/*
+ * After a new configuration of the same camera: start from the exposure,
+ * white balance and lens position the previous stream ended with. The
+ * exposure keeps its time over a change of the line duration.
+ */
+void IPAMtkIsp50::restoreState()
+{
+	startControls_ = false;
+	if (!carried_.valid)
+		return;
+
+	IPAActiveState &state = context_.activeState;
+	const auto &agc = context_.configuration.agc;
+
+	int32_t exposure = agc.lineDuration > 0s
+				   ? static_cast<int32_t>(std::lround(carried_.exposureTime / agc.lineDuration))
+				   : state.agc.exposure;
+	/* Up to the longest exposure with a longer frame, as the Agc does */
+	const int32_t exposureMax = agc.vblankEnabled ? agc.exposureMaxExtended : agc.exposureMax;
+	state.agc.exposure = std::clamp(exposure, agc.exposureMin, exposureMax);
+	state.agc.again = std::clamp(carried_.again, agc.againMin, agc.againMax);
+	state.agc.digitalGain = carried_.digitalGain;
+	state.agc.valid = true;
+	state.awb.gains = carried_.awbGains;
+	state.awb.temperatureK = carried_.temperatureK;
+	/* The Af algorithm keeps the lens position itself */
+
+	startControls_ = true;
+
+	LOG(IPAMtkIsp50, Debug)
+		<< "Carried over: exposure " << state.agc.exposure << " lines, gain "
+		<< state.agc.again << ", gains " << state.awb.gains;
+}
+
+int IPAMtkIsp50::configure(const IPAConfigInfo &configInfo, ControlInfoMap *ipaControls)
+{
+	sensorInfoMap_ = configInfo.sensorControls;
+	context_.sensorInfo = configInfo.sensorInfo;
+
+	const ControlInfo &exposureInfo = sensorInfoMap_.find(V4L2_CID_EXPOSURE)->second;
+	const ControlInfo &gainInfo = sensorInfoMap_.find(V4L2_CID_ANALOGUE_GAIN)->second;
+
+	/* The state of the previous configuration goes over a mode change */
+	if (configured_)
+		saveState();
+	configured_ = true;
+
+	/* Clear the IPA context before the streaming session. */
+	context_.configuration = {};
+	context_.activeState = {};
+	context_.frameContexts.clear();
+
+	context_.configuration.rawSize = configInfo.rawSize;
+	context_.configuration.statsWindow = configInfo.ispCrop;
+	context_.configuration.agc.lineDuration =
+		context_.sensorInfo.minLineLength * 1.0s / context_.sensorInfo.pixelRate;
+	context_.configuration.agc.exposureMin = exposureInfo.min().get<int32_t>();
+	context_.configuration.agc.exposureMax = exposureInfo.max().get<int32_t>();
+	if (!context_.configuration.agc.exposureMin) {
+		LOG(IPAMtkIsp50, Warning) << "Minimum exposure is zero, that can't be linear";
+		context_.configuration.agc.exposureMin = 1;
+	}
+
+	int32_t againMin = gainInfo.min().get<int32_t>();
+	int32_t againMax = gainInfo.max().get<int32_t>();
+	int32_t againDef = gainInfo.def().get<int32_t>();
+
+	if (camHelper_) {
+		context_.configuration.agc.againMin = camHelper_->gain(againMin);
+		context_.configuration.agc.againMax = camHelper_->gain(againMax);
+		context_.configuration.agc.again10 = std::max(context_.configuration.agc.againMin, 1.0);
+		context_.configuration.agc.againMinStep =
+			(context_.configuration.agc.againMax -
+			 context_.configuration.agc.againMin) /
+			100.0;
+		if (camHelper_->blackLevel().has_value()) {
+			/*
+			 * The black level from camHelper_ is a 16 bit value,
+			 * the algorithms use 8 bit values.
+			 */
+			context_.configuration.black.level =
+				camHelper_->blackLevel().value() / 256;
+		}
+	} else {
+		context_.configuration.agc.againMax = againMax;
+		context_.configuration.agc.again10 = againDef;
+		context_.configuration.agc.againMin = againMin;
+		context_.configuration.agc.againMinStep = 1.0;
+	}
+
+	for (const auto &algo : algorithms()) {
+		int ret = algo->configure(context_, configInfo);
+		if (ret)
+			return ret;
+	}
+
+	restoreState();
+
+	bayerOrder_ = static_cast<BayerFormat::Order>(configInfo.bayerOrder);
+
+	/* All blocks again with the first parameters of the stream */
+	encoder_.reset();
+
+	ControlInfoMap::Map ctrlMap = context_.ctrlMap;
+	*ipaControls = ControlInfoMap(std::move(ctrlMap), controls::controls);
+
+	LOG(IPAMtkIsp50, Info)
+		<< "Exposure " << context_.configuration.agc.exposureMin << "-"
+		<< context_.configuration.agc.exposureMax
+		<< ", gain " << context_.configuration.agc.againMin << "-"
+		<< context_.configuration.agc.againMax
+		<< " (" << context_.configuration.agc.againMinStep << ")"
+		<< ", use case " << static_cast<int>(configInfo.useCase);
+
+	return 0;
+}
+
+void IPAMtkIsp50::start([[maybe_unused]] const ControlList &controls, StartResult *result)
+{
+	settledCount_ = 0;
+	lastGains_ = RGB<float>({ 0.0, 0.0, 0.0 });
+	encoder_.reset();
+	resetParams();
+
+	result->ret = 0;
+	result->sensorControls = ControlList(sensorInfoMap_);
+	result->lensControls = ControlList(context_.lensControls);
+
+	if (!startControls_)
+		return;
+
+	const IPAActiveState &state = context_.activeState;
+	result->sensorControls.set(V4L2_CID_EXPOSURE, state.agc.exposure);
+	const auto &agc = context_.configuration.agc;
+	if (agc.vblankEnabled) {
+		/* Frame length for the exposure, one line of headroom, as processStats() */
+		const int32_t extra = state.agc.exposure - agc.exposureMax;
+		result->sensorControls.set(V4L2_CID_VBLANK,
+					   agc.vblankDefault + (extra > 0 ? extra + 1 : 0));
+	}
+	result->sensorControls.set(V4L2_CID_ANALOGUE_GAIN,
+				   static_cast<int32_t>(camHelper_ ? camHelper_->gainCode(state.agc.again)
+								   : state.agc.again));
+	if (carried_.lensValid && state.af.lensPosition)
+		result->lensControls.set(V4L2_CID_FOCUS_ABSOLUTE, state.af.lensPosition);
+}
+
+void IPAMtkIsp50::stop()
+{
+	context_.frameContexts.clear();
+}
+
+void IPAMtkIsp50::mapBuffers(const std::vector<IPABuffer> &buffers)
+{
+	for (const IPABuffer &buffer : buffers) {
+		const FrameBuffer fb(buffer.planes);
+		buffers_.emplace(buffer.id,
+				 MappedFrameBuffer(&fb, MappedFrameBuffer::MapFlag::ReadWrite));
+	}
+}
+
+void IPAMtkIsp50::unmapBuffers(const std::vector<unsigned int> &ids)
+{
+	for (unsigned int id : ids)
+		buffers_.erase(id);
+}
+
+void IPAMtkIsp50::queueRequest(const uint32_t frame, const ControlList &controls)
+{
+	IPAFrameContext &frameContext = context_.frameContexts.alloc(frame);
+
+	for (const auto &algo : algorithms())
+		algo->queueRequest(context_, frame, frameContext, controls);
+}
+
+void IPAMtkIsp50::computeParams(const uint32_t frame, const uint32_t paramsBufferId)
+{
+	context_.activeState.combinedMatrix = Matrix<float, 3, 3>::identity();
+
+	IPAFrameContext &frameContext = context_.frameContexts.get(frame);
+
+	/* Without the Af algorithm (or with it idle) no focus grid */
+	params_.afStatsInterval = 0;
+	params_.statsInterval = settledCount_ >= 2 ? statsIntervalSettled_
+						    : Statistics::kFramesPerStats;
+	params_.statsLinePairStep = statsLinePairStep_;
+	params_.statsBlockStep = statsBlockStep_;
+	for (const auto &algo : algorithms())
+		algo->prepare(context_, frame, frameContext, &params_);
+	params_.combinedMatrix = context_.activeState.combinedMatrix;
+
+	uint32_t bytesused = 0;
+	auto it = buffers_.find(paramsBufferId);
+	if (it != buffers_.end()) {
+		bytesused = encoder_.encode(params_, bayerOrder_, it->second.planes()[0]);
+		if (bytesused)
+			encoder_.commit();
+	} else {
+		LOG(IPAMtkIsp50, Error) << "Unknown parameters buffer " << paramsBufferId;
+	}
+
+	StatsConfig config;
+	config.interval = params_.statsInterval;
+	config.linePairStep = params_.statsLinePairStep;
+	config.blockStep = params_.statsBlockStep;
+	config.afInterval = params_.afStatsInterval;
+	config.afEveryFrame = params_.afEveryFrame;
+	config.afRegionMode = params_.afRegionMode;
+	config.afRegion.assign(params_.afRegion.begin(), params_.afRegion.end());
+
+	paramsComputed.emit(frame, bytesused, config);
+}
+
+void IPAMtkIsp50::processStats(const uint32_t frame, const uint32_t statsBufferId,
+			       const ControlList &sensorControls)
+{
+	IPAFrameContext &frameContext = context_.frameContexts.get(frame);
+
+	/*
+	 * Software ISP stats are valid only for some frames: the values of
+	 * the sensor controls of this frame are in sensorControls.
+	 */
+	const ControlValue &exposure = sensorControls.get(V4L2_CID_EXPOSURE);
+	const ControlValue &gain = sensorControls.get(V4L2_CID_ANALOGUE_GAIN);
+	if (exposure.type() == ControlTypeInteger32 && gain.type() == ControlTypeInteger32) {
+		frameContext.sensor.exposure = exposure.get<int32_t>();
+		int32_t again = gain.get<int32_t>();
+		frameContext.sensor.gain = camHelper_ ? camHelper_->gain(again) : again;
+	} else {
+		LOG(IPAMtkIsp50, Error)
+			<< "Frame " << frame << ": sensor controls missing or of the wrong type"
+			<< " (exposure type " << static_cast<int>(exposure.type())
+			<< ", gain type " << static_cast<int>(gain.type()) << "), keeping the last values";
+		frameContext.sensor.exposure = context_.activeState.agc.exposure;
+		frameContext.sensor.gain = context_.activeState.agc.again;
+	}
+
+	auto it = buffers_.find(statsBufferId);
+	if (it != buffers_.end() &&
+	    it->second.planes()[0].size() >= sizeof(libcamera::mtkisp50::StatsBuffer)) {
+		const auto *buffer = reinterpret_cast<const libcamera::mtkisp50::StatsBuffer *>(
+			it->second.planes()[0].data());
+		stats_.parse(*buffer, frame);
+	} else {
+		LOG(IPAMtkIsp50, Error) << "Unknown statistics buffer " << statsBufferId;
+		stats_.valid = false;
+		stats_.afGridValid = false;
+	}
+
+	ControlList metadata(controls::controls);
+	for (const auto &algo : algorithms())
+		algo->process(context_, frame, frameContext, &stats_, metadata);
+	metadataReady.emit(frame, metadata);
+
+	/*
+	 * Settled when exposure, white balance (gains within 2 %) and focus
+	 * are steady: then statistics on a longer interval.
+	 */
+	if (stats_.valid) {
+		const auto &agc = context_.activeState.agc;
+		const RGB<float> &gains = context_.activeState.awb.gains;
+		bool awbSteady = true;
+		for (unsigned int c = 0; c < 3; c++) {
+			if (!(lastGains_[c] > 0.0f) ||
+			    std::abs(gains[c] / lastGains_[c] - 1.0f) > 0.02f)
+				awbSteady = false;
+		}
+		lastGains_ = gains;
+
+		const bool settled = agc.valid && !agc.converging && awbSteady &&
+				     !context_.activeState.af.busy;
+		settledCount_ = settled ? settledCount_ + 1 : 0;
+	}
+
+	/* Sanity check */
+	if (!sensorControls.contains(V4L2_CID_EXPOSURE) ||
+	    !sensorControls.contains(V4L2_CID_ANALOGUE_GAIN)) {
+		LOG(IPAMtkIsp50, Error) << "Control(s) missing";
+		return;
+	}
+
+	ControlList ctrls(sensorInfoMap_);
+
+	auto &againNew = frameContext.sensor.gain;
+	ctrls.set(V4L2_CID_EXPOSURE, frameContext.sensor.exposure);
+	ctrls.set(V4L2_CID_ANALOGUE_GAIN,
+		  static_cast<int32_t>(camHelper_ ? camHelper_->gainCode(againNew) : againNew));
+
+	const auto &agc = context_.configuration.agc;
+	if (agc.vblankEnabled) {
+		/* Raise the frame length with the exposure, one line headroom. */
+		int32_t extra = frameContext.sensor.exposure - agc.exposureMax;
+		ctrls.set(V4L2_CID_VBLANK,
+			  agc.vblankDefault + (extra > 0 ? extra + 1 : 0));
+	}
+
+	ControlList lensCtrls(context_.lensControls);
+	if (context_.activeState.af.update) {
+		lensCtrls.set(V4L2_CID_FOCUS_ABSOLUTE,
+			      context_.activeState.af.lensPosition);
+		context_.activeState.af.update = false;
+	}
+
+	setSensorControls.emit(frame, ctrls, lensCtrls);
+}
+
+std::string IPAMtkIsp50::logPrefix() const
+{
+	return "IPAMtkIsp50";
+}
+
+} /* namespace ipa::mtkisp50 */
+
+/*
+ * External IPA module interface
+ */
+extern "C" {
+const struct IPAModuleInfo ipaModuleInfo = {
+	IPA_MODULE_API_VERSION,
+	0,
+	"mtkisp50",
+	"mtkisp50",
+};
+
+IPAInterface *ipaCreate()
+{
+	return new ipa::mtkisp50::IPAMtkIsp50();
+}
+
+} /* extern "C" */
+
+} /* namespace libcamera */
diff --git a/src/ipa/mtkisp50/statistics.cpp b/src/ipa/mtkisp50/statistics.cpp
new file mode 100644
index 0000000..310b3cc
--- /dev/null
+++ b/src/ipa/mtkisp50/statistics.cpp
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Statistics of a frame as the mtkisp50 algorithms see them
+ */
+
+#include "statistics.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPAMtkIsp50Stats)
+
+namespace ipa::mtkisp50 {
+
+using libcamera::mtkisp50::StatsBuffer;
+
+namespace {
+
+/* Sum of a cell back from its mean and count, before the 8 bit shift */
+uint64_t cellSum(const libcamera::mtkisp50::StatsCell &cell, unsigned int c)
+{
+	return static_cast<uint64_t>(std::llround(cell.mean[c] * cell.count));
+}
+
+} /* namespace */
+
+bool Statistics::parse(const StatsBuffer &buffer, uint32_t frameId)
+{
+	valid = false;
+	afGridValid = false;
+
+	if (buffer.version != StatsBuffer::kVersion || buffer.frame != frameId) {
+		LOG(IPAMtkIsp50Stats, Warning)
+			<< "Statistics buffer of frame " << buffer.frame
+			<< " (version " << buffer.version << ") for frame " << frame;
+		return false;
+	}
+
+	const bool cells = buffer.valid & libcamera::mtkisp50::StatsValidCells;
+	const bool af = buffer.valid & libcamera::mtkisp50::StatsValidAf;
+
+	if (buffer.skipped)
+		skippedFrame = frameId;
+
+	if (cells) {
+		if (buffer.gridWidth != kZones || buffer.gridHeight != kZones ||
+		    buffer.bitDepth < 8) {
+			LOG(IPAMtkIsp50Stats, Error)
+				<< "Unsupported statistics grid " << buffer.gridWidth
+				<< "x" << buffer.gridHeight << " at " << buffer.bitDepth << " bits";
+			return false;
+		}
+
+		const unsigned int shift = buffer.bitDepth - 8;
+		RGB<uint64_t> total({ 0, 0, 0 });
+
+		for (unsigned int j = 0; j < kZones * kZones; j++) {
+			const auto &cell = buffer.cells[j];
+			RGB<uint64_t> sum({ cellSum(cell, 0), cellSum(cell, 1), cellSum(cell, 2) });
+
+			total += sum;
+			zoneSum[j] = RGB<uint64_t>({ sum.r() >> shift, sum.g() >> shift,
+						     sum.b() >> shift });
+			zoneCount[j] = cell.count;
+		}
+
+		sum_ = RGB<uint64_t>({ total.r() >> shift, total.g() >> shift,
+				       total.b() >> shift });
+
+		yHistogram.fill(0);
+		for (unsigned int i = 0; i < std::min<unsigned int>(buffer.histogramCount,
+								    StatsBuffer::kMaxHistograms); i++) {
+			const auto &hist = buffer.histograms[i];
+			if (hist.type != libcamera::mtkisp50::StatsHistogramLumaBt601 ||
+			    hist.bins != kYHistogramSize)
+				continue;
+			std::copy_n(hist.data, kYHistogramSize, yHistogram.begin());
+			break;
+		}
+
+		frame = frameId;
+		valid = true;
+	}
+
+	/*
+	 * The grid goes with the frames with statistics, gathered or not, and
+	 * with the frames that gathered it alone.
+	 */
+	if ((cells || af) && buffer.afWidth && buffer.afHeight) {
+		const unsigned int count = std::min<unsigned int>(buffer.afWidth * buffer.afHeight,
+								  afGrid.size());
+
+		afGridWidth = buffer.afWidth;
+		afGridHeight = buffer.afHeight;
+		afCellSize = buffer.afBlockSize;
+		afCellSamples = buffer.afBlockSamples;
+		for (unsigned int j = 0; j < count; j++)
+			afGrid[j] = buffer.af[j].level;
+		afGridFrame = frameId;
+		afGridValid = af && buffer.afMeasure == libcamera::mtkisp50::StatsAfLevelSum;
+	}
+
+	return true;
+}
+
+} /* namespace ipa::mtkisp50 */
+
+} /* namespace libcamera */
diff --git a/src/ipa/mtkisp50/statistics.h b/src/ipa/mtkisp50/statistics.h
new file mode 100644
index 0000000..3656404
--- /dev/null
+++ b/src/ipa/mtkisp50/statistics.h
@@ -0,0 +1,69 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Statistics of a frame as the mtkisp50 algorithms see them
+ *
+ * The algorithms read this view only; parse() fills it from a statistics
+ * buffer (mtkisp50/stats.h) of any source. The fields keep the meaning of the
+ * CPU statistics the algorithms were tuned with: sums of the samples on an
+ * 8 bit scale over a 15x15 zone grid, a 64 bin luma histogram and a focus grid
+ * of green sums.
+ */
+
+#pragma once
+
+#include <array>
+#include <stdint.h>
+
+#include "libcamera/internal/mtkisp50/stats.h"
+#include "libcamera/internal/vector.h"
+
+namespace libcamera {
+
+namespace ipa::mtkisp50 {
+
+struct Statistics {
+	/* Statistics need a frame number that is a multiple of this */
+	static constexpr uint32_t kFramesPerStats = 4;
+
+	/* Statistics of this frame are valid */
+	bool valid;
+	/* Frame the statistics belong to */
+	uint32_t frame;
+	/* Sums of the colour channels of all sampled pixels, 8 bit scale */
+	RGB<uint64_t> sum_;
+
+	static constexpr unsigned int kZones = 15;
+	/* Sums and number of samples per zone, rows from the top */
+	std::array<RGB<uint64_t>, kZones * kZones> zoneSum;
+	std::array<uint32_t, kZones * kZones> zoneCount;
+
+	static constexpr unsigned int kYHistogramSize = 64;
+	using Histogram = std::array<uint32_t, kYHistogramSize>;
+	Histogram yHistogram;
+
+	/* Focus grid: green sums of square cells (8 bit scale) */
+	static constexpr unsigned int kAfGridMaxWidth = libcamera::mtkisp50::StatsBuffer::kMaxAfWidth;
+	static constexpr unsigned int kAfGridMaxHeight = 120;
+	unsigned int afGridWidth;
+	unsigned int afGridHeight;
+	bool afGridValid;
+	/* Frame without statistics on purpose (longer interval) */
+	uint32_t skippedFrame;
+	uint32_t afGridFrame;
+	unsigned int afCellSize;
+	unsigned int afCellSamples;
+	std::array<uint32_t, kAfGridMaxWidth * kAfGridMaxHeight> afGrid;
+
+	/*
+	 * Update the view with the buffer of a frame. Like the statistics of
+	 * the software ISP, fields of a part that is not valid for the frame
+	 * keep the values of the last frame that had it; valid and
+	 * afGridValid tell what belongs to this frame. Returns false if the
+	 * buffer is not usable (wrong version or frame).
+	 */
+	bool parse(const libcamera::mtkisp50::StatsBuffer &buffer, uint32_t frameId);
+};
+
+} /* namespace ipa::mtkisp50 */
+
+} /* namespace libcamera */
diff --git a/src/libcamera/pipeline/mtkisp50/frames.cpp b/src/libcamera/pipeline/mtkisp50/frames.cpp
new file mode 100644
index 0000000..6efd5f2
--- /dev/null
+++ b/src/libcamera/pipeline/mtkisp50/frames.cpp
@@ -0,0 +1,341 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Per request bookkeeping of the mtkisp50 pipeline
+ */
+
+#include "frames.h"
+
+#include <algorithm>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/framebuffer.h>
+
+namespace libcamera {
+
+LOG_DECLARE_CATEGORY(MtkIsp50)
+
+MtkIsp50Frames::MtkIsp50Frames()
+{
+}
+
+void MtkIsp50Frames::init(const std::vector<std::unique_ptr<FrameBuffer>> &paramsBuffers,
+			  const std::vector<std::unique_ptr<FrameBuffer>> &statsBuffers)
+{
+	for (const std::unique_ptr<FrameBuffer> &buffer : paramsBuffers)
+		availableParamsBuffers_.push(buffer.get());
+
+	for (const std::unique_ptr<FrameBuffer> &buffer : statsBuffers)
+		availableStatsBuffers_.push(buffer.get());
+
+	frameInfo_.clear();
+}
+
+void MtkIsp50Frames::clear()
+{
+	availableParamsBuffers_ = {};
+	availableStatsBuffers_ = {};
+	frameInfo_.clear();
+
+	ispOutputs_ = ~0u;
+	ispBusy_ = 0;
+	ispWaiting_.clear();
+	ispHeld_ = false;
+}
+
+MtkIsp50Frames::Info *MtkIsp50Frames::create(unsigned int id, Request *request,
+					     FrameBuffer *rawBuffer, bool rawFromRequest,
+					     FrameBuffer *outputBuffer, FrameBuffer *scaledBuffer)
+{
+	if (availableParamsBuffers_.empty()) {
+		LOG(MtkIsp50, Error) << "Parameters buffer underrun";
+		return nullptr;
+	}
+
+	if (availableStatsBuffers_.empty()) {
+		LOG(MtkIsp50, Error) << "Statistics buffer underrun";
+		return nullptr;
+	}
+
+	if (frameInfo_.count(id)) {
+		LOG(MtkIsp50, Error) << "Frame " << id << " already queued";
+		return nullptr;
+	}
+
+	auto info = std::make_unique<Info>();
+	info->id = id;
+	info->request = request;
+	info->rawBuffer = rawBuffer;
+	info->rawFromRequest = rawFromRequest;
+	info->outputBuffer = outputBuffer;
+	info->scaledBuffer = scaledBuffer;
+	info->paramsBuffer = availableParamsBuffers_.front();
+	info->statsBuffer = availableStatsBuffers_.front();
+	info->rawSequence = 0;
+	info->paramsBytesused = 0;
+	info->captured = false;
+	info->ispQueued = false;
+	info->outputQueued = false;
+	info->scaledQueued = false;
+	info->ispBack = false;
+	info->rawDone = false;
+	info->outputDone = !outputBuffer;
+	info->scaledDone = !scaledBuffer;
+	info->paramsDone = false;
+	info->metadataDone = false;
+	info->error = false;
+
+	availableParamsBuffers_.pop();
+	availableStatsBuffers_.pop();
+
+	Info *ret = info.get();
+	frameInfo_[id] = std::move(info);
+
+	return ret;
+}
+
+void MtkIsp50Frames::remove(Info *info)
+{
+	/* Return the buffers to the pools */
+	availableParamsBuffers_.push(info->paramsBuffer);
+	availableStatsBuffers_.push(info->statsBuffer);
+
+	auto it = std::find(ispWaiting_.begin(), ispWaiting_.end(), info);
+	if (it != ispWaiting_.end())
+		ispWaiting_.erase(it);
+
+	frameInfo_.erase(info->id);
+}
+
+int MtkIsp50Frames::queueIspJob(Info *info, uint32_t paramsBytesused,
+				MtkIsp50IspQueue &queue)
+{
+	/* Raw only: no job, the raw frame is done once captured */
+	if (!outputsOf(info)) {
+		info->rawDone = true;
+		info->paramsDone = true;
+		return 0;
+	}
+
+	int ret = queue.queueRaw(info->rawBuffer);
+	if (ret) {
+		/* Nothing queued, the queues stay matched */
+		info->rawDone = true;
+		info->paramsDone = true;
+		info->outputDone = true;
+		info->scaledDone = true;
+		info->error = true;
+		return ret;
+	}
+
+	/* The raw buffer is in the ISP now */
+	info->ispQueued = true;
+
+	/*
+	 * The params node never holds a job back: without a params buffer the
+	 * ISP keeps the values of the previous job.
+	 */
+	if (paramsBytesused) {
+		if (queue.queueParams(info->paramsBuffer, paramsBytesused)) {
+			LOG(MtkIsp50, Warning)
+				<< "Failed to queue the parameters of frame " << info->id;
+			info->paramsDone = true;
+		}
+	} else {
+		info->paramsDone = true;
+	}
+
+	if (info->outputBuffer) {
+		ret = queue.queueOutput(info->outputBuffer);
+		if (!ret)
+			info->outputQueued = true;
+	}
+
+	if (!ret && info->scaledBuffer) {
+		ret = queue.queueScaled(info->scaledBuffer);
+		if (!ret)
+			info->scaledQueued = true;
+	}
+
+	if (ret) {
+		/*
+		 * The job is queued in part: the caller restarts the ISP, which
+		 * returns the buffers in it
+		 */
+		if (!info->outputQueued)
+			info->outputDone = true;
+		if (!info->scaledQueued)
+			info->scaledDone = true;
+		info->error = true;
+		return ret;
+	}
+
+	return 0;
+}
+
+unsigned int MtkIsp50Frames::outputsOf(const Info *info)
+{
+	return (info->outputBuffer ? MtkIsp50OutputMain : 0) |
+	       (info->scaledBuffer ? MtkIsp50OutputScaled : 0);
+}
+
+void MtkIsp50Frames::startIsp(unsigned int outputs)
+{
+	ispOutputs_ = outputs;
+	ispBusy_ = 0;
+	ispWaiting_.clear();
+	ispHeld_ = false;
+}
+
+void MtkIsp50Frames::submitIspJob(Info *info, uint32_t paramsBytesused)
+{
+	info->paramsBytesused = paramsBytesused;
+
+	if (!outputsOf(info)) {
+		info->rawDone = true;
+		info->paramsDone = true;
+		return;
+	}
+
+	ispWaiting_.push_back(info);
+}
+
+int MtkIsp50Frames::runIspJobs(MtkIsp50IspQueue &queue, Info **failed)
+{
+	while (!ispHeld_ && !ispWaiting_.empty()) {
+		Info *info = ispWaiting_.front();
+		const unsigned int outputs = outputsOf(info);
+
+		if (outputs != ispOutputs_) {
+			if (ispBusy_)
+				return 0;
+
+			int ret = queue.setOutputs(outputs);
+			if (ret) {
+				/* The job cannot run, nothing of it is queued */
+				ispOutputs_ = ~0u;
+				ispWaiting_.pop_front();
+				info->rawDone = true;
+				info->paramsDone = true;
+				info->outputDone = true;
+				info->scaledDone = true;
+				info->error = true;
+				*failed = info;
+				return ret;
+			}
+
+			ispOutputs_ = outputs;
+		}
+
+		ispWaiting_.pop_front();
+
+		int ret = queueIspJob(info, info->paramsBytesused, queue);
+		if (info->ispQueued)
+			ispBusy_++;
+		if (ret) {
+			*failed = info;
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+bool MtkIsp50Frames::ispJobBack(Info *info)
+{
+	if (!info->ispQueued || info->ispBack || !info->rawDone ||
+	    !info->outputDone || !info->scaledDone)
+		return false;
+
+	info->ispBack = true;
+	if (ispBusy_)
+		ispBusy_--;
+
+	return true;
+}
+
+bool MtkIsp50Frames::tryComplete(Info *info)
+{
+	if (!info->rawDone || !info->outputDone || !info->scaledDone ||
+	    !info->paramsDone || !info->metadataDone)
+		return false;
+
+	remove(info);
+
+	return true;
+}
+
+MtkIsp50Frames::Info *MtkIsp50Frames::first()
+{
+	if (frameInfo_.empty())
+		return nullptr;
+
+	return frameInfo_.begin()->second.get();
+}
+
+MtkIsp50Frames::Info *MtkIsp50Frames::find(unsigned int id)
+{
+	const auto &itInfo = frameInfo_.find(id);
+
+	if (itInfo != frameInfo_.end())
+		return itInfo->second.get();
+
+	return nullptr;
+}
+
+MtkIsp50Frames::Info *MtkIsp50Frames::findCapture(const FrameBuffer *buffer)
+{
+	for (auto const &itInfo : frameInfo_) {
+		Info *info = itInfo.second.get();
+		if (info->rawBuffer == buffer && !info->captured)
+			return info;
+	}
+
+	return nullptr;
+}
+
+MtkIsp50Frames::Info *MtkIsp50Frames::findIspRaw(const FrameBuffer *buffer)
+{
+	for (auto const &itInfo : frameInfo_) {
+		Info *info = itInfo.second.get();
+		if (info->rawBuffer == buffer && info->ispQueued && !info->rawDone)
+			return info;
+	}
+
+	return nullptr;
+}
+
+MtkIsp50Frames::Info *MtkIsp50Frames::findOutput(const FrameBuffer *buffer)
+{
+	for (auto const &itInfo : frameInfo_) {
+		Info *info = itInfo.second.get();
+		if (info->outputBuffer == buffer && !info->outputDone)
+			return info;
+	}
+
+	return nullptr;
+}
+
+MtkIsp50Frames::Info *MtkIsp50Frames::findScaled(const FrameBuffer *buffer)
+{
+	for (auto const &itInfo : frameInfo_) {
+		Info *info = itInfo.second.get();
+		if (info->scaledBuffer == buffer && !info->scaledDone)
+			return info;
+	}
+
+	return nullptr;
+}
+
+MtkIsp50Frames::Info *MtkIsp50Frames::findParams(const FrameBuffer *buffer)
+{
+	for (auto const &itInfo : frameInfo_) {
+		Info *info = itInfo.second.get();
+		if (info->paramsBuffer == buffer && !info->paramsDone)
+			return info;
+	}
+
+	return nullptr;
+}
+
+} /* namespace libcamera */
diff --git a/src/libcamera/pipeline/mtkisp50/frames.h b/src/libcamera/pipeline/mtkisp50/frames.h
new file mode 100644
index 0000000..b733be1
--- /dev/null
+++ b/src/libcamera/pipeline/mtkisp50/frames.h
@@ -0,0 +1,159 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Per request bookkeeping of the mtkisp50 pipeline
+ */
+
+#pragma once
+
+#include <deque>
+#include <map>
+#include <memory>
+#include <queue>
+#include <stdint.h>
+#include <vector>
+
+namespace libcamera {
+
+class FrameBuffer;
+class Request;
+
+/* Processed outputs of the ISP, bits of a mask */
+constexpr unsigned int MtkIsp50OutputMain = 1 << 0;
+constexpr unsigned int MtkIsp50OutputScaled = 1 << 1;
+
+/*
+ * Queues of the memory-to-memory ISP. A job runs when a raw buffer and a
+ * buffer of every streaming output are queued; a params buffer that is
+ * queued before them belongs to the same job. An output that starts or
+ * stops streaming joins or leaves from the next job on.
+ */
+class MtkIsp50IspQueue
+{
+public:
+	virtual ~MtkIsp50IspQueue() = default;
+
+	virtual int queueRaw(FrameBuffer *buffer) = 0;
+	virtual int queueParams(FrameBuffer *buffer, uint32_t bytesused) = 0;
+	virtual int queueOutput(FrameBuffer *buffer) = 0;
+	virtual int queueScaled(FrameBuffer *buffer) = 0;
+	/* Stream exactly the outputs of the mask */
+	virtual int setOutputs(unsigned int outputs) = 0;
+};
+
+class MtkIsp50Frames
+{
+public:
+	struct Info {
+		unsigned int id;
+		Request *request;
+
+		/* Raw frame of the capture device, from the pool or the request */
+		FrameBuffer *rawBuffer;
+		bool rawFromRequest;
+		/* Processed outputs of the request, nullptr if not in it */
+		FrameBuffer *outputBuffer;
+		FrameBuffer *scaledBuffer;
+		FrameBuffer *paramsBuffer;
+		FrameBuffer *statsBuffer;
+
+		uint32_t rawSequence;
+		/* Size of the parameters of the ISP job, 0 for none */
+		uint32_t paramsBytesused;
+
+		/* Steps done */
+		bool captured;
+		/* The raw buffer was queued to the ISP */
+		bool ispQueued;
+		bool outputQueued;
+		bool scaledQueued;
+		/* All buffers of the ISP job are back */
+		bool ispBack;
+		bool rawDone;
+		bool outputDone;
+		bool scaledDone;
+		bool paramsDone;
+		bool metadataDone;
+		bool error;
+	};
+
+	MtkIsp50Frames();
+
+	void init(const std::vector<std::unique_ptr<FrameBuffer>> &paramsBuffers,
+		  const std::vector<std::unique_ptr<FrameBuffer>> &statsBuffers);
+	void clear();
+
+	/* nullptr if no params or statistics buffer is free */
+	Info *create(unsigned int id, Request *request, FrameBuffer *rawBuffer,
+		     bool rawFromRequest, FrameBuffer *outputBuffer,
+		     FrameBuffer *scaledBuffer = nullptr);
+	void remove(Info *info);
+
+	/*
+	 * Queue the ISP job of a frame: raw first (the only buffer the ISP
+	 * may refuse, an imported DMABUF), then params if bytesused > 0, then
+	 * the main and the scaled output. A frame without output has no job.
+	 * Returns 0 or the error of the first queue that failed; buffers not
+	 * queued are marked done (the caller cancels the outputs that are not
+	 * queued, and restarts the ISP if the raw buffer is in it).
+	 */
+	int queueIspJob(Info *info, uint32_t paramsBytesused, MtkIsp50IspQueue &queue);
+
+	/* Outputs the job of a frame writes */
+	static unsigned int outputsOf(const Info *info);
+
+	/*
+	 * Scheduling of the ISP jobs. Jobs go to the ISP in frame order. A
+	 * job whose outputs differ from the streaming ones waits until the
+	 * jobs in the ISP are back, then the outputs are switched: a job in
+	 * the ISP takes a buffer of every streaming output.
+	 */
+	void startIsp(unsigned int outputs);
+	/* A frame whose parameters are ready; frames without job are done */
+	void submitIspJob(Info *info, uint32_t paramsBytesused);
+	/*
+	 * Queue the waiting jobs that may go. Returns 0, or an error with the
+	 * frame that failed in @failed (call again for the others).
+	 */
+	int runIspJobs(MtkIsp50IspQueue &queue, Info **failed);
+	/* True if the buffers of the job of @info are all back just now */
+	bool ispJobBack(Info *info);
+	/* No jobs go while held (stop and restart of the ISP) */
+	void holdIsp(bool held) { ispHeld_ = held; }
+
+	size_t ispBusy() const { return ispBusy_; }
+	size_t ispWaiting() const { return ispWaiting_.size(); }
+	unsigned int ispOutputs() const { return ispOutputs_; }
+
+	/* True if everything of the frame is done; the frame is then removed */
+	bool tryComplete(Info *info);
+
+	/* Oldest frame, nullptr if none */
+	Info *first();
+	Info *find(unsigned int id);
+	/* Frame waiting for its raw buffer from the capture device */
+	Info *findCapture(const FrameBuffer *buffer);
+	/* Frame whose raw buffer is queued to the ISP */
+	Info *findIspRaw(const FrameBuffer *buffer);
+	Info *findOutput(const FrameBuffer *buffer);
+	Info *findScaled(const FrameBuffer *buffer);
+	Info *findParams(const FrameBuffer *buffer);
+
+	size_t size() const { return frameInfo_.size(); }
+	size_t freeParams() const { return availableParamsBuffers_.size(); }
+	size_t freeStats() const { return availableStatsBuffers_.size(); }
+
+private:
+	std::queue<FrameBuffer *> availableParamsBuffers_;
+	std::queue<FrameBuffer *> availableStatsBuffers_;
+
+	std::map<unsigned int, std::unique_ptr<Info>> frameInfo_;
+
+	/* Outputs that stream, all bits set if unknown */
+	unsigned int ispOutputs_ = ~0u;
+	/* Jobs in the ISP, and those waiting for it */
+	unsigned int ispBusy_ = 0;
+	std::deque<Info *> ispWaiting_;
+	bool ispHeld_ = false;
+};
+
+} /* namespace libcamera */
