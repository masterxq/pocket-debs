new file mode 100644
index 0000000..f9776f0
--- /dev/null
+++ b/src/ipa/mtkisp50/algorithms/agc.cpp
@@ -0,0 +1,1359 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2024, Red Hat Inc.
+ *
+ * Exposure and gain
+ */
+
+#include "agc.h"
+
+#include <algorithm>
+#include <cmath>
+#include <errno.h>
+#include <stdint.h>
+#include <string>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/log.h>
+
+#include "control_ids.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPAMtkIsp50Exposure)
+
+/* Relative step of the total exposure that still counts as settled (AeState) */
+static constexpr double kSettledStep = 0.04;
+
+namespace ipa::mtkisp50::algorithms {
+
+/*
+ * The number of bins to use for the optimal exposure calculations.
+ */
+static constexpr unsigned int kExposureBinsCount = 5;
+
+/*
+ * The exposure is optimal when the mean sample value of the histogram is
+ * in the middle of the range.
+ */
+static constexpr float kExposureOptimal = kExposureBinsCount / 2.0;
+
+/*
+ * This implements the hysteresis for the exposure adjustment.
+ * It is small enough to have the exposure close to the optimal, and is big
+ * enough to prevent the exposure from wobbling around the optimal value.
+ */
+static constexpr float kExposureSatisfactory = 0.2;
+
+/*
+ * Proportional gain for exposure/gain adjustment. Maps the MSV error to a
+ * multiplicative correction factor:
+ *
+ *   factor = 1.0 + kExpProportionalGain * error
+ *
+ * With kExpProportionalGain = 0.04:
+ *   - max error ~2.5 -> factor 1.10 (~10% step, same as before)
+ *   - error 1.0      -> factor 1.04 (~4% step)
+ *   - error 0.3      -> factor 1.012 (~1.2% step)
+ *
+ * This replaces the fixed 10% bang-bang step with a proportional correction
+ * that converges smoothly and avoids overshooting near the target.
+ */
+static constexpr float kExpProportionalGain = 0.04;
+
+/*
+ * Maximum multiplicative step per frame, to bound the correction when the
+ * scene changes dramatically.
+ */
+static constexpr float kExpMaxStep = 0.15;
+
+/* Largest step per statistics frame with exposureSpeed, in stops */
+static constexpr double kMaxExposureStep = 2.0;
+
+Agc::Agc()
+	: proportionalGain_(kExpProportionalGain), maxStep_(kExpMaxStep),
+	  maxExposureFactor_(1.0), maxDigitalGain_(1.0),
+	  maxExposureStep_(kMaxExposureStep), meterLow_(0.0), meterHigh_(1.0),
+	  tolerance_(kExposureSatisfactory)
+{
+}
+
+/**
+ * \brief Read the optional tuning parameters
+ *
+ * - proportionalGain, maxStep: the proportional gain and the largest relative
+ *   step per statistics frame (defaults kExpProportionalGain, kExpMaxStep)
+ * - minGainStep: smallest gain step, relative to the minimum gain (default
+ *   one hundredth of the gain range)
+ * - maxExposureFactor: how far the exposure may grow beyond the limit of the
+ *   default frame length by raising VBLANK (default 1.0, no extension)
+ * - extensionGain: gain, relative to the minimum gain, from which on the frame
+ *   length is extended (default the maximum gain)
+ * - exposureTarget: regulate the mean of the luminance histogram above the
+ *   black level, as a fraction of the range above it (0.0 to 1.0, a linear
+ *   value, e.g. 0.18), instead of the mean sample value of five bins. The
+ *   error is then expressed in half stops, 2 * log2(target / mean), so that
+ *   the proportional step and the hysteresis keep their meaning (one stop is
+ *   an error of 2, the hysteresis is a tenth of a stop).
+ * - afFrameRate: while the autofocus waits for a steady scene or searches,
+ *   keep the frame rate of the default frame length: an extended exposure is
+ *   traded for analogue gain (same brightness), and taken back afterwards
+ *   (default false)
+ * - maxDigitalGain: with exposureTarget, the largest digital gain applied
+ *   once exposure time and analogue gain are at their limits (default 1.0,
+ *   none). It multiplies the colour gains of the debayer parameters, so Agc
+ *   has to come after Awb in the tuning file. The statistics are taken before
+ *   it, the regulation accounts for it.
+ * - meteringRange: with exposureTarget, [low, high] quantiles of the samples
+ *   above the black level whose mean is regulated (default [0.0, 1.0], all
+ *   samples). A high quantile below 1.0 leaves light sources and windows out
+ *   of the mean, so that they do not darken the rest of the image.
+ * - exposureSpeed: with exposureTarget, the fraction of the error in stops
+ *   corrected per statistics frame (0.0 to 1.0). The correction is then a
+ *   factor 2^(speed * error) limited to maxExposureStep stops (default 2.0),
+ *   instead of the proportional step limited by maxStep. This reaches the
+ *   target after a large change of light in a few statistics frames.
+ * - exposureTolerance: with exposureTarget, the dead band around the target
+ *   in stops within which nothing is changed (default 0.1).
+ * - program: exposure programs (see ExposureProgram), "preview", and
+ *   optionally "video" and "still": lists of [exposure time in us, largest
+ *   total gain]. With a program and zone metering the regulation works on
+ *   the total exposure and splits it with the program of the use of the
+ *   session (video for a video session, preview otherwise); a frame for a
+ *   still image of a session with still images takes the digital gain the
+ *   still program allows beyond the preview. The stages beyond the longest
+ *   exposure of the moment (frame durations, autofocus) are left out. The
+ *   digital gain reaches the largest total gain of the program over the
+ *   largest analogue gain. maxExposureFactor still sets the frame length
+ *   extension, extensionGain and the cascade do not apply. Optionally
+ *   "handheld": [time in us, total gain], the exposure time of the preview
+ *   and still programs stays at most this time up to this total gain, the
+ *   stages beyond take over in darker scenes (see ExposureProgram::limited()).
+ *   For images taken by hand: a long exposure blurs them with the shake of
+ *   the hand, the gain instead adds noise, which the multi-frame still image
+ *   takes out in part. The frames of a still image have the exposure of the
+ *   preview, so the preview has the same limit.
+ * - fNumber: for the brightness of the scene (BV = log2(fNumber^2 / time) -
+ *   log2(gain) - 5 + log2(level / exposureTarget), ISO 100 at gain 1.0;
+ *   default 2.0)
+ * - targetCurve (with a program): {bv: [...], stops: [...]}, the target in
+ *   stops over exposureTarget against the brightness of the scene, linear in
+ *   between, held beyond the ends
+ * - highlight (with a program): {fraction, bv, limit, strength, maxStops}.
+ *   The mean of the brightest fraction (default 0.01) of the luminance
+ *   histogram, relative to the metered mean and taken to the target, should
+ *   not exceed limit/255 (over bv, as targetCurve). Above, the target comes
+ *   down by strength / (1 + strength) of the excess in stops, at most
+ *   maxStops: light sources in the image darken it in part.
+ * - metering: with exposureTarget, "histogram" (default, the mean of the
+ *   luminance histogram as above) or "zones": a weighted mean over a 5x5 grid
+ *   of zones over the statistics window. Per zone the channel means above the
+ *   black level are normalised to the range above it, multiplied by the
+ *   colour gains of Awb (colourGains, default true), limited to 1.0 and
+ *   combined with channelWeights (default 77, 150, 29, the weights of the
+ *   statistics histogram); the zones are combined with zoneWeights (25
+ *   values row by row, default all equal). The regulated value is this mean
+ *   times the digital gain, meteringRange does not apply.
+ */
+int Agc::init(IPAContext &context, const ValueNode &tuningData)
+{
+	proportionalGain_ = tuningData["proportionalGain"].get<float>(kExpProportionalGain);
+	maxStep_ = tuningData["maxStep"].get<float>(kExpMaxStep);
+	minGainStep_ = tuningData["minGainStep"].get<double>();
+	maxExposureFactor_ = tuningData["maxExposureFactor"].get<double>(1.0);
+	extensionGain_ = tuningData["extensionGain"].get<double>();
+	exposureTarget_ = tuningData["exposureTarget"].get<double>();
+	maxDigitalGain_ = tuningData["maxDigitalGain"].get<double>(1.0);
+	afFrameRate_ = tuningData["afFrameRate"].get<bool>(false);
+	exposureSpeed_ = tuningData["exposureSpeed"].get<double>();
+	maxExposureStep_ = tuningData["maxExposureStep"].get<double>(kMaxExposureStep);
+	if (exposureTarget_ && tuningData.contains("exposureTolerance")) {
+		const double stops = tuningData["exposureTolerance"].get<double>(0.0);
+		if (!(stops >= 0.01 && stops <= 1.0)) {
+			LOG(IPAMtkIsp50Exposure, Error) << "Invalid Agc exposureTolerance";
+			return -EINVAL;
+		}
+		/* The error is in half stops */
+		tolerance_ = 2.0 * stops;
+	}
+
+	const std::string metering = tuningData["metering"].get<std::string>("histogram");
+	if (metering == "zones") {
+		zoneMetering_ = true;
+	} else if (metering != "histogram") {
+		LOG(IPAMtkIsp50Exposure, Error) << "Unknown Agc metering " << metering;
+		return -EINVAL;
+	}
+
+	if (tuningData.contains("channelWeights")) {
+		auto w = tuningData["channelWeights"].get<std::vector<double>>();
+		if (!w || w->size() != 3 || !((*w)[0] >= 0 && (*w)[1] >= 0 && (*w)[2] >= 0) ||
+		    (*w)[0] + (*w)[1] + (*w)[2] <= 0.0) {
+			LOG(IPAMtkIsp50Exposure, Error) << "Invalid Agc channelWeights";
+			return -EINVAL;
+		}
+		channelWeights_ = { (*w)[0], (*w)[1], (*w)[2] };
+	}
+
+	if (tuningData.contains("zoneWeights")) {
+		auto w = tuningData["zoneWeights"].get<std::vector<double>>();
+		double total = 0.0;
+		if (w && w->size() == kMeteringZones * kMeteringZones) {
+			for (double v : *w)
+				total += v >= 0.0 ? v : -1e9;
+		}
+		if (!w || !(total > 0.0)) {
+			LOG(IPAMtkIsp50Exposure, Error) << "Invalid Agc zoneWeights (25 values, not negative)";
+			return -EINVAL;
+		}
+		std::copy(w->begin(), w->end(), zoneWeights_.begin());
+	}
+
+	useColourGains_ = tuningData["colourGains"].get<bool>(true);
+	fNumber_ = tuningData["fNumber"].get<double>(2.0);
+
+	if (tuningData.contains("program")) {
+		const ValueNode &prog = tuningData["program"];
+		static constexpr const char *names[] = { "preview", "video", "still" };
+		for (unsigned int i = 0; i < 3; i++) {
+			if (!prog.contains(names[i]))
+				continue;
+			programs_[i] = ExposureProgram::fromTuning(prog[names[i]]);
+			if (!programs_[i])
+				return -EINVAL;
+		}
+		if (!programs_[0]) {
+			LOG(IPAMtkIsp50Exposure, Error) << "Agc program needs a preview program";
+			return -EINVAL;
+		}
+
+		/* The exposure time for images taken by hand (preview and still) */
+		if (prog.contains("handheld")) {
+			auto v = prog["handheld"].get<std::vector<double>>();
+			if (!v || v->size() != 2 || !((*v)[0] > 0.0) || !((*v)[1] >= 1.0)) {
+				LOG(IPAMtkIsp50Exposure, Error) << "Agc program handheld is not [time, gain]";
+				return -EINVAL;
+			}
+			for (unsigned int i : { 0u, 2u }) {
+				if (!programs_[i])
+					continue;
+				programs_[i] = programs_[i]->limited((*v)[0], (*v)[1]);
+				if (!programs_[i]) {
+					LOG(IPAMtkIsp50Exposure, Error) << "Invalid Agc program handheld";
+					return -EINVAL;
+				}
+			}
+			LOG(IPAMtkIsp50Exposure, Info)
+				<< "Exposure held at " << (*v)[0] << " us up to a total gain of " << (*v)[1];
+		}
+	}
+
+	auto curve = [&](const ValueNode &node, const char *xKey, const char *yKey,
+			 std::vector<double> &x, std::vector<double> &y) {
+		auto vx = node[xKey].get<std::vector<double>>();
+		auto vy = node[yKey].get<std::vector<double>>();
+		if (!vx || !vy || vx->empty() || vx->size() != vy->size())
+			return false;
+		for (unsigned int i = 1; i < vx->size(); i++) {
+			if (!((*vx)[i] > (*vx)[i - 1]))
+				return false;
+		}
+		x = *vx;
+		y = *vy;
+		return true;
+	};
+	if (tuningData.contains("targetCurve") &&
+	    !curve(tuningData["targetCurve"], "bv", "stops", targetBv_, targetStops_)) {
+		LOG(IPAMtkIsp50Exposure, Error) << "Invalid Agc targetCurve";
+		return -EINVAL;
+	}
+	if (tuningData.contains("highlight")) {
+		const ValueNode &h = tuningData["highlight"];
+		highlightFraction_ = h["fraction"].get<double>(0.01);
+		highlightStrength_ = h["strength"].get<double>(1.0);
+		highlightMaxStops_ = h["maxStops"].get<double>(1.0);
+		if (!curve(h, "bv", "limit", highlightBv_, highlightLimit_) ||
+		    !(highlightFraction_ > 0.0 && highlightFraction_ < 0.5) ||
+		    !(highlightStrength_ >= 0.0) || !(highlightMaxStops_ >= 0.0 && highlightMaxStops_ <= 4.0)) {
+			LOG(IPAMtkIsp50Exposure, Error) << "Invalid Agc highlight";
+			return -EINVAL;
+		}
+	}
+	tunedWeights_ = zoneWeights_;
+
+	/*
+	 * Measurement of the zone metering after the lens shading correction
+	 * (the gains of the LensShadingCorrection algorithm at the zone
+	 * centres), scaled by meteringScale.
+	 */
+	meteringShading_ = tuningData["meteringShading"].get<bool>(false);
+	meteringScale_ = tuningData["meteringScale"].get<double>(1.0);
+	if (!(meteringScale_ > 0.0 && meteringScale_ < 4.0)) {
+		LOG(IPAMtkIsp50Exposure, Error) << "Invalid Agc meteringScale";
+		return -EINVAL;
+	}
+
+	context.ctrlMap[&controls::AeEnable] = ControlInfo(false, true, true);
+	context.ctrlMap[&controls::ExposureTimeMode] =
+		ControlInfo(std::vector<ControlValue>{ ControlValue(static_cast<int32_t>(controls::ExposureTimeModeAuto)),
+			      ControlValue(static_cast<int32_t>(controls::ExposureTimeModeManual)) },
+			    ControlValue(static_cast<int32_t>(controls::ExposureTimeModeAuto)));
+	context.ctrlMap[&controls::AnalogueGainMode] =
+		ControlInfo(std::vector<ControlValue>{ ControlValue(static_cast<int32_t>(controls::AnalogueGainModeAuto)),
+			      ControlValue(static_cast<int32_t>(controls::AnalogueGainModeManual)) },
+			    ControlValue(static_cast<int32_t>(controls::AnalogueGainModeAuto)));
+	/* Ranges of the sensor mode follow with configure() */
+	context.ctrlMap[&controls::ExposureTime] = ControlInfo(1, 1000000, 10000);
+	context.ctrlMap[&controls::AnalogueGain] = ControlInfo(1.0f, 16.0f, 1.0f);
+	context.ctrlMap[&controls::FrameDurationLimits] =
+		ControlInfo(int64_t(33333), int64_t(1000000),
+			    Span<const int64_t, 2>{ { int64_t(33333), int64_t(1000000) } });
+	if (exposureTarget_)
+		context.ctrlMap[&controls::ExposureValue] = ControlInfo(-8.0f, 8.0f, 0.0f);
+	if (zoneMetering_)
+		context.ctrlMap[&controls::AeMeteringMode] =
+			ControlInfo(std::vector<ControlValue>{ ControlValue(static_cast<int32_t>(controls::MeteringCentreWeighted)),
+				      ControlValue(static_cast<int32_t>(controls::MeteringSpot)),
+				      ControlValue(static_cast<int32_t>(controls::MeteringMatrix)) },
+				    ControlValue(static_cast<int32_t>(controls::MeteringCentreWeighted)));
+
+	auto range = tuningData["meteringRange"].get<std::vector<double>>();
+	if (range) {
+		if (range->size() != 2 || !((*range)[0] >= 0.0 && (*range)[0] < (*range)[1] &&
+					    (*range)[1] <= 1.0)) {
+			LOG(IPAMtkIsp50Exposure, Error) << "Invalid Agc meteringRange";
+			return -EINVAL;
+		}
+		meterLow_ = (*range)[0];
+		meterHigh_ = (*range)[1];
+	}
+
+	if (proportionalGain_ <= 0.0f || maxStep_ <= 0.0f || maxStep_ >= 1.0f ||
+	    maxExposureFactor_ < 1.0 ||
+	    (minGainStep_ && *minGainStep_ <= 0.0) ||
+	    (extensionGain_ && *extensionGain_ < 1.0) ||
+	    (exposureTarget_ && (*exposureTarget_ <= 0.0 || *exposureTarget_ >= 1.0)) ||
+	    !(maxDigitalGain_ >= 1.0 && maxDigitalGain_ <= 64.0) ||
+	    (exposureSpeed_ && !(*exposureSpeed_ > 0.0 && *exposureSpeed_ <= 1.0)) ||
+	    !(maxExposureStep_ > 0.0 && maxExposureStep_ <= 4.0)) {
+		LOG(IPAMtkIsp50Exposure, Error) << "Invalid Agc tuning parameters";
+		return -EINVAL;
+	}
+
+	if (maxDigitalGain_ > 1.0 && !exposureTarget_) {
+		LOG(IPAMtkIsp50Exposure, Warning)
+			<< "Agc maxDigitalGain needs exposureTarget, ignored";
+		maxDigitalGain_ = 1.0;
+	}
+
+	if (programs_[0] && (!zoneMetering_ || !exposureSpeed_)) {
+		LOG(IPAMtkIsp50Exposure, Error) << "Agc program needs zone metering and exposureSpeed";
+		return -EINVAL;
+	}
+
+	if (zoneMetering_ && !exposureTarget_) {
+		LOG(IPAMtkIsp50Exposure, Error) << "Agc zone metering needs exposureTarget";
+		return -EINVAL;
+	}
+
+	if ((exposureSpeed_ || range) && !exposureTarget_) {
+		LOG(IPAMtkIsp50Exposure, Warning)
+			<< "Agc exposureSpeed and meteringRange need exposureTarget, ignored";
+		exposureSpeed_.reset();
+		meterLow_ = 0.0;
+		meterHigh_ = 1.0;
+	}
+
+	return 0;
+}
+
+int Agc::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+	auto &agc = context.configuration.agc;
+
+	if (minGainStep_)
+		agc.againMinStep = *minGainStep_ * agc.againMin;
+
+	context.activeState.agc.digitalGain = 1.0;
+	context.activeState.agc.converging = true;
+	context.activeState.agc.levelRatio = 1.0;
+	total_ = 0.0;
+	highlightStops_ = 0.0;
+	useCase_ = configInfo.useCase == UseCase::Video ? 1 : configInfo.useCase == UseCase::Still ? 2 : 0;
+
+	agc.exposureMaxExtended = agc.exposureMax;
+	agc.extensionGain = agc.againMax;
+	agc.vblankEnabled = false;
+	agc.frame = {};
+	agc.frame.defaultLines = static_cast<int32_t>(context.sensorInfo.minFrameLength);
+	agc.frame.exposureMax = agc.exposureMax;
+
+	const auto it = configInfo.sensorControls.find(V4L2_CID_VBLANK);
+	if (maxExposureFactor_ > 1.0 && it != configInfo.sensorControls.end()) {
+		const int32_t vblankDef = it->second.def().get<int32_t>();
+		const int32_t vblankMax = it->second.max().get<int32_t>();
+		agc.frame.vblankDefault = vblankDef;
+
+		const int32_t limit = agc.frame.exposureWithin(agc.frame.defaultLines +
+							       vblankMax - vblankDef);
+		const int64_t wanted = agc.exposureMax * maxExposureFactor_;
+
+		agc.exposureMaxExtended = static_cast<int32_t>(std::min<int64_t>(wanted, limit));
+		if (agc.exposureMaxExtended > agc.exposureMax) {
+			agc.vblankEnabled = true;
+			if (extensionGain_)
+				agc.extensionGain = std::clamp(*extensionGain_ * agc.againMin,
+							       agc.againMin, agc.againMax);
+		} else {
+			agc.exposureMaxExtended = agc.exposureMax;
+		}
+	}
+
+	/* The frame durations of the application carry over a configuration */
+	updateFrameLimits(context);
+
+	/*
+	 * Ranges in this sensor mode: the exposure up to the extended frame
+	 * length, the frame duration from the default frame length to the
+	 * one of the longest exposure (without extension the default).
+	 */
+	const utils::Duration line = agc.lineDuration;
+	const int32_t minUs = static_cast<int32_t>(utils::Duration(line * agc.exposureMin).get<std::micro>());
+	const int32_t maxUs = static_cast<int32_t>(utils::Duration(line * agc.exposureMaxExtended).get<std::micro>());
+	context.ctrlMap[&controls::ExposureTime] = ControlInfo(minUs, maxUs, std::clamp(10000, minUs, maxUs));
+	context.ctrlMap[&controls::AnalogueGain] =
+		ControlInfo(static_cast<float>(agc.againMin), static_cast<float>(agc.againMax), 1.0f);
+	if (agc.frame.defaultLines > 0 && line > utils::Duration(0)) {
+		const int64_t minFrame = static_cast<int64_t>(
+			utils::Duration(line * agc.frame.defaultLines).get<std::micro>());
+		const int64_t maxFrame = static_cast<int64_t>(
+			utils::Duration(line * agc.frame.linesFor(agc.exposureMaxExtended)).get<std::micro>());
+		context.ctrlMap[&controls::FrameDurationLimits] =
+			ControlInfo(minFrame, maxFrame, Span<const int64_t, 2>{ { minFrame, maxFrame } });
+	}
+
+	LOG(IPAMtkIsp50Exposure, Info)
+		<< "Agc: step " << proportionalGain_ << "/" << maxStep_
+		<< ", min gain step " << agc.againMinStep
+		<< ", exposure up to " << agc.exposureMaxExtended
+		<< " (" << agc.exposureMax << " at the default frame length)"
+		<< ", extension from gain " << agc.extensionGain
+		<< (exposureTarget_ ? ", mean target " + std::to_string(*exposureTarget_)
+				    : std::string(", MSV target"))
+		<< ", digital gain up to " << maxDigitalGain_
+		<< (exposureSpeed_ ? ", speed " + std::to_string(*exposureSpeed_) +
+					     " up to " + std::to_string(maxExposureStep_) + " stops"
+				   : std::string())
+		<< (zoneMetering_ ? std::string(", zone metering") : std::string())
+		<< (meterHigh_ < 1.0 || meterLow_ > 0.0
+			    ? ", metering quantiles " + std::to_string(meterLow_) + "-" +
+				      std::to_string(meterHigh_)
+			    : std::string());
+
+	return 0;
+}
+
+/*
+ * Correction factor for an error in half stops. The sign of the error
+ * determines the direction: positive error means too dark (increase),
+ * negative means too bright (decrease).
+ */
+double Agc::stepFactor(double error) const
+{
+	if (exposureSpeed_) {
+		const double stops = std::clamp(*exposureSpeed_ * error / 2.0,
+						-maxExposureStep_, maxExposureStep_);
+		return std::exp2(stops);
+	}
+
+	/* Proportional correction */
+	const float step = std::clamp(static_cast<float>(error) * proportionalGain_,
+				      -maxStep_, maxStep_);
+	return 1.0 + step;
+}
+
+/*
+ * Mean of the histogram bins from \a first on, between the quantiles of the
+ * metering range, at the bin centres, relative to the range above \a first
+ */
+double Agc::meteredMean(const Statistics::Histogram &histogram, unsigned int first) const
+{
+	const unsigned int size = Statistics::kYHistogramSize - first;
+	uint64_t total = 0;
+
+	for (unsigned int i = first; i < Statistics::kYHistogramSize; i++)
+		total += histogram[i];
+	if (!total)
+		return -1.0;
+
+	const double low = meterLow_ * total;
+	const double high = meterHigh_ * total;
+	double sum = 0.0;
+	double count = 0.0;
+	double cumulative = 0.0;
+
+	for (unsigned int i = 0; i < size; i++) {
+		const double n = histogram[first + i];
+		const double weight = std::min(high, cumulative + n) - std::max(low, cumulative);
+
+		cumulative += n;
+		if (weight <= 0.0)
+			continue;
+
+		sum += weight * (i + 0.5);
+		count += weight;
+	}
+
+	return count > 0.0 ? sum / count / size : -1.0;
+}
+
+/*
+ * Weighted mean of the metering zones: each metering zone combines 3x3 zones
+ * of the statistics grid. Returns -1 without usable statistics.
+ */
+double Agc::zoneMean(const IPAContext &context, const Statistics *stats) const
+{
+	static_assert(Statistics::kZones == 3 * kMeteringZones);
+
+	const double black = context.activeState.blc.level;
+	const double range = 255.0 - black;
+	const RGB<float> &gains = context.activeState.awb.gains;
+	const double channelTotal = channelWeights_[0] + channelWeights_[1] + channelWeights_[2];
+	double sum = 0.0;
+	double weights = 0.0;
+
+	for (unsigned int my = 0; my < kMeteringZones; my++) {
+		for (unsigned int mx = 0; mx < kMeteringZones; mx++) {
+			RGB<double> zone({ 0.0, 0.0, 0.0 });
+			uint64_t count = 0;
+
+			for (unsigned int y = 3 * my; y < 3 * my + 3; y++) {
+				for (unsigned int x = 3 * mx; x < 3 * mx + 3; x++) {
+					const unsigned int i = y * Statistics::kZones + x;
+					for (unsigned int c = 0; c < 3; c++)
+						zone[c] += stats->zoneSum[i][c];
+					count += stats->zoneCount[i];
+				}
+			}
+
+			const double w = zoneWeights_[my * kMeteringZones + mx];
+			if (!count || !(w > 0.0) || !(range > 0.0))
+				continue;
+
+			/* Gain of the lens shading correction at the block centre */
+			const RGB<double> shading = meteringShading_
+				? shadingGain(context, (mx + 0.5) / kMeteringZones,
+					      (my + 0.5) / kMeteringZones)
+				: RGB<double>({ 1.0, 1.0, 1.0 });
+
+			double y = 0.0;
+			for (unsigned int c = 0; c < 3; c++) {
+				double x = std::max(zone[c] / count - black, 0.0) / range * shading[c];
+				if (useColourGains_)
+					x *= gains[c];
+				y += channelWeights_[c] * std::min(x, 1.0);
+			}
+
+			sum += w * meteringScale_ * y / channelTotal;
+			weights += w;
+		}
+	}
+
+	return weights > 0.0 ? sum / weights : -1.0;
+}
+
+/*
+ * Gain of the lens shading correction at a point given as a fraction of the
+ * statistics window: bilinear between the corners of the grid of the DIP,
+ * which lie at 2 * (W / 32) * i over the raw frame (the last one at W). R, G
+ * (mean of the two greens) and B.
+ */
+RGB<double> Agc::shadingGain(const IPAContext &context, double fx, double fy) const
+{
+	const auto &lsc = context.dip.lensShading;
+	const Size &raw = context.configuration.rawSize;
+	const Rectangle &win = context.configuration.statsWindow;
+	if (!lsc || raw.isNull() || win.isNull())
+		return RGB<double>({ 1.0, 1.0, 1.0 });
+
+	constexpr unsigned int n = LensShading::kGridPoints;
+	auto position = [](double v, unsigned int size, unsigned int &i, double &f) {
+		const double step = 2.0 * (size / 32);
+		const double last = step * (n - 2);
+		if (v < last) {
+			i = std::min<unsigned int>(static_cast<unsigned int>(v / step), n - 2);
+			f = (v - i * step) / step;
+		} else {
+			i = n - 2;
+			f = std::clamp((v - last) / (size - last), 0.0, 1.0);
+		}
+	};
+
+	unsigned int ix, iy;
+	double tx, ty;
+	position(win.x + fx * win.width, raw.width, ix, tx);
+	position(win.y + fy * win.height, raw.height, iy, ty);
+
+	auto at = [&](unsigned int c) {
+		const auto &g = lsc->gain[c];
+		const double top = g[iy * n + ix] * (1.0 - tx) + g[iy * n + ix + 1] * tx;
+		const double bottom = g[(iy + 1) * n + ix] * (1.0 - tx) + g[(iy + 1) * n + ix + 1] * tx;
+		return top * (1.0 - ty) + bottom * ty;
+	};
+
+	return RGB<double>({ at(LensShading::R), (at(LensShading::Gr) + at(LensShading::Gb)) / 2.0,
+			     at(LensShading::B) });
+}
+
+/*
+ * Limits from the frame durations of the application (FrameDurationLimits):
+ * the longest exposure whose frame fits into the longest frame duration,
+ * within the frame length extension, and the shortest frame length (only
+ * with VBLANK control, not beyond the longest frame).
+ */
+void Agc::updateFrameLimits(IPAContext &context) const
+{
+	const auto &agc = context.configuration.agc;
+	auto &state = context.activeState.agc;
+
+	state.exposureLimit = agc.exposureMaxExtended;
+	state.minFrameLines = 0;
+	if (agc.lineDuration <= utils::Duration(0))
+		return;
+
+	int32_t maxLines = agc.frame.linesFor(agc.exposureMaxExtended);
+	if (maxFrameDuration_) {
+		const double lines = *maxFrameDuration_ / agc.lineDuration;
+		maxLines = std::min<int32_t>(maxLines, static_cast<int32_t>(std::floor(lines)));
+		state.exposureLimit = std::clamp(agc.frame.exposureWithin(maxLines),
+						 agc.exposureMin, agc.exposureMaxExtended);
+	}
+
+	if (minFrameDuration_ && agc.vblankEnabled) {
+		const double wanted = std::ceil(*minFrameDuration_ / agc.lineDuration);
+		const int32_t lines = std::min<int32_t>(static_cast<int32_t>(wanted), maxLines);
+		/* VBLANK steps; down, so that the frame stays within the longest */
+		const int32_t extra = (lines - agc.frame.defaultLines) /
+				      FrameLength::kVblankStep * FrameLength::kVblankStep;
+		if (extra > 0)
+			state.minFrameLines = agc.frame.defaultLines + extra;
+	}
+}
+
+/*
+ * Longest exposure for the regulation: the limit of the frame durations, and
+ * no further frame length extension while the autofocus searches.
+ */
+int32_t Agc::exposureLimit(const IPAContext &context, int32_t exposure) const
+{
+	const auto &agc = context.configuration.agc;
+	int32_t limit = std::max(context.activeState.agc.exposureLimit, agc.exposureMin);
+
+	if (afFrameRate_ && context.activeState.af.busy)
+		limit = std::min(limit, std::max(agc.exposureMax, exposure));
+
+	return limit;
+}
+
+/*
+ * An exposure beyond the limit (a shorter longest frame duration of the
+ * application) goes over to the analogue gain, as far as it reaches.
+ */
+void Agc::fitExposure(const IPAContext &context, int32_t &exposure, double &again,
+		      int32_t limit) const
+{
+	const auto &agc = context.configuration.agc;
+
+	if (exposure <= limit || limit <= 0)
+		return;
+
+	if (!manualGain_ && again > 0.0)
+		again = std::min(again * exposure / limit, agc.againMax);
+	exposure = limit;
+}
+
+/*
+ * Manual exposure time or gain take the place of the regulated ones; the
+ * exposure follows the frame duration limit.
+ */
+void Agc::applyManual(IPAContext &context, IPAFrameContext &frameContext)
+{
+	const auto &agc = context.configuration.agc;
+
+	if (manualExposure_ && exposureLines_)
+		frameContext.sensor.exposure = *exposureLines_;
+	if (manualGain_ && gainValue_)
+		frameContext.sensor.gain = *gainValue_;
+	if (manualExposure_ && manualGain_)
+		context.activeState.agc.digitalGain = 1.0;
+
+	frameContext.sensor.exposure = std::clamp(frameContext.sensor.exposure, agc.exposureMin,
+						  std::max(context.activeState.agc.exposureLimit,
+							   agc.exposureMin));
+	frameContext.sensor.gain = std::clamp(frameContext.sensor.gain, agc.againMin, agc.againMax);
+
+	context.activeState.agc.exposure = frameContext.sensor.exposure;
+	context.activeState.agc.again = frameContext.sensor.gain;
+}
+
+/*
+ * Regulate, and record whether anything changed: no change means the level is
+ * within the hysteresis or the regulation is at its limits, other algorithms
+ * (autofocus) may then rely on a steady level.
+ */
+void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext, double error)
+{
+	const int32_t exposure = frameContext.sensor.exposure;
+	const double again = frameContext.sensor.gain;
+	const double digitalGain = context.activeState.agc.digitalGain;
+
+	/* ExposureValue: the target in stops, the error is in half stops */
+	if (exposureTarget_)
+		error += 2.0 * exposureValue_;
+
+	/* A limit that came down since the exposure of this frame */
+	if (!manualExposure_)
+		fitExposure(context, frameContext.sensor.exposure, frameContext.sensor.gain,
+			    exposureLimit(context, frameContext.sensor.exposure));
+
+	regulate(context, frameContext, error);
+	applyManual(context, frameContext);
+
+	context.activeState.agc.converging =
+		frameContext.sensor.exposure != exposure ||
+		frameContext.sensor.gain != again ||
+		context.activeState.agc.digitalGain != digitalGain;
+
+	/*
+	 * For AeState: steps of the total exposure below kSettledStep count as
+	 * settled, so that a regulation that creeps at its limits (dark
+	 * scenes) or by the smallest gain steps still reports convergence.
+	 */
+	const double before = exposure * again * digitalGain;
+	const double after = frameContext.sensor.exposure * frameContext.sensor.gain *
+			     context.activeState.agc.digitalGain;
+	context.activeState.agc.settled = before > 0.0 &&
+					  std::abs(after / before - 1.0) < kSettledStep;
+}
+
+/*
+ * Apply the whole factor in one statistics frame: the stages of the order
+ * described in regulate() take their share one after the other, each up to
+ * its limit, the digital gain last (first when going down).
+ */
+void Agc::regulateCascade(IPAContext &context, IPAFrameContext &frameContext, double factor)
+{
+	const auto &agc = context.configuration.agc;
+	int32_t &exposure = frameContext.sensor.exposure;
+	double &again = frameContext.sensor.gain;
+	double &digitalGain = context.activeState.agc.digitalGain;
+	double rest = factor;
+	const int32_t expLimit = exposureLimit(context, exposure);
+
+	auto moveExposure = [&](int32_t limit) {
+		if (rest == 1.0 || exposure <= 0)
+			return;
+		const double wanted = exposure * rest;
+		const int32_t next = rest > 1.0
+					     ? std::min<int32_t>(std::lround(wanted), limit)
+					     : std::max<int32_t>(std::lround(wanted), limit);
+		if ((rest > 1.0 && next <= exposure) || (rest < 1.0 && next >= exposure))
+			return;
+		rest *= static_cast<double>(exposure) / next;
+		exposure = next;
+	};
+	auto moveGain = [&](double &gain, double limit) {
+		if (rest == 1.0 || gain <= 0.0)
+			return;
+		const double next = rest > 1.0 ? std::min(gain * rest, limit)
+					       : std::max(gain * rest, limit);
+		if ((rest > 1.0 && next <= gain) || (rest < 1.0 && next >= gain))
+			return;
+		rest *= gain / next;
+		gain = next;
+	};
+
+	if (factor > 1.0) {
+		if (exposure < agc.exposureMax)
+			moveExposure(agc.exposureMax);
+		if (again < agc.extensionGain)
+			moveGain(again, agc.extensionGain);
+		moveExposure(expLimit);
+		moveGain(again, agc.againMax);
+		if (maxDigitalGain_ > 1.0)
+			moveGain(digitalGain, maxDigitalGain_);
+	} else {
+		moveGain(digitalGain, 1.0);
+		if (exposure > agc.exposureMax)
+			moveGain(again, std::max(agc.extensionGain, agc.againMin));
+		moveExposure(agc.exposureMax);
+		moveGain(again, agc.again10);
+		moveExposure(agc.exposureMin);
+		moveGain(again, agc.againMin);
+	}
+
+	exposure = std::clamp(exposure, agc.exposureMin, expLimit);
+	again = std::clamp(again, agc.againMin, agc.againMax);
+
+	context.activeState.agc.exposure = exposure;
+	context.activeState.agc.again = again;
+}
+
+/*
+ * Frame rate while the autofocus searches: each search step waits for a
+ * number of frames, a frame length extended for a dark scene makes the search
+ * slower in proportion. Trade the extended part of the exposure for gain
+ * while it searches (the product, and so the brightness, stays), and give it
+ * back once it is done, restoring the order of regulate().
+ */
+void Agc::rebalanceForAf(IPAContext &context, IPAFrameContext &frameContext)
+{
+	const auto &agc = context.configuration.agc;
+	int32_t &exposure = frameContext.sensor.exposure;
+	double &again = frameContext.sensor.gain;
+
+	if (agc.exposureMaxExtended <= agc.exposureMax || exposure <= 0 || again <= 0.0)
+		return;
+
+	if (context.activeState.af.busy && exposure > agc.exposureMax) {
+		const double gain = std::min(again * exposure / agc.exposureMax, agc.againMax);
+		const int32_t next = std::clamp<int32_t>(std::lround(exposure * again / gain),
+							 agc.exposureMax, exposure);
+		again = gain;
+		exposure = next;
+	} else if (!context.activeState.af.busy && again > agc.extensionGain &&
+		   exposure >= agc.exposureMax && exposure < context.activeState.agc.exposureLimit) {
+		const int32_t next = std::min<int32_t>(std::lround(exposure * again / agc.extensionGain),
+						       context.activeState.agc.exposureLimit);
+		again = std::max(again * exposure / next, agc.againMin);
+		exposure = next;
+	} else {
+		return;
+	}
+
+	context.activeState.agc.exposure = exposure;
+	context.activeState.agc.again = again;
+	LOG(IPAMtkIsp50Exposure, Debug)
+		<< (context.activeState.af.busy ? "Autofocus" : "Autofocus done")
+		<< ": exposure " << exposure << " gain " << again;
+}
+
+void Agc::regulate(IPAContext &context, IPAFrameContext &frameContext, double error)
+{
+	const auto &agc = context.configuration.agc;
+	int32_t &exposure = frameContext.sensor.exposure;
+	double &again = frameContext.sensor.gain;
+
+	if (std::abs(error) <= tolerance_)
+		return;
+
+	const float factor = static_cast<float>(stepFactor(error));
+	const int32_t expLimit = exposureLimit(context, exposure);
+
+	if (exposureSpeed_) {
+		regulateCascade(context, frameContext, factor);
+		LOG(IPAMtkIsp50Exposure, Debug)
+			<< "error " << error << " factor " << factor
+			<< " exp " << exposure << " again " << again
+			<< " digital gain " << context.activeState.agc.digitalGain;
+		return;
+	}
+
+	/*
+	 * Digital gain: taken back first when too bright, raised last when too
+	 * dark with exposure and analogue gain at their limits. It acts from
+	 * the next prepared frame on, without sensor delay.
+	 */
+	double &digitalGain = context.activeState.agc.digitalGain;
+	if (factor < 1.0f && digitalGain > 1.0) {
+		digitalGain = std::max(digitalGain * factor, 1.0);
+		LOG(IPAMtkIsp50Exposure, Debug)
+			<< "error " << error << " factor " << factor
+			<< " digital gain " << digitalGain;
+		return;
+	}
+	if (factor > 1.0f && maxDigitalGain_ > 1.0 &&
+	    exposure >= expLimit && again >= agc.againMax) {
+		digitalGain = std::min(digitalGain * factor, maxDigitalGain_);
+		LOG(IPAMtkIsp50Exposure, Debug)
+			<< "error " << error << " factor " << factor
+			<< " digital gain " << digitalGain;
+		return;
+	}
+
+	auto exposureUp = [&](int32_t limit) {
+		int32_t next = static_cast<int32_t>(exposure * factor);
+		exposure = std::min(std::max(next, exposure + 1), limit);
+	};
+	auto exposureDown = [&](int32_t limit) {
+		int32_t next = static_cast<int32_t>(exposure * factor);
+		exposure = std::max(std::min(next, exposure - 1), limit);
+	};
+	auto gainUp = [&](double limit) {
+		double next = again * factor;
+		if (next - again < agc.againMinStep)
+			next = again + agc.againMinStep;
+		again = std::min(next, limit);
+	};
+	auto gainDown = [&](double limit) {
+		double next = again * factor;
+		if (again - next < agc.againMinStep)
+			next = again - agc.againMinStep;
+		again = std::max(next, limit);
+	};
+
+	/*
+	 * Order when too dark: exposure up to the limit of the default frame
+	 * length, gain up to extensionGain, exposure up to the extended frame
+	 * length, gain up to the maximum. Too bright: the reverse. Without a
+	 * frame length extension this is exposure first, then gain.
+	 */
+	if (factor > 1.0f) {
+		if (exposure < agc.exposureMax)
+			exposureUp(agc.exposureMax);
+		else if (again < agc.extensionGain)
+			gainUp(agc.extensionGain);
+		else if (exposure < expLimit)
+			exposureUp(expLimit);
+		else
+			gainUp(agc.againMax);
+	} else {
+		if (exposure > agc.exposureMax && again > agc.extensionGain)
+			gainDown(agc.extensionGain);
+		else if (exposure > agc.exposureMax)
+			exposureDown(agc.exposureMax);
+		else if (again > agc.again10)
+			gainDown(agc.againMin);
+		else
+			exposureDown(agc.exposureMin);
+	}
+
+	exposure = std::clamp(exposure, agc.exposureMin, expLimit);
+	again = std::clamp(again, agc.againMin, agc.againMax);
+
+	context.activeState.agc.exposure = exposure;
+	context.activeState.agc.again = again;
+
+	LOG(IPAMtkIsp50Exposure, Debug)
+		<< "error " << error << " factor " << factor
+		<< " exp " << exposure << " again " << again;
+}
+
+double Agc::interpolate(const std::vector<double> &x, const std::vector<double> &y, double v)
+{
+	if (x.empty())
+		return 0.0;
+	if (v <= x.front())
+		return y.front();
+	if (v >= x.back())
+		return y.back();
+	unsigned int i = 0;
+	while (v > x[i + 1])
+		i++;
+	return y[i] + (v - x[i]) / (x[i + 1] - x[i]) * (y[i + 1] - y[i]);
+}
+
+/*
+ * Mean of the brightest fraction of the luminance histogram, above the black
+ * level and relative to the range above it (the statistics before the digital
+ * gain); -1 without data
+ */
+double Agc::highlightLevel(const IPAContext &context, const Statistics *stats) const
+{
+	const auto &hist = stats->yHistogram;
+	const double black = context.activeState.blc.level;
+	const double binWidth = 256.0 / Statistics::kYHistogramSize;
+	uint64_t total = 0;
+	for (uint32_t n : hist)
+		total += n;
+	if (!total || !(255.0 - black > 0.0))
+		return -1.0;
+
+	const double want = highlightFraction_ * total;
+	double count = 0.0;
+	double sum = 0.0;
+	for (int i = Statistics::kYHistogramSize - 1; i >= 0 && count < want; i--) {
+		const double n = std::min<double>(hist[i], want - count);
+		const double y = std::max((i + 0.5) * binWidth - black, 0.0) / (255.0 - black);
+		sum += n * y;
+		count += n;
+	}
+
+	return count > 0.0 ? sum / count : -1.0;
+}
+
+/*
+ * Regulation with an exposure program: the total exposure follows the
+ * error of the metered mean against the target (target curve over the
+ * brightness of the scene, highlights), and is split into exposure time,
+ * analogue and digital gain by the program of the session within the
+ * longest exposure of the moment.
+ */
+void Agc::regulateProgram(IPAContext &context, IPAFrameContext &frameContext,
+			  const Statistics *stats, double metered)
+{
+	const auto &agc = context.configuration.agc;
+	auto &state = context.activeState.agc;
+	const ExposureProgram &prog = programs_[useCase_ == 1 && programs_[1] ? 1 : 0].value();
+
+	const int32_t exposure = frameContext.sensor.exposure;
+	const double again = frameContext.sensor.gain;
+	const double digitalBefore = state.digitalGain;
+	const double dFrame = frameContext.digitalGain > 0.0 ? frameContext.digitalGain : state.digitalGain;
+	const double tFrame = utils::Duration(agc.lineDuration * exposure).get<std::micro>();
+
+	/* The statistics are taken before the digital gain */
+	const double mean = std::max(metered * dFrame, 1e-4);
+	const double base = *exposureTarget_ * std::exp2(exposureValue_);
+	state.levelRatio = mean / *exposureTarget_;
+
+	/* Brightness of the scene */
+	const double bv = std::log2(fNumber_ * fNumber_ / std::max(tFrame * 1e-6, 1e-6)) -
+			  std::log2(std::max(again * dFrame, 1e-3)) - 5.0 +
+			  std::log2(mean / *exposureTarget_);
+	const double offset = interpolate(targetBv_, targetStops_, bv);
+	double target = base * std::exp2(offset);
+
+	/* Highlights, relative to the mean: independent of the exposure */
+	double reduction = 0.0;
+	if (!highlightBv_.empty()) {
+		const double top = highlightLevel(context, stats);
+		const double limit = interpolate(highlightBv_, highlightLimit_, bv) / 255.0;
+		if (top > 0.0 && metered > 0.0 && limit > 0.0) {
+			const double excess = std::log2(top / metered * target / limit);
+			if (excess > 0.0)
+				reduction = std::min(highlightMaxStops_,
+						     highlightStrength_ / (1.0 + highlightStrength_) * excess);
+		}
+		highlightStops_ = 0.5 * highlightStops_ + 0.5 * reduction;
+		target *= std::exp2(-highlightStops_);
+	}
+
+	/* Error in half stops, as the other regulation */
+	const double error = 2.0 * std::log2(target / mean);
+	/*
+	 * The total exposure the frame needed (exact for its own exposure,
+	 * whatever the sensor delays), approached from the regulated one: a
+	 * part the frame could not reach (limits of the preview) stays in it
+	 */
+	const double frameTotal = tFrame * again * dFrame;
+	const double required = frameTotal * target / mean;
+	double total = total_ > 0.0 ? total_ : frameTotal;
+	if (std::abs(error) > tolerance_) {
+		const double stops = std::clamp(*exposureSpeed_ * std::log2(required / total),
+						-maxExposureStep_, maxExposureStep_);
+		total *= std::exp2(stops);
+	}
+
+	/* Longest exposure of the moment, the digital gain of the session */
+	const int32_t limitLines = exposureLimit(context, exposure);
+	const double maxTime = utils::Duration(agc.lineDuration * limitLines).get<std::micro>();
+	const double minTime = utils::Duration(agc.lineDuration * agc.exposureMin).get<std::micro>();
+	const unsigned int top = useCase_ == 2 && programs_[2] ? 2 : useCase_ == 1 && programs_[1] ? 1 : 0;
+	const double dmaxSession = std::max(programs_[top]->maxGain() / agc.againMax, 1.0);
+	const double dmaxFrames = std::max(prog.maxGain() / agc.againMax, 1.0);
+	total = std::clamp(total, minTime * agc.againMin, maxTime * agc.againMax * dmaxSession);
+	total_ = total;
+
+	const ExposureProgram::Split split = prog.split(total, minTime, maxTime, agc.againMin,
+							agc.againMax, dmaxFrames);
+
+	int32_t lines = static_cast<int32_t>(std::lround(split.time / agc.lineDuration.get<std::micro>()));
+	lines = std::clamp(lines, agc.exposureMin, std::max(limitLines, agc.exposureMin));
+	/* The rest of a rounded time goes to the digital gain */
+	const double tLines = utils::Duration(agc.lineDuration * lines).get<std::micro>();
+	double dgain = split.dgain;
+	if (tLines > 0.0 && split.again > 0.0)
+		dgain = std::clamp(total / (tLines * split.again), 1.0, dmaxFrames);
+
+	frameContext.sensor.exposure = lines;
+	frameContext.sensor.gain = std::clamp(split.again, agc.againMin, agc.againMax);
+	state.exposure = frameContext.sensor.exposure;
+	state.again = frameContext.sensor.gain;
+	state.digitalGain = dgain;
+
+	state.converging = frameContext.sensor.exposure != exposure ||
+			   frameContext.sensor.gain != again || state.digitalGain != digitalBefore;
+	const double before = exposure * again * digitalBefore;
+	const double after = frameContext.sensor.exposure * frameContext.sensor.gain * state.digitalGain;
+	state.settled = before > 0.0 && std::abs(after / before - 1.0) < kSettledStep;
+
+	LOG(IPAMtkIsp50Exposure, Debug)
+		<< "zone mean " << mean << " target " << target << " (bv " << bv
+		<< ", offset " << offset << ", highlights -" << highlightStops_
+		<< ") total " << total << " -> exposure " << lines << " (" << tLines
+		<< " us) gain " << frameContext.sensor.gain << " digital gain " << dgain
+		<< " limit " << limitLines;
+}
+
+void Agc::queueRequest(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+			[[maybe_unused]] IPAFrameContext &frameContext,
+			const ControlList &controls)
+{
+	const auto &agc = context.configuration.agc;
+
+	if (const auto &v = controls.get(controls::AeEnable))
+		aeEnable_ = *v;
+	/*
+	 * A switch to manual without a value keeps the value of the moment
+	 * (AeEnable false arrives as both modes manual).
+	 */
+	if (const auto &v = controls.get(controls::ExposureTimeMode)) {
+		const bool manual = *v == controls::ExposureTimeModeManual;
+		if (manual && !manualExposure_ && !controls.contains(controls::ExposureTime.id()))
+			exposureLines_ = context.activeState.agc.exposure;
+		manualExposure_ = manual;
+	}
+	if (const auto &v = controls.get(controls::AnalogueGainMode)) {
+		const bool manual = *v == controls::AnalogueGainModeManual;
+		if (manual && !manualGain_ && !controls.contains(controls::AnalogueGain.id()))
+			gainValue_ = context.activeState.agc.again;
+		manualGain_ = manual;
+	}
+
+	if (const auto &v = controls.get(controls::ExposureTime)) {
+		if (agc.lineDuration > utils::Duration(0))
+			exposureLines_ = static_cast<int32_t>(std::lround(
+				std::chrono::duration<double, std::micro>(*v) / agc.lineDuration));
+		/* An exposure time without its mode: manual, as rkisp1 */
+		if (!controls.contains(controls::ExposureTimeMode.id()))
+			manualExposure_ = true;
+	}
+	if (const auto &v = controls.get(controls::AnalogueGain)) {
+		gainValue_ = *v;
+		if (!controls.contains(controls::AnalogueGainMode.id()))
+			manualGain_ = true;
+	}
+
+	if (const auto &v = controls.get(controls::ExposureValue))
+		exposureValue_ = std::clamp<double>(*v, -8.0, 8.0);
+
+	if (const auto &v = controls.get(controls::AeMeteringMode)) {
+		meteringMode_ = static_cast<controls::AeMeteringModeEnum>(*v);
+		switch (meteringMode_) {
+		case controls::MeteringSpot:
+			zoneWeights_.fill(0.0);
+			zoneWeights_[kMeteringZones * kMeteringZones / 2] = 1.0;
+			break;
+		case controls::MeteringMatrix:
+			zoneWeights_.fill(1.0);
+			break;
+		default:
+			meteringMode_ = controls::MeteringCentreWeighted;
+			zoneWeights_ = tunedWeights_;
+			break;
+		}
+	}
+
+	if (const auto &v = controls.get(controls::FrameDurationLimits)) {
+		/*
+		 * The longest frame duration limits the exposure, the shortest
+		 * one lengthens the frame (microseconds, 0 for none). The
+		 * exposure of the moment comes down to the new limit at once
+		 * (for the start of a stream).
+		 */
+		const int64_t minUs = (*v)[0];
+		const int64_t maxUs = (*v)[1];
+		if (maxUs > 0)
+			maxFrameDuration_ = std::chrono::microseconds(maxUs);
+		else
+			maxFrameDuration_.reset();
+		if (minUs > 0)
+			minFrameDuration_ = std::chrono::microseconds(minUs);
+		else
+			minFrameDuration_.reset();
+
+		updateFrameLimits(context);
+		auto &state = context.activeState.agc;
+		if (state.valid && !manualExposure_)
+			fitExposure(context, state.exposure, state.again,
+				    std::max(state.exposureLimit, agc.exposureMin));
+	}
+}
+
+void Agc::process(IPAContext &context,
+		  [[maybe_unused]] const uint32_t frame,
+		  IPAFrameContext &frameContext,
+		  const Statistics *stats,
+		  ControlList &metadata)
+{
+	utils::Duration exposureTime =
+		context.configuration.agc.lineDuration * frameContext.sensor.exposure;
+	metadata.set(controls::ExposureTime, exposureTime.get<std::micro>());
+	{
+		/* The frame length that goes with the exposure of this frame */
+		const auto &agc = context.configuration.agc;
+		const int32_t lines = agc.vblankEnabled
+					      ? agc.frame.linesFor(frameContext.sensor.exposure,
+								   context.activeState.agc.minFrameLines)
+					      : agc.frame.defaultLines;
+		if (lines > 0)
+			metadata.set(controls::FrameDuration,
+				     static_cast<int64_t>(utils::Duration(agc.lineDuration * lines).get<std::micro>()));
+	}
+	metadata.set(controls::AnalogueGain, frameContext.sensor.gain);
+	metadata.set(controls::DigitalGain, static_cast<float>(frameContext.digitalGain));
+	/* State of the regulation that led to the values of this frame */
+	metadata.set(controls::AeEnable, aeEnable_);
+	metadata.set(controls::ExposureTimeMode,
+		     manualExposure_ ? controls::ExposureTimeModeManual : controls::ExposureTimeModeAuto);
+	metadata.set(controls::AnalogueGainMode,
+		     manualGain_ ? controls::AnalogueGainModeManual : controls::AnalogueGainModeAuto);
+	if (exposureTarget_)
+		metadata.set(controls::ExposureValue, static_cast<float>(exposureValue_));
+	if (zoneMetering_)
+		metadata.set(controls::AeMeteringMode, meteringMode_);
+
+	const bool regulated = aeEnable_ && !(manualExposure_ && manualGain_);
+	metadata.set(controls::AeState,
+		     !regulated ? controls::AeStateIdle
+		     : context.activeState.agc.valid &&
+				     (!context.activeState.agc.converging || context.activeState.agc.settled)
+			     ? controls::AeStateConverged
+			     : controls::AeStateSearching);
+
+	if (!regulated && context.activeState.agc.valid) {
+		/* Manual or held: no regulation, the values stay */
+		frameContext.sensor.exposure = context.activeState.agc.exposure;
+		frameContext.sensor.gain = context.activeState.agc.again;
+		if (aeEnable_)
+			applyManual(context, frameContext);
+		context.activeState.agc.converging = false;
+		return;
+	}
+
+	if (!context.activeState.agc.valid) {
+		/*
+		 * Init active-state from sensor values in case updateExposure()
+		 * does not run for the first frame.
+		 */
+		context.activeState.agc.exposure = frameContext.sensor.exposure;
+		context.activeState.agc.again = frameContext.sensor.gain;
+		context.activeState.agc.valid = true;
+	}
+
+	if (!stats->valid) {
+		/*
+		 * Use the new exposure and gain values calculated the last time
+		 * there were valid stats.
+		 */
+		frameContext.sensor.exposure = context.activeState.agc.exposure;
+		frameContext.sensor.gain = context.activeState.agc.again;
+		return;
+	}
+
+	const bool program = programs_[0] && !manualExposure_ && !manualGain_;
+	if (afFrameRate_ && !program)
+		rebalanceForAf(context, frameContext);
+
+	if (zoneMetering_) {
+		const double metered = zoneMean(context, stats);
+		if (metered < 0.0)
+			return;
+
+		if (program) {
+			regulateProgram(context, frameContext, stats, metered);
+			return;
+		}
+
+		/* The statistics are taken before the digital gain */
+		const double mean = std::max(metered * context.activeState.agc.digitalGain, 1e-4);
+		LOG(IPAMtkIsp50Exposure, Debug)
+			<< "zone mean " << mean << " target " << *exposureTarget_
+			<< " exposure " << frameContext.sensor.exposure
+			<< " gain " << frameContext.sensor.gain
+			<< " digital gain " << context.activeState.agc.digitalGain;
+		updateExposure(context, frameContext, 2.0 * std::log2(*exposureTarget_ / mean));
+		return;
+	}
+
+	/*
+	 * Calculate Mean Sample Value (MSV) according to formula from:
+	 * https://www.araa.asn.au/acra/acra2007/papers/paper84final.pdf
+	 */
+	const auto &histogram = stats->yHistogram;
+	const unsigned int blackLevelHistIdx =
+		context.activeState.blc.level / (256 / Statistics::kYHistogramSize);
+	const unsigned int histogramSize =
+		Statistics::kYHistogramSize - blackLevelHistIdx;
+	const unsigned int yHistValsPerBin = histogramSize / kExposureBinsCount;
+	const unsigned int yHistValsPerBinMod =
+		histogramSize / (histogramSize % kExposureBinsCount + 1);
+	int exposureBins[kExposureBinsCount] = {};
+	unsigned int denom = 0;
+	unsigned int num = 0;
+
+	if (yHistValsPerBin == 0) {
+		LOG(IPAMtkIsp50Exposure, Debug)
+			<< "Not adjusting exposure due to insufficient histogram data";
+		return;
+	}
+
+	for (unsigned int i = 0; i < histogramSize; i++) {
+		unsigned int idx = (i - (i / yHistValsPerBinMod)) / yHistValsPerBin;
+		exposureBins[idx] += histogram[blackLevelHistIdx + i];
+	}
+
+	for (unsigned int i = 0; i < kExposureBinsCount; i++) {
+		LOG(IPAMtkIsp50Exposure, Debug) << i << ": " << exposureBins[i];
+		denom += exposureBins[i];
+		num += exposureBins[i] * (i + 1);
+	}
+
+	float exposureMSV = (denom == 0 ? 0 : static_cast<float>(num) / denom);
+
+	if (!exposureTarget_) {
+		LOG(IPAMtkIsp50Exposure, Debug) << "exposureMSV " << exposureMSV;
+		updateExposure(context, frameContext, kExposureOptimal - exposureMSV);
+		return;
+	}
+
+	/* Mean above the black level, within the metering range */
+	const double metered = meteredMean(histogram, blackLevelHistIdx);
+	if (metered < 0.0)
+		return;
+
+	/* The statistics are taken before the digital gain */
+	const double mean = std::max(metered * context.activeState.agc.digitalGain, 1e-4);
+	LOG(IPAMtkIsp50Exposure, Debug)
+		<< "mean " << mean << " target " << *exposureTarget_
+		<< " exposure " << frameContext.sensor.exposure
+		<< " gain " << frameContext.sensor.gain
+		<< " digital gain " << context.activeState.agc.digitalGain;
+	updateExposure(context, frameContext, 2.0 * std::log2(*exposureTarget_ / mean));
+}
+
+/**
+ * \brief Apply the digital gain to the colour gains of the debayer parameters
+ */
+void Agc::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		  IPAFrameContext &frameContext, DipFrameParams *params)
+{
+	double digitalGain = context.activeState.agc.digitalGain;
+
+	/*
+	 * A frame for a still image: the digital gain the still program
+	 * allows beyond the one of the preview (very dark scenes)
+	 */
+	if (params->useCase == static_cast<uint8_t>(UseCase::Still) && programs_[2] && total_ > 0.0 &&
+	    !manualExposure_ && !manualGain_) {
+		const auto &agc = context.configuration.agc;
+		const double t = utils::Duration(agc.lineDuration * context.activeState.agc.exposure).get<std::micro>();
+		const double a = context.activeState.agc.again;
+		const double dmax = std::max(programs_[2]->maxGain() / agc.againMax, 1.0);
+		if (t > 0.0 && a > 0.0)
+			digitalGain = std::clamp(total_ / (t * a), digitalGain, dmax);
+	}
+
+	frameContext.digitalGain = digitalGain;
+	params->totalGain = static_cast<float>(context.activeState.agc.again * digitalGain);
+	if (digitalGain != 1.0)
+		params->gains = params->gains * static_cast<float>(digitalGain);
+}
+
+REGISTER_IPA_ALGORITHM(Agc, "Agc")
+
+} /* namespace ipa::mtkisp50::algorithms */
+
+} /* namespace libcamera */
