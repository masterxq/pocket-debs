+void CellularModemList::setDataModem(CellularModem *modem)
+{
+    if (!modem || !m_modemList.contains(modem)) {
+        return;
+    }
+    // enabling mobile data on a modem disables it on the other ones
+    modem->setMobileDataEnabled(true);
+    updateDataModem();
+}
+
+static bool isActivating(CellularModem *modem)
+{
+    const auto nmModem = modem->nmModemDevice();
+    if (!nmModem) {
+        return false;
+    }
+    const auto state = nmModem->state();
+    return state >= NetworkManager::Device::Preparing && state <= NetworkManager::Device::Activated;
+}
+
+static bool hasConnectionBoundToSim(CellularModem *modem, bool autoconnectOnly)
+{
+    const auto nmModem = modem->nmModemDevice();
+    const QString simId = modem->simIdentifier();
+    if (!nmModem || simId.isEmpty()) {
+        return false;
+    }
+    for (const auto &con : nmModem->availableConnections()) {
+        const auto gsmSetting = con->settings()->setting(NetworkManager::Setting::Gsm).dynamicCast<NetworkManager::GsmSetting>();
+        if (gsmSetting && gsmSetting->simId() == simId && (!autoconnectOnly || con->settings()->autoconnect())) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static QDateTime lastUsed(CellularModem *modem)
+{
+    QDateTime latest;
+    const auto nmModem = modem->nmModemDevice();
+    if (!nmModem) {
+        return latest;
+    }
+    for (const auto &con : nmModem->availableConnections()) {
+        const QDateTime timestamp = con->settings()->timestamp();
+        if (!timestamp.isNull() && (latest.isNull() || timestamp > latest)) {
+            latest = timestamp;
+        }
+    }
+    return latest;
+}
+
+void CellularModemList::updateDataModem()
+{
+    CellularModem *dataModem = nullptr;
+
+    // the modem that is connected or connecting
+    for (auto modem : std::as_const(m_modemList)) {
+        if (isActivating(modem)) {
+            dataModem = modem;
+            break;
+        }
+    }
+    // the modem that connects by itself, with a connection bound to its SIM first
+    if (!dataModem) {
+        for (auto modem : std::as_const(m_modemList)) {
+            if (modem->mobileDataEnabled() && hasConnectionBoundToSim(modem, true)) {
+                dataModem = modem;
+                break;
+            }
+        }
+    }
+    if (!dataModem) {
+        for (auto modem : std::as_const(m_modemList)) {
+            if (modem->mobileDataEnabled()) {
+                dataModem = modem;
+                break;
+            }
+        }
+    }
+    // mobile data is off: the modem used last, then the first one
+    if (!dataModem) {
+        QDateTime latest;
+        for (auto modem : std::as_const(m_modemList)) {
+            const QDateTime timestamp = lastUsed(modem);
+            if (!timestamp.isNull() && (latest.isNull() || timestamp > latest)) {
+                latest = timestamp;
+                dataModem = modem;
+            }
+        }
+    }
+    if (!dataModem) {
+        dataModem = primaryModem();
+    }
+
+    if (m_dataModem != dataModem) {
+        m_dataModem = dataModem;
+        Q_EMIT dataModemChanged();
+    }
+}
+
+CellularModem *CellularModemList::defaultModem() const
+{
+    return m_defaultModem;
+}
+
+void CellularModemList::setDefaultModem(CellularModem *modem)
+{
+    if (!modem || !m_modemList.contains(modem) || modem->simIdentifier().isEmpty()) {
+        return;
+    }
+    SimIdentities::instance()->setDefaultSim(modem->simIdentifier());
+    updateDefaultModem();
+}
+
+void CellularModemList::updateDefaultModem()
+{
+    CellularModem *defaultModem = nullptr;
+
+    const QString chosen = SimIdentities::instance()->defaultSim();
+    if (!chosen.isEmpty()) {
+        for (auto modem : std::as_const(m_modemList)) {
+            if (modem->simIdentifier() == chosen) {
+                defaultModem = modem;
+                break;
+            }
+        }
+    }
+    // the SIM in the first slot, SIMs without a known slot last
+    if (!defaultModem) {
+        const auto slotOrder = [](CellularModem *modem) {
+            return modem->simSlot() > 0 ? modem->simSlot() : std::numeric_limits<int>::max();
+        };
+        for (auto modem : std::as_const(m_modemList)) {
+            if (modem->sim() && (!defaultModem || slotOrder(modem) < slotOrder(defaultModem))) {
+                defaultModem = modem;
+            }
+        }
+    }
+
+    if (m_defaultModem != defaultModem) {
+        m_defaultModem = defaultModem;
+        Q_EMIT defaultModemChanged();
+    }
+}
