+QString CellularModem::networkType() const
+{
+    if (!m_mmInterface) {
+        return {};
+    }
+    // the newest technology in use, e.g. LTE and 5G NR together with 5G NSA
+    const auto technologies = m_mmInterface->accessTechnologies();
+    if (technologies & MM_MODEM_ACCESS_TECHNOLOGY_5GNR) {
+        return u"5g"_s;
+    } else if (technologies & MM_MODEM_ACCESS_TECHNOLOGY_LTE) {
+        return u"lte"_s;
+    } else if (technologies & (MM_MODEM_ACCESS_TECHNOLOGY_HSPA | MM_MODEM_ACCESS_TECHNOLOGY_HSPA_PLUS)) {
+        return u"hspa"_s;
+    } else if (technologies & MM_MODEM_ACCESS_TECHNOLOGY_HSUPA) {
+        return u"hsupa"_s;
+    } else if (technologies & MM_MODEM_ACCESS_TECHNOLOGY_HSDPA) {
+        return u"hsdpa"_s;
+    } else if (technologies & MM_MODEM_ACCESS_TECHNOLOGY_UMTS) {
+        return u"umts"_s;
+    } else if (technologies & MM_MODEM_ACCESS_TECHNOLOGY_EDGE) {
+        return u"edge"_s;
+    } else if (technologies & MM_MODEM_ACCESS_TECHNOLOGY_GPRS) {
+        return u"gprs"_s;
+    }
+    return {};
+}
