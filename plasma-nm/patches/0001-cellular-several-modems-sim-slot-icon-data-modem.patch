+void CellularModem::loadSimSlot()
+{
+    // ModemManagerQt does not expose the SIM slots of a modem yet
+    QDBusMessage message = QDBusMessage::createMethodCall(u"org.freedesktop.ModemManager1"_s,
+                                                          uni(),
+                                                          u"org.freedesktop.DBus.Properties"_s,
+                                                          u"GetAll"_s);
+    message << u"org.freedesktop.ModemManager1.Modem"_s;
+
+    QPointer<CellularModem> self{this};
+    QDBusPendingCallWatcher *watcher = new QDBusPendingCallWatcher(QDBusConnection::systemBus().asyncCall(message), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [self](QDBusPendingCallWatcher *watcher) {
+        watcher->deleteLater();
+        QDBusPendingReply<QVariantMap> reply = *watcher;
+        if (!self || reply.isError()) {
+            return;
+        }
+
+        QList<QDBusObjectPath> simSlots;
+        const QVariant simSlotsValue = reply.value().value(u"SimSlots"_s);
+        if (simSlotsValue.canConvert<QDBusArgument>()) {
+            simSlotsValue.value<QDBusArgument>() >> simSlots;
+        }
+        const uint primary = reply.value().value(u"PrimarySimSlot"_s).toUInt();
+
+        // a modem without SIM slot information has no slot list and the primary slot 0
+        const int slot = (primary > 0 && primary <= uint(simSlots.size())) ? int(primary) : 0;
+        if (self->m_simSlot == slot) {
+            return;
+        }
+        self->m_simSlot = slot;
+        for (auto sim : std::as_const(self->m_sims)) {
+            sim->setSlot(slot);
+        }
+        Q_EMIT self->simSlotChanged();
+    });
+}
