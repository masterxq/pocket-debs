+void CellularModem::disableMobileData(const QString &keepConnectionUni)
+{
+    if (!m_nmModem) {
+        return;
+    }
+
+    // we do not call NetworkManager::setWwanEnabled(false), because it turns off cellular
+    m_nmModem->setAutoconnect(false);
+    // we need to also set all connections to not autoconnect (#182)
+    for (NetworkManager::Connection::Ptr con : m_nmModem->availableConnections()) {
+        if (con->uuid() == keepConnectionUni || !con->settings()->autoconnect()) {
+            continue;
         }
-        // disconnect network
+        con->settings()->setAutoconnect(false);
+        con->update(con->settings()->toMap());
+    }
+    // disconnect network
+    if (m_nmModem->state() != NetworkManager::Device::Disconnected && m_nmModem->state() != NetworkManager::Device::Unavailable) {
         m_nmModem->disconnectInterface();
     }
 }
 
+QList<CellularModem *> CellularModem::otherModems() const
+{
+    QList<CellularModem *> others;
+    if (auto list = qobject_cast<CellularModemList *>(parent())) {
+        for (auto modem : list->modems()) {
+            if (modem != this) {
+                others.append(modem);
+            }
+        }
+    }
+    return others;
+}
+
+QCoro::Task<void> CellularModem::bindConnectionToSim(NetworkManager::Connection::Ptr connection)
+{
+    // gsm.sim-id makes NetworkManager use the connection only with this SIM
+    const QString simId = simIdentifier();
+    NetworkManager::ConnectionSettings::Ptr settings = connection->settings();
+    NetworkManager::GsmSetting::Ptr gsmSetting = settings->setting(NetworkManager::Setting::Gsm).dynamicCast<NetworkManager::GsmSetting>();
+    if (gsmSetting && !simId.isEmpty() && gsmSetting->simId().isEmpty()) {
+        gsmSetting->setSimId(simId);
+        gsmSetting->setInitialized(true);
+    }
+
+    QDBusReply<void> reply = co_await connection->update(settings->toMap());
+    if (!reply.isValid()) {
+        qCWarning(PLASMA_NM_CELLULAR_LOG) << "Error updating connection" << connection->uuid() << ":" << reply.error().message();
+    }
+}
