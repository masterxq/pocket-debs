     data: PlasmaNM.EnabledConnections {
         id: enabledConnections
@@ -51,6 +52,59 @@ FormCard.FormCardPage {
         model: kcm.messages
     }
 
+    FormCard.FormCard {
+        Layout.topMargin: Kirigami.Units.gridUnit
+        visible: simEnabled && simIdentifier !== ""
+
+        FormCard.AbstractFormDelegate {
+            id: iconChooser
+
+            background: null
+            contentItem: ColumnLayout {
+                spacing: Kirigami.Units.smallSpacing
+
+                Controls.Label {
+                    Layout.fillWidth: true
+                    text: i18n("Icon")
+                    elide: Text.ElideRight
+                    textFormat: Text.PlainText
+                }
+
+                Controls.Label {
+                    Layout.fillWidth: true
+                    text: i18n("Shown with this SIM wherever a SIM is chosen.")
+                    color: Kirigami.Theme.disabledTextColor
+                    font: Kirigami.Theme.smallFont
+                    wrapMode: Text.Wrap
+                    textFormat: Text.PlainText
+                }
+
+                Flow {
+                    Layout.fillWidth: true
+                    spacing: Kirigami.Units.smallSpacing
+
+                    Repeater {
+                        model: simPage.sim ? simPage.sim.availableIcons : []
+
+                        Controls.ToolButton {
+                            required property string modelData
+
+                            icon.name: modelData
+                            icon.width: Kirigami.Units.iconSizes.medium
+                            icon.height: Kirigami.Units.iconSizes.medium
+                            display: Controls.AbstractButton.IconOnly
+                            checkable: true
+                            checked: simPage.sim && simPage.sim.icon === modelData
+                            text: modelData
+                            Accessible.name: i18n("Use this icon for the SIM")
+                            onClicked: simPage.sim.icon = modelData
+                        }
+                    }
+                }
+            }
+        }
+    }
+
     FormCard.FormCard {
         Layout.topMargin: Kirigami.Units.gridUnit
 
--- a/kcms/kcm_cellularnetwork/ui/main.qml
+++ b/kcms/kcm_cellularnetwork/ui/main.qml
@@ -30,7 +30,47 @@ KCM.SimpleKCM {
         id: modemList
     }
 
-    property Cellular.CellularModem selectedModem: modemList.primaryModem
+    property Cellular.CellularModem selectedModem: modemList.dataModem
+
+    readonly property bool modemMissing: !enabledConnections.wwanHwEnabled || !availableDevices.modemDeviceAvailable || !modemList.modemAvailable
+
+    // every modem with a SIM, in the order of the SIM slots (SIMs without a known slot last)
+    readonly property var simModems: modemList.modems
+        .filter(modem => modem.sim !== null)
+        .sort((a, b) => (a.simSlot > 0 ? a.simSlot : Number.MAX_SAFE_INTEGER) - (b.simSlot > 0 ? b.simSlot : Number.MAX_SAFE_INTEGER))
+
+    // choice of a SIM, shown with several SIMs
+    component SimComboBox: FormCard.FormComboBoxDelegate {
+        id: simComboBox
+
+        // modems with a SIM to choose from
+        property var simModems: []
+        // the modem whose SIM is shown as chosen
+        property var chosenModem: null
+        signal modemActivated(var modem)
+
+        // the combo box resets its index when the model changes, so the index is set afterwards
+        function syncCurrentIndex() {
+            currentIndex = model.findIndex(entry => entry.modem === chosenModem);
+        }
+
+        visible: simModems.length > 1
+        model: simModems.map(modem => ({ "text": modem.sim.name, "modem": modem }))
+        textRole: "text"
+
+        onModelChanged: Qt.callLater(() => simComboBox.syncCurrentIndex())
+        onChosenModemChanged: Qt.callLater(() => simComboBox.syncCurrentIndex())
+        Component.onCompleted: syncCurrentIndex()
+
+        onActivated: index => {
+            const modem = model[index] ? model[index].modem : null;
+            if (modem) {
+                modemActivated(modem);
+            }
+            // show the SIM actually in use, also when the choice did not take effect
+            Qt.callLater(() => simComboBox.syncCurrentIndex());
+        }
+    }
 
