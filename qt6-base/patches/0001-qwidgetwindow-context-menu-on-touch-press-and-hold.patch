 #if QT_VERSION < QT_VERSION_CHECK(7, 0, 0)
     if (
 #else
@@ -1205,6 +1238,75 @@ void QWidgetWindow::handleGestureEvent(QNativeGestureEvent *e)
 #endif // QT_NO_GESTURES
 
 #ifndef QT_NO_CONTEXTMENU
+/*
+    A press and hold of a finger (or of a pen, both arrive here as synthesized mouse events) on a
+    text input widget opens its context menu, the only way to reach Paste, Copy and Select All
+    without a keyboard. Touch platforms do the same for their text fields, and so do the text
+    fields of Qt Quick Controls. Widgets which handle touch events or the tap and hold gesture
+    themselves are left alone.
+*/
+static bool wantsTouchPressAndHoldContextMenu(const QWidget *w)
+{
+    for (; w; w = w->parentWidget()) {
+        if (w->testAttribute(Qt::WA_AcceptTouchEvents))
+            return false;
+#ifndef QT_NO_GESTURES
+        if (QWidgetPrivate::get(w)->gestureContext.contains(Qt::TapAndHoldGesture))
+            return false;
+#endif
+        if (w->testAttribute(Qt::WA_InputMethodEnabled)) {
+            return w->contextMenuPolicy() != Qt::NoContextMenu
+                && w->contextMenuPolicy() != Qt::PreventContextMenu;
+        }
+        if (w->isWindow())
+            return false;
+    }
+    return false;
+}
+
+void QWidgetWindowPrivate::trackTouchPressAndHold(const QMouseEvent *event, QWidget *receiver)
+{
+    Q_Q(QWidgetWindow);
+    switch (event->type()) {
+    case QEvent::MouseButtonPress:
+        pressAndHoldTimer.stop();
+        if (event->source() != Qt::MouseEventNotSynthesized && event->button() == Qt::LeftButton
+            && event->buttons() == Qt::LeftButton && wantsTouchPressAndHoldContextMenu(receiver)) {
+            pressAndHoldReceiver = receiver;
+            pressAndHoldGlobalPos = event->globalPosition();
+            pressAndHoldTimer.start(std::chrono::milliseconds(QGuiApplication::styleHints()->mousePressAndHoldInterval()), q);
+        }
+        break;
+    case QEvent::MouseMove:
+        if (pressAndHoldTimer.isActive()
+            && (event->globalPosition() - pressAndHoldGlobalPos).manhattanLength()
+                > QGuiApplication::styleHints()->startDragDistance()) {
+            pressAndHoldTimer.stop();
+        }
+        break;
+    default:
+        pressAndHoldTimer.stop();
+        break;
+    }
+}
+
+void QWidgetWindowPrivate::touchPressAndHoldTimeout()
+{
+    pressAndHoldTimer.stop();
+    QPointer<QWidget> receiver = pressAndHoldReceiver;
+    pressAndHoldReceiver = nullptr;
+    if (!receiver || !receiver->isVisible() || !receiver->isEnabled() || QApplication::activePopupWidget())
+        return;
+
+    // The finger is still down: the following release goes to the menu, which ignores a release
+    // without a press of its own, as after a right button press on platforms that open context
+    // menus on the press.
+    const QPoint globalPos = pressAndHoldGlobalPos.toPoint();
+    QContextMenuEvent e(QContextMenuEvent::Mouse, receiver->mapFromGlobal(globalPos), globalPos,
+                        QGuiApplication::keyboardModifiers());
+    QApplication::sendEvent(receiver, &e);
+}
+
 void QWidgetWindow::handleContextMenuEvent(QContextMenuEvent *e)
 {
     QWidget *receiver = qt_last_mouse_receiver.get();
