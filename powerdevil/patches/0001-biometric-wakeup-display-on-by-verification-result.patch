+// WECKEN=dunkel in the fingerprint configuration of the device keeps the display off after a rejected finger
+static bool fingerprintRejectionWakesDisplay()
+{
+    QFile file(u"/etc/lisbon/fingerabdruck.conf"_s);
+    if (!file.open(QIODevice::ReadOnly | QIODevice::Text)) {
+        return true;
+    }
+    bool wake = true;
+    while (!file.atEnd()) {
+        const QByteArray line = file.readLine().trimmed();
+        if (line.startsWith("WECKEN=")) {
+            const QByteArray value = line.mid(7).split('#').constFirst().trimmed();
+            wake = value != "dunkel";
+        }
+    }
+    return wake;
+}
+
+void Core::onFingerprintVerifyStatus(const QString &result, bool done)
+{
+    Q_UNUSED(done)
+    static const QStringList rejected = {u"verify-no-match"_s,
+                                         u"verify-retry-scan"_s,
+                                         u"verify-swipe-too-short"_s,
+                                         u"verify-finger-not-centered"_s,
+                                         u"verify-remove-and-retry"_s};
+    if (result == u"verify-match"_s || (rejected.contains(result) && fingerprintRejectionWakesDisplay())) {
+        qCDebug(POWERDEVIL) << "Fingerprint result" << result << "turns the display on";
+        wakeup();
+    }
+}
