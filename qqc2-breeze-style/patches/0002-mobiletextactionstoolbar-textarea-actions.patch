From: Devin Lin <espidev@gmail.com>
Date: Mon, 26 Oct 2026 08:35:33 -0400
Subject: [PATCH] MobileTextActionToolbar: Fix TextArea not showing contextual actions
Description:
 The target of the toolbar was typed TextInput, so a TextArea (a TextEdit)
 could not be assigned ("TextArea.qml:92: Unable to assign TextArea to
 QQuickTextInput" for every TextArea) and the toolbar showed no actions
 after a press and hold. Type it as Item; use Qt.inputMethod for the cursor
 rectangles and qualify the ids in the drag handler of the selection handles.
Origin: upstream, https://invent.kde.org/plasma/qqc2-breeze-style/-/commit/6a99f897b6e52911a9c175773e09c9b6e580c3fd
Applied-Upstream: 6.8.2 (Plasma/6.8 cf94142be4053003993c7811eef3dac78772510a)
Bug: https://bugs.kde.org/show_bug.cgi?id=526591
License: LGPL-2.0-or-later (as the patched file)
Last-Update: 2026-11-28
---
diff --git a/style/impl/CursorHandle.qml b/style/impl/CursorHandle.qml
index 8daa50b..18d3c81 100644
--- a/style/impl/CursorHandle.qml
+++ b/style/impl/CursorHandle.qml
@@ -20,10 +20,10 @@ Loader {
     active: visible
     sourceComponent: Kirigami.ShadowedRectangle {
         id: handle
-        property real selectionStartX: Math.floor(InputMethod.anchorRectangle.x + (InputMethod.cursorRectangle.width - width)/2)
-        property real selectionStartY: Math.floor(InputMethod.anchorRectangle.y + InputMethod.cursorRectangle.height + pointyBitVerticalOffset)
-        property real selectionEndX: Math.floor(InputMethod.cursorRectangle.x + (InputMethod.cursorRectangle.width - width)/2)
-        property real selectionEndY: Math.floor(InputMethod.cursorRectangle.y + InputMethod.cursorRectangle.height + pointyBitVerticalOffset)
+        property real selectionStartX: Math.floor(Qt.inputMethod.anchorRectangle.x + (Qt.inputMethod.cursorRectangle.width - width)/2)
+        property real selectionStartY: Math.floor(Qt.inputMethod.anchorRectangle.y + Qt.inputMethod.cursorRectangle.height + pointyBitVerticalOffset)
+        property real selectionEndX: Math.floor(Qt.inputMethod.cursorRectangle.x + (Qt.inputMethod.cursorRectangle.width - width)/2)
+        property real selectionEndY: Math.floor(Qt.inputMethod.cursorRectangle.y + Qt.inputMethod.cursorRectangle.height + pointyBitVerticalOffset)
         property real pointyBitVerticalOffset: Math.abs(pointyBit.y*2)
         parent: Overlay.overlay
         x: root.isSelectionEnd ? selectionEndX : selectionStartX
@@ -80,15 +80,16 @@ Loader {
         }
 
         MouseArea {
+            id: mouseArea
             enabled: handle.visible
             anchors.fill: parent
     //         preventStealing: true
-            onPositionChanged: {
-                let pos = mapToItem(root.target, mouse.x, mouse.y);
+            onPositionChanged: mouse => {
+                let pos = mouseArea.mapToItem(root.target, mouse.x, mouse.y);
                 pos = root.target.positionAt(pos.x, pos.y - handle.height - handle.pointyBitVerticalOffset);
 
-                if (target.selectionStart !== target.selectionEnd) {
-                    if (!isSelectionEnd) {
+                if (root.target.selectionStart !== root.target.selectionEnd) {
+                    if (!root.isSelectionEnd) {
                         root.target.select(Math.min(pos, root.target.selectionEnd - 1), root.target.selectionEnd);
                     } else {
                         root.target.select(root.target.selectionStart, Math.max(pos, root.target.selectionStart + 1));
diff --git a/style/qtquickcontrols/MobileTextActionsToolBar.qml b/style/qtquickcontrols/MobileTextActionsToolBar.qml
index 8add359..deab455 100644
--- a/style/qtquickcontrols/MobileTextActionsToolBar.qml
+++ b/style/qtquickcontrols/MobileTextActionsToolBar.qml
@@ -15,7 +15,7 @@ import org.kde.breeze.impl as Impl
 
 Loader {
     id: root
-    property TextInput target
+    property Item target
     visible: false
     active: visible
 
@@ -38,8 +38,8 @@ Loader {
     sourceComponent: Popup {
         id: popup
 
-        property real xAlignHCenter: Math.round(InputMethod.anchorRectangle.x + (InputMethod.cursorRectangle.x - InputMethod.anchorRectangle.x - width)/2)
-        property real yAlignOver: Math.round(InputMethod.anchorRectangle.y - height - fontMetrics.descent)
+        property real xAlignHCenter: Math.round(Qt.inputMethod.anchorRectangle.x + (Qt.inputMethod.cursorRectangle.x - Qt.inputMethod.anchorRectangle.x - width)/2)
+        property real yAlignOver: Math.round(Qt.inputMethod.anchorRectangle.y - height - fontMetrics.descent)
 
         visible: false
         parent: T.Overlay.overlay
