+/**
+ * fbd_feedback_get_priority:
+ * @self: The feedback
+ *
+ * The priority used when the feedback competes with other feedbacks
+ * for a device: the feedback's priority limited by the cap set with
+ * [method@FbdFeedbackBase.set_priority_cap].
+ *
+ * Returns: The effective priority
+ */
+guint
+fbd_feedback_get_priority (FbdFeedbackBase *self)
+{
+  FbdFeedbackBasePrivate *priv;
+
+  g_return_val_if_fail (FBD_IS_FEEDBACK_BASE (self), 0);
+  priv = fbd_feedback_base_get_instance_private (self);
+
+  return MIN (priv->priority, priv->priority_cap);
+}
+
+/**
+ * fbd_feedback_set_priority_cap:
+ * @self: The feedback
+ * @cap: The highest priority the feedback may use when it runs next
+ *
+ * Limits the priority of the next run, e.g. for events from
+ * applications that may not override other feedback.
+ */
+void
+fbd_feedback_set_priority_cap (FbdFeedbackBase *self, guint cap)
+{
+  FbdFeedbackBasePrivate *priv;
+
+  g_return_if_fail (FBD_IS_FEEDBACK_BASE (self));
+  priv = fbd_feedback_base_get_instance_private (self);
+
+  priv->priority_cap = cap;
+}
