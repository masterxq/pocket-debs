+static char *
+read_attr (GUdevDevice *dev, const char *attr)
+{
+  g_autofree char *path = g_build_filename (g_udev_device_get_sysfs_path (dev), attr, NULL);
+  g_autoptr (GError) err = NULL;
+  char *contents = NULL;
+
+  g_file_get_contents (path, &contents, NULL, &err);
+  g_assert_no_error (err);
+  return contents;
+}
+
+
+static void
+assert_attr (GUdevDevice *dev, const char *attr, const char *expected)
+{
+  g_autofree char *contents = read_attr (dev, attr);
+
+  g_assert_cmpstr (contents, ==, expected);
+}
+
+
+static void
+test_fbd_dev_leds_priority (FbdUmockdevFixture *fixture, gconstpointer unused)
+{
+  GUdevClient *client;
+  g_autolist (GUdevDevice) devs = NULL;
+  g_autoptr (FbdDevLeds) leds = NULL;
+  g_autoptr (GError) err = NULL;
+  GUdevDevice *dev;
+  int low, high, constant;
+
+  client = g_udev_client_new ((const char *const []){ "leds", NULL});
+  devs = g_udev_client_query_by_subsystem (client, "leds");
+  g_assert_cmpint (g_list_length (devs), ==, 1);
+  dev = G_UDEV_DEVICE (devs->data);
+
+  leds = fbd_dev_leds_new (&err);
+  g_assert_no_error (err);
+
+  /* 1 Hz */
+  g_assert_true (fbd_dev_leds_start_periodic (leds, &low, 10, FBD_FEEDBACK_LED_COLOR_BLUE,
+                                              NULL, 100, 1000));
+  assert_attr (dev, "pattern", "0 500 255 500\n");
+
+  /* A higher priority wins */
+  g_assert_true (fbd_dev_leds_start_periodic (leds, &high, 20, FBD_FEEDBACK_LED_COLOR_BLUE,
+                                              NULL, 100, 2000));
+  assert_attr (dev, "pattern", "0 250 255 250\n");
+
+  /* A lower priority waits */
+  g_assert_true (fbd_dev_leds_start_periodic (leds, &constant, 5, FBD_FEEDBACK_LED_COLOR_BLUE,
+                                              NULL, 100, 0));
+  assert_attr (dev, "pattern", "0 250 255 250\n");
+
+  /* The next one is shown again */
+  g_assert_true (fbd_dev_leds_stop (leds, &high));
+  assert_attr (dev, "pattern", "0 500 255 500\n");
+
+  /* A constant light replaces the blink pattern */
+  g_assert_true (fbd_dev_leds_stop (leds, &low));
+  assert_attr (dev, "pattern", "255 1000 255 1000\n");
+
+  g_assert_true (fbd_dev_leds_stop (leds, &constant));
+  assert_attr (dev, "brightness", "0");
+
+  /* Stopping twice is harmless */
+  g_assert_true (fbd_dev_leds_stop (leds, &constant));
+  g_object_unref (client);
+}
+
