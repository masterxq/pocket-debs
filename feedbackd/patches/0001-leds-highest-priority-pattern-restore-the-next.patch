  * #FbdDevLeds is used to interface with all LEDs detected in sysfs
  * It currently only supports one pattern per led at a time.
  */
+/*
+ * A pattern requested for an LED. An LED shows one pattern at a time:
+ * the request with the highest priority, the newest one among equal
+ * priorities. When it ends the next one is shown again.
+ */
+typedef struct {
+  gconstpointer        owner;
+  guint                priority;
+  guint64              serial;
+  FbdDevLed           *led;
+  FbdFeedbackLedColor  color;
+  FbdLedRgbColor       rgb;
+  guint                max_brightness;
+  guint                freq;
+} FbdLedRequest;
+
 typedef struct _FbdDevLeds {
   GObject      parent;
 
   GUdevClient *client;
   GSList      *leds;
+
+  GList       *requests;
+  guint64      next_serial;
+  GHashTable  *shown;  /* FbdDevLed -> FbdLedRequest */
 } FbdDevLeds;
 
 static void initable_iface_init (GInitableIface *iface);
@@ -174,6 +194,9 @@ fbd_dev_leds_dispose (GObject *object)
 {
   FbdDevLeds *self = FBD_DEV_LEDS (object);
 
+  g_clear_pointer (&self->shown, g_hash_table_destroy);
+  g_list_free_full (self->requests, g_free);
+  self->requests = NULL;
   g_clear_object (&self->client);
   g_slist_free_full (self->leds, (GDestroyNotify)g_object_unref);
   self->leds = NULL;
@@ -192,6 +215,61 @@ fbd_dev_leds_class_init (FbdDevLedsClass *klass)
 static void
 fbd_dev_leds_init (FbdDevLeds *self)
 {
+  self->shown = g_hash_table_new (g_direct_hash, g_direct_equal);
+}
+
+
+static FbdLedRequest *
+find_request (FbdDevLeds *self, gconstpointer owner)
+{
+  for (GList *l = self->requests; l; l = l->next) {
+    FbdLedRequest *req = l->data;
+
+    if (req->owner == owner)
+      return req;
+  }
+  return NULL;
+}
+
+
+static void
+remove_request (FbdDevLeds *self, FbdLedRequest *req)
+{
+  if (g_hash_table_lookup (self->shown, req->led) == req)
+    g_hash_table_remove (self->shown, req->led);
+  self->requests = g_list_remove (self->requests, req);
+  g_free (req);
+}
+
+
+/* Show the request that wins on @led, turn it off when there is none */
+static gboolean
+update_led (FbdDevLeds *self, FbdDevLed *led)
+{
+  FbdLedRequest *best = NULL;
+
+  for (GList *l = self->requests; l; l = l->next) {
+    FbdLedRequest *req = l->data;
+
+    if (req->led != led)
+      continue;
+    if (!best || req->priority > best->priority ||
+        (req->priority == best->priority && req->serial > best->serial))
+      best = req;
+  }
+
+  if (best && g_hash_table_lookup (self->shown, led) == best)
+    return TRUE;
+
+  if (!best) {
+    g_hash_table_remove (self->shown, led);
+    return fbd_dev_led_set_brightness (led, 0);
+  }
+
+  g_debug ("LED pattern with priority %u, %u mHz", best->priority, best->freq);
+  g_hash_table_insert (self->shown, led, best);
+  fbd_dev_led_set_color (led, best->color, &best->rgb);
+  return fbd_dev_led_start_periodic (led, best->max_brightness, best->freq);
 }
 
 FbdDevLeds *
@@ -206,20 +284,27 @@ fbd_dev_leds_new (GError **error)
 /**
  * fbd_dev_leds_start_periodic:
  * @self: The #FbdDevLeds
+ * @owner: Identifies the pattern for [method@DevLeds.stop]
+ * @priority: The priority of the pattern
  * @color: The color LED to use for the LED pattern
  * @rgb: The rgb value to set (if `color` indicates an RGB led)
  * @max_brightness_percentage: The max brightness (in percent) to use for the pattern
  * @freq: The pattern's frequency in mHz
  *
- * Start periodic feedback.
+ * Start periodic feedback. The LED shows the pattern unless a pattern
+ * with a higher priority is running on it; a pattern started earlier
+ * by the same owner is replaced.
  */
 gboolean
 fbd_dev_leds_start_periodic (FbdDevLeds          *self,
+                             gconstpointer        owner,
+                             guint                priority,
                              FbdFeedbackLedColor  color,
                              FbdLedRgbColor      *rgb,
                              guint                max_brightness_percentage,
                              guint                freq)
 {
+  FbdLedRequest *req;
   FbdDevLed *led;
 
   g_return_val_if_fail (FBD_IS_DEV_LEDS (self), FALSE);
@@ -230,25 +315,49 @@ fbd_dev_leds_start_periodic (FbdDevLeds          *self,
     return FALSE;
   }
 
-  fbd_dev_led_set_color (led, color, rgb);
-
-  return fbd_dev_led_start_periodic (led, max_brightness_percentage, freq);
+  req = find_request (self, owner);
+  if (req)
+    remove_request (self, req);
+
+  req = g_new0 (FbdLedRequest, 1);
+  req->owner = owner;
+  req->priority = priority;
+  req->serial = self->next_serial++;
+  req->led = led;
+  req->color = color;
+  if (rgb)
+    req->rgb = *rgb;
+  req->max_brightness = max_brightness_percentage;
+  req->freq = freq;
+  self->requests = g_list_prepend (self->requests, req);
+
+  return update_led (self, led);
 }
 
+/**
+ * fbd_dev_leds_stop:
+ * @self: The #FbdDevLeds
+ * @owner: The owner that started the pattern
+ *
+ * Ends the pattern of @owner. If other patterns are requested for the
+ * same LED the one with the highest priority is shown again.
+ */
 gboolean
-fbd_dev_leds_stop (FbdDevLeds *self, FbdFeedbackLedColor color)
+fbd_dev_leds_stop (FbdDevLeds *self, gconstpointer owner)
 {
+  FbdLedRequest *req;
   FbdDevLed *led;
 
   g_return_val_if_fail (FBD_IS_DEV_LEDS (self), FALSE);
 
-  led = find_led_by_color (self, color);
-  if (!led) {
-    g_warning_once ("No usable led found");
-    return FALSE;
-  }
+  req = find_request (self, owner);
+  if (!req)
+    return TRUE;
+
+  led = req->led;
+  remove_request (self, req);
 
-  return fbd_dev_led_set_brightness (led, 0);
+  return update_led (self, led);
 }
 
