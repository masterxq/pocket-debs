 const QString DAEMON_DBUS_SERVICE = QStringLiteral("org.kde.spacebar.Daemon");
@@ -72,6 +77,65 @@ void ChannelHandler::connectInterfaceSignals()
         Q_UNUSED(id);
         Q_EMIT messagesChanged(PhoneNumberList(phoneNumber));
     });
+
+    connect(m_interface, &OrgKdeSpacebarDaemonInterface::simsChanged, this, &ChannelHandler::loadSims);
+    loadSims();
+}
+
+void ChannelHandler::loadSims()
+{
+    auto watcher = new QDBusPendingCallWatcher(m_interface->sims(), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *watcher) {
+        watcher->deleteLater();
+        QDBusPendingReply<StringMapList> reply = *watcher;
+        if (reply.isError()) {
+            return;
+        }
+        QVariantList sims;
+        for (const StringMap &sim : reply.value()) {
+            QVariantMap entry;
+            for (auto it = sim.cbegin(); it != sim.cend(); ++it) {
+                entry.insert(it.key(), it.value());
+            }
+            sims.append(entry);
+        }
+        if (sims != m_sims) {
+            m_sims = sims;
+            Q_EMIT simsChanged();
+        }
+    });
+}
+
+QVariantList ChannelHandler::sims() const
+{
+    return m_sims;
+}
+
+QVariantMap ChannelHandler::sim(const QString &simIdentifier) const
+{
+    for (const QVariant &entry : m_sims) {
+        const QVariantMap sim = entry.toMap();
+        if (!simIdentifier.isEmpty() && sim.value(QStringLiteral("simIdentifier")).toString() == simIdentifier) {
+            return sim;
+        }
+    }
+    return {};
+}
+
+void ChannelHandler::setDefaultSim(const QString &simIdentifier)
+{
+    SettingsManager::self()->setDefaultSim(simIdentifier);
+    SettingsManager::self()->save();
+    Q_EMIT simsChanged();
+}
+
+QString ChannelHandler::defaultSim() const
+{
+    const QString chosen = SettingsManager::self()->defaultSim();
+    if (!sim(chosen).isEmpty()) {
+        return chosen;
+    }
+    return m_sims.isEmpty() ? QString() : m_sims.first().toMap().value(QStringLiteral("simIdentifier")).toString();
 }
 
