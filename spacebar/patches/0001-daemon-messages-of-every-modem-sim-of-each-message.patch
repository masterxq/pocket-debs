+void ModemController::initAllMessaging()
+{
+    for (const auto &device : ModemManager::modemDevices()) {
+        if (!m_slots.contains(device->uni())) {
+            m_slots.insert(device->uni(), 0);
+            loadSimSlot(device->uni());
+        }
+        // the messaging interface of a modem may come later
+        connect(device.get(), &ModemManager::ModemDevice::interfaceAdded, this, &ModemController::initAllMessaging, Qt::UniqueConnection);
+        if (m_msgManagers.contains(device->uni()) || !device->hasInterface(ModemManager::ModemDevice::MessagingInterface)) {
+            continue;
+        }
+        const auto msgManager = device->messagingInterface();
+        m_msgManagers.insert(device->uni(), msgManager);
+        connect(msgManager.get(), &ModemManager::ModemMessaging::messageAdded, this, [this, msgManager](const QString &uni, bool received) {
+            if (!received) {
+                return;
+            }
+            ModemManager::Sms::Ptr msg = msgManager->findMessage(uni);
+            if (msg) {
+                handleNewMessage(msg);
+            }
+        });
+    }
+}
+
+void ModemController::loadSimSlot(const QString &deviceUni)
+{
+    // ModemManagerQt does not expose the SIM slots of a modem yet
+    QDBusMessage message = QDBusMessage::createMethodCall(QStringLiteral("org.freedesktop.ModemManager1"),
+                                                          deviceUni,
+                                                          QStringLiteral("org.freedesktop.DBus.Properties"),
+                                                          QStringLiteral("GetAll"));
+    message << QStringLiteral("org.freedesktop.ModemManager1.Modem");
+
+    QPointer<ModemController> self{this};
+    auto watcher = new QDBusPendingCallWatcher(QDBusConnection::systemBus().asyncCall(message), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [self, deviceUni](QDBusPendingCallWatcher *watcher) {
+        watcher->deleteLater();
+        QDBusPendingReply<QVariantMap> reply = *watcher;
+        if (!self || reply.isError()) {
+            return;
+        }
+        QList<QDBusObjectPath> simSlots;
+        const QVariant simSlotsValue = reply.value().value(QStringLiteral("SimSlots"));
+        if (simSlotsValue.canConvert<QDBusArgument>()) {
+            simSlotsValue.value<QDBusArgument>() >> simSlots;
+        }
+        const uint primary = reply.value().value(QStringLiteral("PrimarySimSlot")).toUInt();
+        self->m_slots.insert(deviceUni, (primary > 0 && primary <= uint(simSlots.size())) ? int(primary) : 0);
+        Q_EMIT self->simsChanged();
+    });
+}
+
+QString ModemController::simForMessage(const QString &uni) const
+{
+    for (auto it = m_msgManagers.cbegin(); it != m_msgManagers.cend(); ++it) {
+        if (it.value()->findMessage(uni)) {
+            const auto device = ModemManager::findModemDevice(it.key());
+            return (device && device->sim()) ? device->sim()->simIdentifier() : QString();
+        }
+    }
+    return {};
+}
+
+QString ModemController::defaultSimIdentifier() const
+{
+    return (m_modem && m_modem->sim()) ? m_modem->sim()->simIdentifier() : QString();
+}
+
+QList<QMap<QString, QString>> ModemController::sims() const
+{
+    QList<QMap<QString, QString>> sims;
+    for (const auto &device : ModemManager::modemDevices()) {
+        const auto sim = device->sim();
+        if (!sim || sim->uni() == QStringLiteral("/")) {
+            continue;
+        }
+        const int slot = m_slots.value(device->uni());
+        QString name;
+        if (slot > 0) {
+            name = i18nc("@label name of a SIM card after its slot", "SIM %1", slot);
+        } else if (!sim->operatorName().isEmpty()) {
+            name = sim->operatorName();
+        } else {
+            name = i18nc("@label name of a SIM card", "SIM");
+        }
+        sims.append({
+            {QStringLiteral("simIdentifier"), sim->simIdentifier()},
+            {QStringLiteral("deviceUni"), device->uni()},
+            {QStringLiteral("slot"), QString::number(slot)},
+            {QStringLiteral("name"), name},
+            {QStringLiteral("icon"), SimIdentities::instance()->icon(sim->simIdentifier())},
+        });
+    }
+    // in the order of the SIM slots, SIMs without a known slot last
+    std::stable_sort(sims.begin(), sims.end(), [](const auto &a, const auto &b) {
+        const int slotA = a.value(QStringLiteral("slot")).toInt();
+        const int slotB = b.value(QStringLiteral("slot")).toInt();
+        return (slotA > 0 ? slotA : INT_MAX) < (slotB > 0 ? slotB : INT_MAX);
+    });
+    return sims;
+}
