+/*
+    SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+
+    SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+*/
+
+#pragma once
+
+#include <QObject>
+#include <QString>
+#include <QStringList>
+
+#include <KConfigWatcher>
+#include <KSharedConfig>
+
+/**
+ * Icons of the SIM cards, shared by all applications that show a SIM.
+ *
+ * Each SIM card is identified by its ICCID (the SIM identifier reported by
+ * ModemManager) and gets one icon out of a fixed set. A SIM that is seen for
+ * the first time is given the first icon of the set that no known SIM has
+ * (when all are in use, the least used one, earlier ones first), and the
+ * choice is stored at once, so every application shows the same icon.
+ *
+ * The SIM used for calls and text messages by default is stored by its
+ * ICCID as well.
+ *
+ * Storage: simidentitiesrc in the configuration directory, one group per SIM
+ * below the group "Sim", named after the ICCID, with the entry Icon; the
+ * default SIM for calls and text messages in the entry Sim of the group
+ * "Defaults". Writes are notified, so that other processes follow at once.
+ */
+class SimIdentities : public QObject
+{
+    Q_OBJECT
+
+public:
+    static SimIdentities *instance();
+
+    /** The icons a SIM can have, in the order they are given to new SIMs. */
+    static QStringList icons();
+
+    /** Icon of the SIM; a SIM not known yet is given and stored an icon. Empty for an empty identifier. */
+    QString icon(const QString &simIdentifier);
+
+    /** Stores the icon chosen for the SIM. */
+    void setIcon(const QString &simIdentifier, const QString &icon);
+
+    /** Identifier of the SIM chosen for calls and text messages, empty if none was chosen. */
+    QString defaultSim() const;
+
+    /** Stores the SIM chosen for calls and text messages. */
+    void setDefaultSim(const QString &simIdentifier);
+
+Q_SIGNALS:
+    /** An icon or the default SIM changed, in this or another process. */
+    void changed();
+
+private:
+    SimIdentities();
+
+    KConfigGroup simGroup(const QString &simIdentifier) const;
+    QString defaultIcon() const;
+    // writes the entry if it differs, returns whether it was written
+    bool writeEntry(KConfigGroup group, const QString &key, const QString &value);
+
+    KSharedConfig::Ptr m_config;
+    KConfigWatcher::Ptr m_watcher;
+};
