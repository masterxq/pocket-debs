+
+msgctxt "@action:button"
+msgid "Edit contact"
+msgstr "Kontakt bearbeiten"
+
+msgctxt "@action:button"
+msgid "Call"
+msgstr "Anrufen"
+
+msgctxt "@action:button"
+msgid "Call back"
+msgstr "Zurückrufen"
+
