@@ -0,0 +1,43 @@
+// SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+// SPDX-License-Identifier: LGPL-2.0-or-later
+
+import QtQuick
+import QtQuick.Controls as Controls
+import org.kde.kirigami as Kirigami
+
+// Flat icon button at the end of a list row. The icon is drawn in the text
+// colour; the button is at least two and a half grid units wide and high, a
+// touch target as Kirigami asks for.
+Controls.ToolButton {
+    id: button
+
+    // icon name, drawn as mask in the text colour
+    property string iconSource: "call-start"
+    // size of the icon
+    property real iconSize: Kirigami.Units.iconSizes.smallMedium
+
+    display: Controls.AbstractButton.IconOnly
+    implicitWidth: Math.max(Kirigami.Units.gridUnit * 2.5, iconSize + leftPadding + rightPadding)
+    implicitHeight: implicitWidth
+    Accessible.name: text
+    Controls.ToolTip.text: text
+    Controls.ToolTip.visible: hovered
+    Controls.ToolTip.delay: Kirigami.Units.toolTipDelay
+
+    contentItem: Item {
+        implicitWidth: button.iconSize
+        implicitHeight: button.iconSize
+
+        Kirigami.Icon {
+            id: icon
+
+            anchors.centerIn: parent
+            width: button.iconSize
+            height: button.iconSize
+            source: button.iconSource
+            isMask: true
+            color: Kirigami.Theme.textColor
+            opacity: button.enabled ? 1 : 0.4
+        }
+    }
+}
