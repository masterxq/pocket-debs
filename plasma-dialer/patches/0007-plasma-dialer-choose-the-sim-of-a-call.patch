+}
+
+KConfigGroup SimIdentities::simGroup(const QString &simIdentifier) const
+{
+    return KConfigGroup(m_config, s_simsGroup).group(simIdentifier);
+}
+
+QString SimIdentities::defaultIcon() const
+{
+    const QStringList candidates = icons();
+    QHash<QString, int> uses;
+    const KConfigGroup sims(m_config, s_simsGroup);
+    for (const QString &sim : sims.groupList()) {
+        uses[sims.group(sim).readEntry(s_iconKey, QString())]++;
+    }
+
+    QString best = candidates.first();
+    for (const QString &candidate : candidates) {
+        if (uses.value(candidate) < uses.value(best)) {
+            best = candidate;
+        }
+    }
+    return best;
+}
+
+QString SimIdentities::icon(const QString &simIdentifier)
+{
+    if (simIdentifier.isEmpty()) {
+        return {};
+    }
+
+    QString icon = simGroup(simIdentifier).readEntry(s_iconKey, QString());
+    if (!icon.isEmpty()) {
+        return icon;
+    }
+
+    // another process may have given the SIM its icon since the file was read
+    m_config->reparseConfiguration();
+    icon = simGroup(simIdentifier).readEntry(s_iconKey, QString());
+    if (!icon.isEmpty()) {
+        return icon;
+    }
+
+    // stored at once, so that the SIM keeps the icon; changed() is not emitted here, since
+    // this is called from property getters: the icons of other SIMs stay as they are
+    icon = defaultIcon();
+    writeEntry(simGroup(simIdentifier), s_iconKey, icon);
+    return icon;
+}
+
+void SimIdentities::setIcon(const QString &simIdentifier, const QString &icon)
+{
+    if (simIdentifier.isEmpty() || icon.isEmpty()) {
+        return;
+    }
+
+    if (writeEntry(simGroup(simIdentifier), s_iconKey, icon)) {
+        Q_EMIT changed();
+    }
+}
+
+QString SimIdentities::defaultSim() const
+{
+    return KConfigGroup(m_config, s_defaultsGroup).readEntry(s_defaultSimKey, QString());
+}
+
+void SimIdentities::setDefaultSim(const QString &simIdentifier)
+{
+    if (simIdentifier.isEmpty()) {
+        return;
+    }
+
+    if (writeEntry(KConfigGroup(m_config, s_defaultsGroup), s_defaultSimKey, simIdentifier)) {
+        Q_EMIT changed();
+    }
+}
+
+bool SimIdentities::writeEntry(KConfigGroup group, const QString &key, const QString &value)
+{
+    if (group.readEntry(key, QString()) == value) {
+        return false;
+    }
+    group.writeEntry(key, value, KConfig::Notify);
+    m_config->sync();
+    return true;
+}
