+import QtQuick
+import QtQuick.Controls as Controls
+import org.kde.kirigami as Kirigami
+
+// Round call button. With several SIMs it carries a badge with the icon of
+// the SIM the call goes through (or three dots for a choice of SIMs).
+Controls.AbstractButton {
+    id: button
+
+    // tinted look for a call through a SIM other than the default one
+    property bool secondary: false
+    // icon of the SIM in the badge, empty for no badge
+    property string simIcon: ""
+    // three dots in the badge instead of a SIM icon
+    property bool showChoice: false
+
+    readonly property real diameter: Math.min(width, height)
+    readonly property bool showBadge: simIcon !== "" || showChoice
+
+    Accessible.role: Accessible.Button
+
+    background: Item {
+        Rectangle {
+            id: circle
+
+            anchors.centerIn: parent
+            width: button.diameter
+            height: width
+            radius: width / 2
+            color: button.secondary ? Qt.alpha(Kirigami.Theme.highlightColor, 0.18) : Kirigami.Theme.highlightColor
+            opacity: button.pressed ? 0.7 : 1
+
+            Kirigami.Icon {
+                anchors.fill: parent
+                anchors.margins: parent.width * (button.secondary ? 0.27 : 0.28)
+                source: "call-start"
+                color: button.secondary ? Kirigami.Theme.highlightColor : "white"
+                isMask: true
+            }
+        }
+
+        SimBadge {
+            visible: button.showBadge
+            size: Math.round(button.diameter * (button.secondary ? 28 / 52 : 32 / 68))
+            discSize: Math.round(button.diameter * (button.secondary ? 26 / 52 : 28 / 68))
+            iconSize: Math.round(button.diameter * (button.secondary ? 17 / 52 : 18 / 68))
+            x: circle.x + circle.width - width + Math.round(button.diameter * 7 / 68)
+            y: circle.y + circle.height - height + Math.round(button.diameter * 7 / 68)
+            simIcon: button.simIcon
+            showChoice: button.showChoice
+        }
+    }
+}
