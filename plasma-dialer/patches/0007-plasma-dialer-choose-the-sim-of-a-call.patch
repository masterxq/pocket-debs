+// SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+//
+// SPDX-License-Identifier: LGPL-2.0-or-later
+
+#include "simutils.h"
+
+#include "simidentities.h"
+
+#include <KLocalizedString>
+
+#include <ModemManagerQt/Manager>
+#include <ModemManagerQt/ModemDevice>
+#include <ModemManagerQt/Sim>
+
+#include <QDBusArgument>
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusObjectPath>
+#include <QDBusPendingCallWatcher>
+#include <QDBusPendingReply>
+#include <QPointer>
+
+#include <algorithm>
+
+using namespace Qt::Literals::StringLiterals;
+
+SimUtils::SimUtils(QObject *parent)
+    : QObject(parent)
+{
+    connect(ModemManager::notifier(), &ModemManager::Notifier::modemAdded, this, &SimUtils::update);
+    connect(ModemManager::notifier(), &ModemManager::Notifier::modemRemoved, this, &SimUtils::update);
+    // an icon or the default SIM changed
+    connect(SimIdentities::instance(), &SimIdentities::changed, this, [this]() {
+        update();
+        Q_EMIT defaultSimChanged();
+    });
+    update();
+}
+
+void SimUtils::loadSimSlot(const QString &deviceUni)
+{
+    // ModemManagerQt does not expose the SIM slots of a modem yet
+    QDBusMessage message =
+        QDBusMessage::createMethodCall(u"org.freedesktop.ModemManager1"_s, deviceUni, u"org.freedesktop.DBus.Properties"_s, u"GetAll"_s);
+    message << u"org.freedesktop.ModemManager1.Modem"_s;
+
+    QPointer<SimUtils> self{this};
+    auto watcher = new QDBusPendingCallWatcher(QDBusConnection::systemBus().asyncCall(message), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [self, deviceUni](QDBusPendingCallWatcher *watcher) {
+        watcher->deleteLater();
+        QDBusPendingReply<QVariantMap> reply = *watcher;
+        if (!self || reply.isError()) {
+            return;
+        }
+
+        QList<QDBusObjectPath> simSlots;
+        const QVariant simSlotsValue = reply.value().value(u"SimSlots"_s);
+        if (simSlotsValue.canConvert<QDBusArgument>()) {
+            simSlotsValue.value<QDBusArgument>() >> simSlots;
+        }
+        const uint primary = reply.value().value(u"PrimarySimSlot"_s).toUInt();
+        const int slot = (primary > 0 && primary <= uint(simSlots.size())) ? int(primary) : 0;
+        if (self->m_slots.value(deviceUni, -1) != slot) {
+            self->m_slots.insert(deviceUni, slot);
+            self->update();
+        }
+    });
+}
+
+void SimUtils::update()
+{
+    QVariantList sims;
+    for (const auto &device : ModemManager::modemDevices()) {
+        const auto sim = device->sim();
+        if (!sim || sim->uni() == u"/"_s) {
+            continue;
+        }
+        connect(sim.data(), &ModemManager::Sim::simIdentifierChanged, this, &SimUtils::update, Qt::UniqueConnection);
+        connect(sim.data(), &ModemManager::Sim::operatorNameChanged, this, &SimUtils::update, Qt::UniqueConnection);
+
+        if (!m_slots.contains(device->uni())) {
+            m_slots.insert(device->uni(), 0);
+            loadSimSlot(device->uni());
+        }
+        const int slot = m_slots.value(device->uni());
+
+        QString name;
+        if (slot > 0) {
+            name = i18nc("@label name of a SIM card after its slot", "SIM %1", slot);
+        } else if (!sim->operatorName().isEmpty()) {
+            name = sim->operatorName();
+        } else {
+            name = i18nc("@label name of a SIM card", "SIM");
+        }
+
+        QVariantMap entry;
+        entry[u"deviceUni"_s] = device->uni();
+        entry[u"simIdentifier"_s] = sim->simIdentifier();
+        entry[u"slot"_s] = slot;
+        entry[u"name"_s] = name;
+        entry[u"icon"_s] = SimIdentities::instance()->icon(sim->simIdentifier());
+        entry[u"operatorName"_s] = sim->operatorName();
+        sims.append(entry);
+    }
+
+    // in the order of the SIM slots, SIMs without a known slot last
+    std::stable_sort(sims.begin(), sims.end(), [](const QVariant &a, const QVariant &b) {
+        const int slotA = a.toMap().value(u"slot"_s).toInt();
+        const int slotB = b.toMap().value(u"slot"_s).toInt();
+        return (slotA > 0 ? slotA : INT_MAX) < (slotB > 0 ? slotB : INT_MAX);
+    });
+
+    if (sims != m_sims) {
+        m_sims = sims;
+        Q_EMIT simsChanged();
+        Q_EMIT defaultSimChanged();
+    }
+}
+
+QVariantList SimUtils::sims() const
+{
+    return m_sims;
+}
+
+QString SimUtils::defaultSimIdentifier() const
+{
+    const QString chosen = SimIdentities::instance()->defaultSim();
+    if (!chosen.isEmpty() && !deviceForSim(chosen).isEmpty()) {
+        return chosen;
+    }
+    return m_sims.isEmpty() ? QString() : m_sims.first().toMap().value(u"simIdentifier"_s).toString();
+}
+
+void SimUtils::setDefaultSimIdentifier(const QString &simIdentifier)
+{
+    // shared with the other applications, SimIdentities::changed updates the SIMs
+    SimIdentities::instance()->setDefaultSim(simIdentifier);
+}
+
+QString SimUtils::defaultDeviceUni() const
+{
+    const QString device = deviceForSim(defaultSimIdentifier());
+    if (!device.isEmpty()) {
+        return device;
+    }
+    // a modem whose SIM has no identifier (yet)
+    return m_sims.isEmpty() ? QString() : m_sims.first().toMap().value(u"deviceUni"_s).toString();
+}
+
+QString SimUtils::deviceForSim(const QString &simIdentifier) const
+{
+    if (simIdentifier.isEmpty()) {
+        return {};
+    }
+    for (const auto &entry : m_sims) {
+        const QVariantMap sim = entry.toMap();
+        if (sim.value(u"simIdentifier"_s).toString() == simIdentifier) {
+            return sim.value(u"deviceUni"_s).toString();
+        }
+    }
+    return {};
+}
+
+QVariantMap SimUtils::simForDevice(const QString &deviceUni) const
+{
+    for (const auto &entry : m_sims) {
+        const QVariantMap sim = entry.toMap();
+        if (sim.value(u"deviceUni"_s).toString() == deviceUni) {
+            return sim;
+        }
+    }
+    return {};
+}
+
+QString SimUtils::iconForSim(const QString &simIdentifier) const
+{
+    return SimIdentities::instance()->icon(simIdentifier);
+}
