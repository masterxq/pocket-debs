+// SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+// SPDX-License-Identifier: LGPL-2.0-or-later
+
+import QtQuick
+import org.kde.kirigami as Kirigami
+
+// Badge with the icon of a SIM (or three dots for a choice of SIMs), placed
+// on a call button: ring in the window colour, disc, icon. With contrast the
+// disc has the text colour and the icon the window colour, for badges on
+// symbols in the text colour (list rows).
+Rectangle {
+    id: badge
+
+    // icon of the SIM
+    property string simIcon: ""
+    // three dots instead of a SIM icon
+    property bool showChoice: false
+    // disc in the text colour, icon in the window colour
+    property bool contrast: false
+    // outer diameter, diameter of the disc and size of the icon
+    property real size: Kirigami.Units.iconSizes.small
+    property real discSize: size - 2
+    property real iconSize: Math.round(discSize * 0.65)
+
+    width: size
+    height: size
+    radius: width / 2
+    color: Kirigami.Theme.backgroundColor
+
+    Rectangle {
+        anchors.centerIn: parent
+        width: badge.discSize
+        height: width
+        radius: width / 2
+        color: badge.contrast ? Kirigami.Theme.textColor : Kirigami.ColorUtils.linearInterpolation(Kirigami.Theme.backgroundColor, Kirigami.Theme.textColor, 0.12)
+
+        Kirigami.Icon {
+            anchors.centerIn: parent
+            width: badge.iconSize
+            height: width
+            source: badge.showChoice ? "overflow-menu" : badge.simIcon
+            color: badge.contrast ? Kirigami.Theme.backgroundColor : Kirigami.Theme.textColor
+            isMask: true
+        }
+    }
+}
