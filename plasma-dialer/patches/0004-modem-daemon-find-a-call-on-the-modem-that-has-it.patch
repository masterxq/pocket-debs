+QSharedPointer<ModemManager::Call> ModemManagerController::findVoiceCall(const QString &deviceUni, const QString &callUni)
+{
+    // call paths are unique among all modems: a call is found also when the
+    // client does not know the modem of the call (several modems)
+    const auto modem = ModemManager::findModemDevice(deviceUni);
+    if (!modem.isNull()) {
+        const auto voiceInterface = this->voiceInterface(modem);
+        if (!voiceInterface.isNull()) {
+            const auto call = voiceInterface->findCall(callUni);
+            if (!call.isNull()) {
+                return call;
+            }
+        }
+    }
+    for (const auto &device : ModemManager::modemDevices()) {
+        const auto voiceInterface = this->voiceInterface(device);
+        if (voiceInterface.isNull()) {
+            continue;
+        }
+        const auto call = voiceInterface->findCall(callUni);
+        if (!call.isNull()) {
+            return call;
+        }
+    }
+    return {};
+}
+
 CallObject *ModemManagerController::getVoiceCallObject(const QString &deviceUni, const QString &callUni)
 {
     Q_UNUSED(deviceUni);
