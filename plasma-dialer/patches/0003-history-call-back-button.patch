From: pocket-debs <masterxq@users.noreply.github.com>
Date: Tue, 25 Nov 2026 12:00:00 +0100
Subject: [PATCH] history: a button to call back
Description:
 Each entry of the call history gets a flat button that calls the number
 back right away; a tap on the entry still puts the number into the dial
 pad.
Forwarded: no
License: LGPL-2.0-or-later (as the patched file)
Last-Update: 2026-11-25
---
--- a/plasma-dialer/src/qml/history/HistoryDelegate.qml
+++ b/plasma-dialer/src/qml/history/HistoryDelegate.qml
@@ -71,6 +71,20 @@ Controls.ItemDelegate {
 
         }
 
+        // a tap on the entry puts the number into the dial pad, this calls it right away
+        Controls.ToolButton {
+            id: callBackButton
+
+            display: Controls.AbstractButton.IconOnly
+            icon.name: "call-start"
+            text: i18nc("@action:button", "Call back")
+            enabled: model.communicationWith.length > 0
+            onClicked: CallUtils.dial(applicationWindow().selectModem(), model.communicationWith)
+            Controls.ToolTip.text: text
+            Controls.ToolTip.visible: hovered
+            Controls.ToolTip.delay: Kirigami.Units.toolTipDelay
+        }
+
     }
 
 }
