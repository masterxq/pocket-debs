+++ b/plasma-dialer/src/contacteditor.h
@@ -0,0 +1,42 @@
+// SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+// SPDX-License-Identifier: LGPL-2.0-or-later
+
+#pragma once
+
+#include <QObject>
+#include <QStringList>
+#include <QUrl>
+#include <QVariantMap>
+#include <qqmlregistration.h>
+
+/**
+ * Reads and writes the name, the phone numbers and the photo of a contact.
+ *
+ * The contact is stored as vCard through KPeople, as Plasma Phonebook does;
+ * properties that the dialer does not edit (e-mail addresses, birthday, ...)
+ * are kept when an existing contact is saved.
+ */
+class ContactEditor : public QObject
+{
+    Q_OBJECT
+    QML_ELEMENT
+    QML_SINGLETON
+
+public:
+    explicit ContactEditor(QObject *parent = nullptr);
+
+    /**
+     * The contact with the KPeople URI personUri: name, phoneNumbers (list of
+     * strings), hasPhoto and editable. An empty URI gives an empty, editable
+     * contact.
+     */
+    Q_INVOKABLE QVariantMap contact(const QString &personUri) const;
+
+    /**
+     * Adds a contact (empty personUri) or changes the contact personUri.
+     * photo is an image file that becomes the photo of the contact, scaled
+     * down; with removePhoto the contact loses its photo. Returns whether the
+     * contact was stored.
+     */
+    Q_INVOKABLE bool save(const QString &personUri, const QString &name, const QStringList &phoneNumbers, const QUrl &photo, bool removePhoto);
+};
