+// SPDX-FileCopyrightText: 2019 Nicolas Fella <nicolas.fella@gmx.de>
+// SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+// SPDX-License-Identifier: LGPL-2.0-or-later
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Controls as Controls
+import QtQuick.Dialogs
+import QtQuick.Layouts
+import QtQuick.Templates as T
+
+import org.kde.kirigami as Kirigami
+import org.kde.kirigamiaddons.components as Components
+import org.kde.kirigamiaddons.formcard as FormCard
+import org.kde.telephony
+import org.kde.plasma.dialer
+
+// Name, photo and phone numbers of a contact, laid out as in Plasma Phonebook.
+// A tap on a number puts it into the dial pad.
+FormCard.FormCardPage {
+    id: root
+
+    // KPeople URI of the contact, empty for a new contact
+    property string personUri
+    // phone number of a new contact
+    property string newNumber
+
+    readonly property var contact: ContactEditor.contact(personUri)
+    readonly property bool editable: contact.editable
+    property list<string> pendingNumbers
+    // image file chosen as new photo
+    property url pendingPhoto
+    property bool photoRemoved: false
+    readonly property bool hasPhoto: pendingPhoto.toString() !== "" || (contact.hasPhoto && !photoRemoved)
+
+    // the number goes to the dial pad, the view closes
+    function useNumber(number) {
+        const window = applicationWindow();
+        root.Kirigami.PageStack.closeDialog();
+        window.call(number);
+    }
+
+    function save() {
+        let numbers = root.pendingNumbers.slice();
+        const extraNumber = addNumberField.text.trim();
+        if (extraNumber !== "") {
+            numbers.push(extraNumber);
+        }
+        if (ContactEditor.save(root.personUri, nameField.text, numbers, root.pendingPhoto, root.photoRemoved)) {
+            root.Kirigami.PageStack.closeDialog();
+        } else {
+            saveError.visible = true;
+        }
+    }
+
+    title: personUri === "" ? i18nc("@title", "New Contact") : i18nc("@title", "Edit Contact")
+
+    Component.onCompleted: {
+        if (personUri === "") {
+            pendingNumbers = newNumber !== "" ? [newNumber] : [];
+            nameField.forceActiveFocus();
+        } else {
+            pendingNumbers = contact.phoneNumbers;
+        }
+    }
+
+    Controls.RoundButton {
+        Layout.alignment: Qt.AlignHCenter
+        Layout.topMargin: Kirigami.Units.gridUnit
+
+        implicitWidth: Kirigami.Units.gridUnit * 5
+        implicitHeight: implicitWidth
+        enabled: root.editable
+        Accessible.name: root.hasPhoto ? i18nc("@action:button", "Change photo") : i18nc("@action:button", "Add photo")
+
+        contentItem: Components.Avatar {
+            source: {
+                if (root.pendingPhoto.toString() !== "") {
+                    return root.pendingPhoto;
+                }
+                if (root.contact.hasPhoto && !root.photoRemoved) {
+                    return ContactUtils.photoImageProviderUri(root.personUri);
+                }
+                return "";
+            }
+            name: nameField.text
+            imageMode: Components.Avatar.ImageMode.AdaptiveImageOrInitals
+        }
+
+        onClicked: fileDialog.open()
+
+        FileDialog {
+            id: fileDialog
+
+            title: i18nc("@title:window", "Choose a Photo")
+            nameFilters: [i18nc("@item:inlistbox file type", "Images (*.png *.jpg *.jpeg *.webp *.bmp)")]
+            onAccepted: {
+                root.pendingPhoto = selectedFile;
+                root.photoRemoved = false;
+            }
+        }
+    }
+
+    Controls.Label {
+        Layout.alignment: Qt.AlignHCenter
+        visible: !root.hasPhoto && root.editable
+        color: Kirigami.Theme.disabledTextColor
+        text: i18n("Add profile picture")
+    }
+
+    Controls.ToolButton {
+        Layout.alignment: Qt.AlignHCenter
+        visible: root.hasPhoto && root.editable
+        icon.name: "edit-delete-remove"
+        text: i18nc("@action:button", "Remove photo")
+        onClicked: {
+            root.pendingPhoto = "";
+            root.photoRemoved = true;
+        }
+    }
+
+    Kirigami.InlineMessage {
+        id: saveError
+
+        Layout.fillWidth: true
+        Layout.topMargin: Kirigami.Units.largeSpacing
+        Layout.leftMargin: Kirigami.Units.largeSpacing
+        Layout.rightMargin: Kirigami.Units.largeSpacing
+        type: Kirigami.MessageType.Error
+        text: i18n("The contact could not be saved.")
+    }
+
+    FormCard.FormCard {
+        Layout.topMargin: Kirigami.Units.largeSpacing
+
+        FormCard.FormTextFieldDelegate {
+            id: nameField
+
+            label: i18n("Name")
+            text: root.contact.name
+            enabled: root.editable
+        }
+    }
+
+    FormCard.FormCard {
+        Layout.topMargin: Kirigami.Units.largeSpacing
+
+        Repeater {
+            model: root.pendingNumbers
+
+            delegate: FormCard.AbstractFormDelegate {
+                id: numberDelegate
+
+                required property string modelData
+                required property int index
+
+                Accessible.name: i18nc("@action:button %1 is a phone number", "Put %1 into the dial pad", modelData)
+                onClicked: root.useNumber(modelData)
+
+                contentItem: RowLayout {
+                    spacing: Kirigami.Units.largeSpacing
+
+                    Kirigami.Icon {
+                        Layout.preferredWidth: Kirigami.Units.iconSizes.smallMedium
+                        Layout.preferredHeight: Kirigami.Units.iconSizes.smallMedium
+                        source: "phone-symbolic"
+                    }
+
+                    ColumnLayout {
+                        Layout.fillWidth: true
+                        spacing: 0
+
+                        Controls.Label {
+                            Layout.fillWidth: true
+                            text: CallUtils.formatNumber(numberDelegate.modelData)
+                            elide: Text.ElideRight
+                        }
+
+                        Controls.Label {
+                            Layout.fillWidth: true
+                            text: i18nc("@info a tap on a phone number", "Tap to put into the dial pad")
+                            font: Kirigami.Theme.smallFont
+                            color: Kirigami.Theme.disabledTextColor
+                            elide: Text.ElideRight
+                        }
+                    }
+
+                    Controls.ToolButton {
+                        visible: root.editable
+                        display: Controls.AbstractButton.IconOnly
+                        icon.name: "list-remove"
+                        text: i18nc("@action:button", "Remove number")
+                        onClicked: root.pendingNumbers = root.pendingNumbers.filter((number, index) => index !== numberDelegate.index)
+                        Controls.ToolTip.text: text
+                        Controls.ToolTip.visible: hovered
+                        Controls.ToolTip.delay: Kirigami.Units.toolTipDelay
+                    }
+                }
+            }
+        }
+
+        FormCard.FormTextFieldDelegate {
+            id: addNumberField
+
+            visible: root.editable
+            label: i18n("Phone")
+            inputMethodHints: Qt.ImhDialableCharactersOnly
+            onAccepted: addNumber.clicked()
+        }
+
+        FormCard.FormDelegateSeparator {
+            visible: root.editable
+            above: addNumber
+        }
+
+        FormCard.FormButtonDelegate {
+            id: addNumber
+
+            visible: root.editable
+            enabled: addNumberField.text.trim().length > 0
+            text: i18n("Add phone number")
+            icon.name: "list-add"
+            onClicked: {
+                root.pendingNumbers = root.pendingNumbers.concat([addNumberField.text.trim()]);
+                addNumberField.text = "";
+            }
+        }
+    }
+
+    footer: T.Control {
+        implicitWidth: Math.max(implicitBackgroundWidth + leftInset + rightInset, implicitContentWidth + leftPadding + rightPadding)
+        implicitHeight: Math.max(implicitBackgroundHeight + topInset + bottomInset, implicitContentHeight + topPadding + bottomPadding)
+
+        leftPadding: Kirigami.Units.smallSpacing
+        rightPadding: Kirigami.Units.smallSpacing
+        bottomPadding: Kirigami.Units.smallSpacing
+        topPadding: Kirigami.Units.smallSpacing + footerSeparator.implicitHeight
+
+        contentItem: Controls.DialogButtonBox {
+            id: buttonBox
+
+            standardButtons: root.editable ? Controls.DialogButtonBox.Cancel | Controls.DialogButtonBox.Save : Controls.DialogButtonBox.Close
+            position: Controls.DialogButtonBox.Footer
+            onAccepted: root.save()
+            onRejected: root.Kirigami.PageStack.closeDialog()
+
+            Component.onCompleted: {
+                const saveButton = standardButton(Controls.DialogButtonBox.Save);
+                if (saveButton) {
+                    saveButton.enabled = Qt.binding(() => nameField.text.trim().length > 0 || root.pendingNumbers.length > 0 || addNumberField.text.trim().length > 0);
+                }
+            }
+        }
+
+        background: Item {
+            Kirigami.Separator {
+                id: footerSeparator
+
+                width: parent.width
+                anchors.top: parent.top
+            }
+        }
+    }
+}
