+// SPDX-FileCopyrightText: 2021 Nicolas Fella <nicolas.fella@gmx.de>
+// SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+// SPDX-License-Identifier: LGPL-2.0-or-later
+
+#include "contacteditor.h"
+
+#include <KContacts/Addressee>
+#include <KContacts/PhoneNumber>
+#include <KContacts/Picture>
+#include <KContacts/VCardConverter>
+#include <KPeople/PersonData>
+#include <KPeople/PersonPluginManager>
+
+#include <QDebug>
+#include <QGuiApplication>
+#include <QImage>
+
+#include <algorithm>
+
+using namespace Qt::Literals::StringLiterals;
+
+// property of a KPeople contact that holds its vCard
+static const QString vCardProperty = u"vcard"_s;
+
+static KContacts::Addressee addresseeOf(const KPeople::PersonData &person)
+{
+    static const KContacts::VCardConverter converter;
+    return converter.parseVCard(person.contactCustomProperty(vCardProperty).toByteArray());
+}
+
+ContactEditor::ContactEditor(QObject *parent)
+    : QObject(parent)
+{
+}
+
+QVariantMap ContactEditor::contact(const QString &personUri) const
+{
+    QVariantMap contact;
+    if (personUri.isEmpty()) {
+        contact[u"name"_s] = QString();
+        contact[u"phoneNumbers"_s] = QStringList();
+        contact[u"hasPhoto"_s] = false;
+        contact[u"editable"_s] = true;
+        return contact;
+    }
+
+    const KPeople::PersonData person(personUri);
+    const KContacts::Addressee addressee = addresseeOf(person);
+    QStringList phoneNumbers;
+    for (const auto &phoneNumber : addressee.phoneNumbers()) {
+        phoneNumbers.append(phoneNumber.number());
+    }
+    contact[u"name"_s] = addressee.isEmpty() ? person.name() : addressee.formattedName();
+    contact[u"phoneNumbers"_s] = phoneNumbers;
+    contact[u"hasPhoto"_s] = !addressee.photo().isEmpty();
+    contact[u"editable"_s] = person.isEditable();
+    return contact;
+}
+
+bool ContactEditor::save(const QString &personUri, const QString &name, const QStringList &phoneNumbers, const QUrl &photo, bool removePhoto)
+{
+    static const KContacts::VCardConverter converter;
+
+    KContacts::Addressee addressee;
+    KPeople::PersonData *person = nullptr;
+    if (!personUri.isEmpty()) {
+        person = new KPeople::PersonData(personUri, this);
+        addressee = addresseeOf(*person);
+    }
+
+    addressee.setFormattedName(name.trimmed());
+
+    // numbers that stay keep their type, new ones are mobile numbers
+    const KContacts::PhoneNumber::List oldNumbers = addressee.phoneNumbers();
+    KContacts::PhoneNumber::List newNumbers;
+    for (const QString &number : phoneNumbers) {
+        const QString trimmed = number.trimmed();
+        if (trimmed.isEmpty()) {
+            continue;
+        }
+        const auto old = std::find_if(oldNumbers.cbegin(), oldNumbers.cend(), [&trimmed](const KContacts::PhoneNumber &phoneNumber) {
+            return phoneNumber.number() == trimmed;
+        });
+        if (old != oldNumbers.cend()) {
+            newNumbers.append(*old);
+        } else {
+            KContacts::PhoneNumber phoneNumber(trimmed);
+            phoneNumber.setType(KContacts::PhoneNumber::Cell);
+            newNumbers.append(phoneNumber);
+        }
+    }
+    addressee.setPhoneNumbers(newNumbers);
+
+    if (removePhoto) {
+        addressee.setPhoto(KContacts::Picture());
+    }
+    if (photo.isValid() && !photo.isEmpty()) {
+        const QImage image(photo.isLocalFile() ? photo.toLocalFile() : photo.toString());
+        if (image.isNull()) {
+            qWarning() << "Could not read the photo" << photo;
+        } else {
+            // photos are scaled down, so that contacts with photos load quickly
+            constexpr int unscaledWidth = 200;
+            const int avatarSize = int(unscaledWidth * qGuiApp->devicePixelRatio());
+            addressee.setPhoto(KContacts::Picture(image.scaled(QSize(avatarSize, avatarSize), Qt::KeepAspectRatio, Qt::SmoothTransformation)));
+        }
+    }
+
+    const QByteArray vCard = converter.createVCard(addressee);
+    bool saved;
+    if (person) {
+        saved = person->setContactCustomProperty(vCardProperty, vCard);
+        person->deleteLater();
+    } else {
+        saved = KPeople::PersonPluginManager::addContact({{vCardProperty, vCard}});
+    }
+    if (!saved) {
+        qWarning() << "Could not save the contact" << personUri;
+    }
+    return saved;
+}
