+#pragma once
+
+#include <QHash>
+#include <QObject>
+#include <QVariantList>
+#include <QVariantMap>
+#include <qqmlregistration.h>
+
+/**
+ * The SIM cards of the modems, for choosing the SIM of a call.
+ *
+ * Each entry of sims describes the active SIM of one modem: deviceUni (the
+ * ModemManager modem), simIdentifier (ICCID), slot (from 1, 0 if not known),
+ * name ("SIM <slot>", else the operator name of the SIM) and icon (shared
+ * with the other applications that show the SIM). The default SIM for calls
+ * is stored by its identifier; without a choice it is the first SIM.
+ */
+class SimUtils : public QObject
+{
+    Q_OBJECT
+    QML_ELEMENT
+    QML_SINGLETON
+
+    Q_PROPERTY(QVariantList sims READ sims NOTIFY simsChanged)
+    Q_PROPERTY(QString defaultSimIdentifier READ defaultSimIdentifier WRITE setDefaultSimIdentifier NOTIFY simsChanged)
+    Q_PROPERTY(QString defaultDeviceUni READ defaultDeviceUni NOTIFY simsChanged)
+
+public:
+    explicit SimUtils(QObject *parent = nullptr);
+
+    QVariantList sims() const;
+    QString defaultSimIdentifier() const;
+    void setDefaultSimIdentifier(const QString &simIdentifier);
+    QString defaultDeviceUni() const;
+
+    // modem with the SIM, empty if the SIM is not inserted
+    Q_INVOKABLE QString deviceForSim(const QString &simIdentifier) const;
+    // entry of sims for the modem, empty if the modem has no SIM
+    Q_INVOKABLE QVariantMap simForDevice(const QString &deviceUni) const;
+    // icon of a SIM, also of one that is not inserted
+    Q_INVOKABLE QString iconForSim(const QString &simIdentifier) const;
+
+Q_SIGNALS:
+    void simsChanged();
+
+private:
+    void update();
+    void loadSimSlot(const QString &deviceUni);
+
+    QVariantList m_sims;
+    QHash<QString, int> m_slots; // SIM slot of each modem
+};
