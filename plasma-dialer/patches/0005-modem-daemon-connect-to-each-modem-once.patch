+void ModemManagerController::removeModem(const QString &deviceUni)
+{
+    m_modemDevices.remove(deviceUni);
+    QObject *modemContext = m_modemContexts.take(deviceUni);
+    if (!modemContext) {
+        return;
+    }
+    // the calls of the modem are gone with it
+    const auto calls = m_calls;
+    for (CallObject *callObject : calls) {
+        if (callObject->parent() == modemContext) {
+            const QString callUni = callObject->id();
+            removeCall(callUni);
+            Q_EMIT callDeleted(deviceUni, callUni);
+        }
+    }
+    delete modemContext;
 }
 
 void ModemManagerController::removeCall(const QString &callId)
 {
-    m_calls.erase(std::remove_if(m_calls.begin(),
-                                 m_calls.end(),
-                                 [callId](CallObject *callObject) {
-                                     return (callObject->id() == callId);
-                                 }),
-                  m_calls.end());
+    const auto removed = std::stable_partition(m_calls.begin(), m_calls.end(), [callId](CallObject *callObject) {
+        return (callObject->id() != callId);
+    });
+    for (auto it = removed; it != m_calls.end(); ++it) {
+        (*it)->deleteLater();
+    }
+    m_calls.erase(removed, m_calls.end());
 }
 
