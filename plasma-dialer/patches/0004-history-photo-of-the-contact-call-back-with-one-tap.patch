     id: root
 
+    // contact of the number, empty if it is not in the contacts
+    readonly property string personUri: model.communicationWith ? ContactUtils.personUri(model.communicationWith) : ""
+    readonly property string displayName: model.communicationWith ? ContactUtils.displayString(model.communicationWith) : ""
+    readonly property bool missed: model.direction == DialerTypes.CallDirection.Incoming && model.duration <= 0
