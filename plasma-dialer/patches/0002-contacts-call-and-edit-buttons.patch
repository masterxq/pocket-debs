+#include <QObject>
+#include <qqmlregistration.h>
+
+/**
+ * The application that shows and edits contacts (Plasma Phonebook).
+ */
+class ContactsApp : public QObject
+{
+    Q_OBJECT
+    QML_ELEMENT
+    QML_SINGLETON
+    Q_PROPERTY(bool available READ available CONSTANT)
+
+public:
+    explicit ContactsApp(QObject *parent = nullptr);
+
+    // whether the contacts application is installed
+    bool available() const;
+
+    // starts the contacts application
+    Q_INVOKABLE void open();
+};
