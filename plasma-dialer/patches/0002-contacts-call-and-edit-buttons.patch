+    // runs fn with the number of the contact, asks for one if the contact has several
+    function withNumber(personUri, title, fn) {
+        const phoneNumbers = ContactUtils.phoneNumbers(personUri);
+        if (phoneNumbers.length === 1) {
+            fn(phoneNumbers[0].normalizedNumber);
+        } else if (phoneNumbers.length > 1) {
+            const pop = callPopup.createObject(contactsPage, {
+                "numbers": phoneNumbers,
+                "title": title
+            });
+            pop.onNumberSelected.connect(fn);
+            pop.open();
+        }
