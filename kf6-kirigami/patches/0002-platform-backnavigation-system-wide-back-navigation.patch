--- /dev/null
+++ b/src/platform/backnavigation.h
@@ -0,0 +1,198 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+ *
+ *  SPDX-License-Identifier: LGPL-2.0-or-later
+ */
+
+#ifndef KIRIGAMI_BACKNAVIGATION_H
+#define KIRIGAMI_BACKNAVIGATION_H
+
+#include <QObject>
+#include <QPointer>
+#include <QQmlEngine>
+
+class QQuickItem;
+class QQuickWindow;
+
+namespace Kirigami
+{
+namespace Platform
+{
+class BackNavigationDispatcher;
+
+/*!
+ * \qmltype BackNavigation
+ * \inqmlmodule org.kde.kirigami.platform
+ *
+ * \brief Takes part in the system-wide back navigation of a window.
+ *
+ * Some environments offer one "back" control for all applications, for
+ * example a back button in the navigation bar of a phone shell. On Wayland
+ * compositors that support the \c kde_back_navigation_v1 protocol, Kirigami
+ * tells the compositor for each window whether going back currently has an
+ * effect in it, and goes back one step when the user operates that control.
+ * The shell can then show its back control only when it does something, and
+ * offer its usual controls (for example closing the window) otherwise.
+ *
+ * Applications built from the usual Kirigami components need no code of
+ * their own. Kirigami reports back as available and handles it, in this
+ * order:
+ * \list
+ *   \li the topmost open popup of the window (a drawer, a sheet, a dialog, a
+ *       menu): back closes it exactly as the Escape key would, and a modal
+ *       popup that does not close on Escape blocks back navigation in the
+ *       window behind it;
+ *   \li the submenus of a GlobalDrawer;
+ *   \li the layers of a PageRow, then its columns, as PageRow::goBack()
+ *       does it; the page that would be left receives
+ *       Page::backRequested() first and can accept the event to handle back
+ *       itself.
+ * \endlist
+ *
+ * Back is never reported as available when the only thing it could do is to
+ * close the window or to quit the application.
+ *
+ * An item with its own navigation, for example a StackView that is not a
+ * PageRow, or a page with a selection mode, takes part through this attached
+ * type: it sets \l enabled while going back has an effect for it and goes
+ * back one step when \l triggered is emitted.
+ *
+ * \qml
+ * import QtQuick.Controls as QQC2
+ * import org.kde.kirigami as Kirigami
+ *
+ * QQC2.StackView {
+ *     id: stack
+ *     initialItem: mainView
+ *
+ *     Kirigami.BackNavigation.enabled: stack.depth > 1
+ *     Kirigami.BackNavigation.onTriggered: stack.pop()
+ * }
+ * \endqml
+ *
+ * \qml
+ * Kirigami.ScrollablePage {
+ *     id: page
+ *     property bool selecting: false
+ *
+ *     // A page that the user has scrolled away in a PageRow stays visible,
+ *     // so take part only while it is the current page.
+ *     Kirigami.BackNavigation.enabled: page.selecting && page.isCurrentPage
+ *     Kirigami.BackNavigation.onTriggered: page.selecting = false
+ * }
+ * \endqml
+ *
+ * The attached object takes part only while \l enabled is \c true and the
+ * item it is attached to is visible. When several of them are taking part
+ * in the same window, back goes to the topmost open popup as described above
+ * (to an enabled item inside that popup, if there is one, before the popup
+ * itself), otherwise to an enabled item outside of popups: an item inside
+ * another enabled item comes first, so an inner view goes back before the
+ * PageRow around it; among unrelated items the one enabled most recently
+ * comes first.
+ *
+ * Without a compositor that supports the protocol (another compositor, X11,
+ * other platforms) nothing changes and \l triggered is never emitted. It is
+ * emitted only for the system back control: the back keys and buttons of the
+ * application itself keep their own handling (PageRow::goBack(), the Escape
+ * key for popups).
+ *
+ * It can be attached to an Item, a Window or a Popup. Attached to a Window,
+ * it stands for the content item of the window; attached to a Popup, for the
+ * content of the popup, so that it handles back before the popup is closed.
+ *
+ * \since 6.33
+ */
+class BackNavigationAttached : public QObject
+{
+    Q_OBJECT
+    QML_NAMED_ELEMENT(BackNavigation)
+    QML_UNCREATABLE("Cannot create objects of type BackNavigation, use it as an attached property")
+    QML_ATTACHED(BackNavigationAttached)
+
+    /*!
+     * \qmlattachedproperty bool BackNavigation::enabled
+     *
+     * Whether going back currently has an effect for the item, i.e. whether
+     * the item would handle \l triggered by going back one step.
+     *
+     * Set it to \c false when back would do nothing, and also when the only
+     * thing it could do is to close the window or to quit the application.
+     *
+     * default: \c false
+     */
+    Q_PROPERTY(bool enabled READ isEnabled WRITE setEnabled NOTIFY enabledChanged FINAL)
+
+    /*!
+     * \qmlattachedproperty bool BackNavigation::__available
+     * \internal
+     *
+     * Whether going back has an effect anywhere in the window of the item,
+     * as it is reported to the compositor.
+     */
+    Q_PROPERTY(bool __available READ isWindowAvailable NOTIFY windowAvailableChanged FINAL)
+
+public:
+    explicit BackNavigationAttached(QObject *parent = nullptr);
+    ~BackNavigationAttached() override;
+
+    bool isEnabled() const;
+    void setEnabled(bool enabled);
+
+    bool isWindowAvailable() const;
+
+    /*!
+     * \qmlattachedmethod bool BackNavigation::__trigger()
+     * \internal
+     *
+     * Goes back one step in the window of the item, as the system back control
+     * does. Returns whether something handled it.
+     */
+    Q_INVOKABLE bool __trigger();
+
+    // The item that decides about visibility and nesting.
+    QQuickItem *item() const;
+    // Order among unrelated attached objects: a higher value was enabled later.
+    quint64 enabledSerial() const;
+    // Enabled and visible in a window.
+    bool isActive() const;
+
+    static BackNavigationAttached *qmlAttachedProperties(QObject *object);
+
+Q_SIGNALS:
+    void enabledChanged();
+    void windowAvailableChanged();
+
+    /*!
+     * \qmlattachedsignal BackNavigation::triggered()
+     *
+     * Emitted when the user asked to go back and this item is the one that
+     * handles it. The item goes back one step, as its own back button would.
+     *
+     * Only emitted while \l enabled is \c true.
+     */
+    void triggered();
+
+    // Something that decides about isActive() changed.
+    void activeChanged();
+
+private Q_SLOTS:
+    void updateItem();
+
+private:
+    void updateWindow();
+    void setDispatcher(BackNavigationDispatcher *dispatcher);
+
+    QPointer<QQuickItem> m_item;
+    QPointer<BackNavigationDispatcher> m_dispatcher;
+    QMetaObject::Connection m_windowAvailableConnection;
+    quint64 m_enabledSerial = 0;
+    bool m_enabled = false;
+};
+
+}
+}
+
+QML_DECLARE_TYPEINFO(Kirigami::Platform::BackNavigationAttached, QML_HAS_ATTACHED_PROPERTIES)
+
+#endif
diff --git a/src/platform/backnavigationdispatcher.cpp b/src/platform/backnavigationdispatcher.cpp
new file mode 100644
--- /dev/null
+++ b/src/platform/backnavigationdispatcher.cpp
@@ -0,0 +1,361 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+ *
+ *  SPDX-License-Identifier: LGPL-2.0-or-later
+ */
+
+#include "backnavigationdispatcher_p.h"
+
+#include "backnavigation.h"
+#include "kirigamiplatform_logging.h"
+
+#ifdef KIRIGAMI_ENABLE_WAYLAND
+#include "waylandbacknavigation_p.h"
+#endif
+
+#include <QGuiApplication>
+#include <QMetaEnum>
+#include <QMetaMethod>
+#include <QMetaProperty>
+#include <QQuickItem>
+#include <QQuickWindow>
+
+#include <algorithm>
+
+namespace Kirigami
+{
+namespace Platform
+{
+
+static bool isPopup(const QObject *object)
+{
+    return object && object->inherits("QQuickPopup");
+}
+
+static int closeOnEscapeFlag(const QObject *popup)
+{
+    const QMetaObject *mo = popup->metaObject();
+    const int index = mo->indexOfEnumerator("ClosePolicy");
+    if (index >= 0) {
+        bool ok = false;
+        const int value = mo->enumerator(index).keyToValue("CloseOnEscape", &ok);
+        if (ok) {
+            return value;
+        }
+    }
+    // QQuickPopup::CloseOnEscape
+    return 0x10;
+}
+
+// Whether the Escape key closes the popup (QQuickPopup::keyPressEvent): its close
+// policy has CloseOnEscape and it is interactive (only drawers can be non-interactive).
+static bool closesOnEscape(const QObject *popup)
+{
+    bool ok = false;
+    const int policy = popup->property("closePolicy").toInt(&ok);
+    if (!ok || !(policy & closeOnEscapeFlag(popup))) {
+        return false;
+    }
+    const QVariant interactive = popup->property("interactive");
+    return !interactive.isValid() || interactive.toBool();
+}
+
+static bool isAncestorOrSelf(const QQuickItem *ancestor, const QQuickItem *item)
+{
+    return ancestor == item || ancestor->isAncestorOf(item);
+}
+
+BackNavigationDispatcher *BackNavigationDispatcher::forWindow(QQuickWindow *window)
+{
+    if (!window) {
+        return nullptr;
+    }
+    auto dispatcher = window->findChild<BackNavigationDispatcher *>(QString(), Qt::FindDirectChildrenOnly);
+    if (!dispatcher) {
+        dispatcher = new BackNavigationDispatcher(window);
+    }
+    return dispatcher;
+}
+
+BackNavigationDispatcher::BackNavigationDispatcher(QQuickWindow *window)
+    : QObject(window)
+    , m_window(window)
+{
+    // The overlay of the window, which holds the popups, is created on demand
+    // as a child of the content item. It is looked for in update(): when the
+    // children change, the new child may still be under construction.
+    connect(window->contentItem(), &QQuickItem::childrenChanged, this, &BackNavigationDispatcher::scheduleUpdate);
+    findOverlay();
+
+#ifdef KIRIGAMI_ENABLE_WAYLAND
+    if (WaylandBackNavigation::isSupported()) {
+        m_wayland = new WaylandBackNavigation(window, this);
+        connect(this, &BackNavigationDispatcher::availableChanged, m_wayland, &WaylandBackNavigation::setAvailable);
+        connect(m_wayland, &WaylandBackNavigation::backRequested, this, [this] {
+            if (!trigger()) {
+                qCDebug(KirigamiPlatform) << "Back requested by the compositor without effect in" << m_window;
+            }
+        });
+    }
+#endif
+}
+
+BackNavigationDispatcher::~BackNavigationDispatcher() = default;
+
+quint64 BackNavigationDispatcher::nextSerial()
+{
+    static quint64 serial = 0;
+    return ++serial;
+}
+
+void BackNavigationDispatcher::addHandler(BackNavigationAttached *handler)
+{
+    if (!m_handlers.contains(handler)) {
+        m_handlers.append(handler);
+        connect(handler, &BackNavigationAttached::activeChanged, this, &BackNavigationDispatcher::scheduleUpdate);
+    }
+    scheduleUpdate();
+}
+
+void BackNavigationDispatcher::removeHandler(BackNavigationAttached *handler)
+{
+    m_handlers.removeAll(handler);
+    m_handlers.removeAll(nullptr);
+    disconnect(handler, nullptr, this, nullptr);
+    scheduleUpdate();
+}
+
+bool BackNavigationDispatcher::available()
+{
+    if (m_updatePending) {
+        update();
+    }
+    return m_available;
+}
+
+void BackNavigationDispatcher::scheduleUpdate()
+{
+    // Coalesce the changes of one event loop pass (a page popped and a popup
+    // closed at once, transitions), so that the compositor sees one state.
+    if (m_updatePending) {
+        return;
+    }
+    m_updatePending = true;
+    QMetaObject::invokeMethod(
+        this,
+        [this] {
+            if (m_updatePending) {
+                update();
+            }
+        },
+        Qt::QueuedConnection);
+}
+
+void BackNavigationDispatcher::update()
+{
+    m_updatePending = false;
+    if (!m_overlay) {
+        findOverlay();
+    }
+    if (m_popupsChanged) {
+        watchPopups();
+    }
+    const Target target = findTarget();
+    const bool available = target.handler || target.popup;
+    if (available != m_available) {
+        m_available = available;
+        Q_EMIT availableChanged(m_available);
+    }
+}
+
+bool BackNavigationDispatcher::trigger()
+{
+    // Act on the state as it is now, not as it was last reported.
+    update();
+    const Target target = findTarget();
+
+    if (target.handler) {
+        Q_EMIT target.handler->triggered();
+        return true;
+    }
+
+    if (target.popup) {
+        // Close the popup as the Escape key does (QQuickPopupPrivate::closeOrReject):
+        // dialogs are rejected, everything else is closed.
+        if (target.popup->inherits("QQuickDialog")) {
+            QMetaObject::invokeMethod(target.popup, "reject");
+        } else {
+            QMetaObject::invokeMethod(target.popup, "close");
+        }
+        return true;
+    }
+
+    return false;
+}
+
+QList<QQuickItem *> BackNavigationDispatcher::stackingOrderPopupItems() const
+{
+    // The popup items in the overlay, topmost first. Same order as
+    // QQuickOverlayPrivate::stackingOrderPopups(): paint order, reversed.
+    QList<QQuickItem *> items;
+    if (!m_overlay) {
+        return items;
+    }
+    const QList<QQuickItem *> children = m_overlay->childItems();
+    for (QQuickItem *child : children) {
+        if (isPopup(child->parent())) {
+            items.append(child);
+        }
+    }
+    std::stable_sort(items.begin(), items.end(), [](const QQuickItem *a, const QQuickItem *b) {
+        return a->z() < b->z();
+    });
+    std::reverse(items.begin(), items.end());
+    return items;
+}
+
+BackNavigationAttached *BackNavigationDispatcher::bestHandler(QQuickItem *scope, const QList<QQuickItem *> &excluded) const
+{
+    // Among the active handlers in scope (all of the window if scope is null,
+    // except those in the excluded popup items), take the one enabled last,
+    // then descend to active handlers inside of it: inner navigation first.
+    QList<BackNavigationAttached *> candidates;
+    for (const auto &handler : m_handlers) {
+        if (!handler || !handler->isActive()) {
+            continue;
+        }
+        QQuickItem *item = handler->item();
+        if (item->window() != m_window) {
+            continue;
+        }
+        if (scope && !isAncestorOrSelf(scope, item)) {
+            continue;
+        }
+        const bool inExcluded = std::any_of(excluded.cbegin(), excluded.cend(), [item](QQuickItem *popupItem) {
+            return isAncestorOrSelf(popupItem, item);
+        });
+        if (inExcluded) {
+            continue;
+        }
+        candidates.append(handler);
+    }
+
+    BackNavigationAttached *best = nullptr;
+    auto later = [](const BackNavigationAttached *a, const BackNavigationAttached *b) {
+        return a->enabledSerial() > b->enabledSerial();
+    };
+    for (BackNavigationAttached *candidate : std::as_const(candidates)) {
+        if (!best || later(candidate, best)) {
+            best = candidate;
+        }
+    }
+    while (best) {
+        BackNavigationAttached *inner = nullptr;
+        for (BackNavigationAttached *candidate : std::as_const(candidates)) {
+            if (candidate != best && best->item() != candidate->item() && best->item()->isAncestorOf(candidate->item())
+                && (!inner || later(candidate, inner))) {
+                inner = candidate;
+            }
+        }
+        if (!inner) {
+            break;
+        }
+        best = inner;
+    }
+    return best;
+}
+
+BackNavigationDispatcher::Target BackNavigationDispatcher::findTarget() const
+{
+    Target target;
+    if (!m_window) {
+        return target;
+    }
+
+    const QList<QQuickItem *> popupItems = stackingOrderPopupItems();
+    for (QQuickItem *popupItem : popupItems) {
+        QObject *popup = popupItem->parent();
+        if (!popup->property("visible").toBool() || popup->inherits("QQuickToolTip")) {
+            continue;
+        }
+        // Navigation inside of the popup goes before closing it.
+        if (BackNavigationAttached *handler = bestHandler(popupItem, {})) {
+            target.handler = handler;
+            return target;
+        }
+        if (closesOnEscape(popup)) {
+            target.popup = popup;
+            return target;
+        }
+        if (popup->property("modal").toBool()) {
+            // A modal popup that does not close on Escape blocks the window behind it.
+            return target;
+        }
+        // Non-modal popups that stay open (such as a sidebar drawer) are not
+        // part of back navigation.
+    }
+
+    target.handler = bestHandler(nullptr, popupItems);
+    return target;
+}
+
+void BackNavigationDispatcher::findOverlay()
+{
+    if (m_overlay || !m_window || !m_window->contentItem()) {
+        return;
+    }
+    const QList<QQuickItem *> children = m_window->contentItem()->childItems();
+    for (QQuickItem *child : children) {
+        if (child->inherits("QQuickOverlay")) {
+            m_overlay = child;
+            connect(child, &QQuickItem::childrenChanged, this, [this] {
+                m_popupsChanged = true;
+                scheduleUpdate();
+            });
+            disconnect(m_window->contentItem(), &QQuickItem::childrenChanged, this, &BackNavigationDispatcher::scheduleUpdate);
+            watchPopups();
+            return;
+        }
+    }
+}
+
+void BackNavigationDispatcher::watchPopups()
+{
+    m_popupsChanged = false;
+    if (m_overlay) {
+        const QList<QQuickItem *> children = m_overlay->childItems();
+        for (QQuickItem *child : children) {
+            if (isPopup(child->parent())) {
+                watchPopup(child->parent(), child);
+            }
+        }
+    }
+}
+
+void BackNavigationDispatcher::watchPopup(QObject *popup, QQuickItem *popupItem)
+{
+    if (m_watchedPopups.contains(popup)) {
+        return;
+    }
+    m_watchedPopups.insert(popup);
+    connect(popup, &QObject::destroyed, this, [this, popup] {
+        m_watchedPopups.remove(popup);
+        scheduleUpdate();
+    });
+
+    static const QMetaMethod update = staticMetaObject.method(staticMetaObject.indexOfSlot("scheduleUpdate()"));
+    const QMetaObject *mo = popup->metaObject();
+    for (const char *name : {"visible", "modal", "closePolicy", "interactive"}) {
+        const int index = mo->indexOfProperty(name);
+        if (index >= 0 && mo->property(index).hasNotifySignal()) {
+            connect(popup, mo->property(index).notifySignal(), this, update);
+        }
+    }
+    // Stacking order
+    connect(popupItem, &QQuickItem::zChanged, this, &BackNavigationDispatcher::scheduleUpdate);
+}
+
+}
+}
+
+#include "moc_backnavigationdispatcher_p.cpp"
