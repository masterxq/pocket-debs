@@ -0,0 +1,177 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+ *
+ *  SPDX-License-Identifier: LGPL-2.0-or-later
+ */
+
+#include "waylandbacknavigation_p.h"
+
+#include "kirigamiplatform_logging.h"
+
+#include "qwayland-kde-back-navigation-v1.h"
+
+#include <QGuiApplication>
+#include <QPlatformSurfaceEvent>
+#include <QQuickWindow>
+#include <QWaylandClientExtensionTemplate>
+#include <QtGui/qpa/qplatformnativeinterface.h>
+#include <QtGui/qpa/qplatformwindow_p.h>
+
+namespace Kirigami
+{
+namespace Platform
+{
+
+class BackNavigationManager : public QWaylandClientExtensionTemplate<BackNavigationManager>, public QtWayland::kde_back_navigation_manager_v1
+{
+public:
+    BackNavigationManager()
+        : QWaylandClientExtensionTemplate<BackNavigationManager>(1)
+    {
+    }
+
+    static BackNavigationManager *instance()
+    {
+        // Owned by the application: the proxy is not destroyed explicitly, it
+        // goes away with the connection to the compositor.
+        static QPointer<BackNavigationManager> manager;
+        if (!manager) {
+            manager = new BackNavigationManager;
+            manager->setParent(qGuiApp);
+        }
+        return manager;
+    }
+};
+
+class BackNavigationObject : public QtWayland::kde_back_navigation_v1
+{
+public:
+    BackNavigationObject(::kde_back_navigation_v1 *object, WaylandBackNavigation *owner)
+        : QtWayland::kde_back_navigation_v1(object)
+        , m_owner(owner)
+    {
+    }
+
+    ~BackNavigationObject() override
+    {
+        destroy();
+    }
+
+protected:
+    void kde_back_navigation_v1_back() override
+    {
+        // Handled from the event loop, not from within the dispatch of the
+        // Wayland event: going back may destroy the window and this object.
+        QMetaObject::invokeMethod(m_owner, &WaylandBackNavigation::backRequested, Qt::QueuedConnection);
+    }
+
+private:
+    QPointer<WaylandBackNavigation> m_owner;
+};
+
+bool WaylandBackNavigation::isSupported()
+{
+    return qGuiApp && qGuiApp->nativeInterface<QNativeInterface::QWaylandApplication>();
+}
+
+WaylandBackNavigation::WaylandBackNavigation(QQuickWindow *window, QObject *parent)
+    : QObject(parent)
+    , m_window(window)
+{
+    BackNavigationManager *manager = BackNavigationManager::instance();
+    connect(manager, &QWaylandClientExtension::activeChanged, this, [this, manager] {
+        if (manager->isActive()) {
+            createObject();
+        } else {
+            m_object.reset();
+        }
+    });
+
+    window->installEventFilter(this);
+    if (window->handle()) {
+        attachPlatformWindow();
+    }
+}
+
+WaylandBackNavigation::~WaylandBackNavigation()
+{
+    destroyObject();
+}
+
+bool WaylandBackNavigation::eventFilter(QObject *watched, QEvent *event)
+{
+    if (watched == m_window && event->type() == QEvent::PlatformSurface) {
+        switch (static_cast<QPlatformSurfaceEvent *>(event)->surfaceEventType()) {
+        case QPlatformSurfaceEvent::SurfaceCreated:
+            attachPlatformWindow();
+            break;
+        case QPlatformSurfaceEvent::SurfaceAboutToBeDestroyed:
+            detachPlatformWindow();
+            break;
+        }
+    }
+    return QObject::eventFilter(watched, event);
+}
+
+void WaylandBackNavigation::attachPlatformWindow()
+{
+    auto waylandWindow = m_window ? m_window->nativeInterface<QNativeInterface::Private::QWaylandWindow>() : nullptr;
+    if (!waylandWindow || waylandWindow == m_waylandWindow) {
+        return;
+    }
+    detachPlatformWindow();
+    m_waylandWindow = waylandWindow;
+    connect(waylandWindow, &QNativeInterface::Private::QWaylandWindow::surfaceRoleCreated, this, &WaylandBackNavigation::createObject);
+    connect(waylandWindow, &QNativeInterface::Private::QWaylandWindow::surfaceRoleDestroyed, this, &WaylandBackNavigation::destroyObject);
+    createObject();
+}
+
+void WaylandBackNavigation::detachPlatformWindow()
+{
+    destroyObject();
+    if (m_waylandWindow) {
+        disconnect(m_waylandWindow, nullptr, this, nullptr);
+    }
+    m_waylandWindow = nullptr;
+}
+
+void WaylandBackNavigation::createObject()
+{
+    BackNavigationManager *manager = BackNavigationManager::instance();
+    if (m_object || !m_waylandWindow || !manager->isActive()) {
+        return;
+    }
+    // Only toplevels have a back navigation state: no popups, no subsurfaces.
+    auto toplevel = static_cast<::xdg_toplevel *>(
+        QGuiApplication::platformNativeInterface()->nativeResourceForWindow(QByteArrayLiteral("xdg_toplevel"), m_window));
+    if (!toplevel) {
+        return;
+    }
+    m_object = std::make_unique<BackNavigationObject>(manager->get_back_navigation(toplevel), this);
+    if (m_available) {
+        m_object->set_state(QtWayland::kde_back_navigation_v1::state_available);
+    }
+}
+
+void WaylandBackNavigation::destroyObject()
+{
+    // After surfaceRoleDestroyed the xdg_toplevel is already gone and the
+    // object is inert; destroying it is still required.
+    m_object.reset();
+}
+
+void WaylandBackNavigation::setAvailable(bool available)
+{
+    if (available == m_available) {
+        return;
+    }
+    m_available = available;
+    if (m_object) {
+        m_object->set_state(available ? QtWayland::kde_back_navigation_v1::state_available : QtWayland::kde_back_navigation_v1::state_unavailable);
+    }
+}
+
+}
+}
+
+#include "moc_waylandbacknavigation_p.cpp"
