+ *  SPDX-License-Identifier: LGPL-2.0-or-later
+ */
+
+#ifndef KIRIGAMI_BACKNAVIGATIONDISPATCHER_P_H
+#define KIRIGAMI_BACKNAVIGATIONDISPATCHER_P_H
+
+#include <QList>
+#include <QObject>
+#include <QPointer>
+#include <QSet>
+
+class QQuickItem;
+class QQuickWindow;
+
+namespace Kirigami
+{
+namespace Platform
+{
+class BackNavigationAttached;
+class WaylandBackNavigation;
+
+/*
+ * Back navigation state of one QQuickWindow.
+ *
+ * Collects the BackNavigation attached objects of the window and watches the
+ * popups in its overlay. available() tells whether a back request would have an
+ * effect, trigger() carries one out. On Wayland the state is sent to the
+ * compositor and its back events are passed to trigger().
+ *
+ * Created on demand as a child of the window, so it lives as long as the window.
+ */
+class BackNavigationDispatcher : public QObject
+{
+    Q_OBJECT
+
+public:
+    static BackNavigationDispatcher *forWindow(QQuickWindow *window);
+
+    ~BackNavigationDispatcher() override;
+
+    void addHandler(BackNavigationAttached *handler);
+    void removeHandler(BackNavigationAttached *handler);
+
+    bool available();
+    bool trigger();
+
+    static quint64 nextSerial();
+
+public Q_SLOTS:
+    void scheduleUpdate();
+
+Q_SIGNALS:
+    void availableChanged(bool available);
+
+private:
+    explicit BackNavigationDispatcher(QQuickWindow *window);
+
+    // What a back request would act on: a handler, a popup to close, or nothing.
+    struct Target {
+        BackNavigationAttached *handler = nullptr;
+        QObject *popup = nullptr;
+    };
+    Target findTarget() const;
+    BackNavigationAttached *bestHandler(QQuickItem *scope, const QList<QQuickItem *> &excluded) const;
+    QList<QQuickItem *> stackingOrderPopupItems() const;
+
+    void update();
+    void findOverlay();
+    void watchPopups();
+    void watchPopup(QObject *popup, QQuickItem *popupItem);
+
+    QPointer<QQuickWindow> m_window;
+    QList<QPointer<BackNavigationAttached>> m_handlers;
+    QPointer<QQuickItem> m_overlay;
+    QSet<QObject *> m_watchedPopups;
+    WaylandBackNavigation *m_wayland = nullptr;
+    bool m_available = false;
+    bool m_updatePending = false;
+    bool m_popupsChanged = false;
+};
+
+}
+}
+
+#endif
