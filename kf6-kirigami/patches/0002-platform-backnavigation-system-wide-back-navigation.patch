new file mode 100644
--- /dev/null
+++ b/src/platform/backnavigation.cpp
@@ -0,0 +1,152 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+ *
+ *  SPDX-License-Identifier: LGPL-2.0-or-later
+ */
+
+#include "backnavigation.h"
+
+#include "backnavigationdispatcher_p.h"
+#include "kirigamiplatform_logging.h"
+
+#include <QQuickItem>
+#include <QQuickWindow>
+
+namespace Kirigami
+{
+namespace Platform
+{
+
+BackNavigationAttached::BackNavigationAttached(QObject *parent)
+    : QObject(parent)
+{
+    if (qobject_cast<QQuickItem *>(parent)) {
+        // nothing to resolve
+    } else if (qobject_cast<QQuickWindow *>(parent)) {
+        // The content item of a window is constant.
+    } else if (parent && parent->inherits("QQuickPopup")) {
+        connect(parent, SIGNAL(contentItemChanged()), this, SLOT(updateItem()));
+    } else {
+        qCWarning(KirigamiPlatform) << "BackNavigation must be attached to an Item, a Window or a Popup, not" << parent;
+    }
+    updateItem();
+}
+
+BackNavigationAttached::~BackNavigationAttached()
+{
+    setDispatcher(nullptr);
+}
+
+BackNavigationAttached *BackNavigationAttached::qmlAttachedProperties(QObject *object)
+{
+    return new BackNavigationAttached(object);
+}
+
+void BackNavigationAttached::updateItem()
+{
+    QQuickItem *item = nullptr;
+    if (auto parentItem = qobject_cast<QQuickItem *>(parent())) {
+        item = parentItem;
+    } else if (auto window = qobject_cast<QQuickWindow *>(parent())) {
+        item = window->contentItem();
+    } else if (parent() && parent()->inherits("QQuickPopup")) {
+        // The item of the popup itself (QQuickPopupItem) holds the content item.
+        item = parent()->property("contentItem").value<QQuickItem *>();
+        while (item && !item->inherits("QQuickPopupItem")) {
+            item = item->parentItem();
+        }
+        if (!item) {
+            item = parent()->property("contentItem").value<QQuickItem *>();
+        }
+    }
+
+    if (item == m_item) {
+        return;
+    }
+    if (m_item) {
+        disconnect(m_item, nullptr, this, nullptr);
+    }
+    m_item = item;
+    if (m_item) {
+        connect(m_item, &QQuickItem::windowChanged, this, &BackNavigationAttached::updateWindow);
+        connect(m_item, &QQuickItem::visibleChanged, this, &BackNavigationAttached::activeChanged);
+        connect(m_item, &QObject::destroyed, this, &BackNavigationAttached::updateItem);
+    }
+    updateWindow();
+    Q_EMIT activeChanged();
+}
+
+void BackNavigationAttached::updateWindow()
+{
+    QQuickWindow *window = m_item ? m_item->window() : nullptr;
+    setDispatcher(BackNavigationDispatcher::forWindow(window));
+}
+
+void BackNavigationAttached::setDispatcher(BackNavigationDispatcher *dispatcher)
+{
+    if (dispatcher == m_dispatcher) {
+        return;
+    }
+    const bool wasAvailable = isWindowAvailable();
+    if (m_dispatcher) {
+        disconnect(m_windowAvailableConnection);
+        m_dispatcher->removeHandler(this);
+    }
+    m_dispatcher = dispatcher;
+    if (m_dispatcher) {
+        m_dispatcher->addHandler(this);
+        m_windowAvailableConnection =
+            connect(m_dispatcher, &BackNavigationDispatcher::availableChanged, this, &BackNavigationAttached::windowAvailableChanged);
+    }
+    if (wasAvailable != isWindowAvailable()) {
+        Q_EMIT windowAvailableChanged();
+    }
+}
+
+bool BackNavigationAttached::isEnabled() const
+{
+    return m_enabled;
+}
+
+void BackNavigationAttached::setEnabled(bool enabled)
+{
+    if (enabled == m_enabled) {
+        return;
+    }
+    m_enabled = enabled;
+    if (m_enabled) {
+        m_enabledSerial = BackNavigationDispatcher::nextSerial();
+    }
+    Q_EMIT enabledChanged();
+    Q_EMIT activeChanged();
+}
+
+bool BackNavigationAttached::isWindowAvailable() const
+{
+    return m_dispatcher && m_dispatcher->available();
+}
+
+bool BackNavigationAttached::__trigger()
+{
+    return m_dispatcher && m_dispatcher->trigger();
+}
+
+QQuickItem *BackNavigationAttached::item() const
+{
+    return m_item;
+}
+
+quint64 BackNavigationAttached::enabledSerial() const
+{
+    return m_enabledSerial;
+}
+
+bool BackNavigationAttached::isActive() const
+{
+    return m_enabled && m_item && m_item->window() && m_item->isVisible();
+}
+
+}
+}
+
+#include "moc_backnavigation.cpp"
