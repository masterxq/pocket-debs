+/*
+ *  SPDX-FileCopyrightText: 2026 masterxq <masterxq@users.noreply.github.com>
+ *
+ *  SPDX-License-Identifier: LGPL-2.0-or-later
+ */
+
+#ifndef KIRIGAMI_WAYLANDBACKNAVIGATION_P_H
+#define KIRIGAMI_WAYLANDBACKNAVIGATION_P_H
+
+#include <QObject>
+#include <QPointer>
+
+#include <memory>
+
+class QQuickWindow;
+
+namespace Kirigami
+{
+namespace Platform
+{
+class BackNavigationObject;
+
+/*
+ * kde_back_navigation_v1 for one window: reports the back navigation state of
+ * the window to the compositor and passes its back events on.
+ *
+ * The protocol object belongs to the xdg_toplevel of the window. Qt creates a
+ * new xdg_toplevel each time the window is shown and destroys it when the
+ * window is hidden, so the object is created and destroyed along with it.
+ */
+class WaylandBackNavigation : public QObject
+{
+    Q_OBJECT
+
+public:
+    // Whether the application runs on Wayland.
+    static bool isSupported();
+
+    WaylandBackNavigation(QQuickWindow *window, QObject *parent);
+    ~WaylandBackNavigation() override;
+
+public Q_SLOTS:
+    void setAvailable(bool available);
+
+Q_SIGNALS:
+    void backRequested();
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override;
+
+private:
+    void attachPlatformWindow();
+    void detachPlatformWindow();
+    void createObject();
+    void destroyObject();
+
+    QPointer<QQuickWindow> m_window;
+    QPointer<QObject> m_waylandWindow;
+    std::unique_ptr<BackNavigationObject> m_object;
+    bool m_available = false;
+};
+
+}
+}
+
+#endif
