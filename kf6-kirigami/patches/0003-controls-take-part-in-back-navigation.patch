      */
@@ -694,6 +697,11 @@ QT.Control {
         sequences: [ StandardKey.Back ]
         onActivated: root.goBack()
     }
+
+    // System-wide back control of the window: available exactly when goBack() has an effect
+    Platform.BackNavigation.enabled: layersStack.depth > 1 || root.currentIndex >= 1
+    Platform.BackNavigation.onTriggered: root.goBack()
+
     Shortcut {
         sequences: [ StandardKey.Forward ]
         onActivated: root.goForward()
