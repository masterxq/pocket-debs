+static nir_def *
+bi_get_implicit_lod(nir_builder *b, nir_tex_instr *tex, struct tex_srcs srcs)
+{
+   struct bifrost_texture_operation desc = {
+      .op = BIFROST_TEX_OP_GRDESC,
+      .mask = 1,
+      .shadow_or_clamp_disable = true,
+   };
+   unsigned comps = tex->coord_components - tex->is_array;
+   nir_def *xy = nir_trim_vector(b, srcs.coord, MIN2(comps, 2));
+   nir_def *z = comps == 3 ? nir_channel(b, srcs.coord, 2) : NULL;
+   nir_def *grdesc = build_bi_texc(b, nir_type_float32, srcs.tex_h, srcs.samp_h,
+                                 tex->sampler_dim, xy, desc, false, &z, z ? 1 : 0);
+   nir_def *lod = nir_unpack_32_2x16_split_x(b, grdesc);
+   if (srcs.bias)
+      lod = nir_iadd_sat(b, lod, build_sfixed_8_8(b, srcs.bias));
+
+   return nir_u2u32(b, lod);
+}
+
+static bool
+bi_lower_tex(nir_builder *b, nir_tex_instr *tex, unsigned arch)
+{
+   /* If txf is used, we assume there is a valid sampler bound at index 0. Use
+    * it for txf operations, since there may be no other valid samplers. This is
+    * a workaround: txf does not require a sampler in NIR (so sampler_index is
+    * undefined) but we need one in the hardware. This is ABI with the driver.
+    */
+   if (!nir_tex_instr_need_sampler(tex))
+      tex->sampler_index = 0;
+
+   b->cursor = nir_before_instr(&tex->instr);
+   nir_def *sampler = nir_steal_tex_src(tex, nir_tex_src_backend1);
+   nir_def *size = nir_steal_tex_src(tex, nir_tex_src_backend2);
+   struct tex_srcs srcs = steal_tex_srcs(b, tex, arch);
+
+   nir_def *gradient_lod = NULL;
+   if (!srcs.lod && !srcs.min_lod && !srcs.bias && (srcs.ddx || srcs.ddy)) {
+      nir_def *grdesc = build_bi_gradient_desc(b, srcs.tex_h, srcs.samp_h,
+                                               tex->sampler_dim, srcs.ddx, srcs.ddy);
+      gradient_lod = nir_channel(b, grdesc, 0);
+   }
+
+   nir_def *res;
+   if (sampler && nir_tex_instr_has_implicit_derivative(tex)) {
+      assert(size && srcs.offset && !gradient_lod && !srcs.min_lod);
+      nir_def *lod = bi_get_implicit_lod(b, tex, srcs);
+      nir_def *isotropic = nir_ieq_imm(
+         b, nir_ubitfield_extract_imm(b, nir_channel(b, sampler, 2), 24, 2), 0);
+
+      /* GRDESC uses the original coordinates for derivatives. Keep TEXC's
+       * implicit sample for anisotropic or multi-level filtering and for
+       * samplers without a mirrored offset.
+       */
+      struct tex_srcs adjusted = srcs;
+      nir_def *emulate = bi_lower_mirrored_offset(b, &adjusted, sampler, size,
+                                                 lod, isotropic);
+      adjusted.bias = NULL;
+      nir_def *native = bi_emit_tex(b, tex, srcs, NULL);
+      nir_def *shifted = bi_emit_tex(b, tex, adjusted, lod);
+      res = nir_bcsel(b, emulate, shifted, native);
+   } else {
+      if (sampler) {
+         assert(size && srcs.offset && gradient_lod);
+         bi_lower_mirrored_offset(b, &srcs, sampler, size, gradient_lod,
+                                   nir_imm_true(b));
+      }
+      res = bi_emit_tex(b, tex, srcs, gradient_lod);
+   }
+
    nir_def_replace(&tex->def, res);
    return true;
 }
