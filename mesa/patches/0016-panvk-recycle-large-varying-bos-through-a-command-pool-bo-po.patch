Description: panvk: recycle large varying BOs through a command pool BO pool
 Varying allocations larger than the slab size got a new BO for every
 command buffer reset. Give the command pool a big-BO pool for varyings,
 like the TLS one, and release it with RELEASE_RESOURCES.
Author: pocket-debs
Origin: https://github.com/masterxq/mesa-lisbon (branch lisbon/26.3)
Forwarded: no
License: MIT (as the patched files)
Last-Update: 2026-11-25
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
index 8cf3d560ccd..abb92cb1f2c 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
@@ -516,8 +516,8 @@ panvk_create_cmdbuf(struct vk_command_pool *vk_pool, VkCommandBufferLevel level,
       .owns_bos = true,
       .needs_locking = false,
    };
-   panvk_pool_init(&cmdbuf->varying_pool, device, &pool->varying_bo_pool, NULL,
-                   &var_pool_props);
+   panvk_pool_init(&cmdbuf->varying_pool, device, &pool->varying_bo_pool,
+                   &pool->varying_big_bo_pool, &var_pool_props);
 
    list_inithead(&cmdbuf->batches);
    *cmdbuf_out = &cmdbuf->vk;
