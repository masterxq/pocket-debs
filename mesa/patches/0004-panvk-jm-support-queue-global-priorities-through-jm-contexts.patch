+#include <errno.h>
+
 #include "genxml/gen_macros.h"
 
 #include "decode.h"
@@ -75,6 +77,7 @@ panvk_queue_submit_batch(struct panvk_gpu_queue *queue,
          .in_syncs = (uintptr_t)in_fences,
