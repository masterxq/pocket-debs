Subject: [PATCH] panvk: use per-device address spaces and queue priorities on JM

Open a separate render-node file for each device when possible. Apply non-default queue priorities through the kernel JM context ioctls and advertise the extensions when the kernel supports them.

--- a/src/panfrost/vulkan/panvk_physical_device.c
+++ b/src/panfrost/vulkan/panvk_physical_device.c
@@ -572,7 +572,6 @@
                            uint32_t family_idx,
                            VkQueueFamilyGlobalPriorityPropertiesKHR *prio)
 {
-   const unsigned arch = pan_arch(physical_device->kmod.dev->props.gpu_id);
    uint32_t prio_idx = 0;
 
    switch (family_idx) {
@@ -580,13 +579,6 @@
       enum pan_kmod_group_allow_priority_flags prio_mask =
          physical_device->kmod.dev->props.allowed_group_priorities_mask;
 
-      /* Non-medium priority context is not hooked-up in the JM backend, even
-       * though the panfrost kmod advertize it. Manually filter non-medium
-       * priority for now.
-       */
-      if (arch < 10)
-         prio_mask &= PAN_KMOD_GROUP_ALLOW_PRIORITY_MEDIUM;
-
       if (prio_mask & PAN_KMOD_GROUP_ALLOW_PRIORITY_LOW)
          prio->priorities[prio_idx++] = VK_QUEUE_GLOBAL_PRIORITY_LOW_KHR;
       if (prio_mask & PAN_KMOD_GROUP_ALLOW_PRIORITY_MEDIUM)
--- a/src/panfrost/vulkan/panvk_vX_physical_device.c
+++ b/src/panfrost/vulkan/panvk_vX_physical_device.c
@@ -33,6 +33,14 @@
 #define RESERVED_UBO_COUNT                   6
 #define MAX_INLINE_UNIFORM_BLOCK_DESCRIPTORS (32 - RESERVED_UBO_COUNT)
 
+static bool
+has_global_priority(const struct panvk_physical_device *device)
+{
+   return PAN_ARCH >= 10 ||
+          (device->kmod.dev->props.allowed_group_priorities_mask &
+           PAN_KMOD_GROUP_ALLOW_PRIORITY_LOW);
+}
+
 void
 panvk_per_arch(get_physical_device_extensions)(
    const struct panvk_physical_device *device,
@@ -71,7 +79,7 @@
       .KHR_external_semaphore_fd = true,
       .KHR_format_feature_flags2 = true,
       .KHR_get_memory_requirements2 = true,
-      .KHR_global_priority = true,
+      .KHR_global_priority = has_global_priority(device),
       .KHR_image_format_list = true,
       .KHR_imageless_framebuffer = true,
       .KHR_index_type_uint8 = true,
@@ -168,8 +176,8 @@
       .EXT_extended_dynamic_state3 = true,
       .EXT_external_memory_acquire_unmodified = true,
       .EXT_external_memory_dma_buf = true,
-      .EXT_global_priority = true,
-      .EXT_global_priority_query = true,
+      .EXT_global_priority = has_global_priority(device),
+      .EXT_global_priority_query = has_global_priority(device),
       .EXT_graphics_pipeline_library = true,
       .EXT_hdr_metadata = true,
       .EXT_host_image_copy = true,
@@ -456,7 +464,7 @@
       .maintenance4 = true,
 
       /* Vulkan 1.4 */
-      .globalPriorityQuery = true,
+      .globalPriorityQuery = has_global_priority(device),
       .shaderSubgroupRotate = true,
       .shaderSubgroupRotateClustered = true,
       .shaderFloatControls2 = true,
--- a/src/panfrost/vulkan/panvk_vX_device.c
+++ b/src/panfrost/vulkan/panvk_vX_device.c
@@ -10,6 +10,8 @@
  * SPDX-License-Identifier: MIT
  */
 
+#include <fcntl.h>
+
 #include "drm-uapi/panthor_drm.h"
 
 #include "vk_cmd_enqueue_entrypoints.h"
@@ -288,11 +290,31 @@
    }
 }
 
+static int
+open_device_fd(const struct panvk_physical_device *physical_device)
+{
+   int physical_fd = physical_device->kmod.dev->fd;
+
+#if PAN_ARCH < 10
+   /* Panfrost ties its single address space to the DRM file. Open a fresh
+    * file for each VkDevice so their BOs do not share that address space.
+    */
+   char *path = drmGetRenderDeviceNameFromFd(physical_fd);
+   if (path) {
+      int fd = open(path, O_RDWR | O_CLOEXEC);
+      free(path);
+      if (fd >= 0)
+         return fd;
+   }
+#endif
+
+   return os_dupfd_cloexec(physical_fd);
+}
+
 static VkResult
 check_global_priority(const struct panvk_physical_device *phys_dev,
                       const VkDeviceQueueCreateInfo *create_info)
 {
-   const unsigned arch = pan_arch(phys_dev->kmod.dev->props.gpu_id);
    const VkDeviceQueueGlobalPriorityCreateInfoKHR *priority_info =
       vk_find_struct_const(create_info->pNext,
                            DEVICE_QUEUE_GLOBAL_PRIORITY_CREATE_INFO_KHR);
@@ -307,13 +329,6 @@
       enum pan_kmod_group_allow_priority_flags allowed_prio_mask =
          phys_dev->kmod.dev->props.allowed_group_priorities_mask;
 
-      /* Non-medium priority context is not hooked-up in the JM backend, even
-       * though the panfrost kmod advertize it. Manually filter non-medium
-       * priority for now.
-       */
-      if (arch < 10)
-         allowed_prio_mask &= PAN_KMOD_GROUP_ALLOW_PRIORITY_MEDIUM;
-
       if (requested_prio & allowed_prio_mask)
          return VK_SUCCESS;
 
@@ -514,7 +529,7 @@
       .priv = &device->vk.alloc,
    };
    device->kmod.dev = pan_kmod_dev_create(
-      os_dupfd_cloexec(physical_device->kmod.dev->fd),
+      open_device_fd(physical_device),
       physical_device->kmod.dev->flags, &device->kmod.allocator);
 
    if (!device->kmod.dev) {
--- a/src/panfrost/vulkan/jm/panvk_queue.h
+++ b/src/panfrost/vulkan/jm/panvk_queue.h
@@ -19,6 +19,7 @@
 struct panvk_gpu_queue {
    struct vk_queue vk;
    uint32_t sync;
+   uint32_t jm_ctx_handle;
 };
 
 VK_DEFINE_HANDLE_CASTS(panvk_gpu_queue, vk.base, VkQueue, VK_OBJECT_TYPE_QUEUE)
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -9,6 +9,8 @@
  * SPDX-License-Identifier: MIT
  */
 
+#include <errno.h>
+
 #include "genxml/gen_macros.h"
 
 #include "decode.h"
@@ -75,6 +77,7 @@
          .in_syncs = (uintptr_t)in_fences,
          .in_sync_count = nr_in_fences,
          .out_sync = queue->sync,
+         .jm_ctx_handle = queue->jm_ctx_handle,
          .jc = batch->vtc_jc.first_job,
       };
 
@@ -110,6 +113,7 @@
          .bo_handles = (uintptr_t)bos,
          .bo_handle_count = nr_bos,
          .out_sync = queue->sync,
+         .jm_ctx_handle = queue->jm_ctx_handle,
          .jc = batch->frag_jc.first_job,
          .requirements = PANFROST_JD_REQ_FS,
       };
@@ -331,16 +335,13 @@
                                  uint32_t queue_idx,
                                  struct vk_queue **out_queue)
 {
-   ASSERTED const VkDeviceQueueGlobalPriorityCreateInfoKHR *priority_info =
+   const VkDeviceQueueGlobalPriorityCreateInfoKHR *priority_info =
       vk_find_struct_const(create_info->pNext,
                            DEVICE_QUEUE_GLOBAL_PRIORITY_CREATE_INFO_KHR);
-   ASSERTED const VkQueueGlobalPriorityKHR priority =
+   const VkQueueGlobalPriorityKHR priority =
       priority_info ? priority_info->globalPriority
                     : VK_QUEUE_GLOBAL_PRIORITY_MEDIUM_KHR;
 
-   /* XXX: Panfrost kernel module doesn't support priorities so far */
-   assert(priority == VK_QUEUE_GLOBAL_PRIORITY_MEDIUM_KHR);
-
    struct panvk_gpu_queue *queue = vk_zalloc(&device->vk.alloc, sizeof(*queue), 8,
                                          VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
    if (!queue)
@@ -358,10 +359,33 @@
       goto err_finish_queue;
    }
 
+   if (priority != VK_QUEUE_GLOBAL_PRIORITY_MEDIUM_KHR) {
+      assert(priority == VK_QUEUE_GLOBAL_PRIORITY_LOW_KHR ||
+             priority == VK_QUEUE_GLOBAL_PRIORITY_HIGH_KHR);
+      struct drm_panfrost_jm_ctx_create create_ctx = {
+         .priority = priority == VK_QUEUE_GLOBAL_PRIORITY_LOW_KHR
+                        ? PANFROST_JM_CTX_PRIORITY_LOW
+                        : PANFROST_JM_CTX_PRIORITY_HIGH,
+      };
+      ret = pan_kmod_ioctl(device->drm_fd, DRM_IOCTL_PANFROST_JM_CTX_CREATE,
+                          &create_ctx);
+      if (ret) {
+         result = errno == EACCES || errno == EPERM
+                     ? VK_ERROR_NOT_PERMITTED_KHR
+                     : VK_ERROR_OUT_OF_HOST_MEMORY;
+         result = panvk_error(device, result);
+         goto err_destroy_sync;
+      }
+      queue->jm_ctx_handle = create_ctx.handle;
+   }
+
    queue->vk.driver_submit = panvk_per_arch(gpu_queue_submit);
    *out_queue = &queue->vk;
    return VK_SUCCESS;
 
+err_destroy_sync:
+   pan_kmod_sync_destroy(device->kmod.dev, queue->sync);
+
 err_finish_queue:
    vk_queue_finish(&queue->vk);
 
@@ -376,6 +400,15 @@
    struct panvk_device *dev = to_panvk_device(vk_queue->base.device);
 
    vk_queue_finish(&queue->vk);
+   if (queue->jm_ctx_handle) {
+      struct drm_panfrost_jm_ctx_destroy destroy_ctx = {
+         .handle = queue->jm_ctx_handle,
+      };
+      ASSERTED int ret =
+         pan_kmod_ioctl(dev->drm_fd, DRM_IOCTL_PANFROST_JM_CTX_DESTROY,
+                        &destroy_ctx);
+      assert(!ret);
+   }
    pan_kmod_sync_destroy(dev->kmod.dev, queue->sync);
    vk_free(&dev->vk.alloc, queue);
 }
