+
    nir_def *coord_xy = NULL;
    nir_def *sr[BI_TEX_SR_COUNT] = {};
 
@@ -575,12 +632,9 @@ bi_lower_tex(nir_builder *b, nir_tex_ins
       } else if (srcs.min_lod || srcs.bias) {
