 #ifdef MOZ_ENABLE_V4L2
+// Stateless V4L2 decoders (the Request API, used e.g. by libva-v4l2-request)
+// also need the media controller device that owns the decoder's video node,
+// to allocate requests (MEDIA_IOC_REQUEST_ALLOC). Only admit /dev/media*
+// devices whose topology exposes one of the M2M video nodes allowed above,
+// plus that video node's sysfs uevent (used to map the topology's devnode
+// back to its /dev path), so webcam and capture media devices stay blocked.
+static void AddV4l2RequestMediaDevices(SandboxBroker::Policy* policy,
+                                       const nsTArray<dev_t>& aM2mDevices) {
+  if (aM2mDevices.IsEmpty()) {
+    return;
+  }
+  DIR* dir = opendir("/dev");
+  if (!dir) {
+    return;
+  }
+  struct dirent* dir_entry;
+  while ((dir_entry = readdir(dir))) {
+    if (strncmp(dir_entry->d_name, "media", 5)) {
+      continue;
+    }
+    nsCString path = "/dev/"_ns;
+    path += nsDependentCString(dir_entry->d_name);
+    int fd = open(path.get(), O_RDWR | O_NONBLOCK | O_CLOEXEC, 0);
+    if (fd < 0) {
+      continue;
+    }
+    struct media_v2_topology topology = {};
+    if (ioctl(fd, MEDIA_IOC_G_TOPOLOGY, &topology) < 0 ||
+        topology.num_interfaces == 0 || topology.num_interfaces > 256) {
+      close(fd);
+      continue;
+    }
+    uint32_t count = topology.num_interfaces;
+    auto interfaces = std::make_unique<media_v2_interface[]>(count);
+    topology = {};
+    topology.num_interfaces = count;
+    topology.ptr_interfaces = reinterpret_cast<uintptr_t>(interfaces.get());
+    if (ioctl(fd, MEDIA_IOC_G_TOPOLOGY, &topology) < 0) {
+      close(fd);
+      continue;
+    }
+    close(fd);
+    bool allowed = false;
+    for (uint32_t i = 0; i < std::min(count, topology.num_interfaces); ++i) {
+      const media_v2_interface& intf = interfaces[i];
+      if (intf.intf_type != MEDIA_INTF_T_V4L_VIDEO) {
+        continue;
+      }
+      dev_t devnum = makedev(intf.devnode.major, intf.devnode.minor);
+      if (!aM2mDevices.Contains(devnum)) {
+        continue;
+      }
+      allowed = true;
+      policy->AddPath(rdonly, nsPrintfCString("/sys/dev/char/%u:%u/uevent",
+                                              intf.devnode.major,
+                                              intf.devnode.minor)
+                                  .get());
+    }
+    if (allowed) {
+      policy->AddPath(rdwr, path.get());
+    }
+  }
+  closedir(dir);
+}
